            Object oPopupMessageControlMenuItem is a cCJMenuItem
                Set psCaption to "Popup Message Control"
                Set psTooltip to "Popup Message Control"
                Set psImage to "message_16.ico"
                
                Procedure OnExecute Variant vCommandBarControl
                    Handle hoClient
                    Get Client_Id to hoClient
                    Send Activate_oSigCJPopupControlDemo_View of hoClient
                End_Procedure
            End_Object

            Object oMarkupControlMenuItem is a cCJMenuItem
                Set psCaption to "Markup Control"
                Set psTooltip to "Markup Control"
                Set psImage to "markup_16.ico"

                Procedure OnExecute Variant vCommandBarControl
                    Handle hoClient
                    Get Client_Id to hoClient
                    Send Activate_oSIGCJLabelControlDemo_View of hoClient
                End_Procedure
            End_Object

            Object oProgressBarControlMenuItem is a cCJMenuItem
                Set psCaption to "Progress Bar"
                Set psTooltip to "Progress Bar"
                Set psImage to "ControlProgressBar.ico"

                Procedure OnExecute Variant vCommandBarControl
                    Handle hoClient
                    Get Client_Id to hoClient
                    Send Activate_oSIGCJProgressBarDemo_View of hoClient
                End_Procedure
            End_Object
        End_Object
        #ENDIF 
        
        Object oReportandCalendarViews is a cSigCJRibbonTabGroup
            Set psCaption to "Report && Calendar"
            Set pbControlsCentered to True

            #IFDEF C_Module_ReportControl
            Object oReportViews is a cCJMenuItem
                Set peControlType to xtpControlPopup
                Set psImage to "report_view_32.ico"
                Set psCaption to "Report Control"
                Set psToolTip to "Report View Demos"
                Object oReportViewText is a cCJMenuItem
                    Set psCaption to "Text File"
                    
                    Procedure OnExecute Variant vCommandBarControl
                        Handle hoClient
                        Get Client_Id to hoClient
                        Send Activate_SigCjReportControlDemo_Text_View of hoClient
                    End_Procedure
                End_Object
                Object oReportViewStandard is a cCJMenuItem
                    Set psCaption to "Standard Table"
                    
                    Procedure OnExecute Variant vCommandBarControl
                        Handle hoClient
                        Get Client_Id to hoClient
                        Send Activate_SigCjReportControlDemo_Table_View of hoClient
                    End_Procedure
                End_Object
                Object oReportViewSQL is a cCJMenuItem
                    Set psCaption to "SQL Table/Query"
                    
                    Procedure OnExecute Variant vCommandBarControl
                        Handle hoClient
                        Get Client_Id to hoClient
                        Send Activate_SigCjReportControlDemo_SQL_View of hoClient
                    End_Procedure
                End_Object
                Object oReportViewTree is a cCJMenuItem
                    Set psCaption to "Tree Style"
                    
                    Procedure OnExecute Variant vCommandBarControl
                        Handle hoClient
                        Get Client_Id to hoClient
                        Send Activate_oSigCJReportControlDemo_TreeView of hoClient
                    End_Procedure
                End_Object

            End_Object
            #ENDIF 
            
            #IFDEF C_Module_Calendar
            Object oCalendarViews is a cCJMenuItem
                Set pbControlBeginGroup to True
                Set peControlType to xtpControlPopup
                Set psImage to "calendar_view_32.ico"
                Set psCaption to "Calendar Control"
                Set psToolTip to "Calendar Control Demos"
                
                Object oSpecialDates is a cCJMenuItem
                    Set psCaption to "Maintenance"
                    
                    Procedure OnExecute Variant vCommandBarControl
                        Handle hoClient
                        Get Client_Id to hoClient
                        Send Activate_oCalendar_Maintenance_View of hoClient
                    End_Procedure
                End_Object
                Object oCategories is a cCJMenuItem
                    Set psCaption to "Demo"
                    
                    Procedure OnExecute Variant vCommandBarControl
                        Handle hoClient
                        Get Client_Id to hoClient
                        Send Activate_oCalendar_Demo_View of hoClient
                    End_Procedure
                End_Object
            End_Object
            #ENDIF
            
            #IFDEF C_Module_Calendar_Old 
            Object oOLDCalendarViews is a cCJMenuItem
                Set pbControlBeginGroup to True
                Set peControlType to xtpControlPopup
                Set psImage to "calendar_view_32.ico"
                Set psCaption to "OLD Calendar Control"
                Set psToolTip to "OLD Calendar Control Demos"
                Object oSpecialDates is a cCJMenuItem
                    Set psCaption to "Special Dates"
                    
                    Procedure OnExecute Variant vCommandBarControl
                        Handle hoClient
                        Get Client_Id to hoClient
                        Send Activate_oSigCJCalendarDemo_Special_Dates_View of hoClient
                    End_Procedure
                End_Object
                Object oCategories is a cCJMenuItem
                    Set psCaption to "Categories"
                    
                    Procedure OnExecute Variant vCommandBarControl
                        Handle hoClient
                        Get Client_Id to hoClient
                        Send Activate_oSigCjCalendarDemo_Categories_View of hoClient
                    End_Procedure
                End_Object
                Object oResource is a cCJMenuItem
                    Set psCaption to "Calendar Resources"
                    
                    Procedure OnExecute Variant vCommandBarControl
                        Handle hoClient
                        Get Client_Id to hoClient
                        Send Activate_oCalendar_Resources of hoClient
                    End_Procedure
                End_Object
                Object oStandard is a cCJMenuItem
                    Set psCaption to "Standard Calendar"
                    
                    Procedure OnExecute Variant vCommandBarControl
                        Handle hoClient
                        Get Client_Id to hoClient
                        Send Activate_oSigCJCalendarDemo_Standard_View of hoClient
                    End_Procedure
                End_Object
                Object oBespoke is a cCJMenuItem
                    Set psCaption to "Bespoke Calendar"
                    
                    Procedure OnExecute Variant vCommandBarControl
                        Handle hoClient
