Use SigCJLibraries.pkg 
Use Dftimer.pkg
Register_Object oDockingManager

Object oCommandBarSystem is a cSigCJRibbonBar 
    
    Object oSystemButton is a cSigCJSystemButton
        Set pbSystemMenuShowGripper to False
        Set piSystemMenuIconSize to 32 32  
        Set psImage to "order.ico"
        Object oNew is a cCJMenuItem
            Set psImage to "newdoc_32.ico"
            Set psCaption to "&New"
            Set psShortcut to "Ctrl+N"
        End_Object
              
        Object oOpen is a cCJMenuItem
            Set psImage to "openfolder_32.ico"
            Set psCaption to "&Open"
            Set psShortcut to "Ctrl+O"
        End_Object 
        
        Object oPrintPreview is a cCJMenuItem
            Set psImage to "printer_32.ico"
            Set psCaption to "&Print Preview"
            Set psShortcut to "Ctrl+P"                
        End_Object
        
        Object oExit is a cCJExitMenuItem
            Set psImage to "Exit_32.ico"
        End_Object 
        
        Object oContributors is a cCJMenuItem
            Set psCaption to "VDF SIG UK"
            Set pbControlFlagWrapRow to True 
            Set peControlType to xtpControlLabel
            
            Procedure OnCreateControl Handle hoObj
                Set ComHeight of hoObj to 24
            End_Procedure
            
        End_Object

        Object o1Donor is a cCJMenuItem
            Set psCaption to "Martin Pincott" 
            Set peControlStyle to xtpButtonCaption
            
            Procedure OnCreateControl Handle hoObj
                Set ComHeight of hoObj to 24
            End_Procedure                      
        End_Object
        
        Object o2Donor is a cCJMenuItem
            Set psCaption to "Ian Smith" 
            
            Procedure OnCreateControl Handle hoObj
                Set ComHeight of hoObj to 24
            End_Procedure                
        End_Object

        Object o3Donor is a cCJMenuItem
            Set psCaption to "Peter Bragg" 
            Set peControlStyle to xtpButtonCaption
            
            Procedure OnCreateControl Handle hoObj
                Set ComHeight of hoObj to 24
            End_Procedure                      
        End_Object
    End_Object

    Object oQuickAccessToolbar is a cSigCJQuickAccessToolbar
        Object oSaveItem is a cCJSaveMenuItem
        End_Object
        Object oDeleteItem is a cCJDeleteEditMenuItem
        End_Object
        Object oCutItem is a cCJCutMenuItem
            Set pbControlBeginGroup to True
        End_Object
        Object oCopyAllItem is a cCJCopyMenuItem
        End_Object
        Object oPasteItem is a cCJPasteMenuItem
        End_Object
    End_Object 
    
    Object oMenuTab is a cSigCJRibbonTab 
        Set psCaption to "Menu"
        
        #IFDEF C_Module_Orders 
        Object oOrderViews is a cSigCJRibbonTabGroup
            Set psCaption to "Order Views"
            Set pbControlsCentered to True
            
            Object oOrderViews is a cCJMenuItem
                Set peControlType to xtpControlPopup
                Set psImage to "Windows_32.ico"
                Set psCaption to "Order Views"
                Set psToolTip to "Order Entry Views"
                Object oCustomerEntry is a cCJMenuItem
                    Set psCaption to "Customer Entry"
                    
                    Procedure OnExecute Variant vCommandBarControl
                        Handle hoClient
                        Get Client_Id to hoClient
                        Send Activate_oCustomerView of hoClient
                    End_Procedure
                End_Object
                Object oInventoryitem is a cCJMenuItem
                    Set psCaption to "Inventory Item"
                    
                    Procedure OnExecute Variant vCommandBarControl
                        Handle hoClient
                        Get Client_Id to hoClient
                        Send Activate_oInventoryView of hoClient
                    End_Procedure
                End_Object
                Object oOrderEntry is a cCJMenuItem
                    Set psCaption to "Order Entry"
                    
                    Procedure OnExecute Variant vCommandBarControl
                        Handle hoClient
                        Get Client_Id to hoClient
                        Send Activate_oOrderEntryView of hoClient
                    End_Procedure
                End_Object
                Object oSalesPerson is a cCJMenuItem
                    Set psCaption to "Sales Person Entry"
                    
                    Procedure OnExecute Variant vCommandBarControl
                        Handle hoClient
                        Get Client_Id to hoClient
                        Send Activate_oSalesPersonView of hoClient
                    End_Procedure
                End_Object
                Object oVendors is a cCJMenuItem
                    Set psCaption to "Vendor Entry"
                    
                    Procedure OnExecute Variant vCommandBarControl
                        Handle hoClient
                        Get Client_Id to hoClient
                        Send Activate_oVendorView of hoClient
                    End_Procedure
                End_Object
            End_Object
      
        End_Object
        #ENDIF 
        
        #IFDEF C_Module_GeneralComponents
        Object oGeneralCompontantViews is a cSigCJRibbonTabGroup
            Set psCaption to "General Components"
            
            Procedure OnCreate
                Forward Send OnCreate
                
                // Set ComAllowReduce to False
            End_Procedure

            Object oPushButtonsMenuItem is a cCJMenuItem
                Set psCaption to "Push Buttons"
                Set psTooltip to "Push Buttons"
                Set psImage to "pushbuttons_16.ico"
