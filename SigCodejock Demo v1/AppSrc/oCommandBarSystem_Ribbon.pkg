            End_Object
            #ENDIF
            
            #IFDEF C_Module_Treeview
            Object oTreeViewMenuItem is a cCJMenuItem
                Set psCaption to "TreeView Control"
                Set psTooltip to "TreeView Control"
                Set peControlType to xtpControlPopup

                Object oSimpleTreeViewMenuItem is a cCJMenuItem
                    Set psCaption to "Simple TreeView"
                    Set psTooltip to "Simple TreeView"

                    Procedure OnExecute Variant vCommandBarControl
                        Handle hoClient
                        Get Client_Id to hoClient
                        Send Activate_oSigCJTreeViewDemo_Simple_View of hoClient
                    End_Procedure
                End_Object

                Object oSalesOrdersTreeViewMenuItem is a cCJMenuItem
                    Set psCaption to "Sales Orders TreeView"
                    Set psTooltip to "Sales Orders TreeView"

                    Procedure OnExecute Variant vCommandBarControl
                        Handle hoClient
                        Get Client_Id to hoClient
