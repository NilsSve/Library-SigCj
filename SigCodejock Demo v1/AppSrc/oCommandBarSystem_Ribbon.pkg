            #ENDIF

        End_Object
        
        #IFDEF C_Module_DockingManager
        Object oDockingPanes is a cSigCJRibbonTabGroup
            Set psCaption to "Docking Panes"

            Object oPropertyGrid_Menu is a cCJMenuItem
                Set psCaption     to "Property Grid"
                Set psToolTip     to "Property Grid"
                Set psDescription to "Property Grid"
                Set psImage       to "Configure_16.ico"
                Set pbActiveUpdate to True
                       
                Procedure OnExecute Variant vCommandBarControl
                    Send ShowPane of oDockingManager C_Pane_Property_Grid
                End_Procedure
                
                Function IsEnabled Returns Boolean
                    Boolean bStatus
                    Get IsPaneClosed of oDockingManager C_Pane_Property_Grid to bStatus
                    Function_Return bStatus
                End_Function
                
            End_Object
            
            Object oTaskPanel_Menu is a cCJMenuItem
                Set psCaption     to "Task Panel"
                Set psToolTip     to "Task Panel"
                Set psDescription to "Task Panel"
                Set psImage       to "ActionTileVertically.ico"
                Set pbActiveUpdate to True
                       
                Procedure OnExecute Variant vCommandBarControl
                    Send ShowPane of oDockingManager C_Pane_Task_Panel
                End_Procedure
                
                Function IsEnabled Returns Boolean
                    Boolean bStatus
                    Get IsPaneClosed of oDockingManager C_Pane_Task_Panel to bStatus
                    Function_Return bStatus
                End_Function
            End_Object

            Object oShortCutBar_Menu is a cCJMenuItem
                Set psCaption     to "Short Cut Bar"
                Set psToolTip     to "Short Cut Bar"
                Set psDescription to "Short Cut Bar"
                Set psImage       to "WindowSidebar_16.ico"
                Set pbActiveUpdate to True
                       
                Procedure OnExecute Variant vCommandBarControl
                    Send ShowPane of oDockingManager C_Pane_Short_Cut_Bar
                End_Procedure
                
                Function IsEnabled Returns Boolean
                    Boolean bStatus
                    Get IsPaneClosed of oDockingManager C_Pane_Short_Cut_Bar to bStatus
                    Function_Return bStatus
                End_Function
            End_Object

        End_Object
        #ENDIF
        
        Object oManageGroup is a cSigCJRibbonTabGroup
            Set psCaption to "Users"
            
            Object oManage is a cCJMenuItem
                Set psCaption to "Manage User"
                Set peControlStyle to xtpButtonIconAndCaptionBelow
                Set psImage to "User_32.ico"
                Set psToolTip to "Manage User"
            End_Object
            Object oNew is a cCJMenuItem
                Set pbControlBeginGroup to True
                Set psCaption to "New"
                Set peControlStyle to xtpButtonIconAndCaptionBelow
                Set psImage to "user_new_32.ico"
                Set psToolTip to "Create New User"
            End_Object
            Object oDelete is a cCJMenuItem
                Set psCaption to "Delete"
                Set peControlStyle to xtpButtonIconAndCaptionBelow
                Set psImage to "user_delete_32.ico"
                Set psToolTip to "Delete User"
            End_Object
            Object oDelete is a cCJMenuItem
                Set psCaption to "Groups"
                Set peControlStyle to xtpButtonIconAndCaptionBelow
                Set psImage to "user_group_32.ico"
                Set psToolTip to "User Groups"
            End_Object  
            Object oPin is a cCJMenuItem
                Set pbControlBeginGroup to True
                Set psCaption to "Apply Pin"
                Set psImage to "pinned_16.ico"
                Set psToolTip to "Apply Pin"
            End_Object
            Object oLock is a cCJMenuItem
                Set psCaption to "Lock Record"
                Set psImage to "lock_16.ico"
                Set psToolTip to "Lock Record"
            End_Object
            Object oFilter is a cCJMenuItem
                Set psCaption to "Apply Filter"
                Set psImage to "filter_16.ico"
                Set psToolTip to "Lock Record"
            End_Object
        
        End_Object
        
    End_Object
    
    Object oToolBarTab is a cSigCJRibbonTab
        Set psCaption to "Toolbar"
        Object oFindingGroup is a cSigCJRibbonTabGroup
            Set psCaption to "Finding Toolbar"
            Object oFindFirstTool is a cCJFindFirstMenuItem
            End_Object
    
            Object oFindPreviousTool is a cCJFindPreviousMenuItem
            End_Object
    
            Object oFindMenuTool is a cCJFindMenuItem
            End_Object
    
            Object oFindNextTool is a cCJFindNextMenuItem
            End_Object
    
            Object oFindLastTool is a cCJFindLastMenuItem
            End_Object
            Object oPromptToolItem is a cCJPromptMenuItem
                Set pbControlBeginGroup to True
            End_Object
        End_Object
        Object oDataEntryGroup is a cSigCJRibbonTabGroup
            Set psCaption to "Data Entry Toolbar"
            Object oClearToolItem is a cCJClearMenuItem
                Set peControlStyle to xtpButtonIconAndCaption
            End_Object
            
            Object oClearAllToolItem2 is a cCJClearAllMenuItem
                Set peControlStyle to xtpButtonIconAndCaption
            End_Object
                
            Object oSaveToolItem is a cCJSaveMenuItem
                Set peControlStyle to xtpButtonIconAndCaption
                Set pbControlBeginGroup to True
            End_Object
    
            Object oDeleteToolItem is a cCJDeleteMenuItem
                Set peControlStyle to xtpButtonIconAndCaption
            End_Object
        End_Object
        Object oEditGroup is a cSigCJRibbonTabGroup
            Set psCaption to "Edit Toolbar"
            Object oCutToolbarItem is a cCJCutMenuItem
            End_Object
    
            Object oCopyToolbarItem is a cCJCopyMenuItem
            End_Object
    
            Object oPasteToolbarItem is a cCJPasteMenuItem
            End_Object
    
            Object oDeleteEditToolbarItem is a cCJDeleteEditMenuItem
                Set pbControlBeginGroup to True
            End_Object
            
        End_Object

    End_Object

            
    Object oStatusBar is a cCJStatusBar

        Object oStatusTime is a cCJStatusBarPane
            Set piWidth to 120
            Set pbStyleNoBorders    to True
        End_Object

        Object oStatusPane1 is a cCJStatusBarPane
            Set piID to sbpIDIdlePane
            Set pbStyleStretch to True
        End_Object

        Object oStatusPane2 is a cCJStatusBarPane
            Set phoViewPane to Self
            Set pbStyleStretch to True
        End_Object

        Object oStatusCapslockState is a cCJStatusBarPane
            Set piId to sbpIDCapslock
        End_Object

        Object oStatusNumlockState is a cCJStatusBarPane
            Set piId to sbpIDNumLock
        End_Object

        Object oTimer is a DFTimer
            Set Timer_Active_State to True
            Procedure OnTimer
                Set psText of oStatusTime to (Mid(CurrentDateTime(),19,1))   
            End_Procedure
            
        End_Object  // oTimer

    End_Object // oStatusBar

End_Object