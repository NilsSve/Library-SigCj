                Set psImage to "messagedialogs_16.ico"

                Procedure OnExecute Variant vCommandBarControl
                    Handle hoClient
                    Get Client_Id to hoClient
                    Send Activate_oSigCJTaskDialogDemo_View of hoClient
                End_Procedure
            End_Object

            Object oMonthCalendarMenuItem is a cCJMenuItem
                Set psCaption to "Popup Calendar"
