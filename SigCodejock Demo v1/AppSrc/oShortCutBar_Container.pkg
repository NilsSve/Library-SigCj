Use DfAllEnt.pkg
Use cSigCJDockingPane_Container.pkg
Use cSigCjShortcutBar.pkg

Define C_Bar_OrderSamples 	   for 1
Define C_Bar_GeneralComponents for 2
Define C_Bar_ReportControl 	   for 3
Define C_Bar_CalendarControl   for 4
Define C_Bar_TreeViewControl   for 5

Object oShortCutBar_Container is a cSigCJDockingPane_Container
    Set Border_Style to Border_None
    
    Object oSigCjShortCutBar is a cSigCjShortCutBar
        Set size to 100 100
        Set peAnchors to anAll

        Procedure Setup_ShortcutBar
            Handle hoBar
    
            #IFDEF C_Module_Orders
            Send Add_Bar of ghoSigCj_ShortcutBar C_Bar_OrderSamples "Order Samples" "Order.ico"
    			Send Add_Item of ghoSigCj_ShortcutBar C_Bar_OrderSamples "Inventory Item View"     "Order.ico" "msg_Activate_oInventoryView"   "oClientArea"
    			Send Add_Item of ghoSigCj_ShortcutBar C_Bar_OrderSamples "Vendor Entry View"       "Order.ico" "msg_Activate_oVendorView"      "oClientArea"
    			Send Add_Item of ghoSigCj_ShortcutBar C_Bar_OrderSamples "Sales Person Entry View" "Order.ico" "msg_Activate_oSalesPersonView" "oClientArea"
    			Send Add_Item of ghoSigCj_ShortcutBar C_Bar_OrderSamples "Customer Entry View"     "Order.ico" "msg_Activate_oCustomerView"    "oClientArea"
    			Send Add_Item of ghoSigCj_ShortcutBar C_Bar_OrderSamples "Order Entry"             "Order.ico" "msg_Activate_oOrderEntryView"  "oClientArea"
            #ENDIF
            
            #IFDEF C_Module_GeneralComponents    
            Send Add_Bar of ghoSigCj_ShortcutBar C_Bar_GeneralComponents "General Components" "Tasks_16.ico"
				Send Add_Item of ghoSigCj_ShortcutBar C_Bar_GeneralComponents "Push Buttons"          "Tasks_16.ico" "msg_Activate_oSigCJPushButtonDemo_View"    "oClientArea"
				Send Add_Item of ghoSigCj_ShortcutBar C_Bar_GeneralComponents "Tri-State Checkbox"    "Tasks_16.ico" "msg_Activate_oSigCJCheckBoxDemo_View"      "oClientArea"
				Send Add_Item of ghoSigCj_ShortcutBar C_Bar_GeneralComponents "Message Dialogs"       "Tasks_16.ico" "msg_Activate_oSigCJTaskDialogDemo_View"    "oClientArea"
				Send Add_Item of ghoSigCj_ShortcutBar C_Bar_GeneralComponents "Popup Calendar"        "Tasks_16.ico" "msg_Activate_oSigCJMonthCalendarDemo_View" "oClientArea"
				Send Add_Item of ghoSigCj_ShortcutBar C_Bar_GeneralComponents "Popup Message Control" "Tasks_16.ico" "msg_Activate_oSigCJPopupControlDemo_View"  "oClientArea"
				Send Add_Item of ghoSigCj_ShortcutBar C_Bar_GeneralComponents "Markup Control"        "Tasks_16.ico" "msg_Activate_oSIGCJLabelControlDemo_View"  "oClientArea"
            #ENDIF
            
            #IFDEF C_Module_ReportControl
            Send Add_Bar of ghoSigCj_ShortcutBar C_Bar_ReportControl "Report Control" "ActionCopy.ico"
				Send Add_Item of ghoSigCj_ShortcutBar C_Bar_ReportControl "Text File"      "ActionCopy.ico" "msg_Activate_SigCjReportControlDemo_Text_View"  "oClientArea"
				Send Add_Item of ghoSigCj_ShortcutBar C_Bar_ReportControl "Standard Table" "ActionCopy.ico" "msg_Activate_SigCjReportControlDemo_Table_View" "oClientArea"
				Send Add_Item of ghoSigCj_ShortcutBar C_Bar_ReportControl "SQL Table"      "ActionCopy.ico" "msg_Activate_SigCjReportControlDemo_SQL_View"   "oClientArea"
				Send Add_Item of ghoSigCj_ShortcutBar C_Bar_ReportControl "Tree View"      "ActionCopy.ico" "msg_Activate_oSigCJReportControlDemo_TreeView"  "oClientArea"
            #ENDIF
            
            #IFDEF C_Module_Calendar
            Send Add_Bar of ghoSigCj_ShortcutBar C_Bar_CalendarControl "Calendar Control"  "ActionCalendar.ico"
				Send Add_Item of ghoSigCj_ShortcutBar C_Bar_CalendarControl "Maintenance"      "ActionCalendar.ico" "msg_Activate_oCalendar_Maintenance_View" "oClientArea"
				Send Add_Item of ghoSigCj_ShortcutBar C_Bar_CalendarControl "Demo"             "ActionCalendar.ico" "msg_Activate_oCalendar_Demo_View"        "oClientArea"
            #ENDIF
            
            #IFDEF C_Module_Calendar_Old
            Send Add_Bar of ghoSigCj_ShortcutBar C_Bar_CalendarControl "OLD Calendar Control" "ActionCalendar.ico"
				Send Add_Item of ghoSigCj_ShortcutBar C_Bar_CalendarControl "Special Dates"      "ActionCalendar.ico" "msg_Activate_oSigCJCalendarDemo_Special_Dates_View" "oClientArea"
				Send Add_Item of ghoSigCj_ShortcutBar C_Bar_CalendarControl "Categories"         "ActionCalendar.ico" "msg_Activate_oSigCjCalendarDemo_Categories_View"    "oClientArea"
				Send Add_Item of ghoSigCj_ShortcutBar C_Bar_CalendarControl "Calendar Resources" "ActionCalendar.ico" "msg_Activate_oCalendar_Resources"                   "oClientArea"
                Send Add_Item of ghoSigCj_ShortcutBar C_Bar_CalendarControl "Standard Calendar"  "ActionCalendar.ico" "msg_Activate_oSigCJCalendarDemo_Standard_View"      "oClientArea"
				Send Add_Item of ghoSigCj_ShortcutBar C_Bar_CalendarControl "Bespoke Calendar"   "ActionCalendar.ico" "msg_Activate_oSigCJCalendarDemo_Bespoke_View"       "oClientArea"
				Send Add_Item of ghoSigCj_ShortcutBar C_Bar_CalendarControl "Resource Calendar"  "ActionCalendar.ico" "msg_Activate_oSigCJCalendarDemo_Resource_View"      "oClientArea"
            #ENDIF
            
            #IFDEF C_Module_Treeview
            Send Add_Bar of ghoSigCj_ShortcutBar C_Bar_TreeViewControl "Calendar Control" "WindowSidebar_16.ico"
				Send Add_Item of ghoSigCj_ShortcutBar C_Bar_TreeViewControl "Simple TreeView"        "WindowSidebar_16.ico" "msg_Activate_oSigCJTreeViewDemo_Simple_View"       "oClientArea"
				Send Add_Item of ghoSigCj_ShortcutBar C_Bar_TreeViewControl "Sales Orders TreeVeiw"  "WindowSidebar_16.ico" "msg_Activate_oSigCJTreeViewDemo_SalesOrders_View"  "oClientArea"
			#ENDIF
               
            #IFDEF C_Module_Orders
                Get Find_Bar C_Bar_OrderSamples to hoBar
                Send Color_Bar of hoBar clTeal
    		#ENDIF
            
            #IFDEF C_Module_GeneralComponents    
                Get Find_Bar C_Bar_GeneralComponents to hoBar
                Send Color_Bar of hoBar clOlive
    		#ENDIF
        End_Procedure
        
        //Works any time so Colors can be set and reset as required
//        Procedure Color_Bars
//            Handle hoBar
//            
//            Get Find_Bar C_Bar_OrderSamples to hoBar
//            Send Color_Bar of hoBar clTeal
//            
//            Get Find_Bar C_Bar_GeneralComponents to hoBar
//            Send Color_Bar of hoBar clOlive
//        End_Procedure
    End_Object

End_Object     