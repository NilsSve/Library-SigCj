                Set psTooltip to "Order Samples"
                Set peControlType to xtpControlPopup

                Object oInventoryItemViewMenuItem1 is a cCJMenuItem
                    Set psCaption to "Inventory Item View"
                    Set psTooltip to "Inventory Item View"
                
                    Procedure OnExecute Variant vCommandBarControl
                        Handle hoClient
                        Get Client_Id to hoClient
                        Send Activate_oInventoryView of hoClient
                    End_Procedure
                End_Object

                Object oVendorEntryViewMenuItem1 is a cCJMenuItem
                    Set psCaption to "Vendor Entry View"
