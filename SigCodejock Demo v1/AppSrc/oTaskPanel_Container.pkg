            Object oShortcutBarOffice2007_Item is a cSigCJTaskPanelGroupItem
                Set psLabel to "Shortcut Bar Office 2007"
                Set psImage to "Theme_16.ico"
                Procedure OnClick
                    #IF (SigCj_Codejock_Version < 150001) 
                        Set peTaskPanelTheme to eTPT_BarOffice2007
