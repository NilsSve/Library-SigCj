Use cSigCJTaskPanel.pkg

    Object oTaskPanel_Container is a cSigCJTaskPanel
        Set peTaskPanelBehaviour to eTPB_BehaviourToolbox
               
        #IFDEF C_Module_Orders       
        Object oOrder_Sample_Group is a cSigCJTaskPanelGroup
            Set psLabel to "Order Samples"
            Set psImage to "Order.ico"

            Object oInventoryItemView_GroupItem is a cSigCJTaskPanelGroupItem
                Set psLabel   to "Inventory Item View"
                Set psImage   to "Order.ico"

                Procedure OnClick
                    Handle hoClient
                    Get Client_Id to hoClient
                    Send Activate_oInventoryView of hoClient
                End_Procedure
            End_Object
            
            Object oVendorEntryView_GroupItem is a cSigCJTaskPanelGroupItem
                Set psLabel to "Vendor Entry View"
                Set psImage to "Order.ico"
            
                Procedure OnClick
                    Handle hoClient
                    Get Client_Id to hoClient
                    Send Activate_oVendorView of hoClient
                End_Procedure
            End_Object

            Object oSalesPersonEntryView_GroupItem is a cSigCJTaskPanelGroupItem
                Set psLabel to "Sales Person Entry View"
                Set psImage to "Order.ico"
            
                Procedure OnClick
                    Handle hoClient
                    Get Client_Id to hoClient
                    Send Activate_oSalesPersonView of hoClient
                End_Procedure
            End_Object

            Object oCustomerEntryView_GroupItem is a cSigCJTaskPanelGroupItem
                Set psLabel to "Customer Entry View"
                Set psImage to "Order.ico"
            
                Procedure OnClick
                    Handle hoClient
                    Get Client_Id to hoClient
                    Send Activate_oCustomerView of hoClient
                End_Procedure
            End_Object

            Object oOrderEntry_GroupItem is a cSigCJTaskPanelGroupItem
                Set psLabel to "Order Entry"
                Set psImage to "Order.ico"
            
                Procedure OnClick
                    Handle hoClient
                    Get Client_Id to hoClient
                    Send Activate_oOrderEntryView of hoClient
                End_Procedure
            End_Object

        End_Object // oOrder_Sample_Group
        #ENDIF

