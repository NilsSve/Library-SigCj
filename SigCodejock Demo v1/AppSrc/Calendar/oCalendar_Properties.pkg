Use cSigCJPropertyGrid.pkg

    Object oSigCJCalendar_PropertyGrid is a cSigCJPropertyGrid
        Set Size to 169 151
        Set Location to 1 0
        Set Border_Style to Border_None
        Set peAnchors to anAll
    
        Set piHelpHeight to 60
        Set prSplitterPos to 0.5
        Set pbVariableSplitterPos to True
        Set phoMainContainerObjectID to (Parent(Self))
        Set pbVariableHelpHeight to True
        
        Object oCtgry_Class is a cSigCJPropertyGridCategory
            Set psLabel to "Class"
            Set psHelpText to "Non OCX Properties"
    
            Object oItem_Use_Icons is a cSigCJPropertyGridItem
                Set psLabel to "Use Icons"
                Set psHelpText to "Use custom icons instead of Glyphs. Only applies when theme set to Office 07"
                Set peItemType to ePGItype_Boolean
                Set pvInitialValue to (If(pbUseIcons(oSigCJCalendarControl1),"True","False"))  
                
                Procedure OnChange
                    Boolean bValue
                
                    Get pvValue to bValue
                    Set pbUseIcons of oSigCJCalendarControl1 to bValue
                End_Procedure        
            End_Object
    
            Object oItem_Use_Icons is a cSigCJPropertyGridItem
                Set psLabel to "Custom Icons"
                Set psHelpText to "Allow custom icons to added to events"
                Set peItemType to ePGItype_Boolean
                Set pvInitialValue to (If(pbUseCustomIcons(oSigCJCalendarControl1),"True","False"))  
                
                Procedure OnChange
                    Boolean bValue
                
                    Get pvValue to bValue
                    Set pbUseCustomIcons of oSigCJCalendarControl1 to bValue
                End_Procedure        
            End_Object
    
            Object oItem_Use_Icons is a cSigCJPropertyGridItem
                Set psLabel to "Custom Properties"
                Set psHelpText to "Allow custom properties to added to events"
                Set peItemType to ePGItype_Boolean
                Set pvInitialValue to (If(pbUseCustomProperties(oSigCJCalendarControl1),"True","False"))  
                
                Procedure OnChange
                    Boolean bValue
                
                    Get pvValue to bValue
                    Set pbUseCustomProperties of oSigCJCalendarControl1 to bValue
                End_Procedure        
            End_Object
    
        End_Object
    
        Object oCtgry_Main is a cSigCJPropertyGridCategory
            Set psLabel to "Main"
            Set psHelpText to "Calendar Properties"
    
            Object oCtgry_CaptionBar is a cSigCJPropertyGridItem
                Set psLabel to "Caption Bar"
                Set psHelpText to "Set options for the caption bar"
                
                Object oItem_ShowBar is a cSigCJPropertyGridItem
                    Set psLabel to "Show Bar"
                    Set psHelpText to "Display the calendar caption bar."
                    Set peItemType to ePGItype_Boolean
                    Set pvInitialValue to (If(peCaptionBar(oSigCJCalendarControl1) iand eCal_ShowCaptionBar,"True","False"))  
                    
                    Procedure OnChange
                        Send Update_Caption_bar
                    End_Procedure        
                End_Object
    
                Object oItem_Show_Date is a cSigCJPropertyGridItem
                    Set psLabel to "Show Date"
                    Set psHelpText to "Display the calendar caption bar date label."
                    Set peItemType to ePGItype_Boolean
                    Set pvInitialValue to (If(peCaptionBar(oSigCJCalendarControl1) iand eCal_CaptionBarDateLabel,"True","False"))  
                    
                    Procedure OnChange
                        Send Update_Caption_bar
                    End_Procedure        
                End_Object
                
                Object oItem_Show_Date_Nav is a cSigCJPropertyGridItem
                    Set psLabel to "Show Date Buttons"
                    Set psHelpText to "Display the calendar caption bar scroll date buttons."
                    Set peItemType to ePGItype_Boolean
                    Set pvInitialValue to (If(peCaptionBar(oSigCJCalendarControl1) iand eCal_CaptionBarScrollDateButtons,"True","False"))  
                    
                    Procedure OnChange
                        Send Update_Caption_bar
                    End_Procedure        
                End_Object
                
                Object oItem_Show_View_Nav is a cSigCJPropertyGridItem
                    Set psLabel to "Show View Buttons"
                    Set psHelpText to "Displaythe calendar caption bar switch view buttons."
                    Set peItemType to ePGItype_Boolean
                    Set pvInitialValue to (If(peCaptionBar(oSigCJCalendarControl1) iand eCal_CaptionBarSwitchViewButtons,"True","False"))  
                    
                    Procedure OnChange
                        Send Update_Caption_bar
                    End_Procedure        
                End_Object
    
                Procedure Update_Caption_bar
                    Boolean bShow bDate bDateNav bViewNav
                    
                    Get pvValue of oItem_ShowBar        to bShow
                    Get pvValue of oItem_Show_Date      to bDate
                    Get pvValue of oItem_Show_Date_Nav  to bDateNav
                    Get pvValue of oItem_Show_View_Nav  to bViewNav
                    
                    Set peCaptionBar of oSigCJCalendarControl1 to (If(bShow   ,eCal_ShowCaptionBar             ,0) ior ;
                                                            If(bDate   ,eCal_CaptionBarDateLabel        ,0) ior ;
                                                            If(bDateNav,eCal_CaptionBarScrollDateButtons,0) ior ;
                                                            If(bViewNav,eCal_CaptionBarSwitchViewButtons,0))
                End_Procedure
    
            End_Object
    
            Object oItem_Reminders is a cSigCJPropertyGridItem
                Set psLabel to "Reminders"
                Set psHelpText to "Enable reminders."
                Set peItemType to ePGItype_Boolean
                Set pvInitialValue to (If(pbEnableReminders(oSigCJCalendarControl1),"True","False"))  
    
                    Procedure OnChange
                        //Send Update_Caption_bar
                    End_Procedure        
            End_Object
    
            Object oItem_Dialogs is a cSigCJPropertyGridItem
                Set psLabel to "Custom Dialogs"
                Set psHelpText to "Use custom or the built in dialogs."
                Set peItemType to ePGItype_Boolean
                Set pvInitialValue to (If(pbUseCustomDialogs(oSigCJCalendarControl1),"True","False"))  
    
                //Custom dialogs not yet implemented in the calendar                    
                Set pbReadOnly to True
    
                Procedure OnChange
                    //Custom dialogs not yet implemented in the calendar                    
                End_Procedure        
            End_Object
    
            Object oItem_Categories is a cSigCJPropertyGridItem
                Set psLabel to "Custom Categories"
                Set psHelpText to "Use custom categories."
                Set peItemType to ePGItype_Boolean
                Set pvInitialValue to (If(pbUseCustomCategories(oSigCJCalendarControl1),"True","False"))  
    
                Procedure OnChange
                    Boolean bValue
                
                    Get pvValue to bValue
                    Set pbUseCustomCategories of oSigCJCalendarControl1 to bValue
                End_Procedure        
            End_Object
    
            Object oItem_TimeScale is a cSigCJPropertyGridComboFormItem
                Set psLabel to "Time Scale"
                Set psHelpText to "Sets the time Scale interval."
                Set peItemType to ePGItype_Enum
                Set pvInitialValue to (peTimeScale(oSigCJCalendarControl1))
    
                Procedure OnAddLookupItems
                    Send AddLookupItem eCal_TimeScale_5   eCal_TimeScale_5   "" ""  
                    Send AddLookupItem eCal_TimeScale_10  eCal_TimeScale_10  "" ""  
                    Send AddLookupItem eCal_TimeScale_15  eCal_TimeScale_15  "" ""  
                    Send AddLookupItem eCal_TimeScale_30  eCal_TimeScale_30  "" ""  
                    Send AddLookupItem eCal_TimeScale_60  eCal_TimeScale_60  "" ""                      
                End_Procedure
    
                Procedure OnChange
                    String sValue
                
                    Get pvValue to sValue
                    Set peTimeScale of oSigCJCalendarControl1 to sValue
                End_Procedure        
            End_Object
            
            Object oScaleTime_DayStart is a cSigCJPropertyGridItem
                Set psLabel to "Scale Time Day Start"
                Set psHelpText to "Set the scale start time for the day. (HH:MM)"
                Set peItemType to ePGItype_String
                Set pvInitialValue to (ptmTimeScaleMinTime(oSigCJCalendarControl1))  
    
                Procedure OnChange
                    Time tmValue
                
                    Get pvValue to tmValue
                    Set ptmTimeScaleMinTime of oSigCJCalendarControl1 to tmValue
                End_Procedure        
            End_Object

            Object oScaleTime_DayEnd is a cSigCJPropertyGridItem
                Set psLabel to "Scale Time_Day End"
                Set psHelpText to "Set the scale end time for the day. (HH:MM)"
                Set peItemType to ePGItype_String
                Set pvInitialValue to (ptmTimeScaleMaxTime(oSigCJCalendarControl1))  
    
                Procedure OnChange
                    Time tmValue
                
                    Get pvValue to tmValue
                    Set ptmTimeScaleMaxTime of oSigCJCalendarControl1 to tmValue
                End_Procedure        
            End_Object
    
            Object oScaleTime_Use is a cSigCJPropertyGridItem
                Set psLabel to "Use Scale times"
                Set peItemType to ePGItype_Boolean
                Set pvInitialValue to (pbUseScaleTimes(oSigCJCalendarControl1))  
    
                Procedure OnChange
                    Boolean bValue
                
                    Get pvValue to bValue
                    Set pbUseScaleTimes of oSigCJCalendarControl1 to bValue
                End_Procedure
                
            End_Object
            
            Object oItem_ViewType is a cSigCJPropertyGridComboFormItem
                Set psLabel to "View Type"
                Set psHelpText to "The Calender Control's current view."
                Set peItemType to ePGItype_Enum
                Set pvInitialValue to (peViewType(oSigCJCalendarControl1))
    
                Procedure OnAddLookupItems
                    Send AddLookupItem "Day"      eCal_ViewType_Day      "" ""
                    Send AddLookupItem "Working"  eCal_ViewType_Working  "" ""
                    Send AddLookupItem "Week"     eCal_ViewType_Week     "" ""
                    Send AddLookupItem "Month"    eCal_ViewType_Month    "" ""
                    Send AddLookupItem "FullWeek" eCal_ViewType_FullWeek "" ""
                End_Procedure           
    
                Procedure OnChange
                    String sValue
                
                    Get pvValue to sValue
                    Set peViewType of oSigCJCalendarControl1 to sValue
                End_Procedure        
            End_Object
    
        End_Object
    
        Object oCtgry_Options is a cSigCJPropertyGridCategory
            Set psLabel to "Options"
            Set psHelpText to "Calendar Option Properties"
    
            Object oItem_ToolTips is a cSigCJPropertyGridItem
                Set psLabel to "Tool Tips"
                Set psHelpText to "Standard tool tips are displayed when the mouse is over an event which is too small to display the entire subject for the event."
                Set peItemType to ePGItype_Boolean
                Set pvInitialValue to (If(pbEnableStdToolTips(oSigCJCalendarControl1),"True","False"))  
    
                Procedure OnChange
                    Boolean bValue
                
                    Get pvValue to bValue
                    Set pbEnableStdToolTips of oSigCJCalendarControl1 to bValue
                End_Procedure        
            End_Object
    
            Object oItem_ClickToAdd is a cSigCJPropertyGridItem
                Set psLabel to "Click to Add"
                Set psHelpText to "Show the 'Click to add appointment' tip window when the mouse is positioned over an open time slot."
                Set peItemType to ePGItype_Boolean
                Set pvInitialValue to (If(pbClickToAdd(oSigCJCalendarControl1),"True","False"))  
    
                Procedure OnChange
                    Boolean bValue
                
                    Get pvValue to bValue
                    Set pbClickToAdd of oSigCJCalendarControl1 to bValue
                End_Procedure        
            End_Object
    
            Object oItem_ClickToAddText is a cSigCJPropertyGridItem
                Set psLabel to "Click to Add Text"
                Set psHelpText to "Text displayed in the 'Click to Add appointment' tip window."
                Set peItemType to ePGItype_String
                Set pvInitialValue to (psClickToAddText(oSigCJCalendarControl1))
    
                Procedure OnChange
                    String sValue
                
                    Get pvValue to sValue
                    Set psClickToAddText of oSigCJCalendarControl1 to sValue
                End_Procedure        
            End_Object
    
            Object oItem_TimeMark is a cSigCJPropertyGridComboFormItem
                Set psLabel to "Time Mark"
                Set psHelpText to "Specifies when the Time Mark is displayed on the time scale."
                Set peItemType to ePGItype_Enum
                Set pvInitialValue to (peDayViewCurrentTimeMarkVisible(oSigCJCalendarControl1))
    
                Procedure OnAddLookupItems
                    Send AddLookupItem "None"    eCal_TM_None            "" "" 
                    Send AddLookupItem "Today"   eCal_TM_VisibleForToday "" "" 
                    Send AddLookupItem "Always"  eCal_TM_VisibleAlways   "" "" 
                    Send AddLookupItem "Printed" eCal_TM_Printed         "" "" 
                End_Procedure
    
                Procedure OnChange
                    String sValue
                
                    Get pvValue to sValue
                    Set psClickToAddText of oSigCJCalendarControl1 to sValue
                End_Procedure        
            End_Object
    
            Object oItem_Minutes is a cSigCJPropertyGridItem
                Set psLabel to "Show Minutes"
                Set psHelpText to "Display minute marks on the time scale."
                Set peItemType to ePGItype_Boolean
                Set pvInitialValue to (If(pbDayViewShowMinutes(oSigCJCalendarControl1),"True","False"))  
    
                Procedure OnChange
                    Boolean bValue
                
                    Get pvValue to bValue
                    Set pbDayViewShowMinutes of oSigCJCalendarControl1 to bValue
                End_Procedure        
            End_Object
    
            Object oItem_IP_Create is a cSigCJPropertyGridItem
                Set psLabel to "In Place Create"
                Set psHelpText to "Create event creation when a character key is pressed when a cell has focus in the Calendar."
                Set peItemType to ePGItype_Boolean
                Set pvInitialValue to (If(pbInPlaceCreateEvent(oSigCJCalendarControl1),"True","False"))  
    
                Procedure OnChange
                    Boolean bValue
                
                    Get pvValue to bValue
                    Set pbInPlaceCreateEvent of oSigCJCalendarControl1 to bValue
                End_Procedure        
            End_Object
    
            Object oItem_IPE is a cSigCJPropertyGridItem
                Set psLabel to "In Place Edit"
                Set psHelpText to "Options to start an In Place Edit."
    
                Object oItem_IPE_Resize is a cSigCJPropertyGridItem
                    Set psLabel to "On Resize"
                    Set psHelpText to "In-place editing of the event subject after the event is resized."
                    Set peItemType to ePGItype_Boolean
                    Set pvInitialValue to (If(pbInPlaceEdit_AfterEventResize(oSigCJCalendarControl1),"True","False"))  
    
                    Procedure OnChange
                        Boolean bValue
                    
                        Get pvValue to bValue
                        Set pbInPlaceEdit_AfterEventResize of oSigCJCalendarControl1 to bValue
                    End_Procedure        
                End_Object
    
                Object oItem_IPE_F2 is a cSigCJPropertyGridItem
                    Set psLabel to "On F2"
                    Set psHelpText to "In-place editing of the event subject when the F2 key is pressed"
                    Set peItemType to ePGItype_Boolean
                    Set pvInitialValue to (If(pbInPlaceEdit_ByF2(oSigCJCalendarControl1),"True","False"))  
    
                    Procedure OnChange
                        Boolean bValue
                    
                        Get pvValue to bValue
                        Set pbInPlaceEdit_ByF2 of oSigCJCalendarControl1 to bValue
                    End_Procedure        
                End_Object
    
                Object oItem_IPE_Mouse is a cSigCJPropertyGridItem
                    Set psLabel to "On Mouse Click"
                    Set psHelpText to "In-place editing of the event subject when the event is clicked with the left mouse button."
                    Set peItemType to ePGItype_Boolean
                    Set pvInitialValue to (If(pbInPlaceEdit_ByMouseClick(oSigCJCalendarControl1),"True","False"))  
    
                    Procedure OnChange
                        Boolean bValue
                    
                        Get pvValue to bValue
                        Set pbInPlaceEdit_ByMouseClick of oSigCJCalendarControl1 to bValue
                    End_Procedure        
                End_Object
                
                Object oItem_IPE_Tab is a cSigCJPropertyGridItem
                    Set psLabel to "On Tab"
                    Set psHelpText to "In-place editing of the event subject when the Tab key is used to navigate events in the current view."
                    Set peItemType to ePGItype_Boolean
                    Set pvInitialValue to (If(pbInPlaceEdit_ByTab(oSigCJCalendarControl1),"True","False"))  
    
                    Procedure OnChange
                        Boolean bValue
                    
                        Get pvValue to bValue
                        Set pbInPlaceEdit_ByTab of oSigCJCalendarControl1 to bValue
                    End_Procedure        
                End_Object
            End_Object
    
            Object oItem_FirstDay is a cSigCJPropertyGridComboFormItem
                Set psLabel to "1st Week Day"
                Set psHelpText to "Specifies the first day of the week."
                Set peItemType to ePGItype_Enum
                Set pvInitialValue to (peFirstDayOfTheWeek(oSigCJCalendarControl1))
    
                Procedure OnAddLookupItems
                    Send AddLookupItem "Sunday"    eCal_Sunday    "" ""
                    Send AddLookupItem "Monday"    eCal_Monday    "" ""
                    Send AddLookupItem "Tuesday"   eCal_Tuesday   "" ""
                    Send AddLookupItem "Wednesday" eCal_Wednesday "" ""
                    Send AddLookupItem "Thursday"  eCal_Thursday  "" ""
                    Send AddLookupItem "Friday"    eCal_Friday    "" ""
                    Send AddLookupItem "Saturday"  eCal_Saturday  "" ""
                End_Procedure
    
                Procedure OnChange
                    String sValue
                
                    Get pvValue to sValue
                    Set peFirstDayOfTheWeek of oSigCJCalendarControl1 to sValue
                End_Procedure        
            End_Object
    
            Object oItem_Compress is a cSigCJPropertyGridItem
                Set psLabel to "Compress Weekend"
                Set psHelpText to "Are Saturday and Sunday 'compressed' while in Month view."
                Set peItemType to ePGItype_Boolean
                Set pvInitialValue to (If(pbCompressWeekendDays(oSigCJCalendarControl1),"True","False"))  
    
                Procedure OnChange
                    Boolean bValue
                
                    Get pvValue to bValue
                    Set pbCompressWeekendDays of oSigCJCalendarControl1 to bValue
                End_Procedure        
            End_Object
    
            Object oItem_OutlookGlyphs is a cSigCJPropertyGridItem
                Set psLabel to "Outlook Glyphs"
                Set psHelpText to "Use 'MS Outlook' font to display Glyphs, or built-in bitmaps."
                Set peItemType to ePGItype_Boolean
                Set pvInitialValue to (If(pbUseOutlookGlyphs(oSigCJCalendarControl1),"True","False"))  
    
                Procedure OnChange
                    Boolean bValue
                
                    Get pvValue to bValue
                    Set pbUseOutlookGlyphs of oSigCJCalendarControl1 to bValue
                End_Procedure        
            End_Object
    
            Object oItem_EndDate is a cSigCJPropertyGridComboFormItem
                Set psLabel to "Show End Date"
                Set psHelpText to "Displays end time of an event in Week / Month view."
                Set peItemType to ePGItype_Enum
                Set pvInitialValue to (peShowEndDate(oSigCJCalendarControl1))
    
                Procedure OnAddLookupItems
                    Send AddLookupItem "None"  eCal_MW_None  "" ""
                    Send AddLookupItem "Week"  eCal_MW_Week  "" ""
                    Send AddLookupItem "Month" eCal_MW_Month "" ""
                    Send AddLookupItem "Both"  eCal_MW_Both  "" ""
                End_Procedure
    
                Procedure OnChange
                    String sValue
                
                    Get pvValue to sValue
                    Set peShowEndDate of oSigCJCalendarControl1 to sValue
                End_Procedure        
            End_Object
    
            Object oItem_Clocks is a cSigCJPropertyGridComboFormItem
                Set psLabel to "Show clocks"
                Set psHelpText to "Display start and end time of events as graphical clock when in Week / Month view."
                Set peItemType to ePGItype_Enum
                Set pvInitialValue to (peShowTimeAsClocks(oSigCJCalendarControl1))
    
                Procedure OnAddLookupItems
                    Send AddLookupItem "None"  eCal_MW_None  "" ""
                    Send AddLookupItem "Week"  eCal_MW_Week  "" ""
                    Send AddLookupItem "Month" eCal_MW_Month "" ""
                    Send AddLookupItem "Both"  eCal_MW_Both  "" ""
                End_Procedure
    
                Procedure OnChange
                    String sValue
                
                    Get pvValue to sValue
                    Set peShowTimeAsClocks of oSigCJCalendarControl1 to sValue
                End_Procedure        
    
            End_Object
    
        End_Object
    
        Object oCtgry_Times is a cSigCJPropertyGridCategory
            Set psLabel to "Times"
            Set psHelpText to "Calendar Time Settings"
    
            Object oItem_WorkDayStart is a cSigCJPropertyGridItem
                Set psLabel to "Working Day Start"
                Set psHelpText to "Set the start time for the working day. (HH:MM)"
                Set peItemType to ePGItype_String
                Set pvInitialValue to (ptmWorkDayStartTime(oSigCJCalendarControl1))  
    
                Procedure OnChange
                    Time tmValue
                
                    Get pvValue to tmValue
                    Set ptmWorkDayStartTime of oSigCJCalendarControl1 to tmValue
                End_Procedure        
            End_Object
    
            Object oItem_WorkDayEnd is a cSigCJPropertyGridItem
                Set psLabel to "Working Day End"
                Set psHelpText to "Set the end time for the working day. (HH:MM)"
                Set peItemType to ePGItype_String
                Set pvInitialValue to (ptmWorkDayEndTime(oSigCJCalendarControl1))  
    
                Procedure OnChange
                    Time tmValue
                
                    Get pvValue to tmValue
                    Set ptmWorkDayEndTime of oSigCJCalendarControl1 to tmValue
                End_Procedure        
            End_Object
    
            Object oItem_ShortLastDay is a cSigCJPropertyGridItem
                Set psLabel to "Shorter Last Day"
                Set psHelpText to "Specifies if the last working day of the weel is shorter than the rest."
                Set peItemType to ePGItype_Boolean
                Set pvInitialValue to (If(pbShorterLastDay(oSigCJCalendarControl1),"True","False"))  
    
                Procedure OnChange
                    Boolean bValue
                
                    Get pvValue to bValue
                    Set pbShorterLastDay of oSigCJCalendarControl1 to bValue
                End_Procedure        
            End_Object
    
            Object oItem_LastDayEnd is a cSigCJPropertyGridItem
                Set psLabel to "Working Day End"
                Set psHelpText to "Set the end time for the last working day of the week. (HH:MM)"
                Set peItemType to ePGItype_String
                Set pvInitialValue to (ptmLastWorkDayEndTime(oSigCJCalendarControl1))  
    
                Procedure OnChange
                    Time tmValue
                
                    Get pvValue to tmValue
                    Set ptmLastWorkDayEndTime of oSigCJCalendarControl1 to tmValue
                End_Procedure        
            End_Object
    
            Object oItem_ShadeLunch is a cSigCJPropertyGridItem
                Set psLabel to "Shade lunch period"
                Set psHelpText to "Specifies if the luch period should be shaded."
                Set peItemType to ePGItype_Boolean
                Set pvInitialValue to (If(pbShadeLunchTime(oSigCJCalendarControl1),"True","False"))  
    
                Procedure OnChange
                    Boolean bValue
                
                    Get pvValue to bValue
                    Set pbShadeLunchTime of oSigCJCalendarControl1 to bValue
                End_Procedure        
            End_Object
    
            Object oItem_LunchStart is a cSigCJPropertyGridItem
                Set psLabel to "Lunch Time Start"
                Set psHelpText to "Set the start time for the lunch period. (HH:MM)"
                Set peItemType to ePGItype_String
                Set pvInitialValue to (ptmLunchStartTime(oSigCJCalendarControl1))  
    
                Procedure OnChange
                    Time tmValue
                
                    Get pvValue to tmValue
                    Set ptmLunchStartTime of oSigCJCalendarControl1 to tmValue
                End_Procedure        
            End_Object
    
            Object oItem_LunchEnd is a cSigCJPropertyGridItem
                Set psLabel to "Lunch Time End"
                Set psHelpText to "Set the end time for the lunch period. (HH:MM)"
                Set peItemType to ePGItype_String
                Set pvInitialValue to (ptmLunchEndTime(oSigCJCalendarControl1))  
    
                Procedure OnChange
                    Time tmValue
                
                    Get pvValue to tmValue
                    Set ptmLunchEndTime of oSigCJCalendarControl1 to tmValue
                End_Procedure        
            End_Object
    
        End_Object
    
        Object oCtgry_Print is a cSigCJPropertyGridCategory
            Set psLabel to "Print"
            Set psHelpText to "Calendar print properties"
        End_Object
    
        Object oCtgry_Preview is a cSigCJPropertyGridCategory
            Set psLabel to "Print Preview"
            Set psHelpText to "Calendar print preview properties"
    
            Object oItem_Title is a cSigCJPropertyGridItem
                Set psLabel to "Title"
                Set psHelpText to "Print preview dialog title"
                Set peItemType to ePGItype_String
                Set pvInitialValue to (psPrintPreviewTitle(oSigCJCalendarControl1))
    
                Procedure OnChange
                    String sValue
                
                    Get pvValue to sValue
                    Set psPrintPreviewTitle of oSigCJCalendarControl1 to sValue
                End_Procedure        
            End_Object
        End_Object
    End_Object
