        Object o_peFirstDayOfTheWeek is a cSigCJPropertyGridComboFormItem
            Set psLabel to "First Week Day"
            Set psHelpText to "Sets the first day of the week."
            Set peItemType to ePGItype_Enum
            Set pvInitialValue to (peFirstDayOfTheWeek(zzCal_Object))

            Procedure OnAddLookupItems
                Send AddLookupItem "Sunday"    eCal_Sunday    "" ""  
                Send AddLookupItem "Monday"    eCal_Monday    "" ""  
                Send AddLookupItem "Tuesday"   eCal_Tuesday   "" ""  
                Send AddLookupItem "Wednesday" eCal_Wednesday "" ""  
                Send AddLookupItem "Thursday"  eCal_Thursday  "" ""                      
                Send AddLookupItem "Friday"    eCal_Friday    "" ""                      
                Send AddLookupItem "Saturday"  eCal_Saturday  "" ""                      
            End_Procedure

            Procedure OnChange
                String sValue
            
                Get pvValue to sValue
                Set peFirstDayOfTheWeek of zzCal_Object to sValue
            End_Procedure        
        End_Object

        //---------------------------------------------------------------------

        Object o_pbFullDateMode is a cSigCJPropertyGridItem
            Set psLabel to "Full Date Mode"
            Set psHelpText to "Tells the calendar to use DayHeaderFormat to display header information in day view."
            Set peItemType to ePGItype_Boolean
            Set pvInitialValue to (If(pbFullDateMode(zzCal_Object),"True","False"))  

            Procedure OnChange
