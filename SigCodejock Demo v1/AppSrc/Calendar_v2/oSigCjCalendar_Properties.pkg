        //---------------------------------------------------------------------

        Object oItem_IPE is a cSigCJPropertyGridItem
            Set psLabel to "In Place Edit"
            Set psHelpText to "Options to start an In Place Edit."
            Set piValueBackgroundColor to (RGB(234,216,196))
        
            Procedure Private.Create Handle hoParent Boolean bRecursive
                Handle hoCaptionMetrics 
    
                Forward Send Private.Create hoParent bRecursive
                
                Get Private.phoPropertyCaptionMetrics to hoCaptionMetrics
                Set ComBackColor of hoCaptionMetrics to (RGB(234,216,196))
            End_Procedure

            Object oItem_IPE_Resize is a cSigCJPropertyGridItem
                Set psLabel to "On Resize"
                Set psHelpText to "In-place editing of the event subject after the event is resized."
                Set peItemType to ePGItype_Boolean
                Set pvInitialValue to (If(pbEnableInPlaceEditEventSubject_AfterEventResize(zzCal_Object),"True","False"))

                Procedure OnChange
                    Boolean bValue

