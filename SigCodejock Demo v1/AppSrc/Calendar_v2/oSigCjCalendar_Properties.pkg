Use cSigCJPropertyGrid.pkg

Object oSigCJCalendar_Properties_Grid is a cSigCJPropertyGrid
    Set Size to 156 165
    Set Location to 3 3
    Set Border_Style to Border_None
    Set peAnchors to anAll

    Set piHelpHeight to 60
    Set prSplitterPos to 0.5
    Set pbVariableSplitterPos to True
    Set phoMainContainerObjectID to (Parent(Self))
    Set pbVariableHelpHeight to True

    Property Handle phoCal
    
    //=========================================================================

    Object oC_AutoRefresh is a cSigCJPropertyGridCategory
        Set psLabel to "Auto Refresh"
        Set psHelpText to "Properties to configure automatic data refresh"

        //---------------------------------------------------------------------

        Object o_pbEnableAutoRefresh is a cSigCJPropertyGridItem
            Set psLabel to "Enable Auto Refresh"
            Set psHelpText to "If enabled an idle handler will be used to refresh the data. This is a design time property."
            Set peItemType to ePGItype_Boolean
            Set pvInitialValue to (If(pbEnableAutoRefresh(zzCal_Object),"True","False"))  

            Procedure OnChange
                Boolean bValue
            
                Get pvValue to bValue
                Set pbEnableAutoRefresh of zzCal_Object to bValue
            End_Procedure        
        End_Object

        //---------------------------------------------------------------------

        Object o_piRefreshInterval is a cSigCJPropertyGridItem
            Set psLabel to "Refresh Interval"
            Set psHelpText to "How often will the data be refreshed."
            Set peItemType to ePGItype_Number
            Set pvInitialValue to (piRefreshInterval(zzCal_Object))

            Procedure OnChange
                Integer iValue
            
                Get pvValue to iValue
                Set piRefreshInterval of zzCal_Object to iValue
            End_Procedure        
        End_Object

        //---------------------------------------------------------------------

        Object o_peIntervalUnits is a cSigCJPropertyGridComboFormItem
            Set psLabel to "Refresh Units"
            Set psHelpText to "Specifies whether the Refresh Interval is in Minutes or Seconds."
            Set peItemType to ePGItype_Enum
            Set pvInitialValue to (peIntervalUnits(zzCal_Object))  

            Procedure OnAddLookupItems
                Send AddLookupItem "Minutes"  eCal_AR_Minutes   "" ""  
                Send AddLookupItem "Seconds"  eCal_AR_Seconds  "" ""  
            End_Procedure

            Procedure OnChange
                Integer eValue
            
                Get pvValue to eValue
                Set peIntervalUnits of zzCal_Object to eValue
            End_Procedure        
        End_Object

    End_Object 
 
    //-------------------------------------------------------------------------

    Object oC_Calendar is a cSigCJPropertyGridCategory
        Set psLabel to "Calendar"
        Set psHelpText to ""

        //---------------------------------------------------------------------

        Object o_pbDayViewAutoResetBusyFlag is a cSigCJPropertyGridItem
            Set psLabel to "Auto Reset Busy"
            Set psHelpText to "Specifies if the event status is automatically set to 'Free' when an Event is moved from the hours area to the all day area and vice versa."
            Set peItemType to ePGItype_Boolean
            Set pvInitialValue to (If(pbDayViewAutoResetBusyFlag(zzCal_Object),"True","False"))  

            Procedure OnChange
                Boolean bValue
            
                Get pvValue to bValue
                Set pbDayViewAutoResetBusyFlag of zzCal_Object to bValue
            End_Procedure        
        End_Object

        //---------------------------------------------------------------------

        Object o_pbMonthViewCompressWeekendDays is a cSigCJPropertyGridItem
            Set psLabel to "Compress Weekend Days"
            Set psHelpText to 'Specifies whether Saturday and Sunday are "compressed" while in Month view.'
            Set peItemType to ePGItype_Boolean
            Set pvInitialValue to (If(pbMonthViewCompressWeekendDays(zzCal_Object),"True","False"))  

            Procedure OnChange
                Boolean bValue
            
                Get pvValue to bValue
                Set pbMonthViewCompressWeekendDays of zzCal_Object to bValue
            End_Procedure        
        End_Object

        //---------------------------------------------------------------------

