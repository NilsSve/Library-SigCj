        Object o_pbSwitchToDayViewIfPickedSingleDay is a cSigCJPropertyGridItem
            Set psLabel to "Switch to Day View"
            Set psHelpText to "Specifies whether to switch to day view when a day is selected in the date picker."
            Set peItemType to ePGItype_Boolean
            Set pvInitialValue to (If(pbSwitchToDayViewIfPickedSingleDay(zzCal_Object),"True","False"))  

