            End_Procedure        
        End_Object

        //---------------------------------------------------------------------

        Object o_pbMarkupEnabled is a cSigCJPropertyGridItem
            Set psLabel to "Markup Enabled"
            Set psHelpText to "Allows the use of a XAML snippet to be used to display text in events\appointments."
            Set peItemType to ePGItype_Boolean
            Set pvInitialValue to (If(pbMarkupEnabled(zzCal_Object),"True","False"))  

            Procedure OnChange
