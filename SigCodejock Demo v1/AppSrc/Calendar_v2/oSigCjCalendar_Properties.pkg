        Object oItem_IPE is a cSigCJPropertyGridItem
            Set psLabel to "Context Menu Text"
            Set psHelpText to "Properties to set the text on context menus."
            Set piValueBackgroundColor to (RGB(234,216,196))
        
            Procedure Private.Create Handle hoParent Boolean bRecursive
                Handle hoCaptionMetrics 
    
                Forward Send Private.Create hoParent bRecursive
                
                Get Private.phoPropertyCaptionMetrics to hoCaptionMetrics
                Set ComBackColor of hoCaptionMetrics to (RGB(234,216,196))
            End_Procedure

            Object o_psCM_CreateEvent is a cSigCJPropertyGridItem
                Set psLabel to "Create Event"
                Set psHelpText to "Text for the Create Event menu item."
                Set peItemType to ePGItype_String
                Set pvInitialValue to (psCM_CreateEvent(zzCal_Object))  
    
                Procedure OnChange
                    String sValue
                
                    Get pvValue to sValue
                    Set psCM_CreateEvent of zzCal_Object to sValue
                End_Procedure        
            End_Object

