                Set pbSwitchToDayViewIfPickedSingleDay of zzCal_Object to bValue
            End_Procedure        
        End_Object

        //---------------------------------------------------------------------

        Object o_peWorkWeekMask is a cSigCJPropertyGridComboFormItem
            Set psLabel to "Working Week"
            Set psHelpText to 'Specifies which days of the week are "work days". Any combination of days can be set'
            Set peItemType to ePGItype_Enum
            Set pvInitialValue to (peWorkWeekMask(zzCal_Object))

            Procedure OnAddLookupItems
                Send AddLookupItem "All Week"  eCal_WW_AllWeek    "" ""  
                Send AddLookupItem "Mon - Fri" eCal_WW_Mo_Fr      "" ""  
                Send AddLookupItem "Sat & Sun" eCal_WW_SaSu       "" ""  
                Send AddLookupItem "Sunday"    eCal_WW_Sunday     "" ""  
                Send AddLookupItem "Monday"    eCal_WW_Monday     "" ""                      
                Send AddLookupItem "Tuesday"   eCal_WW_Tuesday    "" ""                      
                Send AddLookupItem "Wednesday" eCal_WW_Wednesday  "" ""                      
                Send AddLookupItem "Thursday"  eCal_WW_Thursday   "" ""                      
                Send AddLookupItem "Friday"    eCal_WW_Friday     "" ""                      
                Send AddLookupItem "Saturday"  eCal_WW_Saturday   "" ""                      
            End_Procedure

            Procedure OnChange
                String sValue
            
                Get pvValue to sValue
                Set peWorkWeekMask of zzCal_Object to sValue
            End_Procedure        
        End_Object

    End_Object 
 
