//    Writeln "dLastMod_Date     = |" tEvent.dLastMod_Date      "|"
//    Writeln "tmLastMod_Time    = |" tEvent.tmLastMod_Time     "|"
//    Writeln "sLocation         = |" tEvent.sLocation          "|"
//    Writeln "bMeetingFlag      = |" tEvent.bMeetingFlag       "|"
//    Writeln "bPrivateFlag      = |" tEvent.bPrivateFlag       "|"
//    Writeln "eRecurr_State     = |" tEvent.eRecurr_State      "|"
//    Writeln "bReminder         = |" tEvent.bReminder          "|"
//    Writeln "iRem_MinsBefore   = |" tEvent.iRem_MinsBefore    "|"
//    Writeln "sRem_SoundFile    = |" tEvent.sRem_SoundFile     "|"
//    Writeln "iScheduleID       = |" tEvent.iScheduleID        "|"
//    Writeln "sScheduleIDs      = |" tEvent.sScheduleIDs       "|"
