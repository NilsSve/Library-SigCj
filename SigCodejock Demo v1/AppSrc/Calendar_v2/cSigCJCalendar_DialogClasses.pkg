End_Class

//==============================================================================
//A Time picker control with spin buttons.
//This is based on the CJ DateTimePicker but only supports Time formats. It 
//supports formats with fixed seconds (00 & 59) and returns the time as a string 
//in the formatted HH:MM:SS as reguired by the Calendar class.

Enum_List
    Define eDTP_HM for 1
    Define eDTP_HMS
    Define eDTP_HM00
    Define eDTP_HM59
End_Enum_List


{ OverrideProperty=Size InitialValue=13,47 }
Class cSigCJCalendar_TimePicker is a cSigCjComDateTimePicker
    Import_Class_Protocol cSigCJMethods_Mixin
    
    Procedure Construct_Object
        Forward Send Construct_Object
        
        Set Size to 13 47
        
        Property Integer pbAutoSize True
        
        Property Boolean Private_pb24Hour       True
        Property Boolean Private_pbEnabled      True
        Property Integer Private_peFormat       eDTP_HMS
        Property String  Private_psTime_Value
    End_Procedure

    Procedure End_Construct_Object
        Forward Send End_Construct_Object
    End_Procedure

    Procedure OnCreate
        Forward Send OnCreate
        
        Send Set_Time_Format
        Set Time_Value to (Private_psTime_Value(Self))
        Set ComEnabled to (Enabled_State(Self))
        Set ComEnabled to (Private_pbEnabled(Self)) 
    End_Procedure

    //=========================================================================

    { MethodType=Property Category="SigCj:Calendar" InitialValue=True }
    Procedure Set pbEnabled Boolean bValue
        Set Private_pbEnabled to bValue
        If (IsComObjectCreated(Self)) Begin
            Set ComEnabled to bValue
        End
    End_Procedure

    Function pbEnabled Returns Boolean
        If (IsComObjectCreated(Self)) Function_Return (ComEnabled(Self))
        Else                          Function_Return (Private_pbEnabled(Self))
    End_Function

    //=========================================================================
    
    Procedure Set_Time_Format
        Integer eTimeFormat 
        String sTimeFormat
        
        If (IsComObjectCreated(Self)) Begin
            Get Private_peFormat to eTimeFormat
            If (eTimeFormat = eDTP_HM  ) Move "hh:mm"    to sTimeFormat
            If (eTimeFormat = eDTP_HMS ) Move "hh:mm:ss" to sTimeFormat
            If (eTimeFormat = eDTP_HM00) Move "hh:mm:00" to sTimeFormat
            If (eTimeFormat = eDTP_HM59) Move "hh:mm:59" to sTimeFormat
    
            If (Private_pb24Hour(Self)) Move (Replace("hh", sTimeFormat, "HH")) to sTimeFormat
    
            Set ComFormat to OLExtpPickerCustom 
            Set ComCustomFormat to sTimeFormat         
            Set ComUpDown to True

            If (pbAutoSize(Self)) Begin
                If (eTimeFormat = eDTP_HM) Set Size to 13 37
                Else                       Set Size to 13 47
            End
        End
    End_Procedure

    //-------------------------------------------------------------------------

    { MethodType=Property Category="SigCj:Calendar" InitialValue=True }
    Procedure Set pb24Hour Boolean bValue
        Set Private_pb24Hour to bValue
        Send Set_Time_Format
    End_Procedure

    Function pb24Hour Returns Boolean
        Function_Return (Private_pb24Hour(Self))
    End_Function

    //-------------------------------------------------------------------------

    { EnumList="eDTP_HM, eDTP_HMS, eDTP_HM00, eDTP_HM59" }
    { MethodType=Property Category="SigCj:Calendar" InitialValue=eDTP_HMS }
    Procedure Set peFormat Integer eFormat
        Set Private_peFormat to eFormat
        Send Set_Time_Format
    End_Procedure

    Function peFormat Returns Integer
        Function_Return (Private_peFormat(Self))
    End_Function

    //==========================================================================
    
    Procedure Set Time_Value String sTime
        Integer eFormat iHour iMinute

        Set Private_psTime_Value to sTime

        If (IsComObjectCreated(Self)) Begin
            Move (Left(sTime,2))  to iHour
            Move (Mid(sTime,2,4)) to iMinute              
            Set ComHour   to iHour
            Set ComMinute to iMinute
    
            Get peFormat to eFormat
            If (eFormat = eDTP_HM  ) Set ComSecond to 0
            If (eFormat = eDTP_HMS ) Set ComSecond to (Right(sTime,2))
            If (eFormat = eDTP_HM00) Set ComSecond to 0
            If (eFormat = eDTP_HM59) Begin
                Set ComSecond to 59
                If (iMinute > 0) Begin
                    Set ComMinute to (iMinute - 1)
                End
                Else Begin
                    Set ComMinute to 59
                    If (iHour > 0) Set ComHour to (iHour - 1)
                End
            End
        End
    End_Procedure

    Function Time_Value Returns String 
        Integer iValue eFormat
        String sTime

        If (IsComObjectCreated(Self)) Begin
            Move "" to sTime        
    
            Get ComHour to iValue
            If (iValue < 10) Append sTime "0"
            Append sTime iValue ":"
            
            Get ComMinute to iValue
            If (iValue < 10) Append sTime "0"
            Append sTime iValue ":"
    
            Get peFormat to eFormat
            If (eFormat = eDTP_HM  ) Append sTime "00"
            If (eFormat = eDTP_HM00) Append sTime "00"
            If (eFormat = eDTP_HM59) Append sTime "59"
            If (eFormat = eDTP_HMS ) Begin
                Get ComSecond to iValue
                If (iValue < 10) Append sTime "0"
                Append sTime iValue ":"
            End
        End
        Else Begin
            Move "00:00:00" to sTime
        End
        
        Function_Return sTime
    End_Function
End_Class

