            tdSigCjCal_Dialog_Info tDialogInfo
            
            Get ptDialogInfo to tDialogInfo
            Get Show_Dialog of oSigCjCalendar_RecPattern_Panel tDialogInfo.tDialog_RecPattern to tDialogInfo.tDialog_RecPattern
            If ((tDialogInfo.tDialog_RecPattern.eAction <> eCal_Dialog_Action_None  )  and ;
                (tDialogInfo.tDialog_RecPattern.eAction <> eCal_Dialog_Action_Exists)) Begin
                Move tDialogInfo.tEvent.iID to tDialogInfo.tDialog_RecPattern.tRecPattern.iMasterEventId
                Set ptDialogInfo to tDialogInfo
            End
        End_Procedure
    End_Object

