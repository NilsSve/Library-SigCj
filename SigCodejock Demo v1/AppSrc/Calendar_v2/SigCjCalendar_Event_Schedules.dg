    Object oAllDayEvent is a CheckBox
        Set Size to 10 50
        Set Location to 46 158
        Set Label to "All Day Event"
        Set AlignmentMode to taLeftJustify

        Procedure OnChange
            If (Checked_State(Self)) Begin
                Set pbEnabled of oStartTime to False
                Set pbEnabled of oEndTime   to False
            End
            Else Begin
                Set pbEnabled of oStartTime to True
                Set pbEnabled of oEndTime   to True
            End
        End_Procedure
    End_Object

