Use DFClient.pkg
Use DFSelLst.pkg
Use Windows.pkg
Use cdbCJGridPromptList.pkg


Class cSigCjCJGridPromptList is a cDbCJGridPromptList
    
    Procedure Construct_Object
        Forward Send Construct_Object
        
        Set peAnchors to anAll
        Set phoPromptList to (Self) 
    End_Procedure // Construct_Object
    
    Procedure End_Construct_Object
        Forward Send End_Construct_Object
        
        Send OnLoad_Columns 
    End_Procedure // End_Construct_Object     
    
    // Hook 
    Procedure OnLoad_Columns 
    End_Procedure

    Function Add_Column Integer iFile Integer iField Integer iWidth String sCaption Returns Handle    
        Handle hoColumn
        
        Get Create (RefClass(cDbCJGridColumn)) to hoColumn
        Send Bind_Data of hoColumn iFile iField
        Set  psCaption of hoColumn to sCaption
        Set  piWidth   of hoColumn to iWidth
        Function_Return hoColumn
    End_Function  // Add_Column
    
End_Class // cSigCjdbPromptList
