Use  Windows           // Basic Definitions
Use  DataDict.pkg          // DataDictionary Class Definition
Use  DDvalTbl          // Validation Table Class Definitions

Open Calevent

//DDB-HeaderEnd

Class CalEvent_DataDictionary  is a DataDictionary

    // Define_Fields:
    // This procedure is used to set up all data-dictionary rules.

    Procedure Define_Fields
        Forward Send Define_Fields
        //DDB-Generated-Code-Location
        //DDB-DefineFieldStart

        Set Main_File            To Calevent.File_Number

        Set Foreign_Field_Options  DD_KEYFIELD   To DD_AUTOFIND    DD_NOPUT       DD_FINDREQ    
        Set Foreign_Field_Options  DD_INDEXFIELD To DD_NOPUT       DD_FINDREQ    
        Set Foreign_Field_Options  DD_DEFAULT    To DD_DISPLAYONLY

        // Field-based properties.......................

        // Calevent.Urn

        // Calevent.Alldayevent

        // Calevent.Body

        // Calevent.Busystatus

        // Calevent.Categories

        // Calevent.Creationdate

        // Calevent.Creationtime

        // Calevent.Customicons

        // Calevent.Customprop

        // Calevent.Enddate

        // Calevent.Endtime

        // Calevent.Importance

        // Calevent.Label

        // Calevent.Lastmod_Date

        // Calevent.Lastmod_Time

        // Calevent.Location

        // Calevent.Meetingflag

        // Calevent.Privateflag

        // Calevent.Recurr_State

        // Calevent.Reminder

        // Calevent.Rem_Minsbefore

        // Calevent.Rem_Soundfile

        // Calevent.Scheduleid

        // Calevent.Startdate

        // Calevent.Starttime

        // Calevent.Subject

        // Calevent.Re_Startdateorg

        // Calevent.Re_Starttimeorg

        // Calevent.Re_Enddateorg

        // Calevent.Re_Endtimeorg

        // Calevent.Re_Deleted

        // Calevent.Rec_Pattern_Id

        //DDB-DefineFieldEnd
    End_Procedure    // Define_Fields

    // Field_Defaults:
    // This procedure is used to establish default field values.

    Procedure Field_Defaults
        Forward Send Field_Defaults
        //DDB-Generated-Code-Location
        //DDB-FieldDefaultStart
        //DDB-FieldDefaultEnd
    End_Procedure    // Field_Defaults

End_Class    // CalEvent_DataDictionary
//DDB-FileEnd
