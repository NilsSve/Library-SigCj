CompilerWarnings Suspend

//==============================================================================
// NOTE
// ====
// This control has been moved from the SigCjW_Controls.pkg package as we need a
// data aware version as well.
//==============================================================================

Use FlexCom20.pkg
Use cComDbActiveXControl.pkg
Use SigCjLicense.pkg
Use SigCjC_AlignmentStyle.pkg
Use SigCjC_Drag_Drop.pkg
Use SigCjW_Controls.pkg

// NOTE (SigCj for DF26): cSigCjCom_DCheckBox, cSigCjCom_DCheckBoxEvents and
// cSigCjComCheckBox used to be declared here AND in SigCjW_Controls.pkg - both
// are generated from Codejock.Controls - so any program reaching both files got
// 4345/4332 and a cascade of 4297. The three duplicates (and the Define blocks
// that came with them) are gone; SigCjW_Controls.pkg is the single source, and
// is Used above because cSigCjComDbCheckBox imports two of its mixins.
// cSigCjComDbCheckBox is NOT in SigCjW_Controls.pkg, which is why this file stays.
//==============================================================================

// CheckBox Control
{ CLSID=L_cSigCjComCheckBox }
Class cSigCjComDbCheckBox is a cComDbActiveXControl
    Import_Class_Protocol cSigCjCom_DCheckBox
    Import_Class_Protocol cSigCjCom_DCheckBoxEvents

    Procedure Construct_Object
        Forward Send Construct_Object
        Set psProgID to L_cSigCjComCheckBox
        Set psEventId to "{C0DE2430-08CC-4B3D-82EA-3B7BE0CF1117}"
        Set psLicenseKey to L_cSigCjKeyControls
        Set peAutoCreate to acDeferredAutoCreate
        //Connect the default bindable property
        Send RegisterPropertyChangeEvent 0 msg_OnControlValueChanged
    End_Procedure

    Function ControlValue Returns String
        //Associate the default bindable property with Get Value
        String retVal
        Get ComValue to retVal
        Function_Return retVal
    End_Function

    Procedure Set ControlValue String sVal
        //Associate the default bindable property with Set Value
        Set ComValue to sVal
    End_Procedure
End_Class

//==============================================================================
//End of package - SigCjW_CheckBox.pkg
//==============================================================================
