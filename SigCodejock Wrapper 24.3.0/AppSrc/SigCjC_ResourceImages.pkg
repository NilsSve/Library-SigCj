//CompilerWarnings Suspend

Use FlexCom20.pkg

Class cSigCjComIResourceImageList is a cComAutomationObject

    Function ComAddBitmap OLE_HANDLE llHandle Integer llnID Returns Boolean
        Handle hDispatchDriver
        Boolean retVal
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 2
        Send DefineParam to hDispatchDriver OLE_VT_I4 llHandle
        Send DefineParam to hDispatchDriver OLE_VT_I4 llnID
        Get InvokeComMethod of hDispatchDriver 1 OLE_VT_BOOL to retVal
        Function_Return retVal
    End_Function

    Function ComLoadBitmap String llPath Integer llnID Returns Boolean
        Handle hDispatchDriver
        Boolean retVal
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 2
        Send DefineParam to hDispatchDriver OLE_VT_BSTR llPath
        Send DefineParam to hDispatchDriver OLE_VT_I4 llnID
        Get InvokeComMethod of hDispatchDriver 2 OLE_VT_BOOL to retVal
        Function_Return retVal
    End_Function

    Function ComRemove Integer llnID Returns Boolean
        Handle hDispatchDriver
        Boolean retVal
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 1
        Send DefineParam to hDispatchDriver OLE_VT_I4 llnID
        Get InvokeComMethod of hDispatchDriver 3 OLE_VT_BOOL to retVal
        Function_Return retVal
    End_Function

    Procedure ComRemoveAll
        Handle hDispatchDriver
        Get phDispatchDriver to hDispatchDriver
        Send InvokeComMethod to hDispatchDriver 4 OLE_VT_VOID
    End_Procedure
End_Class

Class cSigCjComResourceImages is a cComAutomationObject

    Function ComLoadFromFile String llDllFileName String llIniFileName Returns Boolean
        Handle hDispatchDriver
        Boolean retVal
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 2
        Send DefineParam to hDispatchDriver OLE_VT_BSTR llDllFileName
        Send DefineParam to hDispatchDriver OLE_VT_BSTR llIniFileName
        Get InvokeComMethod of hDispatchDriver 1 OLE_VT_BOOL to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Function ComDllFileName Returns String
        Handle hDispatchDriver
        String retVal
        Get phDispatchDriver to hDispatchDriver
        Get InvokeComMethod of hDispatchDriver 2 OLE_VT_BSTR to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Function ComIniFileName Returns String
        Handle hDispatchDriver
        String retVal
        Get phDispatchDriver to hDispatchDriver
        Get InvokeComMethod of hDispatchDriver 3 OLE_VT_BSTR to retVal
        Function_Return retVal
    End_Function

    Function ComGetColor String llSection String llKeyName Returns OLE_COLOR
        Handle hDispatchDriver
        OLE_COLOR retVal
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 2
        Send DefineParam to hDispatchDriver OLE_VT_BSTR llSection
        Send DefineParam to hDispatchDriver OLE_VT_BSTR llKeyName
        Get InvokeComMethod of hDispatchDriver 4 OLE_VT_I4 to retVal
        Function_Return retVal
    End_Function
End_Class

