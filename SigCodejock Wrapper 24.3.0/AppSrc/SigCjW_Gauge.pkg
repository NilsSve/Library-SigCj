// Event interface for Gauge Control
Class cSigCjCom_DGaugeEvents is a Mixin

    { MethodType=Event }
    Procedure OnComGaugeUpdated Variant llGaugeType
    End_Procedure

    { MethodType=Event }
    Procedure OnComReCreated
    End_Procedure

    { Visibility=Private }
    Procedure RegisterComEvents
        Send RegisterComEvent 1 msg_OnComGaugeUpdated
        Send RegisterComEvent 10001000 msg_OnComReCreated
    End_Procedure
End_Class

// Xtreme Gauge Control
{ CLSID=L_cSigCjComGauge }
Class cSigCjComGauge is a cComActiveXControl
    Import_Class_Protocol cSigCjComIGauge
    Import_Class_Protocol cSigCjCom_DGaugeEvents

    Procedure Construct_Object
        Forward Send Construct_Object
        Set psProgID to L_cSigCjComGauge
        Set psEventId to "{C0DE2400-446A-4925-94B6-F938563E4E9E}"
        Set psLicenseKey to L_cSigCjKeyGauge
        Set peAutoCreate to acDeferredAutoCreate
    End_Procedure
End_Class

