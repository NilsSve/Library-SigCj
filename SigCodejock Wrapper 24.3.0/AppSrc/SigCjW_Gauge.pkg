// Dispatch interface for Gauge traits collection type
Class cSigCjComIGaugeTraits is a Mixin

    { MethodType=Property DesignTime=False }
    Function ComTraitsArgument Returns String
        String retVal
        Get ComProperty of (phDispatchDriver(Self)) 1001 OLE_VT_BSTR to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComTraitsArgument String value
        Set ComProperty of (phDispatchDriver(Self)) 1001 OLE_VT_BSTR to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComResourcePath Returns String
        String retVal
        Get ComProperty of (phDispatchDriver(Self)) 1002 OLE_VT_BSTR to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComResourcePath String value
        Set ComProperty of (phDispatchDriver(Self)) 1002 OLE_VT_BSTR to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComResourceModule Returns OLE_HANDLE
        OLE_HANDLE retVal
        Get ComProperty of (phDispatchDriver(Self)) 1003 OLE_VT_I4 to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComResourceModule OLE_HANDLE value
        Set ComProperty of (phDispatchDriver(Self)) 1003 OLE_VT_I4 to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComResourceNamespace Returns String
        String retVal
        Get ComProperty of (phDispatchDriver(Self)) 1004 OLE_VT_BSTR to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComResourceNamespace String value
        Set ComProperty of (phDispatchDriver(Self)) 1004 OLE_VT_BSTR to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComTraitsData Returns String
        Handle hDispatchDriver
        String retVal
        Get phDispatchDriver to hDispatchDriver
        Get InvokeComMethod of hDispatchDriver 1000 OLE_VT_BSTR to retVal
        Function_Return retVal
    End_Function

    Procedure ComLoad Variant llSource Variant llArg
        Handle hDispatchDriver
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 2
        Send DefineParam to hDispatchDriver OLE_VT_VARIANT llSource
        Send DefineParam to hDispatchDriver OLE_VT_VARIANT llArg
        Send InvokeComMethod to hDispatchDriver 2000 OLE_VT_VOID
    End_Procedure

    Function ComGetCustomTrait String llJsonPath Returns Variant
        Handle hDispatchDriver
        Variant retVal
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 1
        Send DefineParam to hDispatchDriver OLE_VT_BSTR llJsonPath
        Get InvokeComMethod of hDispatchDriver 2001 OLE_VT_VARIANT to retVal
        Function_Return retVal
    End_Function

    Procedure ComSetCustomTrait String llJsonPath Variant llValue
        Handle hDispatchDriver
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 2
        Send DefineParam to hDispatchDriver OLE_VT_BSTR llJsonPath
        Send DefineParam to hDispatchDriver OLE_VT_VARIANT llValue
        Send InvokeComMethod to hDispatchDriver 2002 OLE_VT_VOID
    End_Procedure
End_Class

// Xtreme Gauge Traits Collection
