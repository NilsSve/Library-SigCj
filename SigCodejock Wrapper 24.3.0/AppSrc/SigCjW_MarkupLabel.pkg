Class cSigCjCom_DMarkupLabelEvents is a Mixin

    { MethodType=Event }
    Procedure OnComReCreated
    End_Procedure

    { Visibility=Private }
    Procedure RegisterComEvents
        Send RegisterComEvent 10001000 msg_OnComReCreated
    End_Procedure
End_Class

// MarkupLabel Control
{ CLSID=L_cSigCjComMarkupLabel }
Class cSigCjComMarkupLabel is a cComActiveXControl
    Import_Class_Protocol cSigCjCom_DMarkupLabel
    Import_Class_Protocol cSigCjCom_DMarkupLabelEvents

    Procedure Construct_Object
        Forward Send Construct_Object
        Set psProgID to L_cSigCjComMarkupLabel
        Set psEventId to "{C0DE2400-6B68-4E54-BC24-2F891C6C2167}"
        Set psLicenseKey to L_cSigCjKeyMarkupLabel
        Set peAutoCreate to acDeferredAutoCreate
    End_Procedure
End_Class

