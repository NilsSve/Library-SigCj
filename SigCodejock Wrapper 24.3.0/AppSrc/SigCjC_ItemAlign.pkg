//CompilerWarnings Suspend

Use FlexCom20.pkg

Define OLEXTPItemAlignment for Integer
    Define OLEDT_TOP for 0
    Define OLEDT_LEFT for 0
    Define OLEDT_CENTER for 1
    Define OLEDT_RIGHT for 2
    Define OLEDT_VCENTER for 4
    Define OLEDT_BOTTOM for 8
    Define OLEDT_WORDBREAK for 16
    Define OLEDT_SINGLELINE for 32
    Define OLEDT_END_ELLIPSIS for 32768

