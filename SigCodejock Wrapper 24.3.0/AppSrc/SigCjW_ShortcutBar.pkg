    Function ComAddItem Integer llId String llCaption Integer llhWnd Returns Variant
        Handle hDispatchDriver
        Variant retVal
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 3
        Send DefineParam to hDispatchDriver OLE_VT_I4 llId
        Send DefineParam to hDispatchDriver OLE_VT_BSTR llCaption
        Send DefineParam to hDispatchDriver OLE_VT_I4 llhWnd
        Get InvokeComMethod of hDispatchDriver 2 OLE_VT_DISPATCH to retVal
        Function_Return retVal
    End_Function

    Procedure ComAddImageList Variant llImageList
        Handle hDispatchDriver
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 1
        Send DefineParam to hDispatchDriver OLE_VT_DISPATCH llImageList
        Send InvokeComMethod to hDispatchDriver 3 OLE_VT_VOID
    End_Procedure

    Procedure ComRemoveItem Integer llId
        Handle hDispatchDriver
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 1
        Send DefineParam to hDispatchDriver OLE_VT_I4 llId
        Send InvokeComMethod to hDispatchDriver 7 OLE_VT_VOID
    End_Procedure

    Procedure ComRemoveAllItems
        Handle hDispatchDriver
        Get phDispatchDriver to hDispatchDriver
