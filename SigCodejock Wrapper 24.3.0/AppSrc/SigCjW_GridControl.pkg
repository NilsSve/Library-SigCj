// Track Control
{ CLSID=L_cSigCjComTrackControl }
Class cSigCjComTrackControl is a cComActiveXControl
    Import_Class_Protocol cSigCjCom_DTrackControl
    Import_Class_Protocol cSigCjCom_DTrackControlEvents

    Procedure Construct_Object
        Forward Send Construct_Object
        Set psProgID to L_cSigCjComTrackControl
        Set psEventId to "{C0DE2400-B010-4B1F-9713-B426EEDD55E0}"
        Set psLicenseKey to L_cSigCjKeyGridControl
        Set peAutoCreate to acDeferredAutoCreate
    End_Procedure
End_Class

