//CompilerWarnings Suspend

Use FlexCom20.pkg

Class cSigCjComXtremePrinterInfo is a cComAutomationObject

    { MethodType=Property DesignTime=False }
    Function ComDeviceName Returns String
        Handle hDispatchDriver
        String retVal
        Get phDispatchDriver to hDispatchDriver
        Get InvokeComMethod of hDispatchDriver 1 OLE_VT_BSTR to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Function ComDriverName Returns String
        Handle hDispatchDriver
        String retVal
        Get phDispatchDriver to hDispatchDriver
        Get InvokeComMethod of hDispatchDriver 2 OLE_VT_BSTR to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Function ComPortName Returns String
        Handle hDispatchDriver
        String retVal
        Get phDispatchDriver to hDispatchDriver
        Get InvokeComMethod of hDispatchDriver 3 OLE_VT_BSTR to retVal
        Function_Return retVal
    End_Function
End_Class

Class cSigCjComXtremePrintPreviewOptions is a cComAutomationObject

    { MethodType=Property DesignTime=False }
    Function ComTitle Returns String
        String retVal
        Get ComProperty of (phDispatchDriver(Self)) 1 OLE_VT_BSTR to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComTitle String value
        Set ComProperty of (phDispatchDriver(Self)) 1 OLE_VT_BSTR to value
    End_Procedure
End_Class

Class cSigCjComPrintPageHeaderFooter is a cComAutomationObject

    { MethodType=Property DesignTime=False }
    Function ComFont Returns Variant
        Variant retVal
        Get ComProperty of (phDispatchDriver(Self)) -512 OLE_VT_DISPATCH to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComFont Variant value
        Set ComProperty of (phDispatchDriver(Self)) -512 OLE_VT_DISPATCH to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComFormatString Returns String
        String retVal
        Get ComProperty of (phDispatchDriver(Self)) 1 OLE_VT_BSTR to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComFormatString String value
        Set ComProperty of (phDispatchDriver(Self)) 1 OLE_VT_BSTR to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComTextLeft Returns String
        String retVal
        Get ComProperty of (phDispatchDriver(Self)) 2 OLE_VT_BSTR to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComTextLeft String value
        Set ComProperty of (phDispatchDriver(Self)) 2 OLE_VT_BSTR to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComTextCenter Returns String
        String retVal
        Get ComProperty of (phDispatchDriver(Self)) 3 OLE_VT_BSTR to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComTextCenter String value
        Set ComProperty of (phDispatchDriver(Self)) 3 OLE_VT_BSTR to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComTextRight Returns String
        String retVal
        Get ComProperty of (phDispatchDriver(Self)) 4 OLE_VT_BSTR to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComTextRight String value
        Set ComProperty of (phDispatchDriver(Self)) 4 OLE_VT_BSTR to value
    End_Procedure

    Procedure ComClear
        Handle hDispatchDriver
        Get phDispatchDriver to hDispatchDriver
        Send InvokeComMethod to hDispatchDriver 50 OLE_VT_VOID
    End_Procedure
End_Class

Class cSigCjComPrintInfo is a cComAutomationObject

    { MethodType=Property DesignTime=False }
    Function ComContinuePrinting Returns Boolean
        Boolean retVal
        Get ComProperty of (phDispatchDriver(Self)) 1 OLE_VT_BOOL to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComContinuePrinting Boolean value
        Set ComProperty of (phDispatchDriver(Self)) 1 OLE_VT_BOOL to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComMaxPage Returns Integer
        Integer retVal
        Get ComProperty of (phDispatchDriver(Self)) 2 OLE_VT_I4 to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComMaxPage Integer value
        Set ComProperty of (phDispatchDriver(Self)) 2 OLE_VT_I4 to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComPreviewMode Returns Boolean
        Handle hDispatchDriver
        Boolean retVal
        Get phDispatchDriver to hDispatchDriver
        Get InvokeComMethod of hDispatchDriver 3 OLE_VT_BOOL to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Function ComCurrentPage Returns Integer
        Handle hDispatchDriver
        Integer retVal
        Get phDispatchDriver to hDispatchDriver
        Get InvokeComMethod of hDispatchDriver 4 OLE_VT_I4 to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Function ComPrintRectLeft Returns Integer
        Handle hDispatchDriver
        Integer retVal
        Get phDispatchDriver to hDispatchDriver
        Get InvokeComMethod of hDispatchDriver 5 OLE_VT_I4 to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Function ComPrintRectTop Returns Integer
        Handle hDispatchDriver
        Integer retVal
        Get phDispatchDriver to hDispatchDriver
        Get InvokeComMethod of hDispatchDriver 6 OLE_VT_I4 to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Function ComPrintRectRight Returns Integer
        Handle hDispatchDriver
        Integer retVal
        Get phDispatchDriver to hDispatchDriver
        Get InvokeComMethod of hDispatchDriver 7 OLE_VT_I4 to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Function ComPrintRectBottom Returns Integer
        Handle hDispatchDriver
        Integer retVal
        Get phDispatchDriver to hDispatchDriver
        Get InvokeComMethod of hDispatchDriver 8 OLE_VT_I4 to retVal
        Function_Return retVal
    End_Function
End_Class

