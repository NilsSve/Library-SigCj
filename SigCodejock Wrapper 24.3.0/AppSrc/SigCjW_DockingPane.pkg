// Visual Theme  Constants
Define OLEVisualTheme for Integer
    // ThemeDefault
    Define OLEThemeDefault for 0
    // ThemeOffice
    Define OLEThemeOffice for 1
    // ThemeOffice2003
    Define OLEThemeOffice2003 for 2
    // ThemeNativeWinXP
    Define OLEThemeNativeWinXP for 3
    // ThemeGrippered
    Define OLEThemeGrippered for 4
    // ThemeVisio
    Define OLEThemeVisio for 5
    // ThemeWhidbey
    Define OLEThemeWhidbey for 6
    // ThemeShortcutBar2003
    Define OLEThemeShortcutBar2003 for 7
    // ThemeExplorer
    Define OLEThemeExplorer for 8
    // ThemeVisualStudio2005
    Define OLEThemeVisualStudio2005 for 9
    // ThemeResource
    Define OLEThemeResource for 10
    // ThemeWord2007
    Define OLEThemeWord2007 for 11
    // ThemeOutlook2007
    Define OLEThemeOutlook2007 for 12
    // ThemeVisualStudio6
    Define OLEThemeVisualStudio6 for 13
    // ThemeVisualStudio2005Beta2
    Define OLEThemeVisualStudio2005Beta2 for 14
    // ThemeVisualStudio2005Beta2
    Define OLEThemeVisualStudio2008 for 15
    // ThemeVisualStudio2010
    Define OLEThemeVisualStudio2010 for 16
    // ThemeOffice2003Visio
    Define OLEThemeOffice2003Visio for 17
    // ThemeOffice2007Visio
    Define OLEThemeOffice2007Visio for 18
    // ThemeOffice2013
    Define OLEThemeOffice2013 for 19
    // ThemeOffice2016
    Define OLEThemeOffice2016 for 19
    // ThemeVisualStudio2012
    Define OLEThemeVisualStudio2012 for 20
    // ThemeVisualStudio2015
    Define OLEThemeVisualStudio2015 for 21
    // ThemeNativeWindows10
    Define OLEThemeNativeWindows10 for 22
    // ThemeVisualStudio2017
    Define OLEThemeVisualStudio2017 for 23
    // ThemeVisualStudio2019
    Define OLEThemeVisualStudio2019 for 24
    // ThemeVisualStudio2022
    Define OLEThemeVisualStudio2022 for 25
    // ThemeNativeWindows11
    Define OLEThemeNativeWindows11 for 26

// Visual Theme  Constants
Define OLEDockingDirection for Integer
    // To dock Pane left of another one
    Define OLEDockLeftOf for 0
    // To dock Pane right of another one
    Define OLEDockRightOf for 1
    // To dock Pane top of another one
    Define OLEDockTopOf for 2
    // To dock Pane bottom of another one
    Define OLEDockBottomOf for 3

// Pane Options
Define OLEPaneOptions for Integer
    // The Pane can not be closed
    Define OLEPaneNoCloseable for 1
    // The Pane can not be hidden
    Define OLEPaneNoHideable for 2
    // The Pane can not be floated
    Define OLEPaneNoFloatable for 4
    // The Pane hasn't caption
    Define OLEPaneNoCaption for 8
    // The Pane has menu button in caption
    Define OLEPaneHasMenuButton for 16
    // The Pane can't be docked
    Define OLEPaneNoDockable for 32

// Sticker Styles
Define OLEDockingContextStickerStyle for Integer
    Define OLEStickerStyleWhidbey for 0
    Define OLEStickerStyleVisualStudio2005 for 1
    Define OLEStickerStyleVisualStudio2008 for 2
    Define OLEStickerStyleVisualStudio2010 for 3
    Define OLEStickerStyleVisualStudio2012Light for 4
    Define OLEStickerStyleVisualStudio2012Dark for 5
    Define OLEStickerStyleVisualStudio2015Blue for 6
    Define OLEStickerStyleVisualStudio2015Light for 7
    Define OLEStickerStyleVisualStudio2015Dark for 8
    Define OLEStickerStyleVisualStudio2017Blue for 9
    Define OLEStickerStyleVisualStudio2017BlueExtra for 10
    Define OLEStickerStyleVisualStudio2017Light for 11
    Define OLEStickerStyleVisualStudio2017Dark for 12
    Define OLEStickerStyleVisualStudio2019Blue for 13
    Define OLEStickerStyleVisualStudio2019BlueExtra for 14
    Define OLEStickerStyleVisualStudio2019Light for 15
    Define OLEStickerStyleVisualStudio2019Dark for 16
    Define OLEStickerStyleVisualStudio2022Blue for 17
    Define OLEStickerStyleVisualStudio2022BlueExtra for 18
    Define OLEStickerStyleVisualStudio2022Light for 19
    Define OLEStickerStyleVisualStudio2022Dark for 20

// Splitter Style
Define OLEDockingPaneSplitterStyle for Integer
    Define OLEPaneSplitterFlat for 0
    Define OLEPaneSplitter3D for 1
    Define OLEPaneSplitterSoft3D for 2
    Define OLEPaneSplitterGradient for 4
    Define OLEPaneSplitterGripperOfficeXP for 256
    Define OLEPaneSplitterGripperOffice2003 for 512

// Caption Button Style
Define OLEDockingPaneCaptionButtonStyle for Integer
    Define OLEPaneCaptionButtonDefault for 0
    Define OLEPaneCaptionButtonOffice for 1
    Define OLEPaneCaptionButtonOffice2003 for 2
    Define OLEPaneCaptionButtonThemedExplorerBar for 3
    Define OLEPaneCaptionButtonThemedButton for 4
    Define OLEPaneCaptionButtonThemedToolBar for 5
    Define OLEPaneCaptionButtonThemedToolWindow for 6

// Tab Button Flags
Define OLEDockingPaneTabButtonFlags for Integer
    Define OLEPaneTabButtonNone for 0
    Define OLEPaneTabButtonSelected for 1
    Define OLEPaneTabButtonAlways for 2

// Caption Direction
Define OLEDockingPaneCaptionDirection for Integer
    Define OLEPaneCaptionHorizontal for 0
    Define OLEPaneCaptionVertical for 1
    Define OLEPaneCaptionAutoByPosition for 2
    Define OLEPaneCaptionAutoBySize for 3

// Enable options
Define OLEDockingPaneEnableOptions for Integer
    Define OLEPaneDisabled for 0
    Define OLEPaneEnableClient for 1
    Define OLEPaneEnableActions for 2
    Define OLEPaneEnabled for 3

// Keyboard Navigate options
Define OLEDockingPaneKeyboardNavigate for Integer
    Define OLEPaneKeyboardUnused for 0
    Define OLEPaneKeyboardUseAltMinus for 1
    Define OLEPaneKeyboardUseAltF6 for 2
    Define OLEPaneKeyboardUseAltF7 for 4
    Define OLEPaneKeyboardUseCtrlTab for 8
    Define OLEPaneKeyboardUseAll for 15

// Docking pane type
Define OLEDockingPaneType for Integer
    Define OLEPaneTypeDockingPane for 0
    Define OLEPaneTypeTabbedContainer for 1
    Define OLEPaneTypeSplitterContainer for 2
    Define OLEPaneTypeMiniWnd for 3
    Define OLEPaneTypeClient for 4
    Define OLEPaneTypeAutoHidePanel for 5
    Define OLEPaneTypeSidePanel for 6

// Pane Actions
Define OLEDockingPaneAction for Integer
    // Docking pane is currently floating.  This occurs when the user clicks on the title bar of a docking pane and drags the pane to another location.  When this occurs, the pane is said to be 'floating.'
    Define OLEPaneActionFloating for 0
    // Docking pane has been docked, and is currently floating.
    Define OLEPaneActionFloated for 1
    // Docking pane is currently closing.  This occurs when the close button of the pane is clicked.
    Define OLEPaneActionClosing for 2
    // Docking pane has been closed.  This occurs when the docking pane has finished closing.
    Define OLEPaneActionClosed for 3
    // Docking pane is in the process of docking.
    Define OLEPaneActionDocking for 4
    // Docking pane has been docked.  This occurs when the docking pane has finished docking. 
    Define OLEPaneActionDocked for 5
    // Docking pane is in the process of attaching to another pane.
    Define OLEPaneActionAttaching for 6
    // Docking pane has been attached.  This occurs when the docking pane has finished attaching to another pane.
    Define OLEPaneActionAttached for 7
    // Docking pane is currently pinning (hiding).  This occurs when the 'pin' button is clicked.
    Define OLEPaneActionPinning for 8
    // Docking pane has been pinned.  This occurs when the docking pane has finished pinning.
    Define OLEPaneActionPinned for 9
    // Docking pane is currently collapsing 'hiding'. 
    Define OLEPaneActionCollapsing for 10
    // Docking Pane has been collapsed.   This occurs when the docking pane has finished collapsing.
    Define OLEPaneActionCollapsed for 11
    // Docking pane is currently expanding. 
    Define OLEPaneActionExpanding for 12
    // Docking pane is expanded, this is when the pane is fully shown from the autohide position.
    Define OLEPaneActionExpanded for 13
    // Docking pane become active.
    Define OLEPaneActionActivated for 14
    // Docking pane deactivated.
    Define OLEPaneActionDeactivated for 15
    // Docking pane detaching.
    Define OLEPaneActionDetaching for 16
    // Docking pane dragging.
    Define OLEPaneActionDragging for 17
    // Docking pane unpinning.
    Define OLEPaneActionUnpinning for 18
    // Docking pane unpinned.
    Define OLEPaneActionUnpinned for 19
    // Docking pane resizing.
    Define OLEPaneActionSplitterResizing for 20
    // Docking pane resized.
    Define OLEPaneActionSplitterResized for 21

Class cSigCjComIDockingPaneLayout is a Mixin

    Procedure ComDoPropExchange Variant llpPX
        Handle hDispatchDriver
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 1
        Send DefineParam to hDispatchDriver OLE_VT_DISPATCH llpPX
        Send InvokeComMethod to hDispatchDriver 1 OLE_VT_VOID
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComPanesCount Returns Integer
        Handle hDispatchDriver
        Integer retVal
        Get phDispatchDriver to hDispatchDriver
        Get InvokeComMethod of hDispatchDriver 2 OLE_VT_I4 to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Function ComPane Integer llIndex Returns Variant
        Handle hDispatchDriver
        Variant retVal
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 1
        Send DefineParam to hDispatchDriver OLE_VT_I4 llIndex
        Get InvokeComMethod of hDispatchDriver 0 OLE_VT_DISPATCH to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Function Com_NewEnum Returns Variant
        Handle hDispatchDriver
        Variant retVal
        Get phDispatchDriver to hDispatchDriver
        Get InvokeComMethod of hDispatchDriver -4 OLE_VT_UNKNOWN to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Function ComContainersCount Returns Integer
        Handle hDispatchDriver
        Integer retVal
        Get phDispatchDriver to hDispatchDriver
        Get InvokeComMethod of hDispatchDriver 3 OLE_VT_I4 to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Function ComContainer Integer llIndex Returns Variant
        Handle hDispatchDriver
        Variant retVal
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 1
        Send DefineParam to hDispatchDriver OLE_VT_I4 llIndex
        Get InvokeComMethod of hDispatchDriver 4 OLE_VT_DISPATCH to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Function ComTopContainer Returns Variant
        Handle hDispatchDriver
        Variant retVal
        Get phDispatchDriver to hDispatchDriver
        Get InvokeComMethod of hDispatchDriver 5 OLE_VT_DISPATCH to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Function ComClientContainer Returns Variant
        Handle hDispatchDriver
        Variant retVal
        Get phDispatchDriver to hDispatchDriver
        Get InvokeComMethod of hDispatchDriver 6 OLE_VT_DISPATCH to retVal
        Function_Return retVal
    End_Function
End_Class

Class cSigCjComDockingPaneLayout is a cComAutomationObject
    Import_Class_Protocol cSigCjComIDockingPaneLayout

    Procedure Construct_Object
        Forward Send Construct_Object
        Set peAutoCreate to acNoAutoCreate
    End_Procedure
End_Class

