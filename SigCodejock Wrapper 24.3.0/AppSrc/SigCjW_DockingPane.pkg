Class cSigCjComIDockingPanePaintManager is a Mixin

    { MethodType=Property DesignTime=False }
    Function ComShowCaption Returns Boolean
        Boolean retVal
        Get ComProperty of (phDispatchDriver(Self)) 1 OLE_VT_BOOL to retVal
        Function_Return retVal
    End_Function

