// Event interface for FlowGraph Control
Class cSigCjCom_DFlowGraphEvents is a Mixin

    { MethodType=Event }
    Procedure OnComMouseMove Short llButton Short llShift Integer llx Integer lly
    End_Procedure

    { MethodType=Event }
    Procedure OnComMouseDown Short llButton Short llShift Integer llx Integer lly
    End_Procedure

    { MethodType=Event }
    Procedure OnComMouseUp Short llButton Short llShift Integer llx Integer lly
    End_Procedure

    { MethodType=Event }
    Procedure OnComDblClick
    End_Procedure

    { MethodType=Event }
    Procedure OnComConnectionChanged Variant llConnection Integer llAction
    End_Procedure

    { MethodType=Event }
    Procedure OnComSelectionChanged
    End_Procedure

    { MethodType=Event }
    Procedure OnComPageZoomLevelChanged
    End_Procedure

    { MethodType=Event }
    Procedure OnComPageScrollOffsetChanged
    End_Procedure

    { MethodType=Event }
    Procedure OnComNodeLocationChanged Variant llNode
    End_Procedure

    { MethodType=Event }
    Procedure OnComActivePageChanged
    End_Procedure

    { MethodType=Event }
    Procedure OnComEndLabelEdit Variant llItem String ByRef llNewString Boolean ByRef llCancel
    End_Procedure

    { MethodType=Event }
    Procedure OnComConnectionChanging Variant llConnection Variant llInputConnectionPoint Boolean ByRef llCancel
    End_Procedure

    { MethodType=Event }
    Procedure OnComOLEDragOver Variant llData Integer ByRef llEffect Short llButton Short llShift OLE_XPOS_PIXELS llx OLE_YPOS_PIXELS lly Short llState
    End_Procedure

    { MethodType=Event }
    Procedure OnComOLEDragDrop Variant llData Integer ByRef llEffect Short llButton Short llShift OLE_XPOS_PIXELS llx OLE_YPOS_PIXELS lly
    End_Procedure

    { MethodType=Event }
    Procedure OnComReCreated
    End_Procedure

    { Visibility=Private }
    Procedure RegisterComEvents
        Send RegisterComEvent -606 msg_OnComMouseMove
        Send RegisterComEvent -605 msg_OnComMouseDown
        Send RegisterComEvent -607 msg_OnComMouseUp
        Send RegisterComEvent -601 msg_OnComDblClick
        Send RegisterComEvent 10 msg_OnComConnectionChanged
        Send RegisterComEvent 11 msg_OnComSelectionChanged
        Send RegisterComEvent 12 msg_OnComPageZoomLevelChanged
        Send RegisterComEvent 13 msg_OnComPageScrollOffsetChanged
        Send RegisterComEvent 14 msg_OnComNodeLocationChanged
        Send RegisterComEvent 15 msg_OnComActivePageChanged
        Send RegisterComEvent 16 msg_OnComEndLabelEdit
        Send RegisterComEvent 17 msg_OnComConnectionChanging
        Send RegisterComEvent 300 msg_OnComOLEDragOver
        Send RegisterComEvent 301 msg_OnComOLEDragDrop
        Send RegisterComEvent 10001000 msg_OnComReCreated
    End_Procedure
End_Class

// Xtreme FlowGraph Control
{ CLSID=L_cSigCjComFlowGraph }
Class cSigCjComFlowGraph is a cComActiveXControl
    Import_Class_Protocol cSigCjCom_DFlowGraph
    Import_Class_Protocol cSigCjCom_DFlowGraphEvents

    Procedure Construct_Object
        Forward Send Construct_Object
        Set psProgID to L_cSigCjComFlowGraph
        Set psEventId to "{C0DE2400-2BFB-472D-838F-319731206C8F}"
        Set psLicenseKey to L_cSigCjKeyFlowGraph
        Set peAutoCreate to acDeferredAutoCreate
    End_Procedure
End_Class

