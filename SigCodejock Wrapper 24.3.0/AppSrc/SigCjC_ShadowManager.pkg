    Function ComEnableShadow OLE_HANDLE llhWnd OLE_COLOR llColor Integer llOuterSize Integer llInnerSize Integer llxOffset Integer llyOffset Short llTransparency Returns Variant
        Handle hDispatchDriver
        Variant retVal
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 7
        Send DefineParam to hDispatchDriver OLE_VT_I4 llhWnd
        Send DefineParam to hDispatchDriver OLE_VT_I4 llColor
        Send DefineParam to hDispatchDriver OLE_VT_I4 llOuterSize
        Send DefineParam to hDispatchDriver OLE_VT_I4 llInnerSize
        Send DefineParam to hDispatchDriver OLE_VT_I4 llxOffset
        Send DefineParam to hDispatchDriver OLE_VT_I4 llyOffset
        Send DefineParam to hDispatchDriver OLE_VT_I2 llTransparency
        Get InvokeComMethod of hDispatchDriver 11 OLE_VT_DISPATCH to retVal
        Function_Return retVal
    End_Function

