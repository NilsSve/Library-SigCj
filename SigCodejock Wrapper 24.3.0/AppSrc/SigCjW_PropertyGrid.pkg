// Event interface for PropertyGrid Control
Class cSigCjCom_DPropertyGridEvents is a Mixin

    { MethodType=Event }
    Procedure OnComPropertySortChanged
    End_Procedure

    { MethodType=Event }
    Procedure OnComSelectionChanged Variant llItem
    End_Procedure

    { MethodType=Event }
    Procedure OnComValueChanged Variant llItem
    End_Procedure

    { MethodType=Event }
    Procedure OnComInplaceButtonDown Variant llButton Variant llCancel
    End_Procedure

    { MethodType=Event }
    Procedure OnComDblClick Variant llItem
    End_Procedure

    { MethodType=Event }
    Procedure OnComRClick Variant llItem
    End_Procedure

    { MethodType=Event }
    Procedure OnComVerbClick Variant llVerb
    End_Procedure

    { MethodType=Event }
    Procedure OnComKeyUp Short ByRef llKeyCode Short llShift
    End_Procedure

    { MethodType=Event }
    Procedure OnComKeyDown Short ByRef llKeyCode Short llShift
    End_Procedure

    { MethodType=Event }
    Procedure OnComCancelEdit Variant llItem
    End_Procedure

    { MethodType=Event }
    Procedure OnComRequestEdit Variant llItem Boolean ByRef llCancel
    End_Procedure

    { MethodType=Event }
    Procedure OnComAfterEdit Variant llItem String ByRef llNewValue Boolean ByRef llCancel
    End_Procedure

    { MethodType=Event }
    Procedure OnComExpandChanged Variant llItem
    End_Procedure

    { MethodType=Event }
    Procedure OnComEditChanged Variant llItem String ByRef llText
    End_Procedure

    { MethodType=Event }
    Procedure OnComMouseMove Short llButton Short llShift Integer llx Integer lly
    End_Procedure

    { MethodType=Event }
    Procedure OnComMouseDown Short llButton Short llShift Integer llx Integer lly
    End_Procedure

    { MethodType=Event }
    Procedure OnComMouseUp Short llButton Short llShift Integer llx Integer lly
    End_Procedure

    { MethodType=Event }
    Procedure OnComReCreated
    End_Procedure

    { Visibility=Private }
    Procedure RegisterComEvents
        Send RegisterComEvent 1 msg_OnComPropertySortChanged
        Send RegisterComEvent 2 msg_OnComSelectionChanged
        Send RegisterComEvent 3 msg_OnComValueChanged
        Send RegisterComEvent 4 msg_OnComInplaceButtonDown
        Send RegisterComEvent 5 msg_OnComDblClick
        Send RegisterComEvent 6 msg_OnComRClick
        Send RegisterComEvent 7 msg_OnComVerbClick
        Send RegisterComEvent -604 msg_OnComKeyUp
        Send RegisterComEvent -602 msg_OnComKeyDown
        Send RegisterComEvent 10 msg_OnComCancelEdit
        Send RegisterComEvent 11 msg_OnComRequestEdit
        Send RegisterComEvent 12 msg_OnComAfterEdit
        Send RegisterComEvent 13 msg_OnComExpandChanged
        Send RegisterComEvent 14 msg_OnComEditChanged
        Send RegisterComEvent -606 msg_OnComMouseMove
        Send RegisterComEvent -605 msg_OnComMouseDown
        Send RegisterComEvent -607 msg_OnComMouseUp
        Send RegisterComEvent 10001000 msg_OnComReCreated
    End_Procedure
End_Class

