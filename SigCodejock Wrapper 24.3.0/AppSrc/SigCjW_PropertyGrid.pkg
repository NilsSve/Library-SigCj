//CompilerWarnings Suspend

Use FlexCom20.pkg

Use SigCjLicense.pkg
Use SigCjC_AmbientProperty.pkg
Use SigCjC_ColorManager.pkg
Use SigCjC_ImageManager.pkg
Use SigCjC_ResourceImages.pkg
Use SigCjC_ToolTip.pkg

// Sort Order Connstants
Define OLEPropertySort for Integer
    // Categorized
    Define OLECategorized for 0
    // Alphabetical
    Define OLEAlphabetical for 1
    // NoSort
    Define OLENoSort for 2

// Property Item Type
Define OLEPropertyItemType for Integer
    // String Item
    Define OLEPropertyItemString for 0
    // Number Item
    Define OLEPropertyItemNumber for 1
    // Bool Item
    Define OLEPropertyItemBool for 2
    // Color Item
    Define OLEPropertyItemColor for 3
    // Font Item
    Define OLEPropertyItemFont for 4
    // Double Item
    Define OLEPropertyItemDouble for 5
    // Date Item
    Define OLEPropertyItemDate for 6
    // Picture Item
    Define OLEPropertyItemPicture for 7
    // Enum Item
    Define OLEPropertyItemEnum for 8
    // Flags Item
    Define OLEPropertyItemEnumFlags for 9
    // Category Item
    Define OLEPropertyItemCategory for 10
    // Multiline Item
    Define OLEPropertyItemMultilineString for 11
    // Option Item
    Define OLEPropertyItemOption for 12

// Property Item Flags
Define OLEPropertyItemFlags for Integer
    // Item has an edit control (default)
    Define OLEItemHasEdit for 1
    // Item has an expand button
    Define OLEItemHasExpandButton for 2
    // Item has a combo button
    Define OLEItemHasComboButton for 4

// Visual Themes
Define OLEXTPPropertyGridVisualTheme for Integer
    // Specifies that the property grid will use the default theme.
    Define OLExtpPropertyGridThemeDefault for 0
    // Specifies that the property grid will use the Office XP like theme.
    Define OLExtpPropertyGridThemeOfficeXP for 1
    // Specifies that the property grid will use the Office 2003 like theme.
    Define OLExtpPropertyGridThemeOffice2003 for 2
    // Specifies that the property grid will use the Office 2013 like theme.
    Define OLExtpPropertyGridThemeOffice2013 for 3
    // Specifies that the property grid will use the Office 2016 like theme.
    Define OLExtpPropertyGridThemeOffice2016 for 3
    // Specifies that the property grid will use the Visual Studio 2012 Light like theme.
    Define OLExtpPropertyGridThemeVisualStudio2012Light for 4
    // Specifies that the property grid will use the Visual Studio 2012 Dark like theme.
    Define OLExtpPropertyGridThemeVisualStudio2012Dark for 5
    // Specifies that the property grid will use the Visual Studio 2015 like theme.
    Define OLExtpPropertyGridThemeVisualStudio2015 for 6
    // Specifies that the property grid will use the Office 2007 / 2010 like theme.
    Define OLExtpPropertyGridThemeResource for 7
    // Specifies that the property grid will use the Native Window 10 like theme.
    Define OLExtpPropertyGridThemeNativeWindows10 for 8
    // Specifies that the property grid will use the Visual Studio 2017 like theme.
    Define OLExtpPropertyGridThemeVisualStudio2017 for 9
    // Specifies that the property grid will use the Visual Studio 2019 like theme.
    Define OLExtpPropertyGridThemeVisualStudio2019 for 10
    // Specifies that the property grid will use the Visual Studio 2022 like theme.
    Define OLExtpPropertyGridThemeVisualStudio2022 for 11
    // Specifies that the property grid will use the Native Window 11 like theme.
    Define OLExtpPropertyGridThemeNativeWindows11 for 12
    // Specifies that the property grid will use the native Window XP visual theme.
    Define OLExtpPropertyGridThemeNativeWinXP for 100
    // Specifies that the property grid will use the 'Cool' theme.
    Define OLExtpPropertyGridThemeCool for 101
    // Specifies that the property grid will use the 'Simple' visual theme.
    Define OLExtpPropertyGridThemeSimple for 102
    // Specifies that the property grid will use the Delphi-style visual theme.
    Define OLExtpPropertyGridThemeDelphi for 103
    // Specifies that the property grid will use the Visual Studio 2005 like theme.
    Define OLExtpPropertyGridThemeVisualStudio2005 for 104
    // Specifies that the property grid will use the Visual Studio 2010 like theme.
    Define OLExtpPropertyGridThemeVisualStudio2010 for 105
    // Specifies that the property grid will use the Visual Studio 2005(Whidbey) like theme.
    Define OLExtpPropertyGridThemeWhidbey for 104
    // Specifies that the property grid will use the Office 2007.
    Define OLExtpPropertyGridThemeOffice2007 for 7

// Border Style
Define OLEXTPPropertyGridBorderStyle for Integer
    Define OLExtpGridBorderNone for 0
    Define OLExtpGridBorderFlat for 1
    Define OLExtpGridBorderStaticEdge for 2
    Define OLExtpGridBorderClientEdge for 3

// Text Format
Define OLEPropertyItemDrawTextFormat for Integer
    Define OLEDrawTextCenter for 1
    Define OLEDrawTextRight for 2
    Define OLEDrawTextVcenter for 4
    Define OLEDrawTextBottom for 8
    Define OLEDrawTextWordBreak for 16
    Define OLEDrawTextSingleLine for 32
    Define OLEDrawTextNoprefix for 2048

// Edit Style
Define OLEPropertyItemEditStyle for Integer
    Define OLEEditStyleLeft for 0
    Define OLEEditStyleCenter for 1
    Define OLEEditStyleRight for 2
    Define OLEEditStyleMultiLine for 4
    Define OLEEditStyleUpperCase for 8
    Define OLEEditStyleLowerCase for 16
    Define OLEEditStyleAutoVscroll for 64
    Define OLEEditStyleAutoHscroll for 128
    Define OLEEditStyleWantReturn for 4096
    Define OLEEditStyleNumber for 8192
    Define OLEEditStyleVScroll for 2097152

// Color Editor
Define OLEPropertyGridItemColorEditor for Integer
    Define OLEItemColorPopup for 0
    Define OLEItemColorStandardDialog for 1
    Define OLEItemColorExtendedDialog for 2

Class cSigCjComIPropertyGridInplaceButton is a Mixin

    { MethodType=Property DesignTime=False }
    Function ComId Returns Integer
        Integer retVal
        Get ComProperty of (phDispatchDriver(Self)) 0 OLE_VT_I4 to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComId Integer value
        Set ComProperty of (phDispatchDriver(Self)) 0 OLE_VT_I4 to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComCaption Returns String
        String retVal
        Get ComProperty of (phDispatchDriver(Self)) 1 OLE_VT_BSTR to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComCaption String value
        Set ComProperty of (phDispatchDriver(Self)) 1 OLE_VT_BSTR to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComWidth Returns Integer
        Integer retVal
        Get ComProperty of (phDispatchDriver(Self)) 4 OLE_VT_I4 to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComWidth Integer value
        Set ComProperty of (phDispatchDriver(Self)) 4 OLE_VT_I4 to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComIconIndex Returns Integer
        Integer retVal
        Get ComProperty of (phDispatchDriver(Self)) 5 OLE_VT_I4 to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComIconIndex Integer value
        Set ComProperty of (phDispatchDriver(Self)) 5 OLE_VT_I4 to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComEnabled Returns Boolean
        Boolean retVal
        Get ComProperty of (phDispatchDriver(Self)) 6 OLE_VT_BOOL to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComEnabled Boolean value
        Set ComProperty of (phDispatchDriver(Self)) 6 OLE_VT_BOOL to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComTooltip Returns String
        String retVal
        Get ComProperty of (phDispatchDriver(Self)) 20 OLE_VT_BSTR to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComTooltip String value
        Set ComProperty of (phDispatchDriver(Self)) 20 OLE_VT_BSTR to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComHyperlink Returns Boolean
        Boolean retVal
        Get ComProperty of (phDispatchDriver(Self)) 21 OLE_VT_BOOL to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComHyperlink Boolean value
        Set ComProperty of (phDispatchDriver(Self)) 21 OLE_VT_BOOL to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComShowAlways Returns Boolean
        Boolean retVal
        Get ComProperty of (phDispatchDriver(Self)) 22 OLE_VT_BOOL to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComShowAlways Boolean value
        Set ComProperty of (phDispatchDriver(Self)) 22 OLE_VT_BOOL to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComAlignment Returns Integer
        Integer retVal
        Get ComProperty of (phDispatchDriver(Self)) 23 OLE_VT_I4 to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComAlignment Integer value
        Set ComProperty of (phDispatchDriver(Self)) 23 OLE_VT_I4 to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComTabStop Returns Boolean
        Boolean retVal
        Get ComProperty of (phDispatchDriver(Self)) 24 OLE_VT_BOOL to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComTabStop Boolean value
        Set ComProperty of (phDispatchDriver(Self)) 24 OLE_VT_BOOL to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComIndex Returns Integer
        Handle hDispatchDriver
        Integer retVal
        Get phDispatchDriver to hDispatchDriver
        Get InvokeComMethod of hDispatchDriver 3 OLE_VT_I4 to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Function ComItem Returns Variant
        Handle hDispatchDriver
        Variant retVal
        Get phDispatchDriver to hDispatchDriver
        Get InvokeComMethod of hDispatchDriver 2 OLE_VT_DISPATCH to retVal
        Function_Return retVal
    End_Function
End_Class

