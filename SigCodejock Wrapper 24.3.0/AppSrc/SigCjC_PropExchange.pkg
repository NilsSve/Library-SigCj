//CompilerWarnings Suspend

Use FlexCom20.pkg

Class cSigCjComPropExchange is a cComAutomationObject

    { MethodType=Property DesignTime=False }
    Function ComValue Returns Variant
        Variant retVal
        Get ComProperty of (phDispatchDriver(Self)) 0 OLE_VT_VARIANT to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComValue Variant value
        Set ComProperty of (phDispatchDriver(Self)) 0 OLE_VT_VARIANT to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComEncoding Returns String
        String retVal
        Get ComProperty of (phDispatchDriver(Self)) 11 OLE_VT_BSTR to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComEncoding String value
        Set ComProperty of (phDispatchDriver(Self)) 11 OLE_VT_BSTR to value
    End_Procedure

    Function ComCreateAsXML Boolean llLoading String llSection Returns Boolean
        Handle hDispatchDriver
        Boolean retVal
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 2
        Send DefineParam to hDispatchDriver OLE_VT_BOOL llLoading
        Send DefineParam to hDispatchDriver OLE_VT_BSTR llSection
        Get InvokeComMethod of hDispatchDriver 1 OLE_VT_BOOL to retVal
        Function_Return retVal
    End_Function

    Function ComCreateAsRegistry Boolean llLoading String llSection Returns Boolean
        Handle hDispatchDriver
        Boolean retVal
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 2
        Send DefineParam to hDispatchDriver OLE_VT_BOOL llLoading
        Send DefineParam to hDispatchDriver OLE_VT_BSTR llSection
        Get InvokeComMethod of hDispatchDriver 2 OLE_VT_BOOL to retVal
        Function_Return retVal
    End_Function

    Function ComCreateAsBinaryFile Boolean llLoading String llPath Returns Boolean
        Handle hDispatchDriver
        Boolean retVal
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 2
        Send DefineParam to hDispatchDriver OLE_VT_BOOL llLoading
        Send DefineParam to hDispatchDriver OLE_VT_BSTR llPath
        Get InvokeComMethod of hDispatchDriver 3 OLE_VT_BOOL to retVal
        Function_Return retVal
    End_Function

    Function ComLoadFromFile String llPath Returns Boolean
        Handle hDispatchDriver
        Boolean retVal
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 1
        Send DefineParam to hDispatchDriver OLE_VT_BSTR llPath
        Get InvokeComMethod of hDispatchDriver 4 OLE_VT_BOOL to retVal
        Function_Return retVal
    End_Function

    Procedure ComSaveToFile String llPath
        Handle hDispatchDriver
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 1
        Send DefineParam to hDispatchDriver OLE_VT_BSTR llPath
        Send InvokeComMethod to hDispatchDriver 5 OLE_VT_VOID
    End_Procedure

    Function ComGetSection String llSection Returns Variant
        Handle hDispatchDriver
        Variant retVal
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 1
        Send DefineParam to hDispatchDriver OLE_VT_BSTR llSection
        Get InvokeComMethod of hDispatchDriver 7 OLE_VT_DISPATCH to retVal
        Function_Return retVal
    End_Function

    Procedure ComExchangeString String llPropName String ByRef llValue String llDefaultValue
        Handle hDispatchDriver
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 3
        Send DefineParam to hDispatchDriver OLE_VT_BSTR llPropName
        Send DefineParam to hDispatchDriver (OLE_VT_BYREF ior OLE_VT_BSTR) llValue
        Send DefineParam to hDispatchDriver OLE_VT_BSTR llDefaultValue
        Send InvokeComMethod to hDispatchDriver 8 OLE_VT_VOID
    End_Procedure

    Procedure ComExchangeInt String llPropName Integer ByRef llValue Integer llDefaultValue
        Handle hDispatchDriver
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 3
        Send DefineParam to hDispatchDriver OLE_VT_BSTR llPropName
        Send DefineParam to hDispatchDriver (OLE_VT_BYREF ior OLE_VT_I4) llValue
        Send DefineParam to hDispatchDriver OLE_VT_I4 llDefaultValue
        Send InvokeComMethod to hDispatchDriver 9 OLE_VT_VOID
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComLoading Returns Boolean
        Handle hDispatchDriver
        Boolean retVal
        Get phDispatchDriver to hDispatchDriver
        Get InvokeComMethod of hDispatchDriver 12 OLE_VT_BOOL to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Function ComValid Returns Boolean
        Handle hDispatchDriver
        Boolean retVal
        Get phDispatchDriver to hDispatchDriver
        Get InvokeComMethod of hDispatchDriver 13 OLE_VT_BOOL to retVal
        Function_Return retVal
    End_Function

    Procedure ComEmptySection
        Handle hDispatchDriver
        Get phDispatchDriver to hDispatchDriver
        Send InvokeComMethod to hDispatchDriver 14 OLE_VT_VOID
    End_Procedure
End_Class

//==============================================================================
//End of package - SigCjC_PropExchange.pkg
//==============================================================================

