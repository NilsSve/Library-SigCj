Class cSigCjCom_DChart3dRotation is a Mixin

    { MethodType=Property DesignTime=False }
    Function ComYaw Returns Real
        Real retVal
        Get ComProperty of (phDispatchDriver(Self)) 1 OLE_VT_R8 to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComYaw Real value
        Set ComProperty of (phDispatchDriver(Self)) 1 OLE_VT_R8 to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComPitch Returns Real
        Real retVal
        Get ComProperty of (phDispatchDriver(Self)) 2 OLE_VT_R8 to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComPitch Real value
        Set ComProperty of (phDispatchDriver(Self)) 2 OLE_VT_R8 to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComRoll Returns Real
        Real retVal
        Get ComProperty of (phDispatchDriver(Self)) 3 OLE_VT_R8 to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComRoll Real value
        Set ComProperty of (phDispatchDriver(Self)) 3 OLE_VT_R8 to value
    End_Procedure
End_Class

// Chart3dRotation
Class cSigCjComChart3dRotation is a cComAutomationObject
    Import_Class_Protocol cSigCjCom_DChart3dRotation

    Procedure Construct_Object
        Forward Send Construct_Object
        Set psProgID to L_cSigCjComChart3dRotation
        Set peAutoCreate to acNoAutoCreate
    End_Procedure
End_Class

