//CompilerWarnings Suspend

Use FlexCom20.pkg

Use SigCjLicense.pkg
Use SigCjC_ColorManager.pkg

Define OLESkinFrameworkApplyOptions for Integer
    Define OLExtpSkinApplyMetrics for 1
    Define OLExtpSkinApplyFrame for 2
    Define OLExtpSkinApplyColors for 4
    Define OLExtpSkinApplyMenus for 8
    Define OLExtpSkinApplyDCs for 16

// Dispatch interface for SkinFramework Control
Class cSigCjCom_DSkinFramework is a Mixin

    { MethodType=Property DesignTime=False }
    Function ComApplyOptions Returns OLESkinFrameworkApplyOptions
        OLESkinFrameworkApplyOptions retVal
        Get ComProperty of (phDispatchDriver(Self)) 1 OLE_VT_I4 to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComApplyOptions OLESkinFrameworkApplyOptions value
        Set ComProperty of (phDispatchDriver(Self)) 1 OLE_VT_I4 to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComAutoApplyNewWindows Returns Boolean
        Boolean retVal
        Get ComProperty of (phDispatchDriver(Self)) 5 OLE_VT_BOOL to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComAutoApplyNewWindows Boolean value
        Set ComProperty of (phDispatchDriver(Self)) 5 OLE_VT_BOOL to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComAutoApplyNewThreads Returns Boolean
        Boolean retVal
        Get ComProperty of (phDispatchDriver(Self)) 10 OLE_VT_BOOL to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComAutoApplyNewThreads Boolean value
        Set ComProperty of (phDispatchDriver(Self)) 10 OLE_VT_BOOL to value
    End_Procedure

    Function ComLoadSkin String llResourcePath String llIniFileName Returns Boolean
        Handle hDispatchDriver
        Boolean retVal
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 2
        Send DefineParam to hDispatchDriver OLE_VT_BSTR llResourcePath
        Send DefineParam to hDispatchDriver OLE_VT_BSTR llIniFileName
        Get InvokeComMethod of hDispatchDriver 2 OLE_VT_BOOL to retVal
        Function_Return retVal
    End_Function

    Procedure ComApplyWindow OLE_HANDLE llhWnd
        Handle hDispatchDriver
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 1
        Send DefineParam to hDispatchDriver OLE_VT_I4 llhWnd
        Send InvokeComMethod to hDispatchDriver 3 OLE_VT_VOID
    End_Procedure

    Procedure ComEnableThemeDialogTexture OLE_HANDLE llhWnd Integer llFlags
        Handle hDispatchDriver
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 2
        Send DefineParam to hDispatchDriver OLE_VT_I4 llhWnd
        Send DefineParam to hDispatchDriver OLE_VT_I4 llFlags
        Send InvokeComMethod to hDispatchDriver 4 OLE_VT_VOID
    End_Procedure

    Procedure ComRemoveWindow OLE_HANDLE llhWnd
        Handle hDispatchDriver
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 1
        Send DefineParam to hDispatchDriver OLE_VT_I4 llhWnd
        Send InvokeComMethod to hDispatchDriver 6 OLE_VT_VOID
    End_Procedure

    Procedure ComRemoveAllWindows
        Handle hDispatchDriver
        Get phDispatchDriver to hDispatchDriver
        Send InvokeComMethod to hDispatchDriver 7 OLE_VT_VOID
    End_Procedure

    Procedure ComAddWindowClass String llClassName String llBaseClassName
        Handle hDispatchDriver
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 2
        Send DefineParam to hDispatchDriver OLE_VT_BSTR llClassName
        Send DefineParam to hDispatchDriver OLE_VT_BSTR llBaseClassName
        Send InvokeComMethod to hDispatchDriver 8 OLE_VT_VOID
    End_Procedure

    Procedure ComRemoveWindowClass String llClassName
        Handle hDispatchDriver
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 1
        Send DefineParam to hDispatchDriver OLE_VT_BSTR llClassName
        Send InvokeComMethod to hDispatchDriver 9 OLE_VT_VOID
    End_Procedure

    Function ComEnumerateSkinDirectory String llPath Boolean llRecursive Returns Variant
        Handle hDispatchDriver
        Variant retVal
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 2
        Send DefineParam to hDispatchDriver OLE_VT_BSTR llPath
        Send DefineParam to hDispatchDriver OLE_VT_BOOL llRecursive
        Get InvokeComMethod of hDispatchDriver 11 OLE_VT_DISPATCH to retVal
        Function_Return retVal
    End_Function

    Function ComEnumerateSkinFile String llPath Returns Variant
        Handle hDispatchDriver
        Variant retVal
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 1
        Send DefineParam to hDispatchDriver OLE_VT_BSTR llPath
        Get InvokeComMethod of hDispatchDriver 12 OLE_VT_DISPATCH to retVal
        Function_Return retVal
    End_Function

    Function ComGetColor OLEXTPColorManagerColor llIndex Returns OLE_COLOR
        Handle hDispatchDriver
        OLE_COLOR retVal
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 1
        Send DefineParam to hDispatchDriver OLE_VT_I4 llIndex
        Get InvokeComMethod of hDispatchDriver 14 OLE_VT_I4 to retVal
        Function_Return retVal
    End_Function

    Procedure ComExcludeModule String llModuleName
        Handle hDispatchDriver
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 1
        Send DefineParam to hDispatchDriver OLE_VT_BSTR llModuleName
        Send InvokeComMethod to hDispatchDriver 15 OLE_VT_VOID
    End_Procedure

    Function ComCreateSchema String llResourcePath String llIniFileName Returns Variant
        Handle hDispatchDriver
        Variant retVal
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 2
        Send DefineParam to hDispatchDriver OLE_VT_BSTR llResourcePath
        Send DefineParam to hDispatchDriver OLE_VT_BSTR llIniFileName
        Get InvokeComMethod of hDispatchDriver 16 OLE_VT_DISPATCH to retVal
        Function_Return retVal
    End_Function

    Procedure ComSetWindowTheme OLE_HANDLE llhWnd Variant llSchema
        Handle hDispatchDriver
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 2
        Send DefineParam to hDispatchDriver OLE_VT_I4 llhWnd
        Send DefineParam to hDispatchDriver OLE_VT_DISPATCH llSchema
        Send InvokeComMethod to hDispatchDriver 17 OLE_VT_VOID
    End_Procedure

    Procedure ComSuspend
        Handle hDispatchDriver
        Get phDispatchDriver to hDispatchDriver
        Send InvokeComMethod to hDispatchDriver 18 OLE_VT_VOID
    End_Procedure

    Procedure ComResume
        Handle hDispatchDriver
        Get phDispatchDriver to hDispatchDriver
        Send InvokeComMethod to hDispatchDriver 19 OLE_VT_VOID
    End_Procedure

    Procedure ComAboutBox
        Handle hDispatchDriver
        Get phDispatchDriver to hDispatchDriver
        Send InvokeComMethod to hDispatchDriver -552 OLE_VT_VOID
    End_Procedure
End_Class

// Event interface for SkinFramework Control
Class cSigCjCom_DSkinFrameworkEvents is a Mixin

    { Visibility=Private }
    Procedure RegisterComEvents
    End_Procedure
End_Class

// SkinFramework Control
{ CLSID=L_cSigCjComSkinFramework }
Class cSigCjComSkinFramework is a cComActiveXControl
    Import_Class_Protocol cSigCjCom_DSkinFramework
    Import_Class_Protocol cSigCjCom_DSkinFrameworkEvents

    Procedure Construct_Object
        Forward Send Construct_Object
        Set psProgID to L_cSigCjComSkinFramework
        Set psEventId to "{C0DE2430-4463-4030-B324-AC6A8075FEC8}"
        Set psLicenseKey to L_cSigCjKeySkinFramework
        Set peAutoCreate to acAutoCreate
    End_Procedure
End_Class

// SkinFramework Global Settings
Class cSigCjComISkinFrameworkGlobalSettings is a Mixin

    { MethodType=Property DesignTime=False }
    Function ComLicense Returns String
        String retVal
        Get ComProperty of (phDispatchDriver(Self)) 101 OLE_VT_BSTR to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComLicense String value
        Set ComProperty of (phDispatchDriver(Self)) 101 OLE_VT_BSTR to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComTitle Returns String
        String retVal
        Get ComProperty of (phDispatchDriver(Self)) 102 OLE_VT_BSTR to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComTitle String value
        Set ComProperty of (phDispatchDriver(Self)) 102 OLE_VT_BSTR to value
    End_Procedure

    // Set this value to True to force using legacy SkinFramework core that has been in use up to version 19
    { MethodType=Property DesignTime=False }
    Function ComUseLegacyCore Returns Boolean
        Boolean retVal
        Get ComProperty of (phDispatchDriver(Self)) 110 OLE_VT_BOOL to retVal
        Function_Return retVal
    End_Function

    // Set this value to True to force using legacy SkinFramework core that has been in use up to version 19
    { MethodType=Property DesignTime=False }
    Procedure Set ComUseLegacyCore Boolean value
        Set ComProperty of (phDispatchDriver(Self)) 110 OLE_VT_BOOL to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComVersion Returns String
        Handle hDispatchDriver
        String retVal
        Get phDispatchDriver to hDispatchDriver
        Get InvokeComMethod of hDispatchDriver 104 OLE_VT_BSTR to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Function ComUnicode Returns Boolean
        Handle hDispatchDriver
        Boolean retVal
        Get phDispatchDriver to hDispatchDriver
        Get InvokeComMethod of hDispatchDriver 105 OLE_VT_BOOL to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Function ComOcxPath Returns String
        Handle hDispatchDriver
        String retVal
        Get phDispatchDriver to hDispatchDriver
        Get InvokeComMethod of hDispatchDriver 106 OLE_VT_BSTR to retVal
        Function_Return retVal
    End_Function
End_Class

// SkinFramework Global Settings
Class cSigCjComSkinFrameworkGlobalSettings is a cComAutomationObject
    Import_Class_Protocol cSigCjComISkinFrameworkGlobalSettings

    Procedure Construct_Object
        Forward Send Construct_Object
        Set psProgID to L_cSigCjComSkinFrameworkGlobalSettings
        Set peAutoCreate to acNoAutoCreate
    End_Procedure
End_Class

