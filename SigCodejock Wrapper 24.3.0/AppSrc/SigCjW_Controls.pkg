Define OLECommonDialogColorConstants for Integer
    // Sets the initial color value for the dialog box 
    Define OLExtpCCRGBInit for 1
    // Entire dialog box is displayed, including the Define Custom Colors section
    Define OLExtpCCFullOpen for 2
    // Disables the Define Custom Colors command button and prevents the user from defining custom colors
    Define OLExtpCCPreventFullOpen for 4
    // Causes the dialog box to display a Help button
    Define OLExtpCCShowHelp for 8
    // Causes the dialog box to display only solid colors in the set of basic colors.
    Define OLExtpCCSolidColor for 128
    // Causes the dialog box to display all available colors in the set of basic colors.
    Define OLExtpCCAnyColor for 256

Define OLECommonDialogFileOpenConstants for Integer
    // Specifies that the File Namelist box allows multiple selections.
    Define OLExtpOFNAllowMultiselect for 512
    // Specifies that the dialog box prompts the user to create a file that doesn't currently exist. This flag automatically sets the xtpOFNPathMustExist and xtpOFNFileMustExist flags.
    Define OLExtpOFNCreatePrompt for 8192
    // Use the Explorer-like Open A File dialog box template. Common dialogs that use this flag do not work under Windows NT using the Windows 95 shell.
    Define OLExtpOFNExplorer for 524288
    // Indicates that the extension of the returned filename is different from the extension specified by the DefaultExt property. This flag isn't set if the DefaultExt property is Null, if the extensions match, or if the file has no extension.
    Define OLExtpOFNExtensionDifferent for 1024
    // Specifies that the user can enter only names of existing files in the File Name text box. If this flag is set and the user enters an invalid filename, a warning is displayed. This flag automatically sets the xtpOFNPathMustExist flag.
    Define OLExtpOFNFileMustExist for 4096
    // Causes the dialog box to display the Help button.
    Define OLExtpOFNHelpButton for 16
    // Hides the Read Onlycheck box.
    Define OLExtpOFNHideReadOnly for 4
    // Use long filenames.
    Define OLExtpOFNLongNames for 2097152
    // Forces the dialog box to set the current directory to what it was when the dialog box was opened.
    Define OLExtpOFNNoChangeDir for 8
    // Do not dereference shell links (also known as shortcuts). By default, choosing a shell link causes it to be dereferenced by the shell.
    Define OLExtpOFNNoDereferenceLinks for 1048576
    // Do not use long file names.
    Define OLExtpOFNNoLongNames for 262144
    // Specifies that the returned file won't have the Read Only attribute set and won't be in a write-protected directory.
    Define OLExtpOFNNoReadOnlyReturn for 32768
    // Specifies that the common dialog box allows invalid characters in the returned filename.
    Define OLExtpOFNNoValidate for 256
    // Causes the Save As dialog box to generate a message box if the selected file already exists. The user must confirm whether to overwrite the file.
    Define OLExtpOFNOverwritePrompt for 2
    // Specifies that the user can enter only validpaths. If this flag is set and the user enters an invalid path, a warning message is displayed.
    Define OLExtpOFNPathMustExist for 2048
    // Causes the Read Only check box to be initially checked when the dialog box is created. This flag also indicates the state of the Read Only check box when the dialog box is closed.
    Define OLExtpOFNReadOnly for 1
    // Specifies that sharing violation errors will be ignored.
    Define OLExtpOFNShareAware for 16384
    // Prevents the system from adding a link to the selected file in the file system directory that contains the user's most recently used documents.
    Define OLExtpOFNDontAddToRecent for 33554432
    // Enables the old-style Explorer-style dialog box to be resized using either the mouse or the keyboard.
    Define OLExtpOFNEnableSizing for 8388608
    // Forces the showing of system and hidden files, thus overriding the user setting to show or not show hidden files. However, a file that is marked both system and hidden is not shown.
    Define OLExtpOFNForceShowHidden for 268435456
    // Hides and disables the Network button.
    Define OLExtpOFNNoNetworkButton for 131072
    // When an application specifies this flag, the library does not check for write protection, a full disk, an open drive door, or network protection. A file cannot be reopened once it is closed.
    Define OLExtpOFNNoTestFileCreate for 65536

Define OLECommonDialogFontConstants for Integer
    // Specifies that the dialog box allows only a selection of the fonts that use the Windows character set. If this flag is set, the user won't be able to select a font that contains only symbols.
    Define OLExtpCFANSIOnly for 1024
    // Enables the Apply button on the dialog box.
    Define OLExtpCFApply for 512
    // Causes the dialog box to list the available printer and screen fonts. The hDC property identifies thedevice context associated with the printer.
    Define OLExtpCFBoth for 3
    // Specifies that the dialog box enables strikethrough, underline, and color effects.
    Define OLExtpCFEffects for 256
    // Specifies that the dialog box selects only fixed-pitch fonts.
    Define OLExtpCFFixedPitchOnly for 16384
    // Specifies that an error message box is displayed if the user attempts to select a font or style that doesn't exist.
    Define OLExtpCFForceFontExist for 65536
    // Causes the dialog box to display a Help button.
    Define OLExtpCFHelpButton for 4
    // Specifies that the dialog box selects only font sizes within the range specified by the Min and Max properties.
    Define OLExtpCFLimitSize for 8192
    // No font name selected.
    Define OLExtpCFNoFaceSel for 524288
    // Specifies that the dialog box doesn't allow graphic device interface (GDI) font simulations.
    Define OLExtpCFNoSimulations for 4096
    // No font size selected.
    Define OLExtpCFNoSizeSel for 2097152
    // No style was selected.
    Define OLExtpCFNoStyleSel for 1048576
    // Specifies that the dialog box doesn't allow vector-font selections.
    Define OLExtpCFNoVectorFonts for 2048
    // Causes the dialog box to list only the fonts supported by the printer, specified by the hDC property.
    Define OLExtpCFPrinterFonts for 2
    // Specifies that the dialog box allows only the selection of fonts that can be scaled.  
    Define OLExtpCFScalableOnly for 131072
    // Causes the dialog box to list only the screen fonts supported by the system.
    Define OLExtpCFScreenFonts for 1
    // Specifies that the dialog box allows only the selection of TrueType fonts.
    Define OLExtpCFTTOnly for 262144
    // Specifies that the dialog box allows only the selection of fonts that are available on both the printer and on screen. If this flag is set, the xtpCFBoth and xtpCFScalableOnly flags should also be set.
    Define OLExtpCFWYSIWYG for 32768
    // Additionally displays fonts that are set to Hide in Fonts Control Panel
    Define OLExtpCFInactiveFonts for 536870912
    // Disables the Script combo box.
    Define OLExtpCFNoScriptSel for 8388608
    // Causes the Font dialog box to list only horizontally oriented fonts.
    Define OLExtpCFNoVertFonts for 16777216

Define OLECommonDialogHelpConstants for Integer
    // Displays Help for a particular command 
    Define OLExtpHelpCommandHelp for 258
    // Displays the contents topic in the current Help file 
    Define OLExtpHelpContents for 3
    // Displays Help for a particular topic 
    Define OLExtpHelpContext for 1
    // Displays a topic identified by a context number 
    Define OLExtpHelpContextPopup for 8
    // Creates a Help file that displays text in only one font 
    Define OLExtpHelpForceFile for 9
    // Displays Help for using the Help application itself 
    Define OLExtpHelpHelpOnHelp for 4
    // Displays the index of the specified Help file 
    Define OLExtpHelpIndex for 3
    // Displays Help for a particular keyword 
    Define OLExtpHelpKey for 257
    // Calls the search engine in Windows Help 
    Define OLExtpHelpPartialKey for 261
    // Notifies the Help application that the specified Help file is no longer in use 
    Define OLExtpHelpQuit for 2
    // Designates a specific topic as the contents topic 
    Define OLExtpHelpSetContents for 5
    // Sets the current index for multi-index Help 
    Define OLExtpHelpSetIndex for 5

Define OLECommonDialogBrowseFolderConstants for Integer
    // Only return file system directories. If the user selects folders that are not part of the file system, the OK button is grayed.
    Define OLExtpBFReturnOnlyFSDirs for 1
    // Do not include network folders below the domain level in the dialog box's tree view control.
    Define OLExtpBFDontGoBelowDomain for 2
    // Include a status area in the dialog box. The callback function can set the status text by sending messages to the dialog box. This flag is not supported when xtpBFNewDialogStyle is specified.
    Define OLExtpBFStatusText for 4
    // Only return file system ancestors. An ancestor is a subfolder that is beneath the root folder in the namespace hierarchy. If the user selects an ancestor of the root folder that is not part of the file system, the OK button is grayed.
    Define OLExtpBFReturnFSAncestors for 8
    // Shell Version 4.71. Include an edit control in the browse dialog box that allows the user to type the name of an item.
    Define OLExtpBFEditBox for 16
    // Shell Version 5.0. Use the new user interface. Setting this flag provides the user with a larger dialog box that can be resized and has several new capabilities.
    Define OLExtpBFNewDialogStyle for 64
    // Shell Version 5.0. The browse dialog box can display URLs. The xtpBFUseNewUI and xtpBFBrowseIncludeFiles flags must also be set. The browse dialog box displays URLs only if the folder that contains the selected item supports URLs.
    Define OLExtpBFBrowseIncludeURL for 128
    // Shell Version 5.0. Use the new user interface, including an edit box. This flag is equivalent to xtpBFEditBox combined with xtpBFNewDialogStyle.
    Define OLExtpBFUseNewUI for 80
    // Shell Version 6.0. When combined with xtpBFNewDialogStyle, adds a usage hint to the dialog box, in place of the edit box. xtpBFEditBox overrides this flag.
    Define OLExtpBFUAHint for 256
    // Shell Version 6.0. Do not include the New Folder button in the browse dialog box.
    Define OLExtpBFNoNewFolderButton for 512
    // Shell Version 6.0. When the selected item is a shortcut, return the PIDL of the shortcut itself rather than its target.
    Define OLExtpBFNoTranslateTargets for 1024
    // Only return computers. If the user selects anything other than a computer, the OK button is grayed.
    Define OLExtpBFBrowseForComputer for 4096
    // Only allow the selection of printers. If the user selects anything other than a printer, the OK button is grayed.
    Define OLExtpBFBrowseForPrinter for 8192
    // Shell Version 4.71. The browse dialog box displays files as well as folders.
    Define OLExtpBFBrowseIncludeFiles for 16384
    // Shell Version 5.0. The browse dialog box can display sharable resources on remote systems. This is intended for applications that want to expose remote shares on a local system. The xtpBFNewDialogStyle flag must also be set.
    Define OLExtpBFShareable for 32768
    // Windows 7 and later. Allow folder junctions such as a library or a compressed file with a .zip file name extension to be browsed.
    Define OLExtpBFBrowseFileJunctions for 65536

Define OLECommonDialogPrintDialogConstants for Integer
    // Returns or sets the state of the Collatecheck box.
    Define OLExtpPDCollate for 16
    // Disables the Print To File check box.
    Define OLExtpPDDisablePrintToFile for 524288
    // Causes the dialog box to display the Help button.
    Define OLExtpPDHelpButton for 2048
    // Hides the Print To File check box.
    Define OLExtpPDHidePrintToFile for 1048576
    // Disables the Pages option button and the associated edit control.
    Define OLExtpPDNoPageNums for 8
    // Disables the Selection option button.
    Define OLExtpPDNoSelection for 4
    // Prevents a warning message from being displayed when there is no default printer.
    Define OLExtpPDNoWarning for 128
    // Returns or sets the state of the Pages option button.
    Define OLExtpPDPageNums for 2
    // Causes the system to display the Print Setup dialog box rather than the Print dialog box.
    Define OLExtpPDPrintSetup for 64
    // Returns or sets the state of the Print To File check box.
    Define OLExtpPDPrintToFile for 32
    // Returns adevice context for the printer selection made in the dialog box. The device context is returned in the dialog box's hDC property.
    Define OLExtpPDReturnDC for 256
    // Returns default printer name.
    Define OLExtpPDReturnDefault for 1024
    // Returns an information context for the printer selection made in the dialog box. An information context provides a fast way to get information about the device without creating a device context.
    Define OLExtpPDReturnIC for 512
    // Returns or sets the state of the Selection option button. If neither xtpPDPageNums nor xtpPDSelection is specified, the All option button is in the selected state.
    Define OLExtpPDSelection for 1
    // If a printer driver doesn't support multiple copies, setting this flag disables the Number of copies spinner control in the Print dialog.
    Define OLExtpPDUseDevModeCopies for 262144
    // Hides and disables the Network button.
    Define OLExtpPDNoNetworkButton for 2097152

