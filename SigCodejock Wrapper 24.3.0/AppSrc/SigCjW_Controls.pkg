// Event interface for WebBrowser Control
Class cSigCjCom_DWebBrowserEvents is a Mixin

    // Download of page complete.
    { MethodType=Event }
    Procedure OnComDownloadComplete
    End_Procedure

    // Fired when the document being navigated to reaches ReadyState_Complete.
    { MethodType=Event }
    Procedure OnComDocumentComplete Variant llpDisp Variant llURL
    End_Procedure

    // Fired when the document being navigated to becomes visible and enters the navigation stack.
    { MethodType=Event }
    Procedure OnComNavigateComplete2 Variant llpDisp Variant llURL
    End_Procedure

    // Fired before navigate occurs in the given WebBrowser (window or frameset element). The processing of this navigation may be modified.
    { MethodType=Event }
    Procedure OnComBeforeNavigate2 Variant llpDisp Variant llURL Variant llFlags Variant llTargetFrameName Variant llPostData Variant llHeaders Boolean ByRef llCancel
    End_Procedure

    // Statusbar text changed.
    { MethodType=Event }
    Procedure OnComStatusTextChange String llText
    End_Procedure

    // Fired when download progress is updated.
    { MethodType=Event }
    Procedure OnComProgressChange Integer llProgress Integer llProgressMax
    End_Procedure

    // Document title changed.
    { MethodType=Event }
    Procedure OnComTitleChange String llTitle
    End_Procedure

    // Download of a page started.
    { MethodType=Event }
    Procedure OnComDownloadBegin
    End_Procedure

    // The enabled state of a command changed.
    { MethodType=Event }
    Procedure OnComCommandStateChange Integer llCommand Boolean llEnable
    End_Procedure

    // Fired when the PutProperty method has been called.
    { MethodType=Event }
    Procedure OnComPropertyChange String llProperty
    End_Procedure

    // A new, hidden, non-navigated WebBrowser window is needed.
    { MethodType=Event }
    Procedure OnComNewWindow2 Variant llppDisp Boolean ByRef llCancel
    End_Procedure

    // Fired when application is quiting
    { MethodType=Event }
    Procedure OnComQuit
    End_Procedure

    // Fired when a binding error occurs (window or frameset element)
    { MethodType=Event }
    Procedure OnComNavigateError Variant llpDisp Variant llURL Variant llTargetFrameName Variant llStatusCode Boolean ByRef llCancel
    End_Procedure

    // Fired when the host window should allow/disallow resizing
    { MethodType=Event }
    Procedure OnComWindowSetResizable Boolean llResizable
    End_Procedure

    // Fired when the host window should change its Left coordinate
    { MethodType=Event }
    Procedure OnComWindowSetLeft Integer llLeft
    End_Procedure

    // Fired when the host window should change its Top coordinate
    { MethodType=Event }
    Procedure OnComWindowSetTop Integer llTop
    End_Procedure

    // Fired when the host window should change its width
    { MethodType=Event }
    Procedure OnComWindowSetWidth Integer llWidth
    End_Procedure

    // Fired when the host window should change its height
    { MethodType=Event }
    Procedure OnComWindowSetHeight Integer llHeight
    End_Procedure

    // Fired when the WebBrowser is about to be closed by script
    { MethodType=Event }
    Procedure OnComWindowClosing Boolean llIsChildWindow Boolean ByRef llCancel
    End_Procedure

    // Fired to indicate the security level of the current web page contents
    { MethodType=Event }
    Procedure OnComSetSecureLockIcon Integer llSecureLockIcon
    End_Procedure

    { MethodType=Event }
    Procedure OnComWebView2NavigationStarting String llUri Boolean llIsUserInitiated Boolean llIsRedirected Variant llNavigationId Boolean ByRef llCancel
    End_Procedure

    { MethodType=Event }
    Procedure OnComWebView2ContentLoading Boolean llIsErrorPage Variant llNavigationId
    End_Procedure

    { MethodType=Event }
    Procedure OnComWebView2SourceChanged Boolean llIsNewDocument
    End_Procedure

    { MethodType=Event }
    Procedure OnComWebView2HistoryChanged
    End_Procedure

    { MethodType=Event }
    Procedure OnComWebView2NavigationCompleted Boolean llIsSuccess OLEWebView2WebErrorStatus llWebErrorStatus Variant llNavigationId
    End_Procedure

    { MethodType=Event }
    Procedure OnComWebView2FrameNavigationStarting String llUri Boolean llIsUserInitiated Boolean llIsRedirected Variant llNavigationId Boolean ByRef llCancel
    End_Procedure

    { MethodType=Event }
    Procedure OnComWebView2FrameNavigationCompleted Boolean llIsSuccess OLEWebView2WebErrorStatus llWebErrorStatus Variant llNavigationId
    End_Procedure

    { MethodType=Event }
    Procedure OnComWebView2ScriptDialogOpening String llUri OLEWebView2ScriptDialogKind llKind String llMessage String llDefaultText String ByRef llResultText Boolean ByRef llAccept
    End_Procedure

    { MethodType=Event }
    Procedure OnComWebView2PermissionRequested String llUri OLEWebView2PermissionKind llPermission Boolean llIsUserInitiated OLEWebView2PermissionState ByRef llPermissionState
    End_Procedure

    { MethodType=Event }
    Procedure OnComWebView2ProcessFailed OLEWebView2ProcessFailedKind llKind
    End_Procedure

    { MethodType=Event }
    Procedure OnComWebView2NewWindowRequested String llUri Boolean llIsUserInitiated Boolean ByRef llHandled
    End_Procedure

    { MethodType=Event }
    Procedure OnComWebView2DocumentTitleChanged
    End_Procedure

    { MethodType=Event }
    Procedure OnComWebView2ContainsFullScreenElementChanged
    End_Procedure

    { MethodType=Event }
    Procedure OnComWebView2WindowCloseRequested
    End_Procedure

    { MethodType=Event }
    Procedure OnComReCreated
    End_Procedure

    { Visibility=Private }
    Procedure RegisterComEvents
        Send RegisterComEvent 1 msg_OnComDownloadComplete
        Send RegisterComEvent 2 msg_OnComDocumentComplete
        Send RegisterComEvent 3 msg_OnComNavigateComplete2
        Send RegisterComEvent 4 msg_OnComBeforeNavigate2
        Send RegisterComEvent 5 msg_OnComStatusTextChange
        Send RegisterComEvent 6 msg_OnComProgressChange
        Send RegisterComEvent 7 msg_OnComTitleChange
        Send RegisterComEvent 8 msg_OnComDownloadBegin
        Send RegisterComEvent 9 msg_OnComCommandStateChange
        Send RegisterComEvent 10 msg_OnComPropertyChange
        Send RegisterComEvent 11 msg_OnComNewWindow2
        Send RegisterComEvent 12 msg_OnComQuit
        Send RegisterComEvent 13 msg_OnComNavigateError
        Send RegisterComEvent 14 msg_OnComWindowSetResizable
        Send RegisterComEvent 15 msg_OnComWindowSetLeft
        Send RegisterComEvent 16 msg_OnComWindowSetTop
        Send RegisterComEvent 17 msg_OnComWindowSetWidth
        Send RegisterComEvent 18 msg_OnComWindowSetHeight
        Send RegisterComEvent 19 msg_OnComWindowClosing
        Send RegisterComEvent 20 msg_OnComSetSecureLockIcon
        Send RegisterComEvent 1000 msg_OnComWebView2NavigationStarting
        Send RegisterComEvent 1001 msg_OnComWebView2ContentLoading
        Send RegisterComEvent 1002 msg_OnComWebView2SourceChanged
        Send RegisterComEvent 1003 msg_OnComWebView2HistoryChanged
        Send RegisterComEvent 1004 msg_OnComWebView2NavigationCompleted
        Send RegisterComEvent 1005 msg_OnComWebView2FrameNavigationStarting
        Send RegisterComEvent 1006 msg_OnComWebView2FrameNavigationCompleted
        Send RegisterComEvent 1007 msg_OnComWebView2ScriptDialogOpening
        Send RegisterComEvent 1008 msg_OnComWebView2PermissionRequested
        Send RegisterComEvent 1009 msg_OnComWebView2ProcessFailed
        Send RegisterComEvent 1010 msg_OnComWebView2NewWindowRequested
        Send RegisterComEvent 1011 msg_OnComWebView2DocumentTitleChanged
        Send RegisterComEvent 1012 msg_OnComWebView2ContainsFullScreenElementChanged
        Send RegisterComEvent 1013 msg_OnComWebView2WindowCloseRequested
        Send RegisterComEvent 10001000 msg_OnComReCreated
    End_Procedure
End_Class

