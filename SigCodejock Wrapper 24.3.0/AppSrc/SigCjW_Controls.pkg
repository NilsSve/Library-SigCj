// Event interface for TaskDialog Control
Class cSigCjCom_DTaskDialogEvents is a Mixin

    { MethodType=Event }
    Procedure OnComButtonClicked Integer llId Variant llCloseDialog
    End_Procedure

    { MethodType=Event }
    Procedure OnComHyperlinkClicked String llURL
    End_Procedure

    { MethodType=Event }
    Procedure OnComRadioButtonClicked Integer llId
    End_Procedure

    { MethodType=Event }
    Procedure OnComVerificationClicked Boolean llChecked
    End_Procedure

    { MethodType=Event }
    Procedure OnComExpandButtonClicked Boolean llExpanded
    End_Procedure

    { MethodType=Event }
    Procedure OnComTimer Integer llMilliSeconds Variant llReset
    End_Procedure

    { MethodType=Event }
    Procedure OnComConstructed
    End_Procedure

    { MethodType=Event }
    Procedure OnComInputBoxChanged
    End_Procedure

    { Visibility=Private }
    Procedure RegisterComEvents
        Send RegisterComEvent 1 msg_OnComButtonClicked
        Send RegisterComEvent 2 msg_OnComHyperlinkClicked
        Send RegisterComEvent 3 msg_OnComRadioButtonClicked
        Send RegisterComEvent 4 msg_OnComVerificationClicked
        Send RegisterComEvent 5 msg_OnComExpandButtonClicked
        Send RegisterComEvent 6 msg_OnComTimer
        Send RegisterComEvent 7 msg_OnComConstructed
        Send RegisterComEvent 8 msg_OnComInputBoxChanged
    End_Procedure
End_Class

// TaskDialog Control
{ CLSID=L_cSigCjComTaskDialog }
Class cSigCjComTaskDialog is a cComActiveXControl
    Import_Class_Protocol cSigCjCom_DTaskDialog
    Import_Class_Protocol cSigCjCom_DTaskDialogEvents

    Procedure Construct_Object
        Forward Send Construct_Object
        Set psProgID to L_cSigCjComTaskDialog
        Set psEventId to "{C0DE2400-A70B-4266-91CE-4475E8A455B9}"
        Set psLicenseKey to L_cSigCjKeyControls
        Set peAutoCreate to acAutoCreate
    End_Procedure
End_Class

