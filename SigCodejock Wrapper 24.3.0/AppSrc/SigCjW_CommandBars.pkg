// Dispatch interface for CommandBars Control
Class cSigCjCom_DCommandBars is a Mixin

    { MethodType=Property DesignTime=False }
    Function ComVisualTheme Returns OLEXTPVisualTheme
        OLEXTPVisualTheme retVal
        Get ComProperty of (phDispatchDriver(Self)) 5 OLE_VT_I4 to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComVisualTheme OLEXTPVisualTheme value
        Set ComProperty of (phDispatchDriver(Self)) 5 OLE_VT_I4 to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComIcons Returns Variant
        Variant retVal
        Get ComProperty of (phDispatchDriver(Self)) 29 OLE_VT_DISPATCH to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComIcons Variant value
        Set ComProperty of (phDispatchDriver(Self)) 29 OLE_VT_DISPATCH to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComScaleMode Returns OLEXTPScaleMode
        OLEXTPScaleMode retVal
        Get ComProperty of (phDispatchDriver(Self)) 30 OLE_VT_I4 to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComScaleMode OLEXTPScaleMode value
        Set ComProperty of (phDispatchDriver(Self)) 30 OLE_VT_I4 to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComRightToLeft Returns Boolean
        Boolean retVal
        Get ComProperty of (phDispatchDriver(Self)) 46 OLE_VT_BOOL to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComRightToLeft Boolean value
        Set ComProperty of (phDispatchDriver(Self)) 46 OLE_VT_BOOL to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComIsAllCaps Returns Boolean
        Boolean retVal
        Get ComProperty of (phDispatchDriver(Self)) 69 OLE_VT_BOOL to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComIsAllCaps Boolean value
        Set ComProperty of (phDispatchDriver(Self)) 69 OLE_VT_BOOL to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComIsAllowFrameTransparency Returns Boolean
        Boolean retVal
        Get ComProperty of (phDispatchDriver(Self)) 71 OLE_VT_BOOL to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComIsAllowFrameTransparency Boolean value
        Set ComProperty of (phDispatchDriver(Self)) 71 OLE_VT_BOOL to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComFontHeight Returns Integer
        Integer retVal
        Get ComProperty of (phDispatchDriver(Self)) 73 OLE_VT_I4 to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComFontHeight Integer value
        Set ComProperty of (phDispatchDriver(Self)) 73 OLE_VT_I4 to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComReCreateReparented Returns Boolean
        Boolean retVal
        Get ComProperty of (phDispatchDriver(Self)) 10002000 OLE_VT_BOOL to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Procedure Set ComReCreateReparented Boolean value
        Set ComProperty of (phDispatchDriver(Self)) 10002000 OLE_VT_BOOL to value
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComCount Returns Integer
        Handle hDispatchDriver
        Integer retVal
        Get phDispatchDriver to hDispatchDriver
        Get InvokeComMethod of hDispatchDriver 1 OLE_VT_I4 to retVal
        Function_Return retVal
    End_Function

    // Returns a specific item.
    { MethodType=Property DesignTime=False }
    Function ComItem Integer llIndex Returns Variant
        Handle hDispatchDriver
        Variant retVal
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 1
        Send DefineParam to hDispatchDriver OLE_VT_I4 llIndex
        Get InvokeComMethod of hDispatchDriver 0 OLE_VT_DISPATCH to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Function Com_NewEnum Returns Variant
        Handle hDispatchDriver
        Variant retVal
        Get phDispatchDriver to hDispatchDriver
        Get InvokeComMethod of hDispatchDriver -4 OLE_VT_UNKNOWN to retVal
        Function_Return retVal
    End_Function

    Function ComAdd String llName OLEXTPBarPosition llPosition Returns Variant
        Handle hDispatchDriver
        Variant retVal
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 2
        Send DefineParam to hDispatchDriver OLE_VT_BSTR llName
        Send DefineParam to hDispatchDriver OLE_VT_I4 llPosition
        Get InvokeComMethod of hDispatchDriver 2 OLE_VT_DISPATCH to retVal
        Function_Return retVal
    End_Function

    Procedure ComAddImageList Variant llImageList
        Handle hDispatchDriver
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 1
        Send DefineParam to hDispatchDriver OLE_VT_DISPATCH llImageList
        Send InvokeComMethod to hDispatchDriver 3 OLE_VT_VOID
    End_Procedure

    { MethodType=Property DesignTime=False }
    Function ComActiveMenuBar Returns Variant
        Handle hDispatchDriver
        Variant retVal
        Get phDispatchDriver to hDispatchDriver
        Get InvokeComMethod of hDispatchDriver 4 OLE_VT_DISPATCH to retVal
        Function_Return retVal
    End_Function

    { MethodType=Property DesignTime=False }
    Function ComActiveMenuTitleBar Returns Variant
        Handle hDispatchDriver
        Variant retVal
        Get phDispatchDriver to hDispatchDriver
        Get InvokeComMethod of hDispatchDriver 81 OLE_VT_DISPATCH to retVal
        Function_Return retVal
    End_Function

    Procedure ComGetClientRect Integer ByRef llLeft Integer ByRef llTop Integer ByRef llRight Integer ByRef llBottom
        Handle hDispatchDriver
        Get phDispatchDriver to hDispatchDriver
        Send PrepareParams to hDispatchDriver 4
