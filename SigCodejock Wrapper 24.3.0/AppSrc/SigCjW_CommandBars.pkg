    // Any of the first three in random selection.
    Define OLExtpAnimateRandom for 1
    // Unfold top to bottom.
    Define OLExtpAnimateUnfold for 2
    // Slide in from left.
    Define OLExtpAnimateSlide for 3
    // Fade-in.
