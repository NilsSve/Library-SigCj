// Event interface for CommandBars Control
Class cSigCjCom_DCommandBarsEvents is a Mixin

    { MethodType=Event }
    Procedure OnComExecute Variant llControl
    End_Procedure

    { MethodType=Event }
    Procedure OnComUpdate Variant llControl
    End_Procedure

    { MethodType=Event }
    Procedure OnComResize
    End_Procedure

    { MethodType=Event }
    Procedure OnComGetClientBordersWidth Integer ByRef llLeft Integer ByRef llTop Integer ByRef llRight Integer ByRef llBottom
    End_Procedure

    { MethodType=Event }
    Procedure OnComControlSelected Variant llControl
    End_Procedure

    { MethodType=Event }
    Procedure OnComInitCommandsPopup Variant llCommandBar
    End_Procedure

    { MethodType=Event }
    Procedure OnComResizeClient Integer llLeft Integer llTop Integer llRight Integer llBottom
    End_Procedure

    { MethodType=Event }
    Procedure OnComSpecialColorChanged
    End_Procedure

    { MethodType=Event }
    Procedure OnComRepositionAlignedControls Integer ByRef llLeft Integer ByRef llTop Integer ByRef llRight Integer ByRef llBottom
    End_Procedure

    { MethodType=Event }
    Procedure OnComCustomization Variant llOptions
    End_Procedure

    { MethodType=Event }
    Procedure OnComToolBarVisibleChanged Variant llToolBar
    End_Procedure

    { MethodType=Event }
    Procedure OnComControlRButtonUp Variant llControl
    End_Procedure

    { MethodType=Event }
    Procedure OnComCustomizationDone
    End_Procedure

    { MethodType=Event }
    Procedure OnComCommandBarKeyDown Variant llCommandBar Integer ByRef llKeyCode Short llShift
    End_Procedure

    { MethodType=Event }
    Procedure OnComToolBarContextMenu Variant llToolBar Variant llContextMenu
    End_Procedure

    { MethodType=Event }
    Procedure OnComTrackingModeChanged Variant llCommandBar Boolean llMode
    End_Procedure

    { MethodType=Event }
    Procedure OnComCustomizationResetToolBar Variant llToolBar
    End_Procedure

    { MethodType=Event }
    Procedure OnComCustomizationAddToolBar Variant llToolBar
    End_Procedure

    { MethodType=Event }
    Procedure OnComCustomizationDeleteToolBar Variant llToolBar
    End_Procedure

    { MethodType=Event }
    Procedure OnComControlNotify Variant llControl Integer llCode Variant llNotifyData Variant llHandled
    End_Procedure

    { MethodType=Event }
    Procedure OnComGetActiveDocumentID Integer ByRef llId
    End_Procedure

    { MethodType=Event }
    Procedure OnComCustomizationResetAll
    End_Procedure

    { MethodType=Event }
    Procedure OnComMessageBarClosed Variant llMessageBar
    End_Procedure

    { MethodType=Event }
    Procedure OnComOLEStartDrag Variant llData Integer ByRef llAllowedEffects
    End_Procedure

    { MethodType=Event }
    Procedure OnComOLECompleteDrag Integer ByRef llEffect
    End_Procedure

    { MethodType=Event }
    Procedure OnComReCreated
    End_Procedure

    { Visibility=Private }
    Procedure RegisterComEvents
        Send RegisterComEvent 1 msg_OnComExecute
        Send RegisterComEvent 2 msg_OnComUpdate
        Send RegisterComEvent 3 msg_OnComResize
        Send RegisterComEvent 4 msg_OnComGetClientBordersWidth
        Send RegisterComEvent 5 msg_OnComControlSelected
        Send RegisterComEvent 6 msg_OnComInitCommandsPopup
        Send RegisterComEvent 7 msg_OnComResizeClient
        Send RegisterComEvent 8 msg_OnComSpecialColorChanged
        Send RegisterComEvent 9 msg_OnComRepositionAlignedControls
        Send RegisterComEvent 10 msg_OnComCustomization
        Send RegisterComEvent 11 msg_OnComToolBarVisibleChanged
        Send RegisterComEvent 12 msg_OnComControlRButtonUp
        Send RegisterComEvent 13 msg_OnComCustomizationDone
        Send RegisterComEvent -602 msg_OnComCommandBarKeyDown
        Send RegisterComEvent 14 msg_OnComToolBarContextMenu
        Send RegisterComEvent 15 msg_OnComTrackingModeChanged
        Send RegisterComEvent 16 msg_OnComCustomizationResetToolBar
        Send RegisterComEvent 17 msg_OnComCustomizationAddToolBar
        Send RegisterComEvent 18 msg_OnComCustomizationDeleteToolBar
        Send RegisterComEvent 19 msg_OnComControlNotify
        Send RegisterComEvent 20 msg_OnComGetActiveDocumentID
        Send RegisterComEvent 21 msg_OnComCustomizationResetAll
        Send RegisterComEvent 22 msg_OnComMessageBarClosed
        Send RegisterComEvent 303 msg_OnComOLEStartDrag
        Send RegisterComEvent 304 msg_OnComOLECompleteDrag
        Send RegisterComEvent 10001000 msg_OnComReCreated
    End_Procedure
