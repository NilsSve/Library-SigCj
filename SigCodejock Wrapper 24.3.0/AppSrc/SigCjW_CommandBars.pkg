// Docking Flags
Define OLEXTPToolBarFlags for Integer
    // Allows docking at the top of the client area. 
    Define OLExtpFlagAlignTop for 1
    // Allows docking at the bottom of the client area. 
    Define OLExtpFlagAlignBottom for 2
    // Allows docking on the left side of the client area. 
    Define OLExtpFlagAlignLeft for 4
    // Allows docking on the left side of the client area. 
    Define OLExtpFlagAlignRight for 8
    // Allows docking on any side of the client area. 
    Define OLExtpFlagAlignAny for 15
    // Allows floating. 
    Define OLExtpFlagFloating for 16
    // Allow to hide wrapped controls.
    Define OLExtpFlagHideWrap for 32
    // Bar is stretched.
    Define OLExtpFlagStretched for 64
    // Bar is stretched, but not fill whole row
    Define OLExtpFlagStretchedShared for 1048576
