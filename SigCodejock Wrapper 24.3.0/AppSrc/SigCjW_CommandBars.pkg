// Control Flags
Define OLEXTPControlFlags for Integer
    // Control is right aligned.
    Define OLExtpFlagRightAlign for 1
    // Control does not have focus.  The control will be skipped when performing actions such as tabbing through the controls in the command bar.
    Define OLExtpFlagSkipFocus for 2
    // To Pop up child bar left.  The popup will start from the right side of the control that was clicked and be displayed right-to-left. 
    Define OLExtpFlagLeftPopup for 4
    // Control is manually updated.
    Define OLExtpFlagManualUpdate for 8
    // Used to disable customization.  The user will not be able to move or edit the control.
    Define OLExtpFlagNoMovable for 16
    // Used to stretch a control to fill the maximum available width if the control is in the ActiveMenuBar.  This has no effect on controls in the toolbar.
    Define OLExtpFlagControlStretched for 32
    // Show tooltip always.
    Define OLExtpFlagShowPopupBarTip for 64
    // Wrap row for toolbar or popup bar.
    Define OLExtpFlagWrapRow for 128
    // Control is on the right side of Ribbon tabs.
    Define OLExtpFlagRibbonTabBackground for 256

