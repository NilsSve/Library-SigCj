Use cSigCJGlobalSettings.pkg
Use cSigCJPropEx_Mixin.pkg
Use cSigCJMethods_Mixin.pkg

//=============================================================================

Enum_List   //eDP_Client_Type
    Define eDP_Normal
    Define eDP_ActiveX
End_Enum_List

Enum_List   //eDP_Event_Director
    Define eDP_No_Events
    Define eDP_Direct_To_Manager
    Define eDP_Direct_To_Panes
    Define eDP_Direct_To_Both
End_Enum_List

//=============================================================================

Class cSigCjDockingPaneLayout is a cSigCjComDockingPaneLayout
    Import_Class_Protocol cSigCJPropEx_Mixin

    Procedure Construct_Object
        Forward Send Construct_Object

        Send Initialise_PropEx_Mixin
        Set psPX_Class to "SigCJDockingPanesControl"
    End_Procedure
End_Class

//=============================================================================

{ OverrideProperty=psLicenseKey              DesignTime=False }
{ OverrideProperty=psProgID                  DesignTime=False }
{ OverrideProperty=peAutoCreate              DesignTime=False }
{ OverrideProperty=peNeighborhood            DesignTime=False }
{ OverrideProperty=Delegation_Mode           DesignTime=False }
Class cSigCjDockingPane is a cSigCjComPane

    Procedure Construct_Object
        Forward Send Construct_Object

        { Category="CodeJock" InitialValue=0 }
        Property Integer piID 0

        { Category="CodeJock" InitialValue=150 }
        Property Integer piHeight 150

        { Category="CodeJock" InitialValue=150 }
        Property Integer piWidth 150

        { Category="CodeJock" InitialValue=OLEDockLeftOf }
        { EnumList="OLEDockLeftOf, OLEDockRightOf, OLEDockTopOf, OLEDockBottomOf" }
        Property Integer peLocation OLEDockLeftOf

        { Category="CodeJock" InitialValue=0 }
        Property Integer piNeighbour 0

        { Category="CodeJock" InitialValue=-1 }
        Property Integer piAttachTo -1 
        
        { Category="CodeJock" InitialValue="" }
        Property String  psTitle ""

        { Category="CodeJock" InitialValue=0 }
        Property Handle  phoClientObject 0

        { Category="CodeJock" InitialValue=-1 }
        Property Integer piSideDockingOffset -1

        { Category="CodeJock" InitialValue=False }
        Property Boolean pbInitiallyHidden False

        { Category="CodeJock" InitialValue=eDP_Normal }
        { EnumList="eDP_Normal, eDP_ActiveX" }
        Property Integer peClientType eDP_Normal

        //-------------------------------------------------------------------------

        { Category="CodeJock" InitialValue=True }
        Property Boolean pbCloseable True

        { Category="CodeJock" InitialValue=True }
        Property Boolean pbHideable True

        { Category="CodeJock" InitialValue=True }
        Property Boolean pbFloatable True

        { Category="CodeJock" InitialValue=True }
        Property Boolean pbCaption True

        { Category="CodeJock" InitialValue=False }
        Property Boolean pbMenuButton False

        { Category="CodeJock" InitialValue=True }
        Property Boolean pbDockable True

        //-------------------------------------------------------------------------

        { DesignTime=False }
        Property Integer Private_piImage 0
        { DesignTime=False }
        Property String  Private_psImage ""
    End_Procedure

    //-------------------------------------------------------------------------
    
    Procedure Set psImage String sImage
        Integer iImageId

        Set Private_psImage to sImage

        Get AddImage of ghoSigCjGlobalSetting sImage 0 OLExtpImageNormal to iImageId
        Set Private_piImage to iImageId

        If (IsComObjectCreated(Self)) Begin
            Set ComIconID  to iImageId
        End
    End_Procedure

    Function psImage Returns String
        Function_Return (Private_psImage(Self))
    End_Function

    //-------------------------------------------------------------------------

    Procedure Setup_Pane
        Handle hoWnd hoClient 
        Variant vPane
        Integer iOptions

        Get Create_Pane (piId(Self))       (piHeight(Self))    (piWidth(Self)) ;
                        (peLocation(Self)) (piNeighbour(Self)) (Self) to vPane //Docking Manager
        Set pvComObject to vPane
        Set ComTitle    to (psTitle(Self))
        Set ComIconId   to (Private_piImage(Self))

        If (piSideDockingOffset(Self) > -1) Begin
            Send ComDockSidePane vPane (piSideDockingOffset(Self)) (peLocation(Self))   //Docking Manager
        End

        Set ComHidden to (pbInitiallyHidden(Self))

        //Set Options
        Move 0 to iOptions
        If (not(pbCloseable (Self))) Move (iOptions ior OLEPaneNoCloseable  ) to iOptions
        If (not(pbHideable  (Self))) Move (iOptions ior OLEPaneNoHideable   ) to iOptions
        If (not(pbFloatable (Self))) Move (iOptions ior OLEPaneNoFloatable  ) to iOptions
        If (not(pbCaption   (Self))) Move (iOptions ior OLEPaneNoCaption    ) to iOptions
        If (    pbMenuButton(Self))  Move (iOptions ior OLEPaneHasMenuButton) to iOptions
        If (not(pbDockable  (Self))) Move (iOptions ior OLEPaneNoDockable   ) to iOptions
        Set ComOptions to iOptions
    End_Procedure

    //-------------------------------------------------------------------------
    //Events
    //-------------------------------------------------------------------------

    { MethodType=Event }
    Procedure OnClosed Boolean ByRef bCancel
    End_Procedure

    { MethodType=Event }
    Procedure OnClosing Boolean ByRef bCancel
    End_Procedure

    { MethodType=Event }
    Procedure OnCollapsed Boolean ByRef bCancel
    End_Procedure

    { MethodType=Event }
    Procedure OnCollapsing Boolean ByRef bCancel
    End_Procedure

    { MethodType=Event }
    Procedure OnDocked Boolean ByRef bCancel
    End_Procedure

    { MethodType=Event }
    Procedure OnExpanded Boolean ByRef bCancel
    End_Procedure

    { MethodType=Event }
    Procedure OnExpanding Boolean ByRef bCancel
    End_Procedure

    { MethodType=Event }
    Procedure OnFloated Boolean ByRef bCancel
    End_Procedure

    { MethodType=Event }
    Procedure OnPinned Boolean ByRef bCancel
    End_Procedure

    { MethodType=Event }
    Procedure OnUnPinned Boolean ByRef bCancel
    End_Procedure

    { MethodType=Event }
    Procedure OnActivated Boolean ByRef bCancel
    End_Procedure  
    
    { MethodType=Event }
    Procedure OnDeactivated Boolean ByRef bCancel
    End_Procedure
End_Class

