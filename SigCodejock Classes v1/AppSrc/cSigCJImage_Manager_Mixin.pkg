    Function AddImage String sImage Integer iId Integer eImageType Returns Integer
        Boolean bIsIcon bOK 
        Handle  hBitmap 
        Handle  hoImageIcons
        Integer iVoid eType iNextImage iImageId
        String  sImagePath
        Variant vImageManager vImageHandle
        tdImageInfo[] tImageInfo

        If (Trim(sImage) <> "") Begin
            //Keep thing simple
            Move (Uppercase(sImage)) to sImage
    
            //Have we already loaded this 
            Get Find_Image sImage to iImageId
            
            If (iImageId = 0) Begin
                //Are we looking for an Icon or a Bitmap
                Move (Pos(".ICO",sImage)>0) to bIsIcon
                Move (If(bIsIcon,IMAGE_ICON,IMAGE_BITMAP)) to eType
    
                //Is it in the EXE as a resource
                Move (LoadImage(GetModuleHandle(0), sImage, eType, 0, 0, 0)) to hBitmap
                If (hBitmap =0) Begin // the bitmap was not in the EXE resource
                    Get_File_Path sImage to sImagePath // find path in DFPATH, if appropriate
                    If (sImagePath <> "") Begin // The image was found!
                        //If we use LoadImage to here we can ignore the "load from file"
                        //methods in the CJ Image Manager
                        Move (LoadImage(0, sImagePath, eType, 0, 0, LR_LOADFROMFILE)) to hBitmap
                    End
                End
    
                //If we have an image loaded into memeory, add it 
                If (hBitmap <> 0) Begin
    
                    //Sort out the ID
                    If (iId=0) Begin
                        Get piLastImageId to iImageId
                        Increment iImageId
                        Set piLastImageId to iImageId
                    End
                    Else Begin
                        Move iId to iImageId
                    End
    
                    Get ComIcons to vImageManager
                    Get Create U_cCJImageManagerIcons to hoImageIcons
                        Set pvComObject of hoImageIcons to vImageManager
        
                        If (bIsIcon) Begin
                            Send ComAddIcon of hoImageIcons hBitmap iImageId eImageType 
                        End
                        Else Begin
                            Send ComAddBitmap of hoImageIcons hBitmap iImageId eImageType False
                            // this works with alpha blends - even when passed false
                        End
    
                        Get ComGetImage of hoImageIcons iImageId 0 to vImageHandle
                    Send destroy of hoImageIcons
    
                    Move (DeleteObject(hBitmap)) to iVoid
    
                    //Note what we have just added                
                    Get ptImageInfo to tImageInfo
                    Move (SizeOfArray(tImageInfo)) to iNextImage
                    Move sImage       to tImageInfo[iNextImage].sImageName
                    Move iImageId     to tImageInfo[iNextImage].iImageID
                    Move vImageHandle to tImageInfo[iNextImage].vImageHandle
                    Move hBitmap      to tImageInfo[iNextImage].hWnd
                    Set ptImageInfo   to tImageInfo
                End
                Else Begin 
                    If (IsDebuggerPresent()) Begin
                        Error DFERR_PROGRAM ("Cannot find image [" +  sImage + "]")
                    End
                End
            End
        End
        
        Function_Return iImageId
    End_Procedure
End_Class 

