Use VDFBase.pkg

Struct tdImageInfo
    String  sImageName
    Integer iImageId
    Variant vImageHandle
    Handle  hWnd
End_Struct

Class cSigCJImage_Manager_Mixin is a Mixin

    // Initialise, create properties etc
    Procedure Initialise_Image_Manager_Mixin 

        { Category="CodeJock" }
        Property Handle phoImagelist

        { Visibility=Private }
        Property Integer piLastImageId 5000

        { Visibility=Private }
        Property tdImageInfo[] ptImageInfo

    End_Procedure

    // Creation method that creates the image list object for storage of images and icons
    { MethodType=Method }
    Procedure Create_Image_Manager
        Handle  hoImageManager
        Variant vImagelist
        
        Get Create U_cCJImageManager to hoImageManager
        Send CreateComObject of hoImageManager
        Get ComIcons of hoImageManager to vImagelist
        Set ComIcons to vImagelist
        Send destroy of hoImageManager
    End_Procedure  // Create_Image_Manager

    // Hook for loading Images 
    { MethodType=Method }
    Procedure Load_Images
    End_Procedure
    
    {DocStart = Method}
    //---------------------------------------------------
    //
    // Function     : CompareImageName
    //
    // Scope        : Private 
    //
    // Purpose      : Used internally as part of a SearchArray call to compare the sImageName elements 
    //                of two tdImageInfo structs 
    //               
    //---------------------------------------------------
    {DocEnd} 
    
    {MethodType=Method Visibility=Private}    
    Function CompareImageName tdImageInfo tImage1 tdImageInfo tImage2 Returns Integer
        Integer iRetVal
        If (tImage1.sImageName = tImage2.sImageName) Begin
            Move (EQ) to iRetVal
        End  
        Function_Return iRetVal
    End_Function

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Function     : CompareImageID
    //
    // Scope        : Private 
    //
    // Purpose      : Used internally as part of a SearchArray call to compare the iImageId elements 
    //                of two tdImageInfo structs 
    //               
    //---------------------------------------------------
    {DocEnd} 
    
    {MethodType=Method Visibility=Private}       
    Function CompareImageID tdImageInfo tImage1 tdImageInfo tImage2 Returns Integer
        Integer iRetVal
        If (tImage1.iImageId = tImage2.iImageId) Begin
            Move (EQ) to iRetVal
        End  
        Function_Return iRetVal
    End_Function

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Function     : Find_Image
    //
    // Scope        : Public 
    //
    // Paramaters   : String sImage
    //
    // Returns      : Integer (Image ID)
    //
    // Purpose      : Searches the ptImageInfo property to see if an image, specified by name ("someicon.ico") has
    //                already been uploaded. If so, it returns the unique id to that image.            
    //               
    //---------------------------------------------------
    {DocEnd} 
        
    Function Find_Image String sImage Returns Integer
        Integer iImageId iSearchIndex        
        tdImageInfo[] taImageInfo
        tdImageInfo tImageInfo
        
        Get ptImageInfo to taImageInfo
        Move sImage to tImageInfo.sImageName
        Move (SearchArray(tImageInfo,taImageInfo,Self,get_CompareImageName)) to iSearchIndex
        If (iSearchIndex <> -1) Begin
            Move taImageInfo[iSearchIndex].iImageId to iImageId
        End   
        Function_Return iImageId
    End_Function

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Function     : Find_Image_Name
    //
    // Scope        : Public 
    //
    // Paramaters   : Integer iImageId
    //
    // Returns      : Handle
    //
    // Purpose      : Returns the Image file name as specified by its Image ID                  
    //               
    //---------------------------------------------------
    {DocEnd} 
        
    Function Find_Image_Name Integer iImageId Returns String
        String sRetVal
        Integer iSearchIndex        
        tdImageInfo[] taImageInfo
        tdImageInfo tImageInfo
        
        Get ptImageInfo to taImageInfo
        Move iImageId to tImageInfo.iImageId
        Move (SearchArray(tImageInfo,taImageInfo,Self,get_CompareImageID)) to iSearchIndex
        If (iSearchIndex <> -1) Begin
            Move taImageInfo[iSearchIndex].sImageName to sRetVal
        End                
        Function_Return sRetVal  
    End_Function

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Function     : ImageHwndFromId
    //
    // Scope        : Public 
    //
    // Paramaters   : Integer iImageId
    //
    // Returns      : Handle
    //
    // Purpose      : Returns the window handle to an image as specified by its Image ID                  
    //               
    //---------------------------------------------------
    {DocEnd} 
        
    Function ImageHwndFromId Integer iImageId Returns Handle
        Handle hRetVal
        Integer iSearchIndex        
        tdImageInfo[] taImageInfo
        tdImageInfo tImageInfo
        
        Get ptImageInfo to taImageInfo
        Move iImageId to tImageInfo.iImageId
        Move (SearchArray(tImageInfo,taImageInfo,Self,get_CompareImageID)) to iSearchIndex
        If (iSearchIndex <> -1) Begin
            Move taImageInfo[iSearchIndex].hWnd to hRetVal
        End                
        Function_Return hRetVal  
    End_Function
    
    {DocStart = Method}
    //---------------------------------------------------
    //
    // Function     : ImageFromId
    //
    // Scope        : Public 
    //
    // Paramaters   : Integer iImageId
    //
    // Returns      : variant (IDispatch* pointer to the image)
    //
    // Purpose      : Returns the IDispatch* pointer to the image as specified by its Image ID                  
    //               
    //---------------------------------------------------
    {DocEnd} 
    
    Function ImageFromId Integer iImageId Returns Variant
        Variant vImage
        Integer iSearchIndex        
        tdImageInfo[] taImageInfo
        tdImageInfo tImageInfo
        
        Get ptImageInfo to taImageInfo
        Move iImageId to tImageInfo.iImageId
        Move (SearchArray(tImageInfo,taImageInfo,Self,get_CompareImageID)) to iSearchIndex
        If (iSearchIndex <> -1) Begin
            Move taImageInfo[iSearchIndex].vImageHandle to vImage
        End  
        Else Begin
            Move (NullComObject()) to vImage
        End
        Function_Return vImage
    End_Function
        

    {DocStart=Method}
    //-------------------------------------------------------------------------
    //
    //Purpose : Adds an image to the image manager
    //
    //Parameters : sImage - The file name of the image to load#
    //             iID - If zero the next ID will be allocated 
