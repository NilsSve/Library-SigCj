    //                   with this ID has already been loaded then it will be 
    //                   replaced
    //              eImageType - The usage type of the image i.e. normal, 
    //                           shadowed, checked etc.
    //
    //Returns : The image ID. 
    //
    //-------------------------------------------------------------------------
    {DocEnd}
    
