Use cCJGrid.pkg

Class cSigGrid is a cCJGrid
 
    { MethodType=Event }
    Procedure Construct_Object
        Forward Send Construct_Object

        { Category="ShadeRow" InitialValue=False }
        Property Boolean pbShade_Row False
        { Category="ShadeRow" InitialValue=0.8 }
        Property Number  pnShade 0.8
        { Visibility=Private }
        Property Integer Private_DefaultSelectedBackColor


        Set peVerticalGridStyle      to xtpGridNoLines
        Set pbShadeSortColumn        to True
        Set pbSelectionEnable        to True
        Set pbHeaderReorders         to True
        Set pbHeaderTogglesDirection to True
        Set peAnchors                to anAll
        
        On_Key kClear_All Send Request_Clear_All
    End_Procedure
    
    Procedure Request_Clear
        Forward Send Request_Clear  // Send to the cCJGrid class to do what it does naturally  
        Delegate Send Request_Clear // Now we need to sent it to the parent so that it does a standard Request_clear to the view
    End_Procedure

    Procedure Request_Save
        Forward Send Request_Save  // Send to the cCJGrid class to do what it does naturally  
        Delegate Send Request_Save // Now we need to sent it to the parent so that it does a standard Request_clear to the view
    End_Procedure

    Procedure End_Construct_Object
    	Forward Send End_Construct_Object
    	
    	// If we are shading rows we need to turn this off otherwise the rows will get coloured grey
    	If (pbShade_Row(Self)) Set pbSelectionEnable to False    	
    End_Procedure       

    { MethodType=Event }
	Procedure OnSetRowColour Handle hoGridItemMetrics Integer iRow 
	    // Hook 
	End_Procedure    
 
    { MethodType=Event }
    Procedure OnCreateGridControl
        Integer iColor

        Forward Send OnCreateGridControl 
 
        Get ComHighlightBackColor of (phoReportPaintManager(Self)) to iColor
        Set Private_DefaultSelectedBackColor to iColor
    End_Procedure
 
End_Class

//==============================================================================
//End of Package - cSigGrid.pkg
