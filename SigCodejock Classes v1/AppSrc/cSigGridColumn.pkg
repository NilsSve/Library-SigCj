Use cCJGridColumn.pkg

Class cSigGridColumn is a cCJGridColumn

	Procedure OnSetDisplayMetrics Handle hoGridItemMetrics Integer iRow String ByRef sValue
		Integer iCurrentRow iColor iRed iBlue iGreen
		Number nShade
		
		Send OnSetRowColour hoGridItemMetrics iRow
		 
		If (pbShade_Row(Parent(Self))) Begin
	        Get SelectedRow of (phoDataSource(Parent(Self))) to iCurrentRow
	        If (iCurrentRow = iRow) Begin
	            Get ComBackColor of hoGridItemMetrics to iColor
	            Get pnShade of (Parent(Self)) to nShade
	            Get R_From_RGB iColor to iRed
	            Get G_From_RGB iColor to iGreen
	            Get B_From_RGB iColor to iBlue
	            Move ( RGB(Mod(iRed * nShade, 256), Mod(iGreen * nShade, 256), Mod(iBlue * nShade, 256)) ) to iColor
	            Set ComBackColor of hoGridItemMetrics to iColor
	        End
	  	End

		Forward Send OnSetDisplayMetrics hoGridItemMetrics iRow (&sValue)	
 	End_Procedure	

End_Class

