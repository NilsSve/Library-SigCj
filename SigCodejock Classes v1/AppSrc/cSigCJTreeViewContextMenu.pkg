Use cSigCJContextMenu.pkg

Class cSigCJTreeView_ContextMenu is a cSigCJContextMenu

    Procedure Add_Standard_MenuItems
        //Send Add_MenuItem "Rebuild"             "Rebuild_TreeView"   False
        Send Add_MenuItem "Refresh"             "Refresh_TreeView"   False
    End_Procedure // Add_Standard_MenuItems

    Procedure Popup
        Boolean bVisible
        Handle hoContextMenu 
        Get phoContextMenu_TreeView to hoContextMenu

        Send OnPopup_ContextMenu_TreeView hoContextMenu
        Forward Send Popup
    End_Procedure

    Procedure Construct_Object
        Forward Send Construct_Object
        Set phoContextMenu_TreeView to (Self)
    End_Procedure // Construct_Object
    
End_Class // cSigCJReportControlContextMenu_Header

            