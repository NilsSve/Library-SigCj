//IMPORTANT
//=========
//
//This pack will "use" the correctly named packages ReportControl or GridControl.
//
//If you are using Codejock version 22.0 or greater, it is strongly recommended 
//that you change your code to Use the renamed control - Grid.
//
//==============================================================================

Use SigCjLicense.pkg

#IF (SigCj_Codejock_Version < 220000)
    Use cSigCJReportControl_Pre2200.pkg
#ELSE
    #Warning DFERR_COMP_WARNING_OBSOLETE_CMD "Obsolete package: cSigCJReportControl. Recode for renamed Codejock Grid Control"

    #Replace SigCJReportIdleHandler                 cSigCJGridIdleHandler
    #Replace SigCJReportColumn                      cSigCjComGridColumn
    #Replace SigCJReportRecordItem                  cSigCJGridRecordItem
    #Replace eRC_HitTest_ReportArea                 eRC_HitTest_GridArea
    #Replace cSigCJReportControl                    cSigCJGridControl
    #Replace phoReportRecords                       phoGridRecords            
    #Replace phoReportRecord                        phoGridRecord             
    #Replace phoReportRecordItem                    phoGridRecordItem         
    #Replace phoReportRecordItemMetrics             phoGridRecordItemMetrics  
    #Replace phoReportColumns                       phoGridColumns            
    #Replace phoReportColumn                        phoGridColumn             
    #Replace phoReportColumnOrder                   phoGridColumnOrder        
    #Replace phoReportRows                          phoGridRows               
    #Replace phoReportRow                           phoGridRow                
    #Replace phoReportGroupRow                      phoGridGroupRow           
    #Replace phoReportSelectedRows                  phoGridSelectedRows       
    // REMOVED (SigCj for DF26): #Replace phoReportPaintManager phoGridPaintManager
    // DataFlex's OWN cCJGrid/cDbCJGrid declare phoReportPaintManager (DF26
    // Pkg\cCJGrid.pkg line 123), so this global rename rewrote a DataFlex-owned
    // token in every file compiled after this one. cSigGrid.pkg and
    // cSigdbGrid.pkg subclass the DataFlex grid and were silently retargeted to
    // a property their base class does not have - Error 98 at run time, clean at
    // compile time. Code using a cSigCJGridControl should say phoGridPaintManager.
    #Replace phoReportPrintOptions                  phoGridPrintOptions       
    #Replace phoReportNavigator                     phoGridNavigator
    #Replace phoContextMenu_ReportArea              phoContextMenu_GridArea
    #Replace oSQL_Report_Handler                    oSQL_Grid_Handler
    #Replace oSigCJReportIdleHandler                oSigCJGridIdleHandler
    #Replace OnAdd_ContextMenu_ReportArea           OnAdd_ContextMenu_GridArea
    #Replace OnPopup_ContextMenu_ReportArea         OnPopup_ContextMenu_GridArea
    #Replace Report_Row_Count                       Grid_Row_Count
    #Replace OnReport_Row_Count                     OnGrid_Row_Count
    #Replace Rebuild_Report                         Rebuild_Grid
    #Replace Deferred_Refresh_Report                Deferred_Refresh_Grid
    #Replace OnRefresh_Report                       OnRefresh_Grid
    #Replace Refresh_Report                         Refresh_Grid
    #Replace DoReset_Report_Control                 DoReset_Grid_Control
    #Replace DoRefresh_Report_Control               DoRefresh_Grid_Control
    #Replace DoDelete_Report_Data                   DoDelete_Grid_Data
    #Replace Add_Report_Column                      Add_Grid_Column
    #Replace OLEXTPReportColumnOrderChangedReason   OLEXTPGridColumnOrderChangedReason
    #Replace OnLeftClick_ReportArea                 OnLeftClick_GridArea
    #Replace PreviewReport                          PreviewGrid
    #Replace PrintReport                            PrintGrid
    #Replace Add_Report_Item                        Add_Grid_Item

    #Replace OLExtpReportFilterTreeByParentAndChildren  OLExtpGridFilterTreeByParentAndChildren
    #Replace U_cSigCJComReportRecords                   U_cSigCJComGridRecords   
    #Replace U_cSigCJComReportRecord                    U_cSigCJComGridRecord    
    #Replace U_cSigCJComReportRecordItem                U_cSigCJComGridRecordItem
    #Replace U_cSigCJComReportRecordItemMetrics         U_cSigCJComGridRecordItemMetrics

//    OLExtpReportWatermarkCenter
//    OLExtpReportWatermarkvCenter 
//    OLExtpReportWatermarkPreserveRatio
//    OLExtpReportColumnAddedToGroupby    OLExtpGridColumnAddedToGroupby
    
    Use cSigCJGridControl.pkg
#ENDIF

//==============================================================================
//End of package - cSigCJReportControl.pkg
