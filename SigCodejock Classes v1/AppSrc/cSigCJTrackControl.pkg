        Set ComMovePivot                   to (Private_pbMovePivot(Self)) 
        Set ComMultipleSelection           to (Private_pbMultipleSelection(Self)) 
        Set ComMultiSelectionMode          to (Private_pbMultiSelectionMode(Self)) 
