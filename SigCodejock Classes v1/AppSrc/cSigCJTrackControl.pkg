Use SigCjLicense.pkg

// Codejock renamed Report Control to Grid Control at 22.0.0 and the wrapper
// SigCjW_ReportControl.pkg went with it. The Track Control classes this file
// needs now live in SigCjW_GridControl.pkg.
#IF (SigCj_Codejock_Version < 220000)
    Use SigCjW_ReportControl.pkg
#ELSE
    // ...and Codejock renamed the enumerations with it. Same shim style as
    // cSigCJReportControl.pkg uses for the class names.
    #Replace OLEXtpReportBorderStyle               OLEXTPGridBorderStyle
    #Replace OLEXtpReportColumnOrderChangedReason  OLEXTPGridColumnOrderChangedReason
    #Replace OLEXtpReportCustomDraw                OLEXTPGridCustomDraw
    #Replace OLEXtpReportDragDrop                  OLEXTPGridDragDrop
    #Replace OLEXtpReportElementRect               OLEXTPGridElementRect
    #Replace OLEXtpReportFilterMode                OLEXTPGridFilterMode
    #Replace OLEXtpReportWatermarkAlignment        OLEXTPGridWatermarkAlignment
    #Replace Refresh_Report                        Refresh_Grid

    Use SigCjW_GridControl.pkg
#ENDIF
Use cSigCJMethods_Mixin.pkg
Use cSigCJGlobalSettings.pkg
Use cSigCJPropEx_Mixin.pkg
Use cSigCJReportControlContextMenu.pkg
Use cSigCJFieldChooser.pkg
Use gFormatNumbers.pkg
Use CSV_Export.dg
Use StdFont.pkg

Register_Function pbRefreshRequired Returns Boolean

Class SigCJTrackIdleHandler is a cIdleHandler

    Procedure OnIdle
        If (pbRefreshRequired(Self)) Begin
            Delegate Send Refresh_Report
            Set pbRefreshRequired to False 
        End
    End_Procedure
    
End_Class 

Class cSigCjTrackControl_Properties is a Mixin
    
    Procedure Initialise_Properties
        
    End_Procedure
    
    
End_Class

Class cSigCjTrackControl is a cSigCjComTrackControl
    
    Procedure Construct_Object
        Forward Send Construct_Object
        
        { Visibility = Private }                         
        Property Boolean Private_pbAllowColumnRemove           False
        { Visibility = Private }                               
        Property Boolean Private_pbAllowColumnReorder          False 
        { Visibility = Private }                               
        Property Boolean Private_pbAllowColumnResize           True
        { Visibility = Private }                               
        Property Boolean Private_pbAllowColumnSort             True
        { Visibility = Private }                               
        Property Boolean Private_pbAllowEdit                   False 
        { Visibility = Private }
        Property Boolean Private_pbAllowEditPreview            False 
        { Visibility = Private }
        Property Boolean Private_pbAllowSelectionCheck         False 
        { Visibility = Private }                         
        Property Boolean Private_pbAutoColumnSizing            False 
        { Visibility = Private }
        Property Boolean Private_pbDesktopTrackerMode          False 
        { Visibility = Private }                         
        Property Boolean Private_pbEditOnClick                 False 
        { Visibility = Private }                               
        Property Boolean Private_pbEnabled                     True
        { Visibility = Private }
        Property Boolean Private_pbEnableMarkup                False 
        { Visibility = Private }
        Property Boolean Private_pbFastDeselectMode            False 
        { Visibility = Private }
        Property Boolean Private_pbFilterHiddenColumns         False 
        { Visibility = Private }                         
        Property Boolean Private_pbFilterSeparatorStrict       False 
        { Visibility = Private }                         
        Property Boolean Private_pbFocusSubItems               True
        { Visibility = Private }                               
        Property Boolean Private_pbFooterRowsAllowAccess       False 
        { Visibility = Private }                               
        Property Boolean Private_pbFooterRowsAllowEdit         False 
        { Visibility = Private }
        Property Boolean Private_pbFooterRowsEnableSelection   False 
        { Visibility = Private }
        Property Boolean Private_pbForcePagination             False 
        { Visibility = Private }
        Property Boolean Private_pbFreeHeightMode              False 
        { Visibility = Private }
        Property Boolean Private_pbFreezeColumnsAbs            False 
        { Visibility = Private }                         
        Property Boolean Private_pbFullColumnScrolling         False 
        { Visibility = Private }                               
        Property Boolean Private_pbHeaderRowsAllowAccess       False 
        { Visibility = Private }                               
        Property Boolean Private_pbHeaderRowsAllowEdit         False 
        { Visibility = Private }
        Property Boolean Private_pbHeaderRowsEnableSelection   False 
        { Visibility = Private }
        Property Boolean Private_pbHideColumnAfterGroupBoxDrop False 
        { Visibility = Private }
        Property Boolean Private_pbIconView                    False 
        { Visibility = Private }
        Property Boolean Private_pbInitialSelectionEnable      True
        { Visibility = Private }
        Property Boolean Private_pbMovePivot                   False 
        { Visibility = Private }                         
        Property Boolean Private_pbMultipleSelection           True
        { Visibility = Private }
        Property Boolean Private_pbMultiSelectionMode          True
        { Visibility = Private }                         
        Property Boolean Private_pbPinFooterRows               False 
        { Visibility = Private }                               
