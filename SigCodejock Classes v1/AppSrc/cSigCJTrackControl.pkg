        Set ComSkipGroupsFocus             to (Private_pbSkipGroupsFocus(Self)) 
        Set ComShowHeader                  to (Private_pbShowHeader(Self)) 
        Set ComShowHeaderRows              to (Private_pbShowHeaderRows(Self)) 
        Set ComShowRowFocus                to (Private_pbShowRowFocus(Self)) 
        Set ComSortedDragDrop              to (Private_pbSortedDragDrop(Self)) 
        Set ComSortRecordChildren          to (Private_pbSortRecordChildren(Self)) 
        Set ComStrictBestFit               to (Private_pbStrictBestFit(Self)) 
        Set ComReleaseOnDestroy            to (Private_pbReleaseOnDestroy(Self)) 
        Set ComRightToLeft                 to (Private_pbRightToLeft(Self)) 
        Set ComRightToLeftReading          to (Private_pbRightToLeftReading(Self)) 
        Set ComTrapTabKey                  to (Private_pbTrapTabKey(Self)) 
        Set ComUnrestrictedDragDrop        to (Private_pbUnrestrictedDragDrop(Self)) 

        
    End_Procedure
    
    
