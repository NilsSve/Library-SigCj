        { Visibility = Private }
        Property Boolean Private_pbPrintGroupRowIcon           True
        { Visibility = Private }                         
        Property Boolean Private_pbReleaseOnDestroy            True
        { Visibility = Private }                               
        Property Boolean Private_pbRightToLeft                 False 
        { Visibility = Private }                               
        Property Boolean Private_pbRightToLeftReading          False 
        { Visibility = Private }                               
        Property Boolean Private_pbSelectionEnable             False 
        { Visibility = Private }
        Property Boolean Private_pbSelectionExcludeGroupRows   False 
        { Visibility = Private }
        Property Boolean Private_pbSendContextMenuForWholeHeaderArea False 
        { Visibility = Private }                         
        Property Boolean Private_pbShowItemsInGroups           False 
        { Visibility = Private }                               
        Property Boolean Private_pbShowFooter                  False 
        { Visibility = Private }                               
        Property Boolean Private_pbShowFooterRows              False 
        { Visibility = Private }                               
        Property Boolean Private_pbShowGroupBox                False
        { Visibility = Private }                               
        Property Boolean Private_pbShowHeader                  True
        { Visibility = Private }                               
        Property Boolean Private_pbShowHeaderRows              True
        { Visibility = Private }                               
        Property Boolean Private_pbShowRowFocus                False 
        { Visibility = Private }                               
        Property Boolean Private_pbSkipGroupsFocus             True
        { Visibility = Private }
        Property Boolean Private_pbSortedDragDrop              False 
        { Visibility = Private }
        Property Boolean Private_pbSortRecordChildren          True
        { Visibility = Private }
        Property Boolean Private_pbStrictBestFit               False 
        { Visibility = Private }
        Property Boolean Private_pbTrapTabKey                  False 
        { Visibility = Private }
        Property Boolean Private_pbUnrestrictedDragDrop        False 

        
    End_Procedure

    Procedure End_Construct_Object
        Forward Send End_Construct_Object
    End_Procedure
    
    Procedure OnCreate
        Forward Send OnCreate 
        
        // Set Boolean Properties
        Set ComAllowColumnRemove           to (Private_pbAllowColumnRemove(Self))
        Set ComAllowColumnReorder          to (Private_pbAllowColumnReorder(Self)) 
        Set ComAllowColumnResize           to (Private_pbAllowColumnResize(Self)) 
        Set ComAllowColumnSort             to (Private_pbAllowColumnSort(Self)) 
        Set ComAllowEdit                   to (Private_pbAllowEdit(Self)) 
        Set ComAllowEditPreview            to (Private_pbAllowEditPreview(Self)) 
        Set ComAllowSelectionCheck         to (Private_pbAllowSelectionCheck(Self)) 
        Set ComAutoColumnSizing            to (Private_pbAutoColumnSizing(Self)) 
        Set ComDesktopTrackerMode          to (Private_pbDesktopTrackerMode(Self)) 
        Set ComEditOnClick                 to (Private_pbEditOnClick(Self)) 
        Set ComEnabled                     to (Private_pbEnabled(Self)) 
        Set ComEnableMarkup                to (Private_pbEnableMarkup(Self)) 
        Set ComFastDeselectMode            to (Private_pbFastDeselectMode(Self)) 
        Set ComFilterHiddenColumns         to (Private_pbFilterHiddenColumns(Self)) 
        Set ComFilterSeparatorStrict       to (Private_pbFilterSeparatorStrict(Self)) 
        Set ComFocusSubItems               to (Private_pbFocusSubItems(Self)) 
        Set ComFooterRowsAllowAccess       to (Private_pbFooterRowsAllowAccess(Self)) 
        Set ComFooterRowsAllowEdit         to (Private_pbFooterRowsAllowEdit(Self)) 
        Set ComFooterRowsEnableSelection   to (Private_pbFooterRowsEnableSelection(Self)) 
        Set ComForcePagination             to (Private_pbForcePagination(Self)) 
        Set ComFreeHeightMode              to (Private_pbFreeHeightMode(Self)) 
        Set ComFreezeColumnsAbs            to (Private_pbFreezeColumnsAbs(Self)) 
        Set ComFullColumnScrolling         to (Private_pbFullColumnScrolling(Self)) 
        Set ComHeaderRowsAllowAccess       to (Private_pbHeaderRowsAllowAccess(Self)) 
        Set ComHeaderRowsAllowEdit         to (Private_pbHeaderRowsAllowEdit(Self)) 
        Set ComHeaderRowsEnableSelection   to (Private_pbHeaderRowsEnableSelection(Self)) 
        Set ComHideColumnAfterGroupBoxDrop to (Private_pbHideColumnAfterGroupBoxDrop(Self)) 
        Set ComIconView                    to (Private_pbIconView(Self)) 
        Set ComInitialSelectionEnable      to (Private_pbInitialSelectionEnable(Self)) 
        Set ComMovePivot                   to (Private_pbMovePivot(Self)) 
        Set ComMultipleSelection           to (Private_pbMultipleSelection(Self)) 
        Set ComMultiSelectionMode          to (Private_pbMultiSelectionMode(Self)) 
        Set ComPinFooterRows               to (Private_pbPinFooterRows(Self)) 
        Set ComPreviewMode                 to (Private_pbPreviewMode(Self)) 
        Set ComPrintGroupRowIcon           to (Private_pbPrintGroupRowIcon(Self)) 
        Set ComSelectionEnable             to (Private_pbSelectionEnable(Self)) 
        Set ComSelectionExcludeGroupRows   to (Private_pbSelectionExcludeGroupRows(Self)) 
