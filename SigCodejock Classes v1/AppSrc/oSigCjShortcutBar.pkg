Use cSigCJDockingPane.pkg
Use cSigCjShortcutBar.pkg

//==============================================================================
//We need to put the shortcut bar in a container within the docking panel. If
//the shortcut bar is NOT in a container then the short cut bar disapears if a 
//model dialog is displays and closed before a non model panel is made visable.

Object oSigCj_SC_Bar_Container is a Container3d
    Set Border_Style to Border_None
    
    Object oSigCj_SC_Bar is a cSigCj_SC_Bar
        Set size to 100 100
        Set peAnchors to anAll
    End_Object
End_Object

//==============================================================================

Object oSigCj_ShortCut_Bar is a cSigCjDockingManager
    Set phoCommandBars to oCommandBarSystem
    Set pbPX_Save_Layout to True
    Set psPX_Tag to "ShortCutBar"

    Object oSigCj_SCB_Pane is a cSigCjDockingPane
        //Set Size            to 125 100
        Set peLocation      to OLEDockLeftOf
        Set pbCloseable     to False
        Set pbHideable      to False
        Set pbFloatable     to False
        Set pbCaption       to False
        Set pbDockable      to False
        Set piSplitterSize  to 0
        Set pbLockSplitters to True
        Set piId to 1
        Set phoClient  to (oSigCj_SC_Bar_Container(Self))
    End_Object
End_Object 

//==============================================================================
//End of Package - oSigCjShortcutBar.pkg
