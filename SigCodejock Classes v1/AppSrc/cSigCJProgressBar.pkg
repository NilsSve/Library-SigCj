Use SigCjW_Controls.pkg
Use cSigCJMethods_Mixin.pkg
Use StdFont.pkg

Enum_List   //ePR_Orientation
    Define ePR_Horizontal   for 0
    Define ePR_Vertical
End_Enum_List

Enum_List   //ePR_Style
    Define ePR_BarStandard  for 0
    Define ePR_BarSmooth
    Define ePR_BarMarquee
End_Enum_List

{ OverrideProperty=Label_Col_Offset         DesignTime=False }
{ OverrideProperty=Label_Justification_Mode DesignTime=False }
{ OverrideProperty=Label_Row_Offset         DesignTime=False }
{ OverrideProperty=piMinSize                DesignTime=False }
{ OverrideProperty=Border_Style             DesignTime=False }
{ OverrideProperty=Visible_State            DesignTime=False }
{ OverrideProperty=Attach_Parent_State      DesignTime=False }
{ OverrideProperty=Block_Mouse_State        DesignTime=False }
{ OverrideProperty=Client_Area_State        DesignTime=False }
{ OverrideProperty=Delegation_Mode          DesignTime=False }
{ OverrideProperty=Focus_Mode               DesignTime=False }
{ OverrideProperty=pbBindValue              DesignTime=False }
{ OverrideProperty=peAutoCreate             DesignTime=False }
{ OverrideProperty=peNeighborhood           DesignTime=False }
{ OverrideProperty=Popup_State              DesignTime=False }
{ OverrideProperty=Ring_State               DesignTime=False }
{ OverrideProperty=Scope_State              DesignTime=False }
{ OverrideProperty=Search_Case              DesignTime=False }
{ OverrideProperty=Skip_State               DesignTime=False }
{ OverrideProperty=Help_Id                  DesignTime=False }
{ OverrideProperty=Help_Keyword             DesignTime=False }
{ OverrideProperty=psHtmlHelpTopic          DesignTime=False }
{ OverrideProperty=Status_Help              DesignTime=False }
{ OverrideProperty=Use_Parent_Status_Help   DesignTime=False }
{ OverrideProperty=psLicenseKey             DesignTime=False }
{ OverrideProperty=psProgID                 DesignTime=False }
{ OverrideProperty=Color                    DesignTime=False }
{ OverrideProperty=TextColor                DesignTime=False }
{ OverrideProperty=label                    DesignTime=False }
{ OverrideProperty=Enabled_State            DesignTime=False }
{ OverrideProperty=Size                    InitialValue=13,150 }
Class cSigCJProgressBar is a cSigCjComProgressBar
    Import_Class_Protocol cSigCJMethods_Mixin

    //-------------------------------------------------------------------------

    Procedure Construct_Object
        Forward Send Construct_Object

        //The default COM size is 100 100, make it something sensible
        Set Size to 13 150

        { DesignTime=False }
        Property Integer Private_peAppearance OLExtpAppearanceStandard

        { DesignTime=False }
        Property OLE_Color Private_piBackColor clWhite

        { DesignTime=False }
        Property OLE_Color Private_piBarColor

        { DesignTime=False }
        Property Boolean Private_pbEnabled True

        { DesignTime=False }
        Property Boolean Private_pbFlatStyle False

        { DesignTime=False }
        Property OLE_Color Private_piForeColor clWindowText

        { DesignTime=False }
        Property Integer Private_piMarqueeDelay 80

        { DesignTime=False }
        Property Integer Private_piMax 100

        { DesignTime=False }
        Property Integer Private_piMin

        { DesignTime=False }
        Property Integer Private_peOrientation ePR_Horizontal

        { DesignTime=False }
        Property Integer Private_peStyle ePR_BarStandard

        { DesignTime=False }
        Property Integer Private_pbStyle_Changing False

        { DesignTime=False }
        Property String Private_psText

        { DesignTime=False }
        Property Boolean Private_pbUseVisualStyle False

        { DesignTime=False }
        Property Integer Private_piValue

        //---------------------------------------------------------------------

        { DesignTime=False }
        Property boolean Private_pbBold False

        { DesignTime=False }
        Property Boolean Private_pbItalic False

        { DesignTime=False }
        Property Boolean Private_pbStrikethrough False

        { DesignTime=False }
        Property Boolean Private_pbUnderline False

        { DesignTime=False }
        Property String Private_psFontName "MS Sans Serif"

        { DesignTime=False }
        Property Number Private_pnFontSize 8.25

        { DesignTime=False }
        Property Handle Private_hoFont  (Create(Self, U_cComStdFont))

    End_Procedure

    { MethodType=Event }
    Procedure OnCreate
        Handle hoFont
        Integer iColor
        OLE_Color iBackColor   //See cSigCJLabel.pkg
        OLE_Color iForeColor

        Forward Send OnCreate

        //Bar Color depends on the OS so get Controls Color is piBarColor not set
        If (Private_piBarColor(Self) = 0) Begin
            Get ComBarColor to iColor
            Set Private_piBarColor to iColor
        End

        Get Private_piBackColor to iBackColor
        Get Private_piForeColor to iForeColor

        Set peAppearance        to (Private_peAppearance(Self))
        Set piBackColor         to iBackColor   //See above (Private_piBackColor(Self))
        Set piBarColor          to (Private_piBarColor(Self))
        Set pbEnabled           to (Private_pbEnabled(Self))
        Set pbFlatStyle         to (Private_pbFlatStyle(Self))
        Set piForeColor         to iForeColor   //See above (Private_piForeColor(Self))
        Set piMarqueeDelay      to (Private_piMarqueeDelay(Self))
        Set piMax               to (Private_piMax(Self))
        Set piMin               to (Private_piMin(Self))
        Set peOrientation       to (Private_peOrientation(Self))
        Set peStyle             to (Private_peStyle(Self))
        Set psText              to (Private_psText(Self))
        Set pbUseVisualStyle    to (Private_pbUseVisualStyle(Self))

        //Connect the OCX and dataflex FONT objects and set defaults
        Get Private_hoFont   to hoFont
        Set pvComObject      of hoFont to (ComFont(Self))
        Set ComBold          of hoFont to (Private_pbBold(Self))
        Set ComItalic        of hoFont to (Private_pbItalic(Self))
        Set ComStrikethrough of hoFont to (Private_pbStrikethrough(Self))
        Set ComUnderline     of hoFont to (Private_pbUnderline(Self))
        // We want to use the standrad windows or df font here
        //Set ComName          of hoFont to (Private_psFontName(Self))
        //Set ComSize          of hoFont to (Private_pnFontSize(Self))
    End_Procedure  // OnCreate

    //-------------------------------------------------------------------------

    { MethodType=Property Category="CodeJock" InitialValue=False }
    Procedure Set pbBold Boolean bState
        Set SigCJProperty Set_Private_pbBold Set_ComBold (Private_hoFont(Self)) to bState
    End_Procedure

    Function pbBold Returns Boolean
        Function_Return (SigCJProperty(Self, Get_Private_pbBold, Get_ComBold, Private_hoFont(Self)))
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Property Category="CodeJock" InitialValue=False }
    Procedure Set pbItalic Boolean bState
        Set SigCJProperty Set_Private_pbItalic Set_ComItalic (Private_hoFont(Self)) to bState
    End_Procedure

    Function pbItalic Returns Boolean
        Function_Return (SigCJProperty(Self, Get_Private_pbItalic, Get_ComItalic, Private_hoFont(Self)))
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Property Category="CodeJock" InitialValue=False }
    Procedure Set pbStrikethrough Boolean bState
        Set SigCJProperty Set_Private_pbStrikethrough Set_ComStrikethrough (Private_hoFont(Self)) to bState
    End_Procedure

    Function pbStrikethrough Returns Boolean
        Function_Return (SigCJProperty(Self, Get_Private_pbStrikethrough, Get_ComStrikethrough, Private_hoFont(Self)))
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Property Category="CodeJock" InitialValue=False }
    Procedure Set pbUnderline Boolean bState
        Set SigCJProperty Set_Private_pbUnderline Set_ComUnderline (Private_hoFont(Self)) to bState
    End_Procedure

    Function pbUnderline Returns Boolean
        Function_Return (SigCJProperty(Self, Get_Private_pbUnderline, Get_ComUnderline, Private_hoFont(Self)))
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Property Category="CodeJock" InitialValue="MS Sans Serif" }
    Procedure Set psFontName String sName
        Set SigCJProperty Set_Private_psFontName Set_ComName (Private_hoFont(Self)) to sName
    End_Procedure

    Function psFontName Returns String
        Function_Return (SigCJProperty(Self, Get_Private_psFontName, Get_ComName, Private_hoFont(Self)))
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Property Category="CodeJock" InitialValue=8.25 }
    Procedure Set pnFontSize Number nSize
        Set SigCJProperty Set_Private_pnFontSize Set_ComSize (Private_hoFont(Self)) to nSize
    End_Procedure

    Function pnFontSize Returns Number
        Function_Return (SigCJProperty(Self, Get_Private_pnFontSize, Get_ComSize, Private_hoFont(Self)))
    End_Function

    //-------------------------------------------------------------------------

    #IF (SigCj_Codejock_Version < 150001)
        { MethodType=Property Category="CodeJock" InitialValue=OLExtpAppearanceStandard }
        { EnumList="OLExtpAppearanceStandard, OLExtpAppearanceFlat, OLExtpAppearanceUltraFlat, OLExtpAppearanceOffice2000, OLExtpAppearanceOffice2000, OLExtpAppearanceOffice2003, OLExtpAppearanceOffice2007" }
    #ELSE
        { MethodType=Property Category="CodeJock" InitialValue=OLExtpAppearanceStandard }
        { EnumList="OLExtpAppearanceStandard, OLExtpAppearanceFlat, OLExtpAppearanceUltraFlat, OLExtpAppearanceOffice2000, OLExtpAppearanceOffice2000, OLExtpAppearanceOffice2003, OLExtpAppearanceResource" }
    #ENDIF
    Procedure Set peAppearance Integer eAppearance
        Set SigCJProperty Set_Private_peAppearance Set_ComAppearance to eAppearance
    End_Procedure

    Function peAppearance Returns Integer
        Function_Return (SigCJProperty(Self, Get_Private_peAppearance, Get_ComAppearance ))
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Property Category="CodeJock" PropertyType=Color InitialValue=clBtnFace }
    { EnumList= "cl3DDkShadow, cl3DLight, clActiveBorder, clActiveCaption, clAppWorkSpace, clBackground"    }
    { EnumList+="clBtnFace, clBtnHighlight, clBtnShadow, clBtnText, clCaptionText, clGrayText, clHighlight" }
    { EnumList+="clHighlightText, clInactiveBorder, clInactiveCaption, clInactiveCaptionText, clInfoBk"     }
    { EnumList+="clInfoText, clMenu, clMenuText, clScrollBar, clWindow, clWindowFrame, clWindowText"        }
    { EnumList+="clDefault, clNone, clAqua, clBlack, clBlue, clDkGray, clFuchsia, clGray, clGreen, clLime"  }
    { EnumList+="clLtGray, clMaroon, clNavy, clOlive, clPurple, clRed, clSilver, clTeal, clWhite, clYellow" }
    Procedure Set piBackColor OLE_Color iColor
        Set SigCJProperty Set_Private_piBackColor Set_ComBackColor to iColor
    End_Procedure

    Function piBackColor Returns OLE_Color
        Function_Return (SigCJProperty(Self, Get_Private_piBackColor, Get_ComBackColor ))
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Property Category="CodeJock" PropertyType=Color }
    { EnumList= "cl3DDkShadow, cl3DLight, clActiveBorder, clActiveCaption, clAppWorkSpace, clBackground"    }
    { EnumList+="clBtnFace, clBtnHighlight, clBtnShadow, clBtnText, clCaptionText, clGrayText, clHighlight" }
    { EnumList+="clHighlightText, clInactiveBorder, clInactiveCaption, clInactiveCaptionText, clInfoBk"     }
    { EnumList+="clInfoText, clMenu, clMenuText, clScrollBar, clWindow, clWindowFrame, clWindowText"        }
    { EnumList+="clDefault, clNone, clAqua, clBlack, clBlue, clDkGray, clFuchsia, clGray, clGreen, clLime"  }
    { EnumList+="clLtGray, clMaroon, clNavy, clOlive, clPurple, clRed, clSilver, clTeal, clWhite, clYellow" }
    Procedure Set piBarColor OLE_Color iColor
        Set SigCJProperty Set_Private_piBarColor Set_ComBarColor to iColor
    End_Procedure

    Function piBarColor Returns OLE_Color
        Function_Return (SigCJProperty(Self, Get_Private_piBarColor, Get_ComBarColor ))
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Property Category="CodeJock" InitialValue=True }
    Procedure Set pbEnabled Boolean bState
        Set SigCJProperty Set_Private_pbEnabled Set_ComEnabled to bState
    End_Procedure

    Function pbEnabled Returns Boolean
        Function_Return (SigCJProperty(Self, Get_Private_pbEnabled, Get_ComEnabled ))
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Property Category="CodeJock" InitialValue=False }
    Procedure Set pbFlatStyle Boolean bState
        Set SigCJProperty Set_Private_pbFlatStyle Set_ComFlatStyle to bState
    End_Procedure

    Function pbFlatStyle Returns Boolean
        Function_Return (SigCJProperty(Self, Get_Private_pbFlatStyle, Get_ComFlatStyle ))
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Property Category="CodeJock" PropertyType=Color InitialValue=clWindowText }
    { EnumList= "cl3DDkShadow, cl3DLight, clActiveBorder, clActiveCaption, clAppWorkSpace, clBackground"    }
    { EnumList+="clBtnFace, clBtnHighlight, clBtnShadow, clBtnText, clCaptionText, clGrayText, clHighlight" }
    { EnumList+="clHighlightText, clInactiveBorder, clInactiveCaption, clInactiveCaptionText, clInfoBk"     }
    { EnumList+="clInfoText, clMenu, clMenuText, clScrollBar, clWindow, clWindowFrame, clWindowText"        }
    { EnumList+="clDefault, clNone, clAqua, clBlack, clBlue, clDkGray, clFuchsia, clGray, clGreen, clLime"  }
    { EnumList+="clLtGray, clMaroon, clNavy, clOlive, clPurple, clRed, clSilver, clTeal, clWhite, clYellow" }
    Procedure Set piForeColor Integer iColor
        Set SigCJProperty Set_Private_piForeColor Set_ComForeColor to iColor
    End_Procedure

    Function piForeColor Returns Integer
        Function_Return (SigCJProperty(Self, Get_Private_piForeColor, Get_ComForeColor ))
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Property Category="CodeJock" InitialValue=80 }
    Procedure Set piMarqueeDelay Integer iValue
        Set SigCJProperty Set_Private_piMarqueeDelay Set_ComMarqueeDelay to iValue
    End_Procedure

    Function piMarqueeDelay Returns Integer
        Function_Return (SigCJProperty(Self, Get_Private_piMarqueeDelay, Get_ComMarqueeDelay ))
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Property Category="CodeJock" InitialValue=100 }
    Procedure Set piMax Integer iValue
        Set SigCJProperty Set_Private_piMax Set_ComMax to iValue
    End_Procedure

    Function piMax Returns Integer
        Function_Return (SigCJProperty(Self, Get_Private_piMax, Get_ComMax ))
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Property Category="CodeJock" InitialValue=0 }
    Procedure Set piMin Integer iValue
        Set SigCJProperty Set_Private_piMin Set_ComMin to iValue
    End_Procedure

    Function piMin Returns Integer
        Function_Return (SigCJProperty(Self, Get_Private_piMin, Get_ComMin ))
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Property Category="CodeJock" InitialValue=ePR_Horizontal }
    { EnumList="ePR_Horizontal, ePR_Vertical" }
    Procedure Set peOrientation Integer eOrientation
        Set SigCJProperty Set_Private_peOrientation Set_ComOrientation to eOrientation
    End_Procedure

    Function peOrientation Returns Integer
        Function_Return (SigCJProperty(Self, Get_Private_peOrientation, Get_ComOrientation ))
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Property Category="CodeJock" InitialValue=ePR_BarStandard }
    { EnumList="ePR_BarStandard, ePR_BarSmooth, ePR_BarMarquee" }
    Procedure Set peStyle Integer eStyle
        Set SigCJProperty Set_Private_peStyle Set_ComScrolling to eStyle

        Set Private_pbStyle_Changing to True
            If (eStyle = ePR_BarSmooth)  Set pbUseVisualStyle to False
            If (eStyle = ePR_BarMarquee) Set pbUseVisualStyle to True
        Set Private_pbStyle_Changing to False
    End_Procedure

    Function peStyle Returns Integer
        Function_Return (SigCJProperty(Self, Get_Private_peStyle, Get_ComScrolling ))
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Property Category="CodeJock" InitialValue="" }
    Procedure Set psText String sText
        Set SigCJProperty Set_Private_psText Set_ComText to sText
    End_Procedure

    Function psText Returns String
        Function_Return (SigCJProperty(Self, Get_Private_psText, Get_ComText ))
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Property Category="CodeJock" InitialValue=True }
    Procedure Set pbUseVisualStyle Boolean bState
        If ((peStyle(Self) = ePR_BarStandard) or Private_pbStyle_Changing(Self)) Begin
            Set SigCJProperty Set_Private_pbUseVisualStyle Set_ComUseVisualStyle to bState
        End
    End_Procedure

    Function pbUseVisualStyle Returns Boolean
        Function_Return (SigCJProperty(Self, Get_Private_pbUseVisualStyle, Get_ComUseVisualStyle ))
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Property Category="CodeJock" InitialValue=0 }
    Procedure Set piValue Integer iValue
        Set SigCJProperty Set_Private_piValue Set_ComValue to iValue
    End_Procedure

    Function piValue Returns Integer
        Function_Return (SigCJProperty(Self, Get_Private_piValue, Get_ComValue ))
    End_Function

    //-------------------------------------------------------------------------

End_Class

//==============================================================================
//End of Package - cSigCJProgressBar.pkg
//==============================================================================
