    //-------------------------------------------------------------------------
    //EnableReminders is a Write_Only method. Here we code it as a standard
    //property for consistency

    { MethodType=Property Category="SigCj:Dialogs" InitialValue=True }
    Procedure Set pbEnableReminders Boolean bState
        Set Internal_pbEnableReminders to bState

        If (IsComObjectCreated(Self)) Begin
            Send ComEnableReminders bState
        End
    End_Procedure

    Function pbEnableReminders Returns Boolean
        Boolean bState

        If (IsComObjectCreated(Self)) Begin
            Get ComIsRemindersEnabled to bState
        End
        Else Begin
            Get Internal_pbEnableReminders to bState
        End

        Function_Return bState
    End_Function

