//==============================================================================
//NOTES
//=====
//CAUTION - Codejock use the term "Event" for an item / entry in the calendar.
//          Do not confuse program events with calendar items!!!
//==============================================================================

Use Flexml.pkg
Use SigCjW_Calendar.pkg
Use cSigCJMethods_Mixin.pkg
Use cSigCJContextMenu.pkg
Use cSigCj_Font.pkg
Use cSigCjCalendar_IdleHandler.pkg
Use cSigCjCalendar_Public.pkg

//=============================================================================

// Category="SigCj:Auto Refresh" Visibility=Public
//Enum eCal_Auto_Refresh - Auto Refresh interval unit

Define eCal_AR_Minutes for 1
Define eCal_AR_Seconds for 2

//-----------------------------------------------------------------------------

// Category="SigCj:Dialogs" Visibility=Public
//Enum eCal_CM_Type - Context Menu type

Define eCal_CM_Disabled for 0
Define eCal_CM_Standard for 1
Define eCal_CM_Custom   for 2

//-----------------------------------------------------------------------------

// Category="SigCj:Data" Visibility=Public
//Enum eCal_DP_Type - Data Provider type

Define eCal_DP_Type_XML    for 1
Define eCal_DP_Type_Access for 2
Define eCal_DP_Type_MAPI   for 3
Define eCal_DP_Type_Custom for 4

//-----------------------------------------------------------------------------

// Category="SigCj:General" Visibility=Public
//Enum eCal_Days - Days

Define eCal_Sunday      for 1
Define eCal_Monday      for 2
Define eCal_Tuesday     for 3
Define eCal_Wednesday   for 4
Define eCal_Thursday    for 5
Define eCal_Friday      for 6
Define eCal_Saturday    for 7

//-----------------------------------------------------------------------------

// Category="SigCj:DB_Link" Visibility=Internal
//Enum eCal_DB_Link - DB_Link custom property names

Define eCal_DB_Link  for "db_link"
Define eCal_DB_Table for "db_link_table"
Define eCal_DB_Key   for "db_link_key"

//-----------------------------------------------------------------------------

// Category="SigCj:General" Visibility=Internal
//Enum eCal_IDs - Created & Modified User IDs

Define eCal_ID_CreatedBy  for "id_created"
Define eCal_ID_ModifiedBy for "id_modified"

//-----------------------------------------------------------------------------

// Category="SigCj:General" Visibility=Internal
//Enum eCal_HitTest_Area - Hit Test Areas

Define eCal_Hit_Unknown         for 0
Define eCal_Hit_AllDayArea      for 1   //16384 
Define eCal_Hit_AllDayEvent     for 2   //32, 16384
Define eCal_Hit_DayArea         for 3   //1, 8192 
Define eCal_Hit_Event           for 4   //32, 8192 
Define eCal_Hit_DayHeader       for 5   //2
Define eCal_Hit_ResourceHeader  for 6   //8
Define eCal_Hit_TimeScale       for 7   //4096 

//-----------------------------------------------------------------------------

// Category="SigCj:General" Visibility=Internal
//Enum eCal_Mouse_Buttons - Mouse Buttons

Define eCal_Mouse_Button_Left    for 1
Define eCal_Mouse_Button_Right   for 2

Define eCal_Mouse_Shift          for 1
Define eCal_Mouse_Ctrl           for 2
Define eCal_Mouse_Alt            for 4
Define eCal_Mouse_Shift_Ctrl     for (eCal_Mouse_Shift + eCal_Mouse_Ctrl )
Define eCal_Mouse_Alt_Shift      for (eCal_Mouse_Alt   + eCal_Mouse_Shift)
Define eCal_Mouse_Alt_Ctrl       for (eCal_Mouse_Alt   + eCal_Mouse_Ctrl )
Define eCal_Mouse_Shift_Alt_Ctrl for (eCal_Mouse_Shift + eCal_Mouse_Alt + eCal_Mouse_Ctrl)

//-----------------------------------------------------------------------------

// Category="SigCj:Special Dates" Visibility=Public
//Enum eCal_SP_AllowCreate  - Special Dates Allow Create

Define eCal_SD_Create_No   for 0
Define eCal_SD_Create_Yes  for 1
Define eCal_SD_Create_Ask  for 2

//-----------------------------------------------------------------------------

// Category="SigCj:Special Dates" Visibility=Public
//Enum eCal_Shade_Type - Special Dates Shade Type

Define eCal_SD_Shade_Working  for 0
Define eCal_SD_Shade_IncLunch for 1
Define eCal_SD_Shade_AllDay   for 2

//-----------------------------------------------------------------------------

// Category="SigCj:Time Scale" Visibility=Public
//Enum eCal_TimeScale - Time Scale interval

Define eCal_TimeScale_5       for 5
Define eCal_TimeScale_10      for 10
Define eCal_TimeScale_15      for 15
Define eCal_TimeScale_20      for 20
Define eCal_TimeScale_30      for 30
Define eCal_TimeScale_60      for 60

//-----------------------------------------------------------------------------

// Category="SigCj:Time Scale" Visibility=Public
//Enum eCal_TimeMark - Time Mark

Define eCal_TM_None             for OLExtpCalendarCurrentTimeMarkNone
Define eCal_TM_VisibleForToday  for OLExtpCalendarCurrentTimeMarkVisibleForToday
Define eCal_TM_VisibleAlways    for OLExtpCalendarCurrentTimeMarkVisibleAlways
Define eCal_TM_Printed          for OLExtpCalendarCurrentTimeMarkPrinted

//-----------------------------------------------------------------------------

// Category="SigCj:General" Visibility=Internal
//Enum eCal_ViewType - ViewType (Simplified set)

Define eCal_ViewType_Day      for OLExtpCalendarDayView
Define eCal_ViewType_Week     for OLExtpCalendarWeekView
Define eCal_ViewType_Month    for OLExtpCalendarMonthView
Define eCal_ViewType_TimeLine for OLExtpCalendarTimeLineView

//==============================================================================

// Category="SigCj:Schedules" Visibility=Internal
Struct tdSigCjCal_DataProvider
    Integer iID
    String  sName
    Integer eDataType
    String  sConnection
End_Struct

//-----------------------------------------------------------------------------

//This probably contains too much. All the names are not really needed but make
//debugging easier. 

// Category="SigCj:General" Visibility=Internal
Struct tdSigCjCal_HitTestInfo       
    Integer   iCode                 //Raw hit code
    Integer   eHitItem              //Our simplified hit code
    DateTime  dtDateTime            //Date and time clicked on - if valid
    Boolean   bDataTimeValid        //Use this to determine if dtDateTime is a valid date time
    Boolean   bEventClicked         //Easier and quicker to check a boolean instead of an IDispatch Pointer
    Boolean   bRecurring            //Is the event a recurring event
    Boolean   bException            //Is the event an exception to a recurring event
    Variant   vEvent                //Get this from viewEvent if valid
    Variant   vViewDay              //Other Codejock view object
    Variant   vViewEvent            //Other Codejock view object
    Variant   vViewGroup            //Other Codejock view object
    Integer   eViewType             //Day / Week / Month
    Integer   eViewType_CJ          //Codejocks extended version of above
    Integer   iGroupIndex           //This is the resource index
    Boolean   bSel_AllDay           //Active View selected info
    DateTime  dtSel_Begin           //  --- " --- " --- " ---
    DateTime  dtSel_End             //  --- " --- " --- " ---
    Integer   iSel_GroupIndex       //  --- " --- " --- " ---
    Boolean   bSel_IsValid          //  --- " --- " --- " ---
    Boolean   bCanCut
    Boolean   bCanCopy
    Boolean   bCanPaste
    Integer   iSelected_Count
    Integer[] iaEvent_IDs
    Integer   iEvent_ID             //ID of Event if Event clcked on
    Integer   iEvent_Master_ID      //Master Event ID if recurring event
    Integer   iRecPattern_ID        //Recurrence Pattern ID if recurring event
    Integer   iLayout_ID            //ID of Layout current loaded
    Integer   iDataProvider_ID      //ID of data provider for resource clicked on
    Integer   iResource_ID          //ID of resource clicked on
    Integer[] iSchedule_IDs         //IDs of schedules displayed in resource
    String    sLayout_Name          //Name of Layout current loaded
    String    sDataProvider_Name    //Name of data provider for resource clicked on 
    String    sResource_Name        //Name of resource clicked on                   
    String[]  sSchedule_Names       //Names of schedules displayed in resource       
    Variant   vDataProvider         //
    Boolean   bHasCustomIcons       //Event has custom icons
    Boolean   bHasCustomProperties  //Event has custom properties
    tdSigCjCal_DB_Link tDB_Link     //Does the event have a DB_Link set
End_Struct

//-----------------------------------------------------------------------------

// Category="SigCj:Schedules" Visibility=Public
Struct tdSigCjCal_Layout
    Integer iID
    String  sName
End_Struct

//-----------------------------------------------------------------------------

// Category="SigCj:Schedules" Visibility=Public
Struct tdSigCjCal_Schedule
    Integer iID
    String  sName
    Integer iShadeColor
    String  sProperties
    //Array of property name and value ?? not sure if it is needed
End_Struct

//-----------------------------------------------------------------------------

// Category="SigCj:Special Dates" Visibility=Public
Struct tdSigCjCal_SpecialDate
    Date    dDate
    Boolean bIsSpecial
    String  sDescription
    Integer iBackColor
    Integer eShadeStyle
    Integer eAllowEvents
End_Struct

//-----------------------------------------------------------------------------

// Category="SigCj:Data" Visibility=Internal
Struct tdSigCjCal_Dialog_COM_Objects
    Variant vDataProvider
    Variant vEvent
    Variant vMasterEvent
    Variant vRecPattern
End_Struct

//-----------------------------------------------------------------------------

// Category="SigCj:Data" Visibility=Internal
Struct tdSigCjCal_RM_DataProvider
    Integer iInUse
    Variant vDataProvider
    tdSigCjCal_DataProvider tDataProvider
End_Struct

//-----------------------------------------------------------------------------

// Category="SigCj:Schedules" Visibility=Internal
Struct tdSigCjCal_RM_Category
    Integer iInUse
    tdSigCjCal_Category tCategory
End_Struct

//-----------------------------------------------------------------------------

// Category="SigCj:Schedules" Visibility=Internal
Struct tdSigCjCal_RM_Schedule
    Integer   iInUse
    Integer[] taCategory_IDs
    tdSigCjCal_Schedule tSchedule
End_Struct

//-----------------------------------------------------------------------------

// Category="SigCj:Schedules" Visibility=Internal
Struct tdSigCjCal_RM_Resource
    Boolean   bEnabled
    Integer   iInUse
    Integer   iDataProvider_ID
    Integer[] iSchedule_IDs
    Variant   vResourceDescription
    tdSigCjCal_Resource tResource
End_Struct    

//-----------------------------------------------------------------------------

// Category="SigCj:Schedules" Visibility=Internal
Struct tdSigCjCal_RM_Layout
    tdSigCjCal_Layout        tLayout
    tdSigCjCal_RM_Resource[] taRM_Resources
End_Struct

