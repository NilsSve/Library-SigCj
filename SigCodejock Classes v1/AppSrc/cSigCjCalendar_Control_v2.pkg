    // Category="SigCj:Dialogs" Visibility=Private
    Procedure Create_Context_Menu_Header
        Handle hoMenu hoItem

        //Menu
        Get Create U_cSigCJContextMenu to hoMenu

        //Add Items
        //No items added - the menu is created dynamically when shown

        Set phoContextMenu_Header to hoMenu
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Dialogs" Visibility=Private
    Procedure Create_Context_Menu_Main
        Handle hoMenu hoItem

        //Menu
        Get Create U_cSigCJContextMenu to hoMenu

        //Add Items
        Send Add_MenuItem of hoMenu (psCM_RefreshData           (Self)) "CM_Refresh_Data"           False  ""
        Send Add_MenuItem of hoMenu (psCM_CreateEvent           (Self)) "CM_Create_Event"           True  ""
        Send Add_MenuItem of hoMenu (psCM_EditEvent             (Self)) "CM_Edit_Event"             False ""
        Send Add_MenuItem of hoMenu (psCM_DeleteEvent           (Self)) "CM_Delete_Event"           False ""

        Send Add_MenuItem of hoMenu (psCM_Cut                   (Self)) "CM_Cut"                    True  ""
        Send Add_MenuItem of hoMenu (psCM_Copy                  (Self)) "CM_Copy"                   False ""
        Send Add_MenuItem of hoMenu (psCM_Paste                 (Self)) "CM_Paste"                  False ""

        Send Add_MenuItem of hoMenu (psCM_Print_Preview         (Self)) "CM_Print_Preview"          True ""
        Send Add_MenuItem of hoMenu (psCM_Print                 (Self)) "CM_Print"                  False ""
        Send Add_MenuItem of hoMenu (psCM_Print_Page_Setup      (Self)) "CM_Print_Page_Setup"       False ""

        Send Add_MenuItem of hoMenu (psCM_GotoDB_Link           (Self)) "CM_Goto_DB_Link"           True  ""
        Send Add_MenuItem of hoMenu (psCM_AddDB_Link            (Self)) "CM_Add_DB_Link"            False  ""
        Send Add_MenuItem of hoMenu (psCM_EditDB_Link           (Self)) "CM_Edit_DB_Link"           False ""
        Send Add_MenuItem of hoMenu (psCM_RemoveDB_Link         (Self)) "CM_Remove_DB_Link"         False ""

        Send Add_MenuItem of hoMenu (psCM_AddCustomIcon         (Self)) "CM_Add_CustomIcon"         True  ""
        Send Add_MenuItem of hoMenu (psCM_RemoveCustomIcon      (Self)) "CM_Remove_CustomIcon"      False ""

        Send Add_MenuItem of hoMenu (psCM_AddCustomProperty     (Self)) "CM_Add_CustomProperty"     True  ""
        Send Add_MenuItem of hoMenu (psCM_EditCustomProperty    (Self)) "CM_Edit_CustomProperty"    False ""
        Send Add_MenuItem of hoMenu (psCM_RemoveCustomProperty  (Self)) "CM_Remove_CustomProperty"  False ""

        Send Add_MenuItem of hoMenu (psCM_RemoveException       (Self)) "CM_RemoveException"        True ""

        Set phoContextMenu_Main to hoMenu
    End_Procedure

