    // Category="SigCj:Schedules" Visibility=Public
    Procedure Create_DataProvider tdSigCjCal_DataProvider tDataProvider
        tdSigCjCal_RM_DataProvider[] taRM_DataProviders

        Get ptaRM_DataProviders to taRM_DataProviders
            Move tDataProvider to taRM_DataProviders[SizeOfArray(taRM_DataProviders)].tDataProvider
        Set ptaRM_DataProviders to taRM_DataProviders
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Support Methods" Visibility=Internal
    Function Create_DataProvider_COM_Object Handle hoResourceManager tdSigCjCal_DataProvider tDataProvider Returns Variant
        Boolean bOK
        Integer eDP_Flags iCount
        String  sConnection
        Handle  hoDataProvider hoEventCategories
        Variant vDataProvider vCategories

        Get Connection_String tDataProvider to sConnection
        
        If (sConnection <> "ERROR") Begin
            Case Begin
                Case (tDataProvider.eDataType = eCal_DP_Type_XML)
                    Move (OLExtpCalendarDPF_CreateIfNotExists + OLExtpCalendarDPF_SaveOnDestroy + OLExtpCalendarDPF_CloseOnDestroy) to eDP_Flags
                Case Break
    
                Case (tDataProvider.eDataType = eCal_DP_Type_Access)
                    Move (OLExtpCalendarDPF_CreateIfNotExists + OLExtpCalendarDPF_SaveOnDestroy + OLExtpCalendarDPF_CloseOnDestroy) to eDP_Flags
                Case Break
    
                Case (tDataProvider.eDataType = eCal_DP_Type_MAPI)
                    Move (OLExtpCalendarDPF_CreateIfNotExists + OLExtpCalendarDPF_SaveOnDestroy + OLExtpCalendarDPF_CloseOnDestroy) to eDP_Flags
                Case Break
    
                Case (tDataProvider.eDataType = eCal_DP_Type_Custom)
                    Move OLExtpCalendarDPFUnknown to eDP_Flags
                Case Break
            Case End

            Get ComAddDataProvider of hoResourceManager sConnection eDP_Flags to bOK
    
            If (bOK) Begin
                Get ComDataProvidersCount of hoResourceManager to iCount
                Get ComDataProvider       of hoResourceManager (iCount -1) to vDataProvider
                Get Internal_phoDataProvider to hoDataProvider
                Set pvComObject of hoDataProvider to vDataProvider
                Get ComOpen of hoDataProvider to bOK
    
                If (not(bOK)) Begin
                    Move (NullComObject()) to vDataProvider
                    Error 501 ("Cannot open Data Provider (ID: " + String(tDataProvider.iID) + ")")
                End
                Else Begin
                    Get Internal_phoEventCategories to hoEventCategories
                    Get ComEventCategories of hoDataProvider to vCategories
                    Set pvComObject of hoEventCategories to vCategories
    
                    Send ComRemoveAll of hoEventCategories
                End
            End
            Else Begin
                Move (NullComObject()) to vDataProvider
                Error 501 ("Cannot add Data Provider (ID: " + String(tDataProvider.iID) + ")")
            End
        End //not error

        Function_Return vDataProvider
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Schedules" Visibility=Private
    Procedure Create_Default_Data_Provider
        tdSigCjCal_DataProvider tDataProvider

        Move (piVDF_DataProvider(Self)) to tDataProvider.iID
        Move eCal_DP_Type_Custom        to tDataProvider.eDataType
        Move "Default VDF"              to tDataProvider.sName
        Move "VDF"                      to tDataProvider.sConnection

        Send Create_DataProvider tDataProvider
    End_Procedure

