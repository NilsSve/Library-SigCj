    // Category="SigCj:Construction" Visibility=Internal     
    Procedure End_Construct_Object
        Handle hoIdleHandler
        Forward Send End_Construct_Object

        Send Set_Theme_To_Office_07     //Force the theme to Office 07 - Design constraint

        Send Create_Context_Menu_Header
        Send Create_Context_Menu_Main
        Send Create_Context_Menu_Scale
        Send OnRegisterDialogs

        Get Create U_cSigCjCalendar_IdleHandler to hoIdleHandler
        Set phoIdleHandler to hoIdleHandler
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Construction" Visibility=Internal     
    Procedure OnCreate
        Boolean bIsComObjectCreated bRetVal
        Handle  hoDialogs hWND
        Variant vCal_ComObject

        //Which mode are we working in resource mode or simple mode
        Set Internal_pbEnableResources to (pbEnableResources(Self))

        Forward Send OnCreate

        //Connect embedded objects
        Set pvComObject of (Internal_phoDayView            (Self)) to (ComDayView            (Self))
        Set pvComObject of (Internal_phoCalendarOptions    (Self)) to (ComOptions            (Self))
        Set pvComObject of (Internal_phoPrintOptions       (Self)) to (ComPrintOptions       (Self))
        Set pvComObject of (Internal_phoPrintPreviewOptions(Self)) to (ComPrintPreviewOptions(Self))
        Set pvComObject of (Internal_phoPageHeader         (Self)) to (ComHeader             (Internal_phoPrintOptions(Self)))
        Set pvComObject of (Internal_phoPageFooter         (Self)) to (ComFooter             (Internal_phoPrintOptions(Self)))
        Set pvComObject of (Internal_phoPrinterInfo        (Self)) to (ComPrinterInfo        (Internal_phoPrintOptions(Self)))

        //Connect the font objects
        Send Link of oHeader_Font         (ComDateHeaderFont         (Internal_phoPrintOptions(Self)))
        Send Link of oHeaderCalendar_Font (ComDateHeaderCalendarFont (Internal_phoPrintOptions(Self)))
        Send Link of oPrn_Footer_Font     (ComFont                   (Internal_phoPageFooter  (Self)))
        Send Link of oPrn_Header_Font     (ComFont                   (Internal_phoPageHeader  (Self)))

        //Get the units for the print margins. This is done once here for speed.
        //If the users change their units while the app is running then tufff.
        Get ComMarginsMeasureMetrics of (Internal_phoPrintOptions(Self)) to bRetVal
        Set Internal_pbMarginsMeasureMetrics to bRetVal

        //Create Com Resource Manager and default (VDF) Data Provider
        Get IsComObjectCreated of (Internal_phoResourceManager(Self)) to bIsComObjectCreated
        If (not(bIsComObjectCreated)) Begin
            Send CreateComObject of (Internal_phoResourceManager(Self))
            Send Create_Default_Data_Provider
        End

        //Create Built-in dialogs and attach to calendar
        Get Internal_phoCalendarDialogs to hoDialogs
        Get IsComObjectCreated of hoDialogs to bIsComObjectCreated
        If (not(bIsComObjectCreated)) Begin
            Send CreateComObject of hoDialogs
        End

        //Attached the dialogs to the calendar container
        Move (Window_Handle(Parent(Self))) to hWND
        Set ComParentHWND of hoDialogs to hWND

        //Attached the dialogs to the calendar object
        Get pvComObject to vCal_ComObject
        Set ComCalendar of hoDialogs to vCal_ComObject

        //Reminders
        Get ComCreateRemindersWindow of hoDialogs to bRetVal

        //Set the control properties
        Set psCustomFormat4Tooltip                              to (Internal_psCustomFormat4Tooltip                          (Self))
        Set psCustomTitle                                       to (Internal_psCustomTitle                                   (Self))
        Set psDayHeaderFormat                                   to (Internal_psDayHeaderFormat                               (Self))
        Set pbDayViewAutoResetBusyFlag                          to (Internal_pbDayViewAutoResetBusyFlag                      (Self))
        Set peDayViewCurrentTimeMarkVisible                     to (Internal_peDayViewCurrentTimeMarkVisible                 (Self))
        Set pbDayViewTimeScaleShowMinutes                       to (Internal_pbDayViewTimeScaleShowMinutes                   (Self))
        Set pbEnableAddNewTooltip                               to (Internal_pbEnableAddNewTooltip                           (Self))
        Set pbEnabled                                           to (Internal_pbEnabled                                       (Self))
        Set pbEnableInPlaceCreateEvent                          to (Internal_pbEnableInPlaceCreateEvent                      (Self))
        Set pbEnableInPlaceEditEventSubject_AfterEventResize    to (Internal_pbEnableInPlaceEditEventSubject_AfterEventResize(Self))
        Set pbEnableInPlaceEditEventSubject_ByF2                to (Internal_pbEnableInPlaceEditEventSubject_ByF2            (Self))
        Set pbEnableInPlaceEditEventSubject_ByMouseClick        to (Internal_pbEnableInPlaceEditEventSubject_ByMouseClick    (Self))
        Set pbEnableInPlaceEditEventSubject_ByTab               to (Internal_pbEnableInPlaceEditEventSubject_ByTab           (Self))
        Set pbEnablePrevNextEventButtons                        to (Internal_pbEnablePrevNextEventButtons                    (Self))
        Set pbEnableReminders                                   to (Internal_pbEnableReminders                               (Self))
        Set pbEnableToolTips                                    to (Internal_pbEnableToolTips                                (Self))
        Set peFirstDayOfTheWeek                                 to (Internal_peFirstDayOfTheWeek                             (Self))
        Set pbFullDateMode                                      to (Internal_pbFullDateMode                                  (Self))
        Set pbMarkupEnabled                                     to (Internal_pbMarkupEnabled                                 (Self))
        Set piMinColumnWidth                                    to (Internal_piMinColumnWidth                                (Self))
        Set pbMonthViewCompressWeekendDays                      to (Internal_pbMonthViewCompressWeekendDays                  (Self))
        Set ComMultipleSchedulesMode                            to (Internal_pbMultipleSchedulesMode                         (Self))
        Set pbOneLineCaptionBar                                 to (Internal_pbOneLineCaptionBar                             (Self))
        Set psPreviewTitle                                      to (Internal_psPreviewTitle                                  (Self))
        Set piPrnBlackWhiteContrast                             to (Internal_piPrnBlackWhiteContrast                         (Self))
        Set pbPrnBlackWhitePrinting                             to (Internal_pbPrnBlackWhitePrinting                         (Self))
        Set pbPrnLandscape                                      to (Internal_pbPrnLandscape                                  (Self))
        Set psPrnFooterFormatString                             to (Internal_psPrnFooterFormatString                         (Self))
        Set psPrnFooterLeft                                     to (Internal_psPrnFooterLeft                                 (Self))
        Set psPrnFooterCenter                                   to (Internal_psPrnFooterCenter                               (Self))
        Set psPrnFooterRight                                    to (Internal_psPrnFooterRight                                (Self))
        Set psPrnHeaderFormatString                             to (Internal_psPrnHeaderFormatString                         (Self))
        Set psPrnHeaderLeft                                     to (Internal_psPrnHeaderLeft                                 (Self))
        Set psPrnHeaderCenter                                   to (Internal_psPrnHeaderCenter                               (Self))
        Set psPrnHeaderRight                                    to (Internal_psPrnHeaderRight                                (Self))
        Set pnPrnMarginBottom                                   to (Internal_pnPrnMarginBottom                               (Self))
        Set pnPrnMarginLeft                                     to (Internal_pnPrnMarginLeft                                 (Self))
        Set pnPrnMarginRight                                    to (Internal_pnPrnMarginRight                                (Self))
        Set pnPrnMarginTop                                      to (Internal_pnPrnMarginTop                                  (Self))
        Set pbPrnPrintDateHeader                                to (Internal_pbPrnPrintDateHeader                            (Self))
        Set pdPrnPrintFrom                                      to (Internal_pdPrnPrintFrom                                  (Self))
        Set pbPrnPrintFromToExactly                             to (Internal_pbPrnPrintFromToExactly                         (Self))
        Set pdPrnPrintTo                                        to (Internal_pdPrnPrintTo                                    (Self))
        Set pbReadOnlyMode                                      to (Internal_pbReadOnlyMode                                  (Self))
        Set pbRightToLeft                                       to (Internal_pbRightToLeft                                   (Self))
        Set pbShowCaptionBar                                    to (Internal_pbShowCaptionBar                                (Self))
        Set pbShowCaptionBarDateLabel                           to (Internal_pbShowCaptionBarDateLabel                       (Self))
        Set pbShowCaptionBarExpandButton                        to (Internal_pbShowCaptionBarExpandButton                    (Self))
        Set pbShowCaptionBarScrollDateButtons                   to (Internal_pbShowCaptionBarScrollDateButtons               (Self))
        Set pbShowCaptionBarSwitchViewButtons                   to (Internal_pbShowCaptionBarSwitchViewButtons               (Self))
        Set pbShowEndDate                                       to (Internal_pbMonthViewShowEndDate                          (Self))
        Set pbShowMultiColumnsButton                            to (Internal_pbShowMultiColumnsButton                        (Self))
        Set pbShowTimeAsClocks                                  to (Internal_pbMonthViewShowTimeAsClocks                     (Self))
        Set pbShowTooltipForAllDayEvents                        to (Internal_pbShowTooltipForAllDayEvents                    (Self))
        Set pbShowTooltipForNotFocused                          to (Internal_pbShowTooltipForNotFocused                      (Self))
        Set pbSwitchToDayViewIfPickedSingleDay                  to (Internal_pbSwitchToDayViewIfPickedSingleDay              (Self))
        Set peTimeScale                                         to (Internal_peTimeScale                                     (Self))
        Set ptmTimeScaleMaxTime                                 to (Internal_ptmTimeScaleMaxTime                             (Self))
        Set ptmTimeScaleMinTime                                 to (Internal_ptmTimeScaleMinTime                             (Self))
        Set psTooltipAddNewText                                 to (Internal_psTooltipAddNewText                             (Self))
        Set pbTooltipUnderMouse                                 to (Internal_pbTooltipUnderMouse                             (Self))
        Set pbUseMultiColumnWeekMode                            to (Internal_pbUseMultiColumnWeekMode                        (Self))
        Set ptmWorkDayEndTime                                   to (Internal_ptmWorkDayEndTime                               (Self))
        Set ptmWorkDayStartTime                                 to (Internal_ptmWorkDayStartTime                             (Self))
        Set peWorkWeekMask                                      to (Internal_peWorkWeekMask                                  (Self))

        //Properties not exposed to users
#IF (SigCj_Codejock_Version < 200300)  
        Set ComDayViewScale2Label   of (Internal_phoCalendarOptions(Self)) to (Internal_psDayViewScale2Label   (Self))
        Set ComDayViewScale2Visible of (Internal_phoCalendarOptions(Self)) to (Internal_pbDayViewScale2Visible (Self))
#ELSE
        Set ComDayViewAdditionalScaleLabel   of (Internal_phoCalendarOptions(Self)) to (Internal_psDayViewScale2Label   (Self))
        Set ComDayViewAdditionalScaleLeftVisible of (Internal_phoCalendarOptions(Self)) to (Internal_pbDayViewScale2Visible (Self))
#ENDIF
        Set ComDayViewScaleLabel    of (Internal_phoCalendarOptions(Self)) to (Internal_psDayViewScaleLabel    (Self))
        Set ComEnableTimelineButton of (Internal_phoCalendarOptions(Self)) to (Internal_pbEnableTimelineButton (Self))
        Set ComShowTimelineButton                                          to (Internal_pbShowTimelineButton   (Self))
        Set ComHideCaptionBar                                              to (Internal_pbHideCaptionBar_In_TL_Mode (Self))
        Set ComUseOutlookFontGlyphs of (Internal_phoCalendarOptions(Self)) to (Internal_pbUseOutlookFontGlyphs (Self))

        Send Enable_Draw_Events //Enable before draw events - needed for icons and colors
        If (Internal_pbEnableResources(Self)) Begin
            Send OnLoadLayout
        End
        Else Begin
            Send OnCreate_DataProvider
            Send Simple_DataProvider_Create
            Send OnCreate_Categories
            Send Simple_DataProvider_Apply_Categories

            //Disable Header context menu
            If (Not(Internal_pbEnableResources(Self))) Begin
                Set peContextMenu_Header to eCal_CM_Disabled
            End
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Construction" Visibility=Internal     
    Procedure Activating
        Forward Send Activating

        If (pbEnableAutoRefresh(Self)) Begin
            Set pdtLastRefresh to (CurrentDateTime())
            Set pbEnabled of (phoIdleHandler(Self)) to True
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Construction" Visibility=Internal     
    Procedure DeActivating
        If (pbEnableAutoRefresh(Self)) Begin
            Set pbEnabled of (phoIdleHandler(Self)) to False
        End

        Forward Send Deactivating
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Auto Refresh" Visibility=Internal     
    Procedure DoIdleHandler
        Integer  eIntervalUnits
        DateTime dtNow dtLastRefresh
        TimeSpan tsRefreshInterval tsHowLong

        If (peIntervalUnits(Self) = eCal_AR_Seconds) Begin
            Move (DateSetSecond(tsRefreshInterval, piRefreshInterval(Self))) to tsRefreshInterval
        End
        Else Begin
            Move (DateSetSecond(tsRefreshInterval, 0)) to tsRefreshInterval
        End

        If (peIntervalUnits(Self) = eCal_AR_Minutes) Begin
            Move (DateSetMinute(tsRefreshInterval, piRefreshInterval(Self))) to tsRefreshInterval
        End
        Else Begin
            Move (DateSetMinute(tsRefreshInterval, 0)) to tsRefreshInterval
        End

        Move (DateSetHour  (tsRefreshInterval, 0)) to tsRefreshInterval
        Move (DateSetDay   (tsRefreshInterval, 0)) to tsRefreshInterval

        Get pdtLastRefresh to dtLastRefresh
        Move (CurrentDateTime()) to dtNow
        Move (dtNow - dtLastRefresh) to tsHowLong
        If (tsHowLong > tsRefreshInterval) Begin
            //- add event ? - Send OnBefore_AutoRefresh
            Send Refresh_Data True
            //- add event ? - Send OnAfter_AutoRefresh
        End
    End_Procedure

    //=========================================================================
    //Main Methods
    //=========================================================================

    // Category="SigCj:Support Methods" Visibility=Internal
    Procedure Add_Categories Handle hoEventCategories Integer[] iSchedule_IDs
        Integer   iCategory_Count iCategory_Loop iCategory_Index
        Integer   iSchedule_Count iSchedule_Loop iSchedule_Index
        Variant   vCategory
        tdSigCjCal_RM_Category[] taRM_Categories
        tdSigCjCal_RM_Schedule[] taRM_Schedules

        Get ptaRM_Categories to taRM_Categories
        Get ptaRM_Schedules  to taRM_Schedules

        //Create deduped list of required categories
        Move (SizeOfArray(iSchedule_IDs) - 1) to iSchedule_Count
        For iSchedule_Loop from 0 to iSchedule_Count
            Get Schedule_Index iSchedule_IDs[iSchedule_Loop] to iSchedule_Index
            Move (SizeOfArray(taRM_Schedules[iSchedule_Index].taCategory_IDs) - 1) to iCategory_Count
            For iCategory_Loop from 0 to iCategory_Count
                Get ComFind of hoEventCategories taRM_Schedules[iSchedule_Index].taCategory_IDs[iCategory_Loop] to vCategory
                If (IsNullComObject(vCategory)) Begin
                    //Now create the Category COM object
                    Get Category_Index taRM_Schedules[iSchedule_Index].taCategory_IDs[iCategory_Loop] to iCategory_Index
                    Send Create_Category_COM_Object hoEventCategories taRM_Categories[iCategory_Index].tCategory
                End
            Loop
        Loop
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Icons" Visibility=Public
    Procedure AddCustomIcon Integer iDataProvider_ID Integer iEvent_ID Integer iIcon_ID
        Handle  hoCalendarIconIDs hoDataProvider hoEvent
        Variant  vCalendarIconIDs  vDataProvider  vEvent

        Get Event_Object iDataProvider_ID iEvent_ID to vEvent
        Get Internal_phoEvent to hoEvent
        Set pvComObject of hoEvent to vEvent

        Get ComCustomIcons of hoEvent to vCalendarIconIDs
        Get Internal_phoCalendarIconIDs to hoCalendarIconIDs
        Set pvComObject of hoCalendarIconIDs to vCalendarIconIDs
        Send ComAddIfNeed of hoCalendarIconIDs iIcon_ID

        Send Notify_Event_Changed hoEvent
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Data" Visibility=Public
    Procedure AddEventToCollection tdSigCjCal_Event tEvent
        Variant vEvent

        Move (NullComObject()) to vEvent
        Get CreateEventObject tEvent False to vEvent

        If (not(IsNullComObject(vEvent))) Begin
            Send ComAdd of (Internal_phoEvents(Self)) vEvent
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Data" Visibility=Public
    Procedure AddRecPatternExceptionEvent tdSigCjCal_Event tEvent
        Variant vEvent

        Move (NullComObject()) to vEvent
        Get CreateEventObject tEvent True to vEvent

        If (not(IsNullComObject(vEvent))) Begin
            Send ComSetException of (Internal_phoRecPattern(Self)) vEvent
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Schedules" Visibility=Public
    Procedure Apply_Category Integer iSchedule_ID Integer iCategory_ID
        Integer iSchedule_Index iCategory_Index iIndex
        tdSigCjCal_RM_Category[] taRM_Categories
        tdSigCjCal_RM_Schedule[] taRM_Schedules

        Get Schedule_Index iSchedule_ID to iSchedule_Index
        If (iSchedule_Index <> -1) Begin
            Get Category_Index iCategory_ID to iCategory_Index
            If (iCategory_Index <> -1) Begin
                Get ptaRM_Schedules to taRM_Schedules
                    Move (SizeOfArray(taRM_Schedules[iSchedule_Index].taCategory_IDs)) to iIndex
                    Move iCategory_ID to taRM_Schedules[iSchedule_Index].taCategory_IDs[iIndex]
                Set ptaRM_Schedules to taRM_Schedules

                Get ptaRM_Categories to taRM_Categories
                    Increment taRM_Categories[iCategory_Index].iInUse
                Set ptaRM_Categories to taRM_Categories
            End
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Schedules" Visibility=Public
    Procedure Apply_DataProvider Integer iResource_ID Integer iDataProvider_ID
        Integer iResource_Index iDataProvider_Index
        tdSigCjCal_RM_DataProvider[] taRM_DataProviders
        tdSigCjCal_RM_Resource[]     taRM_Resources

        Get Resource_Index iResource_ID False to iResource_Index
        If (iResource_Index <> -1) Begin
            Get DataProvider_Index iDataProvider_ID to iDataProvider_Index
            If (iDataProvider_Index <> -1) Begin
                Get ptaRM_Resources to taRM_Resources
                    Move iDataProvider_ID to taRM_Resources[iResource_Index].iDataProvider_ID
                Set ptaRM_Resources to taRM_Resources

                Get ptaRM_DataProviders to taRM_DataProviders
                    Increment taRM_DataProviders[iDataProvider_Index].iInUse
                Set ptaRM_DataProviders to taRM_DataProviders
            End
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Schedules" Visibility=Public
    Procedure Apply_Layout Integer iLayout_ID
        Boolean bOK
        Integer iCount iLoop iIndex
        Integer iLayout_Index iDataProvider_Index iSchedule_Index
        Integer iResource_Count iResource_Loop iSchedule_Count iSchedule_Loop
        Handle  hoResourceManager hoResourceDescription hoResource hoDataProvider
        Handle  hoScheduleIDs hoEventCategories hoSchedules
        Variant vScheduleIDs
        Integer[] iSchedule_IDs
        tdSigCjCal_RM_DataProvider[] taRM_DataProviders
        tdSigCjCal_RM_Layout[]       taRM_Layouts
        tdSigCjCal_RM_Resource[]     taRM_Resources
        tdSigCjCal_RM_Schedule[]     taRM_Schedules

        If (Internal_pbEnableResources(Self)) Begin
            Get Layout_Index iLayout_ID to iLayout_Index
            If (iLayout_Index <> -1) Begin
                //Get handles to other objects
                Get Internal_phoDataProvider        to hoDataProvider
                Get Internal_phoEventCategories     to hoEventCategories
                Get Internal_phoResource            to hoResource
                Get Internal_phoResourceManager     to hoResourceManager
                Get Internal_phoResourceDescription to hoResourceDescription
                Get Internal_phoScheduleIDs         to hoScheduleIDs
                Get Internal_phoSchedules           to hoSchedules
    
                Get ptaRM_Layouts       to taRM_Layouts
                Get ptaRM_DataProviders to taRM_DataProviders
                Get ptaRM_Schedules     to taRM_Schedules
    
                //Reset Data Providers
                Send ReleaseComObject of hoDataProvider
                Move (SizeOfArray(taRM_DataProviders) - 1) to iCount
                For iLoop from 0 to iCount
                    Move (NullComObject()) to taRM_DataProviders[iLoop].vDataProvider
                Loop
        
                //Reset Resource manager
                Send ReleaseComObject to hoResource
                Send ReleaseComObject to hoResourceDescription
                Send ComRemoveAll of hoResourceManager
    
                //Get Layout info
                Move taRM_Layouts[iLayout_Index].taRM_Resources to taRM_Resources
    
                //Create Resource(s)
                Move (SizeOfArray(taRM_Resources) - 1) to iResource_Count
                For iResource_Loop from 0 to iResource_Count
                    //Add Resource, creating data providers as we go
                    Get ComAddResource of hoResourceManager taRM_Resources[iResource_Loop].tResource.sName taRM_Resources[iResource_Loop].bEnabled to bOK
                    If (bOK) Begin
                        //Resource
                        Get ComResource of hoResourceManager (ComResourcesCount(hoResourceManager) - 1) to taRM_Resources[iResource_Loop].vResourceDescription
                        Set pvComObject of hoResourceDescription to taRM_Resources[iResource_Loop].vResourceDescription
                        Set ComGenerateName of hoResourceDescription to False
    
                        //Data Provider
                        Get DataProvider_Index taRM_Resources[iResource_Loop].iDataProvider_ID to iDataProvider_Index
                        If (IsNullComObject(taRM_DataProviders[iDataProvider_Index].vDataProvider)) Begin
                            Get Create_DataProvider_COM_Object hoResourceManager taRM_DataProviders[iDataProvider_Index].tDataProvider ;
                            to taRM_DataProviders[iDataProvider_Index].vDataProvider
                        End
    
                        Set pvComObject of hoResource to (ComResource(hoResourceDescription))
                        Send ComSetDataProvider of hoResource taRM_DataProviders[iDataProvider_Index].vDataProvider False
                        Set pvComObject of hoDataProvider to taRM_DataProviders[iDataProvider_Index].vDataProvider
                        Set ComCacheMode of hoDataProvider to OLExtpCalendarDPCacheModeOnClear
    
                        //Add Categories
                        Set pvComObject of hoEventCategories to (ComEventCategories(hoDataProvider))
                        Send Add_Categories hoEventCategories taRM_Resources[iResource_Loop].iSchedule_IDs
    
                        //Schedules
                        Get ComScheduleIDs of hoResource to vScheduleIDs
                        Set pvComObject of hoScheduleIDs to vScheduleIDs
    
                        Move (SizeOfArray(taRM_Resources[iResource_Loop].iSchedule_IDs) - 1) to iSchedule_Count
                        For iSchedule_Loop from 0 to iSchedule_Count
                            Set pvComObject of hoSchedules to (ComSchedules(hoDataProvider))
                            Get Schedule_Index taRM_Resources[iResource_Loop].iSchedule_IDs[iSchedule_Loop] to iSchedule_Index
                            Send Create_Schedule_COM_Object hoSchedules taRM_Schedules[iSchedule_Index].tSchedule
    
                            Send ComAdd of hoScheduleIDs taRM_Resources[iResource_Loop].iSchedule_IDs[iSchedule_Loop]
                            Move (SearchArray(taRM_Resources[iResource_Loop].iSchedule_IDs[iSchedule_Loop], iSchedule_IDs)) to iIndex
                            If (iIndex = -1) Begin
                                Move taRM_Resources[iResource_Loop].iSchedule_IDs[iSchedule_Loop] to iSchedule_IDs[SizeOfArray(iSchedule_IDs)]
                            End
                        Loop
                    End
                    Else Begin
                        Error 501 ("Failed to Create COM Resource(ID: " + String(taRM_Resources[iResource_Loop].tResource.iID) + " )")
                    End
                Loop
    
                Move taRM_Resources to taRM_Layouts[iLayout_Index].taRM_Resources
                Set ptaRM_Layouts to taRM_Layouts
                Set ptaRM_DataProviders to taRM_DataProviders
                Set piaSchedule_IDs to iSchedule_IDs
                Set piCurrent_Layout_ID to iLayout_ID
    
                Send ComApplyToCalendar of hoResourceManager (pvComObject(Self))
                Send ComPopulate
//                Send ComPopulate    //Need to send this twice!! Could be a thread timing issues
            End //Layout index <> -1
        End//pbEnableResources
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Schedules" Visibility=Public
    Procedure Apply_Resource Integer iLayout_ID Integer iResource_ID Boolean bEnabled_State
        Boolean bEnabled
        Integer iLayout_Index iResource_Index iIndex
        tdSigCjCal_RM_Layout[]   taRM_Layouts
        tdSigCjCal_RM_Resource[] taRM_Resources

        Get Layout_Index iLayout_ID to iLayout_Index
        If (iLayout_Index <> -1) Begin
            Get Resource_Index iResource_ID False to iResource_Index
            If (iResource_Index <> -1) Begin
                If (num_arguments > 2) Move bEnabled_State to bEnabled
                Else                   Move True           to bEnabled

                Get ptaRM_Resources to taRM_Resources
                    Increment taRM_Resources[iResource_Index].iInUse
                Set ptaRM_Resources to taRM_Resources

                Get ptaRM_Layouts to taRM_Layouts
                    Move (SizeOfArray(taRM_Layouts[iLayout_Index].taRM_Resources)) to iIndex
                    Move taRM_Resources[iResource_Index] to taRM_Layouts[iLayout_Index].taRM_Resources[iIndex]
                    Move bEnabled                        to taRM_Layouts[iLayout_Index].taRM_Resources[iIndex].bEnabled
                Set ptaRM_Layouts to taRM_Layouts
            End
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Schedules" Visibility=Public
    Procedure Apply_Schedule Integer iResource_ID Integer iSchedule_ID
        Integer iResource_Index iSchedule_Index iIndex
        tdSigCjCal_RM_Resource[] taRM_Resources
        tdSigCjCal_RM_Schedule[] taRM_Schedules

        Get Resource_Index iResource_ID False to iResource_Index
        If (iResource_Index <> -1) Begin
            Get Schedule_Index iSchedule_ID to iSchedule_Index
            If (iSchedule_Index <> -1) Begin
                Get ptaRM_Resources to taRM_Resources
                    Move (SizeOfArray(taRM_Resources[iResource_Index].iSchedule_IDs)) to iIndex
                    Move iSchedule_ID to taRM_Resources[iResource_Index].iSchedule_IDs[iIndex]
                Set ptaRM_Resources to taRM_Resources

                Get ptaRM_Schedules to taRM_Schedules
                    Increment taRM_Schedules[iSchedule_Index].iInUse
                Set ptaRM_Schedules to taRM_Schedules
            End
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Support Methods" Visibility=Internal
    Procedure Apply_Standard_Event_Icons Handle  hoEvents
        Boolean bIE_Reminder bIE_Recurrence bIE_Exception bIE_Meeting bIE_Private 
        Boolean bReminder bRecurrence bException bMeeting bPrivate bDB_Link
        Integer iCount iLoop iRecState
        Handle  hoEvent hoIconIDs
        Variant vEvent  vCustomIcons

        Get Internal_phoEvent to hoEvent
        Get Internal_phoCalendarIconIDs to hoIconIDs

        Get pbIconEnabled_Exception  to bIE_Exception
        Get pbIconEnabled_Meeting    to bIE_Meeting
        Get pbIconEnabled_Private    to bIE_Private
        Get pbIconEnabled_Recurrence to bIE_Recurrence
        Get pbIconEnabled_Reminder   to bIE_Reminder

        Get ComCount of hoEvents to iCount
        Decrement iCount

        For iLoop from 0 to iCount
            Move False to bException
            Move False to bMeeting
            Move False to bPrivate
            Move False to bRecurrence
            Move False to bReminder

            Get ComEvent of hoEvents iLoop to vEvent
            Set pvComObject of hoEvent to vEvent

            If (bIE_Reminder) Get ComReminder    of hoEvent to bReminder
            If (bIE_Meeting)  Get ComMeetingFlag of hoEvent to bMeeting
            If (bIE_Private)  Get ComPrivateFlag of hoEvent to bPrivate

            Get ComRecurrenceState of hoEvent to iRecState
            If (bIE_Recurrence) Move (iRecState = OLExtpCalendarRecurrenceOccurrence) to bRecurrence
            If (bIE_Exception)  Move (iRecState = OLExtpCalendarRecurrenceException ) to bException

            Get ComCustomIcons of hoEvent to vCustomIcons
            Set pvComObject of hoIconIDs to vCustomIcons

            If (bReminder  ) Send ComAddIfNeed of hoIconIDs OLExtpCalendarEventIconIDReminder
            Else             Send ComRemoveID  of hoIconIDs OLExtpCalendarEventIconIDReminder

            If (bRecurrence) Send ComAddIfNeed of hoIconIDs OLExtpCalendarEventIconIDOccurrence
            Else             Send ComRemoveID  of hoIconIDs OLExtpCalendarEventIconIDOccurrence

            If (bException ) Send ComAddIfNeed of hoIconIDs OLExtpCalendarEventIconIDException
            Else             Send ComRemoveID  of hoIconIDs OLExtpCalendarEventIconIDException

            If (bMeeting   ) Send ComAddIfNeed of hoIconIDs OLExtpCalendarEventIconIDMeeting
            Else             Send ComRemoveID  of hoIconIDs OLExtpCalendarEventIconIDMeeting

            If (bPrivate   ) Send ComAddIfNeed of hoIconIDs OLExtpCalendarEventIconIDPrivate
            Else             Send ComRemoveID  of hoIconIDs OLExtpCalendarEventIconIDPrivate

            If (pbEnableDB_Link(Self)) Begin
                Get psCustomProperty_hoEvent eCal_DB_Link to bDB_Link
                If (bDB_Link) Send ComAddIfNeed of hoIconIDs (piIconID_DB_Link(Self))
                Else          Send ComRemoveID  of hoIconIDs (piIconID_DB_Link(Self))
            End
        Loop
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Support Methods" Visibility=Internal
    Procedure BeforeDrawDay_DayViewCell Handle hoDrawParams
        Boolean  bWorkCell bShade bLastDay 
        Handle   hoCellColor hoViewGroup
        Variant  vViewGroup
        DateTime dtBegin
        Integer  iSpecial_Date eShadeStyle
        Integer iWorkingColour iNonWorkingColour 
        Integer iResource_Color iResource_Index iLayout_Index
        tdSigCjCal_RM_Layout[] taRM_Layouts

        Get ComBeginTime of hoDrawParams to dtBegin
        Get ComWorkCell  of hoDrawParams to bWorkCell

        Get piWorkingCellBackColor    to iWorkingColour
        Get piNonWorkingCellBackColor to iNonWorkingColour

        If (pbEnableSpecialDates(Self)) Begin
            Get SpecialDate_Is_Special_Date (Date(dtBegin)) to iSpecial_Date
            If (iSpecial_Date <> -1) Begin
                Get SpecialDate_Back_Color iSpecial_Date to iWorkingColour
                Get SpecialDate_ShadeType  iSpecial_Date to eShadeStyle
                If (eShadeStyle = eCal_SD_Shade_AllDay) Begin
                    Get SpecialDate_Back_Color iSpecial_Date to iNonWorkingColour 
                End
            End
        End
        Else Begin
            Move -1 to iSpecial_Date
        End

        If (bWorkCell) Begin
            If (pbEnable_ShadeResources(Self)) Begin
                Get ComViewGroup of hoDrawParams to vViewGroup
                Get Internal_phoViewGroup to hoViewGroup
                Set pvComObject of hoViewGroup to vViewGroup
                Get ComGroupIndex of hoViewGroup to iResource_Index

                Get ptaRM_Layouts to taRM_Layouts
                Get Layout_Index (piCurrent_Layout_ID(Self)) to iLayout_Index
                 If (SizeOfArray(taRM_Layouts[iLayout_Index].taRM_Resources) > 0) Begin
                    Move taRM_Layouts[iLayout_Index].taRM_Resources[iResource_Index].tResource.iShadeColor to iResource_Color
                    If (taRM_Layouts[iLayout_Index].taRM_Resources[iResource_Index].tResource.bMuiltiColor) Begin
                        Get OnResourceMultiColor dtBegin taRM_Layouts[iLayout_Index].taRM_Resources[iResource_Index].tResource to iResource_Color
                    End
                    If (iResource_Color > 0) Begin
                        Move iResource_Color to iWorkingColour
                    End
                End
            End
            
            If (pbShadeLunchTime(Self)) Begin
                Get IsTimeBetween dtBegin (ptmLunchStartTime(Self)) (ptmLunchEndTime(Self)) to bShade
                If (bShade) Begin
                    If (iSpecial_Date <> -1) begin
                        If (eShadeStyle = eCal_SD_Shade_Working) Begin
                            Move iNonWorkingColour to iWorkingColour
                        End
                    End
                    Else Begin
                        Move iNonWorkingColour to iWorkingColour
                    End
                End
            End

            If (pbShorterLastDay(Self)) Begin
                Get IsLastWeekDay (Date(dtBegin)) to bLastDay
                If (bLastDay) Begin
                    Get IsTimeBetween dtBegin (ptmLastWorkDayEndTime(Self)) (Internal_ptmWorkDayEndTime(Self)) to bShade
                    If (bShade) Begin
                        Move iNonWorkingColour to iWorkingColour
                    End
                End
            End
        End

        If (bWorkCell) Begin
            Get Internal_phoWorkingCellColors to hoCellColor
            Set ComBackgroundColor of hoCellColor to iWorkingColour
        End
        Else Begin
            Get Internal_phoNonWorkingCellColors to hoCellColor
            Set ComBackgroundColor of hoCellColor to iNonWorkingColour
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Support Methods" Visibility=Internal
    Procedure BeforeDrawDay_MonthViewDay Handle hoDrawParams
        Integer iColor iSpecial_Date
        Date    dDate
        Handle  hoTheme hoMonthView hoMonthViewDay
        Variant vMonthView vDay

        If (pbEnableSpecialDates(Self)) Begin
            Get ComDate of hoDrawParams to dDate
            Get SpecialDate_Is_Special_Date dDate to iSpecial_Date
            If (iSpecial_Date <> -1) Begin
                Get SpecialDate_Back_Color iSpecial_Date to iColor  

                Get Internal_phoThemeOffice2007              to hoTheme 
                       
                Get ComMonthView of hoTheme to vMonthView
                Get Internal_phoThemeOffice2007MonthView     to hoMonthView
                Set pvComObject of hoMonthView to vMonthView

                Get ComDay of hoMonthView to vDay
                Get Internal_phoThemeOffice2007MonthViewDay  to hoMonthViewDay
                Set pvComObject of hoMonthViewDay to vDay
                
                Set ComBackgroundDarkColor  of hoMonthViewDay to iColor
                Set ComBackgroundLightColor of hoMonthViewDay to iColor
            End
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Support Methods" Visibility=Internal
    Procedure BeforeDrawDay_WeekViewDay Handle hoDrawParams
        Integer iColor iSpecial_Date
        Date    dDate
        Handle  hoTheme hoWeekView hoWeekViewDay
        Variant vWeekView vDay

        If (pbEnableSpecialDates(Self)) Begin
            Get ComDate of hoDrawParams to dDate
            Get SpecialDate_Is_Special_Date dDate to iSpecial_Date
            If (iSpecial_Date <> -1) Begin
                Get SpecialDate_Back_Color iSpecial_Date to iColor  

                Get Internal_phoThemeOffice2007            to hoTheme        

                Get ComWeekView of hoTheme to vWeekView
                Get Internal_phoThemeOffice2007WeekView    to hoWeekView
                Set pvComObject of hoWeekView to vWeekView

                Get ComDay of hoWeekView to vDay
                Get Internal_phoThemeOffice2007WeekViewDay to hoWeekViewDay
                Set pvComObject of hoWeekViewDay to vDay
                
                Set ComBackgroundDarkColor  of hoWeekViewDay to iColor
                Set ComBackgroundLightColor of hoWeekViewDay to iColor
            End
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Schedules" Visibility=Internal
    Function Category_Index Integer iCategory_ID Returns Integer
        Integer iCount iLoop iIndex
        tdSigCjCal_RM_Category[] taRM_Categories

        Get ptaRM_Categories to taRM_Categories

        Move -1 to iIndex
        Move (SizeOfArray(taRM_Categories) - 1) to iCount
        For iLoop from 0 to iCount
            If (taRM_Categories[iLoop].tCategory.iID = iCategory_ID) Begin
                Move iLoop to iIndex
                Move (iCount + 1) to iLoop  //bomb loop
            End
        Loop

        If (iIndex = -1) Begin
            Error 501 ("Cannot find Category (ID: " + String(iCategory_ID) + ")")
        End

        Function_Return iIndex
    End_Function

