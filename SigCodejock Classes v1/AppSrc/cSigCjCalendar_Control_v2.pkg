    // Category="SigCj:Support Methods" Visibility=Internal
    Procedure Set_Theme_To_Office_07
        Handle hoThemeOffice07 hoImageManagerIcons //hoWorkspace
        Variant vTheme vCustomIcons

        Get Internal_phoThemeOffice2007 to hoThemeOffice07
        Send CreateComObject of hoThemeOffice07
        Get pvComObject of hoThemeOffice07 to vTheme
        Send ComSetTheme vTheme

        //Find Working & non-Working day theme objects
        Send Find_Day_Theme_Objects hoThemeOffice07

        //Setup handle to image manager
        Get ComCustomIcons of hoThemeOffice07 to vCustomIcons
        Get Internal_phoImageManagerIcons to hoImageManagerIcons
        Set pvComObject of hoImageManagerIcons to vCustomIcons

        //Standard Icons
        Send Load_Standard_Icons
        Send Enable_Standard_Icons hoThemeOffice07

        //User Icons
        Send OnLoadIcons
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Dialogs" Visibility=Private
    Procedure Show_Context_Menu_Header
        Integer iCount iLoop iIndex iCheckedCount iWidth
        Handle hoMenu hoControls hoDayView
        Variant vControls
        String  sMessage sChecked
        tdSigCjCal_HitTestInfo   tHitTest_Info
        tdSigCjCal_RM_Layout[]   taRM_Layouts
        tdSigCjCal_RM_Resource[] taRM_Resources

        Get ptHitTestInfo to tHitTest_Info

        Get phoContextMenu_Header to hoMenu
        //Naff way to delete all menu items... must be a proper interface for this BUT I can't find it!!
        Send Destroy of hoMenu
        Get Create U_cSigCJContextMenu to hoMenu
        Set phoContextMenu_Header to hoMenu

        Move 0 to iCheckedCount
        Get ptaRM_Layouts to taRM_Layouts
        Get Layout_Index (piCurrent_Layout_ID(Self)) to iIndex
        Move taRM_Layouts[iIndex].taRM_Resources to taRM_Resources
        Move (SizeOfArray(taRM_Resources) - 1) to iCount
        For iLoop from 0 to iCount
            Move "CM_EnableResource " to sMessage
            Append sMessage (String(taRM_Resources[iLoop].bEnabled))  " "
            Append sMessage (String(taRM_Resources[iLoop].tResource.iID))
            Send Add_MenuItem of hoMenu taRM_Resources[iLoop].tResource.sName sMessage False ""
            Set Checked of hoMenu taRM_Resources[iLoop].tResource.sName to taRM_Resources[iLoop].bEnabled
            If (taRM_Resources[iLoop].bEnabled) Begin
                Increment iCheckedCount
                Move taRM_Resources[iLoop].tResource.sName to sChecked
            End
        Loop

        If (iCheckedCount = 1) Begin
            Set Enabled  of hoMenu sChecked to False
        End
        
        If (tHitTest_Info.eViewType = eCal_ViewType_Day) Begin
            Send Add_MenuItem of hoMenu "Reorder" "CM_ReorderResources" True ""

            Get Internal_phoDayView to hoDayView
            Get ComMinColumnWidth of hoDayView to iWidth
            Send Add_MenuItem of hoMenu "Min Width" ("CM_MinWidth " + String(iWidth)) True ""
        End

        If (ComIsToolTipVisible(Self)) Send ComHideToolTip
        Send Popup to hoMenu
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Dialogs" Visibility=Private
    Procedure Show_Context_Menu_Main tdSigCjCal_HitTestInfo tHitTestInfo
        Boolean bEditAllowed
        Handle hoMenu

        Get phoContextMenu_Main to hoMenu

        Move True to bEditAllowed
        If (tHitTestInfo.eViewType = eCal_ViewType_Day)   Move (pbAllowEditInDayView  (Self)) to bEditAllowed
        If (tHitTestInfo.eViewType = eCal_ViewType_Month) Move (pbAllowEditInMonthView(Self)) to bEditAllowed
        If (tHitTestInfo.eViewType = eCal_ViewType_Week)  Move (pbAllowEditInWeekView (Self)) to bEditAllowed
        
        If (pbEnableCCP(Self)) Begin
            Set Visible of hoMenu (psCM_Cut  (Self)) to True
            Set Visible of hoMenu (psCM_Copy (Self)) to True
            Set Visible of hoMenu (psCM_Paste(Self)) to True

            Set Enabled of hoMenu (psCM_Cut  (Self)) to tHitTestInfo.bCanCut
            Set Enabled of hoMenu (psCM_Copy (Self)) to tHitTestInfo.bCanCopy 
            Set Enabled of hoMenu (psCM_Paste(Self)) to tHitTestInfo.bCanPaste
        End
        Else Begin
            Set Visible of hoMenu (psCM_Cut  (Self)) to False
            Set Visible of hoMenu (psCM_Copy (Self)) to False
            Set Visible of hoMenu (psCM_Paste(Self)) to False
        End

        If (pbCM_Print(Self)) Begin
            Set Visible of hoMenu (psCM_Print_Preview   (Self)) to True
            Set Visible of hoMenu (psCM_Print           (Self)) to True
            Set Visible of hoMenu (psCM_Print_Page_Setup(Self)) to True
        End
        Else Begin
            Set Visible of hoMenu (psCM_Print_Preview   (Self)) to False
            Set Visible of hoMenu (psCM_Print           (Self)) to False
            Set Visible of hoMenu (psCM_Print_Page_Setup(Self)) to False
        End
        
        If (bEditAllowed) Begin
            //What should be visible
            Set Visible of hoMenu (psCM_CreateEvent    (Self)) to True
            Set Visible of hoMenu (psCM_EditEvent      (Self)) to True
            Set Visible of hoMenu (psCM_DeleteEvent    (Self)) to True
            If (pbEnableDB_Link(Self) and pbCM_DB_Link(Self)) Begin
                Set Visible of hoMenu (psCM_GotoDB_Link  (Self)) to True
                Set Visible of hoMenu (psCM_AddDB_Link   (Self)) to True
                Set Visible of hoMenu (psCM_EditDB_Link  (Self)) to True
                Set Visible of hoMenu (psCM_RemoveDB_Link(Self)) to True
            End
            If (pbEnableCustomIcons(Self) and pbCM_CustomIcon(Self)) Begin
                Set Visible of hoMenu (psCM_AddCustomIcon   (Self)) to True
                Set Visible of hoMenu (psCM_RemoveCustomIcon(Self)) to True
            End
            If (pbEnableCustomProperties(Self) and pbCM_CustomProperty(Self)) Begin
                Set Visible of hoMenu (psCM_AddCustomProperty   (Self)) to True
                Set Visible of hoMenu (psCM_EditCustomProperty  (Self)) to True
                Set Visible of hoMenu (psCM_RemoveCustomProperty(Self)) to True
            End
            Set Visible of hoMenu (psCM_RemoveException(Self)) to True

            //What should be enabled
            Set Enabled of hoMenu (psCM_CreateEvent(Self)) to (not(tHitTestInfo.bEventClicked))
            Set Enabled of hoMenu (psCM_EditEvent  (Self)) to tHitTestInfo.bEventClicked
            Set Enabled of hoMenu (psCM_DeleteEvent(Self)) to tHitTestInfo.bEventClicked
    
            If (pbEnableDB_Link(Self) and pbCM_DB_Link(Self)) Begin
                Set Enabled of hoMenu (psCM_GotoDB_Link  (Self)) to tHitTestInfo.tDB_Link.bDB_Link
                Set Enabled of hoMenu (psCM_AddDB_Link   (Self)) to (not(tHitTestInfo.tDB_Link.bDB_Link) and tHitTestInfo.bEventClicked)
                Set Enabled of hoMenu (psCM_EditDB_Link  (Self)) to tHitTestInfo.tDB_Link.bDB_Link
                Set Enabled of hoMenu (psCM_RemoveDB_Link(Self)) to tHitTestInfo.tDB_Link.bDB_Link
            End    
            If (pbEnableCustomIcons(Self) and pbCM_CustomIcon(Self)) Begin
                Set Enabled of hoMenu (psCM_AddCustomIcon   (Self)) to True
                Set Enabled of hoMenu (psCM_RemoveCustomIcon(Self)) to tHitTestInfo.bHasCustomIcons
            End
            If (pbEnableCustomProperties(Self) and pbCM_CustomProperty(Self)) Begin
                Set Enabled of hoMenu (psCM_AddCustomProperty   (Self)) to True
                Set Enabled of hoMenu (psCM_EditCustomProperty  (Self)) to tHitTestInfo.bHasCustomProperties
                Set Enabled of hoMenu (psCM_RemoveCustomProperty(Self)) to tHitTestInfo.bHasCustomProperties
            End

            Set Enabled of hoMenu (psCM_RemoveException(Self)) to (tHitTestInfo.bException)
        End
        Else Begin
            Set Visible of hoMenu (psCM_CreateEvent    (Self)) to False
            Set Visible of hoMenu (psCM_EditEvent      (Self)) to False
            Set Visible of hoMenu (psCM_DeleteEvent    (Self)) to False

            If (pbEnableDB_Link(Self) and pbCM_DB_Link(Self)) Begin
                Set Visible of hoMenu (psCM_GotoDB_Link  (Self)) to False
                Set Visible of hoMenu (psCM_AddDB_Link   (Self)) to False
                Set Visible of hoMenu (psCM_EditDB_Link  (Self)) to False
                Set Visible of hoMenu (psCM_RemoveDB_Link(Self)) to False
            End
            If (pbEnableCustomIcons(Self) and pbCM_CustomIcon(Self)) Begin
                Set Visible of hoMenu (psCM_AddCustomIcon   (Self)) to False
                Set Visible of hoMenu (psCM_RemoveCustomIcon(Self)) to False
            End
            If (pbEnableCustomProperties(Self) and pbCM_CustomProperty(Self)) Begin
                Set Visible of hoMenu (psCM_AddCustomProperty   (Self)) to False
                Set Visible of hoMenu (psCM_EditCustomProperty  (Self)) to False
                Set Visible of hoMenu (psCM_RemoveCustomProperty(Self)) to False
            End
            
            Set Visible of hoMenu (psCM_RemoveException(Self)) to False
        End

        If (ComIsToolTipVisible(Self)) Send ComHideToolTip
        Send Popup to hoMenu
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Dialogs" Visibility=Private
    Procedure Show_Context_Menu_Scale tdSigCjCal_HitTestInfo tHitTestInfo
        Integer eTimeScale
        Handle  hoMenu hoTimeScale

        Get phoContextMenu_Scale to hoMenu
        Get phoDialog_TimeScale  to hoTimeScale
        Get peTimeScale to eTimeScale

        Set Visible of hoMenu "Custom" to (hoTimeScale > 0)

        Set checked of hoMenu  "5 Minutes" to (eTimeScale = eCal_TimeScale_5)
        Set checked of hoMenu "10 Minutes" to (eTimeScale = eCal_TimeScale_10)
        Set checked of hoMenu "15 Minutes" to (eTimeScale = eCal_TimeScale_15)
        Set checked of hoMenu "20 Minutes" to (eTimeScale = eCal_TimeScale_20)
        Set checked of hoMenu "30 Minutes" to (eTimeScale = eCal_TimeScale_30)
        Set checked of hoMenu "60 Minutes" to (eTimeScale = eCal_TimeScale_60)
        If ((eTimeScale <> eCal_TimeScale_5  ) and (eTimeScale <> eCal_TimeScale_10) and ;
            (eTimeScale <> eCal_TimeScale_15 ) and (eTimeScale <> eCal_TimeScale_20) and ;
            (eTimeScale <> eCal_TimeScale_30 ) and (eTimeScale <> eCal_TimeScale_60)) Begin
            Set Checked of hoMenu "Custom" to True
        End
        Else Begin
            Set Checked of hoMenu "Custom" to False
        End

        If (ComIsToolTipVisible(Self)) Send ComHideToolTip
        Send Popup to hoMenu
    End_Procedure

    //-------------------------------------------------------------------------
    
    // Category="SigCj:Icons" Visibility=Internal
    Procedure Show_Dialog_CustomIcon Integer eAction
        Handle hoCustomIcons hoEvent
        Variant vCustomIcons
        tdSigCjCal_HitTestInfo       tHitTestInfo
        tdSigCjCal_Dialog_CustomIcon tDialog_CustomIcons

        Get ptHitTestInfo to tHitTestInfo

        Get Internal_phoEvent       to hoEvent
        Set pvComObject of hoEvent to tHitTestInfo.vEvent

        Get Internal_phoCustomIcons to hoCustomIcons
        Get ComCustomIcons of hoEvent to vCustomIcons
        Set pvComObject of hoCustomIcons to vCustomIcons

        Get Dialog_CustomIcon_Info hoCustomIcons to tDialog_CustomIcons
        Get OnCustomIcons eAction tDialog_CustomIcons to tDialog_CustomIcons
        If (tDialog_CustomIcons.eAction = eCal_Dialog_Action_Edit) Begin
            Send Update_CustomIcons hoCustomIcons tDialog_CustomIcons
            Send Notify_Event_Changed hoEvent
        End
    End_Procedure
    
    //-------------------------------------------------------------------------
    
    // Category="SigCj:Properties" Visibility=Internal
    Procedure Show_Dialog_CustomProperty Integer eAction
        Handle hoEvent hoCustomProperties 
        Variant vCustomPropeties
        tdSigCjCal_HitTestInfo      tHitTestInfo
        tdSigCjCal_Dialog_CustomProperty tDialog_CustomProperty

        Get ptHitTestInfo to tHitTestInfo

        Move eAction to tDialog_CustomProperty.eAction
        Get psaCustomProperties tHitTestInfo.iDataProvider_ID tHitTestInfo.iEvent_ID to tDialog_CustomProperty.tCustomProperties

        Get OnCustomProperty tDialog_CustomProperty to tDialog_CustomProperty

        If (tDialog_CustomProperty.eAction <> eCal_Dialog_Action_None) Begin
            Get Internal_phoCustomProperties to hoCustomProperties
            Get Internal_phoEvent            to hoEvent
            Set pvComObject of hoEvent       to tHitTestInfo.vEvent
            
            Get ComCustomProperties of hoEvent to vCustomPropeties
            Set pvComObject of hoCustomProperties to vCustomPropeties
            
            Send Update_CustomProperty hoCustomProperties tDialog_CustomProperty
            Send Notify_Event_Changed hoEvent
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:DB_Link" Visibility=Internal
    Procedure Show_Dialog_DB_Link Integer eAction
        Handle hoEvent hoCustomProperties //hoDataProvider 
        Variant vCustomPropeties
        tdSigCjCal_HitTestInfo      tHitTestInfo
        tdSigCjCal_Dialog_DB_Link   tDialog_DB_Link

        Get ptHitTestInfo to tHitTestInfo
        Move eAction to tDialog_DB_Link.eAction

        If (eAction = eCal_Dialog_Action_Create) Begin
            Move True to tDialog_DB_Link.tDB_Link.bDB_Link
        End
        Else Begin
            Move tHitTestInfo.tDB_Link to tDialog_DB_Link.tDB_Link
        End

        Get OnAdd_DB_Link tDialog_DB_Link to tDialog_DB_Link
        
        If (tDialog_DB_Link.eAction <> eCal_Dialog_Action_None) Begin
            Get Internal_phoCustomProperties to hoCustomProperties
            Get Internal_phoEvent            to hoEvent
            
            Set pvComObject of hoEvent        to tHitTestInfo.vEvent
            
            Get ComCustomProperties of hoEvent to vCustomPropeties
            Set pvComObject of hoCustomProperties to vCustomPropeties
            
            Set ComProperty of hoCustomProperties eCal_DB_Link to tDialog_DB_Link.tDB_Link.bDB_Link
            If (tDialog_DB_Link.tDB_Link.bDB_Link) Begin
                Set ComProperty of hoCustomProperties eCal_DB_Table to tDialog_DB_Link.tDB_Link.sTable
                Set ComProperty of hoCustomProperties eCal_DB_Key   to tDialog_DB_Link.tDB_Link.sKey
            End
            Send Notify_Event_Changed hoEvent
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Schedules" Visibility=Internal
    Procedure Simple_DataProvider_Create
        Boolean bOK
        Handle  hoDataProvider
        String  sConnection
        tdSigCjCal_RM_DataProvider   tRM_DataProvider
        tdSigCjCal_RM_DataProvider[] taRM_DataProviders
        tdSigCjCal_RM_DataProvider[] taRM_EmptyDataProviders
        
        //Always use the last Data Provider added (the VDF default will be 
        //used if the user has not added any during event OnCreate_DataProvider
        Get ptaRM_DataProviders to taRM_DataProviders
        Move taRM_DataProviders[(SizeOfArray(taRM_DataProviders) - 1)] to tRM_DataProvider
        
        Get Connection_String tRM_DataProvider.tDataProvider to sConnection
        Send ComSetDataProvider sConnection
        Get ComDataProvider  to tRM_DataProvider.vDataProvider
        Get Internal_phoDataProvider to hoDataProvider       
        Set pvComObject of hoDataProvider to tRM_DataProvider.vDataProvider

        Get ComOpen of hoDataProvider to bOK
        If (not(bOK)) Begin
            Get ComCreate of hoDataProvider to bOK
        End

        //Keep just the Data Provider used.
        Move tRM_DataProvider to taRM_EmptyDataProviders[0]
        Set ptaRM_DataProviders to taRM_EmptyDataProviders
    End_Procedure
    
    //-------------------------------------------------------------------------

    // Category="SigCj:Schedules" Visibility=Internal
    Procedure Simple_DataProvider_Apply_Categories
        Integer iCount iLoop
        Handle  hoDataProvider hoEventCategories
        Variant vCategories
        tdSigCjCal_RM_Category[] taRM_Categories
        tdSigCjCal_RM_DataProvider[] taRM_DataProviders
        
        Get Internal_phoDataProvider    to hoDataProvider       
        Get Internal_phoEventCategories to hoEventCategories

        //Get Data Provider object
        Get ptaRM_DataProviders to taRM_DataProviders
        Set pvComObject of hoDataProvider to taRM_DataProviders[0].vDataProvider

        //Remove default categories
        Get Internal_phoEventCategories to hoEventCategories
        Get ComEventCategories of hoDataProvider to vCategories
        Set pvComObject of hoEventCategories to vCategories
    
        Send ComRemoveAll of hoEventCategories
        
        //Add Categories
        Get ptaRM_Categories to taRM_Categories
        Set pvComObject of hoEventCategories to (ComEventCategories(hoDataProvider))

        Move (SizeOfArray(taRM_Categories) - 1) to iCount
        For iLoop from 0 to iCount
            Send Create_Category_COM_Object hoEventCategories taRM_Categories[iLoop].tCategory
        Loop
    End_Procedure

