    // Category="SigCj:Schedules" Visibility=Public
    Procedure Create_Category tdSigCjCal_Category tCategory
        tdSigCjCal_RM_Category[] taRM_Categories

        Get ptaRM_Categories to taRM_Categories
            Move tCategory to taRM_Categories[SizeOfArray(taRM_Categories)].tCategory
        Set ptaRM_Categories to taRM_Categories
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Support Methods" Visibility=Internal
    Procedure Create_Category_COM_Object Handle hoCategories tdSigCjCal_Category tCategory
        Boolean bIsComObjectCreated
        Handle  hoCategory hoColorGradient
        Variant vCategory vBackGround

        //We create and destroy the Category object here instead of using a
        //defined handle (property) as we need to ensure that we create the
        //COM side object.

        Get Create U_cSigCjComCalendarEventCategory to hoCategory
            Get IsComObjectCreated of hoCategory to bIsComObjectCreated
            If (not(bIsComObjectCreated)) Begin
                Send CreateComObject of hoCategory
            End

            Set ComID          of hoCategory to tCategory.iID
            Set ComName        of hoCategory to tCategory.sName
            Set ComBorderColor of hoCategory to tCategory.iBorderColor

            Get ComBackground of hoCategory to vBackGround
            Get Internal_phoThemeColorGradient to hoColorGradient
            Set pvComObject       of hoColorGradient to vBackGround
            Set ComColorLight     of hoColorGradient to tCategory.iColor_1
            Set ComColorDark      of hoColorGradient to tCategory.iColor_2
            Set ComGradientFactor of hoColorGradient to tCategory.nGradient

            Get pvComObject of hoCategory to vCategory
            Send ComAdd of hoCategories vCategory
        Send Destroy of hoCategory
    End_Procedure

