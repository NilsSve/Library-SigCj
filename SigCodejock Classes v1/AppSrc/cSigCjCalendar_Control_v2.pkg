            Set pvComObject of hoSchedule to vSchedule
            Set ComId of hoSchedule to tSchedule.iID

            //Schedule Custom Properties
            //==========================
            //These will be applied (set) here if implemented
        End
        Else Begin
            Error 501 ("Cannot create schedule object (ID: " + String(tSchedule.iID) + ")")
        End
    End_Procedure

