        Get Event_Object iDataProvider_ID iEvent_ID to vEvent
        Get Internal_phoEvent to hoEvent
        Set pvComObject of hoEvent to vEvent

        Get ComCustomProperties of hoEvent to vCustomProperties
        Get Internal_phoCustomProperties    to hoCustomProperties
        Set pvComObject of hoCustomProperties to vCustomProperties
        Get ComCount of hoCustomProperties to iCount
        
        Function_Return iCount
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Properties" Visibility=Public
    Procedure Set psaCustomProperties Integer iDataProvider_ID Integer iEvent_ID Boolean bRemoveCurrent tdSigCjCal_CustomProperty[] tCustomProperties 
        Integer iCount iLoop
        Handle  hoEvent hoCustomProperties hoDataProvider
        Variant vCustomProperties vEvent vDataProvider

        Get Event_Object iDataProvider_ID iEvent_ID to vEvent
        Get Internal_phoEvent to hoEvent
        Set pvComObject of hoEvent to vEvent

        Get ComCustomProperties of hoEvent to vCustomProperties
        Get Internal_phoCustomProperties    to hoCustomProperties
        Set pvComObject of hoCustomProperties to vCustomProperties
        
        If (bRemoveCurrent) Begin
            Send ComRemoveAll of hoCustomProperties 
        End
        
        Move (SizeOfArray(tCustomProperties) - 1) to iCount
        For iLoop from 0 to iCount
            Set ComProperty of hoCustomProperties tCustomProperties[iLoop].sName to tCustomProperties[iLoop].sValue
        Loop
        Send Notify_Event_Changed hoEvent
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Properties" Visibility=Public
    Function psaCustomProperties Integer iDataProvider_ID Integer iEvent_ID Returns tdSigCjCal_CustomProperty[]
        Handle  hoEvent hoCustomProperties
        Variant vCustomProperties vEvent
        String  sXML
        tdSigCjCal_CustomProperty[] tCustomProperties

        Get Event_Object iDataProvider_ID iEvent_ID to vEvent
If (not(IsNullComObject(vEvent))) Begin        
        Get Internal_phoEvent to hoEvent
        Set pvComObject of hoEvent to vEvent

        Get ComCustomProperties of hoEvent to vCustomProperties
        Get Internal_phoCustomProperties    to hoCustomProperties
        Set pvComObject of hoCustomProperties to vCustomProperties
        Get ComSaveToString of hoCustomProperties to sXML

        Get CustomProperties_Convert_XML sXML to tCustomProperties
End        
        Function_Return tCustomProperties
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Properties" Visibility=Private
    Function CustomProperties_Convert_XML String sXML Returns tdSigCjCal_CustomProperty[]
        Boolean bOK
        Integer iIndex
        String  sName
        Handle  hoXML hoRootNode hoProperties hoProperty
        tdSigCjCal_CustomProperty[] tCustomProperties

        Get Create U_cXMLDomDocument to hoXML
        If (hoXML > 0) Begin
            Get LoadXML of hoXML sXML to bOK
            If (bOK) Begin
                Get DocumentElement of hoXML to hoRootNode
                If (hoRootNode > 0) Begin
                    Get FindNode of hoRootNode "CustomProperties" to hoProperties
                    If (hoProperties > 0) Begin
                        Get FirstChild of hoProperties to hoProperty // get the first node
                        While (hoProperty > 0)
                            Get AttributeValue of hoProperty "Name" to sName
                            If ((sName <> eCal_DB_Link) and (sName <> eCal_DB_Table) and (sName <> eCal_DB_Key) and ;
                                (sName <> eCal_ID_CreatedBy) and (sName <> eCal_ID_ModifiedBy)) Begin
                                Move (SizeOfArray(tCustomProperties)) to iIndex
                                Get AttributeValue of hoProperty "Name"  to tCustomProperties[iIndex].sName
                                Get AttributeValue of hoProperty "Value" to tCustomProperties[iIndex].sValue
                            End
                            Get NextNode of hoProperty to hoProperty
                        Loop
                    End
                End
            End
            Send Destroy of hoXML
        End

        Function_Return tCustomProperties
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Schedules" Visibility=Private
    Function DataProvider_Index Integer iDataProvider_ID Returns Integer
        Integer iCount iLoop iIndex
        tdSigCjCal_RM_DataProvider[] taRM_DataProviders

        Get ptaRM_DataProviders to taRM_DataProviders

        Move -1 to iIndex
        Move (SizeOfArray(taRM_DataProviders) - 1) to iCount
        For iLoop from 0 to iCount
            If (taRM_DataProviders[iLoop].tDataProvider.iID = iDataProvider_ID) Begin
                Move iLoop to iIndex
                Move (iCount + 1) to iLoop  //bomb loop
            End
        Loop

        If (iIndex = -1) Begin
            Error 501 ("Cannot find Data Provider (ID: " + String(iDataProvider_ID) + ")")
        End

        Function_Return iIndex
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Schedules" Visibility=Internal
    Function DataProvider_Object Integer iDataProvider_ID Returns Variant
        Integer iDataProvider_Index
        tdSigCjCal_RM_DataProvider[] taRM_DataProviders

        Get ptaRM_DataProviders to taRM_DataProviders
        Get DataProvider_Index iDataProvider_ID to iDataProvider_Index

        Function_Return taRM_DataProviders[iDataProvider_Index].vDataProvider
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Support Methods" Visibility=Public
    Function Date_and_Time_to_DateTime Date dDate String sTime Returns DateTime
        DateTime dtRetVal

        Move dDate to dtRetVal
        Move (DateSetHour  (dtRetVal, Left(sTime,2)  )) to dtRetVal
        Move (DateSetMinute(dtRetVal, Mid (sTime,2,4))) to dtRetVal
        If (Length(sTime) > 5) Begin
            Move (DateSetSecond(dtRetVal, Right(sTime,2))) to dtRetVal
        End

        Function_Return dtRetVal
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Support Methods" Visibility=Public
    Function DateTime_to_Time DateTime dtTime Returns String
        String sHour sMins

        Move (DateGetHour(dtTime)) to sHour
        If (sHour < 10) Move ("0" + sHour) to sHour

        Move (DateGetMinute(dtTime)) to sMins
        If (sMins < 10) Move ("0" + sMins) to sMins

        Function_Return (sHour + ":" + sMins)
    End_Function

