    //-------------------------------------------------------------------------
    //Fired when custom icons need to be changed

    { MethodType=Event }
    // Category="SigCj:Icons" Visibility=Public
    Function OnCustomIcons Boolean bAdd tdSigCjCal_Dialog_CustomIcon tDialog_CustomIcons Returns tdSigCjCal_Dialog_CustomIcon
        //Use tDialog_CustomIcons.eAction to determine what action has been requested

        If (phoDialog_CustomIcons(Self)) Begin
            Get Show_Dialog of (phoDialog_CustomIcons(Self)) tDialog_CustomIcons to tDialog_CustomIcons
        End

        Function_Return tDialog_CustomIcons 
    End_Function

    //-------------------------------------------------------------------------
    //Fired when custom properties need to be changed
    
    { MethodType=Event }
    // Category="SigCj:Properties" Visibility=Public
    Function OnCustomProperty tdSigCjCal_Dialog_CustomProperty tDialog_CustomProperty Returns tdSigCjCal_Dialog_CustomProperty
        //Use tDialog_CustomProperty.eAction to determine what action has been requested

        If (phoDialog_CustomProperties(Self)) Begin
            Move True to tDialog_CustomProperty.bRemoveExisting
            Get Show_Dialog of (phoDialog_CustomProperties(Self)) tDialog_CustomProperty to tDialog_CustomProperty
        End
        
        Function_Return tDialog_CustomProperty 
    End_Function

    //-------------------------------------------------------------------------
    //Only fired if pbEnableCustomEventToolTips is true
    
    { MethodType=Event }
    // Category="SigCj:Tool Tips" Visibility=Public
    Function OnCustomToolTip tdSigCjCal_HitTestInfo tHitTestInfo tdSigCjCal_Event tEvent Returns String
        String sToolTip
        //
        //Move ("[" + tEvent.iID + "] " + tEvent.sSubject) to sToolTip
        Function_Return sToolTip
    End_Function

    //-------------------------------------------------------------------------
    //Fired when pbDB_Link_OnClick is true or Goto_DB_Link selected from context menu
    
