    // Category="SigCj:Schedules" Visibility=Public
    Procedure Remove_Resource Integer iLayout_ID Integer iResource_ID 
        Integer iLayout_Index iResource_Index iIndex iCount iLoop
        Integer[] iSchedule_IDs
        tdSigCjCal_RM_Layout[]   taRM_Layouts
        tdSigCjCal_RM_Resource[] taRM_Resources

        Get Layout_Index iLayout_ID to iLayout_Index
        If (iLayout_Index <> -1) Begin
            Get Resource_Index iResource_ID False to iResource_Index
            If (iResource_Index <> -1) Begin
                Get ptaRM_Layouts to taRM_Layouts
                    Move (SizeOfArray(taRM_Layouts[iLayout_Index].taRM_Resources) - 1) to iCount
                    For iLoop from 0 to iCount
                        If (taRM_Layouts[iLayout_Index].taRM_Resources[iLoop].tResource.iID <> iResource_ID) Begin
                            Move taRM_Layouts[iLayout_Index].taRM_Resources[iLoop] to taRM_Resources[SizeOfArray(taRM_Resources)]
                        End
                    Loop
                    Move taRM_Resources to taRM_Layouts[iLayout_Index].taRM_Resources
                Set ptaRM_Layouts to taRM_Layouts

                Get ptaRM_Resources to taRM_Resources
                    Decrement taRM_Resources[iResource_Index].iInUse
                Set ptaRM_Resources to taRM_Resources
            End
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Schedules" Visibility=Public
    Procedure Remove_Schedule Integer iResource_ID Integer iSchedule_ID
        Integer iResource_Index iSchedule_Index iIndex iCount iLoop
        Integer[] iSchedule_IDs
        tdSigCjCal_RM_Resource[] taRM_Resources
        tdSigCjCal_RM_Schedule[] taRM_Schedules

        Get Resource_Index iResource_ID False to iResource_Index
        If (iResource_Index <> -1) Begin
            Get Schedule_Index iSchedule_ID to iSchedule_Index
            If (iSchedule_Index <> -1) Begin
                Get ptaRM_Resources to taRM_Resources
                    Move (SizeOfArray(taRM_Resources[iResource_Index].iSchedule_IDs)- 1) to iCount
                    For iLoop from 0 to iCount
                        If (taRM_Resources[iResource_Index].iSchedule_IDs[iLoop] <> iSchedule_ID) Begin
                            Move taRM_Resources[iResource_Index].iSchedule_IDs[iLoop] to iSchedule_IDs[SizeOfArray(iSchedule_IDs)]
                        End
                    Loop
                    Move iSchedule_IDs to taRM_Resources[iResource_Index].iSchedule_IDs
                Set ptaRM_Resources to taRM_Resources

                Get ptaRM_Schedules to taRM_Schedules
                    Decrement taRM_Schedules[iSchedule_Index].iInUse
                Set ptaRM_Schedules to taRM_Schedules
            End
        End
    End_Procedure

    //-------------------------------------------------------------------------
    
    // Category="SigCj:Schedules" Visibility=Internal
    Procedure Reorder_Resources
        Integer   iCount iLoop iIndex iLayout_Index
        Handle    hoResourceManager 
        Integer[] iaNew_Order iaOld_Order
        tdSigCjCal_Resource[] taResources
        tdSigCjCal_RM_Layout[]   taRM_Layouts
        tdSigCjCal_RM_Resource[] taRM_Resources_Ordered

        Get Internal_phoResourceManager to hoResourceManager
        Get ptaRM_Layouts to taRM_Layouts
        Get Layout_Index (piCurrent_Layout_ID(Self)) to iLayout_Index

        //Keep the current order of the IDs
        Move (SizeOfArray(taRM_Layouts[iLayout_Index].taRM_Resources) - 1) to iCount
        For iLoop from 0 to iCount
            Move taRM_Layouts[iLayout_Index].taRM_Resources[iLoop].tResource.iID to iaOld_Order[iLoop]
            
            Move taRM_Layouts[iLayout_Index].taRM_Resources[iLoop].tResource.iID   to taResources[iLoop].iID
            Move taRM_Layouts[iLayout_Index].taRM_Resources[iLoop].tResource.sName to taResources[iLoop].sName
        Loop

        //Pass the Resources and get back an array of IDs in the new order
        Get OnReorderResources taResources to iaNew_order

        //Now move resources around
        Move (SizeOfArray(iaOld_Order)) to iCount
        If (SizeOfArray(iaNew_Order) = iCount) Begin
            Decrement iCount
            For iLoop from 0 to iCount
                Move (SearchArray(iaNew_Order[iLoop], iaOld_Order)) to iIndex
                If (iIndex <> iLoop) Begin
                    Send ComMoveResource of hoResourceManager iIndex iLoop
                    Move (RemoveFromArray(iaOld_Order, iIndex)) to iaOld_Order
                    Move (InsertInArray(iaNew_Order,iLoop,iaNew_Order[iLoop])) to iaOld_Order                 
                End
                Move taRM_Layouts[iLayout_Index].taRM_Resources[iLoop] to taRM_Resources_Ordered[SizeOfArray(taRM_Resources_Ordered)]
            Loop
    
            Move taRM_Resources_Ordered to taRM_Layouts[iLayout_Index].taRM_Resources 
            Get ptaRM_Layouts to taRM_Layouts
    
            Send ComApplyToCalendar of hoResourceManager (pvComObject(Self))
            Send Force_Redraw
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Schedules" Visibility=Public
    Procedure Reset_ResourceManager
        tdSigCjCal_RM_Category[]     taRM_Categories          
        tdSigCjCal_RM_DataProvider[] taRM_DataProviders
        tdSigCjCal_RM_Layout[]       taRM_Layouts      
        tdSigCjCal_RM_Resource[]     taRM_Resources    
        tdSigCjCal_RM_Schedule[]     taRM_Schedules           

        Set ptaRM_Categories    to taRM_Categories   
        Set ptaRM_DataProviders to taRM_DataProviders                     
        Set ptaRM_Layouts       to taRM_Layouts                     
        Set ptaRM_Resources     to taRM_Resources                     
        Set ptaRM_Schedules     to taRM_Schedules    
   
        Send Create_Default_Data_Provider
        Set piCurrent_Layout_ID to -1
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Schedules" Visibility=Internal
    Function Resource_Index Integer iResource_ID Boolean bForLayout Returns Integer
        Integer iCount iLoop iIndex
        tdSigCjCal_RM_Resource[] taRM_Resources
        tdSigCjCal_RM_Layout[]   taRM_Layouts

        If (bForLayout) Begin
            Get ptaRM_Layouts to taRM_Layouts
            Get Layout_Index (piCurrent_Layout_ID(Self)) to iIndex
            Move taRM_Layouts[iIndex].taRM_Resources to taRM_Resources
        End
        Else Begin
            Get ptaRM_Resources to taRM_Resources
        End

        Move -1 to iIndex
        Move (SizeOfArray(taRM_Resources) - 1) to iCount
        For iLoop from 0 to iCount
            If (taRM_Resources[iLoop].tResource.iID = iResource_ID) Begin
                Move iLoop to iIndex
                Move (iCount + 1) to iLoop  //bomb loop
            End
        Loop

        If (iIndex = -1) Begin
            Error 501 ("Cannot find Resource (ID: " + String(iResource_ID) + ")")
        End

        Function_Return iIndex
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:DB_Link" Visibility=Internal
    Procedure Retrieve_DB_Link Handle hoCustomProperties Boolean ByRef bDB_Link String ByRef sDB_Table String ByRef sDB_Key
        Get ComProperty of hoCustomProperties eCal_DB_Link to bDB_Link
        If (bDB_Link) Begin
            Get ComProperty of hoCustomProperties eCal_DB_Table to sDB_Table
            Get ComProperty of hoCustomProperties eCal_DB_Key   to sDB_Key

            Send ComRemove of hoCustomProperties eCal_DB_Link
            Send ComRemove of hoCustomProperties eCal_DB_Table
            Send ComRemove of hoCustomProperties eCal_DB_Key
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:General" Visibility=Internal
    Procedure Retrieve_User_IDs Handle hoCustomProperties String ByRef sCreatedBy String ByRef sLastMod_By
        Get ComProperty of hoCustomProperties eCal_ID_CreatedBy  to sCreatedBy 
        Get ComProperty of hoCustomProperties eCal_ID_ModifiedBy to sLastMod_By

        Send ComRemove of hoCustomProperties eCal_ID_CreatedBy
        Send ComRemove of hoCustomProperties eCal_ID_ModifiedBy
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Schedules" Visibility=Internal
    Function Schedule_Index Integer iSchedule_ID Returns Integer
        Integer iCount iLoop iIndex
        tdSigCjCal_RM_Schedule[] taRM_Schedules

        Get ptaRM_Schedules to taRM_Schedules

        Move (SizeOfArray(taRM_Schedules) -1) to iCount
        For iLoop from 0 to iCount
            If (taRM_Schedules[iLoop].tSchedule.iID = iSchedule_ID) Begin
                Move iLoop to iIndex
                Move (iCount + 1) to iLoop  //bomb loop
            End
        Loop

        If (iIndex = -1) Begin
            Error 501 ("Cannot find Schedule (ID: " + String(iSchedule_ID) + ")")
        End

        Function_Return iIndex
    End_Function

