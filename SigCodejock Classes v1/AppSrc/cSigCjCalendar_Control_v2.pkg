    { MethodType=Property Category="SigCj:Time Scale" InitialValue=False }
    Procedure Set pbRestrictTimeScale Boolean bValue
        Set Internal_pbRestrictTimeScale to bValue

        If (bValue) Begin
            Send Internal_Set_Time_Scale ( Internal_ptmTimeScaleMinTime(Self)) True
            Send Internal_Set_Time_Scale ( Internal_ptmTimeScaleMaxTime(Self)) False
        End
        Else Begin
            Send Internal_Set_Time_Scale "00:00" True
            Send Internal_Set_Time_Scale "23:59" False
        End
    End_Procedure

    Function pbRestrictTimeScale Returns Boolean
        Function_Return (Internal_pbRestrictTimeScale(Self))
    End_Function

