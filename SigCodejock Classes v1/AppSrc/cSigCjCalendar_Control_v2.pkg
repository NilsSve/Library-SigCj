    //-------------------------------------------------------------------------

    { MethodType=Property Category="SigCj:Shading" InitialValue="17:00" }
    Procedure Set ptmWorkDayEndTime String tmValue
        DateTime dtWork
        Integer  iHour iMins
        Handle hoOptions

        Get Internal_phoCalendarOptions to hoOptions

        Set Internal_ptmWorkDayEndTime to tmValue
        If (hoOptions and IsComObjectCreated(hoOptions)) Begin
            //Have to get current value... Codejock issue and then set the hours 
            //and mins from integers... Dataflex issue. Fun working this lot out!!!!
            Get ComWorkDayEndTime of hoOptions to dtWork
            Get SigCj_GetHours   tmValue to iHour
            Get SigCj_GetMinutes tmValue to iMins
            Move (DateSetHour  (dtWork, iHour)) to dtWork
            Move (DateSetMinute(dtWork, iMins)) to dtWork

            //Now we can set the time!!
            Set ComWorkDayEndTime of hoOptions to dtWork
        End
    End_Procedure

    Function ptmWorkDayEndTime Returns String
        //We always return our private property as the COM property is returned as a DateTime
        Function_Return (Internal_ptmWorkDayEndTime(Self))
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Property Category="SigCj:Shading" InitialValue="09:00" }
    Procedure Set ptmWorkDayStartTime String tmValue
        DateTime dtWork
        Integer  iHour iMins
        Handle hoOptions

        Get Internal_phoCalendarOptions to hoOptions

        Set Internal_ptmWorkDayStartTime to tmValue
        If (hoOptions and IsComObjectCreated(hoOptions)) Begin
            //Have to get current value... Codejock issue and then set the hours 
            //and mins from integers... Dataflex issue. Fun working this lot out!!!!
            Get ComWorkDayStartTime of hoOptions to dtWork
            Get SigCj_GetHours   tmValue to iHour
            Get SigCj_GetMinutes tmValue to iMins
            Move (DateSetHour  (dtWork, iHour)) to dtWork
            Move (DateSetMinute(dtWork, iMins)) to dtWork

            //Now we can set the time!!
            Set ComWorkDayStartTime of hoOptions to dtWork
        End
    End_Procedure

