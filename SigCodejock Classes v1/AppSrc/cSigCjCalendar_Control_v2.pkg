    //-------------------------------------------------------------------------    

    { MethodType=Property Category="SigCj:Time Scale" InitialValue=eCal_TimeScale_30 }
    { EnumList="eCal_TimeScale_5, eCal_TimeScale_10, eCal_TimeScale_15, eCal_TimeScale_20, eCal_TimeScale_30, eCal_TimeScale_60" }
    Procedure Set peTimeScale Integer eValue
        Handle hoDayView

        Get Internal_phoDayView to hoDayView
        If (hoDayView and IsComObjectCreated(hoDayView)) Begin
            Set ComTimeScale of hoDayView to eValue
        End

        Set Internal_peTimeScale to eValue
    End_Procedure

    { MethodType=Property }
    Function peTimeScale Returns Integer
        Integer eValue
        Handle hoDayView

        Get Internal_phoDayView to hoDayView
        If (hoDayView and IsComObjectCreated(hoDayView)) Begin
            Get ComTimeScale of hoDayView to eValue
        End
        Else Begin
            Get Internal_peTimeScale to eValue
        End

        Function_Return eValue
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Property Category="SigCj:Time Scale" InitialValue="19:00" }
    Procedure Set ptmTimeScaleMaxTime String tmValue
        Set Internal_ptmTimeScaleMaxTime to tmValue

        If (pbRestrictTimeScale(Self)) Begin
            Send Internal_Set_Time_Scale tmValue False
        End
    End_Procedure

    Function ptmTimeScaleMaxTime Returns String
        //We always return our private property as the COM property is returned as a DateTime
