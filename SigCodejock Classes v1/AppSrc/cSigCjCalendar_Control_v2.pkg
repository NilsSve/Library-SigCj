    //=========================================================================

    // Category="SigCj:CJ Event" Visibility=Internal
    Procedure OnComBeforeDrawThemeObject OLECalendarBeforeDrawThemeObject lleObjType Variant llDrawParams
        Handle   hoDrawParams 

        If (lleObjType = OLExtpCalendarBeforeDraw_DayViewCell) Begin
            Get Internal_phoThemeDayViewCellParams to hoDrawParams
            Set pvComObject of hoDrawParams to llDrawParams
            Send BeforeDrawDay_DayViewCell hoDrawParams
        End

        If (lleObjType = OLExtpCalendarBeforeDraw_MonthViewDay) Begin
            Get Internal_phoViewDay to hoDrawParams
            Set pvComObject of hoDrawParams to llDrawParams
            Send BeforeDrawDay_MonthViewDay hoDrawParams
        End
        
        If (lleObjType = OLExtpCalendarBeforeDraw_WeekViewDay) Begin
            Get Internal_phoViewDay to hoDrawParams
            Set pvComObject of hoDrawParams to llDrawParams
            Send BeforeDrawDay_WeekViewDay hoDrawParams
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:CJ Event" Visibility=Internal
    Procedure OnComBeforeEditOperation Variant llOpParams Boolean ByRef llbCancelOperation
        Handle  hoParams bConfirmDelete hoEventViews
        Integer iOperation iBtn iCount
        String  sMessage sTitle
        Variant vEventViews

        Move False to bConfirmDelete

        Get Internal_phoEditOperationParameters to hoParams
        Set pvComObject of hoParams to llOpParams

        Get ComOperation of hoParams to iOperation

        Case Begin
            Case (iOperation = OLExtpCalendarEO_Unknown)                      //Unknown operation value.
            Case Break
            Case (iOperation = OLExtpCalendarEO_DragCopy)                     //Drag copy event.
            Case Break
            Case (iOperation = OLExtpCalendarEO_DragMove)                     //Drag move event.
            Case Break
            Case (iOperation = OLExtpCalendarEO_DragResizeBegin)              //Drag Resizing event begin.
            Case Break
            Case (iOperation = OLExtpCalendarEO_DragResizeEnd)                //Drag Resizing event end.
            Case Break
            Case (iOperation = OLExtpCalendarEO_EditSubject_ByF2)             //In-place edit event by pressing F2 key.
            Case Break
            Case (iOperation = OLExtpCalendarEO_EditSubject_ByMouseClick)     //In-place edit event by mouse click.
            Case Break
            Case (iOperation = OLExtpCalendarEO_EditSubject_ByTab)            //In-place edit event tab key.
            Case Break
            Case (iOperation = OLExtpCalendarEO_EditSubject_AfterEventResize) //In-place edit event after resizing an event.
            Case Break
            Case (iOperation = OLExtpCalendarEO_Cut)                          //Cut events.
            Case Break
            Case (iOperation = OLExtpCalendarEO_Copy)                         //Copy events.
            Case Break
            Case (iOperation = OLExtpCalendarEO_Paste)                        //Paste event.
            Case Break

            //-------------------------------------------------------------

            Case (iOperation = OLExtpCalendarEO_DeleteSelectedEvents)         //Delete selected events.
            Case Break

            //-------------------------------------------------------------

            Case (iOperation = OLExtpCalendarEO_DeleteEvent)                  //Delete event. Sent for a single event or for each selected event.
            Case Break
            Case (iOperation = OLExtpCalendarEO_InPlaceCreateEvent)           //In-place event creation.
            Case Break
        Case End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:CJ Event" Visibility=Internal
    Procedure OnComDblClick
        Boolean bOK
        tdSigCjCal_HitTestInfo tHitTestInfo

        //This is always done so that HitTestInfo is as up to date as possible
        Get HitTestInfo to tHitTestInfo
        Set ptHitTestInfo to tHitTestInfo

        If (pbAllowEditInDayView(Self) and (tHitTestInfo.eViewType = eCal_ViewType_Day)) Begin
            If ((tHitTestInfo.eHitItem = eCal_Hit_AllDayArea) or (tHitTestInfo.eHitItem = eCal_Hit_DayArea)) Begin
                Send NewEventDialog tHitTestInfo.dtSel_Begin
            End

            If ((tHitTestInfo.eHitItem = eCal_Hit_AllDayEvent) or (tHitTestInfo.eHitItem = eCal_Hit_Event)) Begin
                Send EditEventDialog
            End
        End

        If (pbAllowEditInWeekView(Self) and (tHitTestInfo.eViewType = eCal_ViewType_Week)) Begin
            If ((tHitTestInfo.eHitItem = eCal_Hit_AllDayArea) or (tHitTestInfo.eHitItem = eCal_Hit_DayArea)) Begin
                Send NewEventDialog tHitTestInfo.dtSel_Begin
            End

            If ((tHitTestInfo.eHitItem = eCal_Hit_AllDayEvent) or (tHitTestInfo.eHitItem = eCal_Hit_Event)) Begin
                Send EditEventDialog
            End
        End

        If (pbAllowEditInMonthView(Self) and (tHitTestInfo.eViewType = eCal_ViewType_Month)) Begin
            If ((tHitTestInfo.eHitItem = eCal_Hit_AllDayArea) or (tHitTestInfo.eHitItem = eCal_Hit_DayArea)) Begin
                Send NewEventDialog tHitTestInfo.dtSel_Begin
            End

            If ((tHitTestInfo.eHitItem = eCal_Hit_AllDayEvent) or (tHitTestInfo.eHitItem = eCal_Hit_Event)) Begin
                Send EditEventDialog
            End
        End
    End_Procedure

    //-------------------------------------------------------------------------
    
    // Category="SigCj:CJ Event" Visibility=Internal
    Procedure OnComKeyDown Short ByRef llKeyCode Short llShift
        Boolean bOk
        tdSigCjCal_HitTestInfo tHitTestInfo
        
        If (llKeyCode = 46) Begin
            Get ptHitTestInfo to tHitTestInfo
            If (tHitTestInfo.bEventClicked) Begin            
                Send Delete_Event
            End
            Move 0 to llKeyCode
        End

        Forward Send OnComKeyDown llKeyCode llShift
    End_Procedure
    
    //-------------------------------------------------------------------------

    // Category="SigCj:CJ Event" Visibility=Internal
    Procedure OnComMouseDown Short llButton Short llShift OLE_XPOS_PIXELS llx OLE_YPOS_PIXELS lly
        Integer eCurrentView
        DateTime dtEnd
        TimeSpan tsDuration
        Handle  hoActiveView hoViewSelection
        Variant vActiveView vViewSelection
        tdSigCjCal_HitTestInfo  tHitTestInfo

        Get HitTestInfo to tHitTestInfo
        Set ptHitTestInfo to tHitTestInfo

        If (llButton = 2) Begin //Right button
            If ((tHitTestInfo.eHitItem = eCal_Hit_AllDayArea) or (tHitTestInfo.eHitItem = eCal_Hit_AllDayEvent) or ;
                (tHitTestInfo.eHitItem = eCal_Hit_DayArea   ) or (tHitTestInfo.eHitItem = eCal_Hit_Event)) Begin

                If ((llShift = 0) or (llShift > 3)) Begin
                    Get Internal_phoActivteView   to hoActiveView
                    Get ComActiveView to vActiveView
                    Set pvComObject of hoActiveView to vActiveView
                    Send ComUnselectAllEvents of hoActiveView

                    If ((tHitTestInfo.eHitItem = eCal_Hit_AllDayEvent) or (tHitTestInfo.eHitItem = eCal_Hit_Event)) Begin
                        Get ComViewType to eCurrentView
                        Send ComSelectEventByID tHitTestInfo.iEvent_ID
                        Set ComViewType to eCurrentView
                        
                        //Reset the CanCCP Booleans
                        Get ComCanCut   of hoActiveView to tHitTestInfo.bCanCut
                        Get ComCanCopy  of hoActiveView to tHitTestInfo.bCanCopy
                        Get ComCanPaste of hoActiveView to tHitTestInfo.bCanPaste
                
                        Set ptHitTestInfo to tHitTestInfo
                    End
                    Else Begin
                        Move tHitTestInfo.dtDateTime to dtEnd
                        Move (DateSetMinute(tsDuration, (peTimeScale(Self)) )) to tsDuration
                        Move (dtEnd + tsDuration) to dtEnd
                        
                        Get Internal_phoViewSelection to hoViewSelection
                        Get ComSelection of hoActiveView to vViewSelection
                        Set pvComObject     of hoViewSelection to vViewSelection
                        Set ComBegin        of hoViewSelection to tHitTestInfo.dtDateTime
                        Set ComEnd          of hoViewSelection to dtEnd
                        Set ComAllDay       of hoViewSelection to False
                        Set ComGroupIndex   of hoViewSelection to tHitTestInfo.iGroupIndex
                        //Send ComSetSelection of hoActiveView tHitTestInfo.dtDateTime dtEnd False
                    End

                    Send ComRedrawControl
                End

                If (peContextMenu_Main(Self) = eCal_CM_Standard) Begin
                    Send Show_Context_Menu_Main tHitTestInfo
                End
                If (peContextMenu_Main(Self) = eCal_CM_Custom) Begin
                    Send OnShowContextMenu_Main tHitTestInfo
                End
            End

            If ((tHitTestInfo.eHitItem = eCal_Hit_DayHeader) or (tHitTestInfo.eHitItem = eCal_Hit_ResourceHeader)) Begin
                If (peContextMenu_Header(Self) = eCal_CM_Standard) Begin
                    Send Show_Context_Menu_Header
                End
                If (peContextMenu_Header(Self) = eCal_CM_Custom) Begin
                    Send OnShowContextMenu_Header
                End
            End

            If (tHitTestInfo.eHitItem = eCal_Hit_TimeScale) Begin
                If (peContextMenu_Scale(Self) = eCal_CM_Standard) Begin
                    Send Show_Context_Menu_Scale
                End
                If (peContextMenu_Scale(Self) = eCal_CM_Custom) Begin
                    Send OnShowContextMenu_Scale
                End
            End

        End
        Else Begin
            If (pbEnableDB_Link(Self) and pbDB_Link_OnClick(Self)) Begin
                Send DB_Link_Goto
            End
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:CJ Event" Visibility=Internal
    Procedure OnComMouseMove Short llButton Short llShift OLE_XPOS_PIXELS llx OLE_YPOS_PIXELS lly
        String sToolTip
        tdSigCjCal_Event       tEvent
        tdSigCjCal_HitTestInfo tHitTestInfo

        If (pbEnableCustomEventToolTips(Self)) Begin
            Get HitTestInfo to tHitTestInfo

            //Property ptHitTestInfo is not updated as this is a mouse move, not
            //a mouse click. Other methods rely on ptHitTestInfo for information
            //on what was clicked. We still pass on Hit Test info so that the
            //tool tip can be built from information about the event the mouse
            //is over.
            //Set ptHitTestInfo to tHitTestInfo

            If (tHitTestInfo.bEventClicked) Begin
                Get Populate_tdSigCj_Event_From_Object tHitTestInfo.vEvent to tEvent
                Get OnCustomToolTip tHitTestInfo tEvent to sToolTip
                Set ComTooltipText to sToolTip
            End
            Else Set ComTooltipText to ""
        End
    End_Procedure

