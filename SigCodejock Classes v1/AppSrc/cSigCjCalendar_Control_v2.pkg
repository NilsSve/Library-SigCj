    // Category="SigCj:Properties" Visibility=Public
    Procedure Set psCustomProperty Integer iDataProvider_ID Integer iEvent_ID String sName String sValue
        Handle  hoEvent hoCustomProperties hoDataProvider
        Variant vCustomProperties vDataProvider vEvent

        Get Event_Object iDataProvider_ID iEvent_ID to vEvent
        Get Internal_phoEvent to hoEvent
        Set pvComObject of hoEvent to vEvent

        Get ComCustomProperties of hoEvent to vCustomProperties
        Get Internal_phoCustomProperties    to hoCustomProperties
        Set pvComObject of hoCustomProperties to vCustomProperties
        Set ComProperty of hoCustomProperties sName to sValue

        Send Notify_Event_Changed hoEvent
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Properties" Visibility=Public
    Function psCustomProperty Integer iDataProvider_ID Integer iEvent_ID String sName Returns String
        Handle  hoEvent hoCustomProperties
        Variant vCustomProperties vEvent
        String  sValue

        Get Event_Object iDataProvider_ID iEvent_ID to vEvent
        If (not(IsNullComObject(vEvent))) Begin
            Get Internal_phoEvent to hoEvent
            Set pvComObject of hoEvent to vEvent

            Get ComCustomProperties of hoEvent to vCustomProperties
            If (not(IsNullComObject(vCustomProperties))) Begin
                Get Internal_phoCustomProperties    to hoCustomProperties
                Set pvComObject of hoCustomProperties to vCustomProperties
                Get ComProperty of hoCustomProperties sName to sValue
            End
        End

        Function_Return sValue
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Properties" Visibility=Private
    Function psCustomProperty_hoEvent String sName Returns String
        Handle  hoCustomProperties hoEvent
        Variant vCustomProperties
        String  sValue

        Get Internal_phoEvent to hoEvent
        Get ComCustomProperties of hoEvent to vCustomProperties
        Get Internal_phoCustomProperties    to hoCustomProperties
        Set pvComObject of hoCustomProperties to vCustomProperties
        Get ComProperty of hoCustomProperties sName to sValue
        
        Function_Return sValue
    End_Function

