    // Category="SigCj:Dialogs" Visibility=Internal
    Procedure CM_ScaleTime String sData
        If (sData = eCal_TimeScale_5 ) Set peTimeScale to eCal_TimeScale_5
        If (sData = eCal_TimeScale_10) Set peTimeScale to eCal_TimeScale_10
        If (sData = eCal_TimeScale_15) Set peTimeScale to eCal_TimeScale_15
        If (sData = eCal_TimeScale_20) Set peTimeScale to eCal_TimeScale_20
        If (sData = eCal_TimeScale_30) Set peTimeScale to eCal_TimeScale_30
        If (sData = eCal_TimeScale_60) Set peTimeScale to eCal_TimeScale_60
        If (sData = eCal_TimeScale_10) Set peTimeScale to eCal_TimeScale_10
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Dialogs" Visibility=Internal
    Procedure CM_ScaleTime_Custom
        Integer iInterval

        Get peTimeScale to iInterval
        Get OnSetTimeScale iInterval to iInterval
        If ((iInterval > 0) and (iInterval < 61)) Begin
            Set peTimeScale to iInterval
        End
    End_Procedure

    //-------------------------------------------------------------------------
    
    // Category="SigCj:Support Methods" Visibility=Internal
    Function Connection_String tdSigCjCal_DataProvider tDataProvider Returns String
        String sConnection
        
        Case Begin
            Case (tDataProvider.eDataType = eCal_DP_Type_XML)
                Move ("Provider=XML;Data Sourcee=" + tDataProvider.sConnection) to sConnection
            Case Break

            Case (tDataProvider.eDataType = eCal_DP_Type_Access)
                Move ("Provider=Microsoft.Jet.OLEDB.4.0;Data Source=" + tDataProvider.sConnection) to sConnection
            Case Break

            Case (tDataProvider.eDataType = eCal_DP_Type_MAPI)
                Move ("Provider=MAPI;Data Source=" + tDataProvider.sConnection) to sConnection
            Case Break

            Case (tDataProvider.eDataType = eCal_DP_Type_Custom)
                Move ("Provider=custom;DPName=" + tDataProvider.sConnection) to sConnection
            Case Break

            Case Else
                Move "ERROR" to sConnection
                Error 501 ("Invalid Data Provider Type - " + String(tDataProvider.eDataType))
        Case End

        Function_Return sConnection
    End_Function

