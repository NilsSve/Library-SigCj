    // Category="SigCj:DB_Link" Visibility=Internal
    Procedure Store_DB_Link Handle hoCustomProperties Boolean bDB_Link String sDB_Table String sDB_Key
        If (bDB_Link) Begin
            Set ComProperty of hoCustomProperties eCal_DB_Link  to bDB_Link
            Set ComProperty of hoCustomProperties eCal_DB_Table to sDB_Table
            Set ComProperty of hoCustomProperties eCal_DB_Key   to sDB_Key
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:General" Visibility=Internal
    Procedure Store_User_IDs Handle hoCustomProperties String sCreatedBy String sLastMod_By
        Set ComProperty of hoCustomProperties eCal_ID_CreatedBy  to sCreatedBy
        Set ComProperty of hoCustomProperties eCal_ID_ModifiedBy to sLastMod_By
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Support Methods" Visibility=Internal
    Function To_CJ_Margin Number nValue Returns Number
        If (Internal_pbMarginsMeasureMetrics(Self) = True) Function_Return (nValue * 100)
        Else                                              Function_Return (nValue * 1000)
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Icons" Visibility=Internal
    Procedure Update_CustomIcons Handle hoCustomIcons tdSigCjCal_Dialog_CustomIcon tDialog_CustomIcons
        Integer iLoop iCount iIndex

        Move (SizeOfArray(tDialog_CustomIcons.tCustomIcons) - 1) to iCount
        For iLoop from 0 to iCount
            If (tDialog_CustomIcons.tCustomIcons[iLoop].eAction = eCal_Dialog_Action_Create) Begin
                Send ComAddIfNeed of hoCustomIcons tDialog_CustomIcons.tCustomIcons[iLoop].iId
            End
            If (tDialog_CustomIcons.tCustomIcons[iLoop].eAction = eCal_Dialog_Action_Delete) Begin
                Get ComFind of hoCustomIcons tDialog_CustomIcons.tCustomIcons[iLoop].iId to iIndex
                If (iIndex <> -1) Begin
                    Send ComRemove of hoCustomIcons iIndex
                End
            End
        Loop
    End_Procedure

    //-------------------------------------------------------------------------
    
    // Category="SigCj:Properties" Visibility=Internal
    Procedure Update_CustomProperty Handle hoCustomProperties tdSigCjCal_Dialog_CustomProperty tDialog_CustomProperty
        Boolean bDB_Link 
        Integer iCount iLoop
        String  sDB_Table sDB_Key sID_CreatedBy sID_ModifiedBy
                    
        If (tDialog_CustomProperty.bRemoveExisting) Begin
            Send Retrieve_DB_Link  hoCustomProperties (&bDB_Link) (&sDB_Table) (&sDB_Key)
            Send Retrieve_User_IDs hoCustomProperties (&sID_CreatedBy) (&sID_ModifiedBy)
            Send ComRemoveAll of hoCustomProperties
            Send Store_DB_Link  hoCustomProperties bDB_Link sDB_Table sDB_Key
            Send Store_User_IDs hoCustomProperties sID_CreatedBy sID_ModifiedBy
        End

        Move (SizeOfArray(tDialog_CustomProperty.tCustomProperties) - 1) to iCount
        For iLoop from 0 to iCount
            Set ComProperty of hoCustomProperties ;
                               tDialog_CustomProperty.tCustomProperties[iLoop].sName to ;
                               tDialog_CustomProperty.tCustomProperties[iLoop].sValue
        Loop
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Support Methods" Visibility=Internal
    Procedure UpdateEventObject Variant vEvent tdSigCjCal_Event tEvent Boolean bRException 
        Boolean bMultipleSchedulesMode
        Handle   hoEvent hoCategories hoCustomIcons hoCustomProperties 
        DateTime dtWork
        Variant  vCategories vCustomIcons vCustomProperties //vDataProvider
                
        Get Internal_phoEvent to hoEvent
        Set pvComObject of hoEvent to vEvent
        
        Set ComBody                         of hoEvent to (Trim(tEvent.sBody))
        Set ComSubject                      of hoEvent to (Trim(tEvent.sSubject))
        Set ComLocation                     of hoEvent to (Trim(tEvent.sLocation))
        Set ComAllDayEvent                  of hoEvent to tEvent.bAllDayEvent
        Set ComBusyStatus                   of hoEvent to tEvent.eBusyStatus
        Set ComImportance                   of hoEvent to tEvent.eImportance
        Set ComLabel                        of hoEvent to (Trim(tEvent.sLabel))
        Set ComMeetingFlag                  of hoEvent to tEvent.bMeetingFlag
        Set ComPrivateFlag                  of hoEvent to tEvent.bPrivateFlag
        Set ComReminder                     of hoEvent to tEvent.bReminder
        Set ComReminderMinutesBeforeStart   of hoEvent to tEvent.iRem_MinsBefore
        Set ComReminderSoundFile            of hoEvent to (Trim(tEvent.sRem_SoundFile))

        Get pbMultipleSchedulesMode to bMultipleSchedulesMode
        If (bMultipleSchedulesMode) Begin
            Set ComScheduleID         of hoEvent to (Mid(tEvent.sScheduleIDs,(Pos("|", tEvent.sScheduleIDs, 2) - 2),2))
            Set ComMultipleSchedules  of hoEvent to tEvent.sScheduleIDs
        End
        Else Begin
            Set ComScheduleID         of hoEvent to tEvent.iScheduleID
        End

        If (tEvent.eRecurr_State <> OLExtpCalendarRecurrenceMaster) Begin
            Get Date_and_Time_to_DateTime tEvent.dStartDate tEvent.tmStartTime to dtWork
            Set ComStartTime of hoEvent to dtWork

            Get Date_and_Time_to_DateTime tEvent.dEndDate   tEvent.tmEndTime   to dtWork
            Set ComEndTime of hoEvent to dtWork
        End

        Get ComCategories of hoEvent to vCategories
        Get Internal_phoEventCategoriesIDs to hoCategories
        Set pvComObject of hoCategories to vCategories
        Send ComLoadFromString of hoCategories tEvent.sCategories

        Get ComCustomIcons of hoEvent to vCustomIcons
        Get Internal_phoCustomIcons to hoCustomIcons
        Set pvComObject of hoCustomIcons to vCustomIcons
        Send ComLoadFromString of hoCustomIcons tEvent.sCustomIcons

        Get ComCustomProperties of hoEvent to vCustomProperties
        Get Internal_phoCustomProperties to hoCustomProperties
        Set pvComObject of hoCustomProperties to vCustomProperties
        Send ComLoadFromString of hoCustomProperties tEvent.sCustomProperties

        //Add DB_Link data as custom properties.. so it does not get lost
        If (pbEnableDB_Link(Self)) Begin
            Send Store_DB_Link hoCustomProperties tEvent.bDB_Link tEvent.sDB_Table tEvent.sDB_Key
        End

        //Add Created and Modified IDs as custom properties.. so they do not get lost
        Send Store_User_IDs hoCustomProperties tEvent.sCreatedBy tEvent.sLastMod_By

        If (bRException) Begin
            Send ComMakeAsRException of hoEvent

#IF (SigCj_Codejock_Version < 240000)  
            //These are Hidden !!!!!!!!!!!!
            Get Date_and_Time_to_DateTime tEvent.dRE_StartDateOrg tEvent.tmRE_StartTimeOrg to dtWork
            Set ComRExceptionStartTimeOrig of hoEvent to dtWork

            Get Date_and_Time_to_DateTime tEvent.dRE_EndDateOrg   tEvent.tmRE_EndTimeOrg   to dtWork
            Set ComRExceptionEndTimeOrig of hoEvent to dtWork

            Set ComRExceptionDeleted       of hoEvent to tEvent.bRE_Deleted
#ENDIF
        End
        Else Begin
            Set ComProperty of hoCustomProperties "process_RecurrenceState"     to tEvent.eRecurr_State
            Set ComProperty of hoCustomProperties "process_RecurrencePatternID" to tEvent.iRec_Pattern_id
        End
    End_Procedure

    //-------------------------------------------------------------------------
    // Category="SigCj:Support Methods" Visibility=Internal
    
    Procedure UpdateRecPatternObject Variant vRecPattern tdSigCjCal_RecPattern tRecPattern
        Handle   hoRecPattern hoRecPatternOptions hoCustomProperties
        DateTime dtWork
        Variant  vRecPatternOptions vCustomProperties
        
        Get Internal_phoRecPattern to hoRecPattern
        Set pvComObject of hoRecPattern to vRecPattern

        Set ComMasterEventId   of hoRecPattern to tRecPattern.iMasterEventId
        Set ComDurationMinutes of hoRecPattern to tRecPattern.iDurationMinutes
        Set ComEndMethod       of hoRecPattern to tRecPattern.eEndMethod

        Case Begin
            Case (tRecPattern.eEndMethod = OLExtpCalendarPatternEndDate)
                Set ComEndDate of hoRecPattern to tRecPattern.dEndDate
            Case Break

            Case (tRecPattern.eEndMethod = OLExtpCalendarPatternEndAfterOccurrences)
                Set ComEndAfterOccurrences of hoRecPattern to tRecPattern.iEndAfterOcc
            Case Break

            Case Else
                //if no end info change end type
                Set ComEndMethod of hoRecPattern to OLExtpCalendarPatternEndNoDate
        Case End

        Set ComStartDate of hoRecPattern to tRecPattern.dStartDate
        Get Date_and_Time_to_DateTime tRecPattern.dStartDate tRecPattern.tmStartTime to dtWork
        Set ComStartTime of hoRecPattern to dtWork

        Get ComOptions of hoRecPattern to vRecPatternOptions
        Get Internal_phoRecPatternOptions to hoRecPatternOptions
        Set pvComObject of hoRecPatternOptions to vRecPatternOptions

        Set ComDailyEveryWeekDayOnly  of hoRecPatternOptions to tRecPattern.bRoD_WeekDayOnly
        Set ComDailyIntervalDays      of hoRecPatternOptions to tRecPattern.iRoD_Int_Days
        Set ComData1                  of hoRecPatternOptions to tRecPattern.iRoData1
        Set ComData2                  of hoRecPatternOptions to tRecPattern.iRoData2
        Set ComData3                  of hoRecPatternOptions to tRecPattern.iRoData3
        Set ComData4                  of hoRecPatternOptions to tRecPattern.iRoData4
        Set ComMonthlyDayOfMonth      of hoRecPatternOptions to tRecPattern.iRoM_DayOfMonth
        Set ComMonthlyIntervalMonths  of hoRecPatternOptions to tRecPattern.iRoM_Int_Months
        Set ComMonthNthIntervalMonths of hoRecPatternOptions to tRecPattern.iRoM_NthInt_Mths
        Set ComMonthNthWhichDay       of hoRecPatternOptions to tRecPattern.iRoM_Nth_Day
        Set ComMonthNthWhichDayMask   of hoRecPatternOptions to tRecPattern.eRoM_Nth_DayMask
        Set ComRecurrenceType         of hoRecPatternOptions to tRecPattern.eRoRecurr_Type
        Set ComWeeklyDayOfWeekMask    of hoRecPatternOptions to tRecPattern.eRoW_DayWeekMask
        Set ComWeeklyIntervalWeeks    of hoRecPatternOptions to tRecPattern.iRoW_Int_Weeks
        Set ComYearlyDayOfMonth       of hoRecPatternOptions to tRecPattern.iRoY_DayOfMonth
        Set ComYearlyMonthOfYear      of hoRecPatternOptions to tRecPattern.iRoY_MonthOfYear
        Set ComYearNthMonthOfYear     of hoRecPatternOptions to tRecPattern.iRoY_NthM_OfYear
        Set ComYearNthWhichDay        of hoRecPatternOptions to tRecPattern.iRoY_Nth_Day
        Set ComYearNthWhichDayMask    of hoRecPatternOptions to tRecPattern.iRoY_Nth_DayMask

        Get ComCustomProperties of hoRecPattern to vCustomProperties
        Get Internal_phoCustomProperties to hoCustomProperties
        Set pvComObject of hoCustomProperties to vCustomProperties
        Send ComLoadFromString of hoCustomProperties tRecPattern.sCustomProp_XML
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Support Methods" Visibility=Internal
    Function View_Object Integer iWhichView Handle hoThemeOffice07 Returns Handle
        Handle  hoView
        Variant  vView

        If (iWhichView = 1) Begin
            Get Create U_cSigCjComCalendarThemeOffice2007DayView to hoView
            Get ComDayView of hoThemeOffice07 to vView
        End

        If (iWhichView = 2) Begin
            Get Create U_cSigCjComCalendarThemeOffice2007WeekView to hoView
            Get ComWeekView of hoThemeOffice07 to vView
        End

        If (iWhichView = 3) Begin
            Get Create U_cSigCjComCalendarThemeOffice2007MonthView to hoView
            Get ComMonthView of hoThemeOffice07 to vView
        End

        Set pvComObject of hoView to vView

        Function_Return hoView
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Support Methods" Visibility=Internal
    Function ViewDay_Object Integer iWhichView Variant vDay Returns Handle
        Handle hoDay

        If (iWhichView = 1) Get Create U_cSigCjComCalendarThemeOffice2007DayViewDay   to hoDay
        If (iWhichView = 2) Get Create U_cSigCjComCalendarThemeOffice2007WeekViewDay  to hoDay
        If (iWhichView = 3) Get Create U_cSigCjComCalendarThemeOffice2007MonthViewDay to hoDay

        Set pvComObject of hoDay to vDay

        Function_Return hoDay
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Support Methods" Visibility=Internal
    Function ViewEvent_Object Integer iWhichView Variant vEvent Returns Handle
        Handle hoEvent

        If (iWhichView = 1) Get Create U_cSigCjComCalendarThemeOffice2007DayViewEvent   to hoEvent
        If (iWhichView = 2) Get Create U_cSigCjComCalendarThemeOffice2007WeekViewEvent  to hoEvent
        If (iWhichView = 3) Get Create U_cSigCjComCalendarThemeOffice2007MonthViewEvent to hoEvent

        Set pvComObject of hoEvent to vEvent

        Function_Return hoEvent
    End_Function

