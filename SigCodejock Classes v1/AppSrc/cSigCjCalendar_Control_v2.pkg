    // Category="SigCj:DB_Link" Visibility=Internal
    Procedure DB_Link_Goto
        tdSigCjCal_HitTestInfo tHitTestInfo
        
        Get ptHitTestInfo to tHitTestInfo
        If (tHitTestInfo.tDB_Link.bDB_Link) Begin
            Send OnDB_Link tHitTestInfo.tDB_Link tHitTestInfo.iEvent_ID
        End        
    End_Procedure
    
    //-------------------------------------------------------------------------

    // Category="SigCj:DB_Link" Visibility=Internal
    Function DB_Link_Info Variant vEvent Returns tdSigCjCal_DB_Link
        Handle  hoEvent hoCustomProperties
        Variant vCustomProperties 
        tdSigCjCal_DB_Link tDB_Link

        Get Internal_phoEvent to hoEvent
        Set pvComObject of hoEvent to vEvent

        Get ComCustomProperties of hoEvent to vCustomProperties
        If (not(IsNullComObject(vCustomProperties))) Begin
            Get Internal_phoCustomProperties    to hoCustomProperties
            Set pvComObject of hoCustomProperties to vCustomProperties
            
            Get ComProperty of hoCustomProperties eCal_DB_Link to tDB_Link.bDB_Link
            If (tDB_Link.bDB_Link) Begin
                Get ComProperty of hoCustomProperties eCal_DB_Table to tDB_Link.sTable
                Get ComProperty of hoCustomProperties eCal_DB_Key   to tDB_Link.sKey
            End
        End

        Function_Return tDB_Link
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Schedules" Visibility=Public
    Procedure Delete_Category Integer iCategory_ID
        Integer iCount iLoop iCategory_Index
        Handle  hoDataProvider hoEventCategories
        tdSigCjCal_RM_Category[] taRM_Categories
        tdSigCjCal_RM_Category[] taRM_Categories_Temp

        Get Category_Index iCategory_ID to iCategory_Index
        If (iCategory_Index <> -1) Begin
            Get ptaRM_Categories to taRM_Categories
            If (taRM_Categories[iCategory_Index].iInUse <= 0) Begin
                Move (SizeOfArray(taRM_Categories) -1) to iCount
                For iLoop from 0 to iCount
                    If (taRM_Categories[iLoop].tCategory.iID <> iCategory_ID) Begin
                        Move taRM_Categories[iLoop] to taRM_Categories_Temp[SizeOfArray(taRM_Categories_Temp)]
                    End
                Loop
                Set ptaRM_Categories to taRM_Categories
            End
            Else Begin
                Error 501 ("Cannot delete Category - in use (ID: " + String(iCategory_ID) + ")")
            End
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Schedules" Visibility=Public
    Procedure Delete_DataProvider Integer iDataProvider_ID
        Integer iCount iLoop iDataProvider_Index
        Variant vDataProvider
        tdSigCjCal_RM_DataProvider[] taRM_DataProviders
        tdSigCjCal_RM_DataProvider[] taRM_DataProviders_Temp

        If (iDataProvider_ID <> piVDF_DataProvider(Self)) Begin
            Get DataProvider_Index iDataProvider_ID to iDataProvider_Index
            If (iDataProvider_Index <> -1) Begin
                Get ptaRM_DataProviders to taRM_DataProviders
                If (taRM_DataProviders[iDataProvider_Index].iInUse <= 0) Begin
                    Move (SizeOfArray(taRM_DataProviders) - 1) to iCount
                    For iLoop from 0 to iCount
                        If (taRM_DataProviders[iLoop].tDataProvider.iID <> iDataProvider_ID) Begin
                            Move taRM_DataProviders[iLoop] to taRM_DataProviders_Temp[SizeOfArray(taRM_DataProviders_Temp)]
                        End
                    Loop
                    Set ptaRM_DataProviders to taRM_DataProviders_Temp
                End
                Else Begin
                    Error 501 ("Cannot delete Data Provider - in use (ID: " + String(iDataProvider_ID) + ")")
                End
            End
        End
        Else Begin
            Error 501 ("Cannot delete VDF Data Provider (not allowed)")
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Data" Visibility=Internal
    Procedure Delete_Event
        Boolean bDelete bVoid
        Integer iEvent_ID iDelete iLoop iCount
        tdSigCjCal_Event  tEvent
        tdSigCjCal_HitTestInfo tHitTestInfo
        
        Get ptHitTestInfo to tHitTestInfo
        Move tHitTestInfo.iEvent_ID to iEvent_ID

        If (tHitTestInfo.bRecurring) Begin  //Recurring
            Get OnAskDeleteSeries to iDelete
            If (iDelete = eCal_Series_All) Begin    //Delete all
                Send OnDeleteEvent_Series tHitTestInfo.iRecPattern_ID
                Send Refresh_Data False
            End
            If (iDelete = eCal_Series_Single) Begin //Delete occurrence
                //Here we need to clone the event and set the RE_Delete flag
                Get Populate_tdSigCj_Event_From_Object tHitTestInfo.vEvent to tEvent

                Move OLExtpCalendarRecurrenceException  to tEvent.eRecurr_State
                Move tEvent.dStartDate                  to tEvent.dRE_StartDateOrg
                Move tEvent.dEndDate                    to tEvent.dRE_EndDateOrg
                Move tEvent.tmStartTime                 to tEvent.tmRE_StartTimeOrg
                Move tEvent.tmEndTime                   to tEvent.tmRE_EndTimeOrg
                Move True                               to tEvent.bRE_Deleted
                Move tHitTestInfo.iRecPattern_ID        to tEvent.iRec_Pattern_id
                Get OnCreateEvent tEvent to iEvent_ID

                Send Refresh_Data False
            End
        End
        Else Begin  //Single Event
            If (tHitTestInfo.iSelected_Count > 1) Begin
                Get OnAskDeleteEvents to bDelete
                If (bDelete) Begin
                    Move (tHitTestInfo.iSelected_Count - 1) to iCount
                    For iLoop from 0 to iCount
                        //We dump the return value and assume that the data will 
                        //need to be refreshed. 
                        Get OnDeleteEvent tHitTestInfo.iaEvent_IDs[iLoop] to bVoid
                    Loop
                End
            End
            Else Begin
                Get OnAskDeleteEvent tHitTestInfo.iEvent_ID to bDelete
                If (bDelete) Begin
                    Get OnDeleteEvent iEvent_ID to bDelete
                End
            End
    
            If (bDelete) Begin
                Send Refresh_Data False
            End
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Schedules" Visibility=Public
    Procedure Delete_Layout Integer iLayout_ID
        Integer iLayout_Index iCount iLoop
        tdSigCjCal_RM_Layout[] taRM_Layouts
        tdSigCjCal_RM_Layout[] taRM_Layouts_Temp

        If (iLayout_ID <> piCurrent_Layout_ID(Self)) Begin
            Get Layout_Index iLayout_ID to iLayout_Index
            If (iLayout_Index <> -1) Begin
                Get ptaRM_Layouts to taRM_Layouts
                If (SizeOfArray(taRM_Layouts[iLayout_Index].taRM_Resources) = 0) Begin
                    Move (SizeOfArray(taRM_Layouts) - 1) to iCount
                    For iLoop from 0 to iCount
                        If (taRM_Layouts[iLoop].tLayout.iID <> iLayout_ID) Begin
                            Move taRM_Layouts[iLoop] to taRM_Layouts_Temp[SizeOfArray(taRM_Layouts_Temp)]
                        End
                    Loop
                    Set ptaRM_Layouts to taRM_Layouts_Temp
                End
                Else Begin
                    Error 501 ("Cannot delete Layout - in use (ID: " + String(iLayout_ID) + ")")
                End
            End
        End
        Else Begin
            Error 501 ("Cannot delete current Layout (ID: " + String(iLayout_ID) + ")")
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Schedules" Visibility=Public
    Procedure Delete_Resource Integer iResource_ID
        Integer iResource_Index
        tdSigCjCal_RM_Resource[] taRM_Resources
        tdSigCjCal_RM_Resource[] taRM_Resources_Temp

        Get Resource_Index iResource_ID False to iResource_Index
        If (iResource_Index <> -1) Begin
            Get ptaRM_Resources to taRM_Resources
            If (taRM_Resources[iResource_Index].iInUse <= 0) Begin
                If (taRM_Resources[iResource_Index].tResource.iID <> iResource_ID) Begin
                    Move taRM_Resources[iResource_Index] to taRM_Resources_Temp[SizeOfArray(taRM_Resources_Temp)]
                End
                Get ptaRM_Resources to taRM_Resources_Temp
            End
            Else Begin
                Error 501 ("Cannot delete Resource - in use (ID: " + String(iResource_ID) + ")")
            End
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Schedules" Visibility=Public
    Procedure Delete_Schedule Integer iSchedule_ID
        Integer iCount iLoop
        tdSigCjCal_RM_Schedule[] taRM_Schedules
        tdSigCjCal_RM_Schedule[] taRM_Schedules_Temp

        Get ptaRM_Schedules to taRM_Schedules
            Move (SizeOfArray(taRM_Schedules) -1) to iCount
            For iLoop from 0 to iCount
                If (taRM_Schedules[iLoop].tSchedule.iID <> iSchedule_ID) Begin
                    Move taRM_Schedules[iLoop] to taRM_Schedules_Temp[SizeOfArray(taRM_Schedules_Temp)]
                End
            Loop
        Set ptaRM_Schedules to taRM_Schedules
    End_Procedure

    //-------------------------------------------------------------------------
    
    // Category="SigCj:Dialogs" Visibility=Internal
    Function Dialog_CustomIcon_Info Handle hoCustomIcons Returns tdSigCjCal_Dialog_CustomIcon
        Integer iLoop iCount iIcon_Loop iIcon_Count iID 
        tdSigCjCal_Dialog_CustomIcon   tDialog_CustomIcons

        Get ptaCustomIcons to tDialog_CustomIcons.tCustomIcons
        Move eCal_Dialog_Action_None to tDialog_CustomIcons.eAction
        
        Get ComCount of hoCustomIcons to iIcon_Count
        Decrement iIcon_Count        

        Move (SizeOfArray(tDialog_CustomIcons.tCustomIcons) - 1) to iCount
        For iLoop from 0 to iCount
            Move eCal_Dialog_Action_None to tDialog_CustomIcons.tCustomIcons[iLoop].eAction
            
            For iIcon_Loop from 0 to iIcon_Count
                Get ComItem of hoCustomIcons iIcon_Loop to iID
                If (iID = tDialog_CustomIcons.tCustomIcons[iLoop].iId) Begin
                    Move eCal_Dialog_Action_Exists  to tDialog_CustomIcons.tCustomIcons[iLoop].eAction
                    Move (iIcon_Count + 1) to iIcon_Loop    //bomb loop
                End
            Loop
        Loop

        Function_Return tDialog_CustomIcons        
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Support Methods" Visibility=Internal
    Function TimeSpan_Mins Date dStart String sStartTime Date dEnd String sEndTime Returns Integer
        Integer iDays iHours iMins
        DateTime dtStart dtEnd
        TimeSpan tsDiff
        
        Get Date_and_Time_to_DateTime dStart sStartTime to dtStart
        Get Date_and_Time_to_DateTime dEnd   sEndTime   to dtEnd
        Move (dtEnd - dtStart) to tsDiff
        Move (DateGetDay   (tsDiff)) to iDays        
        Move (DateGetHour  (tsDiff)) to iHours
        Move (DateGetMinute(tsDiff)) to iMins
        
        Function_Return ((iDays * (24 * 60)) + (iHours * 60) + iMins)
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Dialogs" Visibility=Private
    Function Dialog_Info Returns tdSigCjCal_Dialog_Info
        Integer iLayout_Index iLoop iCount iDataProvider_Index
        Handle hoCustomIcons hoEvent hoRecPattern
        Variant vCustomIcons
        tdSigCjCal_Dialog_COM_Objects   tDialog_COM_Object
        tdSigCjCal_Dialog_Info          tDialogInfo
        tdSigCjCal_HitTestInfo          tHitTestInfo
        tdSigCjCal_RM_DataProvider[]    taRM_DataProviders
        tdSigCjCal_RM_Layout[]          taRM_Layouts
        
        //---------------------------------------------------------------------
        //Get info we may need
        Get ptaRM_Layouts       to taRM_Layouts
        Get ptaRM_DataProviders to taRM_DataProviders
        Get ptHitTestInfo       to tHitTestInfo

        //---------------------------------------------------------------------
        //Add Event Info
        If (tHitTestInfo.bEventClicked) Begin
            //Edit mode
            Move eCal_Dialog_Action_Edit to tDialogInfo.eAction_Event
            Get Populate_tdSigCj_Event_From_Object tHitTestInfo.vEvent to tDialogInfo.tEvent
            Move tHitTestInfo.vEvent to tDialog_COM_Object.vEvent

            Get Internal_phoEvent to hoEvent 
            Set pvComObject of hoEvent to tHitTestInfo.vEvent 
        End
        Else Begin
            //Create Mode
            Move eCal_Dialog_Action_Create to tDialogInfo.eAction_Event

            //Set Event Defaults
            Move tHitTestInfo.bSel_AllDay to tDialogInfo.tEvent.bAllDayEvent
            Move  2 to tDialogInfo.tEvent.eBusyStatus                    
            Move  2 to tDialogInfo.tEvent.eImportance
            Move 15 to tDialogInfo.tEvent.iRem_MinsBefore

            If (tHitTestInfo.bSel_IsValid) Begin
                Move (Date(tHitTestInfo.dtSel_Begin)) to tDialogInfo.tEvent.dStartDate
                Move (Date(tHitTestInfo.dtSel_End  )) to tDialogInfo.tEvent.dEndDate
                Get DateTime_to_Time tHitTestInfo.dtSel_Begin to tDialogInfo.tEvent.tmStartTime
                Get DateTime_to_Time tHitTestInfo.dtSel_End   to tDialogInfo.tEvent.tmEndTime
            End
            
            Move (NullComObject()) to tDialog_COM_Object.vEvent
        End
        
        //---------------------------------------------------------------------
        //Add Rec Pattern Info
        If (tDialogInfo.tEvent.iRec_Pattern_id <> 0) Begin
            //RecPattern exists
            Move eCal_Dialog_Action_Exists to tDialogInfo.tDialog_RecPattern.eAction

            Get ComRecurrencePattern   of hoEvent to tDialog_COM_Object.vRecPattern
            Get Internal_phoRecPattern to hoRecPattern
            Get ComMasterEvent         of hoRecPattern to tDialog_COM_Object.vMasterEvent
            Get Populate_tdSigCj_RecPattern_From_Object tDialog_COM_Object.vRecPattern to tDialogInfo.tDialog_RecPattern.tRecPattern
        End
        Else Begin
            //No RecPattern
            Move eCal_Dialog_Action_None to tDialogInfo.tDialog_RecPattern.eAction
            
            Move OLExtpCalendarRecurrenceDaily  to tDialogInfo.tDialog_RecPattern.tRecPattern.eRoRecurr_Type
            Move OLExtpCalendarPatternEndNoDate to tDialogInfo.tDialog_RecPattern.tRecPattern.eEndMethod

            Move 5    to tDialogInfo.tDialog_RecPattern.tRecPattern.iEndAfterOcc
            Move True to tDialogInfo.tDialog_RecPattern.tRecPattern.bRoD_WeekDayOnly
            Move 1    to tDialogInfo.tDialog_RecPattern.tRecPattern.iRoD_Int_Days      
            Move 1    to tDialogInfo.tDialog_RecPattern.tRecPattern.iRoM_DayOfMonth    
            Move 1    to tDialogInfo.tDialog_RecPattern.tRecPattern.iRoM_Int_Months    
            Move 1    to tDialogInfo.tDialog_RecPattern.tRecPattern.iRoM_NthInt_Mths   
            Move 1    to tDialogInfo.tDialog_RecPattern.tRecPattern.iRoM_Nth_Day       
            Move 1    to tDialogInfo.tDialog_RecPattern.tRecPattern.eRoM_Nth_DayMask   
            Move 1    to tDialogInfo.tDialog_RecPattern.tRecPattern.eRoW_DayWeekMask   
            Move 1    to tDialogInfo.tDialog_RecPattern.tRecPattern.iRoW_Int_Weeks     
            Move 1    to tDialogInfo.tDialog_RecPattern.tRecPattern.iRoY_DayOfMonth    
            Move 1    to tDialogInfo.tDialog_RecPattern.tRecPattern.iRoY_MonthOfYear   
            Move 1    to tDialogInfo.tDialog_RecPattern.tRecPattern.iRoY_NthM_OfYear   
            Move 1    to tDialogInfo.tDialog_RecPattern.tRecPattern.iRoY_Nth_Day       
            Move 1    to tDialogInfo.tDialog_RecPattern.tRecPattern.iRoY_Nth_DayMask   

            Move tDialogInfo.tEvent.dStartDate  to tDialogInfo.tDialog_RecPattern.tRecPattern.dStartDate
            Move tDialogInfo.tEvent.dEndDate    to tDialogInfo.tDialog_RecPattern.tRecPattern.dEndDate
            Move tDialogInfo.tEvent.tmStartTime to tDialogInfo.tDialog_RecPattern.tRecPattern.tmStartTime
            Move tDialogInfo.tEvent.tmEndTime   to tDialogInfo.tDialog_RecPattern.tRecPattern.tmEndTime
            
            Get TimeSpan_Mins tDialogInfo.tEvent.dStartDate tDialogInfo.tEvent.tmStartTime    ;
                              tDialogInfo.tEvent.dEndDate   tDialogInfo.tEvent.tmEndTime   to ;
                              tDialogInfo.tDialog_RecPattern.tRecPattern.iDurationMinutes
                        
            Move (NullComObject()) to tDialog_COM_Object.vRecPattern
            Move (NullComObject()) to tDialog_COM_Object.vMasterEvent
        End 

        //---------------------------------------------------------------------
        //Add Schedule and Category Info
        If (pbEnableResources(Self)) Begin
            //Get ptaRM_Layouts to taRM_Layouts
            Get Layout_Index tHitTestInfo.iLayout_ID to iLayout_Index
            If (pbDialogAllSchedulesMode(Self)) Begin
                Move (SizeOfArray(taRM_Layouts[iLayout_Index].taRM_Resources) - 1) to iCount
                For iLoop from 0 to iCount             
                    Get DialogInfo_Add_Schedules tDialogInfo taRM_Layouts[iLayout_Index].taRM_Resources[iLoop] to tDialogInfo
                Loop
            End
            Else Begin
                Get DialogInfo_Add_Schedules tDialogInfo taRM_Layouts[iLayout_Index].taRM_Resources[tHitTestInfo.iGroupIndex] to tDialogInfo
            End    
        End
        Else Begin
            Get DialogInfo_Add_Categories tDialogInfo to tDialogInfo
        End

        //---------------------------------------------------------------------
        //Add DB_Link Info
        If (pbEnableDB_Link(Self)) Begin
            If (tHitTestInfo.tDB_Link.bDB_Link) begin
                Move eCal_Dialog_Action_Exists to tDialogInfo.tDialog_DB_Link.eAction
                Move tHitTestInfo.tDB_Link to tDialogInfo.tDialog_DB_Link.tDB_Link
            End
            Else Begin
                Move eCal_Dialog_Action_None to tDialogInfo.tDialog_DB_Link.eAction
            End
        End
        Else Begin
            Move eCal_Dialog_Action_Disabled to tDialogInfo.tDialog_DB_Link.eAction
        End
        
        //---------------------------------------------------------------------
        //Add Icon Info
        If (pbEnableCustomIcons(Self)) Begin
            If (tDialogInfo.eAction_Event = eCal_Dialog_Action_Edit) Begin
                Get Internal_phoCustomIcons to hoCustomIcons
                Get ComCustomIcons of hoEvent to vCustomIcons
                Set pvComObject of hoCustomIcons to vCustomIcons

                //Action set by Dialog_CustomIcon_Info 
                Get Dialog_CustomIcon_Info hoCustomIcons to tDialogInfo.tDialog_CustomIcon
            End
            Else Begin
                Get ptaCustomIcons to tDialogInfo.tDialog_CustomIcon.tCustomIcons
                Move eCal_Dialog_Action_None to tDialogInfo.tDialog_CustomIcon.eAction
            End
        End
        Else Begin
            Move eCal_Dialog_Action_Disabled to tDialogInfo.tDialog_CustomIcon.eAction
        End

        //---------------------------------------------------------------------
        //Add Property Info
        If (pbEnableCustomProperties(Self)) Begin
            If (tDialogInfo.eAction_Event = eCal_Dialog_Action_Edit) Begin
                Get psaCustomProperties tHitTestInfo.iDataProvider_ID tHitTestInfo.iEvent_ID to tDialogInfo.tDialog_CustomProperty.tCustomProperties
                If (SizeOfArray(tDialogInfo.tDialog_CustomProperty.tCustomProperties) > 0) Begin
                    Move eCal_Dialog_Action_Exists to tDialogInfo.tDialog_CustomProperty.eAction
                End
                Else Begin
                    Move eCal_Dialog_Action_None to tDialogInfo.tDialog_CustomProperty.eAction
                End
            End
            Else Begin
                Move eCal_Dialog_Action_None to tDialogInfo.tDialog_CustomProperty.eAction
            End
        End
        Else Begin
            Move eCal_Dialog_Action_Disabled to tDialogInfo.tDialog_CustomProperty.eAction
        End

        //---------------------------------------------------------------------
        //Add Other control Info
        
        Get pbDialogAllSchedulesMode    to tDialogInfo.bAllScheduleInfo
        Get pbMultipleSchedulesMode     to tDialogInfo.bMultiSchedulesMode
        Get phoDialog_EditRecurrence    to tDialogInfo.hoRecurringDialog

        If (tDialogInfo.bMultiSchedulesMode) Begin
            Move tHitTestInfo.sResource_Name to tDialogInfo.sDefaultSchedule
        End

        //Data Provider COM object
        Get DataProvider_Index tHitTestInfo.iDataProvider_ID to iDataProvider_Index
        Move taRM_DataProviders[iDataProvider_Index].vDataProvider to tDialog_COM_Object.vDataProvider

        //---------------------------------------------------------------------
        //Save the COM Object handles we will need on return from the dialog

        Set ptDialog_COM_Objects to tDialog_COM_Object

        //---------------------------------------------------------------------

        Function_Return tDialogInfo
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Dialogs" Visibility=Internal
    Function DialogInfo_Add_Categories tdSigCjCal_Dialog_Info tDialogInfo Returns tdSigCjCal_Dialog_Info
        Integer iCategory_Count iCategory_Loop //iSchedule_Count iSchedule_Loop
        tdSigCjCal_RM_Category[] taRM_Categories

        Get ptaRM_Categories to taRM_Categories

        Move "0"           to tDialogInfo.taSchedules[0].iID
        Move "Simple Mode" to tDialogInfo.taSchedules[0].sName

        Move (SizeOfArray(taRM_Categories) - 1) to iCategory_Count
        For iCategory_Loop from 0 to iCategory_Count
            Move taRM_Categories[iCategory_Loop].tCategory to ;
                tDialogInfo.taSchedules[0].taCateogies[SizeOfArray(tDialogInfo.taSchedules[0].taCateogies)]
        Loop

        Function_Return tDialogInfo
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Dialogs" Visibility=Internal
    Function DialogInfo_Add_Schedules tdSigCjCal_Dialog_Info tDialogInfo tdSigCjCal_RM_Resource tRM_Resource Returns tdSigCjCal_Dialog_Info
        Integer iCategory_Index iSchedule_Index iIndex 
        Integer iCategory_Count iCategory_Loop iSchedule_Count iSchedule_Loop
        tdSigCjCal_RM_Category[] taRM_Categories
        tdSigCjCal_RM_Schedule[] taRM_Schedules

        Get ptaRM_Schedules  to taRM_Schedules
        Get ptaRM_Categories to taRM_Categories

        Move (SizeOfArray(tRM_Resource.iSchedule_IDs) - 1) to iSchedule_Count
        For iSchedule_Loop from 0 to iSchedule_Count
            Get DialogInfo_Schedule_Index tDialogInfo.taSchedules tRM_Resource.iSchedule_IDs[iSchedule_Loop] to iSchedule_Index
            If (iSchedule_Index = -1) Begin
                Get Schedule_Index tRM_Resource.iSchedule_IDs[iSchedule_Loop] to iSchedule_Index
                Move (SizeOfArray(tDialogInfo.taSchedules)) to iIndex
                Move taRM_Schedules[iSchedule_Index].tSchedule.iID   to tDialogInfo.taSchedules[iIndex].iID
                Move taRM_Schedules[iSchedule_Index].tSchedule.sName to tDialogInfo.taSchedules[iIndex].sName
                Move (SizeOfArray(taRM_Schedules[iSchedule_Index].taCategory_IDs) - 1) to iCategory_Count
                For iCategory_Loop from 0 to iCategory_Count
                    Get Category_Index taRM_Schedules[iSchedule_Index].taCategory_IDs[iCategory_Loop] to iCategory_Index
                    Move taRM_Categories[iCategory_Index].tCategory to ;
                        tDialogInfo.taSchedules[iIndex].taCateogies[SizeOfArray(tDialogInfo.taSchedules[iIndex].taCateogies)]
                Loop
            End
        Loop

        Function_Return tDialogInfo
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Dialogs" Visibility=Internal
    Function DialogInfo_Schedule_Index tdSigCjCal_Schedule_Info[] taSchedules Integer iSchedule_ID Returns Integer
        Integer iCount iLoop iIndex

        Move -1 to iIndex
        Move (SizeOfArray(taSchedules) -1) to iCount
        For iLoop from 0 to iCount
            If (taSchedules[iLoop].iID = iSchedule_ID) Begin
                Move iLoop to iIndex
                Move (iCount + 1) to iLoop  //bomb loop
            End
        Loop

        Function_Return iIndex
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Dialogs" Visibility=Internal
    Procedure EditEventDialog
        Boolean bOK bException
        Integer eEditSeries
        Handle  hoEvent hoDataProvider hoCustomIcons hoCustomProperties
        Handle  vEvent vCustomIcons vCustomProperties
        tdSigCjCal_HitTestInfo          tHitTestInfo
        tdSigCjCal_Dialog_COM_Objects   tDialog_COM_Ojects
        tdSigCjCal_Dialog_Info          tDialog_Info

        If (phoDialog_EditEvent(Self) > 0) Begin
            Move False to bException
            Get Dialog_Info          to tDialog_Info
            Get ptDialog_COM_Objects to tDialog_COM_Ojects
            Get Internal_phoEvent    to hoEvent
            
            Move True to bOK
            If (tDialog_Info.tEvent.eRecurr_State <> OLExtpCalendarRecurrenceNotRecurring) Begin
                Get OnAskEditSeries to eEditSeries
                If (eEditSeries <> eCal_Series_Abort) Begin
                    If (eEditSeries = eCal_Series_Single) Begin
                        //Clone event and reset tDialog Info 
                        Set pvComObject of hoEvent to tDialog_COM_Ojects.vEvent
                        Get ComCloneEvent of hoEvent to vEvent
                        Send ComMakeAsRException of hoEvent
                        
                        Get Populate_tdSigCj_Event_From_Object vEvent to tDialog_Info.tEvent
                        Move vEvent to tDialog_COM_Ojects.vEvent
                    End
                    Else Begin
                        //reset Info to Master Event
                        Get Populate_tdSigCj_Event_From_Object tDialog_COM_Ojects.vMasterEvent to tDialog_Info.tEvent
                        Move tDialog_COM_Ojects.vMasterEvent to tDialog_COM_Ojects.vEvent
                    End
                End
                Else Begin
                    Move False to bOK
                End
            End

            If (bOK) Begin            
                Move (psUserID(Self)) to tDialog_Info.tEvent.sLastMod_By
                Get OnEditEventDialog tDialog_Info to tDialog_Info

                If (tDialog_Info.eAction_Event <> eCal_Dialog_Action_None) Begin
                    If (tDialog_Info.tDialog_DB_Link.eAction <> eCal_Dialog_Action_None) Begin
                        Move tDialog_Info.tDialog_DB_Link.tDB_Link.bDB_Link to tDialog_Info.tEvent.bDB_Link
                        Move tDialog_Info.tDialog_DB_Link.tDB_Link.sTable   to tDialog_Info.tEvent.sDB_Table
                        Move tDialog_Info.tDialog_DB_Link.tDB_Link.sKey     to tDialog_Info.tEvent.sDB_Key
                    End
                    Send UpdateEventObject tDialog_COM_Ojects.vEvent tDialog_Info.tEvent bException
                    Get Internal_phoEvent to hoEvent

                    If (tDialog_Info.tDialog_RecPattern.eAction <> eCal_Dialog_Action_None) Begin
                        Get ComRecurrencePattern of hoEvent to tDialog_COM_Ojects.vRecPattern
                        If (IsNullComObject(tDialog_COM_Ojects.vRecPattern)) Begin
                            Get ComCreateRecurrence of hoEvent to tDialog_COM_Ojects.vRecPattern
                        End
                        Send UpdateRecPatternObject tDialog_COM_Ojects.vRecPattern tDialog_Info.tDialog_RecPattern.tRecPattern
                        Send ComUpdateRecurrence of hoEvent tDialog_COM_Ojects.vRecPattern
                    End

                    If (tDialog_Info.tDialog_RecPattern.eAction = eCal_Dialog_Action_Create) Begin
                        Get OnCreateRecPattern tDialog_Info.tDialog_RecPattern.tRecPattern to tDialog_Info.tEvent.iRec_Pattern_id
                    End
                    If (tDialog_Info.tDialog_RecPattern.eAction = eCal_Dialog_Action_Edit) Begin
                        Get OnUpdateRecPattern tDialog_Info.tDialog_RecPattern.tRecPattern to bOK
                    End

                    If (tDialog_Info.tDialog_CustomIcon.eAction <> eCal_Dialog_Action_None) Begin
                        Get Internal_phoCustomIcons to hoCustomIcons
                        Send Update_CustomIcons hoCustomIcons tDialog_Info.tDialog_CustomIcon
                    End

                    If (tDialog_Info.tDialog_CustomProperty.eAction <> eCal_Dialog_Action_None) Begin
                        Get Internal_phoCustomProperties to hoCustomProperties

                        //Force removal of existing properties
                        Move True to tDialog_Info.tDialog_CustomProperty.bRemoveExisting
                        Send Update_CustomProperty hoCustomProperties tDialog_Info.tDialog_CustomProperty
                    End

                    Send Notify_Event_Changed hoEvent
                End
            End 

        End //Custom Dialog
        Else Begin
            Get ptHitTestInfo to tHitTestInfo
            Get ComShowEditEvent of (Internal_phoCalendarDialogs(Self)) tHitTestInfo.vEvent to bOK
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Support Methods" Visibility=Internal
    Procedure Enable_Draw_Events
        Handle  hoFlags
        Variant vFlags

        Get Create U_cSigCjComCalendarFlagsSet to hoFlags
            Get ComBeforeDrawThemeObjectFlags to vFlags
            Set pvComObject of hoFlags to vFlags

            Send ComSetFlag of hoFlags (OLExtpCalendarBeforeDraw_DayViewCell + ;
                                        OLExtpCalendarBeforeDraw_WeekViewDay + ;
                                        OLExtpCalendarBeforeDraw_MonthViewDay)
        Send Destroy of hoFlags
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Schedules" Visibility=Public
    Procedure Enable_Resource Integer iLayout_ID Integer iResource_ID Boolean bEnabled
        Integer iLayout_Index iResource_Index
        Handle  hoResourceDescription  hoResourceManager
        tdSigCjCal_RM_Layout[] taRM_Layouts

        Get Layout_Index iLayout_ID to iLayout_Index
        If (iLayout_Index <> -1) Begin
            Get Resource_Index iResource_ID True to iResource_Index
            If (iResource_Index <> -1) Begin
                Get ptaRM_Layouts to taRM_Layouts
                    Move bEnabled to taRM_Layouts[iLayout_Index].taRM_Resources[iResource_Index].bEnabled
                Set ptaRM_Layouts to taRM_Layouts

                //If current layout set COM object
                If (iLayout_ID = (piCurrent_Layout_ID(Self))) Begin
                    Get Internal_phoResourceDescription to hoResourceDescription
                    Set pvComObject of hoResourceDescription to taRM_Layouts[iLayout_Index].taRM_Resources[iResource_Index].vResourceDescription
                    Set ComEnabled of hoResourceDescription to bEnabled

                    Get Internal_phoResourceManager to hoResourceManager
                    Send ComApplyToCalendar of hoResourceManager (pvComObject(Self))
                    Send Force_Redraw
                End
            End
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Icons" Visibility=Internal
    Procedure Enable_Standard_Icons Handle hoThemeOffice07
        Boolean bException bMeeting bPrivate bRecurrence bReminder
        Integer iView ismDay
        Handle hoView hoEvent hoIcons hoDay hoGroup hoSM_Day hoFormula
        Variant vIconsToDraw vView vEvent vIcons vTheme vDay vSM_Day vGroup vFormula

        Get pbIconEnabled_Exception  to bException
        Get pbIconEnabled_Meeting    to bMeeting
        Get pbIconEnabled_Private    to bPrivate
        Get pbIconEnabled_Recurrence to bRecurrence
        Get pbIconEnabled_Reminder   to bReminder

        For iView from 1 to 3
            Get View_Object iView hoThemeOffice07 to hoView

            Get comEvent of hoView to vEvent
            Get ViewEvent_Object iView vEvent to hoEvent
                Get ComEventIconsToDraw of hoEvent to vIcons
                Get Create U_cSigCjComCalendarThemeEventIconsToDraw to hoIcons
                    Set pvComObject of hoIcons to vIcons

                    Set ComShowException  of hoIcons to bException
                    Set ComShowMeeting    of hoIcons to bMeeting
                    Set ComShowOccurrence of hoIcons to bPrivate
                    Set ComShowPrivate    of hoIcons to bRecurrence
                    Set ComShowReminder   of hoIcons to bReminder
                Send Destroy of hoIcons

                Get ComHeightFormula of hoEvent to vFormula
                Get Create U_cSigCjComCalendarThemeFormulaMulDivC to hoFormula
                    Set pvComObject of hoFormula to vFormula

                    Set ComConstant of hoFormula to 5
                Send Destroy of hoFormula
            Send Destroy of hoEvent

            Get ComDay of hoView to vDay
            Get ViewDay_Object iView vDAy to hoDay
                If (iView = 1) Begin
                    Get ComGroup of hoDay to vGroup
                    Get Create U_cSigCjComCalendarThemeOffice2007DayViewDayGroup to hoGroup
                    Set pvComObject of hoGroup to vGroup
                End
                Else Move hoDay to hoGroup

                For ismDay from 1 to 2
                    If (ismDay = 1) Begin
                        Get ComSingleDayEvent of hoGroup to vSM_Day
                        Get Create U_cSigCjComCalendarThemeOffice2007DayViewEventSingleDay to hoSM_Day
                    End
                    If (ismDay = 2) Begin
                        Get ComMultiDayEvent of hoGroup to vSM_Day
                        Get Create U_cSigCjComCalendarThemeOffice2007DayViewEventMultiDay to hoSM_Day
                    End
                    Set pvComObject of hoSM_Day to vSM_Day

                    Get ComEventIconsToDraw of hoSM_Day to vIcons
                    Get Create U_cSigCjComCalendarThemeEventIconsToDraw to hoIcons
                        Set pvComObject of hoIcons to vIcons

                        Set ComShowException  of hoIcons to bException
                        Set ComShowMeeting    of hoIcons to bMeeting
                        Set ComShowOccurrence of hoIcons to bPrivate
                        Set ComShowPrivate    of hoIcons to bRecurrence
                        Set ComShowReminder   of hoIcons to bReminder
                    Send Destroy of hoIcons
                    Send Destroy of hoSM_Day
                Loop

                If (iView = 1) Send Destroy of hoGroup

            Send Destroy of hoDay
            Send Destroy of hoView
        Loop

        Send ComRefreshMetrics of hoThemeOffice07
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Support Methods" Visibility=Internal
    Function Event_Object Integer iDataProvider_ID Integer iEvent_ID Returns Variant
        Handle  hoDataProvider
        Variant vEvent vDataProvider

        Get Internal_phoDataProvider to hoDataProvider
        Get DataProvider_Object iDataProvider_ID to vDataProvider
        Set pvComObject of hoDataProvider to vDataProvider
        Get ComGetEvent of hoDataProvider iEvent_ID to vEvent

        Function_Return vEvent
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Support Methods" Visibility=Internal
    Procedure Find_Day_Theme_Objects Handle hoThemeOffice07
        Handle hoDayView hoDay hoGroup hoCell hoWorkCell hoNonWorkCell
        Variant vDayView  vDay  vGroup  vCell  vWorkCell  vNonWorkCell

        Get Internal_phoWorkingCellColors    to hoWorkCell
        Get Internal_phoNonWorkingCellColors to hoNonWorkCell

        Get ComDayView of hoThemeOffice07 to vDayView
        Get Create U_cSigCjComCalendarThemeOffice2007DayView to hoDayView
            Set pvComObject of hoDayView to vDayView

            Get ComDay of hoDayView to vDay
            Get Create U_cSigCjComCalendarThemeOffice2007DayViewDay to hoDay
                Set pvComObject of hoDay to vDay

                Get ComGroup of hoDay to vGroup
                Get Create U_cSigCjComCalendarThemeOffice2007DayViewDayGroup to hoGroup
                    Set pvComObject of hoGroup to vGroup

                    Get ComCell of hoGroup to vCell
                    Get Create U_cSigCjComCalendarThemeDayViewCell to hoCell
                        Set pvComObject of hoCell to vCell

                        Get ComWorkCell of hoCell to vWorkCell
                        Set pvComObject of hoWorkCell to vWorkCell

                        Get ComNonWorkCell of hoCell to vNonWorkCell
                        Set pvComObject of hoNonWorkCell to vNonWorkCell

                        //We do not destroy the Non/WorkingCell objects

                    Send Destroy of hoCell
                Send Destroy of hoGroup
            Send Destroy of hoDay
        Send Destroy of hoDayView
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Support Methods" Visibility=Public
    Procedure Force_Data_Refresh Integer iDataProvider_ID
        Handle  hoDataProvider
        Variant vDataProvider

        Get DataProvider_Object iDataProvider_ID to vDataProvider

        If (not(IsNullComObject(vDataProvider))) Begin
            Get Internal_phoDataProvider to hoDataProvider
            Set pvComObject of hoDataProvider to vDataProvider

            Send ComRemoveAllEvents of hoDataProvider
            Send ComPopulate
            Send ComRedrawControl

            Set pdtLastRefresh to (CurrentDateTime())
        End
    End_Procedure

    //-------------------------------------------------------------------------
    //The ComRedrawControl message does not appear to work!. The only way to
    //ensure that a redraw happens is to ask the control to re-populate.
    //This method has been created to make the intension of calls to
    //ComPopulate unambiguous.
    //   +  When the control needs to be told to re-populate ComPopulate is
    //      called directly.
    //   +  When a redraw is required this method is called.

    // Category="SigCj:Support Methods" Visibility=Private
    Procedure Force_Redraw
        Send ComPopulate
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Support Methods" Visibility=Internal
    Function From_CJ_Margin Number nValue Returns Number
        If (Internal_pbMarginsMeasureMetrics(Self) = True) Function_Return (nValue / 100)
        Else                                              Function_Return (nValue / 1000)
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Support Methods" Visibility=Internal
    Function Hit_Code_Day Integer iCode Returns Integer
        Integer eHitItem

        Case Begin
            //eCal_Hit_DayArea
            Case ((iCode iand OLExtpCalendarHitTestGroupArea) and ;
                  (iCode iand OLExtpCalendarHitTestDayViewCell))
                Move eCal_Hit_DayArea to eHitItem
            Case Break

            //eCal_Hit_AllDayArea
            Case ((iCode iand OLExtpCalendarHitTestGroupArea) and ;
                  (iCode iand OLExtpCalendarHitTestDayViewAllDayEvent))
                Move eCal_Hit_AllDayArea to eHitItem
            Case Break

            //eCal_Hit_Event
            Case ((iCode iand OLExtpCalendarHitTestEventTextArea) and ;
                  (iCode iand OLExtpCalendarHitTestDayViewCell))
                Move eCal_Hit_Event to eHitItem
            Case Break

            //eCal_Hit_AllDayEvent
            Case ((iCode iand OLExtpCalendarHitTestEventTextArea) and ;
                  (iCode iand OLExtpCalendarHitTestDayViewAllDayEvent))
                Move eCal_Hit_AllDayEvent to eHitItem
            Case Break

            //eCal_Hit_DayHeader
            Case (iCode iand OLExtpCalendarHitTestDayHeader)
                Move eCal_Hit_DayHeader to eHitItem
            Case Break

            //eCal_Hit_ResourceHeader
            Case (iCode iand OLExtpCalendarHitTestGroupHeader)
                Move eCal_Hit_ResourceHeader to eHitItem
            Case Break

            //eCal_Hit_TimeScale
            Case (iCode iand OLExtpCalendarHitTestDayViewTimeScale)
                Move eCal_Hit_TimeScale to eHitItem
            Case Break

            Case Else
                Move eCal_Hit_Unknown to eHitItem
        Case End

        Function_Return eHitItem
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Support Methods" Visibility=Internal
    Function Hit_Code_Week Integer iCode Returns Integer
        Integer eHitItem

        Case Begin
            //eCal_Hit_DayArea
            Case (iCode iand OLExtpCalendarHitTestGroupArea)
                Move eCal_Hit_DayArea to eHitItem
            Case Break

            //eCal_Hit_DayHeader
            Case (iCode iand OLExtpCalendarHitTestDayHeader)
                Move eCal_Hit_DayHeader to eHitItem
            Case Break

            //eCal_Hit_Event
            Case (iCode iand OLExtpCalendarHitTestEventTextArea)
                Move eCal_Hit_Event to eHitItem
            Case Break

            //eCal_Hit_Event
            Case (iCode iand OLExtpCalendarHitTestEventDragArea)
                Move eCal_Hit_Event to eHitItem
            Case Break

            Case Else
                Move eCal_Hit_Unknown to eHitItem
        Case End

        Function_Return eHitItem
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Support Methods" Visibility=Internal
    Function Hit_Code_Month Integer iCode Returns Integer
        Integer eHitItem

        Case Begin
            //eCal_Hit_DayArea
            Case (iCode iand OLExtpCalendarHitTestGroupArea)
                Move eCal_Hit_DayArea to eHitItem
            Case Break

            //eCal_Hit_DayHeader
            Case (iCode iand OLExtpCalendarHitTestDayHeader)
                Move eCal_Hit_DayHeader to eHitItem
            Case Break

            //eCal_Hit_Event
            Case (iCode iand OLExtpCalendarHitTestEventTextArea)
                Move eCal_Hit_Event to eHitItem
            Case Break

            Case Else
                Move eCal_Hit_Unknown to eHitItem
        Case End

        Function_Return eHitItem
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Support Methods" Visibility=Internal
    Function HitTestInfo Returns tdSigCjCal_HitTestInfo
        Boolean  bSelected
        Handle   hoActiveView hoEvent hoHitTest hoResource hoResources hoScheduleIDs 
        Variant   vActiveView  vEvent  vHitTest  vResource  vResources  vScheduleIDs  
        Handle   hoViewSelection hoViewEvent hoViewGroup 
        Variant   vViewSelection  vViewEvent
        Handle   hoCustomProperties hoCustomIcons hoRecPattern hoViewEvents
        Variant   vCustomProperties  vCustomIcons  vRecPattern  vViewEvents
        DateTime dtHitDateTime dtWork
        Integer  iCount iLoop iSchedule_ID iRecState iIcon_ID iDB_Link_Icon_ID eCurrentView
        Integer  iLayout_Index  iSchedule_Index iDataProvider_Index
        tdSigCjCal_HitTestInfo       tHitTestInfo
        tdSigCjCal_RM_DataProvider[] taRM_DataProviders
        tdSigCjCal_RM_Layout[]       taRM_Layouts

        Get ptaRM_DataProviders to taRM_DataProviders
        Get ptaRM_Layouts       to taRM_Layouts

        Get Internal_phoActivteView   to hoActiveView
        Get Internal_phoHitTestInfo   to hoHitTest
        Get Internal_phoViewSelection to hoViewSelection

        Get ComActiveView to vActiveView
        Set pvComObject of hoActiveView to vActiveView

        Get ComHitTest of hoActiveView to vHitTest
        Set pvComObject of hoHitTest to vHitTest

        Get ComViewType to tHitTestInfo.eViewType_CJ
        If (tHitTestInfo.eViewType_CJ = OLExtpCalendarDayView     ) Move eCal_ViewType_Day      to tHitTestInfo.eViewType
        If (tHitTestInfo.eViewType_CJ = OLExtpCalendarWorkWeekView) Move eCal_ViewType_Day      to tHitTestInfo.eViewType
        If (tHitTestInfo.eViewType_CJ = OLExtpCalendarWeekView    ) Move eCal_ViewType_Week     to tHitTestInfo.eViewType
        If (tHitTestInfo.eViewType_CJ = OLExtpCalendarMonthView   ) Move eCal_ViewType_Month    to tHitTestInfo.eViewType
        If (tHitTestInfo.eViewType_CJ = OLExtpCalendarFullWeekView) Move eCal_ViewType_Day      to tHitTestInfo.eViewType
        If (tHitTestInfo.eViewType_CJ = OLExtpCalendarTimeLineView) Move eCal_ViewType_TimeLine to tHitTestInfo.eViewType

        Get ComHitCode       of hoHitTest to tHitTestInfo.iCode
        Get ComHitDateTime   of hoHitTest to tHitTestInfo.dtDateTime
        Get ComTimePartValid of hoHitTest to tHitTestInfo.bDataTimeValid
        Get ComViewDay       of hoHitTest to tHitTestInfo.vViewDay
        Get ComViewEvent     of hoHitTest to tHitTestInfo.vViewEvent
        Get ComViewGroup     of hoHitTest to tHitTestInfo.vViewGroup

        //Current Selected cells
        Get ComSelection of hoActiveView to vViewSelection
        Set pvComObject   of hoViewSelection to vViewSelection
        Get ComAllDay     of hoViewSelection to tHitTestInfo.bSel_AllDay
        Get ComBegin      of hoViewSelection to tHitTestInfo.dtSel_Begin
        Get ComEnd        of hoViewSelection to tHitTestInfo.dtSel_End
        Get ComGroupIndex of hoViewSelection to tHitTestInfo.iSel_GroupIndex
        Get ComIsValid    of hoViewSelection to tHitTestInfo.bSel_IsValid

        //Need to check start and end times - start can be greater than end if 
        //the user drags up when selecting a range of cells. The built in 
        //dialogs handle this automatically, but to make things easy for custom 
        //dialogs we will swop the value here if necessary.
        If (tHitTestInfo.dtSel_Begin > tHitTestInfo.dtSel_End ) Begin
            Move tHitTestInfo.dtSel_Begin to dtWork
            Move tHitTestInfo.dtSel_End   to tHitTestInfo.dtSel_Begin
            Move dtWork                   to tHitTestInfo.dtSel_End
        End

        //What was clicked
        Case Begin
            Case (tHitTestInfo.eViewType = eCal_ViewType_Day)
                Get Hit_Code_Day tHitTestInfo.iCode to tHitTestInfo.eHitItem
            Case Break

            Case (tHitTestInfo.eViewType = eCal_ViewType_Week)
                Get Hit_Code_Week tHitTestInfo.iCode to tHitTestInfo.eHitItem
            Case Break

            Case (tHitTestInfo.eViewType = eCal_ViewType_Month)
                Get Hit_Code_Month tHitTestInfo.iCode to tHitTestInfo.eHitItem
            Case Break

            Case Else
                Move eCal_Hit_Unknown to tHitTestInfo.eHitItem
        Case End

        //Resource / Schedule Info
        If (not(IsNullComObject(tHitTestInfo.vViewGroup))) Begin
            Get Internal_phoResource to hoResource
            Get Internal_phoResources to hoResources
            Get Internal_phoScheduleIDs to hoScheduleIDs
            Get Internal_phoViewGroup to hoViewGroup

            Set pvComObject of hoViewGroup to tHitTestInfo.vViewGroup

            If (Internal_pbEnableResources(Self)) Begin
                //Layout Info
                Move (piCurrent_Layout_ID(Self)) to tHitTestInfo.iLayout_ID
                Get Layout_Index tHitTestInfo.iLayout_ID to iLayout_Index
                Move taRM_Layouts[iLayout_Index].tLayout.sName to tHitTestInfo.sLayout_Name
    
                //Resource Info
                Get ComGroupIndex of hoViewGroup to tHitTestInfo.iGroupIndex
                Move taRM_Layouts[iLayout_Index].taRM_Resources[tHitTestInfo.iGroupIndex].tResource.iID   to tHitTestInfo.iResource_ID
                Move taRM_Layouts[iLayout_Index].taRM_Resources[tHitTestInfo.iGroupIndex].tResource.sName to tHitTestInfo.sResource_Name
    
                Get ComMultipleResources of hoViewGroup to vResources
                Set pvComObject of hoResources to vResources
                Get ComItem of hoResources 0 to vResource
    
                //Schedule Info
                Set pvComObject of hoResource to vResource
                Get ComScheduleIDs of hoResource to vScheduleIDs
                Set pvComObject of hoScheduleIDs to vScheduleIDs
    
                //Data Provider
                Move taRM_Layouts[iLayout_Index].taRM_Resources[tHitTestInfo.iGroupIndex].iDataProvider_ID to tHitTestInfo.iDataProvider_ID
                Get DataProvider_Index tHitTestInfo.iDataProvider_ID to iDataProvider_Index
                Move taRM_DataProviders[iDataProvider_Index].vDataProvider to tHitTestInfo.vDataProvider
            End
            Else Begin
                Move taRM_DataProviders[0].tDataProvider.iID to tHitTestInfo.iDataProvider_ID
                Move taRM_DataProviders[0].vDataProvider     to tHitTestInfo.vDataProvider
            End
        End

        //Event
        If (not(IsNullComObject(tHitTestInfo.vViewEvent))) Begin
            Get Internal_phoViewEvent to hoViewEvent
            Set pvComObject of hoViewEvent to tHitTestInfo.vViewEvent
            Get ComEvent of hoViewEvent to tHitTestInfo.vEvent

            Get Internal_phoEvent to hoEvent
            Set pvComObject of hoEvent to tHitTestInfo.vEvent
            Get ComId of hoEvent to tHitTestInfo.iEvent_ID

            Get ComRecurrenceState of hoEvent to iRecState
            Move (iRecState =  OLExtpCalendarRecurrenceException   ) to tHitTestInfo.bException
            Move (iRecState <> OLExtpCalendarRecurrenceNotRecurring) to tHitTestInfo.bRecurring
            If (tHitTestInfo.bRecurring) Begin
                Get Internal_phoRecPattern to hoRecPattern
                Get ComRecurrencePattern of hoEvent to vRecPattern
                Set pvComObject of hoRecPattern to vRecPattern
                Get ComMasterEventId of hoRecPattern to tHitTestInfo.iEvent_Master_ID
                Get ComID            of hoRecPattern to tHitTestInfo.iRecPattern_ID
            End

            Get DB_Link_Info tHitTestInfo.vEvent to tHitTestInfo.tDB_Link

            //Has custom properties
            Get Internal_phoCustomProperties to hoCustomProperties
            Get ComCustomProperties of hoEvent to vCustomProperties
            Set pvComObject of hoCustomProperties to vCustomProperties
            Get ComCount of hoCustomProperties to iCount
            Move (((iCount > 3) and tHitTestInfo.tDB_Link.bDB_Link) or ;
                  ((iCount > 0) and not(tHitTestInfo.tDB_Link.bDB_Link))) to tHitTestInfo.bHasCustomProperties
            
            //Has custom Icons
            Get piIconID_DB_Link to iDB_Link_Icon_ID
            Get Internal_phoCustomIcons to hoCustomIcons
            Get ComCustomIcons of hoEvent to vCustomIcons
            Set pvComObject of hoCustomIcons to vCustomIcons
            Get ComCount of hoCustomIcons to iCount
            Move 0 to iLoop
            While ((iLoop < iCount) and not(tHitTestInfo.bHasCustomIcons))
                Get ComItem of hoCustomIcons iLoop to iIcon_ID
                If ((iIcon_ID > 0) and (iIcon_ID <> iDB_Link_Icon_ID)) Move True to tHitTestInfo.bHasCustomIcons
                Increment iLoop
            Loop

            Move True to tHitTestInfo.bEventClicked

            Get ComGetSelectedEvents of hoActiveView to vViewEvents
            Get Internal_phoViewEvents to hoViewEvents
            Set pvComObject of hoViewEvents to vViewEvents

            Get ComCount of hoViewEvents to tHitTestInfo.iSelected_Count
            If (tHitTestInfo.iSelected_Count > 1) Begin
                Move (tHitTestInfo.iSelected_Count - 1) to iCount
                For iLoop from 0 to iCount
                    Get ComViewEvent of hoViewEvents iLoop to vViewEvent
                    Set pvComObject of hoViewEvent to vViewEvent
                    Get ComSelected of hoViewEvent to bSelected
                    If (bSelected) Begin
                        Get ComEvent of hoViewEvent to vEvent
                        Set pvComObject of hoEvent to vEvent
                        Get ComId of hoEvent to tHitTestInfo.iaEvent_IDs[(SizeOfArray(tHitTestInfo.iaEvent_IDs))]
                    End
                Loop
            End
        End
        Else Begin
            Move (NullComObject()) to tHitTestInfo.vEvent
            Move -1                to tHitTestInfo.iEvent_ID
            Move -1                to tHitTestInfo.iEvent_Master_ID
            Move False             to tHitTestInfo.bEventClicked
            Move False             to tHitTestInfo.bException
            Move False             to tHitTestInfo.bRecurring
            Move False             to tHitTestInfo.tDB_Link.bDB_Link
        End

        Get ComCanCut   of hoActiveView to tHitTestInfo.bCanCut
        Get ComCanCopy  of hoActiveView to tHitTestInfo.bCanCopy
        Get ComCanPaste of hoActiveView to tHitTestInfo.bCanPaste

        Function_Return tHitTestInfo
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Support Methods" Visibility=Internal
    Procedure Internal_Set_Time_Scale String tmValue Boolean bMinTime
        DateTime dtWork
        Integer  iHour iMins
        Handle   hoDayView

        Get Internal_phoDayView to hoDayView
        If (hoDayView and IsComObjectCreated(hoDayView)) Begin
            //Have to get current value... Codejock issue and then set the hours 
            //and mins from integers... Dataflex issue. Fun working this lot out!!!!
            If (bMinTime) Begin
                Get ComTimeScaleMinTime of hoDayView to dtWork
            End
            Else Begin
                Get ComTimeScaleMaxTime of hoDayView to dtWork
            End
            Get SigCj_GetHours   tmValue to iHour
            Get SigCj_GetMinutes tmValue to iMins
            Move (DateSetHour  (dtWork, iHour)) to dtWork
            Move (DateSetMinute(dtWork, iMins)) to dtWork
            Move (DateSetSecond(dtWork,     1)) to dtWork

            #IFDEF IS$WIN64
                Move (DateSetDay  (dtWork, 1)) to dtWork
                Move (DateSetMonth(dtWork, 1)) to dtWork
                Move (DateSetYear (dtWork, 2000)) to dtWork
            #ENDIF 
            
            //Now we can set the time!!
            If (bMinTime) Begin
                Set ComTimeScaleMinTime of hoDayView to dtWork
            End
            Else Begin
                Set ComTimeScaleMaxTime of hoDayView to dtWork
            End
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Support Methods" Visibility=Private
    Function IsLastWeekDay Date dDate Returns Boolean
        Integer iDay iMask iLastDay

        Move (Mod(dDate,7)) to iDay //Saturday = 1 Friday = 0

        Get peWorkWeekMask to iMask
        If (iMask = eCal_WW_AllWeek ) Move 2 to iLastDay    //Assume Sunday is last day of week
        If (iMask = eCal_WW_SaSu    ) Move 2 to iLastDay
        If (iMask = eCal_WW_Mo_Fr   ) Move 0 to iLastDay
        If (iMask = 126             ) Move 1 to iLastDay

        Function_Return (iDay = iLastDay)
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Support Methods" Visibility=Private
    Function IsTimeBetween DateTime dtTime String sStartTime String sEndTime Returns Boolean
        Integer iWork iStart iEnd iTime
        String  sWork

        Move (Left(sStartTime,5)) to sStartTime //strip off seconds (if there)
        Move (Left(sEndTime,5)) to sEndTime     //strip off seconds (if there)

        Move (Replaces(":",sEndTime,  "")) to iEnd
        Move (Replaces(":",sStartTime,"")) to iStart

        Move (DateGetHour(dtTime)) to sWork
        Move (DateGetMinute(dtTime)) to iWork
        If (iWork < 10) Move (Append(sWork,"0")) to sWork
        Move (Append(sWork,String(iWork))) to iTime

        Function_Return ((iTime >= iStart) and (iTime < iEnd))
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Schedules" Visibility=Internal
    Function Layout_Index Integer iLayout_ID Returns Integer
        Integer iCount iLoop iIndex
        tdSigCjCal_RM_Layout[] taRM_Layouts

        Move -1 to iIndex
        Get ptaRM_Layouts to taRM_Layouts
        Move (SizeOfArray(taRM_Layouts) - 1) to iCount
        For iLoop from 0 to iCount
            If (taRM_Layouts[iLoop].tLayout.iID = iLayout_ID) Begin
                Move iLoop to iIndex
                Move (iCount + 1) to iLoop  //bomb loop
            End
        Loop

        If (iIndex = -1) Begin
            Error 501 ("Cannot find Layout (ID: " + String(iLayout_ID) + ")")
        End

        Function_Return iIndex
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Icons" Visibility=Public
    Procedure Load_Icon Integer iIcon_ID String sIconFileName
        Integer iIndex
        String sBitmapPath
        tdSigCjCal_CustomIcon[] tCustomIcons

        If (not(IsFileNameQualified(sIconFileName))) Begin
            Get psBitmapPath of (phoWorkspace(ghoApplication)) to sBitmapPath
            Move (sBitmapPath + "\" + sIconFileName) to sIconFileName
        End
        Send ComLoadIcon of (Internal_phoImageManagerIcons(Self)) sIconFileName iIcon_ID OLExtpImageNormal

        Get ptaCustomIcons to tCustomIcons
            Move (SizeOfArray(tCustomIcons)) to iIndex
            Move iIcon_ID      to tCustomIcons[iIndex].iId
            Move sIconFileName to tCustomIcons[iIndex].sFileName
        Set ptaCustomIcons to tCustomIcons
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Icons" Visibility=Internal
    Procedure Load_Standard_Icons
        Handle hoImageManagerIcons
        String sBitmapPath

        Get Internal_phoImageManagerIcons to hoImageManagerIcons

        Get psBitmapPath of (phoWorkspace(ghoApplication)) to sBitmapPath
        Move (sBitmapPath + "\") to sBitmapPath

        If (pbIconEnabled_DB_Link   (Self)) Send ComLoadIcon of hoImageManagerIcons (sBitmapPath + psIcon_DB_Link   (Self)) (piIconID_DB_Link(Self))            OLExtpImageNormal
        If (pbIconEnabled_Exception (Self)) Send ComLoadIcon of hoImageManagerIcons (sBitmapPath + psIcon_Exception (Self)) OLExtpCalendarEventIconIDException  OLExtpImageNormal
        If (pbIconEnabled_Meeting   (Self)) Send ComLoadIcon of hoImageManagerIcons (sBitmapPath + psIcon_Meeting   (Self)) OLExtpCalendarEventIconIDMeeting    OLExtpImageNormal
        If (pbIconEnabled_Private   (Self)) Send ComLoadIcon of hoImageManagerIcons (sBitmapPath + psIcon_Private   (Self)) OLExtpCalendarEventIconIDPrivate    OLExtpImageNormal
        If (pbIconEnabled_Recurrence(Self)) Send ComLoadIcon of hoImageManagerIcons (sBitmapPath + psIcon_Recurrence(Self)) OLExtpCalendarEventIconIDOccurrence OLExtpImageNormal
        If (pbIconEnabled_Reminder  (Self)) Send ComLoadIcon of hoImageManagerIcons (sBitmapPath + psIcon_Reminder  (Self)) OLExtpCalendarEventIconIDReminder   OLExtpImageNormal
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Dialogs" Visibility=Internal
    Procedure NewEventDialog DateTime dtWhen
        Boolean bOK
        Date dWhen
        Handle hoDataProvider hoEvent hoCustomIcons hoCustomProperties
        Variant vEvent vCustomIcons vCustomProperties
        tdSigCjCal_Dialog_Info          tDialog_Info
        tdSigCjCal_Dialog_COM_Objects   tDialog_COM_Ojects

        Move (Date(dtWhen)) to dWhen
        Get SpecialDate_Create_Allowed dWhen to bOK
        If (bOK) Begin
            If (phoDialog_EditEvent(Self) > 0) Begin
                Get Dialog_Info to tDialog_Info
                Move (psUserID(Self)) to tDialog_Info.tEvent.sCreatedBy
                Get OnNewEventDialog   tDialog_Info to tDialog_Info

                If (tDialog_Info.eAction_Event <> eCal_Dialog_Action_None) Begin
                    Get ptDialog_COM_Objects to tDialog_COM_Ojects
                    Get Internal_phoDataProvider to hoDataProvider
                    Set pvComObject of hoDataProvider to tDialog_COM_Ojects.vDataProvider
                    
                    If (tDialog_Info.tEvent.iRec_Pattern_id <> -1) Begin
                        If (tDialog_Info.tDialog_DB_Link.eAction <> eCal_Dialog_Action_None) Begin
                            Move tDialog_Info.tDialog_DB_Link.tDB_Link.bDB_Link to tDialog_Info.tEvent.bDB_Link
                            Move tDialog_Info.tDialog_DB_Link.tDB_Link.sTable   to tDialog_Info.tEvent.sDB_Table
                            Move tDialog_Info.tDialog_DB_Link.tDB_Link.sKey     to tDialog_Info.tEvent.sDB_Key
                        End

                        Get ComCreateEvent of hoDataProvider to vEvent
                        Send ComAddEvent of hoDataProvider vEvent
                        Send UpdateEventObject vEvent tDialog_Info.tEvent False
                        Get Internal_phoEvent to hoEvent
                        
                        If (tDialog_Info.tDialog_RecPattern.eAction <> eCal_Dialog_Action_None) Begin
                            Get ComCreateRecurrence of hoEvent to tDialog_COM_Ojects.vRecPattern
                            Send UpdateRecPatternObject tDialog_COM_Ojects.vRecPattern tDialog_Info.tDialog_RecPattern.tRecPattern
                            Send ComUpdateRecurrence of hoEvent tDialog_COM_Ojects.vRecPattern
                        End

                        If (tDialog_Info.tDialog_CustomIcon.eAction <> eCal_Dialog_Action_None) Begin
                            Get Internal_phoCustomIcons to hoCustomIcons
                            Send Update_CustomIcons hoCustomIcons tDialog_Info.tDialog_CustomIcon
                        End

                        If (tDialog_Info.tDialog_CustomProperty.eAction <> eCal_Dialog_Action_None) Begin
                            Get Internal_phoCustomProperties to hoCustomProperties
                            Send Update_CustomProperty hoCustomProperties tDialog_Info.tDialog_CustomProperty
                        End

                        Send Notify_Event_Changed hoEvent
//                        Send ComPopulate
                    End
                    Else Begin
                        Error 501 "Failed to create Recurrence pattern. Event NOT create"
                    End
                End
            End
            Else Begin
                Get ComShowNewEvent of (Internal_phoCalendarDialogs(Self)) to bOK
            End
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Support Methods" Visibility=Internal
    Procedure Notify_Event_Changed Handle hoEvent
        Handle  hoDataProvider 
        Variant vDataProvider  

        Get Internal_phoDataProvider to hoDataProvider
        Get ComDataProvider of hoEvent to vDataProvider
        Set pvComObject of hoDataProvider to vDataProvider
        Send ComChangeEvent of hoDataProvider (pvComObject(hoEvent))
        //Send ComPopulate
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Support Methods" Visibility=Internal
    Function Populate_tdSigCj_Event_From_Object Variant vEvent Returns tdSigCjCal_Event
        Boolean bMultiSchedules
        Handle  hoEvent hoRecPattern hoCategories hoCustomIcons hoCustomProperties
        Variant          vRecPattern  vCategories  vCustomIcons  vCustomProperties
        Integer iCount iLoop
        DateTime dtWork
        tdSigCjCal_Event tEvent

        Get Internal_phoEvent                to hoEvent
        Get Internal_phoRecPattern           to hoRecPattern
        Get Internal_phoEventCategoriesIDs   to hoCategories
        Get Internal_phoCustomIcons          to hoCustomIcons
        Get Internal_phoCustomProperties     to hoCustomProperties

        Set pvComObject of hoEvent to vEvent

        Get ComId                           of hoEvent to tEvent.iID
        Get ComAllDayEvent                  of hoEvent to tEvent.bAllDayEvent
        Get ComBody                         of hoEvent to tEvent.sBody
        Get ComBusyStatus                   of hoEvent to tEvent.eBusyStatus
        Get ComImportance                   of hoEvent to tEvent.eImportance
        Get ComLabel                        of hoEvent to tEvent.sLabel
        Get ComLocation                     of hoEvent to tEvent.sLocation
        Get ComMeetingFlag                  of hoEvent to tEvent.bMeetingFlag
        Get ComPrivateFlag                  of hoEvent to tEvent.bPrivateFlag
        Get ComRecurrenceState              of hoEvent to tEvent.eRecurr_State
        Get ComReminder                     of hoEvent to tEvent.bReminder
        Get ComReminderMinutesBeforeStart   of hoEvent to tEvent.iRem_MinsBefore
        Get ComReminderSoundFile            of hoEvent to tEvent.sRem_SoundFile
        Get ComScheduleID                   of hoEvent to tEvent.iScheduleID
        Get ComSubject                      of hoEvent to tEvent.sSubject
#IF (SigCj_Codejock_Version < 240000)  
        Get ComRExceptionDeleted            of hoEvent to tEvent.bRE_Deleted
#ENDIF
        Get ComMultipleSchedules            of hoEvent to tEvent.sScheduleIDs
        Get ComScheduleID                   of hoEvent to tEvent.iScheduleID

        Get ComRecurrencePattern of hoEvent to vRecPattern
        If (IsNullComObject(vRecPattern)) Begin
            Move 0 to tEvent.iRec_Pattern_id
        End
        Else Begin
            Set pvComObject of hoRecPattern to vRecPattern

            Get ComID of hoRecPattern to tEvent.iRec_Pattern_id
        End

        Get ComStartTime of hoEvent to dtWork
        Move dtWork to tEvent.dStartDate
        Get DateTime_to_Time dtWork to tEvent.tmStartTime

        Get ComEndTime of hoEvent to dtWork
        If (IsDateValid(dtWork)) Begin
            //If no end date has been specified Codejock sets the date to 01/01/9999
            //This is invalid for VDF so check and adjust to the VDF max date if necessary
            If (DateGetYear(dtWork) > 2500) Begin
                Move (DateSetYear(dtWork, 2500)) to dtWork
            End
            Move dtWork to tEvent.dEndDate
        End

        Get DateTime_to_Time dtWork to tEvent.tmEndTime

        Get ComCreationTime of hoEvent to dtWork
        Move dtWork to tEvent.dCreationDate
        Get DateTime_to_Time dtWork to tEvent.tmCreationTime

        Get ComLastModificationTime of hoEvent to dtWork
        Move dtWork to tEvent.dLastMod_Date
        Get DateTime_to_Time dtWork to tEvent.tmLastMod_Time

#IF (SigCj_Codejock_Version < 240000)  
        Get ComRExceptionStartTimeOrig of hoEvent to dtWork
        Move dtWork to tEvent.dRE_StartDateOrg
        Get DateTime_to_Time dtWork to tEvent.tmRE_StartTimeOrg

        Get ComRExceptionEndTimeOrig of hoEvent to dtWork
        Move dtWork to tEvent.dRE_EndDateOrg
        Get DateTime_to_Time dtWork to tEvent.tmRE_EndTimeOrg
#ENDIF
        Get ComCategories of hoEvent to vCategories
        Set pvComObject of hoCategories to vCategories
        Get ComSaveToString of hoCategories to tEvent.sCategories

        //Remove multiple cats. leave only the last one selected / added
        Move (Left(tEvent.sCategories,(pos(",",tEvent.sCategories) -1))) to tEvent.sCategories

        Get ComCustomIcons of hoEvent to vCustomIcons
        Set pvComObject of hoCustomIcons to vCustomIcons
        Get ComSaveToString of hoCustomIcons to tEvent.sCustomIcons

        Get ComCustomProperties of hoEvent to vCustomProperties
        Set pvComObject of hoCustomProperties to vCustomProperties

        //Retrieve DB Link if set
        If (pbEnableDB_Link(Self)) Begin
            Send Retrieve_DB_Link hoCustomProperties (&tEvent.bDB_Link) (&tEvent.sDB_Table) (&tEvent.sDB_Key)
        End
        
        //Retrieve User IDs
        Send Retrieve_User_IDs hoCustomProperties (&tEvent.sCreatedBy) (&tEvent.sLastMod_By)
        
        //store any remaining custom properties
        Get ComSaveToString of hoCustomProperties to tEvent.sCustomProperties

        Function_Return tEvent
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Support Methods" Visibility=Internal
    Function Populate_tdSigCj_RecPattern_From_Object Variant vRecPattern Returns tdSigCjCal_RecPattern
        Handle   hoCustomProperties hoRecPatternOptions hoRecPattern
        Variant   vCustomProperties  vRecPatternOptions
        DateTime dtWork
        tdSigCjCal_RecPattern tRecPattern

        Get Internal_phoRecPattern to hoRecPattern
        Set pvComObject of hoRecPattern to vRecPattern

        Get ComId                   of hoRecPattern to tRecPattern.iID
        Get ComDurationMinutes      of hoRecPattern to tRecPattern.iDurationMinutes
        Get ComEndAfterOccurrences  of hoRecPattern to tRecPattern.iEndAfterOcc
        Get ComEndMethod            of hoRecPattern to tRecPattern.eEndMethod
        Get ComMasterEventId        of hoRecPattern to tRecPattern.iMasterEventId

        Get ComEndDate              of hoRecPattern to tRecPattern.dEndDate

        Get ComStartDate            of hoRecPattern to tRecPattern.dStartDate
        Get ComStartTime            of hoRecPattern to dtWork
        Get DateTime_to_Time dtWork                 to tRecPattern.tmStartTime

        Get ComCustomProperties of hoRecPattern to vCustomProperties
        Get Internal_phoCustomProperties to hoCustomProperties
        Set pvComObject of hoCustomProperties to vCustomProperties
        Get ComSaveToString of hoCustomProperties to tRecPattern.sCustomProp_XML

        Get ComOptions of hoRecPattern to vRecPatternOptions
        Get Internal_phoRecPatternOptions to hoRecPatternOptions
        Set pvComObject of hoRecPatternOptions to vRecPatternOptions

        Get ComDailyEveryWeekDayOnly  of hoRecPatternOptions to tRecPattern.bRoD_WeekDayOnly
        Get ComDailyIntervalDays      of hoRecPatternOptions to tRecPattern.iRoD_Int_Days
        Get ComData1                  of hoRecPatternOptions to tRecPattern.iRoData1
        Get ComData2                  of hoRecPatternOptions to tRecPattern.iRoData2
        Get ComData3                  of hoRecPatternOptions to tRecPattern.iRoData3
        Get ComData4                  of hoRecPatternOptions to tRecPattern.iRoData4
        Get ComMonthlyDayOfMonth      of hoRecPatternOptions to tRecPattern.iRoM_DayOfMonth
        Get ComMonthlyIntervalMonths  of hoRecPatternOptions to tRecPattern.iRoM_Int_Months
        Get ComMonthNthIntervalMonths of hoRecPatternOptions to tRecPattern.iRoM_NthInt_Mths
        Get ComMonthNthWhichDay       of hoRecPatternOptions to tRecPattern.iRoM_Nth_Day
        Get ComMonthNthWhichDayMask   of hoRecPatternOptions to tRecPattern.eRoM_Nth_DayMask
        Get ComRecurrenceType         of hoRecPatternOptions to tRecPattern.eRoRecurr_Type
        Get ComWeeklyDayOfWeekMask    of hoRecPatternOptions to tRecPattern.eRoW_DayWeekMask
        Get ComWeeklyIntervalWeeks    of hoRecPatternOptions to tRecPattern.iRoW_Int_Weeks
        Get ComYearlyDayOfMonth       of hoRecPatternOptions to tRecPattern.iRoY_DayOfMonth
        Get ComYearlyMonthOfYear      of hoRecPatternOptions to tRecPattern.iRoY_MonthOfYear
        Get ComYearNthMonthOfYear     of hoRecPatternOptions to tRecPattern.iRoY_NthM_OfYear
        Get ComYearNthWhichDay        of hoRecPatternOptions to tRecPattern.iRoY_Nth_Day
        Get ComYearNthWhichDayMask    of hoRecPatternOptions to tRecPattern.iRoY_Nth_DayMask

        Function_Return tRecPattern
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Data" Visibility=Public
    Procedure Refresh_Data Boolean bAll
        Integer iCount iLoop
        tdSigCjCal_RM_DataProvider[] taRM_DataProviders

        If (bAll) Begin
            Get ptaRM_DataProviders to taRM_DataProviders
            Move (SizeOfArray(taRM_DataProviders) - 1) to iCount
            For iLoop from 0 to iCount
                Send Force_Data_Refresh taRM_DataProviders[iLoop].tDataProvider.iID
            Loop
        End
        Else Begin
            Send Force_Data_Refresh (piVDF_DataProvider(Self))
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Schedules" Visibility=Public
    Procedure Remove_Category Integer iSchedule_ID Integer iCategory_ID
        Integer iSchedule_Index iCategory_Index iCount iLoop
        Integer[] iCategory_IDs
        tdSigCjCal_RM_Category[] taRM_Categories
        tdSigCjCal_RM_Schedule[] taRM_Schedules

        Get Schedule_Index iSchedule_ID to iSchedule_Index
        If (iSchedule_Index <> -1) Begin
            Get ptaRM_Schedules to taRM_Schedules
                Move (SizeOfArray(taRM_Schedules[iSchedule_Index].taCategory_IDs) - 1) to iCount
                For iLoop from 0 to iCount
                    If (taRM_Schedules[iSchedule_Index].taCategory_IDs[iLoop] <> iCategory_ID) Begin
                        Move taRM_Schedules[iSchedule_Index].taCategory_IDs[iLoop] to iCategory_IDs[SizeOfArray(iCategory_IDs)]
                    End
                Loop
                Move iCategory_IDs to taRM_Schedules[iSchedule_Index].taCategory_IDs
            Set ptaRM_Schedules to taRM_Schedules
        End

        Get ptaRM_Categories to taRM_Categories
            Get Category_Index iCategory_ID to iCategory_Index
            Decrement taRM_Categories[iCategory_Index].iInUse
        Set ptaRM_Categories to taRM_Categories
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Icons" Visibility=Public
    Procedure RemoveCustomIcon Integer iDataProvider_ID Integer iEvent_ID Integer iIcon_ID
        Handle  hoCalendarIconIDs hoDataProvider hoEvent
        Variant  vCalendarIconIDs  vDataProvider  vEvent

        Get Event_Object iDataProvider_ID iEvent_ID to vEvent
        Get Internal_phoEvent to hoEvent
        Set pvComObject of hoEvent to vEvent

        Get ComCustomIcons of hoEvent to vCalendarIconIDs
        Get Internal_phoCustomIcons   to hoCalendarIconIDs
        Set pvComObject of hoCalendarIconIDs to vCalendarIconIDs
        Send ComRemove of hoCalendarIconIDs iIcon_ID

        Send Notify_Event_Changed hoEvent
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Properties" Visibility=Public
    Procedure RemoveCustomProperty Integer iDataProvider_ID Integer iEvent_ID String sName
        Handle  hoEvent hoCustomProperties hoDataProvider
        Variant vCustomProperties vDataProvider vEvent

        Get Event_Object iDataProvider_ID iEvent_ID to vEvent
        Get Internal_phoEvent to hoEvent
        Set pvComObject of hoEvent to vEvent

        Get ComCustomProperties of hoEvent to vCustomProperties
        Get Internal_phoCustomProperties    to hoCustomProperties
        Set pvComObject of hoCustomProperties to vCustomProperties
        Send ComRemove of hoCustomProperties sName

        Send Notify_Event_Changed hoEvent
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Schedules" Visibility=Public
    Procedure Remove_DataProvider Integer iResource_ID Integer iDataProvider_ID
        Integer iResource_Index iDataProvider_Index iIndex iCount iLoop
        tdSigCjCal_RM_DataProvider[] taRM_DataProviders
        tdSigCjCal_RM_Resource[]     taRM_Resources

        If (iDataProvider_ID <> (piVDF_DataProvider(Self))) Begin
            Get Resource_Index iResource_ID False to iResource_Index
            If (iResource_Index <> -1) Begin
                Get DataProvider_Index iDataProvider_ID to iDataProvider_Index
                If (iDataProvider_Index <> -1) Begin
                    //We always expect a data provider so set it to the default (VDF tables)
                    Get ptaRM_Resources to taRM_Resources
                        Move (piVDF_DataProvider(Self)) to taRM_Resources[iResource_Index].iDataProvider_ID
                    Set ptaRM_Resources to taRM_Resources
        
                    Get ptaRM_DataProviders to taRM_DataProviders
                        Decrement taRM_DataProviders[iDataProvider_Index].iInUse
                    Set ptaRM_DataProviders to taRM_DataProviders
                End
            End
        End    
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:DB_Link" Visibility=Internal
    Procedure RemoveDB_Link
        Handle hoEvent hoCustomProperties //hoDataProvider 
        Variant vCustomPropeties
        tdSigCjCal_HitTestInfo tHitTestInfo

        Get ptHitTestInfo to tHitTestInfo

        Get Internal_phoCustomProperties to hoCustomProperties
        Get Internal_phoEvent            to hoEvent
        Set pvComObject of hoEvent        to tHitTestInfo.vEvent
            
        Get ComCustomProperties of hoEvent to vCustomPropeties
        Set pvComObject of hoCustomProperties to vCustomPropeties
            
        Send ComRemove of hoCustomProperties eCal_DB_Link 
        Send ComRemove of hoCustomProperties eCal_DB_Table
        Send ComRemove of hoCustomProperties eCal_DB_Key   

        Send Notify_Event_Changed hoEvent
    End_Procedure
    
