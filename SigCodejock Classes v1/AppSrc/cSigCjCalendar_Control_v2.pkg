    //=========================================================================
    //COM Data Events
    //=========================================================================

    // Category="SigCj:CJ Data Event" Visibility=Internal
    Procedure OnComDoCreateEvent Variant vEvent Integer ByRef iNewEventID Boolean ByRef bResult
        tdSigCjCal_Event tEvent

        //Move object data to buffer
        Get Populate_tdSigCj_Event_From_Object vEvent to tEvent

        Get OnCreateEvent tEvent to iNewEventID
        If (iNewEventID > -1) Begin
            Move True to bResult
        End
        Else Begin
            Move False to bResult   //Make sure we are returning a valid value
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:CJ Data Event" Visibility=Internal
    Procedure OnComDoCreateRPattern Variant vRecPattern Integer ByRef iNewRecPatternID Boolean ByRef bResult
        tdSigCjCal_RecPattern tRecPattern

        //Move object data to buffer
        Get Populate_tdSigCj_RecPattern_From_Object vRecPattern to tRecPattern

        Get OnCreateRecPattern tRecPattern to iNewRecPatternID
        If (iNewRecPatternID > -1) Begin
            Move True to bResult
        End
        Else Begin
            Move False to bResult   //Make sure we are returning a valid value
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:CJ Data Event" Visibility=Internal
    Procedure OnComDoDeleteEvent Variant vEvent Boolean ByRef bResult
        Handle  hoEvent
        Integer iEventID

        Get Internal_phoEvent to hoEvent
        Set pvComObject of hoEvent to vEvent
        Get ComId of hoEvent to iEventID

        Get OnDeleteEvent iEventID to bResult
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:CJ Data Event" Visibility=Internal
    Procedure OnComDoDeleteRPattern Variant vRecPattern Boolean ByRef bResult
        Handle  hoRecPattern
        Integer iRecPatternID

        Get Internal_phoRecPattern to hoRecPattern
        Set pvComObject of hoRecPattern to vRecPattern
        Get ComID of hoRecPattern to iRecPatternID

        Get OnDeleteRecPattern iRecPatternID to bResult
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:CJ Data Event" Visibility=Internal
    Procedure OnComDoGetUpcomingEvents DateTime dtFrom Integer iPeriodMinutes Variant vEvents
        Boolean  bFound
        DateTime dtTo dtStart
        TimeSpan tsTo

        //Workout To DateTime
        Move (DateSetHour  (tsTo,    (iPeriodMinutes / 60))) to tsTo
        Move (DateSetMinute(tsTo, mod(iPeriodMinutes,60  ))) to tsTo
        Move (dtFrom + tsTo) to dtTo

        //Link our Events collection object to the one passed in by Codejock
        Set pvComObject of (Internal_phoEvents(Self)) to vEvents

        //Fire event for the user to add events to the collect via AddEventToCollection
        Send OnGetUpcomingEvents dtFrom dtTo
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:CJ Data Event" Visibility=Internal
    Procedure OnComDoReadEvent Integer iEventID Variant ByRef vEvent
        tdSigCjCal_Event tEvent

        If (iEventID > 0) Begin
            Get OnReadEvent iEventID to tEvent

            If (tEvent.iID > -1) Begin
                Get CreateEventObject tEvent False to vEvent
            End
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:CJ Data Event" Visibility=Internal
    Procedure OnComDoReadRPattern Integer iRecPatternID Variant ByRef vRecPattern
        tdSigCjCal_RecPattern tRecPattern

        Get OnReadRecPattern iRecPatternID to tRecPattern
        If (tRecPattern.iID <> -1) Begin
            Get CreateRecPatternObject tRecPattern to vRecPattern
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:CJ Data Event" Visibility=Internal
    Procedure OnComDoRetrieveDayEvents DateTime dtDay Variant vEvents
        //Link our Events collection object to the one passed in by Codejock
        Set pvComObject of (Internal_phoEvents(Self)) to vEvents

        //Fire event for the user to add events to the collect via AddEventToCollection
        //Pass the active Schedule IDs in case the user want to filter their data finds
        Send OnGetDayEvents (Date(dtDay)) (piaSchedule_IDs(Self))

        //See if the day is a special date
        If (pbEnableSpecialDates(Self)) Begin
            Send SpecialDate_Load_Date (Date(dtDay))
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:CJ Data Event" Visibility=Internal
    Procedure OnComDoUpdateEvent Variant vEvent Boolean ByRef bResult
        tdSigCjCal_Event tEvent

        //Move object data to buffer
        Get Populate_tdSigCj_Event_From_Object vEvent to tEvent

        Get OnUpdateEvent tEvent to bResult
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:CJ Data Event" Visibility=Internal
    Procedure OnComDoUpdateRPattern Variant vRecPattern Boolean ByRef bResult
        tdSigCjCal_RecPattern tRecPattern

        //Move object data to buffer
        Get Populate_tdSigCj_RecPattern_From_Object vRecPattern to tRecPattern

        Get OnUpdateRecPattern tRecPattern to bResult
    End_Procedure

