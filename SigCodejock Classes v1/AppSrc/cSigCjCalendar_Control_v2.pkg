{ OverrideProperty=Search_Case               DesignTime=False }
{ OverrideProperty=Skip_State                DesignTime=False }
{ OverrideProperty=Help_Id                   DesignTime=False }
{ OverrideProperty=Help_Keyword              DesignTime=False }
{ OverrideProperty=psHtmlHelpTopic           DesignTime=False }
{ OverrideProperty=Status_Help               DesignTime=False }
{ OverrideProperty=Use_Parent_Status_Help    DesignTime=False }
{ OverrideProperty=psLicenseKey              DesignTime=False }
{ OverrideProperty=psProgID                  DesignTime=False }
{ OverrideProperty=Color                     DesignTime=False }
{ OverrideProperty=TextColor                 DesignTime=False }
Class cSigCJCalendar_Control_v2 is a cSigCjComCalendarControl
    Import_Class_Protocol cSigCJMethods_Mixin

    //=========================================================================

    // Category="SigCj:Construction" Visibility=Internal     
    Procedure Construct_Object
        Forward Send Construct_Object

        Set peAutoCreate to acAutoCreate

        //=====================================================================
        //Embedded Object Handles
        //=====================================================================

        { DesignTime=False }
        Property Handle Internal_phoActivteView                  (Create(Self, U_cSigCjComCalendarView                       ))
        { DesignTime=False }                                    
        Property Handle Internal_phoCalendarDialogs              (Create(Self, U_cSigCjComCalendarDialogs                    ))
        { DesignTime=False }                                    
        Property Handle Internal_phoCalendarIconIDs              (Create(Self, U_cSigCjComCalendarIconIDs                    ))
        { DesignTime=False }                                    
        Property Handle Internal_phoCalendarOptions              (Create(Self, U_cSigCjComCalendarOptions                    ))
        { DesignTime=False }                                    
        Property Handle Internal_phoCustomIcons                  (Create(Self, U_cSigCjComCalendarIconIDs                    ))
        { DesignTime=False }                                    
        Property Handle Internal_phoCustomProperties             (Create(Self, U_cSigCjComCalendarCustomProperties           ))
        { DesignTime=False }                                    
        Property Handle Internal_phoDataProvider                 (Create(Self, U_cSigCjComCalendarDataProvider               ))
        { DesignTime=False }                                    
        Property Handle Internal_phoDayView                      (Create(Self, U_cSigCjComCalendarDayView                    ))
        { DesignTime=False }                                    
        Property Handle Internal_phoEditOperationParameters      (Create(Self, U_cSigCjComCalendarEditOperationParameters    ))
        { DesignTime=False }                                    
        Property Handle Internal_phoEvent                        (Create(Self, U_cSigCjComCalendarEvent                      ))
        { DesignTime=False }                                    
        Property Handle Internal_phoEvents                       (Create(Self, U_cSigCjComCalendarEvents                     ))
        { DesignTime=False }                                    
        Property Handle Internal_phoEventCategories              (Create(Self, U_cSigCjComCalendarEventCategories            ))
        { DesignTime=False }                                    
        Property Handle Internal_phoEventCategoriesIDs           (Create(Self, U_cSigCjComCalendarEventCategoryIDs           ))
        { DesignTime=False }                                    
        Property Handle Internal_phoHitTestInfo                  (Create(Self, U_cSigCjComCalendarHitTestInfo                ))
        { DesignTime=False }                                    
        Property Handle Internal_phoImageManagerIcons            (Create(Self, U_cSigCjComImageManagerIcons                  ))
        { DesignTime=False }                                    
        Property Handle Internal_phoNonWorkingCellColors         (Create(Self, U_cSigCjComCalendarThemeDayViewCellColors     ))
        { DesignTime=False }                                    
        Property Handle Internal_phoPageFooter                   (Create(Self, U_cSigCjComPrintPageHeaderFooter              ))
        { DesignTime=False }                                    
        Property Handle Internal_phoPageHeader                   (Create(Self, U_cSigCjComPrintPageHeaderFooter              ))
        { DesignTime=False }                                    
        Property Handle Internal_phoPrinterInfo                  (Create(Self, U_cSigCjComXtremePrinterInfo                  ))
        { DesignTime=False }                                    
        Property Handle Internal_phoPrintOptions                 (Create(Self, U_cSigCjComCalendarPrintOptions               ))
        { DesignTime=False }                                    
        Property Handle Internal_phoPrintPreviewOptions          (Create(Self, U_cSigCjComXtremePrintPreviewOptions          ))
        { DesignTime=False }                                    
        Property Handle Internal_phoRecPattern                   (Create(Self, U_cSigCjComCalendarRecurrencePattern          ))
        { DesignTime=False }                                    
        Property Handle Internal_phoRecPatternOptions            (Create(Self, U_cSigCjComCalendarRecurrencePatternOptions   ))
        { DesignTime=False }                                    
        Property Handle Internal_phoResource                     (Create(Self, U_cSigCjComCalendarResource                   ))
        { DesignTime=False }                                    
        Property Handle Internal_phoResourceDescription          (Create(Self, U_cSigCjComCalendarResourceDescription        ))
        { DesignTime=False }                                    
        Property Handle Internal_phoResourceManager              (Create(Self, U_cSigCjComCalendarResourcesManager           ))
        { DesignTime=False }                                    
        Property Handle Internal_phoResources                    (Create(Self, U_cSigCjComCalendarResources                  ))
        { DesignTime=False }                                    
        Property Handle Internal_phoSchedule                     (Create(Self, U_cSigCjComCalendarSchedule                   ))
        { DesignTime=False }                                    
        Property Handle Internal_phoScheduleIDs                  (Create(Self, U_cSigCjComCalendarScheduleIDs                ))
        { DesignTime=False }                                    
        Property Handle Internal_phoSchedules                    (Create(Self, U_cSigCjComCalendarSchedules                  ))
        { DesignTime=False }                                    
        Property Handle Internal_phoThemeColorGradient           (Create(Self, U_cSigCjComCalendarThemeColorGradient         ))
        { DesignTime=False }                                    
        Property Handle Internal_phoThemeDayViewCellParams       (Create(Self, U_cSigCjComCalendarThemeDayViewCellParams     ))
        { DesignTime=False }                                    
        Property Handle Internal_phoThemeOffice2007              (Create(Self, U_cSigCjComCalendarThemeOffice2007            ))
        { DesignTime=False }
        Property Handle Internal_phoThemeOffice2007MonthView     (Create(Self, U_cSigCjComCalendarThemeOffice2007MonthView   ))
        { DesignTime=False }
        Property Handle Internal_phoThemeOffice2007MonthViewDay  (Create(Self, U_cSigCjComCalendarThemeOffice2007MonthViewDay))
        { DesignTime=False }
        Property Handle Internal_phoThemeOffice2007WeekView      (Create(Self, U_cSigCjComCalendarThemeOffice2007WeekView    ))
        { DesignTime=False }
        Property Handle Internal_phoThemeOffice2007WeekViewDay   (Create(Self, U_cSigCjComCalendarThemeOffice2007WeekViewDay ))
        { DesignTime=False }
        Property Handle Internal_phoViewDay                      (Create(Self, U_cSigCjComCalendarViewDay                    ))
        { DesignTime=False }                                    
        Property Handle Internal_phoViewEvent                    (Create(Self, U_cSigCjComCalendarViewEvent                  ))
        { DesignTime=False }                                    
        Property Handle Internal_phoViewEvents                   (Create(Self, U_cSigCjComCalendarViewEvents                 ))
        { DesignTime=False }                                    
        Property Handle Internal_phoViewGroup                    (Create(Self, U_cSigCjComCalendarViewGroup                  ))
        { DesignTime=False }                                    
        Property Handle Internal_phoViewSelection                (Create(Self, U_cSigCjComCalendarViewSelection              ))
        { DesignTime=False }                                    
        Property Handle Internal_phoWorkingCellColors            (Create(Self, U_cSigCjComCalendarThemeDayViewCellColors     ))

        //=====================================================================
        //Non COM Properties
        //=====================================================================

        //Object handles
        { Category="SigCj:General" }
        Property Handle phoDatePicker
        { DesignTime=False }
        Property Handle phoIdleHandler

        //Standard data type properties
        { Category="SigCj:Start Edit" }
        Property Boolean pbAllowEditInDayView           True
        { Category="SigCj:Start Edit" }
        Property Boolean pbAllowEditInMonthView         False
        { Category="SigCj:Start Edit" }
        Property Boolean pbAllowEditInWeekView          False
        { Category="SigCj:Dialogs" }
        Property String psCM_AddDB_Link                 "Add DB Link"
        { Category="SigCj:Dialogs" }
        Property String psCM_AddCustomIcon              "Add Icon"
        { Category="SigCj:Dialogs" }
        Property String psCM_AddCustomProperty          "Add Property"
        { Category="SigCj:Dialogs" }
        Property String psCM_CreateEvent                "Create Event"
        { Category="SigCj:DB_Link" }
        Property Boolean pbCM_DB_Link                   True
        { Category="SigCj:Icons" }
        Property Boolean pbCM_CustomIcon                True
        { Category="SigCj:Properties" }
        Property Boolean pbCM_CustomProperty            True
        { Category="SigCj:Print" }
        Property Boolean pbCM_Print                     True
        { Category="SigCj:Dialogs" }
        Property String psCM_Cut                        "Cut"
        { Category="SigCj:Dialogs" }
        Property String psCM_Copy                       "Copy"
        { Category="SigCj:Dialogs" }
        Property String psCM_Paste                      "Paste"
        { Category="SigCj:Dialogs" }
        Property String psCM_DeleteEvent                "Delete Event"
        { Category="SigCj:Dialogs" }
        Property String psCM_EditDB_Link                "Edit DB_Link"
        { Category="SigCj:Dialogs" }
        Property String psCM_EditCustomProperty         "Edit Property"
        { Category="SigCj:Dialogs" }
        Property String psCM_EditEvent                  "Edit Event"
        { Category="SigCj:Dialogs" }
        Property String psCM_GotoDB_Link                "Goto DB_Link"
        { Category="SigCj:Dialogs" }
        Property String psCM_Print_Preview              "Print Preview"
        { Category="SigCj:Dialogs" }
        Property String psCM_Print                      "Print"
        { Category="SigCj:Dialogs" }
        Property String psCM_Print_Page_Setup           "Page Setup"
        { Category="SigCj:Dialogs" }
        Property String psCM_RefreshData                "Refresh Data"
        { Category="SigCj:Dialogs" }
        Property String psCM_RemoveDB_Link              "Remove DB Link"
        { Category="SigCj:Dialogs" }
        Property String psCM_RemoveCustomIcon           "Remove Icon"
        { Category="SigCj:Dialogs" }
        Property String psCM_RemoveCustomProperty       "Remove Property"
        { Category="SigCj:Dialogs" }
        Property String psCM_RemoveException            "Remove Exception"
        { Category="SigCj:Dialogs" }
        Property Integer peContextMenu_Header           eCal_CM_Standard
        { Category="SigCj:Dialogs" }
        Property Integer peContextMenu_Main             eCal_CM_Standard
        { Category="SigCj:Dialogs" }
        Property Integer peContextMenu_Scale            eCal_CM_Standard
        { Category="SigCj:Dialogs" }
        Property Handle  phoContextMenu_Header          0
        { Category="SigCj:Dialogs" }
        Property Handle  phoContextMenu_Main            0
        { Category="SigCj:Dialogs" }
        Property Handle  phoContextMenu_Scale           0
        { Category="SigCj:Schedules" }
        Property Integer piCurrent_Layout_ID            -1
        { Category="SigCj:DB_Link" }
        Property Boolean pbDB_Link_OnClick              True
        { Category="SigCj:Dialogs" }
        Property Boolean pbDialogAllSchedulesMode       False
        { Category="SigCj:Icons" }
        Property Handle  phoDialog_CustomIcons          0
        { Category="SigCj:Properties" }
        Property Handle  phoDialog_CustomProperties     0
        { Category="SigCj:DB_Link" }
        Property Handle  phoDialog_DB_Link              0
        { Category="SigCj:Dialogs" }
        Property Handle  phoDialog_EditEvent            0   //If set then the specific dialog well be
        { Category="SigCj:Dialogs" }
        Property Handle  phoDialog_EditRecurrence       0   //used instead of the built in ones
        { Category="SigCj:Dialogs" }
        Property Handle  phoDialog_MinWidth             0
        { Category="SigCj:Dialogs" }
        Property Handle  phoDialog_NewEvent             0   //These must be set in Object / sub-class
        { Category="SigCj:Dialogs" }
        Property Handle  phoDialog_Reminders            0
        { Category="SigCj:Dialogs" }
        Property Handle  phoDialog_Reorder              0
        { Category="SigCj:Dialogs" }                
        Property Handle  phoDialog_Series               0
        { Category="SigCj:Dialogs" }
        Property Handle  phoDialog_TimeScale            0
        { Category="SigCj:Auto Refresh" }
        Property Boolean pbEnableAutoRefresh            True
        { Category="SigCj:Tool Tips" }
        Property Boolean pbEnableCustomEventToolTips    False
        { Category="SigCj:Icons" }
        Property Boolean pbEnableCustomIcons            False
        { Category="SigCj:Properties" }
        Property Boolean pbEnableCustomProperties       False
        { Category="SigCj:General" }
        Property Boolean pbEnableCCP                    True
        { Category="SigCj:DB_Link" }
        Property Boolean pbEnableDB_Link                False

        //There are public and internal copies of the EnableResources property. 
        //The internal copy is use by the class and is only set in one place 
        //(in OnCreate) This allows us to create a design time property. If the 
        //user changes the public copy at runtime it will have no effect.
        { Category="SigCj:Schedules" }
        Property Boolean pbEnableResources              False
        { DesignTime=False }
        Property Boolean Internal_pbEnableResources     False

        { Category="SigCj:Special Dates" }
        Property Boolean pbEnableSpecialDates           True 
        { Category="SigCj:Icons" }
        Property String psIcon_DB_Link                  "Cal_DB_Link.ico"
        { Category="SigCj:Icons" }
        Property String psIcon_Exception                "Cal_Exception.ico"
        { Category="SigCj:Icons" }
        Property String psIcon_Meeting                  "Cal_Meeting.ico"
        { Category="SigCj:Icons" }
        Property String psIcon_Private                  "Cal_Private.ico"
        { Category="SigCj:Icons" }
        Property String psIcon_Recurrence               "Cal_Occurrence.ico"
        { Category="SigCj:Icons" }
        Property String psIcon_Reminder                 "Cal_Reminder.ico"
        { Category="SigCj:Icons" }
        Property Boolean pbIconEnabled_DB_Link          True
        { Category="SigCj:Icons" }
        Property Boolean pbIconEnabled_Exception        True
        { Category="SigCj:Icons" }
        Property Boolean pbIconEnabled_Meeting          True
        { Category="SigCj:Icons" }
        Property Boolean pbIconEnabled_Private          True
        { Category="SigCj:Icons" }
        Property Boolean pbIconEnabled_Recurrence       True
        { Category="SigCj:Icons" }
        Property Boolean pbIconEnabled_Reminder         True
        { Category="SigCj:Icons" }
        Property Integer piIconID_DB_Link               1
        { Category="SigCj:Auto Refresh" }
        { EnumList="eCal_AR_Minutes, eCal_AR_Seconds" }
        Property Integer peIntervalUnits                eCal_AR_Seconds
        { DesignTime=False }
        Property DateTime pdtLastRefresh
        { Category="SigCj:Shading" }
        Property String  ptmLastWorkDayEndTime          "16:00"
        { Category="SigCj:Shading" }
        Property String  ptmLunchEndTime                "14:00"
        { Category="SigCj:Shading" }
