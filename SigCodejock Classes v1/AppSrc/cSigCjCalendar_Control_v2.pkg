    // Category="SigCj:Special Dates" Visibility=Internal
    Function SpecialDate_Back_Color Integer iDate Returns Integer
        tdSigCjCal_SpecialDate[] tSpecial_Dates

        Get ptaSpecial_Dates to tSpecial_Dates

        Function_Return tSpecial_Dates[iDate].iBackColor
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Special Dates" Visibility=Internal
    Procedure SpecialDate_Clear_Cache
        tdSigCjCal_SpecialDate[] tSpecial_Dates

        Set ptaSpecial_Dates to tSpecial_Dates
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Special Dates" Visibility=Internal
    Function SpecialDate_Create_Allowed Date dDate Returns Boolean
        Boolean bAllowed
        Integer iDate
        tdSigCjCal_SpecialDate[] taSpecial_Dates

        Move True to bAllowed
        Get SpecialDate_Is_Special_Date dDate to iDate
        If (iDate <> -1) Begin
            Get ptaSpecial_Dates to taSpecial_Dates
            If (taSpecial_Dates[iDate].eAllowEvents = eCal_SD_Create_No) Begin
                Move False to bAllowed
            End

            If (taSpecial_Dates[iDate].eAllowEvents = eCal_SD_Create_Ask) Begin
                Get OnSpecialDataCreateAllowed to bAllowed
            End
        End
        Function_Return bAllowed
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Special Dates" Visibility=Internal
    Function SpecialDate_Find_Date tdSigCjCal_SpecialDate tSpecial_Dates tdSigCjCal_SpecialDate tDate Returns Integer
        Integer iRetVal

        Move (NE) to iRetVal
        If (tSpecial_Dates.dDate = tDate.dDate) Move (EQ) to iRetVal

        Function_Return iRetVal
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Special Dates" Visibility=Internal
    Function SpecialDate_Is_In_Cache Date dDate Returns Integer
        Integer iIndex
        tdSigCjCal_SpecialDate   tDate
        tdSigCjCal_SpecialDate[] tSpecial_Dates

        Get ptaSpecial_Dates to tSpecial_Dates
        Move dDate to tDate.dDate
        Move (SearchArray(tDate, tSpecial_Dates, Self, get_SpecialDate_Find_Date)) to iIndex
        
        Function_Return iIndex
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Special Dates" Visibility=Internal
    Function SpecialDate_Is_Special_Date Date dDate Returns Integer
        Integer iIndex  
        tdSigCjCal_SpecialDate[] tSpecial_Dates

        Get SpecialDate_Is_In_Cache dDate to iIndex
        If (iIndex <> -1) Begin
            Get ptaSpecial_Dates to tSpecial_Dates
            If (not(tSpecial_Dates[iIndex].bIsSpecial)) Begin
                Move -1 to iIndex
            End
        End
        
        Function_Return iIndex
    End_Function

    //-------------------------------------------------------------------------

    // Category="SigCj:Special Dates" Visibility=Internal
    Procedure SpecialDate_Load_Date Date dDay
        Integer iIndex
        tdSigCjCal_SpecialDate[] tSpecial_Dates
        tdSigCjCal_SpecialDate   tSpecial_Day_Data

        Get SpecialDate_Is_In_Cache dDay to iIndex
        If (iIndex = -1) Begin
            Get OnLoadSpecialDate dDay to tSpecial_Day_Data

            Get ptaSpecial_Dates to tSpecial_Dates
                Move (SizeOfArray(tSpecial_Dates)) to iIndex
                Move tSpecial_Day_Data to tSpecial_Dates[iIndex]
            Set ptaSpecial_Dates to tSpecial_Dates

            If (phoDatePicker(Self)) Send ComRedrawControl to (phoDatePicker(Self))
        End
    End_Procedure

    //-------------------------------------------------------------------------

    // Category="SigCj:Special Dates" Visibility=Internal
    Function SpecialDate_ShadeType Integer iDate Returns Integer
        tdSigCjCal_SpecialDate[] tSpecial_Dates

        Get ptaSpecial_Dates to tSpecial_Dates

        Function_Return tSpecial_Dates[iDate].eShadeStyle
    End_Function

