  // Deletes the current row from the ResultSet and underlying database
  // To Do :
  Procedure DeleteRow
    Send Info_Box "To Do : DeleteRow"
  End_Procedure // DeleteRow


  // Inserts a row before the current row from the ResultSet and underlying database
  // To Do :
  Procedure InsertRow
    Send Info_Box "To Do : InsertRow"
  End_Procedure // InsertRow


  // Executes multiple statements that are passed to this method. Statements can be
  // seperated by putting semicolumns between them.
  // A new single resultset object will be temporarily created to execute the statements.
  //
  // Returns a nonzero value if an error occurs
  Procedure ExecuteStatements String sStmts Returns Integer
    Local Integer hoUpdateRS iLinedlm iRetVal
    Local String  sStmt

    Move 0 to iRetVal
    Get CreateResultSet To hoUpdateRS
    If (hoUpdateRS <> 0) Begin
      While ((sStmts <> "") And (iRetVal =0))
        Move (Pos(";",sStmts)) To iLinedlm
        If (iLinedlm <> 0) Move (left(sStmts,iLinedlm)) To sStmt
        Else Move sStmts To sStmt
        Move (Replace(sStmt,sStmts,"")) To sStmts
        Get Msg_ExecuteQuery Of hoUpdateRS sStmt To iRetVal
      Loop
    End
    Else Move 2 To iRetVal
    Procedure_Return iRetVal
  End_Procedure // ExecuteStatements



  // This method will traverse every column for the current row in the resultset.
  // If a column has changed, the database will be updated with the new value.
  //
  //
  Procedure UpdateRow
    Local Integer hoUpdateRS hoMetaData iColumn iColumnCount bChanged iRetVal
    Local String  sColumn sTable sDatatype sFieldValue sStmt sRowID sSQLBackend
    Get phoMetaData To hoMetaData
    If (hoMetaData <> 0) Begin
      Get ColumnCount Of hoMetaData To iColumnCount
      If (iColumnCount > 0) Begin
        Move 1 To iColumn
        While (iColumn <= iColumnCount)
          Get Column_Changed_State Item iColumn To bChanged
          If (bChanged <> 0) Begin
            Get psSQLBackend  To sSQLBackend
            Get ColumnName      Of hoMetaData Item iColumn To sColumn
            Get ColumnTableName Of hoMetaData Item iColumn To sTable
            Get ColumnDataType  Of hoMetaData Item iColumn To sDatatype
            Get ColumnValue Item iColumn To sFieldValue
            If ( (Pos("CHAR",sDataType) <> 0) Or (Pos("TEXT",sDataType) <> 0) ) Begin // Check if the column is a string or text val
              If (Pos ("'",sFieldValue) = 0) Begin
                Move ("'"+sFieldValue+"'") To sFieldValue
              End
            End
            Else If  (Pos("DATE",sDataType) <> 0)  Begin // Check if the column is of type date
              Move ("'"+sFieldValue+"'") To sFieldValue
            End
            Get RowID To sRowID

            If (sSQLBackend = ORAFLEX) Begin
              Move (sStmt+"UPDATE "+sTable+" SET "+sColumn+" = "+sFieldValue+" WHERE ROWID = (CHARTOROWID('"+sRowID+"')); " ) To sStmt
            End
            Else If (sSQLBackend = SQLFLEX) Begin
              Move (sStmt+"UPDATE "+sTable+" SET "+sColumn+" = "+sFieldValue+" WHERE IDENTITYCOL = '"+sRowID+"'; " ) To sStmt
            End

          End
          Increment iColumn
        Loop
      End

      If (sStmt <> "") Begin
        Get msg_ExecuteStatements sStmt To iRetVal
      End // sStmt <> ""
    End
  End_Procedure // UpdateRow


  // This method will refresh the data of the current row with the actual data that is retrieved
  // from the table.
  Procedure RefreshRow
    Local Integer iNdx iColumnCount iTableCount iLoop iCurrentRow bAutoRowNum
    Local Integer hoUpdateRS hoMetaData hoRowBuffer
    Local String  sColumn sTable sDatatype sFieldValue sStmt sVal sRowID sSQLBackend
    Get phoMetaData To hoMetaData
    If (hoMetaData <> 0) Begin
      Get ColumnCount Of hoMetaData To iColumnCount
      Get psSQLBackend  To sSQLBackend
      If (iColumnCount > 0) Begin
        Move 1 To iNdx
        //Get phoStatement To hoStatement
        //If (hoStatement <> 0) Begin
          Move "SELECT " To sStmt

          While (iNdx <= iColumnCount)
            Get FullColumnName Of hoMetaData Item iNdx To sVal
            If (Pos("?",sVal) = 1) Move (Replace("?",sVal,"")) To sVal // A calculated value
            If (sSQLBackEnd = SQLFLEX) Begin
              Get ColumnDataType  Of hoMetaData Item iNdx To sDatatype
              If (Pos("DATE",sDataType) <> 0)  Begin
                Move ("convert(char(10),"+sVal+", 101)") To sVal
              End
            End


            Move (sStmt+sVal) To sStmt
            If (iNdx <> iColumnCount) Begin
              Move (sStmt+", ") To sStmt
            End
            Increment iNdx
          Loop

          Get pbAutoRowNum To bAutoRowNum
          If ((bAutoRowNum = True) And (sSQLBackend=ORAFLEX)) Begin
            Move (sStmt+", ROWNUM") To sStmt
          End

          Move (sStmt+" FROM ") To sStmt

          // enumerate the tables
          Get TableCount Of hoMetaData To iTableCount
          Move 1 To iNdx
          While (iNdx <= iTableCount)
            Get TableName Of hoMetaData Item iNdx To sVal
            Move (sStmt+sVal) To sStmt
            If (iNdx <> iTableCount) Begin
              Move (sStmt+", ") To sStmt
            End
            Increment iNdx
          Loop

          Get RowID To sRowID
          If (sSQLBackEnd = ORAFLEX) Begin
            Move (sStmt+" WHERE ROWID = (CHARTOROWID('"+sRowID+"'))" ) To sStmt
          End
          Else If (sSQLBackEnd = SQLFLEX) Begin
            Move (sStmt+" WHERE IDENTITYCOL = '"+sRowID+"'" ) To sStmt
          End
        //End

        If (sStmt <> "") Begin

          indicate found True
          Indicate Err False
          SQL_SET_STMT To sStmt
          SQL_PREPARE_STMT
          SQL_EXECUTE_STMT

          Get piCurrentRow To iCurrentRow
          Get Array_Value Of (oRowHandles(Self)) Item iCurrentRow To hoRowBuffer
          SQL_FETCH_NEXT_ROW
          If (found) Begin
            If (hoRowBuffer <> 0) Begin
              For iLoop From 0 To (iColumnCount-1)
                DO_GET_BIND_PARAMETERS sVal

                Set Array_Value Of hoRowBuffer Item iLoop To sVal
                Set Column_Changed_State Item iLoop To False
              Loop

              Get pbAutoRowNum To bAutoRowNum
              If ( (bAutoRowNum = True) And (sSQLBackEnd = ORAFLEX) ) Begin
                DO_GET_BIND_PARAMETERS sVal
                Set piRowNum Of hoRowBuffer To (Integer(sVal))
              End
            End // hoRowBuffer
          End
        End // sStmt <> ""


      End // iColumnCount

    End
  End_Procedure // RefreshRow



  // Retrieves the value of the current ROWNUM column. The first row is number 1, the second number 2,
  // and so on.
  // Returns:
  // the current row number; 0 if there is no current row
  // Pre: pbAutoRowNum should be true when the query is executed, so that the proper value is already fetched
  // Throws:
  // SQLException - if a database access error occurs
  Function RowNum Returns Integer
    Local Integer iRowNum iRow hoRowBuffer
    Get piCurrentRow To iRow
    If (iRow > -1) Begin
      Get Array_Value Of (oRowHandles(Self)) Item iRow To hoRowBuffer
      If (hoRowBuffer <> 0) Begin
        Get piRowNum Of hoRowBuffer To iRowNum
      End
    End
    Function_Return iRowNum
  End_Function // RowNum



  // Retrieves the value of the current ROWID column. Every row in the (Oracle) database is uniquely
  // identified by the ROWID. This ID contains specific information about where the physical row is
  // stored.
  // Returns:
  // A 12 char value for Oracle 7.x and a 18 char value for 8i
  // For MS-SQL this will return the value stored in the IDENTITYCOL
  // Pre: pbAutoRowID should be true when the query is executed, so that the proper value is already fetched
  // Throws:
  // SQLException - if a database access error occurs
  Function RowID Returns String
    Local Integer iRow hoRowBuffer
    Local String  sRowID
    Get piCurrentRow To iRow
    If (iRow > -1) Begin
      Get Array_Value Of (oRowHandles(Self)) Item iRow To hoRowBuffer
      If (hoRowBuffer <> 0) Begin
        Get psRowID Of hoRowBuffer To sRowID
      End
    End
    Function_Return sRowID
  End_Function // RowID


  Procedure Set FetchSize Integer iSize
    Local Integer iFile
    Get piCurrentFile To iFile
    If iFile Begin
      Set_attribute DF_FILE_MAX_ROWS of iFile To iSize
    End
  End_Procedure // Set FetchSize


  Procedure Set FetchDirection Integer iDirection
    Set pbFetchDirection To iDirection
  End_Procedure // Set FetchDirection


  Function FetchDirection Returns Integer
    Function_Return (pbFetchDirection(Self))
  End_Function // FetchDirection

End_Class // cSQLResultSet



Procedure SQLException For Desktop Integer iException String sMessage
  Local Integer hoSQLException
  Move (oSQLException(Self)) To hoSQLException
  If (hoSQLException > Desktop) Begin
    Set piSQLException Of hoSQLException To iException
    If (num_arguments = 2) ;
      Set psSQLException Of hoSQLException To sMessage
    Else Set psSQLException Of hoSQLException To ""
    Send SQLException To hoSQLException
  End
End_Procedure // SQLException


Function CreateResultSet For Desktop Returns Handle
  Local Handle hoResultSet hoSelf
  Move Self To hoSelf
  Move Desktop To Self       // Create the resultset at the desktop
  Object oResultSet Is A cSQLResultSet
    Move Self To hoResultSet
  End_Object // oResultSet
  Move hoSelf To Self
  Function_Return hoResultSet
End_Function // CreateResultSet

