    Function_Return sName
  End_Function // GetCursorName


  // Gets the handle of the object that contains the metadata that belongs to the
  // current resultset.
  Function GetMetaData Returns Integer
    Function_Return (phoMetaData(Self))
  End_Function // GetMetaData



  Procedure UpdateString String sFieldID String sFieldValue
    Local Integer iColumn
    Local Integer hoSelf

    Move Self To hoSelf
    Get ColumnNumber Of hoSelf Item sFieldID To iColumn
    If (iColumn <> -1) Begin
      Set ColumnValue Item iColumn To sFieldValue
      Set Column_Changed_State Item iColumn To True
    End
    Else Begin
      Send SQLException SQLX_COLUMN_UNKNOWN ("Column name = ["+sFieldID+"]")
    End
  End_Procedure // UpdateString



  Procedure UpdateInteger String sFieldID Integer iFieldValue
    Local Integer iColumn
    Local Integer hoSelf

    Move Self To hoSelf
    Get ColumnNumber Of hoSelf Item sFieldID To iColumn
    If (iColumn <> -1) Begin
      Set ColumnValue Item iColumn To iFieldValue
      Set Column_Changed_State Item iColumn To True
    End
    Else Begin
      Send SQLException SQLX_COLUMN_UNKNOWN ("Column name = ["+sFieldID+"]")
    End
  End_Procedure // UpdateInteger


