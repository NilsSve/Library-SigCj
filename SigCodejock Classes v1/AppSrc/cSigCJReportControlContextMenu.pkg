Use SigCjLicense.pkg

#IF (SigCj_Codejock_Version < 220000)
    Use cSigCJReportControlContextMenu_Pre2200.pkg
#ELSE
    #Warning DFERR_COMP_WARNING_OBSOLETE_CMD "Obsolete package: cSigCJReportControlContextMenu. Recode for renamed Codejock Grid Control"

    #Replace cSigCJReportControlContextMenu_Header      cSigCJGridControlContextMenu_Header
    #Replace cSigCJReportControlContextMenu_GroupBox    cSigCJGridControlContextMenu_GroupBox
    #Replace cSigCJReportControlContextMenu_Groups      cSigCJGridControlContextMenu_Groups
    #Replace cSigCJReportControlContextMenu_ReportArea  cSigCJGridControlContextMenu_GridArea

    Use cSigCJGridControlContextMenu.pkg
#ENDIF

