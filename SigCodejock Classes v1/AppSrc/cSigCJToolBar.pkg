Use cCJCommandBarSystem.pkg
Use cSigCJMethods_Mixin.pkg
Use cSigCJMenuItem.pkg

Class cSigCJToolBar is a cCJToolbar
    Import_Class_Protocol cSigCJMethods_Mixin
    
    Procedure Construct_Object
        Forward Send Construct_Object
    End_Procedure

    Procedure End_Construct_Object
        Forward Send End_Construct_Object

        // Add your code that needs to be executed at the end of the object construction here:
        Send Load_Menu_Items
    End_Procedure
    
    // Hook 
    { MethodType=Event }
    Procedure Load_Menu_Items
    End_Procedure

    // Create and augment procedures and functions
    Procedure mCreate_Menu_Item String sLabel Integer iImage Integer iControl Integer iKey String sMessage String sToolTip String sStatusHelp 
        Handle hoMenuItem
        
        Get Create U_cSigCJMenuItem to hoMenuItem
        Set psCaption      of hoMenuItem to sLabel
        Set piIconId       of hoMenuItem to iImage
        Set piShortcutKey  of hoMenuItem to iControl iKey
        Set psMessage      of hoMenuItem to sMessage
        Set psTooltip      of hoMenuItem to sToolTip
        Set psDescription  of hoMenuItem to sStatusHelp
    End_Procedure

End_Class

