    // Hooks for left click options
    Procedure OnLeftClick_Header Handle hoColumn
    End_Procedure
    Procedure OnLeftClick_GroupBox Handle hoColumn
    End_Procedure
    Procedure OnLeftClick_GridArea Handle hoColumn Handle hoRow Handle hoItem
    End_Procedure

    // On Mouse Up set Left click options and Right click context menu options
    Procedure OnComMouseUp Short llButton Short llShift Integer llx Integer lly
        Handle  hoHitTestInfo hoGridColumn hoRow hoGroupRow hoItem
        Handle  hoContextMenu_Header hoContextMenu_GroupBox hoContextMenu_Groups hoContextMenu_GridArea
        Variant vHitTest vColumn vRow vGroupRow vItem
        Integer iGridInfoCode iIndex iColumns
        Boolean bGroupRow bExpanded
        String  sName

        Get phoHitTestInfo to hoHitTestInfo
        Get phoContextMenu_Header     to hoContextMenu_Header
        Get phoContextMenu_GroupBox   to hoContextMenu_GroupBox
        Get phoContextMenu_Groups     to hoContextMenu_Groups
        Get phoContextMenu_GridArea to hoContextMenu_GridArea

        Get ComHitTest llx lly to vHitTest
        Set pvComObject of hoHitTestInfo to vHitTest

        Get ComColumn of hoHitTestInfo to vColumn
        Get ComRow    of hoHitTestInfo to vRow
        Get ComItem   of hoHitTestInfo to vItem
        Get ComHt     of hoHitTestInfo to iGridInfoCode

        If (iGridInfoCode = OLExtpHitTestUnknown) Begin
            Set peHitTest to eRC_HitTest_Unknown
        End
        If (iGridInfoCode = OLExtpHitTestGroupBox) Begin
            Set peHitTest to eRC_HitTest_GroupBox

            If ((llButton = 1) and (hoContextMenu_GroupBox > 0)) Begin
                Get phoGridColumn    to hoGridColumn
                Set pvComObject        of hoGridColumn to vColumn
                Send OnLeftClick_GroupBox hoGridColumn
            End
            If ((llButton = 2) and (hoContextMenu_GroupBox > 0)) Begin
                Send Activate of (Self) // Ensure that the VDF object also has the focus
                Send Popup of hoContextMenu_GroupBox
            End
        End
        If (iGridInfoCode = OLExtpHitTestHeader) Begin
            Set peHitTest to eRC_HitTest_Header

            Get phoGridColumn to hoGridColumn
            Set pvComObject of hoGridColumn to vColumn
            If (IsComObjectCreated(hoGridColumn)) Begin
                Get ComIndex    of hoGridColumn to iIndex
                Set Private_piCurrentColumnIndex  to iIndex
            End

            If ((llButton = 1) and (hoContextMenu_Header > 0)) Begin
                Get phoGridColumn  to hoGridColumn
                Set pvComObject      of hoGridColumn to vColumn
                Send OnLeftClick_Header hoGridColumn
            End

            If ((llButton = 2) and (hoContextMenu_Header > 0)) Begin
                Send Activate of (Self) // Ensure that the VDF object also has the focus
                Send Popup of hoContextMenu_Header
            End
        End
        If (iGridInfoCode = OLExtpHitTestGridArea) Begin
            Set peHitTest to eRC_HitTest_GridArea

            If ((llButton = 1) and (hoContextMenu_GridArea > 0)) Begin
                Get phoGridColumn     to hoGridColumn
                Set pvComObject         of hoGridColumn to vColumn
                Get phoGridRow        to hoRow
                Set pvComObject         of hoRow  to vRow
                Get phoGridRecordItem to hoItem
                Set pvComObject         of hoItem to vItem
                Send OnLeftClick_GridArea hoGridColumn hoRow hoItem
            End
            If ((llButton = 2) and (hoContextMenu_GridArea > 0)) Begin
                Send Activate of (Self) // Ensure that the VDF object also has the focus
                Get phoGridRow      to hoRow
                Set pvComObject       of hoRow  to vRow

                If (not(IsNullComObject(vRow))) Begin
                    Get ComGroupRow of hoRow  to bGroupRow
                End

                If (bGroupRow) Begin
                    Send Popup of hoContextMenu_Groups
                    Set ComFocusedRow to vRow
                End
                Else Begin
                    Send Popup of hoContextMenu_GridArea
                End
            End
        End
        Set peHitTest to eRC_HitTest_None
    End_Procedure

