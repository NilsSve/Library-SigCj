    Procedure OnComRowDblClick Variant llRow Variant llItem
        String  sID
        Boolean bGroup
        Handle  hoRow hoRec
        Variant  vRow  vRec

        Get phoGridRow    to hoRow
        Get phoGridRecord to hoRec

        Set pvComObject of hoRow to llRow

        Get ComRecord of hoRow to vRec
        Get ComGroupRow of hoRow to bGroup
        If (not(bGroup)) Begin
            Set pvComObject of hoRec to vRec

            Get ComTag of hoRec to sID

            If (pbRowID_Mode(Self)) Begin
                Send OnDouble_Click_RowID (DeserializeRowID(sID))
            End
            Else Begin
                Send OnDouble_Click sID
            End
        End
    End_Procedure

