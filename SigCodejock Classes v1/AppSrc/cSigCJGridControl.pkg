    Procedure Set pbGroup_Sorted_Columns Boolean bState
        Variant vOrder
        Handle  hoOrder

        Get phoGridColumnOrder to hoOrder
        Set ComShowItemsInGroups to bState

        If (not(bState)) Begin
            Get ComGroupsOrder to vOrder
            Set pvComObject    of hoOrder to vOrder
            Send ComDeleteAll  of hoOrder

            Get ComSortOrder   to vOrder
            Set pvComObject    of hoOrder to vOrder
            Send ComDeleteAll  of hoOrder
        End

        Send ComPopulate
    End_Procedure

    {MethodType=Method DesignTime=False}
    Procedure Remove_Sorted_Columns
        Variant vOrder
        Handle  hoOrder

        Get phoGridColumnOrder to hoOrder
        Get ComSortOrder   to vOrder
        Set pvComObject    of hoOrder to vOrder
        Send ComDeleteAll  of hoOrder
        Send ComPopulate
    End_Procedure

    //=========================================================================
    //Selection

    {MethodType=Method DesignTime=False}
    Procedure SelectAll
        Integer iCount iRow
        Handle  hoGrid_Rows hoRow
        Variant vGrid_Rows  vRow

        Get phoGridRows to hoGrid_Rows
        Get phoGridRow  to hoRow

        Get ComRows to vGrid_Rows
        Set pvComObject of hoGrid_Rows to vGrid_Rows

        Get ComCount of hoGrid_Rows to iCount
        Decrement iCount
        For iRow from 0 to iCount
            Get ComRow of hoGrid_Rows iRow to vRow
            Set pvComObject of hoRow to vRow
            Set ComSelected of hoRow to True
        Loop
        Send Selected_Row_Count
    End_Procedure

    //-------------------------------------------------------------------------

    {MethodType=Method DesignTime=False}
    Procedure DeselectAll
        Variant vSelected_Rows
        Handle  hoSelected_Rows

        Get phoGridSelectedRows to hoSelected_Rows
        Get ComSelectedRows to vSelected_Rows
        Set pvComObject of hoSelected_Rows to vSelected_Rows
        Send ComDeleteAll of hoSelected_Rows
        Send Selected_Row_Count
    End_Procedure

    //-------------------------------------------------------------------------

    {MethodType=Method DesignTime=False}
    Procedure Invert_Selection
        Integer iCount iRow
        Handle  hoGrid_Rows hoRow
        Variant vGrid_Rows  vRow

        Get phoGridRows to hoGrid_Rows
        Get phoGridRow  to hoRow

        Get ComRows to vGrid_Rows
        Set pvComObject of hoGrid_Rows to vGrid_Rows

        Get ComCount of hoGrid_Rows to iCount
        Decrement iCount
        For iRow from 0 to iCount
            Get ComRow of hoGrid_Rows iRow to vRow
            Set pvComObject of hoRow to vRow
            Set ComSelected of hoRow to (not(ComSelected(hoRow)))
        Loop
        Send Selected_Row_Count
    End_Procedure

    //-------------------------------------------------------------------------

    Procedure Find_Row_Tag String sValue
        Boolean bGroupRow
        Integer iCount iRow
        RowID   Row_ID
        String  sID
        Handle  hoGrid_Rows hoRow hoRec
        Variant  vGrid_Rows vRow   vRec

        Get phoGridRows to hoGrid_Rows
        Get phoGridRow          to hoRow
        Get phoGridRecord       to hoRec

        Get ComRows to vGrid_Rows
        Set pvComObject of hoGrid_Rows to vGrid_Rows

        Get ComCount of hoGrid_Rows to iCount
        Decrement iCount
        For iRow from 0 to iCount
            Get ComRow of hoGrid_Rows iRow to vRow
            Set pvComObject of hoRow to vRow

            Get ComGroupRow of hoRow to bGroupRow
            If (not(bGroupRow)) Begin
                Get ComRecord   of hoRow to vRec
                Set pvComObject of hoRec to vRec

                Get ComTag      of hoRec to sID

                If (sID = sValue) Begin
                    Set ComFocusedRow to vRow
                    Send OnComFocusChanging vRow Nothing Nothing Nothing
                    Move (iCount + 1) to iRow
                End
            End
        Loop
    End_Procedure

