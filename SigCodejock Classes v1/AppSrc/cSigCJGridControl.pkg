    Procedure End_Construct_Object
        Forward Send End_Construct_Object

        Send Initialise_Column_Formats
    End_Procedure

    Procedure ReleaseComObject
        //The order of this may be important... not sure... currently does what is expected!
        If (IsComObject(phoGridRecords            (Self))) Set pvComObject of (phoGridRecords           (Self)) to (NullComObject())
        If (IsComObject(phoGridRecord             (Self))) Set pvComObject of (phoGridRecord            (Self)) to (NullComObject())
        If (IsComObject(phoGridRecordItem         (Self))) Set pvComObject of (phoGridRecordItem        (Self)) to (NullComObject())
        If (IsComObject(phoGridRecordItemMetrics  (Self))) Set pvComObject of (phoGridRecordItemMetrics (Self)) to (NullComObject())
        If (IsComObject(phoGridColumns            (Self))) Set pvComObject of (phoGridColumns           (Self)) to (NullComObject())
        If (IsComObject(phoGridColumn             (Self))) Set pvComObject of (phoGridColumn            (Self)) to (NullComObject())
        If (IsComObject(phoGridColumnOrder        (Self))) Set pvComObject of (phoGridColumnOrder       (Self)) to (NullComObject())
        If (IsComObject(phoGridRows               (Self))) Set pvComObject of (phoGridRows              (Self)) to (NullComObject())
        If (IsComObject(phoGridRow                (Self))) Set pvComObject of (phoGridRow               (Self)) to (NullComObject())
        If (IsComObject(phoGridGroupRow           (Self))) Set pvComObject of (phoGridGroupRow          (Self)) to (NullComObject())
        If (IsComObject(phoGridSelectedRows       (Self))) Set pvComObject of (phoGridSelectedRows      (Self)) to (NullComObject())
        If (IsComObject(phoGridPaintManager       (Self))) Set pvComObject of (phoGridPaintManager      (Self)) to (NullComObject())
        If (IsComObject(phoGridPrintOptions       (Self))) Set pvComObject of (phoGridPrintOptions      (Self)) to (NullComObject())
        If (IsComObject(phoPrintPageHeaderFooter  (Self))) Set pvComObject of (phoPrintPageHeaderFooter (Self)) to (NullComObject())
        If (IsComObject(phoHitTestInfo            (Self))) Set pvComObject of (phoHitTestInfo           (Self)) to (NullComObject())
        If (IsComObject(phoFont                   (Self))) Set pvComObject of (phoFont                  (Self)) to (NullComObject())
        If (IsComObject(phoContextMenu_Header     (Self))) Set pvComObject of (phoContextMenu_Header    (Self)) to (NullComObject())
        If (IsComObject(phoContextMenu_GroupBox   (Self))) Set pvComObject of (phoContextMenu_GroupBox  (Self)) to (NullComObject())
        If (IsComObject(phoContextMenu_Groups     (Self))) Set pvComObject of (phoContextMenu_Groups    (Self)) to (NullComObject())
        If (IsComObject(phoContextMenu_GridArea   (Self))) Set pvComObject of (phoContextMenu_GridArea  (Self)) to (NullComObject())

        // Get phoIdleHandler to hoIdle
        If (oSigCJGridIdleHandler(Self) <> 0) Set pbEnabled of (oSigCJGridIdleHandler(Self)) to False

        Forward Send ReleaseComObject
    End_Procedure

    //~~~~~~~~~~~~~~~~~~~~~~~~~~

    Function CreateFieldChooserPanel Returns Handle
        Handle hoFieldChooserPanel

        Get Create U_cSigCjGridFieldChooserPanel to hoFieldChooserPanel
        Set phoGridObject of hoFieldChooserPanel to Self

        Function_Return hoFieldChooserPanel
    End_Function

    Procedure AttachFieldChooser Handle hoFieldChooser Boolean bAttach
        Variant vFieldChooser

        If (IsComObjectCreated(Self) and hoFieldChooser <> 0) Begin
            If bAttach Begin
                Get pvComObject of hoFieldChooser to vFieldChooser
            End
            Else Begin
                Move (NullComObject()) to vFieldChooser
            End
            Set ComFieldChooser to vFieldChooser
        End
    End_Procedure  // AttachFieldChooser

    //~~~~~~~~~~~~~~~~~~~~~~~~~~

    Procedure Reset_Data_Properties
        Set pbAuto_Columns        to False
        Set pbAuto_Row_Ref        to True
        Set phoDD                 to 0
        Set pbDescending          to False
        Set ptsTimeSpan_Load      to ""
        Set ptsTimeSpan_SQL       to ""
        Set piMax_Rows            to 0
        Set piRef_Column          to 0
        Set pbRowID_Mode          to False
        Set pbShow_Recnum         to False
        Set pbSQL_Case            to False
        Set psSQL_From            to ""
        Set psSQL_OrderBy         to ""
        Set psSQL_Select          to ""
        Set psSQL_Select_Statment to ""
        Set psSQL_Where           to ""
        Set pbAlwaysRebuild_SQL   to False
        Set piTable_Index         to 0

        Set Private_piRow_Count             to 0
        Set Private_piFiltered_Row_Count    to 0
        Set Private_piSelected_Row_Count    to 0
    End_Procedure

    //-------------------------------------------------------------------------
    // Support for Obsolete Code

    { Category="CodeJock" InitialValue=True }
    { Obsolete=True }
    Procedure Set pbNormal_Find_Method Boolean bOk
        If (bOk) Set peDataflex_Table_Find_Method to eRC_Find_Normal
        Else Set peDataflex_Table_Find_Method to eRC_Find_Constrained
    End_Procedure
    // Use Set peDataflex_Table_Find_Method to eRC_Find_Normal
    // Options eRC_Find_Normal eRC_Find_RequestRead eRC_Find_Constrained


    //-------------------------------------------------------------------------

    {Category="CodeJock" MethodType=Method}
    Procedure SetWatermark
        Boolean bWatermarkFromFile bRetval
        Integer iWatermarkWeight iWatermarkAlignment iImageId
        String  sWatermarkBitmap sBitmapPath

        Get psWatermarkBitmap    to sWatermarkBitmap
        Get piWatermarkWeight    to iWatermarkWeight
        Get piWatermarkAlignment to iWatermarkAlignment
        Get pbWatermarkFromFile  to bWatermarkFromFile

        Set ComWatermarkAlignment to iWatermarkAlignment

        If (sWatermarkBitmap <> "") Begin
            If (bWatermarkFromFile) Begin
                Get psBitmapPath of (phoWorkspace(ghoApplication))        to sBitmapPath
                Move (Append(sBitmapPath,String("\" + sWatermarkBitmap))) to sBitmapPath
                Get ComSetWatermarkBitmapFromFile sBitmapPath iWatermarkWeight to bRetval
            End
            Else Begin
                Get AddImage of ghoSigCjGlobalSetting sWatermarkBitmap 0 OLExtpImageNormal to iImageId
                Get ComSetWatermarkBitmap iImageId iWatermarkWeight to bRetval
//                If (IsComObjectCreated(Self)) Set ComIcon to iImageId
            End
        End
    End_Procedure

    {Category="CodeJock" MethodType=Property InitialValue=True }
    Procedure Set pbMultipleSelection Boolean bValue
        Set SigCJProperty Set_Private_pbMultipleSelection Set_ComMultipleSelection to bValue
    End_Procedure

    Function pbMultipleSelection Returns Boolean
        Function_Return (SigCJProperty(Self, Get_Private_pbMultipleSelection, Get_ComMultipleSelection))
    End_Function

    {Category="CodeJock" MethodType=Property InitialValue=False }
    Procedure Set pbAutoColumnSizing Boolean bValue
        Set SigCJProperty Set_Private_pbAutoColumnSizing Set_ComAutoColumnSizing to bValue
    End_Procedure

    Function pbAutoColumnSizing Returns Boolean
        Function_Return (SigCJProperty(Self, Get_Private_pbAutoColumnSizing, Get_ComAutoColumnSizing))
    End_Function

    {Category="CodeJock" MethodType=Property InitialValue=True }
    Procedure Set pbShowFooter Boolean bValue
