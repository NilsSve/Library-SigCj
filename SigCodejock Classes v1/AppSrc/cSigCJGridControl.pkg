    Procedure CSV_Export
        Boolean bComer
        Integer iCount iRow iColumn iColumn_Count iWidth iChannel
        RowID   Row_ID
        String  sID sValue sExport_File
        Handle  hoGrid_Rows hoRow hoRec hoItem
        Variant  vGrid_Rows vRow   vRec  vItem
        tdRC_Column_Def[] tColumn_Defs

        Get phoGridSelectedRows to hoGrid_Rows
        Get phoGridRow          to hoRow
        Get phoGridRecord       to hoRec
        Get phoGridRecordItem   to hoItem

        Get ptColumn_Defs         to tColumn_Defs
        Get piColumn_Count        to iColumn_Count

        Set psExport_File to ""
        Send Popup of oCSV_Export_Dialog
        Get psExport_File to sExport_File

        If (sExport_File <> "") Begin
            Move (Seq_New_Channel()) to iChannel
            Direct_Output channel iChannel sExport_File

            Get ComSelectedRows to vGrid_Rows
            Set pvComObject of hoGrid_Rows to vGrid_Rows

            // Output header
            Move (False) to bComer
            For iColumn from 0 to iColumn_Count
                If (tColumn_Defs[iColumn].iSize > 0) Begin
                    If (bComer) Write channel iChannel ","
                    Write channel iChannel ('"' + String(tColumn_Defs[iColumn].sLabel) + '"')
                    Move (True) to bComer
                End
            Loop
            Writeln channel iChannel ""

            Get ComCount of hoGrid_Rows to iCount
            Decrement iCount
            For iRow from 0 to iCount
                Get ComRow of hoGrid_Rows iRow to vRow
                Set pvComObject of hoRow to vRow

                If (ComSelected(hoRow)) Begin
                    If (not(ComGroupRow(hoRow))) Begin
                        Get ComRecord of hoRow to vRec
                        Set pvComObject of hoRec to vRec

                        Move (False) to bComer
                        For iColumn from 0 to iColumn_Count
                            Get ComItem     of hoRec  iColumn to vItem
                            Set pvComObject of hoItem         to vItem
                            Get ComCaption  of hoItem         to sValue
                            If (tColumn_Defs[iColumn].iSize > 0) Begin
                                If (bComer) Write channel iChannel ","
                                Write channel iChannel ('"' + String(sValue) + '"')
                                Move (True) to bComer
                            End
                        Loop
                        Writeln channel iChannel ""
                    End //bGroupRow
                End
            Loop
            Close_Output  channel iChannel sExport_File
            Send Seq_Release_Channel iChannel
        End
    End_Procedure

    //-------------------------------------------------------------------------

    Procedure Process_Rows
        Integer iCount iRow iColumns iCol
        Boolean bCancel
        RowID   Row_ID
        String  sID  sProcess_Type
        Handle  hoGrid_Rows hoRow hoRec hoItem
        Variant  vGrid_Rows vRow   vRec  vItem
        String[] sData

        tdRC_Column_Def[] tColumn_Defs

        Get ptColumn_Defs         to tColumn_Defs
        Get phoGridSelectedRows to hoGrid_Rows
        Get phoGridRow          to hoRow
        Get phoGridRecord       to hoRec
        Get phoGridRecordItem   to hoItem

        Get ComSelectedRows to vGrid_Rows
        Set pvComObject of hoGrid_Rows to vGrid_Rows

        Get piColumn_Count to iColumns
        Get psProcess_Type to sProcess_Type

        Get ComCount of hoGrid_Rows to iCount
        Send OnPre_Process_Rows iCount

        Decrement iCount
        For iRow from 0 to iCount
            Get ComRow of hoGrid_Rows iRow to vRow
            Set pvComObject of hoRow to vRow

            If (ComSelected(hoRow)) Begin
                Get ComRecord of hoRow to vRec
                Set pvComObject of hoRec to vRec

                If (not(ComGroupRow(hoRow))) Begin
                    Get ComTag of hoRec to sID

                    //--- Get Column Data ---
                    Move (ResizeArray(sData,0)) to sData
                    For iCol from 0 to iColumns
                        Get ComItem of hoRec iCol to vItem
                        Set pvComObject of hoItem to vItem
                        If (tColumn_Defs[iCol].eStyle = eRC_Preview) Begin
                            Get ComPreviewText of hoRec to sData[iCol]
                        End
                        Else Begin
                            If (tColumn_Defs[iCol].eStyle = eRC_CheckBox) Begin
                                Get ComChecked of hoItem to sData[iCol]
                            End
                            Else Begin
                                Get ComValue of hoItem to sData[iCol]
                            End
                        End
                    Loop
                    Set psData_Items to sData
                    //--- Get Column Data ---

                    If (pbRowID_Mode(Self)) Begin
                        Move (DeserializeRowID(sID)) to Row_ID
                        Send OnProcess_Rows_RowID Row_ID sProcess_Type (&bCancel)
                    End
                    Else Begin
                       Send OnProcess_Rows sID sProcess_Type (&bCancel)
                    End
                End //bGroupRow
            End
            If (bCancel) Move (iCount+1) to iRow
        Loop
        Send OnPost_Process_Rows bCancel
    End_Procedure

    Procedure OnPre_Process_Rows Integer iRow_Count
        // Event Hook
    End_Procedure

    Procedure OnProcess_Rows String sID String sProcess_Type Boolean ByRef bCancel
        // Event Hook
    End_Procedure

    Procedure OnProcess_Rows_RowID RowID Row_ID String sProcess_Type Boolean ByRef bCancel
        // Event Hook
    End_Procedure

    Procedure OnPost_Process_Rows Boolean bCancel
        // Event Hook
    End_Procedure

    //-------------------------------------------------------------------------

    Procedure OnComFocusChanging Variant llNewRow Variant llNewColumn Variant llNewItem Boolean ByRef llCancel
        Boolean bFound bGroup
        Integer iTable eDb_Type
        String  sID
        Handle  hoRow hoRec
        Variant  vRow  vRec

        Get phoGridRow    to hoRow
        Get phoGridRecord to hoRec

        If (pbActive_Track(Self)) Begin
            Set pvComObject of hoRow to llNewRow

            Get ComRecord of hoRow to vRec
            Get ComGroupRow of hoRow to bGroup
            If (not(bGroup)) Begin
                Set pvComObject of hoRec to vRec

                Get ComTag of hoRec to sID
                Set psCurrent_Tag   to sID

                If (pbRowID_Mode(Self)) Begin
                    If (phoDD(Self) > 0) Begin
                        Move (Main_File(phoDD(Self))) to iTable
                        Send FindByRowId of (phoDD(Self)) iTable (DeserializeRowID(sID))
                        Send OnActive_Track sID
                    End
                 End
                 Else Begin
                    Send OnActive_Track sID
                End
            End
        End
    End_Procedure

    Procedure OnActive_Track String sID
        // Event Hook
    End_Procedure

