Use SigCjW_GridControl.pkg
Use cSigCJMethods_Mixin.pkg
Use cSigCJGlobalSettings.pkg
Use cSigCJPropEx_Mixin.pkg
Use cSigCJGridControlContextMenu.pkg
Use cSigCJGridFieldChooser.pkg
Use gFormatNumbers.pkg
Use CSV_Export.dg
Use StdFont.pkg

Register_Function pbRefreshRequired Returns Boolean

Class cSigCJGridIdleHandler is a cIdleHandler

    Procedure OnIdle
        If (pbRefreshRequired(Self)) Begin
            Delegate Send Refresh_Grid
            Set pbRefreshRequired to False
        End
        If (pbNeedsRedraw(Self)) Begin
            Delegate Send ComRedraw
            Set pbNeedsRedraw to False
        End
    End_Procedure

End_Class

Class cSigCJGridColumn is a cSigCjComGridColumn
    Import_Class_Protocol cSigCJMethods_Mixin

    Procedure Construct_Object
        Forward Send Construct_Object

        { Visibility=Private }
        { MethodType=Property }
        Property String Private.psImage
        { Visibility=Private }
        { MethodType=Property }
        Property Integer Private.piImage
    End_Procedure


    { MethodType=Property }
    { Category="CodeJock" }
    Procedure Set psImage String sImage
        Integer iImageId
        Variant vImage

        Get AddImage    of ghoSigCjGlobalSetting sImage 0 OLExtpImageNormal to iImageId
        Set Private.piImage to iImageId

        If (IsComObjectCreated(Self)) Set ComIcon to iImageId
    End_Procedure

    { MethodType=Property }
    { Category="CodeJock" }
    Function psImage Returns String
        Function_Return (Private.psImage(Self))
    End_Function

End_Class


Class cSigCJGridRecordItem is a cSigCjComGridRecordItem
    Import_Class_Protocol cSigCJMethods_Mixin

    Procedure Construct_Object
        Forward Send Construct_Object

        { Visibility=Private }
        { MethodType=Property }
        Property String Private.psImage
        { Visibility=Private }
        { MethodType=Property }
        Property Integer Private.piImage
    End_Procedure


    { MethodType=Property }
    { Category="CodeJock" }
    Procedure Set psImage String sImage
        Integer iImageId
        Variant vImage

        Get AddImage    of ghoSigCjGlobalSetting sImage 0 OLExtpImageNormal to iImageId
        Set Private.piImage to iImageId

        If (IsComObjectCreated(Self)) Set ComIcon to iImageId
    End_Procedure

    { MethodType=Property }
    { Category="CodeJock" }
    Function psImage Returns String
        Function_Return (Private.psImage(Self))
    End_Function

End_Class


