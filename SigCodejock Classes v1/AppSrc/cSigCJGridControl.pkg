    Procedure OnCreate
        Handle  hoGridPaintManager hoGridPrintOptions hoGridNavigator hoFieldChooserPanel hoFont
        Handle  hoContextMenu_GroupBox hoContextMenu_Groups hoContextMenu_Header hoContextMenu_GridArea
        Variant vImageList vFont
        String  sFontName
        Number  nFontSize
        Integer iColor

        Forward Send OnCreate
        // Force set the default of AutoColumnSizing as in Codejock it's True and we have set it to be False
        Set ComMultipleSelection  to (Private_pbMultipleSelection(Self))
        Set ComAutoColumnSizing   to (Private_pbAutoColumnSizing(Self))
        // Set ComAutoColumnSizing   to (pbAutoColumnSizing(Self))

        Get phoGridPaintManager to hoGridPaintManager
        Get phoGridPrintOptions to hoGridPrintOptions
        Get phoGridNavigator    to hoGridNavigator

        //Attach the Grid control paint manager and Print options to the DataFlex objects.
        //(Only one of each object, so leave attached)
        Set pvComObject of hoGridPaintManager to (ComPaintManager(Self))
        Set pvComObject of hoGridPrintOptions to (ComPrintOptions(Self))
        Set pvComObject of hoGridNavigator    to (ComNavigator(Self))

        //Setup Paint Manager
        #IF (SigCj_Codejock_Version < 150001)
            Set ComColumnStyle       of hoGridPaintManager to OLExtpColumnOffice2007
        #ELSE
            Set ComColumnStyle       of hoGridPaintManager to OLExtpColumnResource
        #ENDIF
        Set ComBorderStyle       to OLExtpBorderThemedFrame
        Set ComFixedRowHeight    of hoGridPaintManager to False    //Allow multi row items
        Set ComVerticalGridStyle of hoGridPaintManager to OLExtpGridNoLines

        If (piMaxPreviewLines(Self) > 0) Set ComMaxPreviewLines of hoGridPaintManager to (piMaxPreviewLines(Self))
        If (psNoItemsText(Self) > '')    Set ComNoItemsText     of hoGridPaintManager to (psNoItemsText(Self))

        // Setup Print Options
        If (pbPrintLandscape(Self)) Set ComLandscape of hoGridPrintOptions to True

        // Setup Fonts
        Get psGridFontName to sFontName
        Get pnGridFontSize to nFontSize
        If ((sFontName <> "") or (nFontSize > 0)) Begin
            Set ComFixedRowHeight of hoGridPaintManager to False
            Get phoFont to hoFont
            Get ComTextFont of hoGridPaintManager to vFont
            Set pvComObject of hoFont to vFont
            If (sFontName <> "") Set ComName of hoFont to sFontName
            If (nFontSize > 0)   Set ComSize of hoFont to nFontSize
        End
        Get psPreviewFontName to sFontName
        Get pnPreviewFontSize to nFontSize
        If ((sFontName <> "") or (nFontSize > 0)) Begin
            Set ComFixedRowHeight of hoGridPaintManager to False
            Get phoFont to hoFont
            Get ComPreviewTextFont of hoGridPaintManager to vFont
            Set pvComObject of hoFont to vFont
            If (sFontName <> "") Set ComName of hoFont to sFontName
            If (nFontSize > 0)   Set ComSize of hoFont to nFontSize
        End

        //Grab the default selected back color.
        Get ComHighlightBackColor of hoGridPaintManager to iColor
        Set Private_DefaultSelectedBackColor to iColor

        // Setup Icons
        Get ComIcons of ghoSigCjGlobalSetting to vImageList
        Set ComIcons to vImageList

        // Show Group Box
        Set ComShowGroupBox      to (pbShowGroupBox(Self))

        // Show Footer
        If (pbEnableTotals(Self)) Begin
            Set ComShowFooter  to (Private_pbShowFooter(Self))
        End
        If (pbShade_Column_On_Sort(Self)) Begin
            Set ComShadeSortColumn of (phoGridPaintManager(Self)) to True
        End

        Send SetWatermark

        Get CreateFieldChooserPanel to hoFieldChooserPanel
        Set phoFieldChooser to hoFieldChooserPanel

        // Add Context Menu option hooks
        Get phoContextMenu_GroupBox   to hoContextMenu_GroupBox
        Get phoContextMenu_Groups     to hoContextMenu_Groups
        Get phoContextMenu_Header     to hoContextMenu_Header
        Get phoContextMenu_GridArea to hoContextMenu_GridArea
        If (Object_Id(hoContextMenu_GroupBox))   Send OnAdd_ContextMenu_GroupBox   hoContextMenu_GroupBox
        If (Object_Id(hoContextMenu_Groups))     Send OnAdd_ContextMenu_Groups     hoContextMenu_Groups
        If (Object_Id(hoContextMenu_Header))     Send OnAdd_ContextMenu_Header     hoContextMenu_Header
        If (Object_Id(hoContextMenu_GridArea)) Send OnAdd_ContextMenu_GridArea hoContextMenu_GridArea

        #IF (SigCj_Codejock_Version > 160300)
            Send ComSetCustomDraw OLExtpCustomBeforeDrawRow
        #ENDIF

        //If auto fill then do so
        If (pbAuto_Fill(Self)) Begin
            Send Rebuild_Grid
        End

        Send Standard_PrintFooter
        Set pbEnabled of (oSigCJGridIdleHandler(Self)) to True
    End_Procedure

    #IF (SigCj_Codejock_Version > 160300)
        Procedure OnComBeforeDrawRow Variant llRow Variant llItem Variant llMetrics
            Handle  hoMetrics hoRow
            Variant vFocusedRow
            Integer iBackColour
            Integer iRed iGreen iBlue
            Number  nShade

            If (pbShade_Row(Self)) Begin
                Get phoGridRow to hoRow
                Set pvComObject  of hoRow to llRow
                Get phoGridRecordItemMetrics to hoMetrics
                Set pvComObject   of hoMetrics to llMetrics

                Get ComBackColor of hoMetrics to iBackColour
                Get ComFocusedRow to vFocusedRow

                If ((IsSameComObject(vFocusedRow, llRow)) or (ComSelected(hoRow))) Begin
                    Get ComBackColor of hoMetrics to iBackColour
                    Get pnShade to nShade
                    Get R_From_RGB iBackColour to iRed
                    Get G_From_RGB iBackColour to iGreen
                    Get B_From_RGB iBackColour to iBlue
                    Move ( RGB(Mod(iRed * nShade, 256), Mod(iGreen * nShade, 256), Mod(iBlue * nShade, 256)) ) to iBackColour
                    Set ComBackColor of hoMetrics to iBackColour
                End
            End
        End_Procedure
    #ENDIF

    //=========================================================================
    // Count Hooks
    {MethodType=Method DesignTime=False}
    Procedure Grid_Row_Count
        Integer iRowCount
        Handle  hoRecords
        Variant  vRecords

        Get phoGridRecords         to hoRecords
        Get ComRecords               to  vRecords
        Set pvComObject of hoRecords to  vRecords
        Get ComCount    of hoRecords to  iRowCount
        Set Private_piRow_Count to iRowCount

        Send OnGrid_Row_Count iRowCount
    End_Procedure

    Procedure OnGrid_Row_Count Integer iRow_Count
        // Hook
    End_Procedure

    {MethodType=Method DesignTime=False}
    Procedure Filtered_Row_Count
        Integer iGroupCount iFiltered_Count iRow
        Boolean bGroupRow
        Handle  hoGridRows hoRow
        Variant  vGridRows  vRow

        Get phoGridRows               to hoGridRows
        Get phoGridRow                 to hoRow
        Get ComRows                     to  vGridRows
        Set pvComObject of hoGridRows to  vGridRows
        Get ComCount    of hoGridRows to  iFiltered_Count

        Decrement iFiltered_Count
        For iRow from 0 to iFiltered_Count
            Get ComRow of hoGridRows iRow to vRow
            Set pvComObject of hoRow to vRow
            Get ComGroupRow of hoRow to bGroupRow
            If (bGroupRow) Increment iGroupCount
        Loop
        Set Private_piFiltered_Row_Count to (iFiltered_Count - iGroupCount +1)

        Send OnFiltered_Row_Count (iFiltered_Count - iGroupCount +1)
    End_Procedure

    Procedure OnFiltered_Row_Count Integer iFiltered_Count
        // Hook
    End_Procedure

    {MethodType=Method DesignTime=False}
    Procedure Selected_Row_Count
        Integer iSelectedCount
        Handle  hoSelectedRows
        Variant vSelectedRows

        Get phoGridSelectedRows         to hoSelectedRows
        Get ComSelectedRows               to  vSelectedRows
        Set pvComObject of hoSelectedRows to  vSelectedRows
        Get ComCount    of hoSelectedRows to  iSelectedCount
        Set Private_piSelected_Row_Count  to  iSelectedCount

        Send OnSelected_Row_Count iSelectedCount
    End_Procedure

    Procedure OnSelected_Row_Count Integer iSelectedCount
        // Hook
    End_Procedure

    Procedure Shade_Row
        Boolean bGroupRow
        Handle  hoRow hoRecord hoItem hoSelectedRows
        Variant  vRow  vRecord  vItem
        Integer iBackColour iCount iDefaultBackColor
        Integer iRed iGreen iBlue
        Number  nTint

        If (pbShade_Row(Self)) Begin
            Get Private_DefaultSelectedBackColor to iDefaultBackColor

            Get phoGridSelectedRows to hoSelectedRows
            If (IsComObject(pvComObject(hoSelectedRows))) Begin
                Get ComCount of (phoGridSelectedRows(Self)) to iCount
            End
            If (iCount <= 1) Begin
                Get ComFocusedRow   to  vRow
                Get phoGridRow    to hoRow
                Set pvComObject     of hoRow to vRow
                If (IsComObject(vRow)) Begin
                    Get ComGroupRow     of hoRow to bGroupRow
                    If (not(bGroupRow)) Begin
                        Get ComRecord       of hoRow to vRecord

                        Get phoGridRecord to hoRecord
                        Set pvComObject     of hoRecord to vRecord
                        Get ComItem         of hoRecord 0 to vItem

                        Get phoGridRecordItem to hoItem
                        Set pvComObject         of hoItem to vItem
                        Get ComBackColor        of hoItem to iBackColour

                        Get R_From_RGB iBackColour to iRed
                        Get G_From_RGB iBackColour to iGreen
                        Get B_From_RGB iBackColour to iBlue

                        Get pnShade to nTint
                        Move ( RGB(Mod(iRed * nTint, 256), Mod(iGreen * nTint, 256), Mod(iBlue * nTint, 256)) ) to iBackColour
                    End
                End
            End

            //Over ride if necessary
            If ((iCount > 1) or (bGroupRow)) Begin
                Move iDefaultBackColor to iBackColour
            End

            Set ComSelectedRowBackColor of (phoGridPaintManager(Self)) to iBackColour
            Set ComHighlightBackColor   of (phoGridPaintManager(Self)) to iBackColour
        End
    End_Procedure

    Procedure OnComSelectionChanged
        Send Selected_Row_Count
        #IF (SigCj_Codejock_Version < 160301)
            Send Shade_Row
        #ENDIF
    End_Procedure

    //=========================================================================
    //General

    Procedure Rebuild_Grid
        Boolean bColumn_Resort
        Integer iRowCount

        Get pbColumn_Resort to bColumn_Resort
        // On Rebuilding the Grid we must reset the Column sort order
        Set pbColumn_Resort to True

        Send DoReset_Grid_Control //delete any data and column definitions
        Send DoDefine_Columns       //define the columns
        Send DoLoad_Data            //load the data
        Send ComPopulate            //display it

        //Send DoBest_Fit

        Set ComTopRowIndex to 0     //Insure we're at the top

        Send Grid_Row_Count
        Send Resync_to_Focus_Row

        If (pbDefaultLayout(Self) = False) Send PX_Load
        Set ComAutoColumnSizing    to (pbAutoColumnSizing(Self))
        Set ComShowGroupBox        to (pbShowGroupBox(Self))
        Set ComShowItemsInGroups   to False
        Send Remove_Sorted_Columns
        Set pbColumn_Resort to bColumn_Resort
        Get Private_piRow_Count to iRowCount
        If (iRowCount > 0) Begin
            If (pbEnableTotals(Self)) Send DoGroupCalculation
            #IF (SigCj_Codejock_Version < 160301)
                Send Shade_Row
            #ENDIF
        End
    End_Procedure

    // Refresh_Grid when idle
    Procedure Deferred_Refresh_Grid
        If (IsComObjectCreated(Self)) Begin
            Set pbRefreshRequired to True
        End
    End_Procedure

    // Redraw the control
    Procedure DeferredRedraw
        Set pbNeedsRedraw to True
     End_Procedure

    // User hook sent at the start of the Refresh_Grid method
    Procedure OnRefresh_Grid
    End_Procedure

    Procedure Refresh_Grid
        Send OnRefresh_Grid

        If ((piColumn_Count(Self) = 0) or (pbAuto_Fill(Self) = False)) Begin
            // No Count then not column data created, so build the Grid
            Send DoReset_Grid_Control //delete any data and column definitions
            Send DoDefine_Columns       //define the columns
            If ((pbAuto_Fill(Self) = False) and (pbPX_Save_Layout(Self) = True)) Send PX_Load
        End
        Else Begin
            Send DoRefresh_Grid_Control
            If (peDb_Type(Self) = eRC_db_SQL) Send Build_SQL_Statement
        End
        Send DoLoad_Data            //load the data
        Send ComPopulate            //display it
        //Send DoBest_Fit

        Set ComTopRowIndex to 0     //Insure we're at the top
        Send Grid_Row_Count
        Send Resync_to_Focus_Row
        If (pbEnableTotals(Self)) Send DoGroupCalculation
    End_Procedure

    Procedure Resync_to_Focus_Row
        Variant vRow

        Get ComFocusedRow to vRow
        If (not(IsNullComObject(vRow))) Begin
            Send OnComFocusChanging vRow Nothing Nothing Nothing
            #IF (SigCj_Codejock_Version < 160301)
                Send Shade_Row
            #ENDIF
        End
        Send Filtered_Row_Count
        Send Selected_Row_Count
    End_Procedure

    Procedure Filter_Rows String sValue
        Set ComFilterText to sValue
        Send ComPopulate
        Send Resync_to_Focus_Row
    End_Procedure

    //-------------------------------------------------------------------------

    Procedure DoReset_Grid_Control
        Handle hoColumns
        Variant vColumns
        tdRC_Column_Def[] tColumn_Defs

        Get phoGridColumns     to hoColumns

        Send DoDelete_Grid_Data

        //delete Grid control column objects
        Get ComColumns to vColumns
        Set pvComObject of hoColumns to vColumns
        Send ComDeleteAll of hoColumns

        //Clear the columns defs
        Set ptColumn_Defs to tColumn_Defs
        Set Private_piColumn_Count to 0
    End_Procedure

    Procedure DoRefresh_Grid_Control
        Send DoDelete_Grid_Data
    End_Procedure

    Procedure DoDelete_Grid_Data
        Integer iColumns iCol
        Handle  hoRecords hoColumns hoColumn
        Variant  vRecords vColumns   vColumn

        Get phoGridRecords to hoRecords

        //delete any data
        Get ComRecords to vRecords
        Set pvComObject of hoRecords to vRecords
        Send ComDeleteAll of hoRecords

        //Need to remove any calculated footer totals
        If (pbEnableTotals(Self)) Begin
            Get phoGridColumns to hoColumns
            Get phoGridColumn to hoColumn

            Get ComColumns               to vColumns
            Set pvComObject of hoColumns to vColumns
            Get ComCount of hoColumns to iColumns
            Decrement iColumns
            For iCol from 0 to iColumns
                Get ComColumn of hoColumns iCol to vColumn
                Set pvComObject of hoColumn to vColumn
                Set ComFooterText of hoColumn to " "
            Loop
        End
    End_Procedure

    //-------------------------------------------------------------------------

    Procedure DoDefine_Columns
        If (pbAuto_Columns(Self)) Begin
           Send Define_From_DD      //Use DD to create columns
        End
        Else Begin
            Send OnDefine_Columns   //Get user to specify column info
        End

        Send Create_Columns         //Ceate RC columns based on defined column info
    End_Procedure

    Procedure OnDefine_Columns
        // Event Hook
        //
        // Call Add_Column for each column
    End_Procedure

    //-------------------------------------------------------------------------

    {MethodType=Method DesignTime=False}
    Procedure Define_From_DD
        Boolean bShow_Recnum bShow
        Handle hoDD
        Integer iTable iColumns iLoop iTable_Type eType iSize  iNo_DP iVal_Type
        String sLabel sTable sColumn sTrue sFalse sEval

        Get pbShow_Recnum to bShow_Recnum
        Get phoDD to hoDD
        If (hoDD <> 0) Begin
            Move (Main_File(hoDD)) to iTable
            Get_Attribute DF_FILE_LOGICAL_NAME  of iTable to sTable
            Get_Attribute DF_FILE_NUMBER_FIELDS of iTable to iColumns

            For iLoop from 0 to iColumns
                Get_Attribute DF_FIELD_NAME      of iTable iLoop to sColumn
                Move True to bShow

                If (not(bShow_Recnum) and Uppercase(Trim(sColumn)) = "RECNUM") Move False to bShow

                //Can add logic in here to control display of overlap / inverse fields etc.

                If (bShow) Begin
                    Get_Attribute DF_FIELD_LENGTH    of iTable iLoop to iSize
                    Get_Attribute DF_FIELD_TYPE      of iTable iLoop to iTable_Type

                    Move -1 to eType    //stop un-handled types
                    If (iTable_Type = DF_ASCII    ) Move eRC_String   to eType
                    If (iTable_Type = DF_DATE     ) Move eRC_Date     to eType
                    If (iTable_Type = DF_DATETIME ) Move eRC_DateTime to eType
                    If (iTable_Type = DF_OVERLAP  ) Move eRC_String   to eType
                    If (iTable_Type = DF_TEXT     ) Move eRC_Text     to eType

                    If (iTable_Type = DF_BCD) Begin
                        Get_Attribute DF_FIELD_PRECISION of iTable iLoop to iNo_DP
                        If (iNo_DP > 0) Move eRC_Real    to eType
                        Else            Move eRC_Integer to eType
                    End

                    //Override eType eRC_String if size > 50
                    If ((pbWordWrap(Self) = True) and (eType = eRC_String) and (iSize > 50)) Begin
                         Move eRC_Text to eType  //Force word wrap
                         Move 50 to iSize
                    End

                    If (iSize < 8) Move 8 to iSize  //8 characters seems to be a good minimum size

                    Move (Field_Label_Short(hoDD,iLoop)) to sLabel
                    If (Trim(sLabel) = "") Move sColumn to sLabel

                    Move (Field_Validation_Type(hoDD,iLoop)) to iVal_Type
                    If (iVal_Type = FA_VALIDATION_TYPE_CHECKBOX) Begin
                        Move (Field_Checkbox_Value(hoDD,iLoop,True )) to sTrue
                        Move (Field_Checkbox_Value(hoDD,iLoop,False)) to sFalse

//Bug                        Move ("If(" - sTable - "." - sColumn - " = " - sTrue - ",'" - sTrue - "','" - sFalse - "')") to sEval
                        Move ("If(" - sTable - "." - sColumn - " = '" - sTrue - "', 1, 0)") to sEval
                        Send Add_Grid_Column sLabel (iSize * 8) eType eRC_CheckBox (sTable - "." - sColumn) sEval
                    End
                    Else Send Add_Grid_Column sLabel (iSize * 8) eType eRC_Standard (sTable - "." - sColumn) ""
                    //(iSize * 8) 8 pixels per char seems to give a good column width
                End
            Loop
        End
    End_Procedure

    //-------------------------------------------------------------------------
    //CAUTION :- Overloaded Function

    //For Text & CSV files
//    Procedure Add_Grid_Column Overloaded String sLabel Integer iSize Integer eDataType Short eStyle
//        tdRC_Column_Def[] tColumn_Defs
//        Integer iCount
//
//        Get ptColumn_Defs to tColumn_Defs
//        Move (SizeOfArray(tColumn_Defs)) to iCount
//
//        Move sLabel     to tColumn_Defs[iCount].sLabel
//        Move iSize      to tColumn_Defs[iCount].iSize
//        Move eDataType  to tColumn_Defs[iCount].eDataType
//        Move eStyle     to tColumn_Defs[iCount].eStyle
//
//        Set ptColumn_Defs to tColumn_Defs
//        Set Private_piColumn_Count to iCount
//    End_Procedure

    //For database & SQL files
    Procedure Add_Grid_Column String sLabel Integer iSize Integer eDataType Integer eStyle String sTC_Name String sEval Boolean bSubTotals String sFormat
        tdRC_Column_Def[] tColumn_Defs
        Integer iCount

        Get ptColumn_Defs to tColumn_Defs
        Move (SizeOfArray(tColumn_Defs)) to iCount

        Move sLabel     to tColumn_Defs[iCount].sLabel
        Move iSize      to tColumn_Defs[iCount].iSize
        Move eDataType  to tColumn_Defs[iCount].eDataType
        Move eStyle     to tColumn_Defs[iCount].eStyle
        If (num_arguments >= 5) Move sTC_Name   to tColumn_Defs[iCount].sTC_Name
        If (num_arguments >= 6) Move sEval      to tColumn_Defs[iCount].sEval
        If (num_arguments >= 7) Move bSubTotals to tColumn_Defs[iCount].bSubTotals
        If (num_arguments >= 8) Move sFormat    to tColumn_Defs[iCount].sFormat

        Set ptColumn_Defs to tColumn_Defs
        Set Private_piColumn_Count to iCount
    End_Procedure

    //-------------------------------------------------------------------------

    {MethodType=Method DesignTime=False}
    Procedure Create_Columns
        Integer iColumnCount iCount
        Integer eDataType
        Handle  hoColumns hoCol
        Variant  vColumns vCol
        tdRC_Column_Def[] tColumn_Defs
        tdRC_Column_Formats tColumn_Formats

        Get ptColumn_Formats to tColumn_Formats
        Get ptColumn_Defs    to tColumn_Defs
        Get piColumn_Count   to iColumnCount

        Get phoGridColumns to hoColumns
        Get phoGridColumn  to hoCol

        Get ComColumns to vColumns
        Set pvComObject of hoColumns to vColumns

        For iCount from 0 to iColumnCount
            Get ComAdd of hoColumns iCount tColumn_Defs[iCount].sLabel tColumn_Defs[iCount].iSize True to vCol
            Set pvComObject of hoCol to vCol

            Set ComAlignment of hoCol to tColumn_Formats[tColumn_Defs[iCount].eDataType].eAlignment

            //If the Style is check box then force alignment to be center
            If (tColumn_Defs[iCount].eStyle = eRC_CheckBox) Begin
                Set ComHeaderAlignment of hoCol to OLExtpAlignmentCenter
                Set ComFooterAlignment of hoCol to OLExtpAlignmentCenter
            End
            Else Begin
                Set ComHeaderAlignment of hoCol to tColumn_Formats[tColumn_Defs[iCount].eDataType].eAlignment
                Set ComFooterAlignment of hoCol to tColumn_Formats[tColumn_Defs[iCount].eDataType].eAlignment
            End

            Set ComBestFitMode of hoCol to tColumn_Formats[tColumn_Defs[iCount].eDataType].eBestFit
            //create a hidden column
            If (tColumn_Defs[iCount].iSize  = 0) Begin
                Set ComVisible of hoCol to False
                Set ComShowInFieldChooser of hoCol to False
            End
            If (tColumn_Defs[iCount].eStyle = eRC_Preview) Begin
                If (pbPreviewMode(Self)) Set ComPreviewMode to True
            End
            Send OnCreateColumn iCount hoCol
        Loop
    End_Procedure

    Procedure OnCreateColumn Integer iColumn Handle hoCol
        // Hook
    End_Procedure

    // Retruns the column label
    Function psColumn_Label Integer iColumn Returns String
        String sRetval
        tdRC_Column_Def[] tColumn_Defs

        Get ptColumn_Defs to tColumn_Defs
        Move tColumn_Defs[iColumn].sLabel to sRetval

        Function_Return sRetval
    End_Function

    //-------------------------------------------------------------------------

    {MethodType=Method DesignTime=False}
    Procedure DoLoad_Data
        Integer  eDb_Type
        DateTime dtStart dtEnd

        If (pbColumn_Resort(Self)) Send Remove_Sorted_Columns
        Get peDb_Type to eDb_Type

        Send OnBefore_Load_Data
        If (piLoad_Monitor(Self) > 0) Send OnLoad_Start (piMax_Rows(Self))

        Move (CurrentDateTime()) to dtStart
        If (eDb_Type = eRC_db_Table) Send DoLoad_Table
        If (eDb_Type = eRC_db_SQL  ) Send DoLoad_SQL
        If (eDb_Type = eRC_db_Text ) Send DoLoad_Text
        Move (CurrentDateTime()) to dtEnd
        Set ptsTimeSpan_Load to (dtEnd - dtStart)

        If (piLoad_Monitor(Self) > 0) Send OnLoad_End (piRow_Count(Self))

        Send DoSetColumnOrdering
        Send DoSetColumnGrouping
        Send OnAfter_Load_Data
    End_Procedure

    //=========================================================================

    Function GroupSubTotalFormula Returns String
        Integer iColumn iCol_Count
        String sFormula
        tdRC_Column_Def[] taColumn_Defs

        Get ptColumn_Defs to taColumn_Defs
        Move (SizeOfArray(taColumn_Defs) - 1) to iCol_Count
        For iColumn from 0 to iCol_Count
            If (taColumn_Defs[iColumn].bSubTotals) Begin
                Move (sFormula + "SUMSUB(C" + String(iColumn) + ":C" + String(iColumn + 1) + ") ") to sFormula
            End
        Loop

        Function_Return (Trim(sFormula))
    End_Function

    Procedure DoGroupCalculation
        Boolean bGroupRow
        Integer iRow iRowCount
        Handle hoGridRow hoGroupRow hoGridRows
        Variant vRow vGridRows
        String  sFormula

        Get phoGridRow      to hoGridRow
        Get phoGridGroupRow to hoGroupRow

        Get phoGridRows               to hoGridRows
        Get ComRows                     to  vGridRows
        Set pvComObject of hoGridRows to  vGridRows

        Get ComCount of hoGridRows to iRowCount
        Decrement iRowCount

        Get GroupSubTotalFormula to sFormula

        For iRow from 0 to iRowCount
            Get ComRow of hoGridRows iRow to vRow
            Set pvComObject of hoGridRow to vRow
            Get ComGroupRow of hoGridRow to bGroupRow
            If (bGroupRow) Begin
                Set pvComObject of hoGroupRow to vRow
                Set ComGroupFormat  of hoGroupRow to "%.02f"
                Set ComGroupFormula of hoGroupRow to sFormula
                Set ComGroupCaption of hoGroupRow to ""
            End
        Loop
    End_Procedure

    Procedure OnComGroupOrderChangedEx Variant llColumn OLEXTPGridColumnOrderChangedReason llReason
        If (llReason iand OLExtpGridColumnAddedToGroupby) Begin
            If (pbEnableTotals(Self)) Send DoGroupCalculation
        End
    End_Procedure

