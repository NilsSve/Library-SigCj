// This sets the defaults format
Struct tdRC_Column_Format
    Boolean bBold
    Boolean bColorColumn
    Integer eAlignment
    Integer eBestFit
    Integer iForeColor
    Integer iBackColor
    Integer iForeColor_Neg
    Integer iBackColor_Neg
    String  sFormat         //the format of the caption - see Codejock help
    String  sDateFormat     //the format of the source Date/Time data (e.g. DD-MM-YYYY hh:mm:ss)
End_Struct

#Replace tdRC_Column_Formats  tdRC_Column_Format[eRC_Last_DataType] //Let the compile do the work

//-----------------------------------------------------------------------------

Struct tdRC_Column_Def
    String  sLabel     // - Column header label
    Integer iSize      // - Column size
    Integer eDataType  // - Column data type
    Integer eStyle     // - Column style - Currency / checkbox etc
    String  sTC_Name   // - Table / Column name (file.field)
    String  sEval      // - Eval value for database function or datafield displayed
    Boolean bSubTotals // - Enable sub total for the column in header row
    String  sFormat    // - This Sets the Column format of each column
End_Struct

//-----------------------------------------------------------------------------

Struct tdRC_Ordering
    Integer iColumn         // - Column Number (zero based)
    Boolean bDescending     // - True = Descending, False = Ascending
End_Struct

