    {MethodType=Method DesignTime=False}
    Procedure Initialise_Column_Formats
        Integer iLoop
        tdRC_Column_Formats tColumn_Formats

        Get ptColumn_Formats to tColumn_Formats

        For iLoop from 0 to eRC_Num_DataTypes
            Move False               to tColumn_Formats[iLoop].bBold
            Move False               to tColumn_Formats[iLoop].bColorColumn
            Move eRC_BestFit_None    to tColumn_Formats[iLoop].eBestFit
            Move clWindow            to tColumn_Formats[iLoop].iBackColor
            Move clWindowText        to tColumn_Formats[iLoop].iForeColor
            Move clWindow            to tColumn_Formats[iLoop].iBackColor_Neg
            Move clRed               to tColumn_Formats[iLoop].iForeColor_Neg
            Move ""                  to tColumn_Formats[iLoop].sFormat
            Move ""                  to tColumn_Formats[iLoop].sDateFormat

            Move OLExtpAlignmentLeft to tColumn_Formats[iLoop].eAlignment
            If ((iLoop = eRC_Currency) or (iLoop = eRC_Integer) or (iLoop = eRC_Real)) Begin
                Move OLExtpAlignmentRight to tColumn_Formats[iLoop].eAlignment
            End
            If (iLoop = eRC_Decimal) Begin
                Move OLExtpAlignmentRight to tColumn_Formats[iLoop].eAlignment
                Move "%.8s" to tColumn_Formats[iLoop].sFormat
            End
            If (iLoop = eRC_Text) Begin
                Move OLExtpAlignmentWordBreak to tColumn_Formats[iLoop].eAlignment
                Move eRC_BestFit_None to tColumn_Formats[iLoop].eBestFit
            End
            If (iLoop = eRC_date) Begin
                Move eRC_BestFit_All to tColumn_Formats[iLoop].eBestFit
            End
        Loop

        Set ptColumn_Formats to tColumn_Formats

        Send OnSetColumnFormats
    End_Procedure

