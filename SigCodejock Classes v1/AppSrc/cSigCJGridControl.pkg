        // Event Hook
    End_Procedure

    //=========================================================================

    Procedure DoBest_Fit
        Integer iColumn iColumn_Count iBestFit
        Handle  hoColumns hoCol
        Variant  vColumns  vCol

        tdRC_Column_Def[] tColumn_Defs
        tdRC_Column_Formats tColumn_Formats

        Get ptColumn_Defs    to tColumn_Defs
        Get ptColumn_Formats to tColumn_Formats

        Get ComColumns to vColumns
        Get Create U_cSigCjComGridColumns to hoColumns
            Set pvComObject of hoColumns to vColumns

            Get ComCount of hoColumns to iColumn_Count
            Decrement iColumn_Count //make zero based

            Get Create U_cSigCjComGridColumn to hoCol

                For iColumn from 0 to iColumn_Count
                    Move tColumn_Formats[tColumn_Defs[iColumn].eDataType].eBestFit to iBestFit
                    If (iBestFit <> eRC_BestFit_None) Begin
                        Get ComColumn of hoColumns iColumn to vCol
                        Set pvComObject of hoCol to vCol
                        Send ComBestFit of hoCol
                    End
                Loop

            Send Destroy of hoCol
        Send Destroy of hoColumns
    End_Procedure

    //=========================================================================

    Procedure Add_Grid_Item Handle  hoRec  Integer iColumn Boolean bRow_Item Integer eDataType Integer eStyle ;
                              Boolean bRow_Colors tdRC_Column_Format tColumn_Format String sValue Boolean bTotals ;
                              String sColumnFormat
        Boolean   bAdded bItem_Colors bItem_Bold
        Integer   iValue iItem_ForeColor iItem_BackColor iDecSep iUsedDecSep iTotal iThousandSep iNumDecPlaces iPos
        Number    nValue nTotal
        DateTime dtValue
        Handle   hoItem hoColumns hoCol
        Variant   vItem vColumns vCol
        String    sPreviewText sTotal

        Get phoGridRecordItem to hoItem
        Move False to bAdded

        If (eStyle = eRC_Preview) Begin
            Get ComPreviewText of hoRec to sPreviewText
            If (sPreviewText <> "") Move (Append(sPreviewText, (" " + String(Trim(sValue))) )) to sPreviewText
            Else Move (Trim(sValue)) to sPreviewText
            Set ComPreviewText of hoRec to sPreviewText
        End

        If (eStyle = eRC_CheckBox) Begin
            Get ComAddItem  of hoRec sValue to vItem
            Set pvComObject of hoItem to vItem

            Set ComHasCheckBox of hoItem to True
            Set ComAlignment   of hoItem to OLExtpAlignmentIconCenter
            Set ComChecked     of hoItem to sValue
            Set ComCaption     of hoItem to " " // This stops the value from being shown

            Move True to bAdded
        End

        If (eStyle = eRC_Standard) Begin
            If (bTotals) Begin
                Get phoGridColumns to hoColumns
                Get phoGridColumn  to hoCol

                Get ComColumns to vColumns
                Set pvComObject of hoColumns to vColumns
                Get ComFind     of hoColumns iColumn to vCol
                Set pvComObject of hoCol to vCol
            End
            //Date, DateTime & Time - Must use DateTime var so Grid control
            //sorts column correctly
            If ((eDataType = eRC_Date    ) or ;
                (eDataType = eRC_DateTime) or ;
                (eDataType = eRC_DTString) or ;
                (eDataType = eRC_Time    )) Begin

                //Expects DD/MM/CCYY HH:MM:SS for none sql tables CCYY/MM/DD HH:MM:SS for sql tables

                //Add date
                If ((eDataType = eRC_Date) or (eDataType = eRC_DateTime) or (eDataType = eRC_DTString)) Begin
                    If ((peDb_Type(Self) = eRC_db_SQL) and (eDataType <> eRC_DTString)) Begin
                        Move (DateSetDay   (dtValue, (Mid(sValue,2,9)))) to dtValue
                        Move (DateSetMonth (dtValue, (Mid(sValue,2,6)))) to dtValue
                        Move (DateSetYear  (dtValue, (Mid(sValue,4,1)))) to dtValue
                    End
                    Else Begin
                        Move (DateSetDay   (dtValue, (DateGetDay(sValue))))   to dtValue
                        Move (DateSetMonth (dtValue, (DateGetMonth(sValue)))) to dtValue
                        Move (DateSetYear  (dtValue, (DateGetYear(sValue))))  to dtValue
                    End
                End
                //Add Time
                If ((eDataType = eRC_DateTime) or (eDataType = eRC_Time) or eDataType = eRC_DTString) Begin
                    If ((peDb_Type(Self) = eRC_db_SQL) and (eDataType <> eRC_DTString)) Begin
                        Move (DateSetHour   (dtValue, (Mid(sValue,2,12)))) to dtValue
                        Move (DateSetMinute (dtValue, (Mid(sValue,2,15)))) to dtValue
                        Move (DateSetSecond (dtValue, (Mid(sValue,2,18)))) to dtValue
                    End
                    Else Begin
                        Move (DateSetHour   (dtValue, (DateGetHour(sValue))))   to dtValue
                        Move (DateSetMinute (dtValue, (DateGetMinute(sValue)))) to dtValue
                        Move (DateSetSecond (dtValue, (DateGetSecond(sValue)))) to dtValue
                    End
                End
                If ((dtValue = "01/01/1753 00:00:00") or (dtValue = "00:00:00" )) Begin
                    Get ComAddItem of hoRec "" to vItem // Don't show blank dates
                End
                Else Get ComAddItem of hoRec dtValue to vItem
                Move True to bAdded
            End

            If (eDataType = eRC_Currency) Begin
                Move sValue to nValue
                Get ComAddItem of hoRec nValue to vItem
                Set pvComObject of hoItem to vItem

                If (bTotals) Begin
                    Get ComFooterText of hoCol to sTotal
                    // replace currency symbol and thousand seperators so we can convert to a number
                    Get_Attribute DF_THOUSANDS_SEPARATOR to iThousandSep
                    Move (Replaces(Character(iThousandSep),sTotal,"")) to sTotal
                    Move (Replaces(ToOEM(Default_Currency_Symbol()),sTotal, "")) to sTotal

                    //Add the old and new values together and convert to a currency string
                    Move (ToOEM(FormatCurrency((Number(sTotal) + nValue),2))) to sTotal
                    Set ComFooterText of hoCol to sTotal
                End

                If ((pbZero_Suppress_Currency(Self)) and (nValue = 0)) Begin
                    Set ComCaption  of hoItem to " "
                End
                Else Begin
                    Move (ToOEM(FormatCurrency(nValue,2))) to sValue
                    Set ComCaption  of hoItem to sValue
                End
                Move True to bAdded
            End

            If (eDataType = eRC_Integer) Begin
                Get ComAddItem of hoRec (Integer(sValue)) to vItem

                If (bTotals) Begin
                    Get ComFooterText of hoCol to iTotal
                    Set ComFooterText of hoCol to (iTotal + Integer(sValue))
                End

                Set pvComObject of hoItem to vItem
                If ((pbZero_Suppress_Integer(Self)) and (Integer(sValue) = 0)) Begin
                    Set pvComObject of hoItem to vItem
                    Set ComCaption  of hoItem to " "
                End
                Move True to bAdded
            End

            If ((eDataType = eRC_Real) or (eDataType = eRC_Decimal)) Begin

                Get_Attribute DF_DECIMAL_SEPARATOR to iDecSep
                If ((iDecSep = 46) and RightPos(",", sValue)) Begin
                    Move 44 to iUsedDecSep
                    Set_Attribute DF_DECIMAL_SEPARATOR to iUsedDecSep
                    Move sValue to nValue
                    Set_Attribute DF_DECIMAL_SEPARATOR to iDecSep
                End
                Else If ((iDecSep = 44) and RightPos(".", sValue)) Begin
                    Move 46 to iUsedDecSep
                    Set_Attribute DF_DECIMAL_SEPARATOR to iUsedDecSep
                    Move sValue to nValue
                    Set_Attribute DF_DECIMAL_SEPARATOR to iDecSep
                End
                Else Begin
                   Move iDecSep to iUsedDecSep
                   Move sValue to nValue
                End

                Move (Pos(Character(iUsedDecSep), sValue)) to iPos
                If (iPos) Begin
                    Move (Length(sValue) - Pos(Character(iUsedDecSep),sValue) ) to iNumDecPlaces
                End
                Else Begin
                    Move 0 to iNumDecPlaces
                End
                Get ComAddItem of hoRec nValue to vItem
                If (bTotals) Begin
                    Get ComFooterText of hoCol to nTotal
                    Move (String(nTotal + nValue)) to sTotal
                    If (iNumDecPlaces > 0) Begin
                        Move (Pos(Character(iUsedDecSep), sTotal)) to iDecSep
                        If (not(iDecSep)) Begin
                            Move (Length(sTotal)) to iDecSep
                            Move (sTotal + Character(iUsedDecSep)) to sTotal
                        End
                        Move (Left(sTotal + Repeat('0', iNumDecPlaces), (iDecSep + 1 + iNumDecPlaces))) to sTotal
                    End
                    Set ComFooterText of hoCol to sTotal
                End
                Set pvComObject of hoItem to vItem
                If ((pbZero_Suppress_Decimal(Self)) and (nValue = 0)) Set ComCaption  of hoItem to " "
                Else Set ComCaption  of hoItem to sValue
                Move True to bAdded
            End
            //All previously unhandled data types
            If (not(bAdded)) Begin
                Get ComAddItem of hoRec sValue to vItem
                Move True to bAdded
            End
        End

        // Check just in case an invalid Style is passed
        If (not(bAdded)) Begin
            //Add empty item
            Get ComAddItem of hoRec "" to vItem
        End

        //Now format the column
        If (bAdded) Begin
            Set pvComObject of hoItem to vItem

            //Alignment done at column level
            If (not(bRow_Colors) and tColumn_Format.bColorColumn) Begin
                If ((eDataType = eRC_Currency) and (sValue < 0)) Begin
                    Set ComBackColor of hoItem to tColumn_Format.iBackColor_Neg
                    Set ComForeColor of hoItem to tColumn_Format.iForeColor_Neg
                End
                Else Begin
                    Set ComBackColor of hoItem to tColumn_Format.iBackColor
                    Set ComForeColor of hoItem to tColumn_Format.iForeColor
                End
            End

            Set ComBold of hoItem to tColumn_Format.bBold
            If (tColumn_Format.sFormat <> "") Begin
                Set ComFormat of hoItem to tColumn_Format.sFormat
            End
// MXP This is not working as required
//            If (sColumnFormat <> "") Begin
//                Set ComFormat of hoItem to sColumnFormat
//            End
            If (bRow_Item) Begin
                If ((eDataType = eRC_Date) or (eDataType = eRC_DateTime) or (eDataType = eRC_DTString)) Begin
                    // Do not process date formats and codejock stores them correctly
                End
                Else Get ComValue of hoItem to sValue
                Send OnCreateRowItem iColumn hoItem sValue
            End
            If (bRow_Colors) Begin
                If ((eDataType = eRC_Date) or (eDataType = eRC_DateTime) or (eDataType = eRC_DTString)) Begin
                    // Do not process date formats and codejock stores them correctly
                End
                Else Get ComValue of hoItem to sValue
                // Send OnSetRowColor   iColumn sValue
            End

            Get pbItem_Colors to bItem_Colors

            If (bItem_Colors) Begin
                Set piItem_ForeColor to 0
                Set piItem_BackColor to 0
                Set pbItem_Bold      to False
                Send OnSetItemColor iColumn sValue
                Get piItem_ForeColor to iItem_ForeColor
                Get piItem_BackColor to iItem_BackColor
                Get pbItem_Bold      to bItem_Bold
                If (iItem_ForeColor) Set ComForeColor of hoItem to iItem_ForeColor
                If (iItem_BackColor) Set ComBackColor of hoItem to iItem_BackColor
                If (bItem_Bold)      Set ComBold      of hoItem to True
            End
        End
    End_Procedure

    Procedure OnCreateRowItem Integer iColumn Handle hoItem String sValue
        // Hook
    End_Procedure

    //=========================================================================
    //Table Data

    Procedure DoLoad_Table
        Boolean bFound bRow_Colors bRow_Item
        Integer iRow_Count iMax_Rows iColumn iColumn_Count iRef_Column
        Integer iRow_ForeColor iRow_BackColor iItem_ForeColor iItem_BackColor iLoad_Monitor
        Handle  hoRecords hoRec hoItem
        Variant  vRecords  vRec  vItem
        String  sValue sTag

        tdRC_Column_Def[] tColumn_Defs
        tdRC_Column_Formats tColumn_Formats

        //Table specific
        Boolean bDescending bDeferredState
        Handle  hoDD
        Integer iFile_Number iIndex iTable
        RowID   Row_ID

        Send Cursor_Wait of Cursor_Control

        Get phoDD to hoDD
        If (hoDD > 0) Begin
            Get phoGridRecordItem to hoItem
            Get phoGridRecord     to hoRec
            Get phoGridRecords    to hoRecords
            Get ComRecords          to vRecords
            Set pvComObject of hoRecords to vRecords

            Get ptColumn_Formats to tColumn_Formats
            Get ptColumn_Defs    to tColumn_Defs
            Get piColumn_Count   to iColumn_Count
            Get piRef_Column     to iRef_Column
            Get piMax_Rows       to iMax_Rows
            Get pbRow_Colors     to bRow_Colors
            Get pbRow_Item       to bRow_Item
            Get piLoad_Monitor   to iLoad_Monitor

            Get piTable_Index to iIndex
            Get pbDescending  to bDescending
            Get Main_File     of hoDD to iTable

            If (peDataflex_Table_Find_Method(Self) = eRC_Find_Normal) Begin
                Send Clear of hoDD
                If (bDescending) Send Find of hoDD LAST_RECORD iIndex
                Else             Send Find of hoDD GE          iIndex
            End
            Else If (peDataflex_Table_Find_Method(Self) = eRC_Find_RequestRead) Begin
                Send Clear of hoDD
                If (bDescending) Send Request_Read of hoDD LAST_RECORD iTable iIndex
                Else             Send Request_Read of hoDD GE          iTable iIndex
            End
            Else If (peDataflex_Table_Find_Method(Self) = eRC_Find_Constrained) Begin
                Constrained_Clear (If(bDescending,LE,GE)) iTable by iIndex
                Constrained_Find Next
            End

            Move (Found) to bFound
            While (bFound)
                Get ComAdd of hoRecords to vRec
                Set pvComObject of hoRec to vRec
                Increment iRow_Count

                //Reset row Colors
                If (bRow_Colors) Begin
                    Set piRow_ForeColor to 0
                    Set piRow_BackColor to 0
                End

                For iColumn from 0 to iColumn_Count
                    //Item Data
                    If (Trim(tColumn_Defs[iColumn].sEval) = "") Move tColumn_Defs[iColumn].sTC_Name to sValue
                    Else                                        Move tColumn_Defs[iColumn].sEval    to sValue
                    Move (Eval(sValue)) to sValue

                    //Add the item
                    Send Add_Grid_Item hoRec                                            ;
                                         iColumn                                          ;
                                         bRow_Item                                        ;
                                         tColumn_Defs[iColumn].eDataType                  ;
                                         tColumn_Defs[iColumn].eStyle                     ;
                                         bRow_Colors                                      ;
                                         tColumn_Formats[tColumn_Defs[iColumn].eDataType] ;
                                         (Trim(sValue))                                   ;
                                         tColumn_Defs[iColumn].bSubTotals                 ;
                                         tColumn_Defs[iColumn].sFormat

                    //Tag value
                    If (iColumn = iRef_Column) Move sValue to sTag

                    //Set row Colors
                    If (bRow_Colors) Send OnSetRowColor iColumn sValue
                Loop

                //Add Tag
                If (pbRowID_Mode(Self)) Begin
                    Get Main_File of (phoDD(Self)) to iFile_Number
                    Move (GetRowID(iFile_Number)) to Row_ID
                    Set ComTag of hoRec to (SerializeRowId(Row_ID))
                End
                Else Begin
                    Set ComTag of hoRec to sTag
                End

                //Set row Color
                If (bRow_Colors) Begin
                    Get piRow_ForeColor to iRow_ForeColor
                    Get piRow_BackColor to iRow_BackColor
                    If ((iRow_ForeColor) or (iRow_BackColor)) Begin
                        For iColumn from 0 to iColumn_Count
                            Get ComItem      of hoRec iColumn to vItem
                            Set pvComObject  of hoItem to vItem
                            Get ComForeColor of hoItem to iItem_ForeColor
                            Get ComBackColor of hoItem to iItem_BackColor
                            If ((iRow_ForeColor) and (iItem_ForeColor = -1)) Set ComForeColor of hoItem to iRow_ForeColor
                            If ((iRow_BackColor) and (iItem_BackColor = -1)) Set ComBackColor of hoItem to iRow_BackColor
                        Loop
                    End
                End

                If (peDataflex_Table_Find_Method(Self) = eRC_Find_Normal) Begin
                    If (bDescending) Send Find of hoDD LT iIndex
                    Else             Send Find of hoDD GT iIndex
                End
                Else If (peDataflex_Table_Find_Method(Self) = eRC_Find_RequestRead) Begin
                    If (bDescending) Send Request_Read of hoDD LT iTable iIndex
                    Else             Send Request_Read of hoDD GT iTable iIndex
                End
                Else If (peDataflex_Table_Find_Method(Self) = eRC_Find_Constrained) Begin
                    Constrained_Find Next
                End

                Move (Found) to bFound
                If ((bFound) and (iMax_Rows > 0)) Move (iRow_Count < iMax_Rows) to bFound

                If (iLoad_Monitor > 0) Begin
                    If ((iRow_Count > iLoad_Monitor) and (Mod(iRow_Count, iLoad_Monitor) = 0)) Send OnLoad_Monitor iRow_Count
                End
            Loop
            // Send DoBest_Fit
        End

        Set Private_piRow_Count to iRow_Count
        Send Cursor_Ready of Cursor_Control
    End_Procedure

    //=========================================================================
    //SQL Data

    Procedure Build_SQL_Statement
        String  sSQL_Statement sSQL_Select sSQL_From sSQL_Where sSQL_OrderBy
        String  sFieldName
        Boolean bCase
        Integer iColumnCount iCount iIndex iSegments iColumn
        Handle  hoDD hTable
        tdRC_Column_Def[] tColumn_Defs

        Send OnBuild_SQL_Statement

        Get phoDD         to hoDD
        Get piTable_Index to iIndex
        Get psSQL_Select  to sSQL_Select
        Get psSQL_From    to sSQL_From
        Get psSQL_Where   to sSQL_Where
        Get psSQL_OrderBy to sSQL_OrderBy
        Get pbSQL_Case    to bCase

        //---------------------------------------------------------------------
        //Sort out Select
        If (sSQL_Select = "") Begin
            Get ptColumn_Defs  to tColumn_Defs
            Get piColumn_Count to iColumnCount
            For iCount from 0 to iColumnCount
                If (iCount > 0) Move (Append(sSQL_Select,", ")) to sSQL_Select
                If ((bCase = True) and (tColumn_Defs[iCount].sEval <> "")) Begin
                    Move (Append(sSQL_Select,String(tColumn_Defs[iCount].sEval))) to sSQL_Select
                End
                Else Move (Append(sSQL_Select,String(tColumn_Defs[iCount].sTC_Name))) to sSQL_Select
            Loop
            Set psSQL_Select  to sSQL_Select
        End

        //---------------------------------------------------------------------
        //Sort out From
        If (sSQL_From = "") Begin
            Get Main_File of hoDD to hTable
            Get_Attribute DF_FILE_LOGICAL_NAME of hTable to sSQL_From
            Set psSQL_From    to sSQL_From
        End

        //---------------------------------------------------------------------
        //Sort out Where
        //This has to be specified by the user

        //---------------------------------------------------------------------
        //Sort out OrderBy
        If ((sSQL_OrderBy = "") and (iIndex > 0)) Begin
            Get Main_File of hoDD to hTable
            Get_Attribute DF_INDEX_NUMBER_SEGMENTS of hTable iIndex to iSegments
            For iCount from 1 to iSegments
                Get_Attribute DF_INDEX_SEGMENT_FIELD of hTable iIndex iCount to iColumn
                Get_Attribute DF_FIELD_NAME of hTable iColumn to sSQL_OrderBy
                Move (Append(sSQL_OrderBy,(String(sSQL_OrderBy) * " "))) to sSQL_OrderBy
            Loop
        End

        //---------------------------------------------------------------------
        // Build the statement
        If (psSQL_Select(Self)  <> "") Move (Append(sSQL_Statement,("select"    * String(psSQL_Select(Self))  ))) to sSQL_Statement
        If (psSQL_From(Self)    <> "") Move (Append(sSQL_Statement,(" from"     * String(psSQL_From(Self))    ))) to sSQL_Statement
        If (psSQL_Where(Self)   <> "") Move (Append(sSQL_Statement,(" where"    * String(psSQL_Where(Self))   ))) to sSQL_Statement
        If (psSQL_OrderBy(Self) <> "") Move (Append(sSQL_Statement,(" order by" * String(psSQL_OrderBy(Self)) ))) to sSQL_Statement

        Set psSQL_Select_Statment to sSQL_Statement
    End_Procedure

    Procedure OnBuild_SQL_Statement
        //Event Hook
    End_Procedure

    //------------------------------------------------------
    //
    // Function   : piDriverIndex
    //
    // Scope      : Public
    //
    // Parameters : sDriver -  Name of driver as returned by DF_FILE_DRIVER
    //
    // Returns    : Integer - ID of the driver, if present.
    //
    // Purpose    : Different workstations may have different drivers installed. This functions (lifted from the help)
    //              loops through a machines installed drivers matching their names to the passed value. If found
    //              the this index can be used in the "Driver" series of Get_Attribute for querying further values
    //
    // Notes      :
    //
    //------------------------------------------------------
    Function piDriverIndex String sDriver Returns Integer
        String sCurrentDriver
        Integer iDriver
        Integer iNumDrivers

        Get_Attribute DF_NUMBER_DRIVERS to iNumDrivers
        For iDriver from 1 to iNumDrivers
            Get_Attribute DF_DRIVER_NAME of iDriver to sCurrentDriver
            If (Uppercase(sDriver) = Uppercase(sCurrentDriver)) ;
                Function_Return iDriver
        Loop

        Function_Return 0
    End_Function // piDriverIndex String sDriver Returns Integer


    //------------------------------------------------------
    //
    // Function   : psConnectionStringFromID
    //
    // Scope      : Public
    //
    // Parameters : sDriver -  Name of driver as returned by DF_FILE_DRIVER
    //              sConnectionID - "Fake" login with a connection ID instead of connection string
    //
    // Returns    : String - connection string
    //
    // Purpose    : Having found the driver in use. Walk through its registered connection ID until
    //              we find the one one we're interested in a return its connection string.
    //
    // Notes      :
    //
    //------------------------------------------------------
    Function psConnectionStringFromID String sDriver String sConnectionID Returns String
        Integer iDriver iConn iNumConn
        String sID sConnectionString

        Get piDriverIndex sDriver to iDriver
        If (iDriver) Begin
            //Walk through all Connection IDs for the relevant driver. Exit when we find something (or run out of IDs)
            Move 0 to iConn
            Get_Attribute DF_DRIVER_NUMBER_CONNECTION_IDS of iDriver to iNumConn
            While ((iConn < iNumConn) and (sConnectionString = ""))

                Get_Attribute DF_DRIVER_CONNECTION_ID of iDriver iConn to sID
                If (Uppercase(sConnectionID) = Uppercase("DFCONNID=" + sID)) ;
                    Get_Attribute DF_DRIVER_CONNECTION_ID_STRING of iDriver iConn to sConnectionString

                Move (iConn + 1) to iConn
            Loop
        End

        Function_Return sConnectionString
    End_Function // psConnectionStringFromID String sDriver String sConnectionID Returns String

    //-------------------------------------------------------------------------

    Procedure DoLoad_SQL
        Boolean bSQL_AutoTranslateToOEM bFound bRow_Colors bRow_Item
        Integer iRow_Count iMax_Rows iColumn iColumn_Count iRef_Column
        Integer iRow_ForeColor iRow_BackColor iItem_ForeColor iItem_BackColor iLoad_Monitor
        Handle  hoRecords hoRec hoItem
        Variant  vRecords  vRec  vItem
        String  sValue sTag
        String sTABLE_CHARACTER_FORMAT

        tdRC_Column_Def[] tColumn_Defs
        tdRC_Column_Formats tColumn_Formats

        //SQL specific
        Boolean  bCase
        Integer  iFetchResult
        Handle   hoSQL hoDD hdbc hstmt hTable
        String   sDriver sConnection sSQL_Select_Statment
        DateTime dtStart dtEnd

        Send Cursor_Wait of Cursor_Control

        Get phoGridRecordItem to hoItem
        Get phoGridRecord     to hoRec
        Get phoGridRecords    to hoRecords
        Get ComRecords          to vRecords
        Set pvComObject of hoRecords to vRecords

        Get ptColumn_Formats to tColumn_Formats
        Get ptColumn_Defs    to tColumn_Defs
        Get piColumn_Count   to iColumn_Count
        Get piRef_Column     to iRef_Column
        Get piMax_Rows       to iMax_Rows
        Get pbRow_Colors     to bRow_Colors
        Get pbRow_Item       to bRow_Item
        Get piLoad_Monitor   to iLoad_Monitor

        Move (CurrentDateTime()) to dtStart

        If ((psSQL_Select_Statment(Self) = "") or pbAlwaysRebuild_SQL(Self)) Send Build_SQL_Statement
        Get psSQL_Select_Statment to sSQL_Select_Statment

        Get phoDD to hoDD
        Get Main_File of hoDD to hTable
        Get pbSQL_Case        to bCase

        Get_Attribute DF_FILE_TABLE_CHARACTER_FORMAT of hTable to sTABLE_CHARACTER_FORMAT
        Move (pbSQL_AutoTranslateToOEM(Self) and (sTABLE_CHARACTER_FORMAT <> 'OEM')) to bSQL_AutoTranslateToOEM

        #IFDEF SigCj_Use_Mertech_Drivers
            Get CreateResultSet to hoSQL
            Send ExecuteQuery of hoSQL sSQL_Select_Statment
        #ELSE
            Move (oSQL_Grid_Handler(Self)) to hoSQL

            Get_Attribute DF_FILE_DRIVER of hTable to sDriver
            Get_Attribute DF_FILE_LOGIN  of hTable to sConnection

            // If have a connection ID. Translate it into a proper connection string
            If (Uppercase(left(sConnection, 9)) = "DFCONNID=") ;
                Get psConnectionStringFromID sDriver sConnection to sConnection

            Get SQLConnect of hoSQL ;
                sDriver ;
                sConnection to hdbc

            Get SQLOpen        of hdbc to hstmt
            Send SQLExecDirect of hstmt sSQL_Select_Statment
        #ENDIF

        Move (CurrentDateTime()) to dtEnd
        Set ptsTimeSpan_SQL to (dtEnd - dtStart)

        Repeat
            #IFDEF SigCj_Use_Mertech_Drivers
                Send Next of hoSQL
                Move (Found) to iFetchResult
            #ELSE
                Get SQLFetch of hstmt to iFetchResult
            #ENDIF

            If (iFetchResult <> 0) Begin
                If (iRow_Count = 1) Begin
                    Move (CurrentDateTime()) to dtEnd
                    Set ptsTimeSpan_SQL to (dtEnd - dtStart)
                End

                Get ComAdd of hoRecords to vRec
                Set pvComObject of hoRec to vRec
                Increment iRow_Count

                //Reset row Colors
                If (bRow_Colors) Begin
                    Set piRow_ForeColor to 0 // Reset Row ForeColor
                    Set piRow_BackColor to 0 // Reset Row BackColor
                End

                For iColumn from 0 to iColumn_Count
                    // Get the Column data
                    #IFDEF SigCj_Use_Mertech_Drivers
                        Get getString of hoSQL (iColumn +1) to sValue
                    #ELSE
                        Get SQLColumnValue of hstmt (iColumn +1) to sValue
                    #ENDIF

                    If (bSQL_AutoTranslateToOEM) ;
                        Move (ToOEM(sValue)) to sValue

                    Move (Trim(sValue)) to sValue

                    If (not(bCase) and (Trim(tColumn_Defs[iColumn].sEval) <> "")) Begin
                        Move (Replace(tColumn_Defs[iColumn].sTC_Name,tColumn_Defs[iColumn].sEval,('"' + String(sValue) + '"'))) to sValue
                        Move (Eval(sValue)) to sValue
                    End

                    //Add the item
                    Send Add_Grid_Item hoRec                                            ;
                                         iColumn                                          ;
                                         bRow_Item                                        ;
                                         tColumn_Defs[iColumn].eDataType                  ;
                                         tColumn_Defs[iColumn].eStyle                     ;
                                         bRow_Colors                                      ;
                                         tColumn_Formats[tColumn_Defs[iColumn].eDataType] ;
                                         (Trim(sValue))                                   ;
                                         tColumn_Defs[iColumn].bSubTotals                 ;
                                         tColumn_Defs[iColumn].sFormat

                    //Tag value
                    If (iColumn = iRef_Column) Move sValue to sTag

                    //Set row Colors
                    If (bRow_Colors) Send OnSetRowColor iColumn sValue
                Loop

                //Add Tag
                Set ComTag of hoRec to sTag

                //Set row Color
                If (bRow_Colors) Begin
                    Get piRow_ForeColor to iRow_ForeColor
                    Get piRow_BackColor to iRow_BackColor
                    If ((iRow_ForeColor) or (iRow_BackColor)) Begin
                        For iColumn from 0 to iColumn_Count
                            Get ComItem      of hoRec iColumn to vItem
                            Set pvComObject  of hoItem to vItem
                            Get ComForeColor of hoItem to iItem_ForeColor
                            Get ComBackColor of hoItem to iItem_BackColor
                            If ((iRow_ForeColor) and (iItem_ForeColor = -1)) Set ComForeColor of hoItem to iRow_ForeColor
                            If ((iRow_BackColor) and (iItem_BackColor = -1)) Set ComBackColor of hoItem to iRow_BackColor
                        Loop
                    End
                End

                If ((iMax_Rows > 0) and (iRow_Count = iMax_Rows)) Begin
                    //Max rows specified and reach so bomb repeat loop
                    Move 0 to iFetchResult
                End
            End
            If (iLoad_Monitor > 0) Begin
                If ((iRow_Count > iLoad_Monitor) and (Mod(iRow_Count, iLoad_Monitor) = 0)) Send OnLoad_Monitor iRow_Count
            End
        Until (iFetchResult = 0)

        #IFDEF SigCj_Use_Mertech_Drivers
            Send Destroy_Object of hoSQL
        #ELSE
            Send SQLClose       of hstmt
            Send SQLDisconnect  of hdbc
        #ENDIF

        Set Private_piRow_Count to iRow_Count

        //Send DoBest_Fit

        Send Cursor_Ready of Cursor_Control
    End_Procedure

    Procedure OnSetRowColor Integer iColumn String sValue
        /// Hook
        // If ((iColumn = 11) and (sValue = "Equipment")) Begin
        //    Set piRow_ForeColor to 255
        //    Set piRow_BackColor to clFuchsia
        // End
    End_Procedure

    Procedure OnSetItemColor Integer iColumn String sValue
        /// Hook
        // If ((iColumn = 11) and (sValue = "Equipment")) Begin
        //    Set piItem_ForeColor to 255
        //    Set piItem_BackColor to clFuchsia
        // End
    End_Procedure

    //=========================================================================
    //Text Data

    Procedure DoLoad_Text
        Boolean bFound bRow_Colors bRow_Item
        Integer iRow_Count iMax_Rows iColumn iColumn_Count iRef_Column
        Integer iRow_ForeColor iRow_BackColor iItem_ForeColor iItem_BackColor iLoad_Monitor
        Handle  hoRecords hoRec hoItem
        Variant  vRecords  vRec  vItem
        String  sValue sTag

        tdRC_Column_Def[] tColumn_Defs
        tdRC_Column_Formats tColumn_Formats

        //Table specific
        String[] saData

        Send Cursor_Wait of Cursor_Control

        Send OnOpen_DataSource
        If (not(pbEOF(Self))) Begin
            Get phoGridRecordItem to hoItem
            Get phoGridRecord     to hoRec
            Get phoGridRecords    to hoRecords
            Get ComRecords          to vRecords
            Set pvComObject of hoRecords to vRecords

            Get ptColumn_Formats to tColumn_Formats
            Get ptColumn_Defs    to tColumn_Defs
            Get piColumn_Count   to iColumn_Count
            Get piRef_Column     to iRef_Column
            Get piMax_Rows       to iMax_Rows
            Get pbRow_Colors     to bRow_Colors
            Get pbRow_Item       to bRow_Item
            Get piLoad_Monitor   to iLoad_Monitor

            Move True to bFound
            While (bFound)
                Move (ResizeArray(saData,0)) to saData
                Set psData_Items to saData

                Send OnPrepare_RowData
                If (not(pbEOF(Self))) Begin
                    Get psData_Items   to saData

                    Get ComAdd of hoRecords to vRec
                    Set pvComObject of hoRec to vRec
                    Increment iRow_Count

                    //Reset row Colors
                    If (bRow_Colors) Begin
                        Set piRow_ForeColor to 0
                        Set piRow_BackColor to 0
                    End

                    For iColumn from 0 to iColumn_Count
                        //Item Data
                        Move saData[iColumn] to sValue

                        //Add the item
                        Send Add_Grid_Item hoRec                                            ;
                                             iColumn                                          ;
                                             bRow_Item                                        ;
                                             tColumn_Defs[iColumn].eDataType                  ;
                                             tColumn_Defs[iColumn].eStyle                     ;
                                             bRow_Colors                                      ;
                                             tColumn_Formats[tColumn_Defs[iColumn].eDataType] ;
                                             (Trim(sValue))                                   ;
                                             tColumn_Defs[iColumn].bSubTotals                 ;
                                             tColumn_Defs[iColumn].sFormat

                        //Set row Colors
                        If (bRow_Colors) Send OnSetRowColor iColumn sValue
                    Loop

                    //Add Tag
                    If (pbAuto_Row_Ref(Self)) Begin
                        Set ComTag of hoRec to iRow_Count
                    End
                    Else Begin
                        Set ComTag of hoRec to saData[iRef_Column]
                    End

                    //Set row Color
                    If (bRow_Colors) Begin
                        Get piRow_ForeColor to iRow_ForeColor
                        Get piRow_BackColor to iRow_BackColor
                        If ((iRow_ForeColor) or (iRow_BackColor)) Begin
                            For iColumn from 0 to iColumn_Count
                                Get ComItem      of hoRec iColumn to vItem
                                Set pvComObject  of hoItem to vItem
                                Get ComForeColor of hoItem to iItem_ForeColor
                                Get ComBackColor of hoItem to iItem_BackColor
                                If ((iRow_ForeColor) and (iItem_ForeColor = -1)) Set ComForeColor of hoItem to iRow_ForeColor
                                If ((iRow_BackColor) and (iItem_BackColor = -1)) Set ComBackColor of hoItem to iRow_BackColor
                            Loop
                        End
                    End
                    If (iMax_Rows > 0) Move (iRow_Count < iMax_Rows) to bFound
                End
                Else Begin
                    Move (False) to bFound
                End

                If (iLoad_Monitor > 0) Begin
                    If ((iRow_Count > iLoad_Monitor) and (Mod(iRow_Count, iLoad_Monitor) = 0)) Send OnLoad_Monitor iRow_Count
                End
            Loop

            //Send DoBest_Fit
        End

        Send OnClose_DataSource
        Set Private_piRow_Count to iRow_Count
        Send Cursor_Ready of Cursor_Control
    End_Procedure

    //-------------------------------------------------------------------------

    Procedure OnOpen_DataSource
        // Event Hook
    End_Procedure

    //-------------------------------------------------------------------------

    Procedure OnPrepare_RowData
        // Event Hook
        //
        // Send Add_Item_Data for each column
    End_Procedure

    //-------------------------------------------------------------------------

    Procedure OnClose_DataSource
        // Event Hook
    End_Procedure

    //-------------------------------------------------------------------------

    Procedure Add_Item_Data String sItem
        String[] sData

        Get psData_Items to sData
        Move sItem to sData[SizeOfArray(sData)]
        Set psData_Items to sData
    End_Procedure

    //=========================================================================

    Procedure OnComGroupOrderChanged
        Boolean bGroupRow
        Integer iCount iRow iWork
        Handle  hoGrid_Rows hoRow hoGroupRow
        Variant vGrid_Rows  vRow

        If (pbCollapseGroups(Self)) Begin
            Get phoGridRows     to hoGrid_Rows
            Get phoGridRow      to hoRow
            Get phoGridGroupRow to hoGroupRow
            Get ComRows to vGrid_Rows
            Set pvComObject of hoGrid_Rows to vGrid_Rows

            Get ComCount of hoGrid_Rows to iCount
            Decrement iCount

            For iRow from 0 to iCount
                Get ComRow of hoGrid_Rows iRow to vRow
                Set pvComObject of hoRow to vRow

                Get ComGroupRow of hoRow to bGroupRow
                If (bGroupRow) Begin
                    Set pvComObject of hoGroupRow to vRow
                    Set ComExpanded of hoRow to False

                    Get ComCount of hoGrid_Rows to iCount
                    Decrement iCount
                End
            Loop
        End
    End_Procedure

    Function Ensure_Visible String sTag Returns Boolean
        Boolean bFound bGroupRow bExpanded
        Integer iCount iLoop
        Handle hoRecords hoRec hoGrid_Rows hoRow hoGroupRow
        Variant vRec vRow vGrid_Rows vGroup_Row
        String sRecTag
        Integer[] aiRow

        Get phoGridRecords  to hoRecords
        Get phoGridRecord   to hoRec
        Get phoGridRows     to hoGrid_Rows
        Get phoGridRow      to hoRow
        Get phoGridGroupRow to hoGroupRow

        Get ComRows to vGrid_Rows
        Set pvComObject of hoGrid_Rows to vGrid_Rows

        Get ComCount of hoRecords to iCount

        //Find record with matching TAG
        Decrement iCount
        Move False to bFound
        Move 0 to iLoop
        Repeat
            Get ComRecord of hoRecords iLoop to vRec
            Set pvComObject of hoRec to vRec

            Get ComTag of hoRec to sRecTag
            If (sRecTag = sTag) Begin
                Move True to bFound
            End
            Increment iLoop
        Until ((iLoop = iCount) or bFound)

        If (bFound) Begin
            //tag found so find row
            Get ComFindRow of hoGrid_Rows vRec to vRow
            If (IsNullComObject(vRow)) Begin
                //Row not found so must be in a collapsed group.
                //Have to expand each group until we find row
                Move False to bFound
                Get ComCount of hoGrid_Rows to iCount
                Decrement iCount
                For iLoop from 0 to iCount
                    Get ComRow of hoGrid_Rows iLoop to vRow
                    Set pvComObject of hoRow to vRow

                    Get ComGroupRow of hoRow to bGroupRow
                    If (bGroupRow) Begin
                        Set pvComObject of hoGroupRow to vRow
                        Get ComExpanded of hoGroupRow to bExpanded
                        If (not(bExpanded)) Begin
                            Set ComExpanded of hoGroupRow to True
                            Get ComFindRow of hoGrid_Rows vRec to vRow
                            If (IsNullComObject(vRow)) Begin
                                Move iLoop to aiRow[SizeOfArray(aiRow)]
                                Get ComCount of hoGrid_Rows to iCount
                                Decrement iCount
                            End
                            Else Begin
                                Move True to bFound
                                Move (iCount + 1) to iLoop  //bomb loop
                            End
                        End
                    End
                Loop

                //Collapse any groups that we have just expanded
                Move (SizeOfArray(aiRow)) to iCount
                While (iCount > 0)
                    Decrement iCount
                    Get ComRow of hoGrid_Rows aiRow[iCount] to vGroup_Row
                    Set pvComObject of hoGroupRow to vGroup_Row
                    Set ComExpanded of hoGroupRow to False
                Loop
            End
        End

        If (bFound) Begin
            //Found row so make it the focus.
            //We use FocusedRow as this makes the row visible and
            //highlights it. EnsureVisible only makes row visible.
            Set pvComObject of hoRow to vRow
            Set ComFocusedRow to vRow
            //Send ComEnsureVisible of hoRow
        End

        Function_Return bFound
    End_Function

    //=========================================================================

    {MethodType=Event}
    Procedure OnSetOrdering tdRC_Ordering[] ByRef taRC_Ordering
    End_Procedure

    {MethodType=Event}
    Procedure OnSetGrouping tdRC_Ordering[] ByRef taRC_Ordering
    End_Procedure

    {MethodType=Method Visibility=Private}
    Procedure DoSetOrdering Boolean bGroup
        tdRC_Ordering[] taRC_Ordering
        Integer iColumns iSort
        Handle hoOrder hoColumns hoColumn
        Variant vColumn vColumns vOrder

        If (bGroup) Begin
            Get ComGroupsOrder to vOrder
            Send OnSetGrouping (&taRC_Ordering)
        End
        Else Begin
            Get ComSortOrder to vOrder
            Send OnSetOrdering (&taRC_Ordering)
        End

        Move (SizeOfArray(taRC_Ordering)) to iColumns
        If (iColumns=0) Begin
            Procedure_Return
        End

        Get phoGridColumnOrder to hoOrder
        Get phoGridColumns to hoColumns
        Get phoGridColumn to hoColumn

        Get ComColumns to vColumns
        Set pvComObject of hoOrder to vOrder
        Set pvComObject of hoColumns to vColumns

        For iSort from 0 to (iColumns-1)
            Get ComColumn of hoColumns taRC_Ordering[iSort].iColumn to vColumn
            Set pvComObject of hoColumn to vColumn
            Set ComSortAscending of hoColumn to (not(taRC_Ordering[iSort].bDescending))
            Send ComAdd of hoOrder vColumn
        Loop
    End_Procedure

    {MethodType=Method Visibility=Private}
    Procedure DoSetColumnOrdering
        Send DoSetOrdering False
    End_Procedure

    {MethodType=Method Visibility=Private}
    Procedure DoSetColumnGrouping
        Send DoSetOrdering True
    End_Procedure

    {MethodType=Method}
    Procedure SortGridByColumn tdRC_Ordering[] tRC_Ordering
        Handle hoSortOrder hoCol
        Integer iItem

        Get phoGridColumn to hoCol
        Get phoGridColumnOrder to hoSortOrder

        Send ComDeleteAll of hoSortOrder
        For iItem from 0 to (SizeOfArray(tRC_Ordering) -1)
            Set pvComObject of hoCol to (ComColumn(phoGridColumns(Self), tRC_Ordering[iItem].iColumn))
            Set ComSortAscending of hoCol to tRC_Ordering[iItem].bDescending
            Send ComAdd of hoSortOrder (pvComObject(hoCol))
        Loop
    End_Procedure //SortGridByColumn tdRC_Ordering[] tRC_Ordering

    //=========================================================================
    // Navigator methods

    { Visibility = False }
    Function Focus_Row_Index Returns Integer
        Integer iRetval
        Variant vRow

        Get ComFocusedRow to vRow
        If (not(IsNullComObject(vRow))) Begin
            Set pvComObject of (phoGridRow(Self)) to vRow
            Get ComIndex    of (phoGridRow(Self)) to iRetval
        End
        Function_Return iRetval
    End_Function

    { Visibility = False }
    Function Last_Row_Index Returns Integer
        Integer iRowCount

        Get ComCount of (phoGridRows(Self)) to iRowCount

        Function_Return (iRowCount - 1) //zero based
    End_Function

    { Visibility = False }
    Function Find_Next_Non_Group_Row Integer iIndex Returns Integer
        Boolean bGroupRow
        Handle  hoRows hoRow
        Variant vRow
        Integer iRowCount

        Get phoGridRows  to hoRows
        Get phoGridRow   to hoRow

        Get Last_Row_Index to iRowCount
        If (iIndex < iRowCount) Increment iIndex

        Repeat
            Get ComRow of hoRows iIndex to vRow
            Set pvComObject of hoRow to vRow
            Get ComGroupRow of hoRow to bGroupRow
            If (bGroupRow) Begin
                Increment iIndex
            End
        Until (not(bGroupRow) or (iIndex = iRowCount))

        If (bGroupRow) Move -1 to iIndex

        Function_Return iIndex
    End_Function

    { Visibility = False }
    Procedure MoveToRow Integer iIndex
        Send ComMoveToRow of (phoGridNavigator(Self)) iIndex False False
    End_Procedure

    Procedure MoveToFirstRow
        Integer iIndex

        Get Find_Next_Non_Group_Row -1 to iIndex
        If (iIndex <> -1) Send MoveToRow iIndex
    End_Procedure

    Procedure MoveUpRow
        Boolean bGroupRow
        Handle hoRows hoRow
        Variant vRows  vRow
        Integer iIndex

        Get Focus_Row_Index to iIndex
        If (iIndex > 0) Begin
            Get phoGridRows   to hoRows
            Get phoGridRow    to hoRow

            Get ComRows to vRows
            Set pvComObject of hoRows to vRows

            Repeat
                Get ComRow of hoRows (iIndex -1) to vRow
                Set pvComObject of hoRow to vRow
                Get ComGroupRow of hoRow to bGroupRow
                If (bGroupRow) Begin
                    Decrement iIndex
                End
            Until (not(bGroupRow) or (iIndex < 2))

            If (not(bGroupRow)) Send MoveToRow (iIndex - 1)
        End
    End_Procedure

    Procedure MoveDownRow
        Integer iIndex

        Get Focus_Row_Index to iIndex
        Get Find_Next_Non_Group_Row iIndex to iIndex

        If (iIndex <> -1) Send MoveToRow iIndex
    End_Procedure

    Procedure MoveToLastRow
        Integer iRowCount

        Get Last_Row_Index to iRowCount
        Send MoveToRow iRowCount
    End_Procedure

    //=========================================================================
    // Other features

    Procedure Standard_PrintFooter
        Handle hoPrintPageHeaderFooter  hoGridPrintOptions hoClient
        String sLabel

        Get Client_id                to hoClient
        Get Label       of  hoClient to sLabel
        Get phoGridPrintOptions    to hoGridPrintOptions
        Get phoPrintPageHeaderFooter to hoPrintPageHeaderFooter

        Set pvComObject     of hoPrintPageHeaderFooter to (ComFooter(hoGridPrintOptions))
        Set ComFormatString of hoPrintPageHeaderFooter to ("&D &b" * String(sLabel) * "&b Page &p of &P")
    End_Procedure

    Procedure Set PrintFooter String sValue
        Handle hoPrintPageHeaderFooter  hoGridPrintOptions
        Get phoGridPrintOptions    to hoGridPrintOptions
        Get phoPrintPageHeaderFooter to hoPrintPageHeaderFooter

        Set pvComObject     of hoPrintPageHeaderFooter to (ComFooter(hoGridPrintOptions))
        Set ComFormatString of hoPrintPageHeaderFooter to sValue
    End_Procedure

    Procedure Set PrintHeader String sValue
        Handle hoPrintPageHeaderFooter  hoGridPrintOptions
        Get phoGridPrintOptions    to hoGridPrintOptions
        Get phoPrintPageHeaderFooter to hoPrintPageHeaderFooter

        Set pvComObject     of hoPrintPageHeaderFooter to (ComHeader(hoGridPrintOptions))
        Set ComFormatString of hoPrintPageHeaderFooter to sValue
    End_Procedure

    //=========================================================================
    //Standard Dataflex methods

    Procedure Deactivating Returns Integer
        Integer iRetVal

        Forward Get Msg_Deactivating to iRetVal

        If (phoFieldChooser(Self)) Begin
            Set Visible_State of (phoFieldChooser(Self)) to False
        End
        Send PX_Save

        Procedure_Return iRetVal
    End_Procedure

