Struct tdSigCjCal_Dialog_CustomIcon
    Integer eAction
    tdSigCjCal_CustomIcon[] tCustomIcons
End_Struct

//-----------------------------------------------------------------------------

// Category="SigCj:Dialogs" Visibility=Public
Struct tdSigCjCal_Dialog_CustomProperty
    Integer eAction
    Boolean bRemoveExisting
    tdSigCjCal_CustomProperty[] tCustomProperties
End_Struct

//-----------------------------------------------------------------------------

