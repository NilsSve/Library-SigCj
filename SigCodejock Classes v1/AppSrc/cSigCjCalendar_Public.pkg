// Category="SigCj:Data" Visibility=Public
Struct tdSigCjCal_Event             //Suggested type and size
    Integer iID                     //NUM  8.0
    Boolean bAllDayEvent            //NUM  2.0
    String  sBody                   //ASC  254
    Integer eBusyStatus             //NUM  2.0
    String  sCategories             //ASC  254
    Date    dCreationDate           //DAT    6
    String  tmCreationTime          //ASC    5
    String  sCreatedBy              //ASC   20
    String  sCustomIcons            //ASC  254
    String  sCustomProperties       //ASC  254
    Boolean bDB_Link                //NUM  2.0
    String  sDB_Key                 //ASC   20
    String  sDB_Table               //ASC   20
    Date    dEndDate                //DAT    6
    String  tmEndTime               //ASC    5
    Integer eImportance             //NUM  2.0
    String  sLabel                  //ASC  254
    Date    dLastMod_Date           //DAT    6
    String  tmLastMod_Time          //ASC    5
    String  sLastMod_By             //ASC   20
    String  sLocation               //ASC  254
    Boolean bMeetingFlag            //NUM  2.0
    Boolean bPrivateFlag            //NUM  2.0
    Integer eRecurr_State           //NUM  2.0
    Boolean bReminder               //NUM  2.0
    Integer iRem_MinsBefore         //NUM  8.0
    String  sRem_SoundFile          //ASC  254
    Integer iScheduleID             //NUM  8.0
    String  sScheduleIDs            //NUM  8.0
    Date    dStartDate              //DAT    6
    String  tmStartTime             //ASC    5
    String  sSubject                //ASC  254
    Date    dRE_StartDateOrg        //DAT    6
    String  tmRE_StartTimeOrg       //ASC    5
    Date    dRE_EndDateOrg          //DAT    6
    String  tmRE_EndTimeOrg         //ASC    5
    Boolean bRE_Deleted             //NUM  2.0
    Integer iRec_Pattern_id         //NUM  8.0
End_Struct                          

//-----------------------------------------------------------------------------

// Category="SigCj:Data" Visibility=Public
Struct tdSigCjCal_RecPattern        //Suggested type and size
    Integer iID                     //NUM 8.0   rp  ID
    String  sCustomProp_XML         //ASC 254   rp  CustomProperties
    Integer iDurationMinutes        //NUM 8.0   rp  DurationMinutes
    Integer iEndAfterOcc            //NUM 8.0   rp  EndAfterOccurrences
    Date    dEndDate                //DAT   6   rp  EndDate
    String  tmEndTime               //ASC   5   rp  {used to cal DurationMinutes}
    Integer eEndMethod              //NUM 2.0   rp  EndMethod
    Integer iMasterEventId          //NUM 8.0   rp  MasterEventId
    Date    dStartDate              //DAT   6   rp  StartDate
    String  tmStartTime             //ASC   5   rp  StartTime
    Boolean bRoD_WeekDayOnly        //NUM 2.0   rpo DailyEveryWeekDayOnly
    Integer iRoD_Int_Days           //NUM 4.0   rpo DailyIntervalDays
    Integer iRoData1                //NUM 8.0   rpo Data1
    Integer iRoData2                //NUM 8.0   rpo Data2
    Integer iRoData3                //NUM 8.0   rpo Data3
    Integer iRoData4                //NUM 8.0   rpo Data4
    Integer iRoM_DayOfMonth         //NUM 2.0   rpo MonthlyDayOfMonth
    Integer iRoM_Int_Months         //NUM 8.0   rpo MonthlyIntervalMonths
    Integer iRoM_NthInt_Mths        //NUM 8.0   rpo MonthNthIntervalMonths
    Integer iRoM_Nth_Day            //NUM 2.0   rpo MonthNthWhichDay
    Integer eRoM_Nth_DayMask        //NUM 2.0   rpo MonthNthWhichDayMask
    Integer eRoRecurr_Type          //NUM 2.0   rpo RecurrenceType
    Integer eRoW_DayWeekMask        //NUM 2.0   rpo WeeklyDayOfWeekMask
    Integer iRoW_Int_Weeks          //NUM 8.0   rpo WeeklyIntervalWeeks
    Integer iRoY_DayOfMonth         //NUM 2.0   rpo YearlyDayOfMonth
    Integer iRoY_MonthOfYear        //NUM 2.0   rpo YearlyMonthOfYear
    Integer iRoY_NthM_OfYear        //NUM 8.0   rpo YearNthMonthOfYear
    Integer iRoY_Nth_Day            //NUM 2.0   rpo YearNthWhichDay
    Integer iRoY_Nth_DayMask        //NUM 8.0   rpo YearNthWhichDayMask
End_Struct

//-----------------------------------------------------------------------------

// Category="SigCj:Dialogs" Visibility=Public
Struct tdSigCjCal_Dialog_RecPattern
    Integer eAction
    tdSigCjCal_RecPattern tRecPattern
End_Struct

