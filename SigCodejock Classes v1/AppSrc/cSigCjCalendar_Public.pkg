//These Enumerated values and Structure data types are used by the example 
//custom dialog. They are provided as a seperate package so that they can be 
//used in any custom dialogs the users may create. 

//=============================================================================

Use VDFBase.pkg

//=============================================================================

// Category="SigCj:Dialogs" Visibility=Public
//Enum eCal_Dialog_Action - Dialog Actions

Define eCal_Dialog_Action_Disabled  for 0
Define eCal_Dialog_Action_None      for 1
Define eCal_Dialog_Action_Exists    for 2
Define eCal_Dialog_Action_Create    for 3
Define eCal_Dialog_Action_Delete    for 4
//Define eCal_Dialog_Action_Update    for 5
Define eCal_Dialog_Action_Edit      for 5

//-----------------------------------------------------------------------------

// Category="SigCj:Dialogs" Visibility=Public
//Enum eCal_Recur_End - Recurring Pattern End Type

Define eCal_Recur_EndAfterOcc  for 1  //OLExtpCalendarPatternEndAfterOccurrences 
Define eCal_Recur_EndOnDate    for 0  //OLExtpCalendarPatternEndDate             
Define eCal_Recur_EndNoEnd     for 2  //OLExtpCalendarPatternEndNoDate           

//-----------------------------------------------------------------------------

// Category="SigCj:Dialogs" Visibility=Public
//Enum eCal_Recur_Type  - Recurrence type

Define eCal_Recur_Daily    for 1    //OLExtpCalendarRecurrenceDaily   
Define eCal_Recur_Weekly   for 2    //OLExtpCalendarRecurrenceWeekly  
Define eCal_Recur_Monthly  for 3    //OLExtpCalendarRecurrenceMonthly 
Define eCal_Recur_MonthNth for 4    //OLExtpCalendarRecurrenceMonthNth
Define eCal_Recur_Yearly   for 5    //OLExtpCalendarRecurrenceYearly  
Define eCal_Recur_YearNth  for 6    //OLExtpCalendarRecurrenceYearNth 

//-----------------------------------------------------------------------------

// Category="SigCj:Dialogs" Visibility=Public
//Enum eCal_Series_Action - Series action

Define eCal_Series_Abort            for 0
Define eCal_Series_All              for 1
Define eCal_Series_Single           for 2

//-----------------------------------------------------------------------------

// Category="SigCj:General" Visibility=Public
//Enum eCal_WW_Mask - Working Week Mask

Define eCal_WW_Sunday    for   1    //OLExtpCalendarDaySunday
Define eCal_WW_Monday    for   2    //OLExtpCalendarDayMonday
Define eCal_WW_Tuesday   for   4    //OLExtpCalendarDayTuesday
Define eCal_WW_Wednesday for   8    //OLExtpCalendarDayWednesday
Define eCal_WW_Thursday  for  16    //OLExtpCalendarDayThursday
Define eCal_WW_Friday    for  32    //OLExtpCalendarDayFriday
Define eCal_WW_Saturday  for  64    //OLExtpCalendarDaySaturday
Define eCal_WW_AllWeek   for 127    //OLExtpCalendarDayAllWeek
Define eCal_WW_SaSu      for  65    //OLExtpCalendarDaySaSu
Define eCal_WW_Mo_Fr     for  62    //OLExtpCalendarDayMo_Fr

//=============================================================================

// Category="SigCj:Schedules" Visibility=Public
Struct tdSigCjCal_Category
    Integer iID
    String  sName           //Short Description
    Integer iBorderColor
    Integer iColor_1        //Light Color
    Integer iColor_2        //Dark Color
    Number  nGradient
End_Struct

//-----------------------------------------------------------------------------

// Category="SigCj:Properties" Visibility=Public
Struct tdSigCjCal_CustomProperty
    String sName
    String sValue
End_Struct

//-----------------------------------------------------------------------------

// Category="SigCj:DB_Link" Visibility=Public
Struct tdSigCjCal_DB_Link
    Boolean bDB_Link
    String  sTable
    String  sKey
End_Struct

//-----------------------------------------------------------------------------

// Category="SigCj:Icons" Visibility=Public
Struct tdSigCjCal_CustomIcon
    Integer iId
    String  sFileName
    Integer eAction
End_Struct

//-----------------------------------------------------------------------------

