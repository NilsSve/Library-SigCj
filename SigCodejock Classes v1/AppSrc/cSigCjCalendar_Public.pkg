Struct tdSigCjCal_Resource
    Integer iID
    String  sName
    Integer iShadeColor
    Boolean bMuiltiColor
End_Struct

//-----------------------------------------------------------------------------

// Category="SigCj:Schedules" Visibility=Public
Struct tdSigCjCal_Schedule_Info
    Integer iID
    String  sName
    tdSigCjCal_Category[] taCateogies
End_Struct

//-----------------------------------------------------------------------------

// Category="SigCj:Dialogs" Visibility=Public
Struct tdSigCjCal_Dialog_Info
    Boolean bEnableResources                                //copy of pbEnableResources
    Boolean bMultiSchedulesMode                             //copy of pbMultiSchedulesMode
    Boolean bAllScheduleInfo                                //copy of pbAllScheduleInfo
    Handle  hoRecurringDialog                               //copy of phoRecurringDialog
    Integer eAction_Event                                   //action for Event
    String  sDefaultSchedule                                //Clicked schedule if in multi schedule mode
    tdSigCjCal_Event                 tEvent                 //Event data if editing or a set of default if creating
    tdSigCjCal_Dialog_RecPattern     tDialog_RecPattern     //RecPattern data if exists or a set of default if none
    tdSigCjCal_Dialog_DB_Link        tDialog_DB_Link        //info about DB_Link
    tdSigCjCal_Dialog_CustomIcon     tDialog_CustomIcon     //info about custom Icons
    tdSigCjCal_Dialog_CustomProperty tDialog_CustomProperty //info about custom properties
    tdSigCjCal_Schedule_Info[]       taSchedules            //Schedule and category information.
End_Struct

