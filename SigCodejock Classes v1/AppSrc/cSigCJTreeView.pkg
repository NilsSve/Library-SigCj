Class cSigCJTreeView is a cSigCjComTreeView
    Import_Class_Protocol cSigCJMethods_Mixin

    Procedure Construct_Object
        Forward Send Construct_Object

        { DesignTime=False }
        Property Integer Private_peAppearance OLExtpAppearanceStandard

        { DesignTime=False }
        Property OLE_Color Private_piBackColor clWindow

        { DesignTime=False }
        Property OLE_Color Private_piForeColor clBlue

        { DesignTime=False }
        Property OLE_Color Private_piSelectionBackColor clHighlight

        { DesignTime=False }
        Property OLE_Color Private_piSelectionForeColor clHighlightText

        { DesignTime=False }
        Property Boolean Private_pbCheckboxes False

        { DesignTime=False }
        Property Boolean Private_pbEnabled True

        { DesignTime=False }
        Property Boolean Private_pbEnableMarkup False

        { DesignTime=False }
        Property Boolean Private_pbFullRowSelect False

        { DesignTime=False }
        Property Boolean Private_pbHideSelection True

        { DesignTime=False }
        Property Boolean Private_pbHotTracking True

        { DesignTime=False }
        Property Integer Private_piIconSize 16

        { DesignTime=False }
        Property Integer Private_piIndentation 0

        { DesignTime=False }
        Property Integer Private_peLabelEdit xtpTreeViewLabelManual

        { DesignTime=False }
        Property Integer Private_peOLEDropMode xtpOLEDropNone

        { DesignTime=False }
        Property String  Private_psPathSeparator "\"

        { DesignTime=False }
        Property Boolean Private_pbRightToLeft False

        { DesignTime=False }
        Property Boolean Private_pbRightToLeftReading False

        { DesignTime=False }
        Property Boolean Private_pbScroll True

        { DesignTime=False }
        Property Boolean Private_pbShowBorder True

        { DesignTime=False }
        Property Integer Private_peShowLines xtpTreeViewShowLinesAtRoot

        { DesignTime=False }
        Property Boolean Private_pbShowPlusMinus True

        { DesignTime=False }
        Property Boolean Private_pbSingleSel False

        { DesignTime=False }
        Property Boolean Private_pbSorted False

        { DesignTime=False }
        Property Boolean Private_pbUseVisualStyle False

        { DesignTime=False }
        Property tdTreeviewNodeTag[] ptNodeTags

        { Category="CodeJock" InitialValue=False }
        Property Boolean pbActive_Track False

        { Category="CodeJock" InitialValue=False }
        Property Variant pvLast_Node

        { Category="CodeJock" InitialValue=False }
        Property Integer piLast_Node_Index

        { DesignTime=False }
        Property String  psRootName "Root"

        { DesignTime=False }
        Property Integer piKey 0

        { DesignTime=False }
        Property Handle  phoNodes     (Create(Self, U_cSigCjComTreeViewNodes))

        { DesignTime=False }
        Property Handle  phoNode      (Create(Self, U_cSigCjTreeViewNode))

        { DesignTime=False }
        Property Handle  phoChildNode (Create(Self, U_cSigCjTreeViewNode))

        { DesignTime=False }
        Property Handle  phoParentNode (Create(Self, U_cSigCjTreeViewNode))

       { DesignTime=False }
        Property Handle phoContextMenu_TreeView  (Create(Self, U_cSigCJTreeView_ContextMenu))

        { Category="CodeJock" }
        Property String psImage_FolderClose "Closetree.bmp"

        { Category="CodeJock" }
        Property String psImage_FolderOpen  "Opentree.bmp"

        { Category="CodeJock" }
        Property String psImage_FolderItem1 "ActionClear.ico"

        { Category="CodeJock" }
        Property String psImage_FolderItem2 "ActionDeleteRecord.ico"

        { Category="CodeJock" }
        Property String[] pasImage_FolderItem

    End_Procedure

    //-------------------------------------------------------------------------

    Procedure OnCreate
        Variant vNodes vIcons
        Handle   hoContextMenu_TreeView
        String[] asImage_FolderItem

        Forward Send OnCreate

        Set ComAppearance          to (Private_peAppearance        (Self))
        Set ComBackColor           to (Private_piBackColor         (Self))
        Set ComForeColor           to (Private_piForeColor         (Self))
        Set ComCheckboxes          to (Private_pbCheckboxes        (Self))
        Set ComEnabled             to (Private_pbEnabled           (Self))
        Set ComEnableMarkup        to (Private_pbEnableMarkup      (Self))
        Set ComFullRowSelect       to (Private_pbFullRowSelect     (Self))
        Set ComHideSelection       to (Private_pbHideSelection     (Self))
        Set ComHotTracking         to (Private_pbHotTracking       (Self))
        Set ComIconSize            to (Private_piIconSize          (Self))
        Set ComIndentation         to (Private_piIndentation       (Self))
        Set ComLabelEdit           to (Private_peLabelEdit         (Self))
        Set ComOLEDropMode         to (Private_peOLEDropMode       (Self))
        Set ComPathSeparator       to (Private_psPathSeparator     (Self))
        Set ComRightToLeft         to (Private_pbRightToLeft       (Self))
        Set ComRightToLeftReading  to (Private_pbRightToLeftReading(Self))
        Set ComScroll              to (Private_pbScroll            (Self))
        Set ComSelectionBackColor  to (Private_piSelectionBackColor(Self))
        Set ComSelectionForeColor  to (Private_piSelectionForeColor(Self))
        Set ComShowBorder          to (Private_pbShowBorder        (Self))
        Set ComShowLines           to (Private_peShowLines         (Self))
        Set ComShowPlusMinus       to (Private_pbShowPlusMinus     (Self))
        Set ComSingleSel           to (Private_pbSingleSel         (Self))
        Set ComSorted              to (Private_pbSorted            (Self))
        Set ComUseVisualStyle      to (Private_pbUseVisualStyle    (Self))

        Get ComNodes    to vNodes
        Set pvComObject of (phoNodes(Self)) to vNodes
        Set ComIcons    to (ComIcons(ghoSigCjGlobalSetting))

        Get pasImage_FolderItem to asImage_FolderItem
        Move (psImage_FolderItem1(Self))  to asImage_FolderItem[1]
        Move (psImage_FolderItem2(Self))  to asImage_FolderItem[2]
        Set pasImage_FolderItem to asImage_FolderItem

        // Add Context Menu option hooks
        Get phoContextMenu_TreeView   to hoContextMenu_TreeView
        If (Object_Id(hoContextMenu_TreeView))   Send OnAdd_ContextMenu_TreeView   hoContextMenu_TreeView

        Send OnClearTreeview
        Send OnCreateTree
    End_Procedure

    Procedure OnCreateTree // Hook
    End_Procedure

    Procedure OnClearTreeview
        tdTreeviewNodeTag[] tNodeTags

        Send ComClear   of (phoNodes(Self))
        Set piKey to 0
        Set ptNodeTags to tNodeTags
    End_Procedure

    //=========================================================================
    Procedure Rebuild_TreeView
        Send OnClearTreeview
        Send OnCreateTree
    End_Procedure

    Procedure Refresh_TreeView
        Send OnClearTreeview
        Send OnCreateTree
    End_Procedure
    //=========================================================================

    #IF (SigCj_Codejock_Version < 150001)
        { MethodType=Property Category="CodeJock" InitialValue=OLExtpAppearanceStandard }
        { EnumList="OLExtpAppearanceStandard, OLExtpAppearanceFlat, OLExtpAppearanceUltraFlat, OLExtpAppearanceOffice2000, OLExtpAppearanceOffice2000, OLExtpAppearanceOffice2003, OLExtpAppearanceOffice2007" }
    #ELSE
        { MethodType=Property Category="CodeJock" InitialValue=OLExtpAppearanceStandard }
        { EnumList="OLExtpAppearanceStandard, OLExtpAppearanceFlat, OLExtpAppearanceUltraFlat, OLExtpAppearanceOffice2000, OLExtpAppearanceOffice2000, OLExtpAppearanceOffice2003, OLExtpAppearanceResource" }
    #ENDIF
