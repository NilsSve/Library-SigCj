    //-------------------------------------------------------------------------

    { MethodType=Event Category="CodeJock" } // Hook
    Procedure OnActive_Track Handle hoNode Integer iIndex
    End_Procedure

    { MethodType=Event Category="CodeJock" } // Hook
    Procedure OnNodeChanging Handle hoNode Integer iIndex
        // If you running with data aware components, then this is the hook to save the record before moving on.
        //  You will need to refind the Old node first
    End_Procedure

    { MethodType=Event Category="CodeJock" } // Hook
    Procedure OnNodeClick Handle hoNode
    End_Procedure

    { Visibility=Private }
    Procedure OnComNodeClick Variant llNode
        Handle  hoNode
        Integer iIndex iLast_Index
        Variant vLast_Node

        Get phoNode     to hoNode
        Set pvComObject of hoNode to llNode
        Send Parent_Node_Properties hoNode

        If (pbActive_Track(Self)) Begin
            Get ComIndex    of hoNode to iIndex

            Get piLast_Node_Index to iLast_Index
            If ((iLast_Index > 0) and (iLast_Index <> iIndex)) Begin
                Get pvLast_Node to vLast_Node
                If (not(IsNullComObject(vLast_Node))) Begin
                    Set pvComObject of hoNode to vLast_Node
                    Get ComIndex    of hoNode to iIndex
                    Send OnNodeChanging hoNode iIndex
                    // Refind the current node, in case its been changed by OnNodeChange
                    // If not refound then OnActive_Track may fail depending the developer code
                    Set pvComObject of hoNode to llNode
                    Get ComIndex    of hoNode to iIndex
                End
            End
            Set pvLast_Node to llNode
            Set piLast_Node_Index to iIndex

            Send OnActive_Track hoNode iIndex
        End
        Send OnNodeClick hoNode
    End_Procedure

    //-------------------------------------------------------------------------

    Procedure Load_NodeTags Handle hoNode Integer iLevel String sCargo Handle hoDDO String sRowId Integer iRecnum
        Integer iIndex
        tdTreeviewNodeTag[] tNodeTags

        Get ptNodeTags to tNodeTags
        Get ComIndex of hoNode to iIndex

        If (num_arguments  = 6) Move iRecnum to tNodeTags[iIndex].iRecnum
        If (num_arguments >= 5) Move sRowId  to tNodeTags[iIndex].sRowId
        If (num_arguments >= 4) Move hoDDO   to tNodeTags[iIndex].hDDO
        If (num_arguments >= 3) Move sCargo  to tNodeTags[iIndex].sCargo
        If (num_arguments >= 2) Move iLevel  to tNodeTags[iIndex].iLevel
        Set ptNodeTags to tNodeTags
    End_Procedure

    //-------------------------------------------------------------------------

    Procedure Remove_Node Integer iIndex
        Integer iCurrent_Index iSize

        Send ComRemove of (phoNodes(Self)) iIndex

        tdTreeviewNodeTag[] tNodeTags
        Get ptNodeTags to tNodeTags
        Move ((SizeOfArray(tNodeTags))-1) to iSize

        Move iIndex to iCurrent_Index
        Repeat
            If (iCurrent_Index = iSize) Begin
                Move (RemoveFromArray(tNodeTags, iCurrent_Index)) to tNodeTags
            End
            Else Begin
                Move tNodeTags[(iCurrent_Index+1)].iRecnum  to tNodeTags[iCurrent_Index].iRecnum
                Move tNodeTags[(iCurrent_Index+1)].sRowId   to tNodeTags[iCurrent_Index].sRowId
                Move tNodeTags[(iCurrent_Index+1)].hDDO     to tNodeTags[iCurrent_Index].hDDO
                Move tNodeTags[(iCurrent_Index+1)].sCargo   to tNodeTags[iCurrent_Index].sCargo
                Move tNodeTags[(iCurrent_Index+1)].iLevel   to tNodeTags[iCurrent_Index].iLevel
            End
            Increment iCurrent_Index
        Until (iCurrent_Index >= iSize)
        Set ptNodeTags to tNodeTags
    End_Procedure

    //-------------------------------------------------------------------------

    Function Add_Root_Node String sText String sKey Returns Handle
        Variant  vNode
        Handle   hoNodes hoNode
        Integer  iKey iIndex
        String   sNewKey
        tdTreeviewNodeTag[] tNodeTags

        Get ptNodeTags to tNodeTags

        Get phoNodes to hoNodes
        Get phoNode  to hoNode

        If (num_arguments =  1) Begin
            Move sText to sNewKey
        End
        If (num_arguments =  2) Begin
            Move sKey to sNewKey
        End

        // If no Key has been supplied create one
        If (Trim(sNewKey) = '') Begin
            Set piKey to (piKey(Self)+1)
            Get piKey to sNewKey
        End
        Get ComAdd   of hoNodes (psRootName(Self)) OLExtpTreeViewNext sNewKey sText Nothing to vNode
        Set pvComObject of hoNode to vNode
        Set psImage     of hoNode to (psImage_FolderClose(Self))
        Get ComIndex    of hoNode to iIndex

        Move 1       to tNodeTags[iIndex].iLevel

        Set ptNodeTags to tNodeTags
        Function_Return hoNode
    End_Function

    Function Add_Child_Node String sText String sKey String sParent_Key Integer iLevel Integer iImage Returns Handle
        Variant  vNode vParent
        Handle   hoNodes hoNode
        Integer  iKey iParent iIndex
        String   sNewKey sNewParentKey
        String[] asImage_FolderItem
        tdTreeviewNodeTag[] tNodeTags

        Get ptNodeTags to tNodeTags

        Get phoNodes to hoNodes
        Get phoNode  to hoNode

        If (num_arguments >=  2) Begin
            Move sKey to sNewKey
        End
        If (num_arguments >=  3) Begin
            Move sParent_Key to sNewParentKey
        End

        // If no Parent Key has been supplied presume its the last key
        If (Trim(sNewParentKey) = '') Begin
            Get piKey to sNewParentKey
        End

        // If no Key has been supplied create one
        If (Trim(sNewKey) = '') Begin
            Set piKey to (piKey(Self)+1)
            Get piKey to sNewKey
        End
        // Debug code
        //Showln sNewParentKey " "  sNewKey " " sText
        Get ComAdd   of hoNodes sNewParentKey OLExtpTreeViewChild sNewKey sText Nothing to vNode
        Set pvComObject of hoNode to vNode
        Set psImage     of hoNode to (psImage_FolderClose(Self))
        Get ComIndex    of hoNode to iIndex
        Move "" to tNodeTags[iIndex].sCargo // force save of array

        If (num_arguments =  4) Move iLevel to tNodeTags[iIndex].iLevel
        If (num_arguments =  5) Begin
            Get pasImage_FolderItem to asImage_FolderItem
            If ((iImage > 0) And (asImage_FolderItem[iImage] <> "")) Set psImage of hoNode to asImage_FolderItem[iImage]
        End

        Set ptNodeTags to tNodeTags

        Function_Return hoNode
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Event Category="CodeJock" }
    Procedure OnExpand Handle hoNode
    End_Procedure

    { DesignTime=False Visibility=Private }
    Procedure OnComExpand Variant llNode
        Handle  hoNode
        String  sImage
        Integer iImage iClose iOpen

        Get phoNode  to hoNode
        Set pvComObject of hoNode to llNode
        Get ComImage    of hoNode to iImage

        Get Find_Image_Name of ghoSigCjGlobalSetting iImage to sImage

        If (sImage = (Uppercase(psImage_FolderClose(Self)))) Begin
            Set psImage    of hoNode to (psImage_FolderOpen(Self))
        End
        Send OnExpand hoNode
    End_Procedure

    //-------------------------------------------------------------------------

    { MethodType=Event Category="CodeJock" }
    Procedure OnCollapse Handle hoNode
    End_Procedure

    { DesignTime=False Visibility=Private }
    Procedure OnComCollapse Variant llNode
        Handle hoNode
        String sImage
        Integer iImage iClose iOpen

        Get phoNode  to hoNode
        Set pvComObject of hoNode to llNode
        Get ComImage    of hoNode to iImage

        Get Find_Image_Name of ghoSigCjGlobalSetting iImage to sImage

        If (sImage = (Uppercase(psImage_FolderOpen(Self)))) Begin
            Set psImage of hoNode to (psImage_FolderClose(Self))
        End
        Send OnCollapse hoNode
    End_Procedure

    { Visibility=Private }
    Procedure Parent_Node_Properties Handle hoNode
        Variant vParentNode
        Handle  hoParentNode
        RowID   riRow

        Get ComParent of hoNode to vParentNode
        If (not(IsNullComObject(vParentNode))) Begin

            Get phoParentNode to hoParentNode
            Set pvComObject of hoParentNode to vParentNode

            Set piParent_Index  of hoNode to (piIndex(hoParentNode))
            Set psParent_Key    of hoNode to (psKey(hoParentNode))
            Set psParent_Text   of hoNode to (psText(hoParentNode))
            Set psParent_Cargo  of hoNode to (Node_Cargo(hoParentNode))
            Set piParent_Level  of hoNode to (Node_Level(hoParentNode))
            Set piParent_Recnum of hoNode to (Node_Recnum(hoParentNode))
            Set priParent_RowID of hoNode to (Node_RowId(hoParentNode))
        End
        Else Begin
            Set piParent_Index  of hoNode to 0
            Set psParent_Key    of hoNode to ""
            Set psParent_Text   of hoNode to ""
            Set psParent_Cargo  of hoNode to ""
            Set piParent_Level  of hoNode to 0
            Set piParent_Recnum of hoNode to 0
            Set priParent_RowID of hoNode to riRow
        End
    End_Procedure

    //-------------------------------------------------------------------------
    // Context Menu OnAdd_ and OnPopup_ Hook options
    //-------------------------------------------------------------------------
    Procedure OnAdd_ContextMenu_TreeView Handle hoContextMenu
        Send Add_Standard_MenuItems of hoContextMenu
    End_Procedure

    Procedure OnPopup_ContextMenu_TreeView Handle hoContextMenu
    End_Procedure

     // On Mouse Up set Left click options and Right click context menu options
    Procedure OnComMouseUp Short llButton Short llShift OLE_XPOS_PIXELS llx OLE_YPOS_PIXELS lly
        Handle  hoContextMenu_TreeView hoNode
        Variant vHitTest
        Integer iIndex iTicket

        Get phoContextMenu_TreeView to hoContextMenu_TreeView
        Get phoNode                 to hoNode

        // Times by 15 seems to do the trick!
        Get ComHitTest (llx*15) (lly*15) to vHitTest
        If (IsComObject(vHitTest)) Begin
            Set pvComObject of hoNode   to vHitTest
        End

        If (llButton = 1) Begin
        End
        If (llButton = 2) Begin
            Send Activate of (Self) // Ensure that the VDF object also has the focus
            // Great we know what node we are on or do we!
            Send Popup of hoContextMenu_TreeView
        End
    End_Procedure

End_Class // cSigCJTreeView

