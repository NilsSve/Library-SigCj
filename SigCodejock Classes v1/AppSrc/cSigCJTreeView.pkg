        { Visibility=Private }
        Property Boolean Private_pbBold False

        { Visibility=Private }
        Property Boolean Private_pbChecked False

        { Visibility=Private }
        Property Boolean Private_pbExpanded False

        { Visibility=Private }
        Property Boolean Private_pbSelected False

        { Visibility=Private }
        Property String Private_psImage

        { Visibility=Private }
        Property Integer Private_piImage

        // Node properties
        { Visibility=Private }
        Property Integer Private_piIndex

        { Visibility=Private }
        Property String Private_psKey

        { Visibility=Private }
        Property String Private_psText

        { Visibility=Private }
