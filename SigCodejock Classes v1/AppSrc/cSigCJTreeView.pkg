        Get piRecnum to iRetval
        Function_Return iRetval
    End_Function

    //-------------------------------------------------------------------------

    Procedure Remove_Children
        Handle  hoChildNode
        Variant vChild
        Integer iIndex iChildren

        Get phoChildNode to hoChildNode

        Get ComChildren to iChildren
        If (iChildren > 0) Begin
            Repeat
                Get ComChild    to vChild
                Set pvComObject of hoChildNode to vChild
                Get ComIndex    of hoChildNode to iIndex
                Send Remove_Node iIndex
                Get ComChildren to iChildren
            Until (iChildren <= 0)
        End
    End_Procedure // Remove_Children

    //-------------------------------------------------------------------------

    Procedure OnCreate
        Forward Send OnCreate

        Set ComBackColor           to (Private_piBackColor(Self))
        Set ComForeColor           to (Private_piForeColor(Self))
        Set ComBold                to (Private_pbBold(Self))
        Set ComExpanded            to (Private_pbExpanded(Self))
    End_Procedure

End_Class // cSigCjTreeViewNode


