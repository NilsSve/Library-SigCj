	Define eTV_FirstChild
	Define eTV_FirstSibling
	Define eTV_LastSibling
	Define eTV_NextSibling
	Define eTV_Parent
	Define eTV_PreviousSibling
	Define eTV_Root
End_Enum_List

Struct tdTreeviewNodeTag
    Integer iLevel
    Integer iRecnum
    String  sRowId
    Handle  hDDO
    String  sCargo
End_Struct

Class cSigCjTreeViewNode is a cSigCjComTreeViewNode
