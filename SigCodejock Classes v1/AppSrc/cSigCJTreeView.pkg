        Set SigCJProperty Set_Private_pbCheckboxes Set_ComCheckboxes to bState
    End_Procedure

    Function pbCheckboxes Returns Boolean
        Function_Return (SigCJProperty(Self, Get_Private_pbCheckboxes, Get_ComCheckboxes ))
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Property Category="CodeJock" InitialValue=True }
    Procedure Set pbEnabled Boolean bState
        Set SigCJProperty Set_Private_pbEnabled Set_ComEnabled to bState
