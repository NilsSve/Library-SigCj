Use DfAllEnt.pkg
Use SigCJMonthCalendar.sl 

Class cSigCJdbForm is a dbForm 
    
    Procedure Construct_Object
        Forward Send Construct_Object
        
        Property Integer pidbDateField         Public False

    End_Procedure

    Procedure mSet_Date_Forms
        Integer iKey iFile# iField# iFormType iMain_File
        String sKey

        //If (Object_Shadow_State(Self) eq 1)   Procedure_Return
        If (Enabled_State(Self) eq 0)   Procedure_Return
        If (Server(Self)) eq 0          Procedure_Return

        Get Data_File  item 0 to iFile#
        Get Data_Field item 0 to iField#
        Get Main_File of (Server(Self)) to iMain_File
        Get Form_Datatype item 0 to iFormType
        If (iFormType = Mask_Date_Window) Move DF_DATE to iKey
        Else If (iFile# > 0) Get_Attribute DF_FIELD_TYPE of iFile# iField# to iKey
        If (iKey = DF_DATE) Begin
            Set Form_Button        0  to Form_Button_Prompt
            Set Form_Button_Bitmap 0  to "CalendarPrompt.Bmp"
            Set Prompt_Object         to (oSigCJMonthCalendar_Lookup(Self))
            Set pidbDateField         to True
            Set Prompt_Button_Mode to PB_PromptOn
            On_Key kPrompt Send Prompt
        End
    End_Procedure

    Procedure Activating Returns Integer
        Integer iRetval

        Send mSet_Date_Forms

        Forward Get msg_Activating to iRetval
        Procedure_Return iRetVal
    End_Procedure

End_Class

//==============================================================================
//End of Package - cSigCJdbForm.pkg
