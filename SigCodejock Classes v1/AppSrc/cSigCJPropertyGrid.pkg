        If (not(IsNullComObject(pvComObject(Self)))) Begin
            If (not(IsNullComObject(pvComObject(Private.phoPropertyValueMetrics(Self))))) Begin
                Set ComForeColor of (Private.phoPropertyValueMetrics(Self)) to iColor
            End
        End
        Set Private.piValueForeColor to iColor
