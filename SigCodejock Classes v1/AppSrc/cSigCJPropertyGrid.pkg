{DocEnd} 
Class cSigCJPropertyGridSliderCtlItem is a cSigCJPropertyGridItem
    Import_Class_Protocol cSigCJPropertyGridItemSpinAndSlider_Mixin
    
    Procedure Construct_Object
        Forward Send Construct_Object
        { Visibility=Private }
        Property Handle Private.phoButtonObject     (Create(Self, U_cSigCjComPropertyGridInPlaceSliderControl))
        
        Send Define_SpinForm_and_Slider_Properties 
    End_Procedure
    
    { MethodType=Method Visibility=Private }
    Procedure Private.Create Handle hoParent Boolean bRecursive
        Variant vButton
        
        If (hoParent=0) Begin
            Procedure_Return
        End
        
        Forward Send Private.Create hoParent bRecursive
        Get ComAddSliderControl to vButton
        Set pvComObject of (Private.phoButtonObject(Self)) to vButton
        Send ApplySettings
    End_Procedure
End_Class

