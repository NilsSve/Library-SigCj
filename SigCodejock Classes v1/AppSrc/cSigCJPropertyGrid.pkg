    { MethodType=Property Category="CodeJock" }
    Procedure Set psFormat String sFormat
        Set SigCJProperty Set_Private.psFormat Set_ComFormat to sFormat
    End_Procedure

    { MethodType=Property Category="CodeJock" }
    Function psFormat Returns String
        Function_Return (Private.psFormat(Self))
    End_Function  
    
    
    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : Set PropertyItemMask
    //
    // Scope        : Public 
    //
    // Paramaters   : llMask, llLiteral, llPrompt
    //
    // Returns      : None
    //
    // Purpose      : Sets the mask of a property grid item 
    //                
    // Notes        : You can use any of these characters for defining your edit mask:
    //                0 - Numeric (0-9)
    //                9 - Numeric (0-9) or space (' ')
    //                # - Numeric (0-9) or space (' ') or ('+') or ('-')
    //                L - Alpha (a-Z)
    //                ? - Alpha (a-Z) or space (' ')
    //                a - Alpha numeric (0-9 and a-Z)
    //                a - Alpha numeric (0-9 and a-Z) or space (' ')
    //                & - All Print character only
    //                H - Hex digit (0-9 and a-F)
    //                X - Hex digit (0-9 and a-F) and space (' ')
    //                > - Forces characters to upper Case (a-Z)
    //                < - Forces characters to lower Case (a-z)
    //
    //                llLiteral defines the prompt area of the mask where text entry is allowed.  This should match the areas that 
    //                you have already defined as mask fields. By default the prompt character is '_' . 
    //                
    //                llPrompt is optional, but allows you to define default characters that you want displayed when the user presses 
    //                the backspace key. This usually represents data that has been previously saved then restored. This makes it easy 
    //                for the user to restore some or all of the default text displayed when the control was initialized. 
    //---------------------------------------------------
    {DocEnd}     
    
    Procedure Set PropertyItemMask String llMask String llLiteral Variant llPrompt
        tdPropertyItemMask tPropertyItemMask
        
        Move True      to tPropertyItemMask.bSetMask
        Move llMask    to tPropertyItemMask.sMask
        Move llLiteral to tPropertyItemMask.sLiteral
        Move llPrompt  to tPropertyItemMask.vPrompt
        Set ptPropertyItemMask to tPropertyItemMask
    End_Procedure

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : DoApplyMask
    //
    // Scope        : Private 
    //
    // Paramaters   : None
    //
    // Returns      : None
    //
    // Purpose      : Called from Private.Create. Applies any mask set using 'Set PropertyItemMask'
    //                
    // Notes        : Called internally. Developer does not need to concern themself with this
    //               
    //---------------------------------------------------
    {DocEnd} 
        
    Procedure DoApplyMask
        tdPropertyItemMask tPropertyItemMask
        
        Get ptPropertyItemMask to tPropertyItemMask
        If (tPropertyItemMask.bSetMask = True) Begin
            If (not(IsNullComObject(pvComObject(Self)))) Begin
                Send ComSetMask tPropertyItemMask.sMask tPropertyItemMask.sLiteral tPropertyItemMask.vPrompt
            End
        End      
    End_Procedure

    
    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : BindToDataBase
    //
    // Scope        : Public 
    //
    // Paramaters   : iFile iField 
    //
    // Returns      : None
    //
    // Purpose      : Links a grid item with the db (file and field). Sets Private.phoPropertyGridItemServer 
    //                and Private.piPropertyGridItemDataField  
    //                                                                     
    // Notes        : If an item is linked to the db, pbCapslock_State and piForm_Margin will be set automatically. If you don't
    //                Set psLabel or psHelpText these too will be taken from the DD
    //                Example Call: Send BindToDataBase File_Field Sysfile.Company_Name 
    //               
    //---------------------------------------------------
    {DocEnd}   

    Procedure BindToDataBase Integer hFile Integer iField
        Handle  hoDDO 
        Integer iLength iType iValidationType iPrecision
        Boolean bOptionEnabled
        String  sStatusHelp sLabel
        
        Get Item_Data_Set hFile to hoDDO 
        Set Private.phoPropertyGridItemServer to hoDDO
        Set Private.piPropertyGridItemDataField to iField
        //Set properties based on field and DD settings...
        If (hFile <> 0) Begin
            Get_Attribute DF_FIELD_LENGTH of hFile iField to iLength
            Set piForm_Margin to iLength
            Get_Attribute DF_FIELD_TYPE of hFile iField to iType
            If (iType=DF_ASCII) Begin
                Set peItemType to ePGItype_String
            End
            Else If (iType=DF_BCD) Begin
                Get_Attribute DF_FIELD_PRECISION of hFile iField to iPrecision
                If (iPrecision=0) Begin
                    Set peItemType to ePGItype_Number
                End
                Else Begin
                    Set peItemType to ePGItype_Double
                    Set psFormat to  ("%0."-String(iPrecision)-"f")  //Doesn't seem to work. Why?
                End
            End
            Else If (iType=DF_DATE) Begin
                Set peItemType to ePGItype_Date
            End
        End
        If (hoDDO <> 0) Begin
            //Should field by uppercase?
            Get Field_Option of hoDDO iField DD_CAPSLOCK to bOptionEnabled
            If (bOptionEnabled) Begin
                Set pbCapslock_State to True
            End
            //Should field by boolean?
            Get Field_Validation_Type of hoDDO iField to iValidationType
            If (iValidationType = FA_VALIDATION_TYPE_CHECKBOX) Begin
                Set peItemType to ePGItype_Boolean
                Set pbCapslock_State to False  // we don't need True/False to be uppercase
            End
            //Label and helptext
            Get Status_Help of hoDDO iField to sStatusHelp
            Get Field_Label_Long of hoDDO iField to sLabel
            If (psHelpText(Self)="") Begin
                Set psHelpText to sStatusHelp
            End
            If (psLabel(Self)="") Begin
                Set psLabel to sLabel
            End
        End
    End_Procedure


    { MethodType=Method Visibility=Private }
    Procedure Private.Create Handle hoParent Boolean bRecursive
        Variant vItem
        Integer iEditStyle eType
        Handle  hoItem
        
        //check for parent
        If (hoParent = 0) Begin
            Procedure_Return
        End
        //Add child item
        Get ComAddChildItem of hoParent (Private.peItemType(Self)) (Private.psLabel(Self)) (Private.pvValue(Self)) to vItem
        Set pvComObject to vItem
        Send Bind_Metrics  
        //Set the ComID value to 'self' so we can map back to the object (see Procedure OnComInplaceButtonDown)
        Set ComId to Self
        //Set Tag value
        Set pvTag to (Private.pvTag(Self))
        //If we have explicitly said that the default should NOT be the same as the initial value, set the default 
        If (not(pbDefaultAsInitialValue(Self))) Begin
            Set pvDefaultValue to (Private.pvDefaultValue(Self))
        End  
        //Set Help Text associated with the item
        Set psHelpText to (Private.psHelpText(Self))
        //Tootip
        Set psToolTip to (Private.psToolTip(Self))
        //Caption Image
        Set psImage to (Private.psImage(Self))
        //Set whether the item should be expanded (if it is expandable)
        Set pbCreateExpanded to (Private.pbCreateExpanded(Self))
        //Caption Emboldened State
        Set pbLabelEmboldened to (Private.pbLabelEmboldened(Self))
        //Apply any mask we may have set
        Send DoApplyMask
        //Set Hidden/ReadOnly states
        Set pbHidden to (Private.pbHidden(Self))
        Set pbReadOnly to (Private.pbReadOnly(Self))
        //Password
        Set pbPassword_State to (Private.pbIsPassword(Self))
        //Capslock
        If (pbCapslock_State(Self)) Begin
            Add ePGEditStyle_Uppercase to iEditStyle
        End  
        Set ComEditStyle to (iEditStyle + ePGEditStyle_AutoHScroll)
        //Format   
        If (peItemType(Self)=ePGItype_Double) Begin
            If (psFormat(Self)<>"") Begin
                Set psFormat to (Private.psFormat(Self)) 
            End
        End
        //Data Entry Width
        If (piForm_Margin(Self)<>0) Begin 
            Set piForm_Margin to (Private.piFormMargin(Self)) 
        End
        Set piValueBackgroundColor to (Private.piValueBackgroundColor(Self))        
        //Create any child objects of this object...
        If (bRecursive) Begin
            Broadcast Send Private.Create Self True
        End        
    End_Procedure
    
    //OnChange
    //Called whenever an item's value is changed and user exists the item
    {MethodType=Event}
    Procedure OnChange
    End_Procedure   
    
    //OnEditAfter
    //Called whenever an item's value has been editted. Setting llCancel to True will stop the edit
    Procedure OnEditAfter String ByRef llNewValue Boolean ByRef llCancel
    End_Procedure
    
    //OnMoveItemDataIn
    //Called from DoMoveDataIn (of the property grid). This is called from OnCreate and can be used to set item data (appy from database,say)
    {MethodType=Event}
    Procedure OnMoveItemDataIn
    End_Procedure
    
    //OnMoveItemDataOut
    //Called from DoMoveDataOut (of the property grid). This can be used to save item data to the database, say
    {MethodType=Event}
    Procedure OnMoveItemDataOut
    End_Procedure  
       
End_Class

{DocStart = Class}
//---------------------------------------------------
//
// Class        : cSigCJPropertyGridSubCategory
//
// Superclass   : cSigCJPropertyGridItem 
//
// Package      : cSigCJPropertyGrid.pkg
//
// Mixins       : 
//
// Description  : Property Grid Item in style of Category. Used for Sub Categorising items with Categories
//
// Properties   : psLabel               (String)   
//                psHelpText            (String)  
//                psToolTip             (String)  
//                pbCreateExpanded      (Boolean) 
//                pbLabelEmboldened     (Boolean) 
//
// Events       : 
//
// Methods      :      
//
// Notes        :
//
// To Do        :           
//               
//---------------------------------------------------
{DocEnd} 

Class cSigCJPropertyGridSubCategory is a cSigCJPropertyGridItem

    Procedure Construct_Object
        Forward Send Construct_Object
        
        Set Private.peItemType to ePGItype_Category
        Set Private.pbLabelEmboldened to True
    End_Procedure
End_Class

{DocStart = Class}
//---------------------------------------------------
// Mixin Class  : cSigCJPropertyGridItemButton_Mixin
//---------------------------------------------------
{DocEnd} 

Class cSigCJPropertyGridItemButton_Mixin is a Mixin
    
    Procedure Define_Item_Button_Properties
        { DesignTime=False }
        Property String  Private.psButtonCaption    "..."
        { DesignTime=False }
        Property Boolean Private.pbButtonEnabled    True
        { DesignTime=False }
        Property String  Private.psButtonImage
        { DesignTime=False }
        Property Integer Private.piButtonID
        { DesignTime=False }
        Property String  Private.psButtonToolTip
        { DesignTime=False }
        Property Integer Private.piButtonWidth      20
        
        { Visibility=Private }
        Property Handle  Private.phoButtonObject    (Create(Self, U_cSigCjComPropertyGridInPlaceButton))              
    End_Procedure
    
    Procedure Set_Item_Button_Properties
        Set psButtonCaption   to (Private.psButtonCaption(Self))    
        Set pbButtonEnabled   to (Private.pbButtonEnabled(Self))
        Set psButtonImage     to (Private.psButtonImage(Self))
        Set piButtonWidth     to (Private.piButtonWidth(Self))
        Set psButtonTooltip   to (Private.psButtonTooltip(Self))         
    End_Procedure

    { MethodType=Property Category="CodeJock"}
    { InitialValue="..." }
    Procedure Set psButtonCaption String sCaption
        If (not(IsNullComObject(pvComObject(Self)))) Begin 
            If (not(IsNullComObject(pvComObject(Private.phoButtonObject(Self))))) Begin
                Set ComCaption of (Private.phoButtonObject(Self)) to sCaption
            End
        End
        Set Private.psButtonCaption to sCaption
    End_Procedure

    { MethodType=Property Category="CodeJock"}
    Function psButtonCaption Returns String
        Function_Return (Private.psButtonCaption(Self))
    End_Function

    { MethodType=Property Category="CodeJock"}
    { InitialValue=True }
    Procedure Set pbButtonEnabled Boolean bEnabled
        If (not(IsNullComObject(pvComObject(Self)))) Begin 
            If (not(IsNullComObject(pvComObject(Private.phoButtonObject(Self))))) Begin
                Set ComEnabled of (Private.phoButtonObject(Self)) to bEnabled
            End
        End
        Set Private.pbButtonEnabled to bEnabled
    End_Procedure

    { MethodType=Property Category="CodeJock"}
    Function pbButtonEnabled Returns Boolean
        Function_Return (Private.pbButtonEnabled(Self))
    End_Function
    
    { MethodType=Property Category="CodeJock"}
    Procedure Set psButtonTooltip String sTooltip
        If (not(IsNullComObject(pvComObject(Self)))) Begin 
            If (not(IsNullComObject(pvComObject(Private.phoButtonObject(Self))))) Begin
                Set ComToolTip of (Private.phoButtonObject(Self)) to sTooltip
            End
        End
        Set Private.psButtonTooltip to sTooltip
    End_Procedure

    { MethodType=Property Category="CodeJock"}
    Function psButtonTooltip Returns String
        Function_Return (Private.psButtonTooltip(Self))
    End_Function    
    
    { MethodType=Property Category="CodeJock"}
    Procedure Set psButtonImage String sImage
        Integer iIndex
        
        If (not(IsNullComObject(pvComObject(Self)))) Begin 
            Get AddImage of ghoSigCjGlobalSetting sImage 0 0 to iIndex //Won't add it again if already uploaded once
            If (not(IsNullComObject(pvComObject(Private.phoButtonObject(Self))))) Begin
                Set ComIconIndex of (Private.phoButtonObject(Self)) to iIndex
            End
        End
        Set Private.psButtonImage to sImage
    End_Procedure

    { MethodType=Property Category="CodeJock"}
    Function psButtonImage Returns String
        Function_Return (Private.psButtonImage(Self))
    End_Function         

    { MethodType=Property Category="CodeJock"}
    Procedure Set piButtonID Integer iID
        If (not(IsNullComObject(pvComObject(Self)))) Begin 
            If (not(IsNullComObject(pvComObject(Private.phoButtonObject(Self))))) Begin
                Set ComId of (Private.phoButtonObject(Self)) to iID
            End
        End
        Set Private.piButtonID to iID
    End_Procedure

    { MethodType=Property Category="CodeJock"}
    Function piButtonID Returns Integer
        Function_Return (Private.piButtonID(Self))
    End_Function     
    
    { MethodType=Property Category="CodeJock"}
    Procedure Set piButtonWidth Integer iWidth
        If (not(IsNullComObject(pvComObject(Self)))) Begin 
            If (not(IsNullComObject(pvComObject(Private.phoButtonObject(Self))))) Begin
                Set ComWidth of (Private.phoButtonObject(Self)) to iWidth
            End
        End
        Set Private.piButtonWidth to iWidth
    End_Procedure

    { MethodType=Property Category="CodeJock"}
    Function piButtonWidth Returns Integer
        Function_Return (Private.piButtonWidth(Self))
    End_Function      

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Function     : piButtonIndex
    //
    // Scope        : Read Only 
    //
    // Paramaters   : None
    //
    // Returns      : Integer
    //
    // Purpose      : Retrieves index of button in array of item's buttons
    //                
    // Notes        : 
    //               
    //---------------------------------------------------
    {DocEnd} 
    
    Function piButtonIndex Returns Integer
        Integer iIndex
        Move -1 to iIndex
        If (not(IsNullComObject(pvComObject(Self)))) Begin 
            If (not(IsNullComObject(pvComObject(Private.phoButtonObject(Self))))) Begin
                Get ComIndex of (Private.phoButtonObject(Self)) to iIndex
            End
        End
        Function_Return iIndex
    End_Function

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Function     : pvItem
    //
    // Scope        : Read Only 
    //
    // Paramaters   : None
    //
    // Returns      : Variant (IdDispatch)
    //
    // Purpose      : Retrieves the parent property grid item for this button (item that this button is drawn in).
    //                
    // Notes        : 
    //               
    //---------------------------------------------------
    {DocEnd} 
        
    Function pvItem Returns Variant
        Variant vItem
        
        If (not(IsNullComObject(pvComObject(Self)))) Begin 
            If (not(IsNullComObject(pvComObject(Private.phoButtonObject(Self))))) Begin
                Get ComItem of (Private.phoButtonObject(Self)) to vItem
            End
        End
        Function_Return vItem
    End_Function
    
    {MethodType=Event}
    //Fired when ever a combo is dropped down or expand button clicked
    Procedure OnClick
    End_Procedure    
    
End_Class

{DocStart = Class}
//---------------------------------------------------
//
// Class        : cSigCJPropertyGridExpandBtnItem
//
// Superclass   : cSigCJPropertyGridItem 
//
// Package      : cSigCJPropertyGrid.pkg
//
// Mixins       : cSigCJPropertyGridItemButton_Mixin
//
// Description  : Property Grid Item with Expand (lookup) button '...'
//
// Properties   : psLabel                 (String)               
//                psHelpText              (String)               
//                psToolTip               (String)               
//                pbCreateExpanded        (Boolean)              
//                pbLabelEmboldened       (Boolean)              
//                peItemType              (Integer)              
//                pvValue                 (Variant)              
//                pbDefaultAsInitialValue (Boolean)              
//                pvDefaultValue          (Variant)              
//                pvInitialValue          (Variant)              
//                pvTag                   (Variant)              
//                pbHidden                (Boolean)              
//                pbReadOnly              (Boolean)              
//                pbPassword_State        (Boolean)              
//                pbCapslock_State        (Boolean)              
//                piForm_Margin           (Integer)              
//                piValueBackgroundColor  (Integer)              
//                psButtonCaption         (String) 
//                pbButtonEnabled         (Boolean)  
//                psButtonImage           (String)  
//                piButtonWidth           (Integer)  
//                psButtonTooltip         (String) 
//
// Events       : OnClick
//                OnChange         
//                OnEditAfter      
//                OnMoveItemDataIn 
//                OnMoveItemDataOut
//
// Methods      : Procedure Set PropertyItemMask (String llMask String llLiteral Variant llPrompt)         
//
// Notes        :
//
// To Do        :           
//               
//---------------------------------------------------
{DocEnd} 

Class cSigCJPropertyGridExpandBtnItem is a cSigCJPropertyGridItem
    Import_Class_Protocol cSigCJPropertyGridItemButton_Mixin

    Procedure Construct_Object
        Forward Send Construct_Object
    
        Send Define_Item_Button_Properties
    End_Procedure

    { MethodType=Method Visibility=Private }
    Procedure Private.Create Handle hoParent Boolean bRecursive
        Variant vButton
        
        If (hoParent=0) Begin
            Procedure_Return
        End
               
        Forward Send Private.Create hoParent bRecursive
        Get ComAddInplaceButton ePGIBS_Expand to vButton
        Set pvComObject of (Private.phoButtonObject(Self)) to vButton  
        Send Set_Item_Button_Properties
    End_Procedure
    
End_Class

{DocStart = Class}
//---------------------------------------------------
//
// Class        : cSigCJPropertyGridComboFormItem
//
// Superclass   : cSigCJPropertyGridItem 
//
// Package      : cSigCJPropertyGrid.pkg
//
// Mixins       : cSigCJPropertyGridItemButton_Mixin
//
// Description  : Property Grid Item with Drop Down ComboForm
//
// Properties   : psLabel                 (String)               
//                psHelpText              (String)               
//                psToolTip               (String)               
//                pbCreateExpanded        (Boolean)              
//                pbLabelEmboldened       (Boolean)              
//                peItemType              (Integer)              
//                pvValue                 (Variant)              
//                pbDefaultAsInitialValue (Boolean)              
//                pvDefaultValue          (Variant)              
//                pvInitialValue          (Variant)              
//                pvTag                   (Variant)              
//                pbHidden                (Boolean)              
//                pbReadOnly              (Boolean)              
//                pbPassword_State        (Boolean)              
//                pbCapslock_State        (Boolean)              
//                piForm_Margin           (Integer)              
//                piValueBackgroundColor  (Integer)              
//                psButtonCaption         (String) 
//                pbButtonEnabled         (Boolean)  
//                psButtonImage           (String)  
//                piButtonWidth           (Integer)  
//                psButtonTooltip         (String) 
//
// Events       : OnClick
//                OnChange         
//                OnEditAfter      
//                OnMoveItemDataIn 
//                OnMoveItemDataOut
//                OnAddLookupItems
//
// Methods      : Procedure Set PropertyItemMask     (String llMask String llLiteral Variant llPrompt)  
//                Procedure Set LookupItemImage      (Integer iItemIndex String sImage)
//                Procedure Set LookupItemData       (Integer iItemIndex Integer iItemData)
//                Procedure AddLookupItem            (String sDescription Integer iItemData String sImage Variant vCode)
//                Function  CodeFromDescription      (String sDescription Boolean ByRef bFound Returns Variant)
//                Function  ItemDataFromDescription  (String sDescription Boolean ByRef bFound Returns Integer)
//                Function  DescriptionFromCode      (Variant vCode Boolean ByRef bFound Returns String)
//                Procedure ComboDeleteItems        
//
// Notes        :
//
// To Do        :           
//               
//---------------------------------------------------
{DocEnd} 

Class cSigCJPropertyGridComboFormItem is a cSigCJPropertyGridItem
    Import_Class_Protocol cSigCJPropertyGridItemButton_Mixin
    
    Procedure Construct_Object
        Forward Send Construct_Object
    
        Send Define_Item_Button_Properties
        { DesignTime=False }
        Property tdGridItemSelectionValue[] ptaGridItemSelectionValue  
    End_Procedure
    
    Procedure End_Construct_Object
        Send OnAddLookupItems
        Forward Send End_Construct_Object
    End_Procedure
    
    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : OnAddLookupItems
    //
    // Scope        : Public Event 
    //
    // Paramaters   : None
    //
    // Returns      : None
    //
    // Purpose      : Intended that you would call "Send AddLookupItem" from this event to populate the combo 
    //                
    // Notes        : If the item is bound to a data field that has a Field_Table_Object the combo will automatically 
    //                be populated. If you want to add images you should forward Send OnAddLookupItems and then add the images
    //               
    //---------------------------------------------------
    {DocEnd} 
        
    { MethodType=Event Visibility=Public }
    Procedure OnAddLookupItems
    End_Procedure

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : ComboDeleteItems
    //
    // Scope        : Public Method 
    //
    // Paramaters   : None
    //
    // Returns      : None
    //
    // Purpose      : Can be used to clear all of a comboforms data items
    //                
    // Notes        : 
    //               
    //---------------------------------------------------
    {DocEnd}     
    
    Procedure ComboDeleteItems
        Handle hoConstraint_s
        Variant vConstraint_s
        tdGridItemSelectionValue[] taGridItemSelectionValues

        Get ComConstraints to vConstraint_s
        Get Create U_cSigCjComPropertyGridItemConstraints to hoConstraint_s
        Set pvComObject of hoConstraint_s to vConstraint_s
        Send ComClear of hoConstraint_s  
        Send Destroy of hoConstraint_s
        //clear our internal array also
        Set ptaGridItemSelectionValue to taGridItemSelectionValues     
    End_Procedure
    
    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : DoAddLookupItems
    //
    // Scope        : Private 
    //
    // Paramaters   : None
    //
    // Returns      : None
    //
    // Purpose      : Called from Private.Create. Adds any lookup items to the list of constraints 
    //                
    // Notes        : Called internally. Developer does not need to concern themself with this
    //               
    //---------------------------------------------------
    {DocEnd} 
        
    { MethodType=Method Visibility=Private }
    Procedure DoAddLookupItems
        Handle hoConstraint_s hoConstraint
        Variant vConstraint_s vConstraint
        Integer iItems iItemIndex
        tdGridItemSelectionValue[] taGridItemSelectionValues
        
        If (not(IsNullComObject(pvComObject(Self)))) Begin
            Get ptaGridItemSelectionValue to taGridItemSelectionValues
            Move (SizeOfArray(taGridItemSelectionValues)) to iItems
            Get ComConstraints to vConstraint_s
            Get Create U_cSigCjComPropertyGridItemConstraints to hoConstraint_s
            Set pvComObject of hoConstraint_s to vConstraint_s
            Send ComClear of hoConstraint_s
            Get Create U_cSigCjComPropertyGridItemConstraint to hoConstraint
            For iItemIndex from 1 to iItems
                Send ComAdd of hoConstraint_s taGridItemSelectionValues[iItemIndex-1].sDescription taGridItemSelectionValues[iItemIndex-1].iItemData
                //now associate any iconindex
                Get ComItem of hoConstraint_s iItemIndex to vConstraint
                Set pvComObject of hoConstraint to vConstraint 
                Set ComIconIndex of hoConstraint to taGridItemSelectionValues[iItemIndex-1].iIconIndex
            Loop            
            Send destroy of hoConstraint  
            Send Destroy of hoConstraint_s
        End
    End_Procedure

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : AddLookupItem
    //
    // Scope        : Public 
    //
    // Paramaters   : sCaption, iData, sImage, vCode
    //
    // Returns      : None
    //
    // Purpose      : 'Registers' an item for inclusion in list of item constraints (lookup values) 
    //                
    // Notes        : vCode is added because it could be that the developer wants to display a descriptive value
    //                whilst mapping to a code value in the background (the code being the value that ultimately
    //                will be saved to the database)
    //               
    //---------------------------------------------------
    {DocEnd} 
        
    { MethodType=Method Visibility=Public }
    Procedure AddLookupItem String sDescription Integer iItemData String sImage Variant vCode
        tdGridItemSelectionValue[] taGridItemSelectionValue
        Integer iItems iIconIndex 
        
        Get AddImage of ghoSigCjGlobalSetting sImage 0 0 to iIconIndex //won't re-add it if already added
        Get ptaGridItemSelectionValue to taGridItemSelectionValue
        Move (SizeOfArray(taGridItemSelectionValue)) to iItems
        Move sDescription to taGridItemSelectionValue[iItems].sDescription
        Move iItemData to taGridItemSelectionValue[iItems].iItemData
        Move iIconIndex to taGridItemSelectionValue[iItems].iIconIndex
        Move vCode to taGridItemSelectionValue[iItems].vCode
        Set ptaGridItemSelectionValue to taGridItemSelectionValue                    
    End_Procedure

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : Set LookupItemImage
    //
    // Scope        : Public 
    //
    // Paramaters   : Integer iItemIndex String sImage
    //
    // Returns      : None
    //
    // Purpose      : Sets icon index for specified lookup item. 
    //                
    // Notes        : MUST be called AFTER AddLookupItem
    //               
    //---------------------------------------------------
    {DocEnd} 
        
    Procedure Set LookupItemImage Integer iItemIndex String sImage
        tdGridItemSelectionValue[] taGridItemSelectionValue
        Integer iImageIndex
        
        Get AddImage of ghoSigCjGlobalSetting sImage 0 0 to iImageIndex
        Get ptaGridItemSelectionValue to taGridItemSelectionValue
        Move iImageIndex to taGridItemSelectionValue[iItemIndex-1].iIconIndex
        Set ptaGridItemSelectionValue to taGridItemSelectionValue
    End_Procedure

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : Set LookupItemData
    //
    // Scope        : Public 
    //
    // Paramaters   : Integer iItemIndex Integer iItemData
    //
    // Returns      : None
    //
    // Purpose      : Sets item data for specified lookup item. 
    //                
    // Notes        : MUST be called AFTER AddLookupItem
    //               
    //---------------------------------------------------
    {DocEnd} 
    
    Procedure Set LookupItemData Integer iItemIndex Integer iItemData
        tdGridItemSelectionValue[] taGridItemSelectionValue
        
        Get ptaGridItemSelectionValue to taGridItemSelectionValue
        Move iItemData to taGridItemSelectionValue[iItemIndex-1].iItemData
        Set ptaGridItemSelectionValue to taGridItemSelectionValue
    End_Procedure    
    

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Function     : ConstraintDescriptionComparison
    //
    // Scope        : Private 
    //
    // Paramaters   : tdGridItemSelectionValue x2 (for comparison)
    //
    // Returns      : Integer
    //
    // Purpose      : To compare the Description elements of 2 structs. 
    //                
    // Notes        : Used internally from CodeFromDescription and ItemDataFromDescription
    //               
    //---------------------------------------------------
    {DocEnd} 
        
    { MethodType=Method Visibility=Private }
    Function ConstraintDescriptionComparison tdGridItemSelectionValue tDesc1 tdGridItemSelectionValue tDesc2 Returns Integer
        Integer iRetVal
        If (tDesc1.sDescription = tDesc2.sDescription) Begin
            Move (EQ) to iRetVal
        End  
        Function_Return iRetVal
    End_Function

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Function     : CodeFromDescription
    //
    // Scope        : Public 
    //
    // Paramaters   : sDescription, bFound (byref)
    //
    // Returns      : Variant (vCode)
    //
    // Purpose      : If you have the current value of an property item and you know this is one of a list of constraints
    //                you can call this function to return the 'Code' value that is associated with this 'Description' value 
    //                
    // Notes        : bFound is passed by reference and tells the developer if the value that they were looking for was found or not.
    //                You can't rely on a return value of 0 (or blank) as an indication of whether it was found because these may be valid values  
    //               
    //---------------------------------------------------
    {DocEnd} 
        
    { MethodType=Method Visibility=Public }
    Function CodeFromDescription String sDescription Boolean ByRef bFound Returns Variant
        Integer iSearchIndex
        Variant vRetVal
        tdGridItemSelectionValue[] taGridItemSelectionValues
        tdGridItemSelectionValue tGridItemSelectionValue
        
        Move False to bFound
        Get ptaGridItemSelectionValue to taGridItemSelectionValues
        Move sDescription to tGridItemSelectionValue.sDescription
        Move (SearchArray(tGridItemSelectionValue,taGridItemSelectionValues,Self,get_ConstraintDescriptionComparison)) to iSearchIndex
        If (iSearchIndex <> -1) Begin
            Move taGridItemSelectionValues[iSearchIndex].vCode to vRetVal
            Move True to bFound
        End
        Function_Return vRetVal 
    End_Function

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Function     : ItemDataFromDescription
    //
    // Scope        : Public 
    //
    // Paramaters   : sDescription, bFound (byref)
    //
    // Returns      : Integer (iItemData)
    //
    // Purpose      : If you have the current value of an property item and you know this is one of a list of constraints
    //                you can call this function to return the iItemData value that is associated with this 'Description' value 
    //                
    // Notes        : bFound is passed by reference and tells the developer if the value that they were looking for was found or not.
    //                You can't rely on a return value of 0 (or blank) as an indication of whether it was found because these may be valid values  
    //               
    //---------------------------------------------------
    {DocEnd} 
        
    { MethodType=Method Visibility=Public }
    Function ItemDataFromDescription String sDescription Boolean ByRef bFound Returns Integer
        Integer iRetVal iSearchIndex 
        tdGridItemSelectionValue[] taGridItemSelectionValues
        tdGridItemSelectionValue tGridItemSelectionValue
        
        Move False to bFound
        Get ptaGridItemSelectionValue to taGridItemSelectionValues
        Move sDescription to tGridItemSelectionValue.sDescription
        Move (SearchArray(tGridItemSelectionValue,taGridItemSelectionValues,Self,get_ConstraintDescriptionComparison)) to iSearchIndex
        If (iSearchIndex <> -1) Begin
            Move taGridItemSelectionValues[iSearchIndex].iItemData to iRetVal
            Move True to bFound 
        End
        Function_Return iRetVal 
    End_Function

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Function     : ConstraintCodeComparison
    //
    // Scope        : Private 
    //
    // Paramaters   : tdGridItemSelectionValue x2 (for comparison)
    //
    // Returns      : Integer
    //
    // Purpose      : To compare the Code elements of 2 structs. 
    //                
    // Notes        : Used internally from DescriptionFromCode
    //               
    //---------------------------------------------------
    {DocEnd} 
        
    { MethodType=Method Visibility=Private }
    Function ConstraintCodeComparison tdGridItemSelectionValue tCode1 tdGridItemSelectionValue tCode2 Returns Integer
        Integer iRetVal
        If (tCode1.vCode = tCode2.vCode) Begin
            Move (EQ) to iRetVal
        End  
        Function_Return iRetVal
    End_Function

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Function     : DescriptionFromCode
    //
    // Scope        : Public 
    //
    // Paramaters   : vCode, bFound (byref)
    //
    // Returns      : sDescription
    //
    // Purpose      : If a property grid item has a combo form with descriptions and associated code values then you can call this
    //                function to determine the description value for a specified code. This is most useful when populating the grid
    //                from a database where the raw data is a code value but you wish to show a descriptive value in the control (think dbcomforms)
    //                
    // Notes        : bFound is passed by reference and tells the developer if the value that they were looking for was found or not.
    //                You can't rely on a return value of 0 (or blank) as an indication of whether it was found because these may be valid values  
    //               
    //---------------------------------------------------
    {DocEnd} 
        
    { MethodType=Method Visibility=Public }
    Function DescriptionFromCode Variant vCode Boolean ByRef bFound Returns String
        String  sRetVal
        Integer iSearchIndex 
        tdGridItemSelectionValue[] taGridItemSelectionValues
        tdGridItemSelectionValue tGridItemSelectionValue
        
        Move False to bFound
        Get ptaGridItemSelectionValue to taGridItemSelectionValues
        Move vCode to tGridItemSelectionValue.vCode
        Move (SearchArray(tGridItemSelectionValue,taGridItemSelectionValues,Self,get_ConstraintCodeComparison)) to iSearchIndex
        If (iSearchIndex <> -1) Begin
            Move taGridItemSelectionValues[iSearchIndex].sDescription to sRetVal
            Move True to bFound 
        End
        Function_Return sRetVal 
    End_Function

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Function     : BindToDataBase
    //
    // Scope        : Public 
    //
    // Paramaters   : Integer hFile Integer iField
    //
    // Returns      : None
    //
    // Purpose      : Forward Send, but then because this is a combo item, see if there is a validation table for this field
    //                If so, set the lookup items with the values from the validation table                
    //
    // Notes        : Set pbCapslock_State to False if there is a codevalidation table. It may be a capslock field, but this will
    //                be for the code, not the description (that we will be displaying)
    //               
    //---------------------------------------------------
    {DocEnd} 
    
    Procedure BindToDataBase Integer hFile Integer iField
        Variant[][] vTableData
        Integer iTableObject iItem
        Handle hoDD
        
        Forward Send BindToDataBase hFile iField
        Get Item_Server to hoDD
        If (hoDD <> 0) Begin
            Get Field_Table_Object of hoDD iField to iTableObject
            If (iTableObject <> 0) Begin
                Get TableData of iTableObject to vTableData
                For iItem from 0 to (SizeOfArray(vTableData)-1)
                    Send AddLookupItem vTableData[iItem][1] (iItem+1) '' vTableData[iItem][0]
                Loop
                //Finally, it may be that the field is capslock, but that this is for the code NOT the description...
                Set pbCapslock_State to False
            End
        End
    End_Procedure

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Function     : ReadItemFromDatabase
    //
    // Scope        : Public 
    //
    // Paramaters   : None
    //
    // Returns      : None
    //
    // Purpose      : Forward Send, but then because this is a combo item, see if we have a description that matches our value
    //                If so, display this instead               
    //               
    //---------------------------------------------------
    {DocEnd} 
    
    { MethodType = Method Visibility=Public }
    Procedure ReadItemFromDatabase
        Handle  hoDD
        Integer iField 
        Variant vValue
        Boolean bFound
        String  sDescription
        
        Forward Send ReadItemFromDatabase
        Get Item_Server to hoDD
        Get Item_Data_Field to iField
        If ((hoDD <> 0) and (iField <> 0)) Begin
            Get pvValue to vValue
            Get DescriptionFromCode vValue (&bFound) to sDescription 
            If (bFound) Begin
                Set pvInitialValue to sDescription   
            End
        End
    End_Procedure 
    
    { MethodType = Method Visibility=Public }
    Procedure MoveItemDataToDatabase 
        Handle  hoDD
        Integer iField
        Variant vValue vCode
        Boolean bFound
        
        Get Item_Server to hoDD
        Get Item_Data_Field to iField
        If ((hoDD <> 0) and (iField <> 0)) Begin
            Get pvValue to vValue
            Get CodeFromDescription vValue (&bFound) to vCode
            If (bFound) Begin
                Move vCode to vValue
            End
            Set Field_changed_Value of hoDD iField to vValue
        End
    End_Procedure
    
    { MethodType=Method Visibility=Private }
    Procedure Private.Create Handle hoParent Boolean bRecursive
        Variant vButton
        Handle  hoButtons
        
        If (hoParent=0) Begin
            Procedure_Return
        End
               
        Forward Send Private.Create hoParent bRecursive
        //If this is of peItemType ePGItype_Enum then we do not need to add a button - it will be added automatically
        If (peItemType(Self) = ePGItype_Enum) Begin
            Get Create U_cSigCjComPropertyGridInPlaceButtons to hoButtons
            Set pvComObject of hoButtons to (ComInplaceButtons(Self))
            Get ComItem of hoButtons 1 to vButton
            Send Destroy of hoButtons
        End
        Else Begin
            Get ComAddInplaceButton ePGIBS_Combo to vButton    
        End        
        Set pvComObject of (Private.phoButtonObject(Self)) to vButton  
        Send DoAddLookupItems
        Send Set_Item_Button_Properties
    End_Procedure
    
End_Class

{DocStart = Class}
//---------------------------------------------------
// Mixin Class  : cSigCJPropertyGridItemSpinAndSlider_Mixin
//---------------------------------------------------
{DocEnd} 

Class cSigCJPropertyGridItemSpinAndSlider_Mixin is a Mixin
    
    Procedure Define_SpinForm_and_Slider_Properties
        { DesignTime=False }
        Property Integer Private.piMax      100 
        { DesignTime=False }
        Property Integer Private.piMin        1
        { DesignTime=False }
        Property Integer Private.piWidth     20   
    End_Procedure

    { MethodType=Property Category="CodeJock"}
    { InitialValue=100 }    
    Procedure Set piMaximum Integer iMax                      
        If (not(IsNullComObject(pvComObject(Self)))) Begin 
            If (not(IsNullComObject(pvComObject(Private.phoButtonObject(Self))))) Begin
                Set ComMax of (Private.phoButtonObject(Self)) to iMax
            End
        End
        Set Private.piMax to iMax
    End_Procedure

    { MethodType=Property Category="CodeJock"}
    Function piMaximum Returns Integer
        Function_Return (Private.piMax(Self))
    End_Function
        
    { MethodType=Property Category="CodeJock"}
    { InitialValue=1 }    
    Procedure Set piMinimum Integer iMin                     
        If (not(IsNullComObject(pvComObject(Self)))) Begin 
            If (not(IsNullComObject(pvComObject(Private.phoButtonObject(Self))))) Begin
                Set ComMin of (Private.phoButtonObject(Self)) to iMin
            End
        End
        Set Private.piMin to iMin
    End_Procedure
    
    { MethodType=Property Category="CodeJock"}
    Function piMinimum Returns Integer
        Function_Return (Private.piMin(Self))
    End_Function
    
    { MethodType=Property Category="CodeJock"}  
    Procedure Set piWidth Integer iWidth 
        If (not(IsNullComObject(pvComObject(Self)))) Begin 
            If (not(IsNullComObject(pvComObject(Private.phoButtonObject(Self))))) Begin
                Set ComWidth of (Private.phoButtonObject(Self)) to iWidth
            End
        End
        Set Private.piWidth to iWidth
    End_Procedure
    
    { MethodType=Property Category="CodeJock"}
    Function piWidth Returns Integer
        Function_Return (Private.piWidth(Self))
    End_Function    
    
    Procedure ApplySettings
        Set piMinimum to (Private.piMin(Self))
        Set piMaximum to (Private.piMax(Self))
        Set piWidth   to (Private.piWidth(Self))
    End_Procedure
    
End_Class

{ OverrideProperty=pbCapslock_State          DesignTime=False }
{ OverrideProperty=pbPassword_State          DesignTime=False }
{ OverrideProperty=peItemType                DesignTime=False }
{DocStart = Class}
