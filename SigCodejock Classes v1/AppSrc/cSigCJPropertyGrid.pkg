//
// Package      : cSigCJPropertyGrid.pkg
//
// Mixins       : cSigCJPropertyGridItemSpinAndSlider_Mixin
//
// Description  : Property Grid Item with built in SpinForm Object
//
// Properties   : psLabel                 (String) 
//                psHelpText              (String) 
//                psToolTip               (String) 
