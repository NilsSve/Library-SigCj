{DocStart = Class}
//---------------------------------------------------
//
// Class        : cSigCJPropertyGrid
//
// Superclass   : cSigCjComPropertyGrid 
//
// Package      : cSigCJPropertyGrid.pkg
//
// Mixins       : cSigCJImage_Manager_Mixin
//
// Description  : Represents a PropertyGrid control. The property grid comes with a built in toolbar for easy sorting 
//                and grouping, and a help panel to display information on each selected item. 
//
// Properties   : peVisualTheme                 (Integer)
//                prSplitterPos                 (Real)
//                pbVariableSplitterPos         (Boolean)
//                pbHighlightChanged            (Boolean)
//                pbHelpVisible                 (Bolean)
//                piHelpHeight                  (Integer)
//                pbToolbarVisible              (Boolean)
//                pbVariableHelpHeight          (Boolean)
//                pbVariableItemsHeight         (Boolean)
//                pbShowInPlaceButtonsAlways    (Boolean)
//                peBorderStyle                 (Integer)
//
// Events       : OnMoveDataIn
//                OnMoveDataOut
//                OnItemChanged                 (Handle hoItem)
//
// Methods      : Procedure DoMoveDataIn                 
//                Procedure DoMoveDataOut
//                Procedure Apply
//                Procedure DoEnumerateAllPropertyGridItems
//                Function  AddImage            (String sImage Integer iId Integer eImageType Returns Integer)
//
// Notes        :
//
// To Do        : Currently unable to get psFormat to work for item type 'double'. Need to look at this
//                                
//---------------------------------------------------
{DocEnd} 

{ OverrideProperty=Label                     DesignTime=False }
{ OverrideProperty=Label_Col_Offset          DesignTime=False }
{ OverrideProperty=Label_Justification_Mode  DesignTime=False }
{ OverrideProperty=Label_Row_Offset          DesignTime=False }
{ OverrideProperty=peAnchors                 DesignTime=False }
{ OverrideProperty=piMinSize                 DesignTime=False }
{ OverrideProperty=TextColor                 DesignTime=False }
{ OverrideProperty=Color                     DesignTime=False }
{ OverrideProperty=Border_Style              DesignTime=False }
{ OverrideProperty=Enabled_State             DesignTime=False }
{ OverrideProperty=Visible_State             DesignTime=False }
{ OverrideProperty=Attach_Parent_State       DesignTime=False }
{ OverrideProperty=Block_Mouse_State         DesignTime=False }
{ OverrideProperty=Client_Area_State         DesignTime=False }
{ OverrideProperty=Delegation_Mode           DesignTime=False }
{ OverrideProperty=Focus_Mode                DesignTime=False }
{ OverrideProperty=pbBindValue               DesignTime=False }
{ OverrideProperty=peAutoCreate              DesignTime=False }
{ OverrideProperty=peNeighborhood            DesignTime=False }
{ OverrideProperty=Popup_State               DesignTime=False }
{ OverrideProperty=Ring_State                DesignTime=False }
{ OverrideProperty=Scope_State               DesignTime=False }
{ OverrideProperty=Search_Case               DesignTime=False }
{ OverrideProperty=Skip_State                DesignTime=False }
{ OverrideProperty=Help_Id                   DesignTime=False }
{ OverrideProperty=Help_Keyword              DesignTime=False }
{ OverrideProperty=psHtmlHelpTopic           DesignTime=False }
{ OverrideProperty=Status_Help               DesignTime=False }
{ OverrideProperty=Use_Parent_Status_Help    DesignTime=False }
{ OverrideProperty=psLicenseKey              DesignTime=False }
{ OverrideProperty=psProgID                  DesignTime=False }
{ DesignerClass=None }
Class cSigCJPropertyGrid is a cSigCjComPropertyGrid
    Import_Class_Protocol cSigCJMethods_Mixin
    
    Procedure Construct_Object
        Forward Send Construct_Object

        // Define new Properties:
        { DesignTime=False Visibility=Private }
#IF (SigCj_Codejock_Version < 220000)  
        Property Integer Private.peVisualTheme              OLExtpGridThemeResource
#ELSE
        Property Integer Private.peVisualTheme              OLExtpPropertyGridThemeResource
#ENDIF
        { DesignTime=False Visibility=Private }
        Property Real Private.prSplitterPos                 0.5
        { DesignTime=False Visibility=Private }
        Property Boolean Private.pbVariableSplitterPos      True
        { DesignTime=False Visibility=Private }
        Property Boolean Private.pbHighlightChanged         True
        { DesignTime=False Visibility=Private }
        Property Boolean Private.pbHelpVisible              True
        { DesignTime=False Visibility=Private }
        Property Integer Private.piHelpHeight               50
        { DesignTime=False Visibility=Private }
        Property Boolean Private.pbToolbarVisible           True
        { DesignTime=False Visibility=Private }
        Property Boolean Private.pbVariableHelpHeight       False
        { DesignTime=False Visibility=Private }
        Property Boolean Private.pbVariableItemsHeight      False
        { DesignTime=False Visibility=Private }
        Property Boolean Private.pbShowInPlaceButtonsAlways False
        { DesignTime=False Visibility=Private }
        Property Integer Private.peBorderStyle              ePGBs_Flat                

        //Property phoMainContainerObjectID
        //The object ID of the main container object (ie the view) that contains any DDs that this grid will use
        //Set automatically (in Item_Data_Set) if not specified, but can be set by the developer
        Property Handle  phoMainContainerObjectID           (Parent(Self))
        
        // Create child objects:
        Object oAllPropertyGridItems is a Broadcaster
        End_Object

        Set peAnchors to anAll  
    End_Procedure

    // Create and augment procedures and functions
    { Category="CodeJock" }
    { MethodType=Property }
    { EnumList="ePGThm_Default, ePGThm_NativeWinXP, ePGThm_Office2003, ePGThm_Cool, ePGThm_Simple, ePGThm_Delphi, ePGThm_Whidbey, ePGThm_OfficeXP, ePGThm_Office2007" }
    { InitialValue=ePGThm_Office2003 }
    Procedure Set peVisualTheme Integer eTheme
        Set SigCJProperty Set_Private.peVisualTheme Set_ComVisualTheme to eTheme
    End_Procedure

    { Category="CodeJock" }
    { MethodType=Property }
    Function peVisualTheme Returns Integer
        Function_Return (Private.peVisualTheme(Self))
    End_Function
    
    { Category="CodeJock" }
    { MethodType=Property }
    { InitialValue=0.5}
    Procedure Set prSplitterPos Real rSplitterPos     
        Boolean bIsCreated
        
        Get IsComObjectCreated to bIsCreated
        If (bIsCreated) Begin
            Set ComSplitterPos to rSplitterPos
        End
        Set Private.prSplitterPos to rSplitterPos
    End_Procedure

    { Category="CodeJock" }
    { MethodType=Property }    
    Function prSplitterPos Returns Real
        Function_Return (Private.prSplitterPos(Self))
    End_Function

    { Category="CodeJock" }
    { MethodType=Property }
    { PropertyType=Boolean}
    { InitialValue=True}
    Procedure Set pbVariableSplitterPos Boolean bState
        Set SigCJProperty Set_Private.pbVariableSplitterPos Set_ComVariableSplitterPos to bState           
    End_Procedure

    { Category="CodeJock" }
    { MethodType=Property }
    Function pbVariableSplitterPos Returns Boolean
        Function_Return (Private.pbVariableSplitterPos(Self))
    End_Function

    { Category="CodeJock" } 
    { MethodType=Property }
    { PropertyType=Boolean }
    { InitialValue=True }
    Procedure Set pbHighlightChanged Boolean bState
        Set SigCJProperty Set_Private.pbHighlightChanged Set_ComHighlightChangedItems to bState         
    End_Procedure

    { Category="CodeJock" }
    { MethodType=Property }
    Function pbHighlightChanged Returns Boolean
        Function_Return (Private.pbHighlightChanged(Self))
    End_Function   

    { Category="CodeJock" } 
    { MethodType=Property }
    { PropertyType=Boolean }
    { InitialValue=True }
    Procedure Set pbHelpVisible Boolean bState
        Set SigCJProperty Set_Private.pbHelpVisible Set_ComHelpVisible to bState            
    End_Procedure

    { Category="CodeJock" }
    { MethodType=Property }
    Function pbHelpVisible Returns Boolean
        Function_Return (Private.pbHelpVisible(Self))
    End_Function  

    { Category="CodeJock" }
    { MethodType=Property }
    { InitialValue=50}
    Procedure Set piHelpHeight Integer iHeight
        Set SigCJProperty Set_Private.piHelpHeight Set_ComHelpHeight to iHeight           
    End_Procedure

    { Category="CodeJock" }
    { MethodType=Property }
    Function piHelpHeight Returns Integer
        Function_Return (Private.piHelpHeight(Self))
    End_Function  

    { Category="CodeJock" } 
    { MethodType=Property }
    { PropertyType=Boolean }
    { InitialValue=True }
    Procedure Set pbToolbarVisible Boolean bState
        Set SigCJProperty Set_Private.pbToolbarVisible Set_ComToolBarVisible to bState               
    End_Procedure

    { Category="CodeJock" }
    { MethodType=Property }
    Function pbToolbarVisible Returns Boolean
        Function_Return (Private.pbToolbarVisible(Self))
    End_Function     

    { Category="CodeJock" } 
    { MethodType=Property }
    { PropertyType=Boolean }
    { InitialValue=False }
    Procedure Set pbVariableHelpHeight Boolean bState
        Set SigCJProperty Set_Private.pbVariableHelpHeight Set_ComVariableHelpHeight to bState       
    End_Procedure

    { Category="CodeJock" }
    { MethodType=Property }
    Function pbVariableHelpHeight Returns Boolean
        Function_Return (Private.pbVariableHelpHeight(Self))
    End_Function  

    { Category="CodeJock" } 
    { MethodType=Property }
    { PropertyType=Boolean }
    { InitialValue=False }
    Procedure Set pbVariableItemsHeight Boolean bState
        Set SigCJProperty Set_Private.pbVariableItemsHeight Set_ComVariableItemsHeight to bState           
    End_Procedure

    { Category="CodeJock" }
    { MethodType=Property }
    Function pbVariableItemsHeight Returns Boolean
        Function_Return (Private.pbVariableItemsHeight(Self))
    End_Function  

    { Category="CodeJock" } 
    { MethodType=Property }
    { PropertyType=Boolean }
    { InitialValue=False }
    Procedure Set pbShowInPlaceButtonsAlways Boolean bState
        Set SigCJProperty Set_Private.pbShowInPlaceButtonsAlways Set_ComShowInplaceButtonsAlways to bState          
    End_Procedure

    { Category="CodeJock" }
    { MethodType=Property }
    Function pbShowInPlaceButtonsAlways Returns Boolean
        Function_Return (Private.pbShowInPlaceButtonsAlways(Self))
    End_Function  

    { Category="CodeJock" }
    { MethodType=Property }
    { EnumList="ePGBs_None, ePGBs_Flat, ePGBs_StaticEdge, ePGBs_ClientEdge" }
    { InitialValue=ePGBs_Flat }
    Procedure Set peBorderStyle Integer eStyle
        Set SigCJProperty Set_Private.peBorderStyle Set_ComBorderStyle to eStyle
    End_Procedure

    { Category="CodeJock" }
    { MethodType=Property }
    Function peBorderStyle Returns Integer
        Function_Return (Private.peBorderStyle(Self))
    End_Function    

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : Item_Data_Set
    //
    // Scope        : Private 
    //
    // Paramaters   : iFile_Number
    //
    // Returns      : Handle
    //
    // Purpose      : Pass a file number and this function will return the object id of the DDO in the view whose main_file
    //                matches the passed value. Uses internally when binding property grid items to a database (Procedure BindToDataBase)
    //                
    // Notes        : 
    //               
    //---------------------------------------------------
    {DocEnd}     
    { MethodType=Method Visibility=Private }
    Function Item_Data_Set Integer iFile_Number Returns Handle
        Handle hoDDO hoMainContainer
        Integer iClient_ID
        
        Get phoMainContainerObjectID to hoMainContainer
        If (hoMainContainer = 0) Begin
            Get Client_Id to iClient_ID
            If (iClient_ID <> 0) Begin
                Move Self to hoMainContainer
                While ((Parent(hoMainContainer) <> iClient_ID) and (hoMainContainer <> 0))
                    Get Parent of hoMainContainer to hoMainContainer
                Loop 
                Set phoMainContainerObjectID to hoMainContainer
            End
        End
        If (hoMainContainer <> 0) Begin
            Broadcast Get Data_Set of hoMainContainer iFile_Number to hoDDO
        End
        Function_Return hoDDO
    End_Function
        
    Procedure OnCreate
        //Apply Property Grid Settings...
        Set ComIcons to (ComIcons(ghoSigCjGlobalSetting))
        
        Set peVisualTheme to (Private.peVisualTheme(Self))         
        Set prSplitterPos to (Private.prSplitterPos (Self))         
        Set pbVariableSplitterPos to (Private.pbVariableSplitterPos(Self))    
        Set pbHighlightChanged to (Private.pbHighlightChanged(Self))       
        Set pbHelpVisible to (Private.pbHelpVisible(Self))             
        Set piHelpHeight to (Private.piHelpHeight(Self))            
        Set pbToolbarVisible to (Private.pbToolbarVisible(Self))           
        Set pbVariableHelpHeight to (Private.pbVariableHelpHeight(Self))       
        Set pbVariableItemsHeight to (Private.pbVariableItemsHeight(Self))     
        Set pbShowInPlaceButtonsAlways to (Private.pbShowInPlaceButtonsAlways(Self)) 
        Set peBorderStyle to (Private.peBorderStyle(Self))  
        //Create Child Objects
        Broadcast Send Private.Create Self True
        //Upload Data
        Send DoMoveDataIn
    End_Procedure
    
    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : DoEnumerateAllPropertyGridItems
    //
    // Scope        : Public 
    //
    // Paramaters   : iMsg
    //
    // Returns      : None
    //
    // Purpose      : As objects of type cSigCJPropertyGridItem are created they are registered with a Broadcaster object
    //                DoEnumerateAllPropertyGridItems simply sends the passed message to all registered objects
    //                
    // Notes        : 
    //               
    //---------------------------------------------------
    {DocEnd} 
    
    { MethodType=Method Visibility=Public }
    Procedure DoEnumerateAllPropertyGridItems Integer iMsg
        Set broadcast_state of (oAllPropertyGridItems(Self)) to True
        Send iMsg of (oAllPropertyGridItems(Self))
        Set broadcast_state of (oAllPropertyGridItems(Self)) to False
    End_Procedure

    
    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : OnMoveDataIn
    //
    // Scope        : Event
    //
    // Paramaters   : None
    //
    // Returns      : None
    //
    // Purpose      : Called from DoMoveDataIn. Simple hook that can used for moving data into the control (ie find a record in a dd)
    //                
    // Notes        : The message OnMoveItemDataIn will also be sent to all grid items 
    //               
    //---------------------------------------------------
    {DocEnd} 
    
    {MethodType=Event}
    Procedure OnMoveDataIn
    End_Procedure

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : OnMoveDataOut
    //
    // Scope        : Event
    //
    // Paramaters   : None
    //
    // Returns      : None
    //
    // Purpose      : Called from DoMoveDataOut. Simple hook that can used for moving data out of the control
    //                
    // Notes        : The message OnMoveItemDataOut will also be sent to all grid items 
    //               
    //---------------------------------------------------
    {DocEnd} 
        
    {MethodType=Event}
    Procedure OnMoveDataOut
    End_Procedure    

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : DoMoveDataIn
    //
    // Scope        : Public Method
    //
    // Paramaters   : None
    //
    // Returns      : None
    //
    // Purpose      : Calls OnMoveDataIn of the property grid object and also OnMoveItemDataIn of all property grid item objects
    //                
    // Notes        : Can be called as a means of loading the property grid items with data 
    //               
    //---------------------------------------------------
    {DocEnd} 
        
    { MethodType=Method Visibility=Public }
    Procedure DoMoveDataIn
        Send OnMoveDataIn
        Send DoEnumerateAllPropertyGridItems Msg_ReadItemFromDatabase
        Send DoEnumerateAllPropertyGridItems msg_OnMoveItemDataIn
    End_Procedure    

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : DoMoveDataOut
    //
    // Scope        : Public Method
    //
    // Paramaters   : None
    //
    // Returns      : None
    //
    // Purpose      : Calls OnMoveDataOut of the property grid object and also OnMoveItemDataOut of all property grid item objects
    //                
    // Notes        : Can be called as a means of saving the property grid's data (from Request_save for example)
    //               
    //---------------------------------------------------
    {DocEnd} 
        
    { MethodType=Method Visibility=Public }
    Procedure DoMoveDataOut
        Send OnMoveDataOut
        Send DoEnumerateAllPropertyGridItems msg_OnMoveItemDataOut
    End_Procedure

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : Apply
    //
    // Scope        : Public Method
    //
    // Paramaters   : None
    //
    // Returns      : None
    //
    // Purpose      : Simply sends DoMoveDataOut
    //                
    // Notes        : If you have coded OnMoveDataOut and OnMoveItemDataOut to save data to the database, it can be triggered simply
    //                by calling 'Apply' of the control
    //               
    //---------------------------------------------------
    {DocEnd} 
        
    { MethodType=Method Visibility=Public }
    Procedure Apply
        Send DoMoveDataOut
    End_Procedure
    

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : OnComInplaceButtonDown
    //
    // Scope        : Private Event
    //
    // Paramaters   : llButton, llCancel
    //
    // Returns      : None
    //
    // Purpose      : Called when ever an items lookup button is clicked. 
    //                Sends OnClick to the appropriate item object
    //                
    // Notes        : Called internally. Developer does not need to concern themself with this
    //                Only objects of class cSigCJPropertyGridComboFormItem and cSigCJPropertyGridExpandbtnItem will receive OnClick
    //               
    //---------------------------------------------------
    {DocEnd} 
    
    {MethodType=Event}
    Procedure OnComInplaceButtonDown Variant llButton Variant llCancel
        Handle hoButton hoItem hoObject_ID
        Variant vGridItem
        
        Get Create U_cSigCjComPropertyGridInplaceButton to hoButton
        Set pvComObject of hoButton to llButton
        Get ComItem of hoButton to vGridItem
        Get Create U_cSigCjComPropertyGridItem to hoItem
        Set pvComObject of hoItem to vGridItem
        Get ComID of hoItem to hoObject_ID
        Send Destroy of hoItem
        Send Destroy of hoButton
        If (hoObject_ID <> 0) Begin
            Send OnClick of hoObject_ID
        End       
    End_Procedure

    {MethodType=Event}
    //Fired when ever a combo is dropped down or expand button clicked
    Procedure OnClick
    End_Procedure    

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : OnItemChanged
    //
    // Scope        : Public Event
    //
    // Paramaters   : Handle hoItem
    //
    // Returns      : None
    //
    // Purpose      : Occurs when a value of any PropertyGridItem has changed.
    //                
    // Notes        : 
    //               
    //---------------------------------------------------
    {DocEnd} 
        
    {MethodType=Event}
    Procedure OnItemChanged Handle hoItem
    End_Procedure
    
    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : OnComValueChanged
    //
    // Scope        : Private Event
    //
    // Paramaters   : llItem
    //
    // Returns      : None
    //
    // Purpose      : Occurs when the value of a PropertyGridItem has changed.
    //                Sends OnChange message to item object
    //                
    // Notes        : Called internally. Developer does not need to concern themself with this
    //               
    //---------------------------------------------------
    {DocEnd} 
        
    {MethodType=Event}
    Procedure OnComValueChanged Variant llItem
        Handle hoItem hoObject_ID
        
        Get Create U_cSigCjComPropertyGridItem to hoItem
        Set pvComObject of hoItem to llItem
        Get ComID of hoItem to hoObject_ID
        Send Destroy of hoItem
        If (hoObject_ID <> 0) Begin
            Send MoveItemDataToDatabase of hoObject_ID  
            Send OnChange of hoObject_ID
            Send OnItemChanged hoObject_ID
        End     
    End_Procedure

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : OnComAfterEdit
    //
    // Scope        : Private Event
    //
    // Paramaters   : llItem, llNewValue (byRef), llCancel (byRef)
    //
    // Returns      : None
    //
    // Purpose      : Called when an edit operation is complete
    //                Sends OnEditAfter message to item object
    //                
    // Notes        : Called internally. Developer does not need to concern themself with this
    //               
    //---------------------------------------------------
    {DocEnd}     
    
    Procedure OnComAfterEdit Variant llItem String ByRef llNewValue Boolean ByRef llCancel
        Handle hoItem hoObject_ID
        
        Get Create U_cSigCjComPropertyGridItem to hoItem
        Set pvComObject of hoItem to llItem
        Get ComID of hoItem to hoObject_ID
        Send Destroy of hoItem
        If (hoObject_ID <> 0) Begin
            Send OnEditAfter of hoObject_ID (&llNewValue) (&llCancel)
        End 
    End_Procedure
    
    
End_Class

{DocStart = Class}
//---------------------------------------------------
// Mixin Class  : cSigCJPropertyGridItem_Mixin
//---------------------------------------------------
{DocEnd} 

Class cSigCJPropertyGridItem_Mixin is a Mixin
    Import_Class_Protocol cSigCJMethods_Mixin
    
    { MethodType=Method Visibility=Private }
    Procedure Define_Standard_Item_Properties
        { DesignTime=False }
        Property String Private.psLabel     ''
        { DesignTime=False }
        Property String Private.psImage                 ''          
        { DesignTime=False }
        Property String Private.psHelpText  ''
        { DesignTime=False }
        Property String Private.psToolTip   ''        
        { DesignTime=False }
        Property Boolean Private.pbCreateExpanded       True  
        { DesignTime=False }
        Property Boolean Private.pbLabelEmboldened      False
        
        {DesignTime=False}
        Property Handle  Private.phoPropertyCaptionMetrics  (Create(Self, U_cSigCjComPropertyGridItemMetrics))
        {DesignTime=False}
        Property Handle  Private.phoPropertyValueMetrics    (Create(Self, U_cSigCjComPropertyGridItemMetrics))     
    End_Procedure
    
    {MethodType=Method Visibility=Private}
    Procedure Bind_Metrics
        Set pvComObject of (Private.phoPropertyCaptionMetrics(Self)) to (ComCaptionMetrics(Self))
        Set pvComObject of (Private.phoPropertyValueMetrics(Self)) to (ComValueMetrics(Self))    
    End_Procedure
    
    { MethodType=Property Category="CodeJock"}
    Procedure Set psLabel String sLabel
        Set SigCJProperty Set_Private.psLabel Set_ComCaption to sLabel
    End_Procedure
    
    { MethodType=Property Category="CodeJock"}
    Function psLabel Returns String
        Function_Return (Private.psLabel(Self))
    End_Function

    { MethodType=Property Category="CodeJock" }
    Procedure Set psImage String sImage
        Integer iImageID
        
        If (not(IsNullComObject(pvComObject(Self)))) Begin
            Get AddImage of ghoSigCjGlobalSetting sImage 0 0 to iImageID //Won't add it again if already uploaded once
            If (not(IsNullComObject(pvComObject(Private.phoPropertyCaptionMetrics(Self))))) Begin        
                Set ComIconIndex of (Private.phoPropertyCaptionMetrics(Self)) to iImageID    
            End
        End
        Set Private.psImage to sImage
    End_Procedure  
    
    { MethodType=Property Category="CodeJock" }
    Function psImage Returns String
        Function_Return (Private.psImage(Self))
    End_Function  
    
    { MethodType=Property Category="CodeJock"}
    Procedure Set psHelpText String sHelpText
        Set SigCJProperty Set_Private.psHelpText Set_ComDescription to sHelpText
    End_Procedure
    
    { MethodType=Property Category="CodeJock"}
    Function psHelpText Returns String
        Function_Return (Private.psHelpText(Self))
    End_Function

    { MethodType=Property Category="CodeJock"}
    Procedure Set psToolTip String sToolTip
        Set SigCJProperty Set_Private.psToolTip Set_ComToolTip to sToolTip
    End_Procedure
    
    { MethodType=Property Category="CodeJock"}
    Function psToolTip Returns String
        Function_Return (Private.psToolTip(Self))
    End_Function
    
    { MethodType=Property Category="CodeJock"}
    { PropertyType=Boolean InitialValue=True } 
    Procedure Set pbCreateExpanded Boolean bExpanded
        Boolean bExpandable

        If (not(IsNullComObject(pvComObject(Self)))) Begin        
            Get ComExpandable to bExpandable
            If (bExpandable) Begin
                Set ComExpanded to bExpanded    
            End
        End
        Set Private.pbCreateExpanded to bExpanded
    End_Procedure

    { MethodType=Property Category="CodeJock"}
    Function pbCreateExpanded Returns Boolean
        Function_Return (Private.pbCreateExpanded(Self))
    End_Function

    { MethodType=Property Category="CodeJock"}
    { PropertyType=Boolean InitialValue=True }    
    Procedure Set pbLabelEmboldened Boolean bState
        Handle hoFont
        Variant vFont
        Boolean bUnderlined
        
        If (not(IsNullComObject(pvComObject(Self)))) Begin
            If (not(IsNullComObject(pvComObject(Private.phoPropertyCaptionMetrics(Self))))) Begin
                Get Create U_cComStdFont to hoFont 
                Get ComFont of (Private.phoPropertyCaptionMetrics(Self)) to vFont  
                Set pvComObject of hoFont to vFont
                Get ComUnderline of hoFont to bUnderlined
                Set ComUnderline of hoFont to True
                Set ComBold of hoFont to bState
                Set ComUnderline of hoFont to bUnderlined
                Send Destroy of hoFont  
            End
        End  
        Set Private.pbLabelEmboldened to bState
    End_Procedure
    
    { MethodType=Property Category="CodeJock"}
    Function pbLabelEmboldened Returns Boolean
        Function_Return (Private.pbLabelEmboldened(Self))
    End_Function
        
End_Class

{DocStart = Class}
//---------------------------------------------------
//
// Class        : cSigCJPropertyGridCategory
//
// Superclass   : cSigCjComPropertyGridItem 
//
// Package      : cSigCJPropertyGrid.pkg
//
// Mixins       : cSigCJPropertyGridItem_Mixin
//
// Description  : Categories are used to group PropertyGritItems into groups within the PropertyGrid. Categories have an 
//                expand/collapse button that can be used to Show/hide the PropertyGridItems that belong the the category.
//
// Properties   : psLabel               (String)
//                psHelpText            (String)
//                psToolTip             (String)
//                pbCreateExpanded      (Boolean)
//                pbLabelEmboldened     (Boolean)
//
// Events       : 
//
// Methods      :                 
//
// Notes        :
//
// To Do        :           
//               
//---------------------------------------------------
{DocEnd} 

{ OverrideProperty=psLicenseKey    DesignTime=False }
{ OverrideProperty=psProgID        DesignTime=False }
{ OverrideProperty=Delegation_Mode DesignTime=False }
{ OverrideProperty=peAutoCreate    DesignTime=False }
{ OverrideProperty=peNeighborhood  DesignTime=False }

Class cSigCJPropertyGridCategory is a cSigCjComPropertyGridItem
    Import_Class_Protocol cSigCJMethods_Mixin
    Import_Class_Protocol cSigCJPropertyGridItem_Mixin
    
    Procedure Construct_Object
        Forward Send Construct_Object

        // Define new Properties:
        Send Define_Standard_Item_Properties
        
        // Create child objects:

        // Set property values:
        Set Private.pbLabelEmboldened to True
    End_Procedure

    // Create and augment procedures and functions
        
    { MethodType=Method Visibility=Private }
    Procedure Private.Create Handle hoParent Boolean bRecursive
        Variant vCategory
        
        //check for parent
        If (hoParent = 0) Begin
            Procedure_Return
        End
        Get ComAddCategory (Private.psLabel(Self)) to vCategory
        Set pvComObject to vCategory
        Send Bind_Metrics  
        Set pbLabelEmboldened to (Private.pbLabelEmboldened(Self))
        Set pbCreateExpanded to (Private.pbCreateExpanded(Self))
        Set psImage to (Private.psImage(Self))
        Set psHelpText to (Private.psHelpText(Self))
        If (bRecursive) Begin
            Broadcast Send Private.Create Self True
        End
    End_Procedure
        
End_Class

{DocStart = Class}
