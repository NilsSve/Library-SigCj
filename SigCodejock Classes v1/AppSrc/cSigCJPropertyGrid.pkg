    Function pbPassword_State Returns Boolean       
        Function_Return (Private.pbIsPassword(Self))
    End_Function    
    
    { MethodType=Property Category="CodeJock"}
    { PropertyType=Boolean InitialValue=False } 
    Procedure Set pbCapslock_State Boolean bState
        Set Private.pbCapslock to bState
    End_Procedure
    
    { MethodType=Property Category="CodeJock"}
    Function pbCapslock_State Returns Boolean
        Function_Return (Private.pbCapslock(Self))
    End_Function 
      
    { MethodType=Property Category="CodeJock"}
    Procedure Set piForm_Margin Integer iWidth

        If (not(IsNullComObject(pvComObject(Self)))) Begin
            If (not(IsNullComObject(pvComObject(Private.phoPropertyValueMetrics(Self))))) Begin
                Set ComMaxLength of (Private.phoPropertyValueMetrics(Self)) to iWidth
            End
        End
        Set Private.piFormMargin to iWidth
    End_Procedure
    
    { MethodType=Property Category="CodeJock"}
    Function piForm_Margin Returns Integer
