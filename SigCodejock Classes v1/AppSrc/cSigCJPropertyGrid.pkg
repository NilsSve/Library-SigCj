    End_Procedure

    // Create and augment procedures and functions
    
    { MethodType=Property Category="CodeJock"}
    Function Item_Server Returns Handle
        Function_Return (Private.phoPropertyGridItemServer(Self))
    End_Function
    
    { MethodType=Property Category="CodeJock"}
    Function Item_Data_Field Returns Integer
        Function_Return (Private.piPropertyGridItemDataField(Self))
    End_Function    

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : MoveItemDataToDatabase
    //
    // Scope        : Public 
    //
    // Paramaters   : None
    //
    // Returns      : None
    //
    // Purpose      : If item is bound to the database (file and field) it will simply set the field_changed_value of the item's
    //                server DDO with the value of the property grid item.
    //                
    // Notes        : Could be Broadcast as part of a save process.
    //                Take care however. If the item has a combo form it MAY be that you DON'T want to save the value (decription)
    //                but instead would want to save the itemdata or code value!
    //                If this is the case, the method can be augmented in the item object to "Get CodeFromDescription" of whatever 
    //                          
    //---------------------------------------------------
    {DocEnd}
        
    { MethodType = Method Visibility=Public }
    Procedure MoveItemDataToDatabase
        Handle  hoDD
        Integer iField eType iValidationType
        Variant vValue
        String  sTrue sFalse sMask
        
        Get Item_Server to hoDD
        Get Item_Data_Field to iField
        If ((hoDD <> 0) and (iField <> 0)) Begin        
            Get pvValue to vValue
            Get peItemType to eType
            If (eType = ePGItype_Boolean) Begin
                Get Field_Validation_Type of hoDD iField to iValidationType
                If (iValidationType = FA_VALIDATION_TYPE_CHECKBOX) Begin
                    Get Field_CheckBox_Value of hoDD iField True to sTrue
                    Get Field_CheckBox_Value of hoDD iField False to sFalse
                    If (vValue="True") Begin
                        Move sTrue to vValue
                    End
                    Else Begin
                        Move sFalse to vValue
                    End
                End
            End
            Set Field_changed_Value of hoDD iField to vValue
        End
    End_Procedure
    
    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : ReadItemFromDatabase
    //
    // Scope        : Public 
    //
    // Paramaters   : None
    //
    // Returns      : None
    //
    // Purpose      : If item is bound to the database (file and field) it will simply get the field_current_value of the item's
    //                server DDO and set the value of the property grid item.
    //                
    // Notes        : Could be Broadcast as part of an initialise process
    //                Take care however. If the item has a combo form it MAY be that you DON'T want to set the value with the raw 
    //                data but instead with a descriptive value. If this is the case, use Get DescriptionFromCode of the comboitem
    //                and set the value with this instead.
    //                             
    //---------------------------------------------------
    {DocEnd}
        
    { MethodType = Method Visibility=Public }
    Procedure ReadItemFromDatabase
        Handle  hoDD
        Integer iField iValidationType iType
        Variant vValue
        String  sState
        Date dDate
        
        Get Item_Server to hoDD
        Get Item_Data_Field to iField
        If ((hoDD <> 0) and (iField <> 0)) Begin
            Get field_current_value of hoDD iField to vValue
            //Is this a checkbox item that we need to translate to True/False
            Get Field_Validation_Type of hoDD iField to iValidationType
            If (iValidationType = FA_VALIDATION_TYPE_CHECKBOX) Begin
                Get Field_CheckBox_Value of hoDD iField True to sState
                If (sState=vValue) Begin
                    Move "True" to vValue
                End
                Else Begin
                    Move "False" to vValue
                End
            End
            //If data type is DATE, then if we don't use a date variable, the item always shows up as changed (?)
            Get_Attribute DF_FIELD_TYPE of (Main_File(hoDD)) iField to iType
            If (iType=DF_DATE) Begin
                Get field_current_value of hoDD iField to dDate
                Set pvInitialValue to dDate
            End
            Else Begin
                Set pvInitialValue to vValue    
            End
        End
    End_Procedure    
    
        
    { MethodType=Property Category="CodeJock"}
    { EnumList="ePGItype_String, ePGItype_Number, ePGItype_Boolean, ePGItype_Color, ePGItype_Font, ePGItype_Double, ePGItype_Date, ePGItype_Picture, ePGItype_Enum, ePGItype_EnumFlags, ePGItype_Category, ePGItype_MultiLineString" }
    { InitialValue=ePGItype_String }
    Procedure Set peItemType Integer eType
        Set Private.peItemType to eType
    End_Procedure
    
    { MethodType=Property Category="CodeJock"}
    Function peItemType Returns Integer
        Function_Return (Private.peItemType(Self))
    End_Function

    { MethodType=Property Category="CodeJock"}
    Procedure Set pvValue Variant vValue
        Set SigCJProperty Set_Private.pvValue Set_ComValue to vValue
    End_Procedure

    { MethodType=Property Category="CodeJock"}
    Function pvValue Returns String
        Variant vValue
        If (not(IsNullComObject(pvComObject(Self)))) Begin
            Get ComValue to vValue     
        End        
        Function_Return vValue
    End_Function

    { MethodType=Property Category="CodeJock"}
    Procedure Set pvDefaultValue Variant vValue
        If (pbDefaultAsInitialValue(Self)) Begin
            Procedure_Return //don't set the default
        End        
        If (not(IsNullComObject(pvComObject(Self)))) Begin
            Set ComDefaultValue to vValue     
        End
        Set Private.pvDefaultValue to vValue
    End_Procedure

    { MethodType=Property Category="CodeJock"}
    Function pvDefaultValue Returns String
        Variant vValue
        If (not(IsNullComObject(pvComObject(Self)))) Begin
            Get ComDefaultValue to vValue     
        End        
        Function_Return vValue
    End_Function

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : Set pvInitialValue
    //
    // Scope        : Public 
    //
    // Paramaters   : Variant (vVal)
    //
    // Returns      : None
    //
    // Purpose      : Can be used to set both the value AND the default value (to be the same) at the same time
    //                
    // Notes        : If setting a value from event OnMoveItemDataIn then this is a useful way of setting both the value AND the default
    //                Otherwise, because the initial value is set during Private.OnCreate, any value applied afterwards will be seen to be 
    //                different (the default will be the intial value - undefined) 
    //               
    //---------------------------------------------------
    {DocEnd} 
    
    { MethodType=Property Category="CodeJock"}
    Procedure Set pvInitialValue Variant vValue
        If (not(IsNullComObject(pvComObject(Self)))) Begin
            Set ComDefaultValue to vValue
            Set ComValue to vValue    
        End
        Set Private.pvValue to vValue
        Set Private.pvDefaultValue to vValue
    End_Procedure
    
    
    { MethodType=Property Category="CodeJock"}
    Procedure Set pvTag Variant vValue
        Set SigCJProperty Set_Private.pvTag Set_ComTag to vValue
    End_Procedure

    { MethodType=Property Category="CodeJock"}
    Function pvTag Returns String       
        Function_Return (Private.pvTag(Self))
    End_Function      

    { MethodType=Property Category="CodeJock"}
