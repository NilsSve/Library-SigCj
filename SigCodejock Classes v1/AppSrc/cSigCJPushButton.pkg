{ OverrideProperty=Size                     InitialValue=14,50 }
{ DesignerClass=cDTButton }
Class cSigCJPushButton is a cSigCjComPushButton
    Import_Class_Protocol cSigCJMethods_Mixin

    //-------------------------------------------------------------------------

    Procedure Construct_Object
        Forward Send Construct_Object

        //The default COM size is 100 100, make it same as DAW button
        Set Size to 14 50

        { DesignTime=False }
        Property Integer Private_peAppearance OLExtpAppearanceStandard

        { DesignTime=False }
        Property OLE_Color Private_piBackColor clBtnFace

        { DesignTime=False }
        Property Integer Private_piBorderGap 4

        { DesignTime=False }
        Property String  Private_psCaption ""

        { DesignTime=False }
        Property Boolean Private_pbChecked False

        { DesignTime=False }
        Property Boolean Private_pbDefault False

        { DesignTime=False }
        Property Boolean Private_pbDrawFocusRect False // True

        { DesignTime=False }
        Property Boolean Private_pbEnabled True

        { DesignTime=False }
        Property Boolean Private_pbEnableMarkup False

        { DesignTime=False }
        Property Boolean Private_pbFlatStyle False

        { DesignTime=False }
        Property OLE_Color Private_piForeColor clWindowText

        { DesignTime=False }
        Property String  Private_psImage ""

        { DesignTime=False }
        Property Integer Private_peImageAlignment OLExtpAlignCenter

        { DesignTime=False }
        Property Integer Private_piImageGap 3

        { DesignTime=False }
        Property Boolean Private_pbMultiLine True

        { DesignTime=False }
        Property Boolean Private_pbRightToLeft False

        { DesignTime=False }
        Property Integer Private_peStyle OLExtpButtonNormal

        { DesignTime=False }
        Property Integer Private_peTextAlignment OLExtpAlignCenter

        { DesignTime=False }
        Property Integer Private_peTextImageRelation OLExtpImageBeforeText

        { DesignTime=False }
        Property Boolean Private_pbUseVisualStyle True

        { DesignTime=False }
        Property Boolean Private_pbClicked False

        { DesignTime=False }
        Property Boolean Private_pbValue

        //Property Private_pihWnd                         Gets the window handle that the control is bound to.
        //Property Private_p OLEDropMode                  Returns or sets how a target component handles drop operations.
        //Property Private_p Picture                      Gets or sets a graphic to be displayed in a push button.
        //Property Private_p Transparent                  Determines if the background of a TabControlPage is visible in WinXP mode.

        { DesignTime=False }
        Property boolean Private_pbBold False

        { DesignTime=False }
        Property Boolean Private_pbItalic False

        { DesignTime=False }
        Property Boolean Private_pbStrikethrough False

        { DesignTime=False }
        Property Boolean Private_pbUnderline False

        { DesignTime=False }
        Property String Private_psFontName //"MS Sans Serif"

        { DesignTime=False }
        Property Number Private_pnFontSize //8.25

        { DesignTime=False }
        Property Handle Private_hoFont  (Create(Self, U_cComStdFont))

        { DesignTime=False }
        Property String Private_psTooltip ""

        { DesignTime=False }
        Property Boolean Private_pbInDropDown False

        { DesignTime=False }
        Property Boolean Private_pbVisible True

        { DesignTime=False }
        Property Boolean Private_pbClick_Valid True

        //---------------------------------------------------------------------

        //Hot tracking
        { Category=CodeJock }
        Property Boolean pbEnableHotTrack   True

        { Category=CodeJock PropertyType=Color InitialValue=clBlue }
        { EnumList= "cl3DDkShadow, cl3DLight, clActiveBorder, clActiveCaption, clAppWorkSpace, clBackground"    }
        { EnumList+="clBtnFace, clBtnHighlight, clBtnShadow, clBtnText, clCaptionText, clGrayText, clHighlight" }
        { EnumList+="clHighlightText, clInactiveBorder, clInactiveCaption, clInactiveCaptionText, clInfoBk"     }
        { EnumList+="clInfoText, clMenu, clMenuText, clScrollBar, clWindow, clWindowFrame, clWindowText"        }
        { EnumList+="clDefault, clNone, clAqua, clBlack, clBlue, clDkGray, clFuchsia, clGray, clGreen, clLime"  }
        { EnumList+="clLtGray, clMaroon, clNavy, clOlive, clPurple, clRed, clSilver, clTeal, clWhite, clYellow" }
        Property Integer piHotTrackColor    clBlue

        { Category=CodeJock }
        Property Boolean pbPointer_Only         False   //Prevents the button from taking the focus

        { Category=CodeJock }
        Property Handle  phoReturn_Focus        0       //Store the invoking object so focus can be returned if pointer only

        { Category=CodeJock }
        Property Handle phoToolTipController    ghoToolTipController    //Allow for different tooltip controllers

        { Category=CodeJock }
        Property Handle phoDropDownMenu //object for drop down button support

        On_Key kEnter Send KeyAction    //Allow the Enter key to perform the button action
    End_Procedure

    { MethodType=Event }
    Procedure OnCreate
        Handle hoFont
        //Ambiguous Function in expression: DAW also define PRIVATE_PIBACKCOLOR,
        //and theirs is an Integer; the system classes compile first. Same
        //workaround as cSigCJLabel.pkg / cSigCJColorPicker.pkg - a local
        //variable removes the expression syntax.
        OLE_Color iColor
        OLE_Color iForeColor

        Forward Send OnCreate

        Get Private_piBackColor to iColor
        Get Private_piForeColor to iForeColor

        Set peAppearance        to (Private_peAppearance(Self))
        Set piBackColor         to iColor   //See above (Private_piBackColor(Self))
        Set piBorderGap         to (Private_piBorderGap(Self))
        Set pbChecked           to (Private_pbChecked(Self))
        Set pbDefault           to (Private_pbDefault(Self))
        Set pbDrawFocusRect     to (Private_pbDrawFocusRect(Self))
        Set pbEnabled           to (Private_pbEnabled(Self))
        Set pbEnableMarkup      to (Private_pbEnableMarkup(Self))
        Set pbFlatStyle         to (Private_pbFlatStyle(Self))
        Set piForeColor         to iForeColor   //See above (Private_piForeColor(Self))
        Set psImage             to (Private_psImage(Self))
        Set peImageAlignment    to (Private_peImageAlignment(Self))
        Set piImageGap          to (Private_piImageGap(Self))
        Set pbMultiLine         to (Private_pbMultiLine(Self))
        Set pbRightToLeft       to (Private_pbRightToLeft(Self))
        Set peStyle             to (Private_peStyle(Self))
        Set peTextAlignment     to (Private_peTextAlignment(Self))
        Set peTextImageRelation to (Private_peTextImageRelation(Self))
        Set pbUseVisualStyle    to (Private_pbUseVisualStyle(Self))

        //Connect the OCX and dataflex FONT objects and set defaults
        Get Private_hoFont   to hoFont
        Set pvComObject      of hoFont to (ComFont(Self))
        Set ComBold          of hoFont to (Private_pbBold(Self))
        Set ComItalic        of hoFont to (Private_pbItalic(Self))
        Set ComStrikethrough of hoFont to (Private_pbStrikethrough(Self))
        Set ComUnderline     of hoFont to (Private_pbUnderline(Self))
        // We want to use the standrad windows or df font here
        // Set ComName          of hoFont to (Private_psFontName(Self))
        // Set ComSize          of hoFont to (Private_pnFontSize(Self))

        If (pbPointer_Only(Self)) Begin
            //Disable focus rectangle and set Skip_State
            Set pbDrawFocusRect to False
            Set Skip_State to True
        End

        If (Private_psTooltip(Self) <> "") Begin
        //If (phoToolTipController(Self) > 0) Begin
            //Set up tool tips
            Send DoChangeTooltipStyle
            Set ComControlToolTip to (Private_psTooltip(Self))
        End

        //This needs to be done after Multiline, so do it at the end in case
        //some of the other properties effect it as well.
        Set ComCaption to (Private_psCaption(Self))
    End_Procedure

    //-------------------------------------------------------------------------

    //Set the button's tool tip to match the Tool Tip Controller specified
    { MethodType=Method }
    Procedure DoChangeTooltipStyle
        Boolean bBaloon
        Integer iIcon iStyle iWidth
        String  sTitle
        Handle  hoToolTipContext hoToolTipController
        Variant vToolTipContext

        //---------------------------------------------------------------------
        //Define how the tool tip will look

        Get phoToolTipController to hoToolTipController
        If (hoToolTipController > 0) Begin  //grab values from specified controller
            Get piIcon         of hoToolTipController  to iIcon
            Get psTitle        of hoToolTipController  to sTitle
            Get piMaxWidth     of hoToolTipController  to iWidth
            Get pbBalloonStyle of hoToolTipController  to bBaloon
            If (bBaloon = True) Move xtpToolTipBalloon  to iStyle
            Else                Move xtpToolTipStandard to iStyle
        End
        Else Begin  //set some default values
            Move xtpToolTipIconInfo to iIcon
            Move xtpToolTipStandard to iStyle
            Move "Information"      to sTitle
        End

        //---------------------------------------------------------------------
        //Setup the tool tip

        Get Create (RefClass(cCJToolTipContext)) to hoToolTipContext
            Get ComToolTipContext to vToolTipContext
            Set pvComObject of hoToolTipContext to vToolTipContext

           Send ComShowTitleAndDescription of hoToolTipContext (If((iIcon > 0 or sTitle <> ""),True,False)) iIcon sTitle
            If (iWidth > 0) Set ComMaxTipWidth of hoToolTipContext to iWidth
            Set ComStyle of hoToolTipContext to iStyle
        Send Destroy of hoToolTipContext
    End_Procedure

    //=========================================================================
    //Augment Add_Focus to update the visible state. This has to be done after
    //the control has been painted to the screen

    Procedure Add_Focus Handle ohParent Returns Integer
        Integer iVoid iRetval
        OLE_Color iForeColor   //See OnCreate

        Forward Get Msg_Add_Focus ohParent to iRetval

        Get Private_piForeColor to iForeColor
        Move (ShowWindow(ComHWnd(Self), Private_pbVisible(Self))) to iVoid
        If (pbEnableHotTrack(Self)) Set ComForeColor to iForeColor

        Procedure_Return iRetval
    End_Procedure // Add_Focus

    //-------------------------------------------------------------------------

    //Keep track of where the focus came from - needed for Pointer Only mode

    Procedure Entering Returns Integer
        Handle hoFoc

        Get Focus to hoFoc
        Set phoReturn_Focus to hoFoc
    End_Procedure

