    { MethodType=Property Category="CodeJock" InitialValue="" }
    Procedure Set psToolTip String sTooltip
        Set SigCJProperty Set_Private_psTooltip Set_ComControlToolTip to sTooltip
    End_Procedure

    Function psTooltip Returns String
        Function_Return (SigCJProperty(Self, Get_Private_psTooltip, Get_ComControlToolTip ))
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Property Category="CodeJock" InitialValue="" }
    Procedure Set psImage String sImage
        Integer iImageId
        Variant vImage

        Set Private_psImage to sImage

        If (IsComObjectCreated(Self)) Begin
            Get AddImage    of ghoSigCjGlobalSetting sImage 0 OLExtpImageNormal to iImageId
            Get ImageFromId of ghoSigCjGlobalSetting iImageId to vImage

            Set ComIcon to vImage
        End
    End_Procedure

    Function psImage Returns String
        Function_Return (Private_psImage(Self))
    End_Function

    //=========================================================================

    //Some ActiveX controls do not honour the Visible_State message event though
    //they're in the parent class (this is one). So we need to use the low
    //level windows message ShowWindow to hide/Show the button.  We also need
    //to change the focus mode so the button can't take the focus via keyboard
    //navigation when invisible.

    { MethodType=Property Category=Codejock InitialValue=True }
    Procedure Set pbVisible Boolean bVisible
        Integer iVoid

        If (bVisible) Set Focus_Mode to Focusable
        Else          Set Focus_Mode to NonFocusable

        If (IsComObjectCreated(Self)) Move (ShowWindow(ComHWnd(Self),bVisible)) to iVoid
        Set Private_pbVisible to bVisible
    End_Procedure

    Function pbVisible Returns Boolean
        Function_Return (Private_pbVisible(Self))
    End_Function

    //Support DAW standard property name - Enabled_State
    { MethodType=Property Category="Appearance" InitialValue=True }
    Procedure Set Visible_State Integer bState
        Set pbVisible to bState
    End_Procedure

    Function Visible_State Returns Integer
        Function_Return (pbVisible(Self))
    End_Function

    //=========================================================================
    //Shadow Mixin support

    Procedure Set Item_Shadow_State Integer iItem Integer iState
        Set pbEnabled to (not(iState))
    End_Procedure

    Function Item_Shadow_State Integer iItem Returns Integer
        Function_Return (not(pbEnabled(Self)))
    End_Function

    Procedure Set Enabled_State Integer bState
        Set Object_Shadow_State to (not(bState))
    End_Procedure

    Function Enabled_State Returns Integer
        Function_Return (not(Object_Shadow_State(Self)))
    End_Function

    //=========================================================================
    //Keyboard methods / events

    //Handle Enter Key (OnKey message in Construct_Object)
    Procedure KeyAction
        If (pbVisible(Self) and pbEnabled(Self)) Send OnClick
    End_Procedure

    //Disable KeyPress as the only key the button should respond to is Enter and
    //this is handled by the OnKey message

    //Procedure OnComKeyPress Short ByRef llKeyAscii
    //    Send OnKeyPress llKeyAscii
    //End_Procedure

    //=========================================================================
    //Mouse methods / events

    //-------------------------------------------------------------------------
    //Mouse click - OnComClick is unreliable so we handle the mouse click via
    //              Mouse Down

    Procedure OnClick
        //Hook
    End_Procedure

    Procedure MouseDown Integer iButton Integer iShift Integer iX Integer iY
        //Hook
    End_Procedure

    Procedure MouseUp Integer iButton Integer iShift Integer iX Integer iY
        Handle hoFoc

        Get phoReturn_Focus to hoFoc
        If (Focus(Self) = Self and pbPointer_Only(Self) and hoFoc <> Self) Begin
            //Return focus to previous control
            Send Activate of hoFoc
        End
    End_Procedure

    Procedure OnComMouseDown Short iButton Short iShift OLE_XPOS_PIXELS iX OLE_YPOS_PIXELS iY
        Send MouseDown iButton iShift iX iY
    End_Procedure

    Procedure OnComMouseUp Short iButton Short iShift OLE_XPOS_PIXELS iX OLE_YPOS_PIXELS iY
        Send OnClick
        Send MouseUp iButton iShift iX iY
    End_Procedure

    //-------------------------------------------------------------------------
    //Mouse move - Not tracking

    Procedure MouseMove Integer iButton Integer iShift Integer iX Integer iY
        OLE_Color iForeColor   //See OnCreate

        Get Private_piForeColor to iForeColor

        If (pbEnableHotTrack(Self) and pbEnabled(Self)) Begin
            If (iX = -1 and iY = -1) Set ComForeColor to iForeColor
            Else Set ComForeColor to (piHotTrackColor(Self))
        End
    End_Procedure

    Procedure OnComMouseMove Short iButton Short iShift OLE_XPOS_PIXELS iX OLE_YPOS_PIXELS iY
        Send MouseMove iButton iShift iX iY
    End_Procedure

    //=========================================================================

    Procedure OnComDropDown
        Integer iLoc iSize

        If (not(Private_pbInDropDown(Self)) and (phoDropDownMenu(Self) <> 0)) Begin
            Set Private_pbInDropDown to True
            Get Absolute_GuiOrigin to iLoc
            Get GuiSize to iSize

            Send DropDown of (phoDropDownMenu(Self)) (((Hi(iLoc) + Hi(iSize)) * 65536) + Low(iLoc)) (Low(iSize))
            Set Private_pbInDropDown to False
        End
    End_Procedure

End_Class

//==============================================================================
//End of package - cSigCJPushButton.pkg
//==============================================================================
