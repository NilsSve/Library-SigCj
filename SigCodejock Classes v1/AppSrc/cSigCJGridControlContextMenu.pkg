// 2012-05-08 Chuck Atkinson Added right click Context Menu Grouping options

Use cSigCJContextMenu.pkg

Register_Function phoFieldChooser Returns Handle
Register_Function pbFreezeColumns Returns Boolean   
Register_Function pbEnableTotals  Returns Boolean      

Class cSigCJGridControlContextMenu_Header is a cSigCJContextMenu

    Procedure Add_Standard_MenuItems
        Send Add_MenuItem "Rebuild"             "Rebuild_Grid"   False
        Send Add_MenuItem "Refresh"             "Refresh_Grid"   False
        Send Add_MenuItem "Field Chooser"       "FieldChooser"     True 
        Send Add_MenuItem "Restore Layout"      "DefaultLayout"    False
        Send Add_MenuItem "Freeze Column"       "FreezeColumn"     True
        Send Add_MenuItem "Clear Freeze Column" "FreezeClear"      False
    End_Procedure // Add_Standard_MenuItems

    Procedure Popup
        Boolean bVisible
        Handle hoContextMenu 
        Get phoContextMenu_Header to hoContextMenu


        If (not(phoFieldChooser(Self))) Begin
            Set Visible "Field Chooser"  to False
            Set Visible "Restore Layout" to False
        End
        Set Visible "Freeze Column"       to (pbFreezeColumns(Self)) 
        Set Visible "Clear Freeze Column" to (pbFreezeColumns(Self)) 

        Send OnPopup_ContextMenu_Header hoContextMenu
        Forward Send Popup 
    End_Procedure

    Procedure Construct_Object
        Forward Send Construct_Object
        Set phoContextMenu_Header to (Self)
    End_Procedure // Construct_Object

End_Class // cSigCJGridControlContextMenu_Header

Class cSigCJGridControlContextMenu_GroupBox is a cSigCJContextMenu
    
    Procedure Add_Standard_MenuItems
        Send Add_MenuItem "Rebuild"            "Rebuild_Grid"   False
        Send Add_MenuItem "Refresh"            "Refresh_Grid"   False
        Send Add_MenuItem "Field Chooser"      "FieldChooser"     True 
        Send Add_MenuItem "Restore Layout"     "DefaultLayout"    False
    End_Procedure // Add_Standard_MenuItems

    Procedure Popup
        Handle hoContextMenu 
        Get phoContextMenu_GroupBox to hoContextMenu
        
        If (not(phoFieldChooser(Self))) Begin
            Set Visible "Field Chooser"  to False
            Set Visible "Restore Layout" to False
        End
        Send OnPopup_ContextMenu_GroupBox hoContextMenu
        Forward Send Popup 
    End_Procedure

    Procedure Construct_Object
        Forward Send Construct_Object
        Set phoContextMenu_GroupBox to (Self)
    End_Procedure // Construct_Object

End_Class // cSigCJGridControlContextMenu_GroupBox 

Class cSigCJGridControlContextMenu_Groups is a cSigCJContextMenu

    Procedure Add_Standard_MenuItems
        Send Add_MenuItem "Expand All"   "Expand_All"   False
        Send Add_MenuItem "Collapse All" "Collapse_All" False
    End_Procedure // Add_Standard_MenuItems

    Procedure Popup
        Handle hoContextMenu 
        Get phoContextMenu_Groups to hoContextMenu
        
        Send OnPopup_ContextMenu_Groups hoContextMenu
        Forward Send Popup 
    End_Procedure
    
    Procedure Expand_All Boolean bRecursive
        Send ComExpandAll True                       
    End_Procedure
    
    Procedure Collapse_All 
        Send ComCollapseAll 
    End_Procedure

    Procedure Construct_Object
        Forward Send Construct_Object
        Set phoContextMenu_Groups to (Self)
    End_Procedure // Construct_Object

End_Class // cSigCJGridControlContextMenu_GroupBox 


Class cSigCJGridControlContextMenu_GridArea is a cSigCJContextMenu
    
    Procedure Add_Standard_MenuItems
        Send Add_MenuItem "Rebuild"                "Rebuild_Grid"     True
        Send Add_MenuItem "Refresh"                "Refresh_Grid"     False
        Send Add_MenuItem "Field Chooser"          "FieldChooser"     True 
        Send Add_MenuItem "Restore Layout"         "DefaultLayout"    False
        Send Add_MenuItem "Select All"             "SelectAll"        True 
        Send Add_MenuItem "Deselect All"           "DeselectAll"      False
        Send Add_MenuItem "Invert Selection"       "Invert_Selection" False
        Send Add_MenuItem "Preview Grid"           "PreviewGrid"      True 
        Send Add_MenuItem "Print Grid"             "PrintGrid"        False
        Send Add_MenuItem "Show Footer"            "ShowFooter"       True 
        Send Add_MenuItem "Hide Footer"            "ShowFooter"       True 
        Send Add_MenuItem "Export To CSV"          "CSV_Export"       True 
        //Send Add_MenuItem "Process Selected Rows"  "Process_Rows"     True 
    End_Procedure // Add_Standard_MenuItems

    Procedure Popup
        Handle hoContextMenu 
        Get phoContextMenu_GridArea to hoContextMenu
        Boolean bMultipleSelection
    
        If (not(phoFieldChooser(Self))) Begin
            Set Visible "Field Chooser"  to False
            Set Visible "Restore Layout"   to False
        End
        
        Get pbMultipleSelection to bMultipleSelection
        Set Visible "Select All"       to bMultipleSelection
        Set Visible "Deselect All"     to bMultipleSelection
        Set Visible "Invert Selection" to bMultipleSelection
           
        If (pbEnableTotals(Self)) Begin 
            If (pbShowFooter(Self)) Begin
               Set Visible "Show Footer"  to False
               Set Visible "Hide Footer"  to True 
            End
            Else Begin 
               Set Visible "Show Footer"  to True
               Set Visible "Hide Footer"  to False 
            End 
        End 
        Else Begin
            Set Visible "Show Footer"      to False
            Set Visible "Hide Footer"      to False
        End
        
// **IS         Send OnPopup_ContextMenu_GridArea hoContextMenu
        Forward Send Popup 
    End_Procedure
    
    Procedure ShowFooter
        Boolean bShowFooter 
        Get pbShowFooter to bShowFooter
        If (bShowFooter = True) Set pbShowFooter to False
        Else Set pbShowFooter to True 
    End_Procedure
    
    Procedure Construct_Object
        Forward Send Construct_Object
        Set phoContextMenu_GridArea to (Self)
    End_Procedure // Construct_Object

End_Class // cSigCJGridControlContextMenu_GridArea
            