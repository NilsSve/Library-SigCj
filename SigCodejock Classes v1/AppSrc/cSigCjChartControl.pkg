        Send RegisterRelevantStyles (RefProcSet(Private_pbSecondaryAxisX)) (Private_psAllSeriesStyles(Self))
        Send RegisterRelevantStyles (RefProcSet(Private_pbSecondaryAxisX)) "xtpCandleStickSeriesStyle,xtpFunnelSeriesStyle,xtpHighLowSeriesStyle,xtpPieSeriesStyle;
            ,xtpPyramidSeriesStyle,xtpRadarAreaSeriesStyle,xtpRadarLineSeriesStyle,xtpRadarPointSeriesStyle,xtpRadarSplineAreaSeriesStyle,xtpRadarSplineSeriesStyle" True // remove registered styles
        {Visibility=Private}
        Property Boolean    Private_pbSecondaryAxisY     False
        Send RegisterRelevantStyles (RefProcSet(Private_pbSecondaryAxisY)) (Private_psAllSeriesStyles(Self))
        Send RegisterRelevantStyles (RefProcSet(Private_pbSecondaryAxisY)) "xtpCandleStickSeriesStyle,xtpFunnelSeriesStyle,xtpHighLowSeriesStyle,xtpPieSeriesStyle;
            ,xtpPyramidSeriesStyle,xtpRadarAreaSeriesStyle,xtpRadarLineSeriesStyle,xtpRadarPointSeriesStyle,xtpRadarSplineAreaSeriesStyle,xtpRadarSplineSeriesStyle" True // remove registered styles
            // ,xtpPie3DSeriesStyle,xtpTorus3DSeriesStyle,xtpPyramid3DSeriesStyle
        {Visibility=Private}
        Property Integer    Private_piTransparency       100
        Send RegisterRelevantStyles (RefProcSet(Private_piTransparency)) "xtpAreaSeriesStyle,xtpBubbleSeriesStyle,xtpSplineAreaSeriesStyle,xtpStackedAreaSeriesStyle;
            ,xtpStackedSplineAreaSeriesStyle,xtpStepAreaSeriesStyle,xtpRangeSplineAreaSeriesStyle,xtpRadarSplineAreaSeriesStyle,xtpRadarAreaSeriesStyle" // ,xtpPyramid3DSeriesStyle
        {Visibility=Private}
        Property Real       Private_prBarWidth           0.5
        Send RegisterRelevantStyles (RefProcSet(Private_prBarWidth)) "xtpBarSeriesStyle,xtpGanttSeriesStyle,xtpRangeBarSeriesStyle,xtpStackedBarSeriesStyle"
        {Visibility=Private}
        Property Boolean    Private_pbSideBySide         True
        Send RegisterRelevantStyles (RefProcSet(Private_pbSideBySide)) "xtpBarSeriesStyle,xtpGanttSeriesStyle,xtpRangeBarSeriesStyle"
        {Visibility=Private}
        Property Real       Private_prMaxSize
        Send RegisterRelevantStyles (RefProcSet(Private_prMaxSize)) "xtpBubbleSeriesStyle"
        {Visibility=Private}
