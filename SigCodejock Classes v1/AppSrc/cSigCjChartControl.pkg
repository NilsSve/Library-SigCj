//---------------------------------Properties----------------------------------------------       

    {Visibility=Public MethodType=Property InitialValue=xtpBarSeriesStyle Category='Series'}
    {EnumList="xtpAreaSeriesStyle,xtpBarSeriesStyle,xtpBubbleSeriesStyle,xtpCandleStickSeriesStyle,xtpFastLineSeriesStyle,xtpFunnelSeriesStyle"}
    {EnumList+="xtpGanttSeriesStyle,xtpHighLowSeriesStyle,xtpLineSeriesStyle,xtpPieSeriesStyle,xtpPointSeriesStyle,xtpPyramidSeriesStyle"}
    {EnumList+="xtpRangeBarSeriesStyle,xtpRangeSplineAreaSeriesStyle,xtpScatterLineSeriesStyle,xtpSplineAreaSeriesStyle,xtpSplineSeriesStyle"}
    {EnumList+="xtpStackedAreaSeriesStyle,xtpStackedBarSeriesStyle,xtpStackedSplineAreaSeriesStyle,xtpStepLineSeriesStyle,xtpStepAreaSeriesStyle"} // xtpPyramid3DSeriesStyle,xtpTorus3DSeriesStyle,xtpPie3DSeriesStyle
    {EnumList+="xtpRadarAreaSeriesStyle,xtpRadarLineSeriesStyle,xtpRadarPointSeriesStyle,xtpRadarSplineAreaSeriesStyle,xtpRadarSplineSeriesStyle"}
    Procedure Set peSeriesStyle Integer iStyle
        Integer iDiagram
        Boolean bChanged

        If ((piSeriesIndex(Self)<>-1) and (Private_peSeriesStyle(Self)<>iStyle)) Begin
            Move True to bChanged
        End
        Set Private_peSeriesStyle to iStyle
        Case Begin
            Case (Private_peSeriesStyle(Self)=xtpRadarAreaSeriesStyle)
            Case (Private_peSeriesStyle(Self)=xtpRadarLineSeriesStyle)
            Case (Private_peSeriesStyle(Self)=xtpRadarPointSeriesStyle)
            Case (Private_peSeriesStyle(Self)=xtpRadarSplineAreaSeriesStyle)
            Case (Private_peSeriesStyle(Self)=xtpRadarSplineSeriesStyle)
                Move xtpDiagramTypeRadar to iDiagram
                Case Break
            Case (Private_peSeriesStyle(Self)=xtpPyramidSeriesStyle)
            Case (Private_peSeriesStyle(Self)=xtpPieSeriesStyle)
            Case (Private_peSeriesStyle(Self)=xtpFunnelSeriesStyle)
                Move xtpDiagramTypePie to iDiagram
                Case Break
            Case Else
                Move xtpDiagramTypeXYChart to iDiagram
        Case End          
        If (bChanged) Begin
            If (Private_peType(Parent(Self))<>iDiagram) Begin
                Send BuildAllDiagramsAndSeries of (Parent(Self))
            End
            Else Begin
                Send CreateChartControl (Parent(Self))
            End        
//            Get ComCount of (phoChartDiagrams(Parent(Self))) to iCurrentCount
//            If (iOriginalCount<>iCurrentCount) Begin
//                Error DFERR_PROGRAM "Mismatch in diagram counts. The number of COM diagrams does not match the number of VDF diagram objects. This could be due to the selection of multiple series styles one or more of which can not share the same diagram i.e. Series objects with styles set as xtpPieSeriesStyle and xtpLineSeriesStyle may not occupy the same diagram object."
//            End
        End
        Else Begin
            Set Private_peType of (Parent(Self)) to iDiagram
        End
    End_Procedure

    Function peSeriesStyle Returns Integer
        Function_Return (Private_peSeriesStyle(Self))
    End_Function
    
