        Send RegisterRelevantStyles (RefProcSet(Private_piHolePercent)) "xtpPieSeriesStyle" // ,xtpPie3DSeriesStyle,xtpTorus3DSeriesStyle
        {Visibility=Private}
        Property Integer    Private_piRotation
        Send RegisterRelevantStyles (RefProcSet(Private_piRotation)) "xtpPieSeriesStyle" // ,xtpPie3DSeriesStyle,xtpTorus3DSeriesStyle
        {Visibility=Private}
