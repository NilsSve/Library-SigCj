    End_Function
    
    {MethodType=Property PropertyType=Property InitialValue=xtpChartGradientLeftToRight}
    {EnumList= "xtpChartGradientAngle0,xtpChartGradientAngle45,xtpChartGradientAngle90,xtpChartGradientAngle135,xtpChartGradientAngle180,xtpChartGradientAngle225,xtpChartGradientAngle270,xtpChartGradientAngle315"}
    {EnumList+="xtpChartGradientTopLeftToBottomRight, xtpChartGradientBottomRightToTopLeft, xtpChartGradientTopRightToBottomLeft"}
    Procedure Set peGradientAngle Integer iAngle
        Set FillStyleProperty (RefProcSet(Private_peGradientAngle)) (RefProcSet(ComGradientAngle)) to iAngle
    End_Procedure
    
    Function peGradientAngle Returns Integer
        Function_Return (Private_peGradientAngle(Self))
    End_Function
    
    {MethodType=Property PropertyType=Property InitialValue=xtpChartHatchStyleHorizontal}
    {EnumList= "xtpChartHatchStyleHorizontal,xtpChartHatchStyleVertical,xtpChartHatchStyleForwardDiagonal,xtpChartHatchStyleBackwardDiagonal"                            }
    {EnumList+="xtpChartHatchStyleCross,xtpChartHatchStyleDiagonalCross,xtpChartHatchStyle05Percent,xtpChartHatchStyle10Percent,xtpChartHatchStyle20Percent"             }
    {EnumList+="xtpChartHatchStyle25Percent,xtpChartHatchStyle30Percent,xtpChartHatchStyle40Percent,xtpChartHatchStyle50Percent,xtpChartHatchStyle60Percent"             } 
    {EnumList+="xtpChartHatchStyle70Percent,xtpChartHatchStyle75Percent,xtpChartHatchStyle80Percent,xtpChartHatchStyle90Percent,xtpChartHatchStyleLightDownwardDiagonal" }
    {EnumList+="xtpChartHatchStyleLightUpwardDiagonal,xtpChartHatchStyleDarkDownwardDiagonal,xtpChartHatchStyleDarkUpwardDiagonal,xtpChartHatchStyleWideDownwardDiagonal"}
    {EnumList+="xtpChartHatchStyleWideUpwardDiagonal,xtpChartHatchStyleLightVertical,xtpChartHatchStyleLightHorizontal,xtpChartHatchStyleNarrowVertical"                 }
    {EnumList+="xtpChartHatchStyleDarkVertical,xtpChartHatchStyleDarkHorizontal,xtpChartHatchStyleDashedDownwardDiagonal,xtpChartHatchStyleDashedUpwardDiagonal"         }
    {EnumList+="xtpChartHatchStyleDashedHorizontal,xtpChartHatchStyleDashedVertical,xtpChartHatchStyleSmallConfetti,xtpChartHatchStyleLargeConfetti"                     }
    {EnumList+="xtpChartHatchStyleZigZag,xtpChartHatchStyleWave,xtpChartHatchStyleDiagonalBrick,xtpChartHatchStyleHorizontalBrick,xtpChartHatchStyleWeave"               }
    {EnumList+="xtpChartHatchStylePlaid,xtpChartHatchStyleDivot,xtpChartHatchStyleDottedGrid,xtpChartHatchStyleDottedDiamond,xtpChartHatchStyleShingle"                  }
    {EnumList+="xtpChartHatchStyleTrellis,xtpChartHatchStyleSphere,xtpChartHatchStyleSmallGrid,xtpChartHatchStyleSmallCheckerBoard,xtpChartHatchStyleLargeCheckerBoard"  }
    {EnumList+="xtpChartHatchStyleOutlinedDiamond,xtpChartHatchStyleSolidDiamond"                                                                                        }    
