    End_Procedure
    
    Function peHatchStyle Returns Integer
        Function_Return (Private_peHatchStyle(Self))
    End_Function

//-------------------------------End Properties--------------------------------------------    

    {Visibility=Public MethodType=Event}
    Procedure OnAxisStripCreated
    End_Procedure

    // Replaces CreateChartControl which is broadcast by the chart on creation and by each child of the chart once they've picked it up. This is because the series;
    // needs to be created before the diagram is created but we don't want the axis objects to be created at this time as there's no axis to attach them to yet.
    {Visibility=Private}
    Procedure CreateDiagramAxisObjects Handle hoParent
        Handle hoCollection
        Variant vStrip vFont

        Get Private_phoAxisStrips of hoParent to hoCollection

        Get ComAdd of hoCollection "" to vStrip
        Set pvComObject to vStrip
        
        Send BindComObject (Private_phoChartAxisStripFillStyle(Self)) Self (RefFunc(ComFillStyle))                             
 
        // Properties
        Set prAxisMaxValue      to (Private_prAxisMaxValue(Self))
        Set prAxisMinValue      to (Private_prAxisMinValue(Self))
        Set peColor1            to (Private_peColor1(Self))
        Set peColor2            to (Private_peColor2(Self))
        Set psLegendText        to (Private_psLegendText(Self))
        Set pbLegendVisible     to (Private_pbLegendVisible(Self))
        Set psName              to (Private_psName(Self))
        Set pbVisible           to (Private_pbVisible(Self))      
        // Fillstyle
        Set peFillMode          to (Private_peFillMode(Self))
        Set peGradientAngle     to (Private_peGradientAngle(Self))
        Set peHatchStyle        to (Private_peHatchStyle(Self))
        
        // Event OnAxisStripCreated : Allows the setting of com properties which have not been defined
        Send OnAxisStripCreated           
    End_Procedure    
    
End_Class

Class cSigCJSeries is a cSigCJComChartSeries    
    
    Procedure Construct_Object
        Forward Send Construct_Object

        Import_Class_Protocol cSigCJChartMethods_Mixin

        {Visibility=Private}
        Property Integer piSeriesIndex -1
        // Struct array used to store and load data points. Populated through procedure AddPoint.
        {Visibility=Private}
        Property tdSeriesPointValues[]  ptaSeriesPointValues       
        
        // Property containing the defined series style e.g xtpChartAreaSeriesStyle
        {Visibility=Private}
        Property Integer Private_peSeriesStyle                  xtpBarSeriesStyle
        // Property containig the series style com class as a string e.g "CXTPChartAreaSeriesStyle" to be used within CreateComElement
        {Visibility=Private}
        Property String  Private_psSeriesStyleClass
        
        // Struct array containing all Com properties and a list of styles that property is relevant to. Managed using procedure RegisterRelevantStyles.
        {Visibility=Private}
        Property tdPropertiesStyleLink[]  Private_ptaPropertiesStyleLink

        {Visibility=Private}
        Property String  Private_psAllSeriesStyles "xtpAreaSeriesStyle,xtpBarSeriesStyle,xtpBubbleSeriesStyle,xtpCandleStickSeriesStyle,xtpFastLineSeriesStyle;
            ,xtpFunnelSeriesStyle,xtpGanttSeriesStyle,xtpHighLowSeriesStyle,xtpLineSeriesStyle,xtpPieSeriesStyle,xtpPointSeriesStyle,xtpPyramidSeriesStyle;
            ,xtpRangeBarSeriesStyle,xtpScatterLineSeriesStyle,xtpSplineAreaSeriesStyle,xtpSplineSeriesStyle,xtpStackedAreaSeriesStyle,xtpStackedBarSeriesStyle;
            ,xtpStackedSplineAreaSeriesStyle,xtpStepLineSeriesStyle,xtpRangeSplineAreaSeriesStyle,xtpStepAreaSeriesStyle;
            ,xtpRadarAreaSeriesStyle,xtpRadarLineSeriesStyle,xtpRadarPointSeriesStyle,xtpRadarSplineAreaSeriesStyle,xtpRadarSplineSeriesStyle"
            //,xtpPie3DSeriesStyle,xtpTorus3DSeriesStyle,xtpPyramid3DSeriesStyle

        //=====================================================================
        //Embedded Object Handles
        //=====================================================================                      
        
        {DesignTime=False}
        Property Handle phoSeriesPointLegendNumberFormat            (Create(Self,RefClass(cSigCjComChartNumberFormat)))        
        /// Bindings for each of the available series styles such as bar chart, line graph etc
        {DesignTime=False}
        Property Handle phoAreaSeriesStyle                          (Create(Self,RefClass(cSigCJComChartAreaSeriesStyle)))
        {DesignTime=False}
        Property Handle phoBarSeriesStyle                           (Create(Self,RefClass(cSigCJComChartBarSeriesStyle)))
        {DesignTime=False}
        Property Handle phoBubbleSeriesStyle                        (Create(Self,RefClass(cSigCJComChartBubbleSeriesStyle)))
        {DesignTime=False}
        Property Handle phoCandleStickSeriesStyle                   (Create(Self,RefClass(cSigCJComChartCandleStickSeriesStyle)))
        {DesignTime=False}
        Property Handle phoFastLineSeriesStyle                      (Create(Self,RefClass(cSigCJComChartFastLineSeriesStyle)))
        {DesignTime=False}
        Property Handle phoFunnelSeriesStyle                        (Create(Self,RefClass(cSigCJComChartFunnelSeriesStyle)))
        {DesignTime=False}
        Property Handle phoGanttSeriesStyle                         (Create(Self,RefClass(cSigCJComChartGanttSeriesStyle)))
        {DesignTime=False}
        Property Handle phoHighLowSeriesStyle                       (Create(Self,RefClass(cSigCJComChartHighLowSeriesStyle)))
        {DesignTime=False}
        Property Handle phoLineSeriesStyle                          (Create(Self,RefClass(cSigCJComChartLineSeriesStyle)))
//        {DesignTime=False}
//        Property Handle phoPie3DSeriesStyle                         (Create(Self,RefClass(cSigCJComChartPie3DSeriesStyle)))
        {DesignTime=False}
        Property Handle phoPieSeriesStyle                           (Create(Self,RefClass(cSigCJComChartPieSeriesStyle)))
        {DesignTime=False}
        Property Handle phoPointSeriesStyle                         (Create(Self,RefClass(cSigCJComChartPointSeriesStyle)))       
//        {DesignTime=False}
//        Property Handle phoPyramid3DSeriesStyle                     (Create(Self,RefClass(cSigCJComChartPyramid3DSeriesStyle)))
        {DesignTime=False}
        Property Handle phoPyramidSeriesStyle                       (Create(Self,RefClass(cSigCJComChartPyramidSeriesStyle)))
        {DesignTime=False}
        Property Handle phoRangeBarSeriesStyle                      (Create(Self,RefClass(cSigCJComChartRangeBarSeriesStyle)))
        {DesignTime=False}
        Property Handle phoScatterLineSeriesStyle                   (Create(Self,RefClass(cSigCJComChartScatterLineSeriesStyle)))
        {DesignTime=False}
        Property Handle phoSplineAreaSeriesStyle                    (Create(Self,RefClass(cSigCJComChartSplineAreaSeriesStyle)))
        {DesignTime=False}
        Property Handle phoSplineSeriesStyle                        (Create(Self,RefClass(cSigCJComChartSplineSeriesStyle)))
        {DesignTime=False}
        Property Handle phoStackedAreaSeriesStyle                   (Create(Self,RefClass(cSigCJComChartStackedAreaSeriesStyle)))
        {DesignTime=False}
        Property Handle phoStackedBarSeriesStyle                    (Create(Self,RefClass(cSigCJComChartStackedBarSeriesStyle)))
        {DesignTime=False}
        Property Handle phoStackedSplineAreaSeriesStyle             (Create(Self,RefClass(cSigCJComChartStackedSplineAreaSeriesStyle)))
        {DesignTime=False}
        Property Handle phoStepLineSeriesStyle                      (Create(Self,RefClass(cSigCJComChartStepLineSeriesStyle)))
//        {DesignTime=False}
//        Property Handle phoTorus3DSeriesStyle                       (Create(Self,RefClass(cSigCJComChartTorus3DSeriesStyle)))
        {DesignTime=False}
        Property Handle phoRangeSplineAreaSeriesStyle               (Create(Self,RefClass(cSigCJComChartRangeSplineAreaSeriesStyle)))
        {DesignTime=False}
        Property Handle phoStepAreaSeriesStyle                      (Create(Self,RefClass(cSigCJComChartStepAreaSeriesStyle)))
        {DesignTime=False}
        Property Handle phoRadarAreaSeriesStyle                     (Create(Self,RefClass(cSigCJComChartRadarAreaSeriesStyle)))                
        {DesignTime=False}
        Property Handle phoRadarLineSeriesStyle                     (Create(Self,RefClass(cSigCJComChartRadarLineSeriesStyle)))        
        {DesignTime=False}
        Property Handle phoRadarPointSeriesStyle                    (Create(Self,RefClass(cSigCJComChartRadarPointSeriesStyle)))        
        {DesignTime=False}
        Property Handle phoRadarSplineAreaSeriesStyle               (Create(Self,RefClass(cSigCJComChartRadarSplineAreaSeriesStyle)))
        {DesignTime=False}
        Property Handle phoRadarSplineSeriesStyle                   (Create(Self,RefClass(cSigCJComChartRadarSplineSeriesStyle)))        
        // Border
        {DesignTime=False}
        Property Handle Private_phoChartBorder                       (Create(Self,RefClass(cSigCJComChartBorder)))
        Send RegisterRelevantStyles (RefProcSet(Private_phoChartBorder)) "xtpAreaSeriesStyle,xtpBarSeriesStyle,xtpGanttSeriesStyle,xtpPieSeriesStyle,xtpRangeBarSeriesStyle;
            ,xtpStackedAreaSeriesStyle,xtpStackedBarSeriesStyle,xtpStackedSplineAreaSeriesStyle;
            ,xtpStepAreaSeriesStyle,xtpRangeSplineAreaSeriesStyle,xtpRadarAreaSeriesStyle,xtpRadarSplineAreaSeriesStyle"            
        // Marker
        {DesignTime=False}
        Property Handle Private_phoChartMarker                       (Create(Self,RefClass(cSigCJComChartMarker)))
        Send RegisterRelevantStyles (RefProcSet(Private_phoChartMarker)) "xtpAreaSeriesStyle,xtpBubbleSeriesStyle,xtpLineSeriesStyle,xtpPointSeriesStyle,xtpScatterLineSeriesStyle;
            ,xtpSplineAreaSeriesStyle,xtpSplineSeriesStyle,xtpStackedAreaSeriesStyle,xtpStackedSplineAreaSeriesStyle,xtpStepLineSeriesStyle;
            ,xtpStepAreaSeriesStyle,xtpRangeSplineAreaSeriesStyle,xtpRadarAreaSeriesStyle,xtpRadarLineSeriesStyle,xtpRadarPointSeriesStyle,xtpRadarSplineAreaSeriesStyle,xtpRadarSplineSeriesStyle"         
        {DesignTime=False}
        Property Handle Private_phoChartMarkerFillStyle              (Create(Self,RefClass(cSigCJComChartFillStyle)))
        // MaxValue MinValue Markers
        {DesignTime=False}
        Property Handle Private_phoChartMarkerMax                    (Create(Self,RefClass(cSigCJComChartMarker)))
        Send RegisterRelevantStyles (RefProcSet(Private_phoChartMarkerMax)) "xtpGanttSeriesStyle,xtpRangeBarSeriesStyle"        
        {DesignTime=False}
        Property Handle Private_phoChartMarkerMaxFillStyle           (Create(Self,RefClass(cSigCJComChartFillStyle)))
        {DesignTime=False}        
        Property Handle Private_phoChartMarkerMin                    (Create(Self,RefClass(cSigCJComChartMarker)))
        Send RegisterRelevantStyles (RefProcSet(Private_phoChartMarkerMin)) "xtpGanttSeriesStyle,xtpRangeBarSeriesStyle"        
        {DesignTime=False}
        Property Handle Private_phoChartMarkerMinFillStyle           (Create(Self,RefClass(cSigCJComChartFillStyle)))
        // FillStyle        
        {DesignTime=False}
        Property Handle Private_phoChartFillStyle                    (Create(Self,RefClass(cSigCJComChartFillStyle)))
        Send RegisterRelevantStyles (RefProcSet(Private_phoChartFillStyle)) "xtpAreaSeriesStyle,xtpBarSeriesStyle,xtpGanttSeriesStyle,xtpRangeBarSeriesStyle,xtpStackedAreaSeriesStyle;
            ,xtpStackedBarSeriesStyle,xtpStackedSplineAreaSeriesStyle,xtpStepAreaSeriesStyle,xtpRangeSplineAreaSeriesStyle,xtpRadarAreaSeriesStyle,xtpRadarSplineAreaSeriesStyle"             
        // LineStyle        
        {DesignTime=False}
        Property Handle Private_phoChartLineStyle                    (Create(Self,RefClass(cSigCJComChartLineStyle)))
        Send RegisterRelevantStyles (RefProcSet(Private_phoChartLineStyle)) "xtpFastLineSeriesStyle,xtpLineSeriesStyle,xtpScatterLineSeriesStyle,xtpSplineSeriesStyle,xtpStepLineSeriesStyle;
            ,xtpRadarLineSeriesStyle,xtpRadarSplineSeriesStyle"            
        
        // Labels
        // Bar Series Label
        {DesignTime=False}
        Property Handle Private_phoChartBarSeriesLabel               (Create(Self,RefClass(cSigCJComChartBarSeriesLabel)))
        Send RegisterRelevantStyles (RefProcSet(Private_phoChartBarSeriesLabel)) "xtpBarSeriesStyle,xtpStackedBarSeriesStyle"      
        // Funnel Series Label
        {DesignTime=False}
        Property Handle Private_phoChartFunnelSeriesLabel            (Create(Self,RefClass(cSigCJComChartFunnelSeriesLabel)))
        Send RegisterRelevantStyles (RefProcSet(Private_phoChartFunnelSeriesLabel)) "xtpFunnelSeriesStyle"                   
        // Pie Series Label
        {DesignTime=False}
        Property Handle Private_phoChartPieSeriesLabel               (Create(Self,RefClass(cSigCJComChartPieSeriesLabel)))
        Send RegisterRelevantStyles (RefProcSet(Private_phoChartPieSeriesLabel)) "xtpPieSeriesStyle" //,xtpPie3DSeriesStyle,xtpTorus3DSeriesStyle"
        // Point Series Label
        {DesignTime=False}
        Property Handle Private_phoChartPointSeriesLabel             (Create(Self,RefClass(cSigCJComChartPointSeriesLabel)))
        Send RegisterRelevantStyles (RefProcSet(Private_phoChartPointSeriesLabel)) "xtpAreaSeriesStyle,xtpLineSeriesStyle,xtpPointSeriesStyle,xtpScatterLineSeriesStyle,xtpSplineAreaSeriesStyle;
            ,xtpSplineSeriesStyle,xtpStackedAreaSeriesStyle,xtpStackedSplineAreaSeriesStyle,xtpStepLineSeriesStyle,xtpStepAreaSeriesStyle,xtpRangeSplineAreaSeriesStyle" 
        // Pyramid Series Label
        {DesignTime=False}
        Property Handle Private_phoChartPyramidSeriesLabel           (Create(Self,RefClass(cSigCJComChartPyramidSeriesLabel)))
        Send RegisterRelevantStyles (RefProcSet(Private_phoChartPyramidSeriesLabel)) "xtpPyramidSeriesStyle" //,xtpPyramid3DSeriesStyle
        // RangeBar Series Label
        {DesignTime=False}
        Property Handle Private_phoChartRangeBarSeriesLabel          (Create(Self,RefClass(cSigCJComChartRangeBarSeriesLabel)))
        Send RegisterRelevantStyles (RefProcSet(Private_phoChartRangeBarSeriesLabel)) "xtpRangeBarSeriesStyle,xtpGanttSeriesStyle"
        // RadarPoint Series Label
        {DesignTime=False}
        Property Handle Private_phoChartRadarPointSeriesLabel          (Create(Self,RefClass(cSigCJComChartRadarPointSeriesLabel)))
        Send RegisterRelevantStyles (RefProcSet(Private_phoChartRadarPointSeriesLabel)) "xtpRadarAreaSeriesStyle,xtpRadarLineSeriesStyle,xtpRadarPointSeriesStyle,xtpRadarSplineAreaSeriesStyle,xtpRadarSplineSeriesStyle"      
        // Series Label
        {DesignTime=False}
        Property Handle Private_phoChartSeriesLabel                  (Create(Self,RefClass(cSigCJComChartSeriesLabel)))
        Send RegisterRelevantStyles (RefProcSet(Private_phoChartSeriesLabel)) "xtpBubbleSeriesStyle"
        // Label Border (applies to all Labels)
        {DesignTime=False}
        Property Handle Private_phoChartSeriesLabelBorder            (Create(Self,RefClass(cSigCJComChartBorder)))
        // Label Fillstyle (applies to all Labels)
        {DesignTime=False}
        Property Handle Private_phoChartSeriesLabelFillStyle         (Create(Self,RefClass(cSigCJComChartFillStyle)))
        // Label Number Format
        {DesignTime=False}
        Property Handle Private_phoChartSeriesLabelNumberFormat      (Create(Self,RefClass(cSigCjComChartNumberFormat)))          
        // Label Font (applies to all Labels)
        {DesignTime=False}
        Property Handle Private_phoChartSeriesLabelFont              (Create(Self,RefClass(cSigCJComChartFont)))                       
        {DesignTime=False}
        Property Handle Private_phoChartSeriesFont                   (Create(Self,RefClass(cSigCJFont)))        

                
        {DesignTime=False}
