        // Point Legend Format
        {Visibility=Private}        
        Property Integer Private_pePointLegendFormatCategory            
        {Visibility=Private}
        Property String  Private_psPointLegendFormatCurrencySymbol      
        {Visibility=Private}
        Property Integer Private_pePointLegendFormatDateTimeCategory    
        {Visibility=Private}
        Property String  Private_psPointLegendFormatDateTimeFormat      
        {Visibility=Private}
        Property Integer Private_piPointLegendFormatDecimalPlaces       
        {Visibility=Private}
        Property Integer Private_piPointLegendFormatLocale              
        {Visibility=Private}
        Property String  Private_psPointLegendFormatPattern             
        {Visibility=Private}
        Property Boolean Private_pbPointLegendFormatUseThousandSeparator False                
        // Border Properties
        {Visibility=Private}
        Property Integer Private_peBorderColor                           clBtnShadow
        {Visibility=Private}
        Property Integer Private_piBorderWidth                           1.5
        {Visibility=Private}
        Property Boolean Private_pbBorderVisible                         False
        // Marker Properties
        {Visibility=Private}
        Property Boolean Private_pbMarkerBorderVisible                   True
        {Visibility=Private}
        Property Integer Private_piMarkerSize                            10
        {Visibility=Private}
        Property Integer Private_peMarkerType                            xtpChartMarkerCircle
        {Visibility=Private}
        Property Boolean Private_pbMarkerVisible                         True
        {Visibility=Private}
        Property Integer Private_peMarkerFillMode                        xtpChartFillGradient
        {Visibility=Private}
        Property Integer Private_peMarkerGradientAngle                   xtpChartGradientAngle45
        {Visibility=Private}
        Property Integer Private_peMarkerHatchStyle                      xtpChartHatchStyleHorizontal
        // MarkerMax Properties
        {Visibility=Private}
        Property Boolean Private_pbMarkerMaxBorderVisible                True
        {Visibility=Private}
        Property Integer Private_piMarkerMaxSize                         10
        {Visibility=Private}            
        Property Integer Private_peMarkerMaxType                         xtpChartMarkerCircle
        {Visibility=Private}            
        Property Boolean Private_pbMarkerMaxVisible                      False
        {Visibility=Private}            
        Property Integer Private_peMarkerMaxFillMode                     xtpChartFillGradient
        {Visibility=Private}            
        Property Integer Private_peMarkerMaxGradientAngle                xtpChartGradientAngle45
