        Send RegisterRelevantStyles (RefProcSet(Private_pbColorEach)) (Private_psAllSeriesStyles(Self))
        Send RegisterRelevantStyles (RefProcSet(Private_pbColorEach)) "xtpCandleStickSeriesStyle,xtpHighLowSeriesStyle" True // remove registered styles
        {Visibility=Private}
