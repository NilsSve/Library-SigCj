//---------End Properties---------------------------------------------------------------------------------------------------    
    
    // Returns the appropriate object handle depending on the type
    Function WrapperObject Returns Handle
        Case Begin
            Case (Private_peType(Self)=xtpDiagramTypeXYChart)
                Function_Return (Private_phoDiagram2D(Self))
                Case Break
            Case (Private_peType(Self)=xtpDiagramTypePie)
                Function_Return (Private_phoDiagramPie(Self))
                Case Break
            Case (Private_peType(Self)=xtpDiagramTypeRadar)
                Function_Return (Private_phoDiagramRadar(Self))
        Case End
    End_Function
    
    // Returns the appropriate class depending on the type
    Function WrapperClass Returns String
        Case Begin
            Case (Private_peType(Self)=xtpDiagramTypeXYChart)
                Function_Return "CXTPChartDiagram2D"
                Case Break
            Case (Private_peType(Self)=xtpDiagramTypePie)
                Function_Return "CXTPChartPieDiagram"
                Case Break
            Case (Private_peType(Self)=xtpDiagramTypeRadar)
                Function_Return "CXTPChartRadarDiagram"
        Case End
    End_Function
    
    {Visibility=Public MethodType=Event}
    Procedure OnDiagramCreated
    End_Procedure
    
    {MethodType=Method Visibility=Public}
    Procedure RefreshAllSeriesPoints
        If (IsComObjectCreated(Self)) Begin     
            Broadcast Send RefreshSeriesPoints
        End
    End_Procedure
    
    {MethodType=Method Visibility=Public}
    Procedure ReLoadAllSeriesPoints
        If (IsComObjectCreated(Self)) Begin 
            Broadcast Send ReloadSeriesPoints
        End
    End_Procedure
    
    {Visibility=Private}
    Procedure BuildDiagram
        Variant vDiagram vTitle vFont vConstantLine vGridLines vLabel vStrip vFormat
        Handle  hoDiagram
        Boolean bIsDiagram2D bIsRadar

        // determine which type of diagram has been specified
        If ((Private_peType(Self)=xtpDiagramTypeXYChart) or (Private_peType(Self)=xtpDiagramTypeRadar)) Begin
            Move True to bIsDiagram2D // for reference when determining whether to bind objects or set properties
            If (Private_peType(Self)=xtpDiagramTypeRadar) Begin
                Move True to bIsRadar
            End
        End        
        // Get the com handle of the diagram from pvDiagram which is set within CreateChartControl of the series as the series style is set
        Get Private_pvDiagram to vDiagram
        // bind it to the wrapper object
        Get WrapperObject to hoDiagram
        Set Private_phoDiagram to hoDiagram
        Set pvComObject of hoDiagram to vDiagram        
                
        // Binding of the diagram title and its sub components within the diagram title collection
        // The title objects and properties are generic to all diagram types
        Send BindComObject (Private_phoDiagramTitleCollection(Self)) hoDiagram (RefFunc(ComTitles))
        If (IsComObjectCreated(Private_phoDiagramTitleCollection(Self))) Begin
            Get ComAdd      of (Private_phoDiagramTitleCollection(Self)) ""    to vTitle
            Set pvComObject of (Private_phoDiagramTitle(Self))                 to vTitle
        End
        Send BindComObject (Private_phoDiagramTitleFont(Self)) (Private_phoDiagramTitle(Self)) (RefFunc(ComFont))
        If (IsComObjectCreated(Private_phoDiagramTitleFont(Self))) Begin
            // Bind a standard font object to the diagram font object
            Send BindComObject (Private_phoDiagramFont(Self)) (Private_phoDiagramTitleFont(Self)) (RefFunc(ComStdFont))
        End
        
        If (bIsDiagram2D=True) Begin
            // Bind objects of the diagram 2D
            Send BindComObject (Private_pho2DBackgroundFillstyle(Self)) hoDiagram (RefFunc(ComBackgroundFillStyle))              
        End
                    
        // Set properties of the diagram... some of these will be dependant upon the Diagram type (2d or pie)
        // Title    
        // The title objects and properties are generic to all diagram types    
        Set peTitleAlignment                to (Private_peDiagramTitleAlignment(Self))
//            Set pbTitleAntialising              to (Private_pbDiagramTitleAntialising(Self))
        Set peTitleDocking                  to (Private_peDiagramTitleDocking(Self))
//            Set piTitleIndent                   to (Private_piDiagramTitleIndent(Self))
        Set peTitleColor                    to (Private_peDiagramTitleColor(Self))
        Set pbTitleVisible                  to (Private_pbDiagramTitleVisible(Self))
        // Title font        
        Set pbTitleBold                     to (Private_pbDiagramTitleBold(Self))
//            Set pbTitleItalic                   to (Private_pbDiagramTitleItalic(Self))
//            Set pbTitleStrikethrough            to (Private_pbDiagramTitleStrikeThrough(Self))
        Set pbTitleUnderline                to (Private_pbDiagramTitleUnderline(Self))
        Set psTitleFontName                 to (Private_psDiagramTitleFontName(Self))
        Set pnTitleFontSize                 to (Private_pnDiagramTitleFontSize(Self))
        // psTitleText must be set after any properties that could effect it's appearance
        Set psTitleText                     to (Private_psDiagramTitleText(Self))
        
        If (bIsDiagram2D) Begin
            // set properties of the diagram 2D
            If (not(bIsRadar)) Begin              
                // 2DDiagram(XY) only
                Set pbAllowScroll                       to (Private_pb2DAllowScroll(Self))
                Set pbAllowZoom                         to (Private_pb2DAllowZoom(Self))
                Set pbRotated                           to (Private_pb2DRotated(Self))
            End
            Else Begin
                // 2DDiagram(Radar) only
                Set piStartAngle                    to (Private_piRadarStartAngle(Self))
                Set peStyle                         to (Private_peRadarStyle     (Self))             
            End
            Set peBorderColor                       to (Private_pe2DBorderColor(Self))
            Set peBackgroundColor1                  to (Private_pe2DBackgroundColor1(Self))
            Set peBackgroundColor2                  to (Private_pe2DBackgroundColor2(Self))
            // 2DDiagram Background FillStyle       
            Set peBackgroundFillMode                to (Private_pe2DBackgroundFillMode(Self))
            Set peBackgroundGradientAngle           to (Private_pe2DBackgroundGradientAngle(Self))
            Set peBackgroundHatchStyle              to (Private_pe2DBackgroundHatchStyle(Self))                     
        End
        
        // Event OnDiagramCreated : Allows the setting of com properties which have not been defined
        Send OnDiagramCreated
        
        If (bIsDiagram2D) Begin               
            Broadcast Send CreateDiagramAxis hoDiagram                     
        End
    End_Procedure
    
    {Visibility=Private}
    Procedure CreateChartControl Handle hoParent
        Variant vDiagram vTitle vFont vConstantLine vGridLines vLabel vStrip vFormat
        Handle  hoDiagram
        Boolean bIsDiagram2D bIsRadar
        
        // if the chart diagram collection object of the chart has been created
        If (IsComObjectCreated(phoChartDiagrams(hoParent))) Begin
            Broadcast Send CreateChartControl Self
            
            Send BuildDiagram
        End
    End_Procedure
End_Class

Class cSigCJAxis is a cSigCjComChartAxis
    
    Procedure Construct_Object
        Forward Send Construct_Object
        
        Import_Class_Protocol cSigCJChartMethods_Mixin
        
        {Visibility=Private}                        
        Property Integer Private_peAxis          xtpChartAxisX

        //=====================================================================
        //Embedded Object Handles
        //=====================================================================

        // constant lines collection
        {DesignTime=False}
        Property Handle Private_phoAxisConstantLines          (Create(Self,RefClass(cSigCjComChartAxisConstantLines)))
        // Grid Lines
        {DesignTime=False}
        Property Handle Private_phoAxisGridLine               (Create(Self,RefClass(cSigCjComChartAxisGridLines)))
        // Interlaced FillStyle
        {DesignTime=False}
        Property Handle Private_phoAxisInterlacedFillstyle    (Create(Self,RefClass(cSigCjComChartFillStyle)))
        // Label
        {DesignTime=False}
        Property Handle Private_phoAxisLabel                  (Create(Self,RefClass(cSigCjComChartAxisLabel)))
        // Label Number Format
        {DesignTime=False}
        Property Handle Private_phoAxisLabelNumberFormat      (Create(Self,RefClass(cSigCjComChartNumberFormat)))        
        // Label Font
        {DesignTime=False}
        Property Handle Private_phoAxisLabelChartFont         (Create(Self,RefClass(cSigCjComChartFont)))
        {DesignTime=False}
        Property Handle Private_phoAxisLabelFont              (Create(Self,RefClass(cSigCjFont)))
        // Title
        {DesignTime=False}
        Property Handle Private_phoAxisTitle                  (Create(Self,RefClass(cSigCjComChartAxisTitle)))
        // Title Font
        {DesignTime=False}
        Property Handle Private_phoAxisTitleChartFont         (Create(Self,RefClass(cSigCjComChartFont)))
        {DesignTime=False}
        Property Handle Private_phoAxisTitleFont              (Create(Self,RefClass(cSigCjFont)))        
        // Strips collection
        {DesignTime=False}
        Property Handle Private_phoAxisStrips                 (Create(Self,RefClass(cSigCjComChartAxisStrips)))
        // Range
        {DesignTime=False}
        Property Handle Private_phoAxisRange                  (Create(Self,RefClass(cSigCjComChartAxisRange)))
        // Tick Marks
        {DesignTime=False}
        Property Handle Private_phoAxisTickMarks              (Create(Self,RefClass(cSigCjComChartAxisTickMarks)))
        
        //=====================================================================
        //COM Properties
        //=====================================================================

        {Visibility=Private}
        Property Integer Private_peAxisAlignment                      xtpChartAxisNear                                           
        {Visibility=Private}
        Property Boolean Private_pbAxisAllowZoom                      False
        {Visibility=Private}
        Property Integer Private_peAxisColor                          clBlack
        {Visibility=Private}
        Property Real    Private_prAxisGridSpacing                    50
        {Visibility=Private}
        Property Boolean Private_pbAxisGridSpacingAuto                True                             
        {Visibility=Private}
        Property Boolean Private_pbAxisInterlaced                     False
        {Visibility=Private}
        Property Integer Private_peAxisInterlacedColor1               clBtnFace        
        {Visibility=Private}
        Property Integer Private_peAxisInterlacedColor2               clWhite
        {Visibility=Private}
        Property Integer Private_piAxisMinorCount                     2
        {Visibility=Private}
        Property Boolean Private_pbAxisReversed                       False
        {Visibility=Private}
        Property Integer Private_piAxisThickness                      0
        {Visibility=Private}
        Property Boolean Private_pbAxisVisible                        True
        // Axis GridLine
        {Visibility=Private}                         
        Property Boolean Private_pbAxisGridLineMinorVisible           False 
        {Visibility=Private}                         
        Property Boolean Private_pbAxisGridLineVisible                True
        // Axis Interlaced Fillstyle
        {Visibility=Private}
        Property Integer Private_peAxisInterlacedFillMode             xtpChartFillGradient
        {Visibility=Private}
        Property Integer Private_peAxisInterlacedGradientAngle        xtpChartGradientAngle45
        {Visibility=Private}
        Property Integer Private_peAxisInterlacedHatchStyle           xtpChartHatchStyleHorizontal
        // Axis Label
        {Visibility=Private}                         
        Property Integer Private_piAxisLabelAngle                     0
//        {Visibility=Private}                         
//        Property Boolean Private_pbAxisLabelAntialiasing              False
        {Visibility=Private}
        Property Integer Private_peAxisLabelTextColor                 clBlack
        {Visibility=Private}                         
        Property Boolean Private_pbAxisLabelVisible                   True
        // Axis Label Format
        {Visibility=Private}
        Property Integer Private_peAxisLabelFormatCategory            xtpChartGeneral
        {Visibility=Private}    
        Property String  Private_psAxisLabelFormatCurrencySymbol
        {Visibility=Private}   
        Property Integer Private_peAxisLabelFormatDateTimeCategory
        {Visibility=Private}
        Property String  Private_psAxisLabelFormatDateTimeFormat
        {Visibility=Private}
        Property Integer Private_piAxisLabelFormatDecimalPlaces
        {Visibility=Private}  
        Property Integer Private_piAxisLabelFormatLocale
        {Visibility=Private}
        Property String  Private_psAxisLabelFormatPattern
        {Visibility=Private}
        Property Boolean Private_pbAxisLabelFormatUseThousandSeparator                                     
        // Axis Label Font
        {Visibility=Private}
        Property Boolean Private_pbAxisLabelBold                      False
//        {Visibility=Private}
//        Property Boolean Private_pbAxisLabelItalic                    False
//        {Visibility=Private}
//        Property Boolean Private_pbAxisLabelStrikeThrough             False
        {Visibility=Private}
        Property Boolean Private_pbAxisLabelUnderline                 False
        {Visibility=Private}
        Property String Private_psAxisLabelFontName
        {Visibility=Private}
        Property Number Private_pnAxisLabelFontSize                   
        // Axis Title
        {Visibility=Private}                         
        Property Integer Private_peAxisTitleAlignment                 xtpChartAlignCenter
//        {Visibility=Private}                         
//        Property Boolean Private_pbAxisTitleAntialiasing              False
        {Visibility=Private}                         
        Property String  Private_psAxisTitleText                      "" 
        {Visibility=Private}                         
        Property Boolean Private_pbAxisTitleVisible                   True                            
        // Axis Title Font
        {Visibility=Private}
        Property Boolean Private_pbAxisTitleBold                      True
//        {Visibility=Private}
//        Property Boolean Private_pbAxisTitleItalic                    False
//        {Visibility=Private}
//        Property Boolean Private_pbAxisTitleStrikeThrough             False
        {Visibility=Private}
        Property Boolean Private_pbAxisTitleUnderline                 False
        {Visibility=Private}
        Property String Private_psAxisTitleFontName
        {Visibility=Private}
        Property Number Private_pnAxisTitleFontSize                   0
        // Axis Range
        {Visibility=Private}
