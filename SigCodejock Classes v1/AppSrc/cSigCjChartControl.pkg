Class cSigCJChartMethods_Mixin is a Mixin
//=============================================================================
//Property support    
//=============================================================================

    //-------------------------------------------------------------------------
    //Main object based properties
    
    { Visibility=Private }
    Procedure Set SigCJProperty Overloaded Handle hmPrivateProperty Handle hmCOMProperty Variant vValue
        Set hmPrivateProperty to vValue
        If (IsComObjectCreated(Self)) Begin
            Set hmCOMProperty to vValue
        End
    End_Procedure
    
    { Visibility=Private }
    Function SigCJProperty Overloaded Handle hmPrivateProperty Handle hmCOMProperty Returns Variant
        Variant vValue
        If (IsComObjectCreated(Self)) Begin
            Get hmCOMProperty to vValue
        End
        Else Begin
            Get hmPrivateProperty to vValue
        End
        Function_Return vValue
    End_Function
    
    //-------------------------------------------------------------------------
    //Sub object based properties
    
    { Visibility=Private }
    Procedure Set SigCJProperty Overloaded Handle hmPrivateProperty Handle hmCOMProperty Handle hObject Variant vValue
        Set hmPrivateProperty to vValue
        If (IsComObjectCreated(hObject)) Begin
            Set hmCOMProperty of hObject to vValue
        End
    End_Procedure
    
    { Visibility=Private }
    Function SigCJProperty Overloaded Handle hmPrivateProperty Handle hmCOMProperty Handle hObject Returns Variant
        Variant vValue
        If (IsComObjectCreated(hObject)) Begin
            Get hmCOMProperty of hObject to vValue
        End
        Else Begin
            Get hmPrivateProperty to vValue
        End
        Function_Return vValue
    End_Function
    
    
    { Visibility=Private }
    Function SeparateIntoElements String sSource String sSeparator Returns String[]
        String[] saRetVal
        Integer iPos
        
        While (sSource contains sSeparator)
            Move (Pos(sSeparator,sSource)) to iPos
            Move (Left(sSource,iPos-1)) to saRetVal[SizeOfArray(saRetVal)]
            Move (Right(sSource,(Length(sSource)-iPos))) to sSource 
        Loop
        If (sSource<>'') Begin
            Move sSource to saRetVal[SizeOfArray(saRetVal)]
        End   
        Function_Return saRetVal      
    End_Function    
       
    { Visibility=Private }
    Procedure BindComObject Handle hoDestination Handle hoSource Integer hProperty
        Variant vObj
        
        Get hProperty   of hoSource to vObj
        Set pvComObject of hoDestination to vObj
    End_Procedure
End_Class


Class cSigCJChart is a cSigCjComChartControl 
    
    Procedure Construct_Object
        Forward Send Construct_Object

        Import_Class_Protocol cSigCJChartMethods_Mixin
     
        {DesignTime=False}
        Property Integer[] Private_peaDiagramTypes 

        //=====================================================================
        //Embedded Object Handles
        //=====================================================================
        
        {DesignTime=False}
        Property Handle Private_phoChartContent                  (Create(Self,RefClass(cSigCjComChartContent)))
        {DesignTime=False}
        Property Handle Private_phoChartTitleCollection          (Create(Self,RefClass(cSigCjComChartTitleCollection)))
        // If we were to later consider using multiple titles we'll have to explore the possibility creating and destroying the title objects 
        // as we come to Get/Set the properties using the item Index of the title collection comtitleobject. As it is we can hard code a handle 
        // to the single title Object.
        {DesignTime=False}
        Property Handle Private_phoChartTitle                    (Create(Self,RefClass(cSigCjComChartTitle)))
        {DesignTime=False}
        Property Handle Private_phoChartTitleFont                (Create(Self,RefClass(cSigCjComChartFont)))                       
        {DesignTime=False}
        Property Handle Private_phoFont                          (Create(Self,RefClass(cSigCJFont))) 
        {DesignTime=False}
        Property Handle Private_phoChartLegend                   (Create(Self,RefClass(cSigCjComChartLegend)))      
        {DesignTime=False}
        Property Handle Private_phoChartLegendBorder             (Create(Self,RefClass(cSigCjComChartBorder)))
        {DesignTime=False}
        Property Handle Private_phoChartLegendFillstyle          (Create(Self,RefClass(cSigCjComChartFillStyle)))
        {DesignTime=False}
        Property Handle Private_phoChartLegendFont               (Create(Self,RefClass(cSigCjComChartFont)))                       
        {DesignTime=False}
        Property Handle Private_phoLegendFont                    (Create(Self,RefClass(cSigCJFont)))                             
        {DesignTime=False}
        Property Handle Private_phoChartBorder                   (Create(Self,RefClass(cSigCjComChartBorder)))
        {DesignTime=False}
        Property Handle Private_phoChartAppearance               (Create(Self,RefClass(cSigCjComChartAppearance)))
        // The Diagram and Series collections
        {DesignTime=False}
        Property Handle phoChartDiagrams                        (Create(Self,RefClass(cSigCjComChartDiagramCollection)))
        {DesignTime=False}
        Property Handle phoChartSeries                          (Create(Self,RefClass(cSigCjComChartSeriesCollection)))
        // Tooltip context object
        {DesignTime=False}
        Property Handle Private_phoChartTooltipContext           (Create(Self,RefClass(cSigCjComToolTipContext)))

        //=====================================================================
        //COM Properties
        //=====================================================================
        
        // chart
        {Visibility=Private}                        
        Property Integer Private_peBackGroundColor               clWindow
        {Visibility=Private}
        Property Integer Private_pePanelDirection                xtpChartPanelVertical
        {Visibility=Private}
        Property Integer Private_piPanelSpacing                  30
        {Visibility=Private}
        Property Integer Private_piToolTipStyle                  xtpToolTipOffice       
        // title
        {Visibility=Private}                        
        Property String Private_psTitleText                      ""
        {Visibility=Private}
        Property Integer Private_peTitleAlignment                xtpChartAlignCenter
//        {Visibility=Private}
//        Property Boolean Private_pbTitleAntialising              False
        {Visibility=Private}
        Property Integer Private_peTitleDocking                  xtpChartDockTop
//        {Visibility=Private}
//        Property Integer Private_piTitleIndent                   0
        {Visibility=Private}
        Property Integer Private_peTitleColor                    clBlack
        {Visibility=Private}
        Property Boolean Private_pbTitleVisible                  True
        // title font
        {Visibility=Private}
        Property Boolean Private_pbTitleBold                     True
//        {Visibility=Private}
//        Property Boolean Private_pbTitleItalic                   False
//        {Visibility=Private}
//        Property Boolean Private_pbTitleStrikeThrough            False
        {Visibility=Private}
        Property Boolean Private_pbTitleUnderline                True
        {Visibility=Private}
        Property String Private_psTitleFontName
        {Visibility=Private}
        Property Number Private_pnTitleFontSize                  0      
        // Legend
//        {Visibility=Private}
//        Property Boolean Private_pbLegendAntialising             False
        {Visibility=Private}
        Property Integer Private_peLegendBackGroundColor         clBtnFace
        {Visibility=Private}
        Property Integer Private_piLegendColumnCount             1
        {Visibility=Private}
        Property Integer Private_peLegendDirection               xtpChartLegendTopToBottom
        {Visibility=Private}
        Property Integer Private_peLegendHorizontalAlignment     xtpChartLegendRightOutside
        {Visibility=Private}
        Property Integer Private_peLegendVerticalAlignment       xtpChartLegendCenter        
        {Visibility=Private}
        Property Integer Private_piLegendMarkerHeight            16
        {Visibility=Private}
        Property Integer Private_piLegendMarkerWidth             25   
        {Visibility=Private}
        Property Boolean Private_pbLegendMarkerVisible           True
        {Visibility=Private}
        Property Integer Private_peLegendTextColor               clBlack               
        {Visibility=Private}
        Property Boolean Private_pbLegendVisible                 True
        {Visibility=Private}
        Property Integer Private_piLegendOffsetX
        {Visibility=Private}
        Property Integer Private_piLegendOffsetY                
        // Legend Border
        {Visibility=Private}
        Property Integer Private_peLegendBorderColor             clBtnShadow
        {Visibility=Private}
        Property Integer Private_piLegendBorderWidth             1.5
        {Visibility=Private}
        Property Boolean Private_pbLegendBorderVisible           True
        // Legend Fillstyle
        {Visibility=Private}
        Property Integer Private_peLegendFillMode                xtpChartFillGradient
        {Visibility=Private}
        Property Integer Private_peLegendGradientAngle           xtpChartGradientAngle45
        {Visibility=Private}
        Property Integer Private_peLegendHatchStyle              xtpChartHatchStyleHorizontal
        // Legend Font
        {Visibility=Private}
        Property Boolean Private_pbLegendBold                    True
        {Visibility=Private}
        Property Boolean Private_pbLegendUnderline               True
        {Visibility=Private}
        Property String Private_psLegendFontName
        {Visibility=Private}
        Property Number Private_pnLegendFontSize                 0 
        // Chart Border
        {Visibility=Private}
        Property Integer Private_peBorderColor                   clBtnShadow
        {Visibility=Private}
        Property Integer Private_piBorderWidth                   1.5
        {Visibility=Private}
        Property Boolean Private_pbBorderVisible                 True
        // Chart Appearance
        {Visibility=Private}
        Property String Private_psAppearance                     "Nature"
        {Visibility=Private}
        Property String Private_psPalette                        "Nature"              
    End_Procedure   
 
    // Set a property of the chart content object
    Procedure Set ChartProperty Handle hPrivateProperty Handle hComProperty Variant vValue
        Set SigCJProperty hPrivateProperty hComProperty (Private_phoChartContent(Self)) to vValue
    End_Procedure
    
    // Set a property of the ToolTip Context object
    Procedure Set ToolTipProperty Handle hPrivateProperty Handle hComProperty Variant vValue
        Set SigCJProperty hPrivateProperty hComProperty (Private_phoChartTooltipContext(Self)) to vValue
    End_Procedure
    
    // set a property of the chart legend object
    Procedure Set LegendProperty Handle hPrivateProperty Handle hComProperty Variant vValue
        Set SigCJProperty hPrivateProperty hComProperty (Private_phoChartLegend(Self)) to vValue
    End_Procedure
    
    // set a property of the chart legend border object
    Procedure Set LegendBorderProperty Handle hPrivateProperty Handle hComProperty Variant vValue
        Set SigCJProperty hPrivateProperty hComProperty (Private_phoChartLegendBorder(Self)) to vValue
    End_Procedure
    
    // set a property of the chart legend fillstyle object
    Procedure Set LegendFillStyleProperty Handle hPrivateProperty Handle hComProperty Variant vValue
        Set SigCJProperty hPrivateProperty hComProperty (Private_phoChartLegendFillStyle(Self)) to vValue
    End_Procedure

    // set a property of the chart legend font object
    Procedure Set LegendFontProperty Handle hPrivateProperty Handle hComProperty Variant vValue
        Set SigCJProperty hPrivateProperty hComProperty (Private_phoLegendFont(Self)) to vValue
    End_Procedure    
    
    // set a property of the chart border object
    Procedure Set BorderProperty Handle hPrivateProperty Handle hComProperty Variant vValue
        Set SigCJProperty hPrivateProperty hComProperty (Private_phoChartBorder(Self)) to vValue
    End_Procedure  
    
    // set a property of the chart appearance/style object
    Procedure Set AppearanceProperty Handle hPrivateProperty Handle hComProperty Variant vValue
        Set SigCJProperty hPrivateProperty hComProperty (Private_phoChartAppearance(Self)) to vValue
    End_Procedure
    
    // set a property of the singular chart title object
    Procedure Set TitleProperty Handle hPrivateProperty Handle hComProperty Variant vValue
        Set SigCJProperty hPrivateProperty hComProperty (Private_phoChartTitle(Self)) to vValue
    End_Procedure
    
    // set a property of the font object of the chart title object
    Procedure Set TitleFontProperty Handle hPrivateProperty Handle hComProperty Variant vValue
        Set SigCJProperty hPrivateProperty hComProperty (Private_phoFont(Self)) to vValue
    End_Procedure
    
