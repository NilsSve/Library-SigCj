//---------------------------------End Properties------------------------------------------
    
    {Visibility=Public MethodType=Event}
    Procedure OnAxisConstantLineCreated
    End_Procedure

    // Replaces CreateChartControl which is broadcast by the chart on creation and by each child of the chart once they've picked it up. This is because the series;
    // needs to be created before the diagram is created but we don't want the axis objects to be created at this time as there's no axis to attach them to yet.    
    {Visibility=Private}
    Procedure CreateDiagramAxisObjects Handle hoParent
        Handle hoCollection
        Variant vConstantLine vFont vLineStyle

        Get Private_phoAxisConstantLines of hoParent to hoCollection
        
        Get ComAdd of hoCollection "" to vConstantLine
        Set pvComObject to vConstantLine
        
        Get ComLineStyle to vLineStyle
        Set pvComObject of (Private_phoChartAxisConstantLineStyle(Self)) to vLineStyle                 
        Send BindComObject (Private_phoChartAxisConstantLineChartFont(Self)) Self (RefFunc(ComFont))
        If (IsComObjectCreated(Private_phoChartAxisConstantLineChartFont(Self))) Begin
            // Bind a standard font object to the diagram font object
            Send BindComObject (Private_phoChartAxisConstantLineFont(Self)) (Private_phoChartAxisConstantLineChartFont(Self)) (RefFunc(ComStdFont))
        End
        
        // Properties
        Set peAlignment       to (Private_peAlignment(Self))
        Set prAxisValue       to (Private_prAxisValue(Self))
        Set peColor           to (Private_peColor(Self))
        Set pbShowBehind      to (Private_pbShowBehind(Self))
        Set pbShowTextBelow   to (Private_pbShowTextBelow(Self))
        Set peTextColor       to (Private_peTextColor(Self))
        Set pbVisible         to (Private_pbVisible(Self))
        // Style Properties       
        Set peDashStyle       to (Private_peDashStyle(Self))
        Set piThickness       to (Private_piThickness(Self))
        // Font Properties        
        Set pbBold            to (Private_pbBold(Self))
        Set pbItalic          to (Private_pbItalic(Self))
//        Set pbStrikethrough   to (Private_pbStrikeThrough(Self))
        Set pbUnderline       to (Private_pbUnderline(Self))
        Set psFontName        to (Private_psFontName(Self))
        Set pnFontSize        to (Private_pnFontSize(Self))
        // psText must be set after any properties that could effect it's appearance
        Set psText            to (Private_psText(Self))
        // pbLegendVisible must be set after any properties that could effect it's appearance including psText
        Set psLegendText      to (Private_psLegendText(Self))
        Set pbLegendVisible   to (Private_pbLegendVisible(Self))
        
        // Event OnAxisConstantLineCreated : Allows the setting of com properties which have not been defined
        Send OnAxisConstantLineCreated        
    End_Procedure    
End_Class

Class cSigCJAxisStrip is a cSigCJComChartAxisStrip
    
    Procedure Construct_Object
        Forward Send Construct_Object

        Import_Class_Protocol cSigCJChartMethods_Mixin
                  
        //=====================================================================
        //Embedded Object Handles
