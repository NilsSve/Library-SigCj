    // Returns the object handle to the appropriate Series Style and sets Private_psSeriesStyleClass with the relevant cComClass
    Function SeriesStyleObject Returns Handle
        Handle hoSeriesStyle
        // clear down the properties incase peSeriesStyle has not been set
        Set Private_psSeriesStyleClass to ""
        Set Private_phoSeriesStyle to hoSeriesStyle
        Case Begin
            Case (peSeriesStyle(Self)=xtpAreaSeriesStyle)
                Set Private_psSeriesStyleClass to "CXTPChartAreaSeriesStyle"
                Get phoAreaSeriesStyle to hoSeriesStyle
                Case Break
            Case (peSeriesStyle(Self)=xtpBarSeriesStyle)
                Set Private_psSeriesStyleClass to "CXTPChartBarSeriesStyle"
                Get phoBarSeriesStyle to hoSeriesStyle
                Case Break
            Case (peSeriesStyle(Self)=xtpBubbleSeriesStyle)
                Set Private_psSeriesStyleClass to "CXTPChartBubbleSeriesStyle"
                Get phoBubbleSeriesStyle to hoSeriesStyle
                Case Break
            Case (peSeriesStyle(Self)=xtpCandleStickSeriesStyle)
                Set Private_psSeriesStyleClass to "CXTPChartCandleStickSeriesStyle"
                Get phoCandleStickSeriesStyle to hoSeriesStyle
                Case Break
            Case (peSeriesStyle(Self)=xtpFastLineSeriesStyle)
                Set Private_psSeriesStyleClass to "CXTPChartFastLineSeriesStyle"
                Get phoFastLineSeriesStyle to hoSeriesStyle
                Case Break
            Case (peSeriesStyle(Self)=xtpFunnelSeriesStyle)
                Set Private_psSeriesStyleClass to "CXTPChartFunnelSeriesStyle"
                Get phoFunnelSeriesStyle to hoSeriesStyle
                Case Break
            Case (peSeriesStyle(Self)=xtpGanttSeriesStyle)
                Set Private_psSeriesStyleClass to "CXTPChartGanttSeriesStyle"
                Get phoGanttSeriesStyle to hoSeriesStyle
                Case Break
            Case (peSeriesStyle(Self)=xtpHighLowSeriesStyle)
                Set Private_psSeriesStyleClass to "CXTPChartHighLowSeriesStyle"
                Get phoHighLowSeriesStyle to hoSeriesStyle
                Case Break
            Case (peSeriesStyle(Self)=xtpLineSeriesStyle)
                Set Private_psSeriesStyleClass to "CXTPChartLineSeriesStyle"
                Get phoLineSeriesStyle to hoSeriesStyle
                Case Break
//            Case (peSeriesStyle(Self)=xtpPie3DSeriesStyle)
//                Set Private_psSeriesStyleClass to "CXTPChartPie3DSeriesStyle"
//                Get phoPie3DSeriesStyle to hoSeriesStyle
//                Case Break
            Case (peSeriesStyle(Self)=xtpPieSeriesStyle)
                Set Private_psSeriesStyleClass to "CXTPChartPieSeriesStyle"
                Get phoPieSeriesStyle to hoSeriesStyle
                Case Break
            Case (peSeriesStyle(Self)=xtpPointSeriesStyle)
                Set Private_psSeriesStyleClass to "CXTPChartPointSeriesStyle"
                Get phoPointSeriesStyle to hoSeriesStyle
                Case Break
//            Case (peSeriesStyle(Self)=xtpPyramid3DSeriesStyle)
//                Set Private_psSeriesStyleClass to "CXTPChartPyramid3DSeriesStyle"
//                Get phoPyramid3DSeriesStyle to hoSeriesStyle
//                Case Break
            Case (peSeriesStyle(Self)=xtpPyramidSeriesStyle)
                Set Private_psSeriesStyleClass to "CXTPChartPyramidSeriesStyle"
                Get phoPyramidSeriesStyle to hoSeriesStyle
                Case Break
            Case (peSeriesStyle(Self)=xtpRangeBarSeriesStyle)
                Set Private_psSeriesStyleClass to "CXTPChartRangeBarSeriesStyle"
                Get phoRangeBarSeriesStyle to hoSeriesStyle
                Case Break
            Case (peSeriesStyle(Self)=xtpScatterLineSeriesStyle)
                Set Private_psSeriesStyleClass to "CXTPChartScatterLineSeriesStyle"
                Get phoScatterLineSeriesStyle to hoSeriesStyle
                Case Break
            Case (peSeriesStyle(Self)=xtpSplineAreaSeriesStyle)
                Set Private_psSeriesStyleClass to "CXTPChartSplineAreaSeriesStyle"
                Get phoSplineAreaSeriesStyle to hoSeriesStyle
                Case Break
            Case (peSeriesStyle(Self)=xtpSplineSeriesStyle)
                Set Private_psSeriesStyleClass to "CXTPChartSplineSeriesStyle"
                Get phoSplineSeriesStyle to hoSeriesStyle
                Case Break
            Case (peSeriesStyle(Self)=xtpStackedAreaSeriesStyle)
                Set Private_psSeriesStyleClass to "CXTPChartStackedAreaSeriesStyle"
                Get phoStackedAreaSeriesStyle to hoSeriesStyle
                Case Break
            Case (peSeriesStyle(Self)=xtpStackedBarSeriesStyle)
                Set Private_psSeriesStyleClass to "CXTPChartStackedBarSeriesStyle"
                Get phoStackedBarSeriesStyle to hoSeriesStyle
                Case Break
            Case (peSeriesStyle(Self)=xtpStackedSplineAreaSeriesStyle)
                Set Private_psSeriesStyleClass to "CXTPChartStackedSplineAreaSeriesStyle"
                Get phoStackedSplineAreaSeriesStyle to hoSeriesStyle
                Case Break
            Case (peSeriesStyle(Self)=xtpStepLineSeriesStyle)
                Set Private_psSeriesStyleClass to "CXTPChartStepLineSeriesStyle"
                Get phoStepLineSeriesStyle to hoSeriesStyle
                Case Break                                                                                                
//            Case (peSeriesStyle(Self)=xtpTorus3DSeriesStyle)
//                Set Private_psSeriesStyleClass to "CXTPChartTorus3DSeriesStyle"
//                Get phoTorus3DSeriesStyle to hoSeriesStyle
            Case (peSeriesStyle(Self)=xtpRangeSplineAreaSeriesStyle)
                Set Private_psSeriesStyleClass to "CXTPChartRangeSplineAreaSeriesStyle"
                Get phoRangeSplineAreaSeriesStyle to hoSeriesStyle
                Case Break
            Case (peSeriesStyle(Self)=xtpStepAreaSeriesStyle)
                Set Private_psSeriesStyleClass to "CXTPChartStepAreaSeriesStyle"
                Get phoStepAreaSeriesStyle to hoSeriesStyle
                Case Break
            Case (peSeriesStyle(Self)=xtpRadarAreaSeriesStyle)
                Set Private_psSeriesStyleClass to "CXTPChartRadarAreaSeriesStyle"
                Get phoRadarAreaSeriesStyle to hoSeriesStyle
                Case Break
            Case (peSeriesStyle(Self)=xtpRadarLineSeriesStyle)
                Set Private_psSeriesStyleClass to "CXTPChartRadarLineSeriesStyle"
                Get phoRadarLineSeriesStyle to hoSeriesStyle
                Case Break
            Case (peSeriesStyle(Self)=xtpRadarPointSeriesStyle)
                Set Private_psSeriesStyleClass to "CXTPChartRadarPointSeriesStyle"
                Get phoRadarPointSeriesStyle to hoSeriesStyle
                Case Break
            Case (peSeriesStyle(Self)=xtpRadarSplineAreaSeriesStyle)
                Set Private_psSeriesStyleClass to "CXTPChartRadarSplineAreaSeriesStyle"
                Get phoRadarSplineAreaSeriesStyle to hoSeriesStyle
                Case Break
            Case (peSeriesStyle(Self)=xtpRadarSplineSeriesStyle)
                Set Private_psSeriesStyleClass to "CXTPChartRadarSplineSeriesStyle"
                Get phoRadarSplineSeriesStyle to hoSeriesStyle
                Case Break             
        Case End
        Set Private_phoSeriesStyle to hoSeriesStyle
        Function_Return hoSeriesStyle
    End_Function

    {Visibility=Private}
    Procedure DoLoadDataSource
        tdSeriesPointValues[] taVoidSeriesPointValues
        
        Set ptaSeriesPointValues to taVoidSeriesPointValues        
        Send OnAddChartData
        Send LoadData
        Send OnEndLoadData
    End_Procedure
    
    {Visibility=Private}
    Procedure LoadData
        Handle hoPoint                   
        Variant vPoint
        Integer iPoints iIndex iLength iLoop eOrdering iYAxisValues
        tdSeriesPointValues[] taSeriesPointValues
        Boolean bIsNumeric bStop
        
        If (not(IsComObjectCreated(Self))) Begin
            Procedure_Return
        End
        
        Get ptaSeriesPointValues to taSeriesPointValues
        Move (SizeOfArray(taSeriesPointValues)) to iPoints
                    
        If (iPoints) Begin
            Get Create (RefClass(cSigCjComChartSeriesPoint)) to hoPoint
            Case Begin
                Case (peSeriesStyle(Self)=xtpCandleStickSeriesStyle)
                Case (peSeriesStyle(Self)=xtpHighLowSeriesStyle)
                Case (peSeriesStyle(Self)=xtpBubbleSeriesStyle)
                Case (peSeriesStyle(Self)=xtpGanttSeriesStyle)
                Case (peSeriesStyle(Self)=xtpRangeBarSeriesStyle)
                Case (peSeriesStyle(Self)=xtpRangeSplineAreaSeriesStyle)
                    Case Begin
                        Case (peSeriesStyle(Self)=xtpCandleStickSeriesStyle)
                        Case (peSeriesStyle(Self)=xtpHighLowSeriesStyle)
                            Move 4 to iYAxisValues
                            Case Break
                        Case Else
                            Move 2 to iYAxisValues
                    Case End
                    Case Break
            Case End
            // Batch Add Points
            If (iYAxisValues=0) Begin
                Send ComAddPoints of (phoSeriesPointCollection(Self)) iPoints
            End
            For iIndex from 0 to (iPoints-1)
                If (iYAxisValues=0) Begin
                    Get ComItem of (phoSeriesPointCollection(Self)) iIndex to vPoint
                End
                Else If (iYAxisValues=2) Begin
                    Get ComAdd2 of (phoSeriesPointCollection(Self)) taSeriesPointValues[iIndex].sXAxisValue taSeriesPointValues[iIndex].sYAxisValue1 taSeriesPointValues[iIndex].sYAxisValue2 to vPoint
                End
                Else If (iYAxisValues=4) Begin
                    Get ComAdd4 of (phoSeriesPointCollection(Self)) taSeriesPointValues[iIndex].sXAxisValue taSeriesPointValues[iIndex].sYAxisValue1 taSeriesPointValues[iIndex].sYAxisValue2 taSeriesPointValues[iIndex].sYAxisValue3 taSeriesPointValues[iIndex].sYAxisValue4 to vPoint
                End
                Set pvComObject of hoPoint to vPoint
                If (iYAxisValues=0) Begin
                    Send SetPointValues hoPoint taSeriesPointValues[iIndex].sXAxisValue taSeriesPointValues[iIndex].sYAxisValue1 taSeriesPointValues[iIndex].sYAxisValue2 taSeriesPointValues[iIndex].sYAxisValue3 taSeriesPointValues[iIndex].sYAxisValue4
                End
                Set ComTooltipText of hoPoint to taSeriesPointValues[iIndex].sToolTipText
                Send OnChartPointCreated hoPoint iIndex
            Loop
            Send Destroy of hoPoint
        End
    End_Procedure
    
    {Visibility=Private MethodType=Method}
    Procedure SetPointValues Handle hoPoint String sXAxisVal String sYAxisVal1 String sYAxisVal2 String sYAxisVal3 String sYAxisVal4
        Integer eOrdering
        
        If (IsComObjectCreated(hoPoint)) Begin
            // get the ordering of the xAxis, if the ordering is set to numerical we must save the data using a different com property
            Get peSeriesArgumentScaleType to eOrdering
            If (eOrdering=xtpChartScaleNumerical) Begin
                Set ComArgumentValue of hoPoint to sXAxisVal
            End
            Else Begin
                Set ComArgumentValueString of hoPoint to sXAxisVal
            End
            // set the Y axis values
            Set ComValue of hoPoint 0 to sYAxisVal1
            Case Begin
                Case (peSeriesStyle(Self)=xtpCandleStickSeriesStyle)
                Case (peSeriesStyle(Self)=xtpHighLowSeriesStyle)
                Case (peSeriesStyle(Self)=xtpBubbleSeriesStyle)
                Case (peSeriesStyle(Self)=xtpGanttSeriesStyle)
                Case (peSeriesStyle(Self)=xtpRangeBarSeriesStyle)
                Case (peSeriesStyle(Self)=xtpRangeSplineAreaSeriesStyle)
                    Set ComValue of hoPoint 1 to sYAxisVal2
                    Case Begin
                        Case (peSeriesStyle(Self)=xtpCandleStickSeriesStyle)
                        Case (peSeriesStyle(Self)=xtpHighLowSeriesStyle)
                            Set ComValue of hoPoint 2 to sYAxisVal3
                            Set ComValue of hoPoint 3 to sYAxisVal4
                    Case End
            Case End 
        End
    End_Procedure
       
    {Visibility=Public MethodType=Method}
    Procedure AddPoint String sToolTipText String sXAxisVal String sYAxisVal1 String sYAxisVal2 String sYAxisVal3 String sYAxisVal4
        Integer iArgs iPoints
        tdSeriesPointValues[] taSeriesPointValues
                
        Move num_arguments to iArgs
        Get ptaSeriesPointValues to taSeriesPointValues
        Move (SizeOfArray(taSeriesPointValues)) to iPoints
        Move sXAxisVal to taSeriesPointValues[iPoints].sXAxisValue
        Move sYAxisVal1 to taSeriesPointValues[iPoints].sYAxisValue1
        If (iArgs>3) Begin
            Move sYAxisVal2 to taSeriesPointValues[iPoints].sYAxisValue2
            If (iArgs>4) Begin
                Move sYAxisVal3 to taSeriesPointValues[iPoints].sYAxisValue3
                Move sYAxisVal4 to taSeriesPointValues[iPoints].sYAxisValue4
            End
        End
        Move sToolTipText to taSeriesPointValues[iPoints].sToolTipText
        Set ptaSeriesPointValues to taSeriesPointValues
    End_Procedure
    
    {Visibility=Public MethodType=Method}
    Procedure AddPoints tdSeriesPointValues[] taPointValues
        Set ptaSeriesPointValues to taPointValues
    End_Procedure
    
    {Visibility=Public MethodType=Method}
    Procedure DeletePoints
        tdSeriesPointValues[] taVoid
        
        Set ptaSeriesPointValues to taVoid
    End_Procedure
    
    {Visibility=Public MethodType=Method}
    Procedure DeletePointAt Integer iIndex
        tdSeriesPointValues[] taPointValues
        Get ptaSeriesPointValues to taPointValues
        Move (RemoveFromArray(taPointValues,iIndex)) to taPointValues
        Set ptaSeriesPointValues to taPointValues
    End_Procedure    

    {Visibility=Public MethodType=Method}
    Procedure ChangePointAt Integer iIndex String sToolTipText String sXAxisVal String sYAxisVal1 String sYAxisVal2 String sYAxisVal3 String sYAxisVal4
        Integer iArgs iPoints
        Variant vPoint
        Handle hoPoint
        tdSeriesPointValues[] taSeriesPointValues

        Move num_arguments to iArgs
        
        Get ptaSeriesPointValues to taSeriesPointValues        
        Move sXAxisVal to taSeriesPointValues[iIndex].sXAxisValue
        Move sYAxisVal1 to taSeriesPointValues[iIndex].sYAxisValue1
        If (iArgs>4) Begin
            Move sYAxisVal2 to taSeriesPointValues[iIndex].sYAxisValue2
            If (iArgs>5) Begin
                Move sYAxisVal3 to taSeriesPointValues[iIndex].sYAxisValue3
                Move sYAxisVal4 to taSeriesPointValues[iIndex].sYAxisValue4
            End          
        End
        Move sToolTipText to taSeriesPointValues[iIndex].sToolTipText
        Set ptaSeriesPointValues to taSeriesPointValues
    End_Procedure
    
    {Visibility=Public MethodType=Method}
    Procedure InsertPointAt Integer iIndex String sToolTipText String sXAxisVal String sYAxisVal1 String sYAxisVal2 String sYAxisVal3 String sYAxisVal4
        Integer iArgs iPoints
        Variant vPoint
        Handle hoPoint
        tdSeriesPointValues tPointValues
        tdSeriesPointValues[] taSeriesPointValues

        Move num_arguments to iArgs
        
        Get ptaSeriesPointValues to taSeriesPointValues        
        Move sXAxisVal to tPointValues.sXAxisValue
        Move sYAxisVal1 to tPointValues.sYAxisValue1
        If (iArgs>4) Begin
            Move sYAxisVal2 to tPointValues.sYAxisValue2
            If (iArgs>5) Begin
                Move sYAxisVal3 to tPointValues.sYAxisValue3
                Move sYAxisVal4 to tPointValues.sYAxisValue4
            End          
        End
        Move sToolTipText to tPointValues.sToolTipText
        Move (InsertInArray(taSeriesPointValues,iIndex,tPointValues)) to taSeriesPointValues
        Set ptaSeriesPointValues to taSeriesPointValues
    End_Procedure    
    
    {Visibility=Public MethodType=Event}
    Procedure OnChartPointCreated Handle hoPointObject Integer iIndex
    End_Procedure    
    
    {Visibility=Public MethodType=Event}
    Procedure OnAddChartData               
    End_Procedure    
    
    {Visibility=Public MethodType=Event}
    Procedure OnEndLoadData
    End_Procedure
    
    {Visibility=Public MethodType=Event}
    Procedure OnSeriesCreated
    End_Procedure
    
    {MethodType=Method Visibility=Private}
    Procedure DestroySeriesPoints
        Send ComDeleteAll of (phoSeriesPointCollection(Self))     
    End_Procedure
    
    {MethodType=Method Visibility=Public}
    Procedure RefreshSeriesPoints
        If (IsComObjectCreated(Self)) Begin
            Send DestroySeriesPoints
            Send LoadData
        End
    End_Procedure    
    
    {MethodType=Method Visibility=Public}
    Procedure ReloadSeriesPoints
        tdSeriesPointValues[] taVoidSeriesPointValues
        
        If (IsComObjectCreated(Self)) Begin 
            Set ptaSeriesPointValues to taVoidSeriesPointValues      
            Send DestroySeriesPoints
            Send DoLoadDataSource
        End
    End_Procedure    
    
    // Returns the object handle of the relevant series label depending upon the series style
    {Visibility=Private}
    Function SeriesLabelIsRelevant Returns Handle
        Case Begin
            Case (DoesPropertyApplyToSeriesStyle(Self,RefProcSet(Private_phoChartSeriesLabel)))
                Function_Return (Private_phoChartSeriesLabel(Self))
            Case (DoesPropertyApplyToSeriesStyle(Self,RefProcSet(Private_phoChartRangeBarSeriesLabel)))
                Function_Return (Private_phoChartRangeBarSeriesLabel(Self))
            Case (DoesPropertyApplyToSeriesStyle(Self,RefProcSet(Private_phoChartPyramidSeriesLabel)))
                Function_Return (Private_phoChartPyramidSeriesLabel(Self))
            Case (DoesPropertyApplyToSeriesStyle(Self,RefProcSet(Private_phoChartPointSeriesLabel)))
                Function_Return (Private_phoChartPointSeriesLabel(Self))
            Case (DoesPropertyApplyToSeriesStyle(Self,RefProcSet(Private_phoChartPieSeriesLabel)))
                Function_Return (Private_phoChartPieSeriesLabel(Self))
            Case (DoesPropertyApplyToSeriesStyle(Self,RefProcSet(Private_phoChartFunnelSeriesLabel)))
                Function_Return (Private_phoChartFunnelSeriesLabel(Self))
            Case (DoesPropertyApplyToSeriesStyle(Self,RefProcSet(Private_phoChartBarSeriesLabel)))
                Function_Return (Private_phoChartBarSeriesLabel(Self))
            Case (DoesPropertyApplyToSeriesStyle(Self,RefProcSet(Private_phoChartRadarPointSeriesLabel)))
                Function_Return (Private_phoChartRadarPointSeriesLabel(Self))                                                                                               
        Case End     
    End_Function

    {Visibility=Private}
    Procedure CreateChartControl Handle hoParent
        Handle hoStyle hoLabel
        Variant vSeries vDiagram vStyle vFont vLabel
        Variant vMarker vLineStyle vFillStyle vFormat vBorder
        Boolean bApplies
        Integer iCount iIndex iSeriesIndex //iArgs
        
        Get piSeriesIndex to iSeriesIndex
        If (iSeriesIndex<>-1) Begin
            Get ComItem of (phoChartSeries(hoParent)) iSeriesIndex to vSeries
        End
        Else Begin
            Get ComAdd of (phoChartSeries(hoParent)) "" to vSeries // Child of the cSigCJDiagram but delegates up to chart object
            Get ComCount of (phoChartSeries(hoParent)) to iIndex
            Set piSeriesIndex to (iIndex-1)
        End
        Set pvComObject to vSeries
        
        // Create, set and bind a series style
        // Currently static, Need to be able to set the style as a property of the series and expose the properties of the style
        // within the series object.
        Get SeriesStyleObject to hoStyle
        Get ComCreateElement of hoParent (Private_psSeriesStyleClass(Self)) to vStyle
        
        // As the comstyle is set it creates the com diagram object and adds it to the diagram collection if it does not yet exist we can get the diagram of the series by calling ComDiagram
        Set ComStyle to vStyle
        Get ComDiagram to vDiagram
        Set Private_pvDiagram of hoParent to vDiagram
        
        Set pvComObject of hoStyle to vStyle
        // Bind Point Legend Format Object
        Send BindComObject (phoSeriesPointLegendNumberFormat(Self)) hoStyle (RefFunc(ComPointLegendFormat))
        // Bind Border object if relevant to style
        Get DoesPropertyApplyToSeriesStyle (RefProcSet(Private_phoChartBorder)) to bApplies
        If (bApplies) Begin
            Get ComBorder of hoStyle to vBorder
            Set pvComObject of (Private_phoChartBorder(Self)) to vBorder         
            Move False to bApplies 
        End
        // Bind Marker object if relevant to style
        Get DoesPropertyApplyToSeriesStyle (RefProcSet(Private_phoChartMarker)) to bApplies
        If (bApplies) Begin
            Get ComMarker of hoStyle to vMarker
            Set pvComObject of (Private_phoChartMarker(Self)) to vMarker           
            // Bind Marker FillStyle
            Send BindComObject (Private_phoChartMarkerFillStyle(Self)) (Private_phoChartMarker(Self)) (RefFunc(ComFillStyle))
            Move False to bApplies 
        End
        // Bind MarkerMax and Min objects if relevant to style
        Get DoesPropertyApplyToSeriesStyle (RefProcSet(Private_phoChartMarkerMax)) to bApplies
        If (bApplies) Begin
            Get ComMaxValueMarker of hoStyle to vMarker
            Set pvComObject of (Private_phoChartMarkerMax(Self)) to vMarker
            // Bind MarkerMax FillStyle
            Send BindComObject (Private_phoChartMarkerMaxFillStyle(Self)) (Private_phoChartMarkerMax(Self)) (RefFunc(ComFillStyle))
            Move False to bApplies 
        End 
        Get DoesPropertyApplyToSeriesStyle (RefProcSet(Private_phoChartMarkerMin)) to bApplies
        If (bApplies) Begin
            Get ComMinValueMarker of hoStyle to vMarker
            Set pvComObject of (Private_phoChartMarkerMin(Self)) to vMarker
            // Bind MarkerMin FillStyle
            Send BindComObject (Private_phoChartMarkerMinFillStyle(Self)) (Private_phoChartMarkerMin(Self)) (RefFunc(ComFillStyle))
            Move False to bApplies 
        End
        // Bind FillStyle object if relevant to style
        Get DoesPropertyApplyToSeriesStyle (RefProcSet(Private_phoChartFillStyle)) to bApplies
        If (bApplies) Begin
            // Bind FillStyle
            Get ComFillStyle of hoStyle to vFillStyle
            Set pvComObject of (Private_phoChartFillStyle(Self)) to vFillStyle
            Move False to bApplies             
        End
        // Bind LineStyle object if relevant to style
        Get DoesPropertyApplyToSeriesStyle (RefProcSet(Private_phoChartLineStyle)) to bApplies
        If (bApplies) Begin
            // Bind LineStyle
            Get ComLineStyle of hoStyle to vLineStyle
            Set pvComObject of (Private_phoChartLineStyle(Self)) to vLineStyle
            Move False to bApplies             
        End

        // Label objects
        Get SeriesLabelIsRelevant to hoLabel
        If (hoLabel>0) Begin
            Get ComLabel of hoStyle to vLabel        
            Set pvComObject of hoLabel to vLabel
            Set Private_phoSeriesStyleLabel to hoLabel
            // Bind the series label border object
            Send BindComObject (Private_phoChartSeriesLabelBorder(Self)) (Private_phoSeriesStyleLabel(Self)) (RefFunc(ComBorder))
            // Bind the series label Fillstyle object
            Send BindComObject (Private_phoChartSeriesLabelFillStyle(Self)) (Private_phoSeriesStyleLabel(Self)) (RefFunc(ComFillStyle))
            // Bind the series label Number Format object
            Get ComFormat of (Private_phoSeriesStyleLabel(Self)) to vFormat
            Set pvComObject of (Private_phoChartSeriesLabelNumberFormat(Self)) to vFormat
            // Bind the series label Font object
            Send BindComObject (Private_phoChartSeriesLabelFont(Self)) (Private_phoSeriesStyleLabel(Self)) (RefFunc(ComFont))
            If (IsComObjectCreated(Private_phoChartSeriesLabelFont(Self))) Begin
                // Bind a standard font object to the series label font object
                Send BindComObject (Private_phoChartSeriesFont(Self)) (Private_phoChartSeriesLabelFont(Self)) (RefFunc(ComStdFont))
            End
        End

        // Bind points collection    
        Send BindComObject (phoSeriesPointCollection(Self)) Self (RefFunc(ComPoints))
        
        // LineStyle                           
        Set peDashStyle                    to (Private_peDashStyle(Self))
        Set piThickness                    to (Private_piThickness(Self))
        // Series Style
        Set peColor                     to (Private_peColor(Self))
        Set pbColorEach                 to (Private_pbColorEach(Self))
        Set pbSecondaryAxisX            to (Private_pbSecondaryAxisX(Self))
        Set pbSecondaryAxisY            to (Private_pbSecondaryAxisY(Self))
        Set piTransparency              to (Private_piTransparency(Self))
        Set prBarWidth                  to (Private_prBarWidth(Self))
        Set pbSideBySide                to (Private_pbSideBySide(Self))
        Set prMaxSize                   to (Private_prMaxSize(Self))
        Set prMinSize                   to (Private_prMinSize(Self))
        Set piLineThickness             to (Private_piLineThickness(Self))
//        Set pbAntialiasing              to (Private_pbAntialiasing(Self))
        Set pbEqualHeight               to (Private_pbEqualHeight(Self))
        Set prHeightToWidthRatio        to (Private_prHeightToWidthRatio(Self))
        Set piPointDistance             to (Private_piPointDistance(Self))
        Set piExplodedDistancePercent   to (Private_piExplodedDistancePercent(Self))
        Set piHolePercent               to (Private_piHolePercent(Self))
        Set piRotation                  to (Private_piRotation(Self))
        Set prStackHeight               to (Private_prStackHeight(Self))
        Set piStackGroup                to (Private_piStackGroup(Self))
        Set pbInvertedStep              to (Private_pbInvertedStep(Self))
        // General Series Properties        
        Set peSeriesArgumentScaleType   to (Private_peSeriesArgumentScaleType(Self))
        Set psSeriesLegendText          to (Private_psSeriesLegendText(Self))
        Set pbSeriesLegendVisible       to (Private_pbSeriesLegendVisible(Self))
        Set psSeriesName                to (Private_psSeriesName(Self))
//        Set psSeriesPointLegendFormat   to (Private_psSeriesPointLegendFormat(Self))
        Set peSeriesValueScaleType      to (Private_peSeriesValueScaleType(Self))
        Set pbSeriesVisible             to (Private_pbSeriesVisible(Self))
        // Point Legend Format
        Set pePointLegendFormatCategory             to (Private_pePointLegendFormatCategory            (Self))
        Set psPointLegendFormatCurrencySymbol       to (Private_psPointLegendFormatCurrencySymbol      (Self))
        Set pePointLegendFormatDateTimeCategory     to (Private_pePointLegendFormatDateTimeCategory    (Self))
        Set psPointLegendFormatDateTimeFormat       to (Private_psPointLegendFormatDateTimeFormat      (Self))
        Set piPointLegendFormatDecimalPlaces        to (Private_piPointLegendFormatDecimalPlaces       (Self))
        Set piPointLegendFormatLocale               to (Private_piPointLegendFormatLocale              (Self))
        Set psPointLegendFormatPattern              to (Private_psPointLegendFormatPattern             (Self))
        Set pbPointLegendFormatUseThousandSeparator to (Private_pbPointLegendFormatUseThousandSeparator(Self))           
        // Border
        Set peBorderColor               to (Private_peBorderColor(Self))
        Set piBorderWidth               to (Private_piBorderWidth(Self))
        Set pbBorderVisible             to (Private_pbBorderVisible(Self))
        // Marker                           
        Set pbMarkerBorderVisible       to (Private_pbMarkerBorderVisible(Self))
        Set piMarkerSize                to (Private_piMarkerSize(Self))
        Set peMarkerType                to (Private_peMarkerType(Self))
        Set pbMarkerVisible             to (Private_pbMarkerVisible(Self))
        Set peMarkerFillMode            to (Private_peMarkerFillMode(Self))
        Set peMarkerGradientAngle       to (Private_peMarkerGradientAngle(Self))
        Set peMarkerHatchStyle          to (Private_peMarkerHatchStyle(Self))
        // MarkerMax
        Set pbMarkerMaxBorderVisible       to (Private_pbMarkerMaxBorderVisible(Self))
        Set piMarkerMaxSize                to (Private_piMarkerMaxSize(Self))
        Set peMarkerMaxType                to (Private_peMarkerMaxType(Self))
        Set pbMarkerMaxVisible             to (Private_pbMarkerMaxVisible(Self))
        Set peMarkerMaxFillMode            to (Private_peMarkerMaxFillMode(Self))
        Set peMarkerMaxGradientAngle       to (Private_peMarkerMaxGradientAngle(Self))
        Set peMarkerMaxHatchStyle          to (Private_peMarkerMaxHatchStyle(Self))
        // MarkerMin                           
        Set pbMarkerMinBorderVisible       to (Private_pbMarkerMinBorderVisible(Self))
        Set piMarkerMinSize                to (Private_piMarkerMinSize(Self))
        Set peMarkerMinType                to (Private_peMarkerMinType(Self))
        Set pbMarkerMinVisible             to (Private_pbMarkerMinVisible(Self))
        Set peMarkerMinFillMode            to (Private_peMarkerMinFillMode(Self))
        Set peMarkerMinGradientAngle       to (Private_peMarkerMinGradientAngle(Self))
        Set peMarkerMinHatchStyle          to (Private_peMarkerMinHatchStyle(Self))
        // FillStyle                           
        Set peFillMode                     to (Private_peFillMode(Self))
        Set peGradientAngle                to (Private_peGradientAngle(Self))
        Set peHatchStyle                   to (Private_peHatchStyle(Self))
        // Label
//        Set pbAntialiasing                 to (Private_pbLabelAntialiasing(Self))
        Set peBackColor                    to (Private_peLabelBackColor(Self))
        Set peLineColor                    to (Private_peLabelLineColor(Self))
        Set piLineLength                   to (Private_piLabelLineLength(Self))
        Set pePosition                     to (Private_peLabelPosition(Self))
        Set pbShowLines                    to (Private_pbLabelShowLines(Self))
        Set peTextColor                    to (Private_peLabelTextColor(Self))
        Set piLabelTransparency            to (Private_piLabelTransparency(Self))        
        Set pbLabelVisibile                to (Private_pbLabelVisible(Self))
        Set piAngle                        to (Private_piLabelAngle(Self))
        Set peType                         to (Private_peLabelType(Self))
        //Label Border                         
        Set peLabelBorderColor             to (Private_peLabelBorderColor(Self))
        Set piLabelBorderWidth             to (Private_piLabelBorderWidth(Self))
        Set pbLabelBorderVisible           to (Private_pbLabelBorderVisible(Self))        
        //Label Fillstyle                      
        Set peLabelFillMode                to (Private_peLabelFillMode(Self))
        Set peLabelGradientAngle           to (Private_peLabelGradientAngle(Self))
        Set peLabelHatchStyle              to (Private_peLabelHatchStyle(Self))
        //Label Format
        Set peLabelFormatCategory             to (Private_peLabelFormatCategory            (Self))
        Set psLabelFormatCurrencySymbol       to (Private_psLabelFormatCurrencySymbol      (Self))
        Set peLabelFormatDateTimeCategory     to (Private_peLabelFormatDateTimeCategory    (Self))
        Set psLabelFormatDateTimeFormat       to (Private_psLabelFormatDateTimeFormat      (Self))
        Set piLabelFormatDecimalPlaces        to (Private_piLabelFormatDecimalPlaces       (Self))
        Set piLabelFormatLocale               to (Private_piLabelFormatLocale              (Self))
        Set psLabelFormatPattern              to (Private_psLabelFormatPattern             (Self))
        Set pbLabelFormatUseThousandSeparator to (Private_pbLabelFormatUseThousandSeparator(Self))         
        //Label Font                              
        Set pbLabelBold                       to (Private_pbLabelBold(Self))
        Set pbLabelItalic                     to (Private_pbLabelItalic(Self))
//        Set pbLabelStrikethrough              to (Private_pbLabelStrikeThrough(Self))
        Set pbLabelUnderline                  to (Private_pbLabelUnderline(Self))
        Set psLabelFontName                   to (Private_psLabelFontName(Self))
        Set pnLabelFontSize                   to (Private_pnLabelFontSize(Self))        
        
        Set peSeriesStyle               to (Private_peSeriesStyle(Self))
        // Event OnSeriesCreated : Allows the setting of com properties which have not been defined
        Send OnSeriesCreated
        
        If (iSeriesIndex=-1) Begin
            // DoLoadDataSource contains events to load the data by adding series points either by batch or individualy.
            Send DoLoadDataSource
        End
        Else Begin
            // if iSeriesIndex is not -1 then we can only be changing the SeriesStyle.
            // in changing the series style the com diagram is destroyed and a new com diagram created.
            // therefore we need to rebuild the diagram to reapply all the diagram properties.
            Send BuildDiagram of hoParent
        End
    End_Procedure
End_Class