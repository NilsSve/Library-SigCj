    // Registers the styles that the property applies to within a strut array property Private_ptaPropertiesStyleLink
    Procedure RegisterRelevantStyles Handle hPrivateProperty String sSeriesStyles Boolean bRemove
        Integer iArgs
        Boolean bAdd
        
        Move True to bAdd
        Move num_arguments to iArgs
        If (iArgs=3) Begin
            If (bRemove=True) Begin
                Move False to bAdd
                // If the number of Args=3 and bRemove=True then we are removing values from iaStyles of the struct
                // So we need to send UnRegisterStyles
                Send UnRegisterStyles hPrivateProperty sSeriesStyles
            End
        End
        If (bAdd=True) Begin
            // If bAdd is True then we must be registering styles
            Send RegisterStyles hPrivateProperty sSeriesStyles                
        End
    End_Procedure
    
    // Registers the styles that the property applies to within a strut array property Private_ptaPropertiesStyleLink
    Procedure RegisterStyles Handle hPrivateProperty String sSeriesStyles
        tdPropertiesStyleLink[] taPropertiesStyleLink
        String[] saStyles
        Integer iSize iLoop iStyle iElement iSearchIndex
        
        // get the current values from the struct property
        Get Private_ptaPropertiesStyleLink to taPropertiesStyleLink
        // Add the new property to sPropertyName of the struct array within the next available element
        Move (SizeOfArray(taPropertiesStyleLink)) to iElement
        Move hPrivateProperty to taPropertiesStyleLink[iElement].hPrivateProperty                  
        // seperate the different series styles from sSeriesStyles in to an array
        Get SeparateIntoElements sSeriesStyles ',' to saStyles
        Move (SizeOfArray(saStyles)) to iSize
        // loop through the array and add the listed series styles to iaStyles[] of the struct array
        For iLoop from 0 to (iSize-1)
            Move (Eval(saStyles[iLoop])) to iStyle
            // Make sure the style does not already exist within the array
            Move (SearchArray(iStyle, taPropertiesStyleLink[iElement].iaStyles)) to iSearchIndex
            If (iSearchIndex=-1) Begin            
                Move iStyle to taPropertiesStyleLink[iElement].iaStyles[iLoop]
            End
        Loop
        // set the struct property with the new values
        Set Private_ptaPropertiesStyleLink to taPropertiesStyleLink
    End_Procedure    
    
    // UnRegisters the styles that the property Does not apply to within the strut array property Private_ptaPropertiesStyleLink
    Procedure UnRegisterStyles Handle hPrivateProperty String sSeriesStyles
        tdPropertiesStyleLink[] taPropertiesStyleLink
        String[] saStyles
        Integer iSize iLoop iStyle iElement iSearchIndex      
        
        // get the current values from the struct property
        Get Private_ptaPropertiesStyleLink to taPropertiesStyleLink
        // find the element that the passed property is stored in  
        Get FindPropertyInStruct hPrivateProperty taPropertiesStyleLink to iElement
        // if we can't find it then it doesn't exist! ergo we can't remove styles from it so bomb out
        If (iElement=-1) Begin
            Procedure_Return
        End
        // seperate the different series styles from sSeriesStyles in to an array
        Get SeparateIntoElements sSeriesStyles ',' to saStyles
        Move (SizeOfArray(saStyles)) to iSize
        // loop through the array and add the listed series styles to iaStyles[] of the struct array
        For iLoop from 0 to (iSize-1)
            Move (Eval(saStyles[iLoop])) to iStyle
            // If removing from existing array iaStyles
            Move (SearchArray(iStyle, taPropertiesStyleLink[iElement].iaStyles)) to iSearchIndex
            If (iSearchIndex<>-1) Begin
                Move (RemoveFromArray(taPropertiesStyleLink[iElement].iaStyles, iSearchIndex)) to taPropertiesStyleLink[iElement].iaStyles
            End
        Loop
        // set the struct property with the new values
        Set Private_ptaPropertiesStyleLink to taPropertiesStyleLink            
    End_Procedure
    
    // Custom comparison function for use within function DoesPropertyApplyToSeriesStyle
    Function CompareStructs tdPropertiesStyleLink ActualStruct tdPropertiesStyleLink SearchStruct Returns Integer
        If (ActualStruct.hPrivateProperty > SearchStruct.hPrivateProperty) ;
            Function_Return (GT)
        If (ActualStruct.hPrivateProperty < SearchStruct.hPrivateProperty) ;
            Function_Return (LT)
        Function_Return (EQ)
    End_Function
    
    Function FindPropertyInStruct Handle hPrivateProperty tdPropertiesStyleLink[] taPropertiesStyleLink Returns Integer
        tdPropertiesStyleLink   tSearchPropertiesStyleLink
        Integer iSearchIndex
        
        // populate the search struct instance with the known property name
        Move hPrivateProperty to tSearchPropertiesStyleLink.hPrivateProperty
        // call CompareStructs function to search struct array elements for the property name in tSearchPropertiesStyleLink
        Move (SearchArray(tSearchPropertiesStyleLink, taPropertiesStyleLink, Self, (RefFunc(CompareStructs)))) to iSearchIndex
        Function_Return iSearchIndex        
    End_Function
    
    // Returns True if the passed property is registered to the specified series style
    Function DoesPropertyApplyToSeriesStyle Integer iPrivateProperty Returns Boolean
        tdPropertiesStyleLink[] taPropertiesStyleLink        
        Integer iSearchIndex iStyle
        
        Get Private_ptaPropertiesStyleLink to taPropertiesStyleLink
        // Search the struct array for the given property
        Get FindPropertyInStruct iPrivateProperty taPropertiesStyleLink to iSearchIndex
        // if we can not find the property then nor can we find the style against that property so return false
        If (iSearchIndex=-1) Begin
            Function_Return False
        End
        Else Begin
            Get Private_peSeriesStyle to iStyle
            // search the array of styles linked to that property for that specified in Private_peSeriesStyle
            Move (SearchArray(iStyle, taPropertiesStyleLink[iSearchIndex].iaStyles)) to iSearchIndex
        End
        // return true if found
        Function_Return (If(iSearchIndex<>-1,True,False))
    End_Function
    
