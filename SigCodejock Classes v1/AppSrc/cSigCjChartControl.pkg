        // Handle to the series style object
        {DesignTime=False}
        Property Handle Private_phoSeriesStyle                       (phoBarSeriesStyle(Self))
        // Handle to relevant chart series label object
        {Visibility=Private}
        Property Handle  Private_phoSeriesStyleLabel                 (Private_phoChartPointSeriesLabel(Self))
              
        
        //=====================================================================
        //COM Properties
        //=====================================================================          
        
        {Visibility=Private}
        Property Integer    Private_peColor             clBlue
        Send RegisterRelevantStyles (RefProcSet(Private_peColor)) (Private_psAllSeriesStyles(Self))
        Send RegisterRelevantStyles (RefProcSet(Private_peColor)) "xtpCandleStickSeriesStyle,xtpHighLowSeriesStyle" True // remove registered styles
        {Visibility=Private}
