        Send RegisterRelevantStyles (RefProcSet(Private_prMinSize)) "xtpBubbleSeriesStyle"
        {Visibility=Private}
        Property Integer    Private_piLineThickness      3
        Send RegisterRelevantStyles (RefProcSet(Private_piLineThickness)) "xtpCandleStickSeriesStyle,xtpHighLowSeriesStyle"
//        {Visibility=Private}
//        Property Boolean    Private_pbAntialiasing
//        Send RegisterRelevantStyles (RefProcSet(Private_pbAntialiasing)) "xtpFastLineSeriesStyle"
        {Visibility=Private}
