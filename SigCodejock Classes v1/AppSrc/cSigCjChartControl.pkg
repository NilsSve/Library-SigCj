    {Visibility=Private}
    Procedure CreateDiagramAxis Handle hoParent
        Variant vTitle vFont vConstantLine vGridLines vLabel vStrip vFormat vAxis

        // if the chart diagram object has been created
        If (IsComObjectCreated(hoParent)) Begin
            Get AxisComObject hoParent to vAxis
            Set pvComObject to vAxis

            // Axis object Bindings
            // Axis Constant Line Collection
            Send BindComObject (Private_phoAxisConstantLines(Self)) Self (RefFunc(ComConstantLines))
            // Axis GridLines object
            Get ComGridLines to vGridLines
            Set pvComObject of (Private_phoAxisGridLine(Self)) to vGridLines
            // Axis Intelaced FillStyle
            Send BindComObject (Private_phoAxisInterlacedFillstyle(Self)) Self (RefFunc(ComInterlacedFillStyle)) 
            // Axis Label
            Get ComLabel to vLabel
            Set pvComObject of (Private_phoAxisLabel(Self)) to vLabel
            Get ComFormat of (Private_phoAxisLabel(Self)) to vFormat
            Set pvComObject of (Private_phoAxisLabelNumberFormat(Self)) to vFormat
            
            Send BindComObject (Private_phoAxisLabelChartFont(Self)) (Private_phoAxisLabel(Self)) (RefFunc(ComFont))
            If (IsComObjectCreated(Private_phoAxisLabelChartFont(Self))) Begin
                // Bind a standard font object to the Axis Label font object
                Send BindComObject (Private_phoAxisLabelFont(Self)) (Private_phoAxisLabelChartFont(Self)) (RefFunc(ComStdFont))
            End
            // Axis Title
            Get ComTitle to vTitle
            Set pvComObject of (Private_phoAxisTitle(Self)) to vTitle
            Send BindComObject (Private_phoAxisTitleChartFont(Self)) (Private_phoAxisTitle(Self)) (RefFunc(ComFont))
            If (IsComObjectCreated(Private_phoAxisTitleChartFont(Self))) Begin
                // Bind a standard font object to the Axis Label font object
                Send BindComObject (Private_phoAxisTitleFont(Self)) (Private_phoAxisTitleChartFont(Self)) (RefFunc(ComStdFont))
            End
            // Axis Strips Collection
            Send BindComObject (Private_phoAxisStrips(Self)) Self (RefFunc(ComStrips))
            // Axis Range
            Send BindComObject (Private_phoAxisRange(Self)) Self (RefFunc(ComRange))
            // Axis Tick Marks
            Send BindComObject (Private_phoAxisTickMarks(Self)) Self (RefFunc(ComTickMarks))

            // Diagram Axis                
            Set peAxisAlignment                    to (Private_peAxisAlignment(Self))
            Set pbAxisAllowZoom                    to (Private_pbAxisAllowZoom(Self))
            Set peAxisColor                        to (Private_peAxisColor(Self))
            Set prAxisGridSpacing                  to (Private_prAxisGridSpacing(Self))
            Set pbAxisGridSpacingAuto              to (Private_pbAxisGridSpacingAuto(Self))
            Set pbAxisInterlaced                   to (Private_pbAxisInterlaced(Self))
            Set peAxisInterlacedColor1             to (Private_peAxisInterlacedColor1(Self))
            Set peAxisInterlacedColor2             to (Private_peAxisInterlacedColor2(Self))
            Set piAxisMinorCount                   to (Private_piAxisMinorCount(Self))
            Set pbAxisReversed                     to (Private_pbAxisReversed(Self))
            Set piAxisThickness                    to (Private_piAxisThickness(Self))
            Set pbAxisVisible                      to (Private_pbAxisVisible(Self))
            // 2DDiagram Axis GridLine                 
            Set pbAxisGridLineMinorVisible         to (Private_pbAxisGridLineMinorVisible(Self))
            Set pbAxisGridLineVisible              to (Private_pbAxisGridLineVisible(Self))
            // 2DDiagram Axis Interlaced Fillstyle     
            Set peAxisInterlacedFillMode           to (Private_peAxisInterlacedFillMode(Self))
            Set peAxisInterlacedGradientAngle      to (Private_peAxisInterlacedGradientAngle(Self))
            Set peAxisInterlacedHatchStyle         to (Private_peAxisInterlacedHatchStyle(Self))                
            // 2DDiagram Axis Label                                       
            Set piAxisLabelAngle                   to (Private_piAxisLabelAngle(Self))
//                Set pbAxisLabelAntialiasing            to (Private_pbAxisLabelAntialiasing(Self))
            Set peAxisLabelTextColor               to (Private_peAxisLabelTextColor(Self))
            Set pbAxisLabelVisible                 to (Private_pbAxisLabelVisible(Self))
            // 2DDiagram Axis Label Format
            Set peAxisLabelFormatCategory             to (Private_peAxisLabelFormatCategory            (Self))
            Set psAxisLabelFormatCurrencySymbol       to (Private_psAxisLabelFormatCurrencySymbol      (Self))
            Set peAxisLabelFormatDateTimeCategory     to (Private_peAxisLabelFormatDateTimeCategory    (Self))
            Set psAxisLabelFormatDateTimeFormat       to (Private_psAxisLabelFormatDateTimeFormat      (Self))
            Set piAxisLabelFormatDecimalPlaces        to (Private_piAxisLabelFormatDecimalPlaces       (Self))
            Set piAxisLabelFormatLocale               to (Private_piAxisLabelFormatLocale              (Self))
            Set psAxisLabelFormatPattern              to (Private_psAxisLabelFormatPattern             (Self))
            Set pbAxisLabelFormatUseThousandSeparator to (Private_pbAxisLabelFormatUseThousandSeparator(Self))                
            // 2DDiagram Axis Label Font                                                     
            Set pbAxisLabelBold                    to (Private_pbAxisLabelBold(Self))
//                Set pbAxisLabelItalic                  to (Private_pbAxisLabelItalic(Self))
//                Set pbAxisLabelStrikeThrough           to (Private_pbAxisLabelStrikeThrough(Self))
            Set pbAxisLabelUnderline               to (Private_pbAxisLabelUnderline(Self))
            Set psAxisLabelFontName                to (Private_psAxisLabelFontName(Self))
            Set pnAxisLabelFontSize                to (Private_pnAxisLabelFontSize(Self))
            // 2DDiagram Axis Title                
            Set peAxisTitleAlignment               to (Private_peAxisTitleAlignment(Self))
//                Set pbAxisTitleAntialiasing            to (Private_pbAxisTitleAntialiasing(Self))
            Set psAxisTitleText                    to (Private_psAxisTitleText(Self))
            Set pbAxisTitleVisible                 to (Private_pbAxisTitleVisible(Self))
            // 2DDiagram Axis Title Font           
            Set pbAxisTitleBold                    to (Private_pbAxisTitleBold(Self))
//                Set pbAxisTitleItalic                  to (Private_pbAxisTitleItalic(Self))
//                Set pbAxisTitleStrikeThrough           to (Private_pbAxisTitleStrikeThrough(Self))
            Set pbAxisTitleUnderline               to (Private_pbAxisTitleUnderline(Self))
            Set psAxisTitleFontName                to (Private_psAxisTitleFontName(Self))
            Set pnAxisTitleFontSize                to (Private_pnAxisTitleFontSize(Self))
            // 2DDiagram Axis Range                    
            Set pbAxisRangeAutoRange               to (Private_pbAxisRangeAutoRange(Self))
            Set prAxisRangeMaxValue                to (Private_prAxisRangeMaxValue(Self))
            Set prAxisRangeMinValue                to (Private_prAxisRangeMinValue(Self))
            Set pbAxisRangeShowZeroLevel           to (Private_pbAxisRangeShowZeroLevel(Self))
            Set pbAxisRangeSideMargins             to (Private_pbAxisRangeSideMargins(Self))     
            Set pbAxisRangeViewAutoRange           to (Private_pbAxisRangeViewAutoRange(Self))
            Set prAxisRangeViewMaxValue            to (Private_prAxisRangeViewMaxValue(Self))
            Set prAxisRangeViewMinValue            to (Private_prAxisRangeViewMinValue(Self))
            Set prAxisRangeZoomLimit               to (Private_prAxisRangeZoomLimit(Self)) 
            // 2DDiagram Axis Tick Marks               
            Set pbAxisTickMarksCrossAxis           to (Private_pbAxisTickMarksCrossAxis(Self))
            Set piAxisTickMarksLength              to (Private_piAxisTickMarksLength(Self))
            Set piAxisTickMarksThickness           to (Private_piAxisTickMarksThickness(Self))
            Set pbAxisTickMarksVisible             to (Private_pbAxisTickMarksVisible(Self))                      
            Set piAxisTickMarksMinorLength         to (Private_piAxisTickMarksMinorLength(Self))
            Set piAxisTickMarksMinorThickness      to (Private_piAxisTickMarksMinorThickness(Self))
            Set pbAxisTickMarksMinorVisible        to (Private_pbAxisTickMarksMinorVisible(Self))
            
            // Event OnAxisCreated : Allows the setting of com properties which have not been defined
            Send OnAxisCreated
            
            Broadcast Send CreateDiagramAxisObjects Self 
        End
    End_Procedure    
    
End_Class

