// Chart Appearance

    {Visibility=Public MethodType=Property InitialValue="Nature" Category=Chart}
    {EnumList= "Nature, Black, Gray"}
    Procedure Set psAppearance String sAppearance
        Set Private_psAppearance to sAppearance
        If (IsComObjectCreated(Private_phoChartAppearance(Self))) Begin
            Send ComSetAppearance of (Private_phoChartAppearance(Self)) sAppearance
        End
    End_Procedure
    
    Function psAppearance Returns String
        Function_Return (Private_psAppearance(Self))
    End_Function
    
    {Visibility=Public MethodType=Property InitialValue="Nature" Category=Chart}
    {EnumList= "Victorian, Vibrant Pastel, Vibrant, Tropical, Summer, Spring Time, Rainbow"          }
    {EnumList+="Purple, Primary Colors, Postmodern, Photodesign, Pastel, Office, Orange Green"       }
    {EnumList+="Nature, Natural, Impresionism, Illustration, Harvest, Green Brown, Green Blue, Green"}
    {EnumList+="Gray, Four Color, Fire, Earth Tone, Danville, Caribbean, Cappuccino, Blue Gray, Blue"}                                                                    
    Procedure Set psPalette String sPalette
        Set Private_psPalette to sPalette
        If (IsComObjectCreated(Private_phoChartAppearance(Self))) Begin
            Send ComSetPalette of (Private_phoChartAppearance(Self)) sPalette
        End
    End_Procedure
    
    Function psPalette Returns String
        Function_Return (Private_psPalette(Self))
    End_Function
         
//---------------------------------------End Properties------------------------------------------------

//----------------------------OnClick Events, Functions and Procedures----------------------------------

    {Visibility=Private}
    Procedure OnComMouseDown Short llButton Short llShift Integer llx Integer lly        
        Variant vComObjUnderCursor vComObj vPointsCol vPoint
        Handle hoSeriesCol hoSeries hoSeriesPointCol hoPoint
        Integer iCount iLoop iLoop2 iPointsCount
        
        // Get the com object under the X,Y co-ords passed by the mouse event.
        Get ComHitTest llx lly to vComObjUnderCursor
        // Does it match any of the com point objects within the points collections of the Series Objects?
        Get phoChartSeries to hoSeriesCol
        Get ComCount of hoSeriesCol to iCount
        For iLoop from 0 to (iCount-1)
            Get Create (RefClass(cSigCjComChartSeries)) to hoSeries
            Get Create (RefClass(cSigCjComChartSeriesPointCollection)) to hoSeriesPointCol
            Get ComItem of hoSeriesCol iLoop to vComObj
            Set pvComObject of hoSeries to vComObj
            Get ComPoints of hoSeries to vPointsCol
            Set pvComObject of hoSeriesPointCol to vPointsCol
            Get ComCount of hoSeriesPointCol to iPointsCount
            For iLoop2 from 0 to (iPointsCount-1)
                Get ComItem of hoSeriesPointCol iLoop2 to vPoint
                If (IsSameComObject(vPoint,vComObjUnderCursor)) Begin // does it match the series point at index iloop
                    Get Create (RefClass(cSigCjComChartSeriesPoint)) to hoPoint
                    Set pvComObject of hoPoint to vPoint
                    Send OnPointClick llButton llShift iLoop iLoop2 hoPoint
                    Send Destroy of hoPoint
                    Move (iPointsCount-1) to iLoop2
                    Move (iCount-1) to iLoop
                End
            Loop          
            Send Destroy of hoSeries
            Send Destroy of hoSeriesPointCol
        Loop
    End_Procedure
    
    {Visibility=Private}
    Procedure OnComDblClick Short llButton Short llShift Integer llx Integer lly
        Variant vComObjUnderCursor vComObj vPointsCol vPoint
        Handle hoSeriesCol hoSeries hoSeriesPointCol hoPoint
        Integer iCount iLoop iLoop2 iPointsCount
        
        // Get the com object under the X,Y co-ords passed by the mouse event.
        Get ComHitTest llx lly to vComObjUnderCursor
        // Does it match any of the com point objects within the points collections of the Series Objects?
        Get phoChartSeries to hoSeriesCol
        Get ComCount of hoSeriesCol to iCount
        For iLoop from 0 to (iCount-1)
            Get Create (RefClass(cSigCjComChartSeries)) to hoSeries
            Get Create (RefClass(cSigCjComChartSeriesPointCollection)) to hoSeriesPointCol
            Get ComItem of hoSeriesCol iLoop to vComObj
            Set pvComObject of hoSeries to vComObj
            Get ComPoints of hoSeries to vPointsCol
            Set pvComObject of hoSeriesPointCol to vPointsCol
            Get ComCount of hoSeriesPointCol to iPointsCount
            For iLoop2 from 0 to (iPointsCount-1)
                Get ComItem of hoSeriesPointCol iLoop2 to vPoint
                If (IsSameComObject(vPoint,vComObjUnderCursor)) Begin // does it match the series point at index iloop
                    Get Create (RefClass(cSigCjComChartSeriesPoint)) to hoPoint
                    Set pvComObject of hoPoint to vPoint
                    Send OnPointDblClick llButton llShift iLoop iLoop2 hoPoint
                    Send Destroy of hoPoint
                    Move (iPointsCount-1) to iLoop2
                    Move (iCount-1) to iLoop
                End
            Loop          
            Send Destroy of hoSeries
            Send Destroy of hoSeriesPointCol
        Loop
    End_Procedure    
    
    {Visibility=Public MethodType=Event}
    Procedure OnPointClick Short llButton Short llShift Integer iSeriesIndex Integer iPointIndex Handle hoPoint
    End_Procedure
    
    {Visibility=Public MethodType=Event}
    Procedure OnPointDblClick Short llButton Short llShift Integer iSeriesIndex Integer iPointIndex Handle hoPoint
    End_Procedure
    
    {Visibility=Public MethodType=Event}
    Procedure OnChartCreated
    End_Procedure
    
    {Visibility=Public MethodType=Method}
    Procedure PrintChart Boolean bPrintPreview
        Integer iRetval iArgs
        Boolean bCancel
        
        Move num_arguments to iArgs
        If (iArgs>0) Begin
            If (bPrintPreview) Begin
                Get ComPrintPreview to iRetval
                If (iRetval=0) Begin
                    Move True to bCancel
                End
            End
        End
        If (not(bCancel)) Begin
            Send ComPrintChart 0
        End
    End_Procedure    
  
//---------------------------------------------------------------------------------------------------------     
    
    {MethodType=Method Visibility=Public}
    Procedure RefreshAllSeriesPoints
        If (IsComObjectCreated(Self)) Begin     
            Broadcast Send RefreshAllSeriesPoints
        End
    End_Procedure
    
    {MethodType=Method Visibility=Public}
    Procedure ReLoadAllSeriesPoints
        If (IsComObjectCreated(Self)) Begin 
            Broadcast Send ReLoadAllSeriesPoints
        End
    End_Procedure  
    
    {Visibility=Private}
    Procedure BuildAllDiagramsAndSeries
        Send ComDeleteAll of (phoChartDiagrams(Self))
        Send ComDeleteAll of (phoChartSeries(Self))
        Broadcast Recursive Set piSeriesIndex to -1
        Broadcast Send CreateChartControl Self
    End_Procedure
    
    {Visibility=Private}
    Procedure OnCreate
        Variant vTitle
        Variant vAppearance vFont
       
        Forward Send OnCreate

        // Binding of the chart content obj
        Send BindComObject (Private_phoChartContent(Self)) Self (RefFunc(ComContent))
        If (IsComObjectCreated(Self)) Begin
            Send ComEnableToolTips True
            // The Binding of the tooltip context is dependant on ComEnableToolTips being set to true
            Send BindComObject (Private_phoChartTooltipContext(Self)) Self (RefFunc(ComToolTipContext)) 
        End
        // Binding of the chart title and its sub components within the chart title collection
        Send BindComObject (Private_phoChartTitleCollection(Self)) (Private_phoChartContent(Self)) (RefFunc(ComTitles))         
        If (IsComObjectCreated(Private_phoChartTitleCollection(Self))) Begin
            Get ComAdd      of (Private_phoChartTitleCollection(Self)) ""    to vTitle
            Set pvComObject of (Private_phoChartTitle(Self))                 to vTitle
        End
        Send BindComObject (Private_phoChartTitleFont(Self)) (Private_phoChartTitle(Self)) (RefFunc(ComFont))         
        If (IsComObjectCreated(Private_phoChartTitleFont(Self))) Begin
            // Bind a standard font object to the chart font object
            Send BindComObject (Private_phoFont(Self)) (Private_phoChartTitleFont(Self)) (RefFunc(ComStdFont)) 
        End
        // Binding of the chart legend and its sub components
        Send BindComObject (Private_phoChartLegend(Self))          (Private_phoChartContent(Self)) (RefFunc(ComLegend))
        Send BindComObject (Private_phoChartLegendBorder(Self))    (Private_phoChartLegend(Self))  (RefFunc(ComBorder))
        Send BindComObject (Private_phoChartLegendFillstyle(Self)) (Private_phoChartLegend(Self))  (RefFunc(ComFillStyle))
        
        Send BindComObject (Private_phoChartLegendFont(Self))      (Private_phoChartLegend(Self))  (RefFunc(ComFont))
        If (IsComObjectCreated(Private_phoChartLegendFont(Self))) Begin
            // Bind a standard font object to the chart font object
            Send BindComObject (Private_phoLegendFont(Self)) (Private_phoChartLegendFont(Self)) (RefFunc(ComStdFont)) 
        End                
        // Binding of the chart border obj
        Send BindComObject (Private_phoChartBorder(Self)) (Private_phoChartContent(Self)) (RefFunc(ComBorder)) 
        // Binding of the chart appearance obj
        Send BindComObject (Private_phoChartAppearance(Self)) (Private_phoChartContent(Self)) (RefFunc(ComAppearance))              
        // Binding of Diagram and series collections
        Send BindComObject (phoChartDiagrams(Self)) (Private_phoChartContent(Self)) (RefFunc(ComDiagrams)) 
        Send BindComObject (phoChartSeries(Self))   (Private_phoChartContent(Self)) (RefFunc(ComSeries)) 
        
        // chart
        Set peBackGroundColor               to (Private_peBackGroundColor(Self))
        Set pePanelDirection                to (Private_pePanelDirection(Self))
        Set piPanelSpacing                  to (Private_piPanelSpacing(Self))
        Set piToolTipStyle                  to (Private_piToolTipStyle(Self))
        // title        
        Set peTitleAlignment                to (Private_peTitleAlignment(Self))
//        Set pbTitleAntialising              to (Private_pbTitleAntialising(Self))
        Set peTitleDocking                  to (Private_peTitleDocking(Self))
//        Set piTitleIndent                   to (Private_piTitleIndent(Self))
        Set peTitleColor                    to (Private_peTitleColor(Self))
        Set pbTitleVisible                  to (Private_pbTitleVisible(Self))
        // title font        
        Set pbTitleBold                     to (Private_pbTitleBold(Self))
//        Set pbTitleItalic                   to (Private_pbTitleItalic(Self))
//        Set pbTitleStrikethrough            to (Private_pbTitleStrikeThrough(Self))
        Set pbTitleUnderline                to (Private_pbTitleUnderline(Self))
        Set psTitleFontName                 to (Private_psTitleFontName(Self))
        Set pnTitleFontSize                 to (Private_pnTitleFontSize(Self))
        // psTitleText must be set after any properties that could effect it's appearance
        Set psTitleText                     to (Private_psTitleText(Self))
        // legend        
//        Set pbLegendAntialising             to (Private_pbLegendAntialising(Self))
        Set peLegendBackGroundColor         to (Private_peLegendBackGroundColor(Self))
        Set piLegendColumnCount             to (Private_piLegendColumnCount(Self))
        Set peLegendDirection               to (Private_peLegendDirection(Self))
        Set peLegendHorizontalAlignment     to (Private_peLegendHorizontalAlignment(Self))           
        Set peLegendVerticalAlignment       to (Private_peLegendVerticalAlignment(Self))
        Set piLegendMarkerHeight            to (Private_piLegendMarkerHeight(Self))     
        Set piLegendMarkerWidth             to (Private_piLegendMarkerWidth(Self))           
        Set pbLegendMarkerVisible           to (Private_pbLegendMarkerVisible(Self))      
        Set peLegendTextColor               to (Private_peLegendTextColor(Self))         
        Set piLegendOffsetX                 to (Private_piLegendOffsetX(Self))
        Set piLegendOffsetY                 to (Private_piLegendOffsetY(Self))               
        // legend border        
        Set peLegendBorderColor             to (Private_peLegendBorderColor(Self))   
        Set piLegendBorderWidth             to (Private_piLegendBorderWidth(Self)) 
        Set pbLegendBorderVisible           to (Private_pbLegendBorderVisible(Self)) 
        // legend fill mode        
        Set peLegendFillMode                to (Private_peLegendFillMode(Self))
        Set peLegendGradientAngle           to (Private_peLegendGradientAngle(Self))
        Set peLegendHatchStyle              to (Private_peLegendHatchStyle(Self))
        // legend font
        Set pbLegendBold                    to (Private_pbLegendBold      (Self))
        Set pbLegendUnderline               to (Private_pbLegendUnderline (Self))
        Set psLegendFontName                to (Private_psLegendFontName  (Self))
        Set pnLegendFontSize                to (Private_pnLegendFontSize  (Self))
        // legend  
        Set pbLegendVisible                 to (Private_pbLegendVisible(Self))
        // border        
        Set peBorderColor                   to (Private_peBorderColor(Self))   
        Set piBorderWidth                   to (Private_piBorderWidth(Self)) 
        Set pbBorderVisible                 to (Private_pbBorderVisible(Self))
        // appearance
        Set psAppearance                    to (Private_psAppearance(Self))
        Set psPalette                       to (Private_psPalette(Self))

        // Event OnChartCreated : Allows the setting of com properties which have not been defined
        Send OnChartCreated
     
        // and finally
        Send BuildAllDiagramsAndSeries
    End_Procedure
End_Class

Class cSigCjDiagram is a cObject //cComAutomationObject //cSigCjComChartDiagram  
    
    Procedure Construct_Object
        Forward Send Construct_Object               

        Import_Class_Protocol cSigCJChartMethods_Mixin
        
        {Visibility=Private} 
        Property Integer Private_peType                                  
        {Visibility=Private} 
        Property Variant Private_pvDiagram
        {Visibility=Private} 
        Property Handle Private_phoDiagram                              (Create(Self,RefClass(cSigCjComChartDiagram2D)))
        
        //=====================================================================
        //Embedded Object Handles
        //=====================================================================                  

        {DesignTime=False}
        Property Handle Private_phoDiagram2D                     (Create(Self,RefClass(cSigCjComChartDiagram2D)))
        {DesignTime=False}
        Property Handle Private_phoDiagramPie                    (Create(Self,RefClass(cSigCjComChartPieDiagram)))
        {DesignTime=False}
        Property Handle Private_phoDiagramRadar                  (Create(Self,RefClass(cSigCjComChartRadarDiagram)))        
        // Title collection bindings, generic to both diagram types
        {DesignTime=False}
        Property Handle Private_phoDiagramTitleCollection        (Create(Self,RefClass(cSigCjComChartTitleCollection)))
        // If we were to later consider using multiple titles we'll have to explore the possibility creating and destroying the title objects 
        // as we come to Get/Set the properties using the item Index of the title collection comtitleobject. As it is we can hard code a handle 
        // to the single title Object.
        {DesignTime=False}
        Property Handle Private_phoDiagramTitle                  (Create(Self,RefClass(cSigCjComChartTitle)))
        {DesignTime=False}
        Property Handle Private_phoDiagramTitleFont              (Create(Self,RefClass(cSigCjComChartFont)))                       
        {DesignTime=False}
        Property Handle Private_phoDiagramFont                   (Create(Self,RefClass(cSigCjFont)))
        
        // Bindings only relevant to Diagram2D
        {DesignTime=False}
        Property Handle Private_pho2DBackgroundFillstyle         (Create(Self,RefClass(cSigCjComChartFillStyle)))

        //=====================================================================
        //COM Properties
        //=====================================================================
                        
        // properties of the Diagram
        // Title
        {Visibility=Private}                        
        Property String Private_psDiagramTitleText                       ""
        {Visibility=Private}
        Property Integer Private_peDiagramTitleAlignment                 xtpChartAlignCenter
//        {Visibility=Private}
//        Property Boolean Private_pbDiagramTitleAntialising               False
        {Visibility=Private}
        Property Integer Private_peDiagramTitleDocking                   xtpChartDockTop
//        {Visibility=Private}
//        Property Integer Private_piDiagramTitleIndent                    0
        {Visibility=Private}
        Property Integer Private_peDiagramTitleColor                     clBlack
        {Visibility=Private}
        Property Boolean Private_pbDiagramTitleVisible                   True
        // Title font
        {Visibility=Private}
        Property Boolean Private_pbDiagramTitleBold                      True
//        {Visibility=Private}
//        Property Boolean Private_pbDiagramTitleItalic                    False
//        {Visibility=Private}
//        Property Boolean Private_pbDiagramTitleStrikeThrough             False
        {Visibility=Private}
        Property Boolean Private_pbDiagramTitleUnderline                 True
        {Visibility=Private}
        Property String Private_psDiagramTitleFontName
        {Visibility=Private}
        Property Number Private_pnDiagramTitleFontSize                   0
        
        // Diagram2D and Radar
        {Visibility=Private}
        Property Integer Private_pe2DBorderColor                         clBtnShadow
        {Visibility=Private}
        Property Integer Private_pe2DBackgroundColor1                    clBtnFace             
        {Visibility=Private}
        Property Integer Private_pe2DBackgroundColor2                    clWhite
        
        // Diagram2D and Radar Fillstyle
        {Visibility=Private}
        Property Integer Private_pe2DBackgroundFillMode                  xtpChartFillGradient
        {Visibility=Private}
        Property Integer Private_pe2DBackgroundGradientAngle             xtpChartGradientAngle45
        {Visibility=Private}
        Property Integer Private_pe2DBackgroundHatchStyle                xtpChartHatchStyleHorizontal
        
        // Diagram2D Only
        {Visibility=Private}
        Property Boolean Private_pb2DAllowScroll                         False                    
        {Visibility=Private}
        Property Boolean Private_pb2DAllowZoom                           False 
        {Visibility=Private}
        Property Boolean Private_pb2DRotated                             False
        
        //Radar Only
        {Visibility=Private}
        Property Integer Private_piRadarStartAngle                       0
        {Visibility=Private}
        Property Integer Private_peRadarStyle                            xtpChartRadarDiagramPolygon
    End_Procedure      
    
    // set a property of the singular diagram title object
    Procedure Set TitleProperty Handle hPrivateProperty Handle hComProperty Variant vValue
        Set SigCJProperty hPrivateProperty hComProperty (Private_phoDiagramTitle(Self)) to vValue
    End_Procedure
    
    // set a property of the font object of the diagram title object
    Procedure Set TitleFontProperty Handle hPrivateProperty Handle hComProperty Variant vValue
        Set SigCJProperty hPrivateProperty hComProperty (Private_phoDiagramFont(Self)) to vValue
    End_Procedure
    
    // The following will not have effect unless 2Ddiagram is also the selected diagram type.
    // set a property of the 2Ddiagram object
    Procedure Set DiagramProperty Handle hPrivateProperty Handle hComProperty Variant vValue
        Set SigCJProperty hPrivateProperty hComProperty (Private_phoDiagram(Self)) to vValue
    End_Procedure
    
    // set a property of the 2Ddiagram background fillstyle object
    Procedure Set DiagramFillStyleProperty Handle hPrivateProperty Handle hComProperty Variant vValue
        Set SigCJProperty hPrivateProperty hComProperty (Private_pho2DBackgroundFillstyle(Self)) to vValue
    End_Procedure 
    
