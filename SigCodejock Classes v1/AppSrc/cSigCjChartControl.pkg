    {Visibility=Public MethodType=Property InitialValue=""}
    Procedure Set psName String sName
        Set StripProperty (RefProcSet(Private_psName)) (RefProcSet(ComName)) to sName
    End_Procedure

    Function psName Returns String
        Function_Return (Private_psName(Self))
    End_Function
    
    {Visibility=Public MethodType=Property InitialValue=True}
    Procedure Set pbVisible Boolean bVisible
        Set StripProperty (RefProcSet(Private_pbVisible)) (RefProcSet(ComVisible)) to bVisible
    End_Procedure

    Function pbVisible Returns Boolean
        Function_Return (Private_pbVisible(Self))
    End_Function
    
// Fillstyle Properties

    {MethodType=Property PropertyType=Property InitialValue=xtpChartFillGradient}
    {EnumList= "xtpChartFillEmpty, xtpChartFillSolid, xtpChartFillGradient, xtpChartFillHatch"}
    Procedure Set peFillMode Integer iMode
        Set FillStyleProperty (RefProcSet(Private_peFillMode)) (RefProcSet(ComFillMode)) to iMode
    End_Procedure
    
    Function peFillMode Returns Integer
