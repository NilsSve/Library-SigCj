//---------------------------------Properties----------------------------------------------

    
    {Visibility=Public MethodType=Property InitialValue=xtpChartAxisX Category='.'}
    {EnumList="xtpChartAxisX,xtpChartAxisY,xtpChartSecondaryAxisX,xtpChartSecondaryAxisY"}    
    Procedure Set peWhichAxis Integer iAxis
        Set Private_peAxis to iAxis
    End_Procedure

    Function peWhichAxis Returns Integer
        Function_Return (Private_peAxis(Self))
    End_Function
    
    // Returns the variant of the appropriate com axis object depending on the specified Axis (AxisX by default) 
    Function AxisComObject Handle hoDiagram Returns Variant
        Case Begin
            Case (Private_peAxis(Self)=xtpChartAxisY)
                Function_Return (ComAxisY(hoDiagram))
                Case Break
            Case (Private_peAxis(Self)=xtpChartSecondaryAxisX)
                Function_Return (ComSecondaryAxisX(hoDiagram))
                Case Break
            Case (Private_peAxis(Self)=xtpChartSecondaryAxisY)
                Function_Return (ComSecondaryAxisY(hoDiagram))
                Case Break
            Case Else
                Function_Return (ComAxisX(hoDiagram))                                
        Case End
    End_Function
    
