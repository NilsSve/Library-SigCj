        {Visibility=Private}
        Property Real    Private_prAxisRangeViewMinValue              0
        {Visibility=Private}
        Property Real    Private_prAxisRangeZoomLimit                 0                                                      
        // Axis Tick Marks                     
        {Visibility=Private}
        Property Boolean Private_pbAxisTickMarksCrossAxis             False
        {Visibility=Private}
        Property Integer Private_piAxisTickMarksLength                5
        {Visibility=Private}
        Property Integer Private_piAxisTickMarksThickness             1
        {Visibility=Private}
        Property Boolean Private_pbAxisTickMarksVisible               True                        
        {Visibility=Private}
