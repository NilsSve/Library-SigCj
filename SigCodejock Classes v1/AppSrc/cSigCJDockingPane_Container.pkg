Use Dfclient.pkg
 
{ DesignerClass = cDTView }
{ OverrideProperty=Border_Style InitialValue=Border_None }
{ DDOHost=True }  // This allows you to maintain your DDO structure in the studio as well.
Class cSigCJDockingPane_Container is a dbContainer3d
 
   // Construct_Object
   Procedure Construct_Object
      Forward Send Construct_Object

      {DesignTime=False}
      Property Handle phoParentPane // will be set automatically when phoClientObject (of a pane) is set to an object instance of this class
      
      Set Location to 0 0
      Set Border_Style to Border_None
      Set peAnchors    to anAll
      Set Visible_State to False
   End_Procedure
 
   Procedure End_Construct_Object
      Forward Send End_Construct_Object
   End_Procedure
 
   Procedure Activating 
      Set location to -1000 -1000
      Forward Send Activating
   End_Procedure
End_Class

