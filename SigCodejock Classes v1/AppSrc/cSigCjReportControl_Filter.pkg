Use SigCjLicense.pkg

#IF (SigCj_Codejock_Version < 220000)
    Use cSigCjReportControl_Filter_Pre2200.pkg
#ELSE
    #Warning DFERR_COMP_WARNING_OBSOLETE_CMD "Obsolete package: cSigCjReportControl_Filter. Recode for renamed Codejock Grid Control"

    #Replace cSigCjReportControl_Filter cSigCjGridControl_Filter

    Use cSigCjGridControl_Filter.pkg
#ENDIF

