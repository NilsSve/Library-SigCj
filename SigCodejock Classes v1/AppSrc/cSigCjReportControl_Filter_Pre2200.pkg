Use Windows.pkg

Class cSigCjReportControl_Filter is a Form
    Procedure Construct_Object
        Forward Send Construct_Object

        Property Boolean pbAuto_Filter      True
        Property Handle  phoClient_Grid
        Property String  psWatermark_Text   "Filter..."

        Set TextColor to clGrayText
    End_Procedure

    Procedure End_Construct_Object
        Forward Send End_Construct_Object

        Set Value to (psWatermark_Text(Self))
    End_Procedure

    Procedure OnChange
        Handle hoClient_Grid
        String sValue
        
        If (pbAuto_Filter(Self)) Begin
            Send Update_Grid
        End
    End_Procedure

    Procedure Update_Grid
        Handle hoClient_Grid
        String sValue
        
        Get phoClient_Grid to hoClient_Grid
        
        If (hoClient_Grid <> 0) Begin
            Get Value to sValue
            If (sValue = psWatermark_Text(Self)) Move "" to sValue            
    
            If (IsComObjectCreated(hoClient_Grid)) Begin
                Send Filter_Rows of hoClient_Grid sValue
            End
        End
    End_Procedure

    Procedure OnSetFocus
        Forward Send OnSetFocus

        If (Value(Self) = psWatermark_Text(Self)) Begin
            Set Value     to ""
            Set TextColor to clWindowText
        End
    End_Procedure

    Procedure OnKillFocus
        Forward Send OnKillFocus

        If (Value(Self) = "") Begin
            Set Value     to (psWatermark_Text(Self))
            Set TextColor to clGrayText
        End
    End_Procedure

    Procedure Reset_Filter
        Set Value     to (psWatermark_Text(Self))
        Set TextColor to clGrayText
    End_Procedure
End_Class

//==============================================================================
//End of Package - cSigCjReportControl_Filter.pkg
