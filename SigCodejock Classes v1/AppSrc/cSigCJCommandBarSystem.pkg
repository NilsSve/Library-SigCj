Use cCJStandardCommandBarSystem.pkg
Use cSigCJMethods_Mixin.pkg
Use cSigCJGlobalSettings.pkg
Use cSigCJTabWorkspace.pkg
Use cSigCJMessageBar.pkg 
Use cSigCJMenuItem.pkg

Class cSigCJCommandBarSystem is a cCJCommandBarSystem
    Import_Class_Protocol cSigCJMethods_Mixin
    
    Procedure Construct_Object
        Forward Send Construct_Object
        {Category="Appearance"}
        Property Boolean pbTabWorkspace True
        {Category="Behavior"}
        Property Boolean pbRecalcLayout True

        {Category="SigCj"}
        Property String psPX_Tag "Main Menu"    //default for main menu bar

        {Visibility=Private}
        Property Handle phoMessageBar       (Create(Self, U_cSigCJMessageBar))
        {Visibility=Private}
        Property Handle phoTabWorkspace     (Create(Self, U_cSigCJTabWorkspace))
        {Visibility=Private} 
        Property Handle phoTabPaintManager  (Create(Self, U_cCJTabPaintManager))
    End_Procedure

    Procedure Deactivating Returns Integer
        Integer iRetVal
        
        Forward Get msg_Deactivating to iRetVal

        Send Save_Custom_Bars

        Procedure_Return iRetVal
    End_Procedure

    Procedure Load_Custom_Bars
        Send ComLoadCommandBars (SigCj_RegKey(Self)) "SigCJCommandBarsControl" (psPX_Tag(Self))
    End_Procedure

    Procedure Save_Custom_Bars
        Send ComSaveCommandBars (SigCj_RegKey(Self)) "SigCJCommandBarsControl" (psPX_Tag(Self))
    End_Procedure

    Procedure OnCreateCommandBars
        Forward Send OnCreateCommandBars
        Set ComVisualTheme to xtpThemeOffice2003 
        Send Initialise_Tab_Control
        Send Initialise_MessageBar     
    End_Procedure

    Procedure OnComCustomizationAddToolBar Variant llToolBar
        Handle hoCommandBar hoBars
        Variant vCommandBar
        Integer iLoop iCount iBarID iLastBarID            
        
        Get Create U_cCJCommandBar  to hoCommandBar
            Get ComCount of ghoCommandBars to iCount
            For iLoop from 1 to iCount
                Get ComItem of ghoCommandBars iLoop to vCommandBar
                Set pvComObject of hoCommandBar to vCommandBar
                Get ComBarID of hoCommandBar to iBarID
                If ((iBarID > iLastBarID) and (iBarID < 10000)) Move iBarID to iLastBarID
            Loop
    
            If (iLastBarID < 6000) Move 6000 to iLastBarID
            Increment iLastBarID
    
            Set pvComObject of hoCommandBar to llToolBar
            Set ComBarID of hoCommandBar to iLastBarID
        Send Destroy of hoCommandBar
    End_Procedure

    {Visibility=Private}
    Procedure ShowTabWorkspace Boolean bShow
        Variant vTabWorkspace
        Handle  hoTabWorkspace
        
        If (IsComObjectCreated(Self)) Begin
            Get ComShowTabWorkspace bShow to vTabWorkspace
            Get phoTabWorkspace to hoTabWorkspace 
            If (hoTabWorkspace<>0) Begin
                Set pvComObject of hoTabWorkspace to vTabWorkspace
                If (IsComObjectCreated(hoTabWorkspace)) Begin
                    Set pvComObject of (phoTabPaintManager(Self)) to (ComPaintManager(hoTabWorkspace))
                    Send OnTabWorkspaceCreated hoTabWorkspace 
                    If (pbRecalcLayout(Self)) Begin
                        Send ComRecalcLayout 
                    End
                    Send OnSetTabPaintManagerProperties (phoTabPaintManager(Self)) 
                End
            End
        End
    End_Procedure
    
    Procedure Initialise_MessageBar 
        Handle hoMessageBar 
        Variant vMessageBar 

        Get phoMessageBar to hoMessageBar

        Get ComMessageBar to vMessageBar
        Set pvComObject   of hoMessageBar to vMessageBar
        Set pbCloseButton of hoMessageBar to True 
    End_Procedure
    
    Procedure Initialise_Tab_Control
        Boolean bTabWorkspace
        
        If (IsComObjectCreated(Self)) Begin
            Get pbTabWorkspace to bTabWorkspace    
            Send ShowTabWorkspace bTabWorkspace    
        End
    End_Procedure
  
    { MethodType=Method }
    Procedure ShowMessageBar String sMessage String sMessageTitle String sImage
        If (num_arguments=3) Begin
            Send DoShowMessageBar of (phoMessageBar(Self)) sMessage sMessageTitle sImage
        End
        Else Begin
            Send DoShowMessageBar of (phoMessageBar(Self)) sMessage sMessageTitle    
        End
        Set pbVisible of (phoMessageBar(Self)) to True
    End_Procedure
   
    { MethodType=Method }
    Procedure HideMessageBar
        Set pbVisible of (phoMessageBar(Self)) to False
    End_Procedure

    {MethodType=Event}
    Procedure OnNewWorkspaceTabItem Variant vTabItem
    End_Procedure
   
    {MethodType=Event}
    Procedure OnTabWorkspaceCreated Handle hoTabWorkspace
        // defaults but can be overwritten in the object if preferred.
        Set ComThemedBackColor of hoTabWorkspace to False
        Set ComFlags           of hoTabWorkspace to xtpWorkspaceShowCloseTab
    End_Procedure 
    
    {MethodType=Event}
    Procedure OnSetTabPaintManagerProperties Handle hoTabPaintManager
    End_Procedure
    
    
