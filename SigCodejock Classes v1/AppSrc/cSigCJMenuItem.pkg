Use cCJCommandBarSystem.pkg
Use cSigCJMethods_Mixin.pkg

{ OverrideProperty=Delegation_Mode           DesignTime=False }
{ OverrideProperty=peAutoCreate              DesignTime=False }
{ OverrideProperty=peNeighborhood            DesignTime=False }
{ OverrideProperty=psLicenseKey              DesignTime=False }
{ OverrideProperty=psProgID                  DesignTime=False }
Class cSigCJMenuItem is a cCJMenuItem
    Import_Class_Protocol cSigCJMethods_Mixin
    
    Procedure Construct_Object
        Forward Send Construct_Object

        Property String psMessage
        Property Handle phDestination Self 
        Property String psAuxillery     ""      //Any arguments to go with the message when it is fired?
    End_Procedure

    Procedure End_Construct_Object
        Forward Send End_Construct_Object

        // Add your code that needs to be executed at the end of the object construction here:
    End_Procedure

    // AR/PA
    // Following procedure and Function are replicated from the cSigCJContextMenu package
    // to allow for the implementation of context menu sub menus.  Without this, you are unable
    // to generate sub menus on the context menu.
    // These methods really should be in a mixin to be incorporated into both classes.
    { DesignTime=False }
    Procedure Add_MenuItem String sCaption String sMessage Boolean bBeginGroup_Optional String sImage_Optional
        Handle     hoMenuItem
        String  sImage
        Boolean bBeginGroup
        
        Move False to bBeginGroup
        If (num_arguments >= 3) ;
            Move bBeginGroup_Optional to bBeginGroup
            
        Move "" to sImage
        If (num_arguments >= 4) ;
            Move sImage_Optional to sImage            

        Get phAdd_MenuItem sCaption sMessage bBeginGroup sImage to hoMenuItem
    End_Procedure

    { DesignTime=False }
    Function phAdd_MenuItem String sCaption String sMessage Boolean bBeginGroup String sImage Returns Handle 
        Integer    iArraySize
        Handle     hoMenuItem
        String[][] saMenuItem
        
        Get psaMenuItem to saMenuItem
        Move (SizeOfArray(saMenuItem)) to iArraySize

        Get Create U_cSigCJMenuItem to hoMenuItem
        If (Trim(sImage)   <> "") Set psImage   of hoMenuItem to (Trim(sImage))
        If (Trim(sCaption) <> "") Set psCaption of hoMenuItem to (Trim(sCaption))
        If (Trim(sMessage) <> "") Set psMessage of hoMenuItem to (Trim(sMessage))
        If (bBeginGroup)          Set pbControlBeginGroup of hoMenuItem to True
        
        Move (Trim(sCaption)) to saMenuItem[iArraySize][0]
        Move hoMenuItem       to saMenuItem[iArraySize][1]
        
        Set psaMenuItem to saMenuItem
        Function_Return hoMenuItem 
    End_Function    //-- pAdd_MenuItem

    Procedure OnExecute Variant vCommandBarControl
        Handle  hoDestination
        Integer iMessage
        
        Move (eval("msg_" + psMessage(Self) )) to iMessage     
        Get phDestination to hoDestination
        If (Object_Id(hoDestination) and iMessage) ;
            Send iMessage of hoDestination (psAuxillery(Self))
    End_Procedure
End_Class

