    Procedure Set peCommonButtons Integer iButtons        
        Set SigCJProperty Set_Private.peCommonButtons Set_ComCommonButtons to iButtons
    End_Procedure 
    
    { MethodType=Property Visibility=Private }
    Function peCommonButtons Returns Integer
        Function_Return (Private.peCommonButtons(Self))
    End_Function

    { MethodType=Property Category="CodeJock" }
    { PropertyType=Boolean InitialValue=False }
    Procedure Set pbShowButtonOk Boolean bState
        Set Private.pbOKButton to bState
        Send SetCommonButtons
    End_Procedure
    
    Function pbShowButtonOk Returns Boolean
        Function_Return (Private.pbOKButton(Self))
    End_Function

    { MethodType=Property Category="CodeJock" }
