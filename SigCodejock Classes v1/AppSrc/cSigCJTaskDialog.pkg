Use SigCjW_Controls.pkg
Use cSigCJMethods_Mixin.pkg
Use cSigCJGlobalSettings.pkg

Define eBtn_OK                  for OLExtpTaskButtonOk
Define eBtn_Yes                 for OLExtpTaskButtonYes
Define eBtn_No                  for OLExtpTaskButtonNo
Define eBtn_Cancel              for OLExtpTaskButtonCancel
Define eBtn_Retry               for OLExtpTaskButtonRetry
Define eBtn_Close               for OLExtpTaskButtonClose 

Define eTaskIcon_None           for OLExtpTaskIconNone        
Define eTaskIconWarning         for OLExtpTaskIconWarning     
Define eTaskIconError           for OLExtpTaskIconError       
Define eTaskIconInfo            for OLExtpTaskIconInformation 
Define eTaskIconShield          for OLExtpTaskIconShield      
Define eTaskIconCustom          for OLExtpTaskIconCustom      

Define eTaskProgressBar_None    for OLExtpTaskProgressBarNone   
Define eTaskProgressBar_Normal  for OLExtpTaskProgressBarNormal 
Define eTaskProgressBar_Marquee for OLExtpTaskProgressBarMarquee

Define CLF for (character(13)+ character(10)) 


{DocStart = Class}
//---------------------------------------------------
//
// Class        : cSigCJTaskDialog
//
// Superclass   : cSigCjComTaskDialog 
//
// Package      : cSigCJTaskDialog.pkg
//
// Mixins       : 
//
// Description  : The TaskDialog Control creates, displays, and operates a task dialog. A task dialog is similar to, 
//                While much more flexible than, a basic message box. The task dialog contains application-defined messages, 
//                title, verification check box, command links and push buttons, plus any combination of predefined icons 
//                and push buttons.
//
// Properties   : pbShowWindowsExitButton       (boolean)
//                psCollapsedControlText        (string)
//                pbShowButtonOk                (boolean)
//                pbShowButtonYes               (boolean)
//                pbShowButtonNo                (boolean)
//                pbShowButtonCancel            (boolean)
//                pbShowButtonRetry             (boolean)
//                pbShowButtonClose             (boolean)
//                psContentText                 (string)
//                piDefaultButton               (integer) 
//                piDefaultRadioOption          (integer)
//                piWidth                       (integer)
//                pbEnableCallbackTimer         (boolean)                
//                pbEnableCommandLinks          (boolean)
//                pbEnableHyperLinks            (boolean)
//                psExpandedControlText         (string)
//                psExpandedInformationText     (string)
//                pbExpandFooterArea            (boolean)
//                piFooterIcon                  (integer)
//                psFooterIconImage             (string)
//                psFooterText                  (string)
//                piMainIcon                    (integer)
//                psMainIconImage               (string)
//                psMainInstructionText         (string)
//                pbMessageBoxStyle             (boolean)
//                phParentHwnd                  (handle)
//                piProgressBarPos              (integer)
//                peProgressBarStyle            (integer)
//                pbRelativePosition            (boolean)
//                pbRtLLayout                   (boolean)
//                pbShowCommandLinkIcons        (boolean)
//                pbUseComCtl32                 (boolean)
//                psVerificationText            (string)
//                pbVerifyCheckState            (boolean)
//                psTitle                       (string)  
//
// Events       : OnButtonClicked
//                OnHyperlinkClicked
//                OnRadioSelected
//                OnVerificationClicked
//                OnExpandButtonClicked
//                OnTimer  
//                OnConstructed
//                OnCreate
//
// Methods      : ShowDialog
//                Set TaskDialogOptionButton
//                Set TaskDialogOptionRadio
//                Set pbButtonEnabledState
//                Set pbRadioOptionEnabledState
//                Reset
//                Set ProgressBarRange
//                StartProgressBarMarquee
//
// Notes        :
//
// To Do        : 
//                                
//---------------------------------------------------
{DocEnd} 

{ OverrideProperty=psLicenseKey  DesignTime=False }
{ OverrideProperty=psProgID      DesignTime=False }
Class cSigCJTaskDialog is a cSigCjComTaskDialog
    Import_Class_Protocol cSigCJMethods_Mixin
        
    Procedure Construct_Object
        Forward Send Construct_Object
        // Define new Properties:
        
        On_Key Key_Escape Send Close_panel
        
        { DesignTime=False Visibility=Private }
        Property Boolean Private.pbShowWindowsExitButton    True
        { DesignTime=False Visibility=Private }
        Property String  Private.psCollapsedControlText     "Details"
        { DesignTime=False Visibility=Private }
        Property Integer Private.peCommonButtons            0
        { DesignTime=False Visibility=Private }
        Property Boolean Private.pbOKButton                 False
        { DesignTime=False Visibility=Private }
        Property Boolean Private.pbYesButton                False
        { DesignTime=False Visibility=Private }
        Property Boolean Private.pbNoButton                 False
        { DesignTime=False Visibility=Private }
        Property Boolean Private.pbCancelButton             False
        { DesignTime=False Visibility=Private }
        Property Boolean Private.pbRetryButton              False
        { DesignTime=False Visibility=Private }
        Property Boolean Private.pbCloseButton              False
        { DesignTime=False Visibility=Private }
        Property String  Private.psContentText              ""
        { DesignTime=False Visibility=Private }
        Property Integer Private.piDefaultButton            0
        { DesignTime=False Visibility=Private }
        Property Integer Private.piDefaultRadioOption       0
        { DesignTime=False Visibility=Private }
        Property Integer Private.piWidth                    0
        { DesignTime=False Visibility=Private }
        Property Boolean Private.pbEnableCallbackTimer      False
        { DesignTime=False Visibility=Private }
        Property Boolean Private.pbEnableCommandLinks       False
        { DesignTime=False Visibility=Private }
        Property Boolean Private.pbEnableHyperLinks         True
        { DesignTime=False Visibility=Private }
        Property Boolean Private.pbExpandInfoTextByDefault  True
        { DesignTime=False Visibility=Private }
        Property String  Private.psExpandedControlText      "Hide Details"
        { DesignTime=False Visibility=Private }
        Property String  Private.psExpandedInformationText  ""
        { DesignTime=False Visibility=Private }
        Property Boolean Private.pbExpandFooterArea         False
        { DesignTime=False Visibility=Private }
        Property Integer Private.piFooterIcon               eTaskIcon_None 
        { DesignTime=False Visibility=Private }
        Property Integer Private.piFooterIconHandle         0
        { DesignTime=False Visibility=Private }
        Property String  Private.psFooterText               ""
        { DesignTime=False Visibility=Private }
        Property Integer Private.piMainIcon                 eTaskIcon_None
        { DesignTime=False Visibility=Private }
        Property Integer Private.piMainIconHandle           0
        { DesignTime=False Visibility=Private }
        Property String  Private.psMainInstructionText      ""
        { DesignTime=False Visibility=Private }
        Property Boolean Private.pbMessageBoxStyle          True
        { DesignTime=False Visibility=Private }
        Property Handle  Private.phParentHwnd               0
        { DesignTime=False Visibility=Private }
        Property Integer Private.piProgressBarPos           0
        { DesignTime=False Visibility=Private }
        Property Integer Private.peProgressBarStyle         eTaskProgressBar_None
        { DesignTime=False Visibility=Private }
        Property Boolean Private.pbRelativePosition         False
        { DesignTime=False Visibility=Private }
        Property Boolean Private.pbRtLLayout                False
        { DesignTime=False Visibility=Private }
        Property Boolean Private.pbShowCommandLinkIcons     True
        { DesignTime=False Visibility=Private }
        Property Boolean Private.pbUseComCtl32              False 
        // Warning setting this to true on a vista or 2008 server will stop the modal state
        { DesignTime=False Visibility=Private }
        Property String  Private.psVerificationText         ""
        { DesignTime=False Visibility=Private }
        Property Boolean Private.pbVerifyCheckState         False
        { DesignTime=False Visibility=Private }
        Property String  Private.psTitle                    ""
        { DesignTime=False Visibility=Private }
        Property String  Private.psMainIconImage            ""
        { DesignTime=False Visibility=Private }
        Property String  Private.psFooterIconImage          ""
        { DesignTime=False Visibility=Private }
        Property Integer piProcessCounter              
    End_Procedure
    
    Procedure End_Construct_Object
        Set location to -100 -100
        Forward Send End_Construct_Object
    End_Procedure
    
//    { MethodType=Method Visibility=Private }
//    Procedure SetTaskDialogProperty Handle hmPrivateProperty Handle hmCOMProperty Variant vValue
//        Set hmPrivateProperty to vValue
//        If (IsComObjectCreated(Self)) Begin
//            Set hmCOMProperty to vValue
//        End
//    End_Procedure
    
    { MethodType=Property Category="CodeJock" }
    { PropertyType=Image }
    Procedure Set psMainIconImage String sImage
        Integer iImageID
        Handle hWnd
        
        Get AddImage of ghoSigCjGlobalSetting sImage 0 0 to iImageID
        Get ImageHwndFromId of ghoSigCjGlobalSetting iImageID to hWnd    
        Set piMainIconHandle to hWnd
        Set Private.psMainIconImage to sImage
    End_Procedure

    { MethodType=Property Category="CodeJock" }
    { PropertyType=Image }
    Function psMainIconImage Returns String
        Function_Return (Private.psMainIconImage(Self))
    End_Function
    
    { MethodType=Property Category="CodeJock" }
    { PropertyType=Image }
    Procedure Set psFooterIconImage String sImage
        Integer iImageID
        Handle hWnd
        
        Get AddImage of ghoSigCjGlobalSetting sImage 0 0 to iImageID
        Get ImageHwndFromId of ghoSigCjGlobalSetting iImageID to hWnd    
        Set piFooterIconHandle to hWnd
        Set Private.psFooterIconImage to sImage
    End_Procedure     

    { MethodType=Property Category="CodeJock" }
    { PropertyType=Image }
    Function psFooterIconImage Returns String
        Function_Return (Private.psFooterIconImage(Self))
    End_Function
    
    { MethodType=Property Category="CodeJock" }
    { PropertyType=Boolean InitialValue=True }
    Procedure Set pbShowWindowsExitButton Boolean bState
        Set SigCJProperty Set_Private.pbShowWindowsExitButton Set_ComAllowCancellation to bState
    End_Procedure
    
    { MethodType=Property Category="CodeJock" }
    Function pbShowWindowsExitButton Returns Boolean
        Function_Return (Private.pbShowWindowsExitButton(Self))
    End_Function

    { MethodType=Property Category="CodeJock" }
    { InitialValue="Details" }
    Procedure Set psCollapsedControlText String sText
        Set SigCJProperty Set_Private.psCollapsedControlText Set_ComCollapsedControlText to sText
    End_Procedure  
    
    { MethodType=Property Category="CodeJock" }
    Function psCollapsedControlText Returns String
        Function_Return (Private.psCollapsedControlText(Self))
    End_Function
    
