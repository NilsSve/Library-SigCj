        Set Private.pbYesButton to bState
        Send SetCommonButtons
    End_Procedure
    
    { MethodType=Property Category="CodeJock" }
    Function pbShowButtonYes Returns Boolean
        Function_Return (Private.pbYesButton(Self))
    End_Function
    
    { MethodType=Property Category="CodeJock" }
    { PropertyType=Boolean InitialValue=False }
    Procedure Set pbShowButtonNo Boolean bState
        Set Private.pbNoButton to bState
        Send SetCommonButtons
    End_Procedure
    
    { MethodType=Property Category="CodeJock" }
    Function pbShowButtonNo Returns Boolean
        Function_Return (Private.pbNoButton(Self))
    End_Function
    
    { MethodType=Property Category="CodeJock" }
    { PropertyType=Boolean InitialValue=False }
    Procedure Set pbShowButtonCancel Boolean bState
        Set Private.pbCancelButton to bState
        Send SetCommonButtons
    End_Procedure
    
    { MethodType=Property Category="CodeJock" }
    Function pbShowButtonCancel Returns Boolean
        Function_Return (Private.pbCancelButton(Self))
    End_Function
    
    { MethodType=Property Category="CodeJock" }
    { PropertyType=Boolean InitialValue=False }
    Procedure Set pbShowButtonRetry Boolean bState
        Set Private.pbRetryButton to bState
        Send SetCommonButtons
    End_Procedure
    
    { MethodType=Property Category="CodeJock" }
    Function pbShowButtonRetry Returns Boolean
        Function_Return (Private.pbRetryButton(Self))
    End_Function
    
    { MethodType=Property Category="CodeJock" }
    { PropertyType=Boolean InitialValue=False }
    Procedure Set pbShowButtonClose Boolean bState
        Set Private.pbCloseButton to bState
        Send SetCommonButtons
    End_Procedure
    
    { MethodType=Property Category="CodeJock" }
    Function pbShowButtonClose Returns Boolean
        Function_Return (Private.pbCloseButton(Self))
    End_Function
        
    { MethodType=Method Visibility=Private }
    Procedure SetCommonButtons
        Set peCommonButtons to (If(pbShowButtonOk(Self),eBtn_OK,0)         ;
                              + If(pbShowButtonYes(Self),eBtn_Yes,0)       ;
                              + If(pbShowButtonNo(Self),eBtn_No,0)         ;
                              + If(pbShowButtonCancel(Self),eBtn_Cancel,0) ;
                              + If(pbShowButtonRetry(Self),eBtn_Retry,0)   ;
                              + If(pbShowButtonClose(Self),eBtn_Close,0))
    End_Procedure
    
    { MethodType=Property Category="CodeJock" }
    Procedure Set psContentText String sText
        Set SigCJProperty Set_Private.psContentText Set_ComContentText to sText
    End_Procedure  
    
    { MethodType=Property Category="CodeJock" }
    Function psContentText Returns String
        Function_Return (Private.psContentText(Self))
    End_Function
    
    { MethodType=Property Category="CodeJock" }
    //{ EnumList="eBtn_OK, eBtn_Yes, eBtn_No, eBtn_Cancel, eBtn_Retry, eBtn_Close" }
    Procedure Set piDefaultButton Integer iButton
        Set SigCJProperty Set_Private.piDefaultButton Set_ComDefaultButton to iButton
    End_Procedure
    
    { MethodType=Property Category="CodeJock" }
    Function piDefaultButton Returns Integer
        Function_Return (Private.piDefaultButton(Self))
    End_Function

