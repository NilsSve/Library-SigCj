    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : ShowDialog
    //
    // Scope        : Public Method
    //
    // Paramaters   : None
    //
    // Returns      : Integer
    //
    // Purpose      : Displays the task dialog and return the selected button (id) when done 
    //                
    //                
    // Notes        :  
    //                          
    //---------------------------------------------------
    {DocEnd}
    { MethodType=Method Visibility=Public}
