        Function_Return (ComShowDialog(Self))
    End_Function
    
    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : Set TaskDialogOptionButton
    //
    // Scope        : Public Method
    //
    // Paramaters   : sButtonText (string), iButtonID (integer)
    //
    // Returns      : 
    //
    // Purpose      : Adds a user defined button to the task dialog's command area.
    //                Example: Set TaskDialogOptionButton "Run"       to 100
    //                         Set TaskDialogOptionButton "Don't Run" to 101
    //                
    // Notes        : The iButtonID indicates the value to be returned when this button is selected and the 
    //                OnButtonClicked Event fires
    //                          
    //---------------------------------------------------
    {DocEnd}    
    { MethodType=Method Visibility=Public}
    Procedure Set TaskDialogOptionButton String sButtonText Integer iButtonID
        Boolean bIsCreated
        
        Get IsComObjectCreated to bIsCreated
        If (bIsCreated) Begin
            Send ComAddButton sButtonText iButtonID
        End
    End_Procedure

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : Set TaskDialogOptionRadio
    //
    // Scope        : Public Method
    //
    // Paramaters   : sRadioText (string), iButtonID (integer)
    //
    // Returns      : 
    //
    // Purpose      : Adds a user defined button to the task dialog's command area.
    //                Example: Set TaskDialogOptionRadio "Allow"       to 100
    //                         Set TaskDialogOptionRadio "Don't Allow" to 101
    //                
    // Notes        : The iButtonID indicates the value to be returned when this button is selected and the 
    //                OnRadioSelected Event fires
    //                          
    //---------------------------------------------------
    {DocEnd}    
    { MethodType=Method Visibility=Public}
    Procedure Set TaskDialogOptionRadio String sRadioText Integer iButtonID
        Boolean bIsCreated
        
        Get IsComObjectCreated to bIsCreated
        If (bIsCreated) Begin
            Send ComAddRadioButton sRadioText iButtonID
        End        
    End_Procedure    

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : Set pbButtonEnabledState
    //
    // Scope        : Public Method
    //
    // Paramaters   : Integer iButtonID Boolean bState
    //
    // Returns      : 
    //
    // Purpose      : Sets the enabled_state for the specified button
    //                
    // Notes        : 
    //                          
    //---------------------------------------------------
    {DocEnd}     
    { MethodType=Method Visibility=Public}
    Procedure Set pbButtonEnabledState Integer iButtonID Boolean bState
        Boolean bIsCreated
        
        Get IsComObjectCreated to bIsCreated
        If (bIsCreated) Begin
            Send ComEnableButton iButtonID bState
        End 
    End_Procedure

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : Set pbRadioOptionEnabledState
    //
    // Scope        : Public Method
    //
    // Paramaters   : Integer iRadioID Boolean bState
    //
    // Returns      : 
    //
    // Purpose      : Sets the enabled_state for the specified radio option
    //                
    // Notes        : 
    //                          
    //---------------------------------------------------
    {DocEnd} 
    { MethodType=Method Visibility=Public}
    Procedure Set pbRadioOptionEnabledState Integer iRadioID Boolean bState
        Boolean bIsCreated
        
        Get IsComObjectCreated to bIsCreated
        If (bIsCreated) Begin
            Send ComEnableRadioButton iRadioID bState
        End 
    End_Procedure   

    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : ClickButton
    //
    // Scope        : Public Method
    //
    // Paramaters   : Integer iButtonID
    //
    // Returns      : 
    //
    // Purpose      : Simulate the action of a button click in the task dialog
    //                
    // Notes        : 
    //                          
    //---------------------------------------------------
    {DocEnd} 
    { MethodType=Method Visibility=Public}    
    Procedure ClickButton Integer iButtonID
        Boolean bIsCreated
        
        Get IsComObjectCreated to bIsCreated
        If (bIsCreated) Begin
            Send ComClickButton iButtonID
        End 
    End_Procedure
    
    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : Reset
    //
    // Scope        : Public Method
    //
    // Paramaters   : 
    //
    // Returns      : 
    //
    // Purpose      : Resets the configuration attributes for the task dialog to the default state
    //                
    // Notes        : 
    //                          
    //---------------------------------------------------
    {DocEnd} 
    { MethodType=Method Visibility=Public}    
    Procedure Reset
        Boolean bIsCreated
        
        Set pbShowButtonOk     to False
        Set pbShowButtonYes    to False
        Set pbShowButtonNo     to False
        Set pbShowButtonCancel to False
        Set pbShowButtonRetry  to False
        Set pbShowButtonClose  to False
        Set pbUseComCtl32      to False
        
        Get IsComObjectCreated to bIsCreated
        If (bIsCreated) Begin
            Send ComReset
        End 
    End_Procedure
    
    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : ProgressBarRange
    //
    // Scope        : Public Method
    //
    // Paramaters   : Integer iMin Integer iMax
    //
    // Returns      : 
    //
    // Purpose      : Sets the minimum and maximum values for the progress bar
    //                
    // Notes        : By default the min is zero and the max is 100
    //                          
    //---------------------------------------------------
    {DocEnd} 
    Procedure Set ProgressBarRange Integer iMin Integer iMax
        Boolean bIsCreated
        
        Get IsComObjectCreated to bIsCreated
        If (bIsCreated) Begin
            Send ComSetProgressBarRange iMin iMax
        End 
    End_Procedure
    
    {DocStart = Method}
    //---------------------------------------------------
    //
    // Procedure    : StartProgressBarMarquee
    //
    // Scope        : Public Method
    //
    // Paramaters   : Boolean bStart Integer imilliseconds
    //
    // Returns      : 
    //
    // Purpose      : Specifies whether the progress bar should be displayed in marquee mode or not with the ability to 
    //                determine marquee speed as well
    //                
    // Notes        : peProgressBarStyle must first be set to eTaskProgressBar_Marquee and StartProgressBarMarquee 
    //                must be called in the OnConstructed event before it can be turned on or off.  
    //                After StartProgressBarMarquee is called in the OnConstructed event you can freely Use StartProgressBarMarquee 
    //                anytime to start and stop the marquee.
    //                          
    //---------------------------------------------------
    {DocEnd} 
    Procedure StartProgressBarMarquee Boolean bStart Integer imilliseconds
        Boolean bIsCreated
        
        Get IsComObjectCreated to bIsCreated
        If (bIsCreated) Begin
            Send ComStartProgressBarMarquee bStart imilliseconds
        End 
    End_Procedure

    {MethodType=Event}
    Procedure OnCreate
        //Apply settings...
        Set pbShowWindowsExitButton   to (Private.pbShowWindowsExitButton(Self))   
        Set psCollapsedControlText    to (Private.psCollapsedControlText(Self))   
        Set peCommonButtons           to (Private.peCommonButtons(Self))    
        Set psContentText             to (Private.psContentText(Self))  
        Set piDefaultButton           to (Private.piDefaultButton(Self))   
        Set piDefaultRadioOption      to (Private.piDefaultRadioOption(Self))   
        Set piWidth                   to (Private.piWidth(Self))   
        Set pbEnableCallbackTimer     to (Private.pbEnableCallbackTimer(Self))   
        Set pbEnableCommandLinks      to (Private.pbEnableCommandLinks(Self))   
        Set pbEnableHyperLinks        to (Private.pbEnableHyperLinks(Self))   
        Set psExpandedControlText     to (Private.psExpandedControlText(Self))   
        Set psExpandedInformationText to (Private.psExpandedInformationText(Self))   
        Set pbExpandFooterArea        to (Private.pbExpandFooterArea(Self))   
        Set piFooterIcon              to (Private.piFooterIcon(Self))   
        Set piFooterIconHandle        to (Private.piFooterIconHandle(Self))   
        Set psFooterText              to (Private.psFooterText(Self))   
        Set piMainIcon                to (Private.piMainIcon(Self))   
        Set piMainIconHandle          to (Private.piMainIconHandle(Self))   
        Set psMainInstructionText     to (Private.psMainInstructionText(Self))   
        Set pbMessageBoxStyle         to (Private.pbMessageBoxStyle(Self))   
        Set phParentHwnd              to (Private.phParentHwnd(Self))   
        Set piProgressBarPos          to (Private.piProgressBarPos(Self))   
        Set peProgressBarStyle        to (Private.peProgressBarStyle(Self))   
        Set pbRelativePosition        to (Private.pbRelativePosition(Self))   
        Set pbRtLLayout               to (Private.pbRtLLayout(Self))   
        Set pbShowCommandLinkIcons    to (Private.pbShowCommandLinkIcons(Self))   
        Set pbUseComCtl32             to (Private.pbUseComCtl32(Self))   
        Set psVerificationText        to (Private.psVerificationText(Self))   
        Set pbVerifyCheckState        to (Private.pbVerifyCheckState(Self))   
        Set psTitle                   to (Private.psTitle(Self)) 
    End_Procedure        
    
    {DocStart = Method}
