    // Procedure    : OnConstructed
    //
    // Scope        : Public Event
    //
    // Paramaters   : 
    //
    // Returns      : 
    //
    // Purpose      : Occurs once the task dialog has been created and before it is displayed.
    //                
    // Notes        : 
    //                          
    //---------------------------------------------------
    {DocEnd} 
    {MethodType=Event Visibility=Public}
    Procedure OnConstructed
    End_Procedure
        
    { MethodType=Event Visibility=Private}
    Procedure OnComButtonClicked Integer llId Variant llCloseDialog
        Send OnButtonClicked llId (&llCloseDialog)
    End_Procedure

    { MethodType=Event Visibility=Private}
    Procedure OnComHyperlinkClicked String llURL
        Send OnHyperlinkClicked llURL
    End_Procedure

    { MethodType=Event Visibility=Private}
    Procedure OnComRadioButtonClicked Integer llId
        Send OnRadioSelected llId
    End_Procedure

    { MethodType=Event Visibility=Private}
    Procedure OnComVerificationClicked Boolean llChecked
        Send OnVerificationClicked llChecked
    End_Procedure

    { MethodType=Event Visibility=Private}
    Procedure OnComExpandButtonClicked Boolean llExpanded
        Send OnExpandButtonClicked llExpanded
    End_Procedure

    { MethodType=Event Visibility=Private}
    Procedure OnComTimer Integer llMilliSeconds Variant llReset
        Send OnTimer llMilliSeconds (&llReset)
    End_Procedure

    { MethodType=Event Visibility=Private}
    Procedure OnComConstructed
        Send OnConstructed
    End_Procedure
   
    // Standard User interface functions 
    Function Initialise Returns Handle
    	Handle hoDialog 

        Get Object_Id to hoDialog
        Send Reset of hoDialog
        Set piProcessCounter to 0
        // This must always be set to false
        Set pbUseComCtl32 of hoDialog to False
        Set Modal_State to True 
        Set phParentHwnd to (Window_Handle(Client_Id(Self)))   
        Function_Return hoDialog
    End_Function
        
    Procedure Base_Box Handle hoDialog String sMessage String sTitle 
        Set pbShowWindowsExitButton	of hoDialog to True 
        Set psTitle                 of hoDialog to sTitle
        Set piMainIcon              of hoDialog to eTaskIconCustom 
        Set psMainInstructionText   of hoDialog to sMessage
    End_Procedure

    Procedure sigCJInfo_Box String sMessage String sTitle 
        Integer iRetval
        Handle hoDialog
        
        Get Initialise to hoDialog
        If (num_arguments  = 1) Send Base_Box hoDialog sMessage " "
        Else Send Base_Box hoDialog sMessage sTitle
        
        Set piMainIcon      of hoDialog to eTaskIconInfo
        Set pbShowButtonOk  of hoDialog to True
        Set piDefaultButton of hoDialog to eBtn_OK
        
        Get ShowDialog  to iRetval
    End_Procedure

    Procedure sigCJWarning_Box String sMessage String sTitle 
        Integer iRetval
        Handle hoDialog
        
        Get Initialise to hoDialog
        If (num_arguments  = 1) Send Base_Box hoDialog sMessage " "
        Else Send Base_Box hoDialog sMessage sTitle
        
        Set piMainIcon      of hoDialog to eTaskIconWarning       
        Set pbShowButtonOk  of hoDialog to True
        Set piDefaultButton	of hoDialog to eBtn_OK
        
        Get ShowDialog  to iRetval
    End_Procedure
        
    Procedure sigCJStop_Box String sMessage String sTitle 
		Integer iRetval
        Handle hoDialog
        
        Get Initialise to hoDialog
        If (num_arguments  = 1) Send Base_Box hoDialog sMessage " "
        Else Send Base_Box hoDialog sMessage sTitle
        
        Set piMainIcon      of hoDialog to eTaskIconError         
        Set pbShowButtonOk  of hoDialog to True
        Set piDefaultButton	of hoDialog to eBtn_OK
        
        Get ShowDialog  to iRetval
    End_Procedure
        
    Function sigCJYesNo_Box String sMessage String sTitle Integer eBtn Returns Integer
        Integer iRetval
        Handle hoDialog
        
        Get Initialise to hoDialog
        If (num_arguments  = 1) Send Base_Box hoDialog sMessage " "
        Else Send Base_Box hoDialog sMessage sTitle
        
        Set psMainIconImage of hoDialog to "Question_32.ico"         
        Set pbShowButtonYes of hoDialog to True
        Set pbShowButtonNo  of hoDialog to True            
        If (num_arguments < 3) Set piDefaultButton	of hoDialog to eBtn_No
        Else Set piDefaultButton	of hoDialog to eBtn
        
        Get ShowDialog  to iRetval
        
        If (iRetval = 2) Function_Return MBR_Yes
        If (iRetval = 4) Function_Return MBR_No
        
    	Function_Return 0 // iRetval    
    End_Function          
        
    Function sigCJYesNoCancel_Box String sMessage String sTitle Integer eBtn Returns Integer
        Integer iRetval
        Handle hoDialog
        
        Get Initialise to hoDialog
        If (num_arguments  = 1) Send Base_Box hoDialog sMessage " "
        Else Send Base_Box hoDialog sMessage sTitle
        
        Set psMainIconImage     of hoDialog to "Question_32.ico"         
        Set pbShowButtonYes     of hoDialog to True
        Set pbShowButtonNo      of hoDialog to True  
        Set pbShowButtonCancel	of hoDialog to True          
        If (num_arguments < 3) Set piDefaultButton	of hoDialog to eBtn_Cancel
        Else Set piDefaultButton	of hoDialog to eBtn
        
        Get ShowDialog  to iRetval
        
        If (iRetval = 2) Function_Return MBR_Yes
        If (iRetval = 4) Function_Return MBR_No
        If (iRetval = 8) Function_Return MBR_Cancel
        
    	Function_Return 0 // iRetval    
	End_Function          
End_Class                                                 

