Use SigCjW_Calendar.pkg
Use cSigCJMethods_Mixin.pkg

{ DesignerClass=cDTContainer3D }
Class cSigCJDatePicker is a cSigCjComDatePicker
    Import_Class_Protocol cSigCJMethods_Mixin
    
    Procedure Construct_Object
        Forward Send Construct_Object   // very important!

        Set peAutoCreate to acAutoCreate

        { DesignTime=False }
        Property Boolean Private_pbDayMetrics False

    End_Procedure

    Procedure End_Construct_Object
        Variant vCJ_Cal

        Forward Send End_Construct_Object   // very important!

        //Set defaults
        Set ComBorderStyle     to OLExtpDatePickerBorderNone
        Set ComShowWeekNumbers to True

        //Set Theme
        //We will be using the Office 07 theme, so (as yet) I have not
        //implemented theme changing.
        #IF (SigCj_Codejock_Version < 150103)
        Send Set_Theme_To_Office_07
        #ELSE
        Set ComVisualTheme to OLExtpCalendarThemeResource 
        #ENDIF 
    End_Procedure

    Procedure OnCreate
        Forward Send OnCreate
        
        If (Private_pbDayMetrics(Self)) Begin
            Set ComAskDayMetrics to True
            Send OnSetDateRange
        End 
    End_Procedure

   { MethodType=Property Category="CodeJock" InitialValue=False }
    Procedure Set pbDayMetrics Boolean bValue
         Set Private_pbDayMetrics to bValue
    End_Procedure

    Function pbDayMetrics Returns Boolean
        Function_Return (Private_pbDayMetrics(Self))  
    End_Function

    { MethodType=Event }        
    Procedure OnSetDateRange
        // Hook for setting the date range
    End_Procedure

    { MethodType=Event }        
    Procedure OnDayMetrics Handle hoDayMetrics Date dValue
        // Hook, sent for each day in the date range
    End_Procedure
    
    // This will only get called if pbDayMetrics is set to True
    Procedure OnComDayMetrics DateTime llDay Variant llMetrics
        Handle hoDayMetrics 
        Date   dDate

        Move llDay to dDate
        Get Create U_cSigCjComDatePickerDayMetrics to hoDayMetrics
        Set pvComObject of hoDayMetrics to llMetrics
            Send OnDayMetrics hoDayMetrics dDate    
        Send Destroy of hoDayMetrics
    End_Procedure

    #IF (SigCj_Codejock_Version < 150103)
    Procedure Set_Theme_To_Office_07
        Handle hoThemeOffice07
        Variant vTheme

        Get Create U_cSigCjComDatePickerThemeOffice2007 to hoThemeOffice07
            Get pvComObject of hoThemeOffice07 to vTheme
            Send ComSetTheme vTheme
        Send Destroy of hoThemeOffice07
    End_Procedure
    #ENDIF
End_Class

