Use SigCjW_Controls.pkg
Use cSigCJMethods_Mixin.pkg
Use StdFont.pkg

//Appearance
{ OverrideProperty=Label_Col_Offset          DesignTime=False }
{ OverrideProperty=Label_Justification_Mode  DesignTime=False }
{ OverrideProperty=Label_Row_Offset          DesignTime=False }
{ OverrideProperty=piMinSize                 DesignTime=False }
{ OverrideProperty=Border_Style              DesignTime=False }
{ OverrideProperty=Color                     DesignTime=False }
{ OverrideProperty=TextColor                 DesignTime=False }
{ OverrideProperty=Visible_State             DesignTime=False }
//Behaviour
{ OverrideProperty=Attach_Parent_State       DesignTime=False }
{ OverrideProperty=Block_Mouse_State         DesignTime=False }
{ OverrideProperty=Client_Area_State         DesignTime=False }
{ OverrideProperty=Delegation_Mode           DesignTime=False }
{ OverrideProperty=Focus_Mode                DesignTime=False }
{ OverrideProperty=pbBindValue               DesignTime=False }
{ OverrideProperty=peAutoCreate              DesignTime=False }
{ OverrideProperty=peNeighborhood            DesignTime=False }
{ OverrideProperty=Popup_State               DesignTime=False }
{ OverrideProperty=Ring_State                DesignTime=False }
{ OverrideProperty=Scope_State               DesignTime=False }
{ OverrideProperty=Search_Case               DesignTime=False }
{ OverrideProperty=Skip_State                DesignTime=False }

{ OverrideProperty=Help_Id                   DesignTime=False }
{ OverrideProperty=Help_Keyword              DesignTime=False }
{ OverrideProperty=psHtmlHelpTopic           DesignTime=False }
{ OverrideProperty=Status_Help               DesignTime=False }
{ OverrideProperty=Use_Parent_Status_Help    DesignTime=False }
{ OverrideProperty=psLicenseKey              DesignTime=False }
{ OverrideProperty=psProgID                  DesignTime=False }
Class cSigCJColorPicker is a cSigCjComColorPicker
    Import_Class_Protocol cSigCJMethods_Mixin

    Procedure Construct_Object
        Forward Send Construct_Object

        { DesignTime=False }
        Property OLE_Color Private_piDefaultColor clBlack

        { DesignTime=False }
        Property OLE_Color Private_piSelectedColor clBlack

        { DesignTime=False }
        Property OLE_Color Private_piBackColor clBlack // to see back Color turn off transparent_state

        { DesignTime=False }
        Property String Private_psCaption ''

        { DesignTime=False }
        Property Boolean Private_pbEnabled True

        { DesignTime=False }
        Property Boolean Private_pbTransparent True // this gives a smooth edge by hiding back Color

        { DesignTime=False }
        Property Boolean Private_pbFlatStyle False

        { DesignTime=False }
        Property Boolean Private_pbUseVisualStyle True

        { DesignTime=False }
        Property Integer Private_peAppearance OLExtpAppearanceStandard

        { DesignTime=False }
        Property Boolean Private_pbShowAutomaticColor True

        { DesignTime=False }
        Property Boolean Private_pbShowMoreColors True

        // Font Properties
        { DesignTime=False }
        Property Boolean Private_pbBold False

        { DesignTime=False }
        Property Boolean Private_pbItalic False

        { DesignTime=False }
        Property Boolean Private_pbStrikethrough False

        { DesignTime=False }
        Property Boolean Private_pbUnderline False

        { DesignTime=False }
        Property String Private_psFontName "MS Sans Serif"

        { DesignTime=False }
        Property Number Private_pnFontSize 8.25

        { DesignTime=False }
        Property Handle Private_hoFont  (Create(Self, U_cComStdFont))
    End_Procedure

    Procedure OnCreate
        Handle hoFont
        
        //Ian Smith
        //Getting Ambiguous Function in expression Errors with DF25.x
        //DAW have also used PRIVATE_PIBACKCOLOR as a property name but their property
        //is still defined as an integer - as the system classes are compiled in first 
        //the compiler complains about our declaration.
        //To stop this - until DAW fixes their code - we are using a local variable to
        //remove the expression syntax.
        //        
        OLE_Color iColor 

        Forward Send OnCreate

        Get Private_piBackColor to iColor

        Set peAppearance            to (Private_peAppearance(Self))
        Set piBackColor             to iColor   //See above (Private_piBackColor(Self))
        Set psCaption               to (Private_psCaption(Self))
        Set piDefaultColor          to (Private_piDefaultColor(Self))
        Set pbEnabled_state         to (Private_pbEnabled(Self))
        Set pbFlatStyle             to (Private_pbFlatStyle(Self))
        Set piSelectedColor         to (Private_piSelectedColor(Self))
        Set pbShowAutomaticColor    to (Private_pbShowAutomaticColor(Self))
        Set pbShowMoreColors        to (Private_pbShowMoreColors(Self))
        Set pbTransparent_State     to (Private_pbTransparent(Self))
        Set pbUseVisualStyle        to (Private_pbUseVisualStyle(Self))

        //Connect the OCX and dataflex FONT objects and set defaults
        Get Private_hoFont   to hoFont
        Set pvComObject      of hoFont to (ComFont(Self))
        Set ComBold          of hoFont to (Private_pbBold(Self))
        Set ComItalic        of hoFont to (Private_pbItalic(Self))
        Set ComStrikethrough of hoFont to (Private_pbStrikethrough(Self))
        Set ComUnderline     of hoFont to (Private_pbUnderline(Self))
        // We want to use the standrad windows or df font here
        //Set ComName          of hoFont to (Private_psFontName(Self))
        //Set ComSize          of hoFont to (Private_pnFontSize(Self))
    End_Procedure

    //-------------------------------------------------------------------------

    { MethodType=Property Category="Font" InitialValue=False }
    Procedure Set pbBold Boolean bState
        Set SigCJProperty Set_Private_pbBold Set_ComBold (Private_hoFont(Self)) to bState
    End_Procedure

    Function pbBold Returns Boolean
        Function_Return (SigCJProperty(Self, Get_Private_pbBold, Get_ComBold, Private_hoFont(Self)))
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Property Category="Font" InitialValue=False }
    Procedure Set pbItalic Boolean bState
        Set SigCJProperty Set_Private_pbItalic Set_ComItalic (Private_hoFont(Self)) to bState
    End_Procedure

    Function pbItalic Returns Boolean
        Function_Return (SigCJProperty(Self, Get_Private_pbItalic, Get_ComItalic, Private_hoFont(Self)))
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Property Category="Font" InitialValue=False }
    Procedure Set pbStrikethrough Boolean bState
        Set SigCJProperty Set_Private_pbStrikethrough Set_ComStrikethrough (Private_hoFont(Self)) to bState
    End_Procedure

    Function pbStrikethrough Returns Boolean
        Function_Return (SigCJProperty(Self, Get_Private_pbStrikethrough, Get_ComStrikethrough, Private_hoFont(Self)))
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Property Category="Font" InitialValue=False }
    Procedure Set pbUnderline Boolean bState
        Set SigCJProperty Set_Private_pbUnderline Set_ComUnderline (Private_hoFont(Self)) to bState
    End_Procedure

    Function pbUnderline Returns Boolean
        Function_Return (SigCJProperty(Self, Get_Private_pbUnderline, Get_ComUnderline, Private_hoFont(Self)))
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Property Category="Font" InitialValue="MS Sans Serif" }
    Procedure Set psFontName String sName
        Set SigCJProperty Set_Private_psFontName Set_ComName (Private_hoFont(Self)) to sName
    End_Procedure

    Function psFontName Returns String
        Function_Return (SigCJProperty(Self, Get_Private_psFontName, Get_ComName, Private_hoFont(Self)))
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Property Category="Font" InitialValue=8.25 }
    Procedure Set pnFontSize Number nSize
        Set SigCJProperty Set_Private_pnFontSize Set_ComSize (Private_hoFont(Self)) to nSize
    End_Procedure

    Function pnFontSize Returns Number
        Function_Return (SigCJProperty(Self, Get_Private_pnFontSize, Get_ComSize, Private_hoFont(Self)))
    End_Function

    //--------------------------------------------------------------------------------------------------

    { MethodType=Property Category="CodeJock" PropertyType=Color InitialValue=clBlack }
    Procedure Set piDefaultColor OLE_Color iColor
        Set SigCJProperty Set_Private_piDefaultColor Set_ComDefaultColor  to iColor
    End_Procedure

    Function piDefaultColor Returns OLE_Color
        Function_Return (SigCJProperty(Self, Get_Private_piDefaultColor, Get_ComDefaultColor ))
    End_Function

    //--------------------------------------------------------------------------------------------------

    { MethodType=Property Category="CodeJock" PropertyType=Color InitialValue=clBlack }
    Procedure Set piSelectedColor OLE_Color iColor
        Set SigCJProperty Set_Private_piSelectedColor Set_ComSelectedColor  to iColor
    End_Procedure

    Function piSelectedColor Returns OLE_Color
        Function_Return (SigCJProperty(Self, Get_Private_piSelectedColor, Get_ComSelectedColor ))
    End_Function

    //--------------------------------------------------------------------------------------------------

    { MethodType=Property Category="Appearance" PropertyType=Color InitialValue=clBlack }
    Procedure Set piBackColor OLE_Color iColor
        Set SigCJProperty Set_Private_piBackColor Set_ComBackColor  to iColor
    End_Procedure

    Function piBackColor Returns OLE_Color
        Function_Return (SigCJProperty(Self, Get_Private_piBackColor, Get_ComBackColor ))
    End_Function

    //--------------------------------------------------------------------------------------------------

    { MethodType=Property Category="CodeJock" InitialValue="" }
    Procedure Set psCaption String sCaption
        Set SigCJProperty Set_Private_psCaption Set_ComCaption  to sCaption
    End_Procedure

    Function psCaption Returns String
        Function_Return (SigCJProperty(Self, Get_Private_psCaption, Get_ComCaption ))
    End_Function

    //--------------------------------------------------------------------------------------------------

    { MethodType=Property Category="Appearance" InitialValue=True }
    Procedure Set pbEnabled_State Boolean bState
        Set SigCJProperty Set_Private_pbEnabled Set_ComEnabled to bState
    End_Procedure

    Function pbEnabled_State Returns Boolean
        Function_Return (SigCJProperty(Self, Get_Private_pbEnabled, Get_ComEnabled))
    End_Function

    //--------------------------------------------------------------------------------------------------

    { MethodType=Property Category="Appearance" InitialValue=True }
    Procedure Set pbTransparent_State Boolean bState
        Set SigCJProperty Set_Private_pbTransparent Set_ComTransparent to bState
    End_Procedure

    Function pbTransparent_State Returns Boolean
        Function_Return (SigCJProperty(Self, Get_Private_pbTransparent, Get_ComTransparent))
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Property Category="CodeJock" InitialValue=False }
    Procedure Set pbFlatStyle Boolean bState
        Set SigCJProperty Set_Private_pbFlatStyle Set_ComFlatStyle to bState
    End_Procedure

    Function pbFlatStyle Returns Boolean
        Function_Return (SigCJProperty(Self, Get_Private_pbFlatStyle, Get_ComFlatStyle ))
    End_Function

    //-------------------------------------------------------------------------

    { MethodType=Property Category="CodeJock" InitialValue=True }
    Procedure Set pbUseVisualStyle Boolean bState
        Set SigCJProperty Set_Private_pbUseVisualStyle Set_ComUseVisualStyle to bState
    End_Procedure

    Function pbUseVisualStyle Returns Boolean
        Function_Return (SigCJProperty(Self, Get_Private_pbUseVisualStyle, Get_ComUseVisualStyle ))
    End_Function

    //-------------------------------------------------------------------------

    #IF (SigCj_Codejock_Version < 150001) 
        { MethodType=Property Category="CodeJock" InitialValue=OLExtpAppearanceStandard }
        { EnumList="OLExtpAppearanceStandard, OLExtpAppearanceFlat, OLExtpAppearanceUltraFlat, OLExtpAppearanceOffice2000, OLExtpAppearanceOffice2000, OLExtpAppearanceOffice2003, OLExtpAppearanceOffice2007" }
    #ELSE    
        { MethodType=Property Category="CodeJock" InitialValue=OLExtpAppearanceStandard }
        { EnumList="OLExtpAppearanceStandard, OLExtpAppearanceFlat, OLExtpAppearanceUltraFlat, OLExtpAppearanceOffice2000, OLExtpAppearanceOffice2000, OLExtpAppearanceOffice2003, OLExtpAppearanceResource" }
    #ENDIF 
    Procedure Set peAppearance Integer eAppearance
        Set SigCJProperty Set_Private_peAppearance Set_ComAppearance to eAppearance
    End_Procedure

    Function peAppearance Returns Integer
        Function_Return (SigCJProperty(Self, Get_Private_peAppearance, Get_ComAppearance ))
    End_Function

    //--------------------------------------------------------------------------------------------------

    { MethodType=Property Category="CodeJock" InitialValue=True }
    Procedure Set pbShowAutomaticColor  Boolean bState
        Set SigCJProperty Set_Private_pbShowAutomaticColor Set_ComShowAutomaticColor to bState
    End_Procedure

    Function pbShowAutomaticColor Returns Boolean
        Function_Return (SigCJProperty(Self, Get_Private_pbShowAutomaticColor, Get_ComShowAutomaticColor))
    End_Function

    //--------------------------------------------------------------------------------------------------

    { MethodType=Property Category="CodeJock" InitialValue=True }
    Procedure Set pbShowMoreColors  Boolean bState
        Set SigCJProperty Set_Private_pbShowMoreColors Set_ComShowMoreColors to bState
    End_Procedure

    Function pbShowMoreColors Returns Boolean
        Function_Return (SigCJProperty(Self, Get_Private_pbShowMoreColors, Get_ComShowMoreColors))
    End_Function

    //--------------------------------------------------------------------------------------------------

    // EVENTS

    //--------------------------------------------------------------------------------------------------

    // Hook for OnClick
    Procedure OnClick
    End_Procedure

    Procedure OnComClick
        Send OnClick
    End_Procedure

    //Standardised Hook for OnMouseDown
    Procedure OnMouseDown Integer eButton Integer x Integer y Integer fKeys
    End_Procedure

    Procedure OnComMouseDown Short llButton Short llShift OLE_XPOS_PIXELS llx OLE_YPOS_PIXELS lly
        Send OnMouseDown llButton llx lly llShift
    End_Procedure

    // Hook for OnMouseMove
    Procedure OnMouseMove Integer eButton Integer x Integer y Integer fKeys
    End_Procedure

    Procedure OnComMouseMove Short llButton Short llShift OLE_XPOS_PIXELS llx OLE_YPOS_PIXELS lly
        Send OnMouseMove llbutton llx lly llShift
    End_Procedure

    //Standardised Hook for OnMouseUp
    Procedure OnMouseUp Integer eButton Integer x Integer y Integer fKeys
    End_Procedure

    Procedure OnComMouseUp Short llButton Short llShift OLE_XPOS_PIXELS llx OLE_YPOS_PIXELS lly
        Send OnMouseUp llButton llx lly llShift
    End_Procedure

    // Hook for OnKeyDown
    Procedure OnKeyDown Short ByRef llKeyCode Short llShift
    End_Procedure

    Procedure OnComKeyDown Short ByRef llKeyCode Short llShift
        Send OnKeyDown (&llKeyCode) llShift
    End_Procedure

    // Hook for OnKeyPress
    Procedure OnKeyPress Short ByRef llKeyAscii
    End_Procedure

    Procedure OnComKeyPress Short ByRef llKeyAscii
        Send OnKeyPress (&llKeyAscii)
    End_Procedure

    // Hook for OnKeyUp
    Procedure OnKeyUp Short ByRef llKeyCode Short llShift
    End_Procedure

    Procedure OnComKeyUp Short ByRef llKeyCode Short llShift
        Send onkeyup (&llKeyCode) llShift
    End_Procedure
End_Class

//==============================================================================
