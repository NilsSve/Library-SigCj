Procedure sigInfo_Box Global String sMessage String sTitle
    Integer iRetval
    If (num_arguments = 1) Send sigCJInfo_Box of oSigCJTaskDialog sMessage "Information"
    Else Send sigCJInfo_Box of oSigCJTaskDialog sMessage sTitle
End_Procedure

Procedure sigWarning_Box Global String sMessage String sTitle
    Integer iRetval
    If (num_arguments = 1) Send sigCJWarning_Box of oSigCJTaskDialog sMessage "Warning"
    Else Send sigCJWarning_Box of oSigCJTaskDialog sMessage sTitle
End_Procedure

Procedure sigStop_Box Global String sMessage String sTitle
    Integer iRetval
    If (num_arguments = 1) Send sigCJStop_Box of oSigCJTaskDialog sMessage "Stop"
    Else Send sigCJStop_Box of oSigCJTaskDialog sMessage sTitle
End_Procedure

Function sigYesNo_Box Global String sMessage String sTitle Integer eBtn Returns Integer
    Integer iRetval
    If (num_arguments = 1) Get sigCJYesNo_Box of oSigCJTaskDialog sMessage to iRetval
    Else If (num_arguments = 2) Get sigCJYesNo_Box of oSigCJTaskDialog sMessage sTitle to iRetval
    Else Get sigCJYesNo_Box of oSigCJTaskDialog sMessage sTitle eBtn to iRetval
    Function_Return iRetval
End_Function

Function sigYesNoCancel_Box Global String sMessage String sTitle Integer eBtn Returns Integer
    Integer iRetval
    If (num_arguments = 1) Get sigCJYesNoCancel_Box of oSigCJTaskDialog sMessage to iRetval
    Else If (num_arguments = 2) Get sigCJYesNoCancel_Box of oSigCJTaskDialog sMessage sTitle to iRetval
    Else Get sigCJYesNoCancel_Box of oSigCJTaskDialog sMessage sTitle eBtn to iRetval
    Function_Return iRetval
End_Function
