Use DfAllEnt.pkg
Use cSigCJTaskDialog.pkg

Object oSigCJTaskDialog is a cSigCJTaskDialog
    
    Property Integer piProcessCounter
    
    Procedure OnConstructed
        Set pbRadioOptionEnabledState 102 to False
    End_Procedure
    
    Procedure OnTimer Integer iMilliSeconds Boolean ByRef bResetCounter
        Integer iCounter
        
        Move True to bResetCounter
        Get piProcessCounter to iCounter
        Increment iCounter
        Set piProcessCounter to iCounter
        Set piProgressBarPos to iCounter
        Set psMainInstructionText to (sFormat("Processing... %1%",String(iCounter)))  
        If (iCounter=101) Begin
            Set psMainInstructionText to "Download Complete 100%" 
            Sleep 2
            Send ClickButton eBtn_Cancel
        End
    End_Procedure
    
    Procedure OnComHyperlinkClicked String llURL
        Runprogram Background (String("Start" * String(llURL))) 
        // (String("Start iexplore.exe" * \String(llURL))) 
    End_Procedure
    
End_Object

