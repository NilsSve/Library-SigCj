// SigCjC_ToolTipContext.pkg was renamed SigCjC_ToolTip.pkg at wrapper 18.3.0;
// it declares the same cSigCjComToolTipContext. This Use was never updated.
Use SigCjC_ToolTip.pkg
Use SigCjLicense.pkg   // defines SigCj_Codejock_Version, tested in a #IF below
Use cSigCJMethods_Mixin.pkg

Class cSigCJToolTipContextr is a cSigCjComToolTipContext
    Import_Class_Protocol cSigCJMethods_Mixin
    
    Procedure Construct_Object
        Forward Send Construct_Object

        // Define new Properties:
        { DesignTime=False }
        Property Integer Private_peTooltipStyle OLExtpToolTipStandard
        
        // Create child objects:

        // Set property values:

    End_Procedure

    Procedure OnCreate
    End_Procedure

    Procedure End_Construct_Object
        Forward Send End_Construct_Object

        // Add your code that needs to be executed at the end of the object construction here:

    End_Procedure

    // Create and augment procedures and functions

    // The Style Property gets\sets the style of the tool tip window. See TooltipContext.Style.
    #IF (SigCj_Codejock_Version < 150001) 
    #ELSE
    #ENDIF
    { MethodType=Property InitialValue=OLExtpToolTipStandard }
    { Category="Tooltip" }
    { EnumList="OLExtpToolTipStandard, OLExtpToolTipBalloon, OLExtpToolTipOffice, OLExtpToolTipRTF, OLExtpToolTipLuna, OLExtpToolTipOffice2007, OLExtpToolTipHTML, OLExtpToolTipMarkup" }
    Procedure Set peTooltipStyle Integer eTooltipStyle
        Set SigCJProperty Set_Private_peTooltipStyle Set_ComStyle to eTooltipStyle
    End_Procedure
    
    Function peTooltipStyle Returns Integer
        Function_Return (SigCJProperty(Self, Get_Private_peTooltipStyle, Get_ComStyle ))
    End_Function

    { MethodType=Property }
    { Category="Tooltip" }
    Procedure Set piTipBackColor Integer iValue
        Set ComTipBkColor to iValue
    End_Procedure

    Function piTipBackColor Returns Integer
        Integer iRetval
        Get ComTipBkColor to iRetval 
        Function_Return iRetval
    End_Function

    { MethodType=Property }
    { Category="Tooltip" }
    Procedure Set ComTipTextColor Integer iValue 
        Set ComTipTextColor to iValue 
    End_Procedure

    Function ComTipTextColor Returns OLE_COLOR
        Integer iValue
        Get ComTipTextColor to iValue 
        Function_Return iValue
    End_Function




End_Class

//==============================================================================
//End of Package - cSigCJToolTipContextr.pkg
