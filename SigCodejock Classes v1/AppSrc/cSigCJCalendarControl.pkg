    //=========================================================================
    //Other Events
    //=========================================================================

    Procedure OnComBeforeEditOperation Variant llOpParams Boolean ByRef llbCancelOperation
        Handle  hoParams bConfirmDelete hoEventViews
        Integer iOperation iBtn iCount
        String  sMessage sTitle
        Variant vEventViews

        Move False to bConfirmDelete

        Get Create U_cSigCjComCalendarEditOperationParameters to hoParams
            Set pvComObject of hoParams to llOpParams

            Get ComOperation of hoParams to iOperation

            //-------------------------------------------------------------
            Case Begin
                Case (iOperation = OLExtpCalendarEO_Unknown)                      //Unknown operation value.
                    Case Break

                Case (iOperation = OLExtpCalendarEO_DragCopy)                     //Drag copy event.
                    Case Break

                Case (iOperation = OLExtpCalendarEO_DragMove)                     //Drag move event.
                    Case Break

                Case (iOperation = OLExtpCalendarEO_DragResizeBegin)              //Drag Resizing event begin.
                    Case Break

                Case (iOperation = OLExtpCalendarEO_DragResizeEnd)                //Drag Resizing event end.
                    Case Break

                Case (iOperation = OLExtpCalendarEO_EditSubject_ByF2)             //In-place edit event by pressing F2 key.
                    Case Break

                Case (iOperation = OLExtpCalendarEO_EditSubject_ByMouseClick)     //In-place edit event by mouse click.
                    Case Break

                Case (iOperation = OLExtpCalendarEO_EditSubject_ByTab)            //In-place edit event tab key.
                    Case Break

                Case (iOperation = OLExtpCalendarEO_EditSubject_AfterEventResize) //In-place edit event after resizing an event.
                    Case Break

                Case (iOperation = OLExtpCalendarEO_Cut)                          //Cut events.
                    Case Break

                Case (iOperation = OLExtpCalendarEO_Copy)                         //Copy events.
                    Case Break

                Case (iOperation = OLExtpCalendarEO_Paste)                        //Paste event.
                    Case Break

                //-------------------------------------------------------------

                Case (iOperation = OLExtpCalendarEO_DeleteSelectedEvents)         //Delete selected events.
                    Get ComEventViews of hoParams to vEventViews
                    Get Create U_cSigCjComCalendarViewEvents to hoEventViews
                        Set pvComObject of hoEventViews to vEventViews

                        Get ComCount of hoEventViews to iCount
                    Send Destroy of hoEventViews

                    //Handle both single selection and muilt selection here as
                    //this only gets called once, where ...EO_DeleteEvent gets
                    //called for each event .
                    If (iCount = 1) Begin
                        Move "Delete the event"     to sMessage
                        Move "Confirm Delete Event" to sTitle
                    End
                    Else Begin
                        Move "Delete the selected events" to sMessage
                        Move "Confirm Delete Events"      to sTitle
                    End

                    Get YesNo_Box sMessage sTitle to iBtn
                    If (iBtn = MBR_NO) Begin
                        Move True to llbCancelOperation
                    End

                    Case Break

                //-------------------------------------------------------------

                Case (iOperation = OLExtpCalendarEO_DeleteEvent)                  //Delete event. Sent for a single event or for each selected event.
                    Case Break

                Case (iOperation = OLExtpCalendarEO_InPlaceCreateEvent)           //In-place event creation.
                    Case Break

                //-------------------------------------------------------------

            Case End

            //-------------------------------------------------------------

        Send Destroy of hoParams

    End_Procedure

