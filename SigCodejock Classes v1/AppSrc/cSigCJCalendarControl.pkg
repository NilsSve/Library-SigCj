    Procedure Show_Built_In_Dialog Integer eDialog Variant vEvent
        Boolean bOK 
        DateTime dtHitDateTime
        Date dHitDate
        Integer iSpecial_Date eAllow

        If (eDialog = eCal_Dialog_NewEvent) Begin
            Get pdtHitDateTime to dtHitDateTime 
            Move (Date(dtHitDateTime)) to dHitDate
            Get Cal_Special_Date dHitDate to iSpecial_Date

            Move False to bOK
            If (iSpecial_Date <> -1) Begin
                Move (Cal_AllowEvents(Self,iSpecial_Date)) to eAllow
                If (eAllow = eCal_AE_Ask) Begin
                    If (YesNo_Box(psAllowEventText(Self), psAllowEventTitle(Self), MB_DEFBUTTON2) = MBR_YES) Move True to bOK
                End
                If (eAllow = eCal_AE_Yes) Begin
                    Move True to bOK
                End
            End
            Else Begin
                Move True to bOK
            End

            If (bOK) Begin
                Get ComShowNewEvent of oe_CJ_CalendarDialogs to bOK
            End
        End

        If (eDialog = eCal_Dialog_EditEvent) Begin
            Get ComShowEditEvent of oe_CJ_CalendarDialogs vEvent to bOK
        End
    End_Procedure

    //-------------------------------------------------------------------------

    Procedure Set_Theme_To_Office_07
        Handle hoThemeOffice07 hoCustonIcons hoWorkspace
        Variant vTheme vCustonIcons
        String sBitmapPath

        Handle hoDayView hoDay hoGroup hoCell hoWorkCell hoNonWorkCell
        Variant vDayView  vDay  vGroup  vCell  vWorkCell  vNonWorkCell
        Integer iColor

        Get phoWorkspace of ghoApplication to hoWorkspace
        Get psBitmapPath of hoWorkspace to sBitmapPath

        Get Create U_cSigCjComCalendarThemeOffice2007 to hoThemeOffice07
        Get ComTheme to vTheme

        Send CreateComObject of hoThemeOffice07
            Get pvComObject of hoThemeOffice07 to vTheme
            Send ComSetTheme vTheme

            //Load any custom options (e.g. icons etc)
            Get ComCustomIcons of hoThemeOffice07 to vCustonIcons
            Get Create U_cSigCjComImageManagerIcons to hoCustonIcons
                Set pvComObject of hoCustonIcons to vCustonIcons

                Send ComLoadIcon of hoCustonIcons (sBitmapPath + "\Cal_Reminder.ico"  ) OLExtpCalendarEventIconIDReminder   OLExtpImageNormal
                Send ComLoadIcon of hoCustonIcons (sBitmapPath + "\Cal_Occurrence.ico") OLExtpCalendarEventIconIDOccurrence OLExtpImageNormal
                Send ComLoadIcon of hoCustonIcons (sBitmapPath + "\Cal_Exception.ico" ) OLExtpCalendarEventIconIDException  OLExtpImageNormal
                Send ComLoadIcon of hoCustonIcons (sBitmapPath + "\Cal_Meeting.ico"   ) OLExtpCalendarEventIconIDMeeting    OLExtpImageNormal
                Send ComLoadIcon of hoCustonIcons (sBitmapPath + "\Cal_Private.ico"   ) OLExtpCalendarEventIconIDPrivate    OLExtpImageNormal
//                Send ComLoadIcon of hoCustonIcons (sBitmapPath + "\Diary_Link.ico"      ) cj_CRM_Link_Icon                    OLExtpImageNormal
//                Send ComLoadIcon of hoCustonIcons (sBitmapPath + "\Diary_Complete.ico"  ) cj_CRM_Complete_Icon                OLExtpImageNormal

            Send Destroy of hoCustonIcons
            //Standard colors
            //We drill down to the color objects. Having got to them we Set 
            //properties so that they are easy to access.

            //This is coded as a full Create Destory set incase we need to
            //access the intermediate objects for anything else.

            Get Private_phoWorkingCellColors    to hoWorkCell
            Get Private_phoNonWorkingCellColors to hoNonWorkCell

            Get ComDayView of hoThemeOffice07 to vDayView
            Get Create U_cSigCjComCalendarThemeOffice2007DayView to hoDayView
                Set pvComObject of hoDayView to vDayView

                Get ComDay of hoDayView to vDay
                Get Create U_cSigCjComCalendarThemeOffice2007DayViewDay to hoDay
                    Set pvComObject of hoDay to vDay

                    Get ComGroup of hoDay to vGroup
                    Get Create U_cSigCjComCalendarThemeOffice2007DayViewDayGroup to hoGroup
                        Set pvComObject of hoGroup to vGroup

                        Get ComCell of hoGroup to vCell
                        Get Create U_cSigCjComCalendarThemeDayViewCell to hoCell
                            Set pvComObject of hoCell to vCell

                            Get ComWorkCell of hoCell to vWorkCell
                            Set pvComObject of hoWorkCell to vWorkCell

                            Get ComNonWorkCell of hoCell to vNonWorkCell
                            Set pvComObject of hoNonWorkCell to vNonWorkCell

                            //We do not destory the Non/WorkingCell objects

                        Send Destroy of hoCell
                    Send Destroy of hoGroup
                Send Destroy of hoDay
            Send Destroy of hoDayView
        Send Destroy of hoThemeOffice07
    End_Procedure

    //-------------------------------------------------------------------------

    Procedure Custom_Icon Variant llpEvent Integer iIcon Boolean bShow
        Handle  hoCustomIcons hoEvent
        Variant vCustomIcons

        Get Create U_cSigCjComCalendarEvent to hoEvent
            Set pvComObject of hoEvent to llpEvent

            Get ComCustomIcons of hoEvent to vCustomIcons
            Get Create U_cSigCjComCalendarIconIDs to hoCustomIcons
                Set pvComObject of hoCustomIcons to vCustomIcons

                If (bShow) Send ComAddIfNeed of hoCustomIcons iIcon
                Else       Send ComRemoveID  of hoCustomIcons iIcon
            Send Destroy of hoCustomIcons
        Send Destroy of hoEvent
    End_Procedure

    //-------------------------------------------------------------------------

    Procedure Add_Link_Icon Variant llpEvent
        Handle  hoCustomIcons hoEvent
        Variant vCustomIcons

        Get Create U_cSigCjComCalendarEvent to hoEvent
            Set pvComObject of hoEvent to llpEvent

            Get ComCustomIcons of hoEvent to vCustomIcons
            Get Create U_cSigCjComCalendarIconIDs to hoCustomIcons
                Set pvComObject of hoCustomIcons to vCustomIcons

//                Send ComAddIfNeed of hoCustomIcons cj_CRM_Link_Icon

            Send Destroy of hoCustomIcons
        Send Destroy of hoEvent
    End_Procedure

    //-------------------------------------------------------------------------

    Procedure Enable_Icons
        Integer iView ismDay
        Handle hoThemeOffice07 hoView hoEvent hoIcons hoDay hoGroup hoSM_Day hoFormula
        Variant vIconsToDraw vView vEvent vIcons vTheme vDay vSM_Day vGroup vFormula

        Get ComTheme to vTheme
        Get Create U_cSigCjComCalendarThemeOffice2007 to hoThemeOffice07
            Set pvComObject of hoThemeOffice07 to vTheme

            For iView from 1 to 3
                If (iView = 1) Begin
                    Get ComDayView of hoThemeOffice07 to vView
                    Get Create U_cSigCjComCalendarThemeOffice2007DayView to hoView
                End
                If (iView = 2) Begin
                    Get ComWeekView of hoThemeOffice07 to vView
                    Get Create U_cSigCjComCalendarThemeOffice2007WeekView to hoView
                End
                If (iView = 3) Begin
                    Get ComMonthView of hoThemeOffice07 to vView
                    Get Create U_cSigCjComCalendarThemeOffice2007MonthView to hoView
                End
                    Set pvComObject of hoView to vView

                    Get comEvent of hoView to vEvent
                    If (iView = 1) Get Create U_cSigCjComCalendarThemeOffice2007DayViewEvent   to hoEvent
                    If (iView = 2) Get Create U_cSigCjComCalendarThemeOffice2007WeekViewEvent  to hoEvent
                    If (iView = 3) Get Create U_cSigCjComCalendarThemeOffice2007MonthViewEvent to hoEvent
                        Set pvComObject of hoEvent to vEvent

                        Get ComEventIconsToDraw of hoEvent to vIcons
                        Get Create U_cSigCjComCalendarThemeEventIconsToDraw to hoIcons
                            Set pvComObject of hoIcons to vIcons

                            Set ComShowException    of hoIcons to True
                            Set ComShowMeeting      of hoIcons to True
                            Set ComShowOccurrence   of hoIcons to True
                            Set ComShowPrivate      of hoIcons to True
                            Set ComShowReminder     of hoIcons to True
                        Send Destroy of hoIcons

                        Get ComHeightFormula of hoEvent to vFormula
                        Get Create U_cSigCjComCalendarThemeFormulaMulDivC to hoFormula
                            Set pvComObject of hoFormula to vFormula

                            Set ComConstant of hoFormula to 5
                        Send Destroy of hoFormula
                    Send Destroy of hoEvent

                    Get ComDay of hoView to vDay
                    If (iView = 1) Get Create U_cSigCjComCalendarThemeOffice2007DayViewDay   to hoDay
                    If (iView = 2) Get Create U_cSigCjComCalendarThemeOffice2007WeekViewDay  to hoDay
                    If (iView = 3) Get Create U_cSigCjComCalendarThemeOffice2007MonthViewDay to hoDay
                        Set pvComObject of hoDay to vDay

                        If (iView = 1) Begin
                            Get ComGroup of hoDay to vGroup
                            Get Create U_cSigCjComCalendarThemeOffice2007DayViewDayGroup to hoGroup
                            Set pvComObject of hoGroup to vGroup
                        End
                        Else Move hoDay to hoGroup
                        For ismDay from 1 to 2
                            If (ismDay = 1) Begin
                                Get ComSingleDayEvent of hoGroup to vSM_Day
                                Get Create U_cSigCjComCalendarThemeOffice2007DayViewEventSingleDay to hoSM_Day
                            End
                            If (ismDay = 2) Begin
                                Get ComMultiDayEvent of hoGroup to vSM_Day
                                Get Create U_cSigCjComCalendarThemeOffice2007DayViewEventMultiDay to hoSM_Day
                            End
                                Set pvComObject of hoSM_Day to vSM_Day

                                Get ComEventIconsToDraw of hoSM_Day to vIcons
                                Get Create U_cSigCjComCalendarThemeEventIconsToDraw to hoIcons
                                    Set pvComObject of hoIcons to vIcons

                                    Set ComShowException    of hoIcons to True
                                    Set ComShowMeeting      of hoIcons to True
                                    Set ComShowOccurrence   of hoIcons to True
                                    Set ComShowPrivate      of hoIcons to True
                                    Set ComShowReminder     of hoIcons to True
                                Send Destroy of hoIcons
                            Send Destroy of hoSM_Day
                        Loop

                        If (iView = 1) Send Destroy of hoGroup
                    Send Destroy of hoDay
                Send Destroy of hoView
            Loop

        Send ComRefreshMetrics of hoThemeOffice07
        Send Destroy of hoThemeOffice07
    End_Procedure

    //-------------------------------------------------------------------------

    Procedure Setup_Categories
        Handle  hoDataProvider hoCategories 
        Variant vCategories  
        tdCal_Category tCat

        Get Private_phoDataProvider to hoDataProvider

        Get Private_phoCategories to hoCategories
        Get ComEventCategories of hoDataProvider to vCategories
        Set pvComObject of hoCategories to vCategories
            
        Send ComRemoveAll of hoCategories

        If (pbUseStdFiles(Self)) Begin
#IFDEF SigCj_Use_StdFiles
            Clear Cal_Cats
            Find gt Cal_Cats by Index.1
            While (Found)
                Get Move_StdFile_Cats_To_tdCats to tCat
                Send Add_Category tCat
                    
                Find gt Cal_Cats by Index.1
            Loop
#ENDIF
        End
        Else Begin
            Send OnCategory_Load 
        End
    End_Procedure

#IFDEF SigCj_Use_StdFiles
    Function Move_StdFile_Cats_To_tdCats Returns tdCal_Category
        tdCal_Category tCats
        
        Move Cal_Cats.ID             to tCats.iURN
        Move Cal_Cats.Short_Desc     to tCats.sShort_Desc
        Move Cal_Cats.Long_Desc      to tCats.sLong_Desc
        Move Cal_Cats.BorderColour   to tCats.iBorder_Color
        Move Cal_Cats.ColourDark     to tCats.iColor_Dark
        Move Cal_Cats.ColourLight    to tCats.iColor_Light
        Move Cal_Cats.GradientFactor to tCats.nGradient

        Function_Return tCats
    End_Function
#ENDIF

    Procedure Add_Category tdCal_Category tCat
        Boolean bIsComObjectCreated
        Handle  hoCategory hoColorGradient 
        Variant vCategory vBackGround

        Get Create U_cSigCjComCalendarEventCategory to hoCategory
            Get IsComObjectCreated of hoCategory to bIsComObjectCreated
            If (not(bIsComObjectCreated)) Begin
                Send CreateComObject of hoCategory
            End
    
            Set ComID          of hoCategory to tCat.iURN
            Set ComName        of hoCategory to tCat.sShort_Desc
            Set ComBorderColor of hoCategory to tCat.iBorder_Color
    
            Get ComBackground of hoCategory to vBackGround
            Get Create U_cSigCjComCalendarThemeColorGradient to hoColorGradient
                Set pvComObject of hoColorGradient to vBackGround
    
                Set ComColorDark      of hoColorGradient to tCat.iColor_Dark
                Set ComColorLight     of hoColorGradient to tCat.iColor_Light
                Set ComGradientFactor of hoColorGradient to tCat.nGradient
    
            Send Destroy of hoColorGradient

            Get pvComObject of hoCategory to vCategory
            Send ComAdd of (Private_phoCategories(Self)) vCategory
        Send Destroy of hoCategory
    End_Procedure

    //-------------------------------------------------------------------------

    Function Date_Range_String Handle hoActiveView Returns String
        Handle  hoDay
        Variant vDay
        Integer iDaysCount
        String  sRange
        Date    dDate

        Get ComDaysCount of hoActiveView to iDaysCount

        If (iDaysCount < 1) Begin
            Move "Error no days selected" to sRange
        End
        Else Begin
            Get Create U_cSigCjComCalendarViewDay to hoDay
                Get ComDays of hoActiveView 0 to vDay
                Set pvComObject of hoDay to vDay
                Get ComDate of hoDay to dDate
                Move dDate to sRange

                If (iDaysCount > 1) Begin
                    Get ComDays of hoActiveView (iDaysCount -1) to vDay
                    Set pvComObject of hoDay to vDay
                    Get ComDate of hoDay to dDate
                    Move (sRange + " - " + String(dDate)) to sRange
                End
            Send Destroy of hoDay
        End

        Function_Return sRange
    End_Function

    //-------------------------------------------------------------------------

    Procedure Set_Single_Data_Source Integer iDataType String sDataSource
        Boolean bOK
        Handle  hoDataProvider
        Variant vDataProvider
        String  sConnection

        //We only support DataFlex & Outlook at present.
        If (iDataType = eCal_DT_DataFlex) Begin
            Move "Provider=custom;DSN=Not Needed" to sConnection
        End
        Else Begin
            Move ("Provider=" + eCal_DataProvider_Outlook + ";Data Source=" + sDataSource) to sConnection
        End

        Send ComSetDataProvider sConnection

        Get Private_phoDataProvider to hoDataProvider
        Get ComDataProvider to vDataProvider
        Set pvComObject of hoDataProvider to vDataProvider

        Get ComOpen of hoDataProvider to bOK
        If (not(bOK)) Begin
            Get ComCreate of hoDataProvider to bOK
        End
    End_Procedure

    //=========================================================================

    Function IsTimeBetween DateTime dtTime String sStartTime String sEndTime Returns Boolean
        Integer iWork iStart iEnd iTime
        String  sWork

        Move (Left(sStartTime,5)) to sStartTime //strip of secinds (if there)
        Move (Left(sEndTime,5)) to sEndTime //strip of secinds (if there)

        Move (Replaces(":",sEndTime,  "")) to iEnd
        Move (Replaces(":",sStartTime,"")) to iStart

        Move (DateGetHour(dtTime)) to sWork
        Move (DateGetMinute(dtTime)) to iWork
        If (iWork < 10) Move (Append(sWork,"0")) to sWork
        Move (Append(sWork,String(iWork))) to iTime

        Function_Return ((iTime >= iStart) and (iTime < iEnd))
    End_Function

    Function IsLastWeekDay Date dDate Returns Boolean
        Integer iDay iMask iLastDay

        Move (Mod(dDate,7)) to iDay //Saturday = 1 Friday = 0

        Get peWorkWeekMask to iMask
        If (iMask = eCal_WW_AllWeek ) Move 2 to iLastDay    //Assume Sunday is last day of week
        If (iMask = eCal_WW_SaSu    ) Move 2 to iLastDay
        If (iMask = eCal_WW_Mo_Fr   ) Move 0 to iLastDay
        If (iMask = 126             ) Move 1 to iLastDay

        Function_Return (iDay = iLastDay)
    End_Function

    Procedure OnComBeforeDrawThemeObject OLECalendarBeforeDrawThemeObject lleObjType Variant llDrawParams
        Boolean  bWorkCell bShade bLastDay
        Handle   hoDrawParams hoCellColor
        DateTime dtBegin
        Integer  iIndex iSpecial_Date
        Integer iWorkingColor iNonWorkingColor

        If (lleObjType = OLExtpCalendarBeforeDraw_DayViewCell) Begin
            Get Private_phoThemeDayViewCellParams to hoDrawParams
            Set pvComObject  of hoDrawParams to llDrawParams
            Get ComBeginTime of hoDrawParams to dtBegin
            Get ComWorkCell  of hoDrawParams to bWorkCell

            Get piWorkingCellBackColor    to iWorkingColor
            Get piNonWorkingCellBackColor to iNonWorkingColor

            Get Cal_Special_Date (Date(dtBegin)) to iSpecial_Date
            If (iSpecial_Date <> -1) Begin
                Move (Cal_BackColor(Self,iSpecial_Date)) to iWorkingColor
                If (Cal_AllDay(Self,iSpecial_Date)) Begin
                    Move (Cal_BackColor(Self,iSpecial_Date)) to iNonWorkingColor
                End
            End
            Else Begin
                If (bWorkCell) Begin
                    If (pbShadeLunchTime(Self)) Begin
                        Get IsTimeBetween dtBegin (ptmLunchStartTime(Self)) (ptmLunchEndTime(Self)) to bShade
                        If (bShade) Begin
                            Move iNonWorkingColor to iWorkingColor
                        End
                    End
    
                    If (pbShorterLastDay(Self)) Begin
                        Get ComIndex of hoDrawParams to iIndex
    
                        //need to cast the DateTime as passing DateTime to a Date results in a DateTime!
                        Get IsLastWeekDay (Date(dtBegin)) to bLastDay
                        If (bLastDay) Begin
                            Get IsTimeBetween dtBegin (ptmLastWorkDayEndTime(Self)) (Private_ptmWorkDayEndTime(Self)) to bShade
                            If (bShade) Begin
                            Move iNonWorkingColor to iWorkingColor
                            End
                        End
                    End
                End
            End // not special
            
            If (bWorkCell) Begin
                Get Private_phoWorkingCellColors to hoCellColor
                Set ComBackgroundColor of hoCellColor to iWorkingColor
            End
            Else Begin
                Get Private_phoNonWorkingCellColors to hoCellColor
                Set ComBackgroundColor of hoCellColor to iNonWorkingColor
            End
        End

    End_Procedure
End_Class

