        { DesignTime=False }
        Property Integer  Private_peWorkWeekMask                     eCal_WW_Mo_Fr
        { DesignTime=False }
        Property String   Private_ptmTimeScaleMinTime                "08:00"
        { DesignTime=False }
        Property String   Private_ptmTimeScaleMaxTime                "19:00"

        { DesignTime=False }
        Property Boolean  Private_pbPrnLandscape                     False
        { DesignTime=False }
        Property Boolean  Private_pbPrnGreyScale                     False
        { DesignTime=False }
        Property Boolean  Private_pbPrnPrintDateHeader               False
        { DesignTime=False }
        Property DateTime Private_pdtPrnPrintFrom                    //
        { DesignTime=False }
        Property DateTime Private_pdtPrnPrintTo                      //
        { DesignTime=False }
        Property Boolean  Private_pbPrnFromToExactly                 False
        { DesignTime=False }
        Property String   Private_psPrnFooterLeft                    ""
        { DesignTime=False }
