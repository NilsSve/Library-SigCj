    { MethodType=Property Category="CodeJock" InitialValue="08:00" }
    Procedure Set ptmTimeScaleMinTime String tmValue
        DateTime dtWork dtEmpty
        Integer iHour iMins

        If (pbUseScaleTimes(Self)=False) Procedure_Return
   
        Set Private_ptmTimeScaleMinTime to tmValue
        If (phoDayView(Self) and IsComObjectCreated(phoDayView(Self))) Begin
#IF (SigCj_Codejock_Version > 120002) 
            Get ComTimeScaleMinTime of (phoDayView(Self)) to dtWork
            Get SigCj_GetHours   tmValue to iHour
            Get SigCj_GetMinutes tmValue to iMins
            Move (DateSetHour  (dtWork, iHour)) to dtWork
            Move (DateSetMinute(dtWork, iMins)) to dtWork
            Move (DateSetSecond(dtWork,     1)) to dtWork

            //Now we can set the time!!
            Set ComTimeScaleMinTime of (phoDayView(Self)) to dtWork
#ENDIF
        End

    End_Procedure

