        { Category=Codejock }
        Property Boolean pbShadeLunchTime           True
        { Category=Codejock }
        Property String  ptmLunchEndTime            "14:00"
        { Category=Codejock }
        Property String  ptmLunchStartTime          "13:00"
        { Category=Codejock }
        Property Boolean pbUseStdFiles              True
        { Category=Codejock }
        Property Boolean pbUseStdDates              True
        { Category=Codejock }
        Property Boolean pbUseScaleTimes            False

        //---------------------------------------------------------------------
        //Commonly used objects or objects many levels down (so once found we save them here for speed).
        { DesignTime=False }
        Property Handle  phoOptions                         (Create(Self, U_cSigCjComCalendarOptions))
        { DesignTime=False }
        Property Handle  phoPrintOptions                    (Create(Self, U_cSigCjComCalendarPrintOptions))
        { DesignTime=False }
