    //=========================================================================
    //Control Data Events
    //=========================================================================

    Procedure OnComDoCreateEvent Variant llpEvent Integer ByRef llNewEventID Boolean ByRef llbResult
        tdEvent tEvent

        //Make sure we are returning a valid value
        Move False to llbResult

        //Move object data to buffer
        Get Move_Event_Object_Data_To_tdEvent llpEvent to tEvent

        If (pbUseStdFiles(Self)) Begin
#IFDEF SigCj_Use_StdFiles
            Clear CalEvent
            Lock
                Get Allocate_CalEvent_URN of oeCal_Sys_DD to tEvent.iURN
                Send Move_tdEvent_To_StdFile_Event tEvent
                SaveRecord CalEvent
            Unlock

            Move tEvent.iURN to llNewEventID
            Move True to llbResult
#ENDIF
        End
        Else Begin
            Get OnEvent_Create tEvent to llNewEventID
            If (llNewEventID <> 0) Move True to llbResult
        End
    End_Procedure

    //-------------------------------------------------------------------------

    Procedure OnComDoCreateRPattern Variant llpPattern Integer ByRef llNewPatternID Boolean ByRef llbResult
        tdR_Pat tR_Pat

        //Make sure we are returning a valid value
        Move False to llbResult

        //Move object data to buffer
        Get Move_R_Pat_Object_Data_To_tdR_Pat llpPattern to tR_Pat

        If (pbUseStdFiles(Self)) Begin
#IFDEF SigCj_Use_StdFiles
            Clear CalR_Pat
            Lock
                Get Allocate_CalR_Pat_URN of oeCal_Sys_DD to tR_Pat.iURN
                Send Move_tdR_Pat_To_StdFile_R_Pat tR_Pat
                SaveRecord CalR_Pat
            Unlock

            Move tR_Pat.iURN to llNewPatternID
            Move True to llbResult
#ENDIF
        End
        Else Begin
            Get OnR_Pat_Create tR_Pat to llNewPatternID
            If (llNewPatternID <> 0) Move True to llbResult
        End
    End_Procedure

    //-------------------------------------------------------------------------

    Procedure OnComDoDeleteEvent Variant llpEvent Boolean ByRef llbResult
        Handle  hoEvent
        Integer iEventID

        Get Private_phoEvent to hoEvent
        Set pvComObject of hoEvent to llpEvent
        Get ComId of hoEvent to iEventID

        Move False to llbResult

        If (pbUseStdFiles(Self)) Begin
#IFDEF SigCj_Use_StdFiles
            Clear CalEvent
            Move iEventID to CalEvent.URN
            Find Eq CalEvent by Index.1
            If (Found) Begin
                Lock
                    Delete CalEvent
                Unlock
                Move True to llbResult
            End
#ENDIF
        End
        Else Begin
            Get OnEvent_Delete iEventID to llbResult
        End
    End_Procedure

    //-------------------------------------------------------------------------

    Procedure OnComDoDeleteRPattern Variant llpPattern Boolean ByRef llbResult
        Handle  hoR_Pat
        Integer iPatternID

        Get Private_phoR_Pat to hoR_Pat
        Set pvComObject of hoR_Pat to llpPattern
        Get ComID of hoR_Pat to iPatternID

        Move False to llbResult

        If (pbUseStdFiles(Self)) Begin
#IFDEF SigCj_Use_StdFiles
            Clear CalR_Pat
            Move iPatternID to CalR_Pat.URN
            Find Eq CalR_Pat by Index.1
            If (Found) Begin
                Lock
                    Delete CalR_Pat
                Unlock
                Move True to llbResult
            End
#ENDIF
        End
        Else Begin
            Get OnR_Pat_Delete iPatternID to llbResult
        End
    End_Procedure

    //-------------------------------------------------------------------------

    Procedure OnComDoReadEvent Integer llEventID Variant ByRef llpEvent
        tdEvent tEvent

        If (pbUseStdFiles(Self)) Begin
#IFDEF SigCj_Use_StdFiles
            Clear CalEvent
            Move llEventID to CalEvent.URN
            Find EQ CalEvent by Index.1
            If (Found) Begin
                Get Move_StdFile_Event_To_tdEvent to tEvent
            End
            Else Begin
                Move 0 to tEvent.iURN
            End
#ENDIF
        End
        Else Begin
            Get OnEvent_Read llEventID to tEvent
        End

        If (tEvent.iURN <> 0) Begin
            Get Create_Event_Object_From_tdEvent tEvent False to llpEvent
        End
    End_Procedure

    //-------------------------------------------------------------------------

    Procedure OnComDoReadRPattern Integer llPatternID Variant ByRef llpPattern
        tdR_Pat tR_Pat

        If (pbUseStdFiles(Self)) Begin
#IFDEF SigCj_Use_StdFiles
            Clear CalR_Pat
            Move llPatternID to CalR_Pat.URN
            Find Eq CalR_Pat by Index.1
            If (Found) Begin
                Get Move_StdFile_R_Pat_To_tdR_Pat to tR_Pat
            End
            Else Begin
                Move 0 to tR_Pat.iURN
            End
#ENDIF
        End
        Else Begin
            Get OnR_Pat_Read llPatternID to tR_Pat
        End

        If (tR_Pat.iURN <> 0) Begin
            Get Create_R_Pat_Object_From_tdR_Pat tR_Pat to llpPattern
        End
    End_Procedure

    //-------------------------------------------------------------------------

    Procedure OnComDoRetrieveDayEvents DateTime lldtDay Variant llEvents
        Date    dThisDate
        tdEvent tEvent

        Set pvComObject of (Private_phoEvents(Self)) to llEvents
        Move lldtDay to dThisDate

        If (pbUseStdFiles(Self)) Begin
#IFDEF SigCj_Use_StdFiles
            Clear CalEvent
            Move dThisDate to CalEvent.EndDate
            Find GT CalEvent by Index.2
            While (Found)
                If (CalEvent.StartDate <= dThisDate) Begin
                    If ((CalEvent.Recurr_State = OLExtpCalendarRecurrenceNotRecurring) or ;
                        (CalEvent.Recurr_State = OLExtpCalendarRecurrenceMaster)) Begin

                        Get Move_StdFile_Event_To_tdEvent to tEvent
                        Send Add_Event_For_Day tEvent
                    End
                End

                Find GT CalEvent by Index.2
            End
#ENDIF
        End
        Else Begin
            Send OnEvents_For_Day    dThisDate
        End
        If (pbUseStdDates(Self)) Begin
            Send Load_Special_Date dThisDate
        End
        Else Begin
            Send OnLoad_Special_Date dThisDate
        End
    End_Procedure

    Procedure Add_Event_For_Day tdEvent tEvent
        Variant vEvent

        Move (NullComObject()) to vEvent
        Get Create_Event_Object_From_tdEvent tEvent False to vEvent

        If (not(IsNullComObject(vEvent))) Begin
            Send ComAdd of (Private_phoEvents(Self)) vEvent
        End
    End_Procedure

    Procedure OnLoad_Special_Date Date dThisDate
    End_Procedure

    Procedure Load_Special_Date Date dThisDate
        Integer iIndex
        tdCal_Dates tCal_Date
        
#IFDEF SigCj_Use_StdDates
        Clear Cal_Date
        Move dThisDate to Cal_Date.Date_From
        Find Le Cal_Date by Index.1
        If ((Found) and (dThisDate >= Cal_Date.Date_From) and (dThisDate <= Cal_Date.Date_To)) Begin
            Move dThisDate            to tCal_Date.dDate
            Move Cal_Date.Title       to tCal_Date.sTitle
            Move Cal_Date.BackColour  to tCal_Date.iBackColor
            Move Cal_Date.AllDay      to tCal_Date.bAllDay
            Move Cal_Date.AllowEvents to tCal_Date.eAllowEvents
            
            Send Add_Special_Date tCal_Date
        End
#ENDIF
    End_Procedure

    Function Cal_Find_Date tdCal_Dates tCal_Dates tdCal_Dates tDate Returns Integer
        Integer iRetVal
        
        Move (NE) to iRetVal
        If (tCal_Dates.dDate = tDate.dDate) Move (EQ) to iRetVal

        Function_Return iRetVal
    End_Function  

    Function Cal_Special_Date Date dDate Returns Integer
        tdCal_Dates[] tCal_Dates
        tdCal_Dates   tDate
        Integer iDate
        
        Get ptCal_Dates to tCal_Dates
        Move dDate to tDate.dDate
         
        Move (SearchArray(tDate, tCal_Dates, Self, get_Cal_Find_Date)) to iDate
        
        Function_Return iDate        
    End_Function

    Procedure Add_Special_Date tdCal_Dates tCal_Date
        Integer iIndex
        tdCal_Dates[] tCalDates

        //Check if already added 
        If (Cal_Special_Date(Self,tCal_Date.dDate) = -1) Begin
            Get ptCal_Dates to tCalDates
            Move (SizeOfArray(tCalDates)) to iIndex
            Move tCal_Date to tCalDates[iIndex]
            Set ptCal_Dates to tCalDates
        End
    End_Procedure

    Function Cal_BackColor Integer iDate Returns Integer
        tdCal_Dates[] tCal_Dates
        
        Get ptCal_Dates to tCal_Dates
        
        Function_Return tCal_Dates[iDate].iBackColor
    End_Function

    Function Cal_AllDay Integer iDate Returns Boolean
        tdCal_Dates[] tCal_Dates
        
        Get ptCal_Dates to tCal_Dates
        
        Function_Return tCal_Dates[iDate].bAllDay
    End_Function

    Function Cal_AllowEvents Integer iDate Returns Integer
        tdCal_Dates[] tCal_Dates
        
        Get ptCal_Dates to tCal_Dates
        
        Function_Return tCal_Dates[iDate].eAllowEvents
    End_Function

