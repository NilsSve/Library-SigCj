        { DesignTime=False }
        Property String   Private_psPrnFooterRight                   ""
        { DesignTime=False }
        Property String   Private_psPrnHeaderLeft                    ""
        { DesignTime=False }
        Property String   Private_psPrnHeaderCenter                  ""
        { DesignTime=False }
        Property String   Private_psPrnHeaderRight                   ""
        { DesignTime=False }
        Property Number   Private_pnPrnMarginBottom                  1.0
        { DesignTime=False }
        Property Number   Private_pnPrnMarginTop                     1.0
        { DesignTime=False }
        Property Number   Private_pnPrnMarginLeft                    1.0
        { DesignTime=False }
        Property Number   Private_pnPrnMarginRight                   1.0
        { DesignTime=False }
        Property Boolean  Private_pbMultiColumnWeekMode              True

        //---------------------------------------------------------------------

        { Category=Codejock InitialValue=16777215 }
        Property Integer piWorkingCellBackColor     16777215
        { Category=Codejock InitialValue=16248294 }
        Property Integer piNonWorkingCellBackColor  16248294
        { Category=Codejock InitialValue="CAUTION - Special Date" }
        Property String psAllowEventTitle           "CAUTION - Special Date"
        { Category=Codejock InitialValue="Create Event?" }
        Property String psAllowEventText            "Create Event?"
        
        //---------------------------------------------------------------------

        { Category=Codejock }
        Property String  ptmLastWorkDayEndTime      "16:00"
        { Category=Codejock }
