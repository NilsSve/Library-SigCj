    { EnumList="eCal_TimeScale_5, eCal_TimeScale_10, eCal_TimeScale_15, eCal_TimeScale_20, eCal_TimeScale_30, eCal_TimeScale_60" }
    { MethodType=Property Category="CodeJock" InitialValue=eCal_TimeScale_30 }
    Procedure Set peTimeScale Integer eValue
        Handle hoDayView
        Variant vDayView

        If (IsComObjectCreated(Self)) Begin
            Get Create U_cSigCjComCalendarDayView to hoDayView
                Get ComDayView to vDayView
                Set pvComObject  of hoDayView to vDayView
                Set ComTimeScale of hoDayView to eValue
            Send Destroy of hoDayView
        End

        Set Private_peTimeScale to eValue
    End_Procedure

    {MethodType=Property }
    Function peTimeScale Returns Integer
        Integer eValue
        Handle hoDayView
        Variant vDayView

        If (IsComObjectCreated(Self)) Begin
            Get Create U_cSigCjComCalendarDayView to hoDayView
                Get ComDayView to vDayView
                Set pvComObject  of hoDayView to vDayView
                Get ComTimeScale of hoDayView to eValue
            Send Destroy of hoDayView
        End
        Else Begin
            Get Private_peTimeScale to eValue
        End
        Function_Return eValue
    End_Function

