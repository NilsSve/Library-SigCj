        { DesignTime=False }
        Property Handle  Private_phoThemeDayViewCellParams  (Create(Self, U_cSigCjComCalendarThemeDayViewCellParams))
        { DesignTime=False }
        Property Handle  Private_phoDataProvider            (Create(Self, U_cSigCjComCalendarDataProvider))
        { DesignTime=False }
        Property Handle  Private_phoDataProvider_RS         (Create(Self, U_cSigCjComCalendarDataProvider))
        { DesignTime=False }
        Property Handle  Private_phoCategoriesIDs           (Create(Self, U_cSigCjComCalendarEventCategoryIDs))
        { DesignTime=False }
