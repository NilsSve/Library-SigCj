Struct tdEvent
    Integer iURN              //NUM  8.0
    Boolean bAllDayEvent      //NUM  2.0
    String  sBody             //ASC  254
    Integer eBusyStatus       //NUM  2.0
    String  sCategories       //ASC  254
    Date    dCreationDate     //DAT    6
    String  tmCreationTime    //ASC    5
    String  sCustomIcons      //ASC  254
    String  sCustomProp       //ASC  254
    Date    dEndDate          //DAT    6
    String  tmEndTime         //ASC    5
    Integer eImportance       //NUM  2.0
    String  sLabel            //ASC  254
    Date    dLastMod_Date     //DAT    6
    String  tmLastMod_Time    //ASC    5
    String  sLocation         //ASC  254
    Boolean bMeetingFlag      //NUM  2.0
    Boolean bPrivateFlag      //NUM  2.0
    Integer eRecurr_State     //NUM  2.0
    Boolean bReminder         //NUM  2.0
    Integer iRem_MinsBefore   //NUM  8.0
    String  sRem_SoundFile    //ASC  254
    Integer iScheduleID       //NUM  8.0
    Date    dStartDate        //DAT    6
    String  tmStartTime       //ASC    5
    String  sSubject          //ASC  254
    Date    dRE_StartDateOrg  //DAT    6
    String  tmRE_StartTimeOrg //ASC    5
    Date    dRE_EndDateOrg    //DAT    6
    String  tmRE_EndTimeOrg   //ASC    5
    Boolean bRE_Deleted       //NUM  2.0
    Integer iRec_Pattern_id   //NUM  8.0
End_Struct

