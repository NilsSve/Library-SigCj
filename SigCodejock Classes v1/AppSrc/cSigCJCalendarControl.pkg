End_Struct

//=============================================================================
//A global handle is created for the Calendar control. This makes it easier for
//other objects that need to 'connect' to the calendar control. E.G. the
//Data Picker object.

Global_Variable Handle ghoSigCj_Calendar

//=============================================================================
//Datafiles Cal_Sys  - This provides Unique Reference Numbers for the other two files.
//                     (Includes methods to allocate the URNs)
//          CalEvent - This stores the calendar events.
//                     (The DD is not used... but we need the file to be open)
//          CalR_Pat - This stores the Recurrence Paterns for the calendar events.
//                     (The DD is not used... but we need the file to be open)
//          Cal_Cats - This stores the custom categoey details.
//                     (The DD is not used... but we need the file to be open)

#IFDEF SigCj_Use_StdFiles
Use Cal_Sys.DD
Use CalEvent.DD
Use CalR_Pat.DD
Use Cal_Cats.DD
#ENDIF

#IFDEF SigCj_Use_StdDates
Use Cal_Date.DD
#ENDIF

#IFDEF SigCj_Use_StdResources
Use Cal_Lay.DD
Use Cal_Res.DD
Use Cal_Sch.DD
Use Cal_SRL.DD
#ENDIF

//=============================================================================
//Context Menu
//=============================================================================

Define cEventRCCM_RemoveException  for 1
Define cEventRCCM_GotoCRM          for 2    //Not Used

Class cCRM_MenuItem is a cCJMenuItem

    Procedure Construct_Object
        Forward Send Construct_Object

        { DesignTime=False }
        Property Handle  phoCallBack
        { DesignTime=False }
        Property Handle  phmMsg
        { DesignTime=False }
        Property Variant pvEvent

        Set pbEnabled   to False
        Set pbVisible   to False
    End_Procedure

    //-------------------------------------------------------------------------

    Procedure OnExecute Variant vCommandBarControl
        Handle  hoCallBack hmMsg
        Variant vEvent
        String  sMessage

        Get phoCallBack to hoCallBack
        Get phmMsg      to hmMsg
        Get pvEvent     to vEvent

        Send hmMsg of hoCallBack vEvent
    End_Procedure
End_Class

//-----------------------------------------------------------------------------

Class cEventRCCM is a cCJContextMenu

    Procedure Construct_Object
        Forward Send Construct_Object

        Property Integer piItemCount 0

        //Define a cCRM_MenuItem object for each item that may be required.

        Object oRemoveException is a cCRM_MenuItem
        End_Object

        //Object oGotoCRM is a cCRM_MenuItem
        //End_Object

    End_Procedure

    //-------------------------------------------------------------------------

    Procedure ConfigureItem Integer eItem Handle hoCallBack Handle hmMsg String sCaption Boolean bSeparator Variant vEvent
        Handle  hoItem
        Integer iItemCount

//        If (eItem = cEventRCCM_GotoCRM)         Move oGotoCRM         to hoItem
        If (eItem = cEventRCCM_RemoveException) Move oRemoveException to hoItem
        If (hoItem > 0) Begin
            Set phoCallBack of hoItem to hoCallBack
            Set phmMsg      of hoItem to hmMsg
            Set pvEvent     of hoItem to vEvent
            Set psCaption   of hoItem to sCaption
            Set pbEnabled   of hoItem to True
            Set pbVisible   of hoItem to True

            Get piItemCount to iItemCount
            Set piItemCount to (iItemCount + 1)

            If (bSeparator and (iItemCount > 0)) Set pbControlBeginGroup of hoItem to True
        End
    End_Procedure

    //-------------------------------------------------------------------------

    Procedure Display_RCCM
        Send Popup
    End_Procedure
End_Class

//=============================================================================
//Dialogs
//=============================================================================

Class cCJ_CalendarDialogs is a cSigCjComCalendarDialogs
    Procedure Construct_Object
        Boolean bIsComObjectCreated bRetVal
        Handle  hWND
        Variant vCal_ComObject

        Forward Send Construct_Object

        Get IsComObjectCreated to bIsComObjectCreated
        If (not(bIsComObjectCreated)) Begin
            Send CreateComObject
        End

        //Attached the dialogs to the calendar container
        Move (Window_Handle(Parent(Self))) to hWND
        Set ComParentHWND to hWND

        //Attached the dialogs ro the calendar object
        Get pvComObject of ghoSigCj_Calendar to vCal_ComObject
        Set ComCalendar to vCal_ComObject

        //Reminders
        Get ComCreateRemindersWindow to bRetVal
    End_Procedure
End_Class

//=============================================================================
//Date Picker
//=============================================================================

{ DesignerClass=cDTContainer3D }
Class cSigCJCalendarDatePicker is a cSigCjComDatePicker

    Procedure Construct_Object
        Forward Send Construct_Object   // very important!

        Set peAutoCreate to acAutoCreate

        { DesignTime=False }
        Property Boolean Private_pbDayMetrics False

    End_Procedure

    Procedure End_Construct_Object
        Variant vCJ_Cal

        Forward Send End_Construct_Object   // very important!

        //Set defaults
        Set ComBorderStyle     to OLExtpDatePickerBorderNone
        Set ComShowWeekNumbers to True

        //Set Theme
        //We will be using the Office 07 theme, so (as yet) I have not
        //implemented theme changing.
        #IF (SigCj_Codejock_Version < 150103)
        Send Set_Theme_To_Office_07
        #ELSE
        Set ComVisualTheme to OLExtpCalendarThemeResource 
        #ENDIF 

        //Attach to the Calendar control
        Get pvComObject of ghoSigCj_Calendar to vCJ_Cal
        Send ComAttachToCalendar vCJ_Cal
    End_Procedure

    Procedure OnCreate
        Forward Send OnCreate
        
        If (Private_pbDayMetrics(Self)) Begin
            Set ComAskDayMetrics to True
            Send OnSetDateRange
        End 
        
    End_Procedure  
       
   { MethodType=Property Category="CodeJock" InitialValue=False }
    Procedure Set pbDayMetrics Boolean bValue
         Set Private_pbDayMetrics to bValue
    End_Procedure

    Function pbDayMetrics Returns Boolean
        Function_Return (Private_pbDayMetrics(Self))  
    End_Function

    { MethodType=Event }        
    Procedure OnSetDateRange
        // Hook for setting the date range
    End_Procedure

    { MethodType=Event }        
    Procedure OnDayMetrics Handle hoDayMetrics Date dValue
        // Hook, sent for each day in the date range
    End_Procedure
    
    // This will only get called if pbDayMetrics is set to True
    Procedure OnComDayMetrics DateTime llDay Variant llMetrics
        Handle hoDayMetrics 
        Date   dDate

        Move llDay to dDate
        Get Create U_cSigCjComDatePickerDayMetrics to hoDayMetrics
        Set pvComObject of hoDayMetrics to llMetrics
            Send OnDayMetrics hoDayMetrics dDate    
        Send Destroy of hoDayMetrics
    End_Procedure

    #IF (SigCj_Codejock_Version < 150103)
    Procedure Set_Theme_To_Office_07
        Handle hoThemeOffice07
        Variant vTheme

        Get Create U_cSigCjComDatePickerThemeOffice2007 to hoThemeOffice07
            Get pvComObject of hoThemeOffice07 to vTheme
            Send ComSetTheme vTheme
        Send Destroy of hoThemeOffice07
    End_Procedure
    #ENDIF
    
End_Class

