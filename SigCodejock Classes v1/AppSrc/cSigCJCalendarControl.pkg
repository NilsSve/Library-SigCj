    Integer iRoY_MonthOfYear  //NUM 2.0
    Integer iRoY_NthM_OfYear  //NUM 8.0
    Integer iRoY_Nth_Day      //NUM 2.0
    Integer iRoY_Nth_DayMask  //NUM 8.0
End_Struct

Struct tdCal_Category
    Integer iURN            //NUM 2.0
    String  sShort_Desc     //ASC  10
    String  sLong_Desc      //ASC  40
    Integer iBorder_Color  //NUM 8.0
