        //---------------------------------------------------------------------

        { Category="Codejock" InitialValue="" }
        Property String psDataSource ""

        { Category="Codejock" InitialValue=eCal_DT_DataFlex }
        { EnumList="eCal_DT_DataFlex, eCal_DT_OutLook" }
        Property Integer peDataType eCal_DT_DataFlex

        { Category="Codejock" InitialValue=eCal_RS_None }
        { EnumList="eCal_RS_None, eCal_RS_StdFiles, eCal_RS_CustomFiles" }
        Property Integer peUseResources     eCal_RS_None
        { Category=Codejock InitialValue="" }
        Property String  psResourceLayout   ""
        
        { DesignTime=False }
        Property Handle  Private_phoCalResources (Create(Self, U_cSigCjComCalendarResources))
        { DesignTime=False }
        Property Handle  Private_phoCalSchedules (Create(Self, U_cSigCjComCalendarSchedules))

        { DesignTime=False }
        Property Handle  Private_phoResource (Create(Self, U_cSigCjComCalendarResource))
        { DesignTime=False }
        Property Handle  Private_phoSchedule (Create(Self, U_cSigCjComCalendarSchedule))

        { DesignTime=False }
        Property Handle  Private_phoScheduleIDs (Create(Self, U_cSigCjComCalendarScheduleIDs))

        //---------------------------------------------------------------------

#IFDEF SigCj_Use_StdFiles
        Object oeCal_Sys_DD is a Cal_Sys_DataDictionary
        End_Object
#ENDIF
    End_Procedure

    Procedure End_Construct_Object
        Handle  hoOptions
        Variant vOptions

        Forward Send End_Construct_Object   // very important!

        //Set the theme to Office 07... The theme setting has not been implemented (Yet).
        Send Set_Theme_To_Office_07

        //The meeting / private / recurring icons are not displayed by default,
        //they have to be enabled individually and for each view type.
        //This enables all glyphs / icons for all view types.
        Send Enable_Icons

        //This removes the default categories and loads new categoreies from the Cal_Cats table
        //---------------------------------------------------------------------
        Object oe_CJ_CalendarDialogs is a cCJ_CalendarDialogs
        End_Object

        //---------------------------------------------------------------------
    End_Procedure

    Procedure OnCreate
        Handle  hoFlags hoCalResources hoCalSchedules
        Variant vFlags   vCalResources  vCalSchedules
        Integer iUseResources
        
        Forward Send OnCreate

        Set pvComObject of (phoOptions            (Self)) to (ComOptions            (Self))
        Set pvComObject of (phoPrintOptions       (Self)) to (ComPrintOptions       (Self))
        Set pvComObject of (phoPrintPreviewOptions(Self)) to (ComPrintPreviewOptions(Self))
        Set pvComObject of (phoDayView(Self))             to (ComDayView(Self))

        Set peCaptionBar                    to (Private_peCaptionBar                   (Self))
        Set pbEnableReminders               to (Private_pbEnableReminders              (Self))
        Set pbEnableStdToolTips             to (Private_pbEnableStdToolTips            (Self))
        Set psPrintPreviewTitle             to (Private_psPrintPreviewTitle            (Self))
        Set pbUseCustomDialogs              to (Private_pbUseCustomDialogs             (Self))
        Set pbUseCustomCategories           to (Private_pbUseCustomCategories          (Self))
        Set pbClickToAdd                    to (Private_pbClickToAdd                   (Self))
        Set psClickToAddText                to (Private_psClickToAddText               (Self))
        Set peDayViewCurrentTimeMarkVisible to (Private_peDayViewCurrentTimeMarkVisible(Self))
        Set pbDayViewShowMinutes            to (Private_pbDayViewShowMinutes           (Self))
        Set pbInPlaceCreateEvent            to (Private_pbInPlaceCreateEvent           (Self))
        Set pbInPlaceEdit_AfterEventResize  to (Private_pbInPlaceEdit_AfterEventResize (Self))
        Set pbInPlaceEdit_ByF2              to (Private_pbInPlaceEdit_ByF2             (Self))
        Set pbInPlaceEdit_ByMouseClick      to (Private_pbInPlaceEdit_ByMouseClick     (Self))
        Set pbInPlaceEdit_ByTab             to (Private_pbInPlaceEdit_ByTab            (Self))
        Set peFirstDayOfTheWeek             to (Private_peFirstDayOfTheWeek            (Self))
        Set pbCompressWeekendDays           to (Private_pbCompressWeekendDays          (Self))
        Set pbMultiColumnWeekMode           to (Private_pbMultiColumnWeekMode          (Self))
        Set pbUseOutlookGlyphs              to (Private_pbUseOutlookGlyphs             (Self))
        Set peShowEndDate                   to (Private_peShowEndDate                  (Self))
        Set peShowTimeAsClocks              to (Private_peShowTimeAsClocks             (Self))
        Set peTimeScale                     to (Private_peTimeScale                    (Self))
        Set peViewType                      to (Private_peViewType                     (Self))
        Set ptmWorkDayEndTime               to (Private_ptmWorkDayEndTime              (Self))
        Set ptmWorkDayStartTime             to (Private_ptmWorkDayStartTime            (Self))
        Set peWorkWeekMask                  to (Private_peWorkWeekMask                 (Self))
        Set ptmTimeScaleMinTime             to (Private_ptmTimeScaleMinTime            (Self))
        Set ptmTimeScaleMaxTime             to (Private_ptmTimeScaleMaxTime            (Self))

//        Set pbPrnLandscape                  to (Private_pbPrnLandscape                 (Self))
//        Set pbPrnGreyScale                  to (Private_pbPrnGreyScale                 (Self))
//        Set pbPrnPrintDateHeader            to (Private_pbPrnPrintDateHeader           (Self))
//        Set pdtPrnPrintFrom                 to (Private_pdtPrnPrintFrom                (Self))
//        Set pdtPrnPrintTo                   to (Private_pdtPrnPrintTo                  (Self))
//        Set pbPrnFromToExactly              to (Private_pbPrnFromToExactly             (Self))
//        Set psPrnFooterLeft                 to (Private_psPrnFooterLeft                (Self))
//        Set psPrnFooterCenter               to (Private_psPrnFooterCenter              (Self))
//        Set psPrnFooterRight                to (Private_psPrnFooterRight               (Self))
//        Set psPrnHeaderLeft                 to (Private_psPrnHeaderLeft                (Self))
//        Set psPrnHeaderCenter               to (Private_psPrnHeaderCenter              (Self))
//        Set psPrnHeaderRight                to (Private_psPrnHeaderRight               (Self))
//        Set pnPrnMarginBottom               to (Private_pnPrnMarginBottom              (Self))
//        Set pnPrnMarginTop                  to (Private_pnPrnMarginTop                 (Self))
//        Set pnPrnMarginLeft                 to (Private_pnPrnMarginLeft                (Self))
//        Set pnPrnMarginRight                to (Private_pnPrnMarginRight               (Self))


        Get Create U_cSigCjComCalendarFlagsSet to hoFlags
            Get ComBeforeDrawThemeObjectFlags to vFlags
            Set pvComObject of hoFlags to vFlags

            Send ComSetFlag of hoFlags OLExtpCalendarBeforeDraw_DayViewCell
        Send Destroy of hoFlags

        //---------------------------------------------------------------------
        
        Send Set_Single_Data_Source (peDataType(Self)) (psDataSource(Self))
        Get peUseResources to iUseResources

//        If (iUseResources = eCal_RS_None) Begin
//            Send Set_Single_Data_Source (peDataType(Self)) (psDataSource(Self))
//        End
//        Else Begin
        If (iUseResources <> eCal_RS_None) Begin
            Get Private_phoCalResources to hoCalResources
            Send CreateComObject of hoCalResources

            If (iUseResources = eCal_RS_StdFiles) Begin
                Send Load_Resources 
            End
            Else Begin
                Send OnLoad_Resources
            End

            Get pvComObject of hoCalResources to vCalResources
            Send ComSetMultipleResources vCalResources
        End

        //---------------------------------------------------------------------

        Send Setup_Categories
        Send ComPopulate
    End_Procedure

    //=========================================================================

    Procedure OnLoad_Resources
        //Hook
    End_Procedure
    
    Procedure Load_Resources
        Boolean bFound
        Handle  hoCalResources hoResource
        Variant vResource
        Integer iLast_Res
        String  sLayout
        
#IFDEF SigCj_Use_StdResources
        Get psResourceLayout to sLayout
        
        Clear Cal_Lay
        Move sLayout to Cal_Lay.Title
        Find Eq Cal_Lay by Index.2
        If (Found) Begin
            Clear Cal_SRL
            Move Cal_Lay.ID to Cal_SRL.Layout
            Repeat 
                Find GT Cal_SRL by Index.1
                Move (Found) to bFound
                If (bFound) Move (Cal_SRL.Layout = Cal_Lay.ID) to bFound
                If (bFound) Begin
                    Relate Cal_SRL  
                    Clear Cal_Res
                    Move Cal_SRL.Resource to Cal_Res.ID
                    Find Eq Cal_Res by Index.1 
                    Clear Cal_Sch
                    Move Cal_SRL.Schedule to Cal_Sch.ID
                    Find Eq Cal_Sch by Index.1 
                    Send Add_Resource_And_Schedule (Trim(Cal_Res.Title)) Cal_Sch.ID (Trim(Cal_Sch.Title)) Cal_Res.DataType (Trim(Cal_Res.DataSource))
                End
            Until (not(bFound))
        End
        Else Begin
            Error 5001 "Invalid Calendar Layout Title"    
            Send Close_panel
        End
#ENDIF
    End_Procedure

    //Add Resource / schedule
    
    Procedure Add_Resource_And_Schedule String sResourceName Integer iScheduleID String sScheduleName Integer iDataType String sDataSource
        Boolean bFound bOK
        Handle hoResource hoSchedule hoScheduleIDs hoDataProvider hoCalSchedules hoCalResources 
        Variant vResource  vSchedule  vScheduleIDs  vDataProvider  vCalSchedules
        Integer iCount iLoop
        String sName
        
        Get Private_phoDataProvider_RS to hoDataProvider

        //---------------------------------------------------------------------
        //Find / Add Resource
        Get Private_phoCalResources to hoCalResources
        Get Private_phoResource     to hoResource
        
        Get ComCount of hoCalResources to iCount
        Decrement iCount    // zero based
        Move False to bFound
        For iLoop from 0 to iCount
            Get ComItem of hoCalResources iLoop to vResource
            Set pvComObject of hoResource to vResource
            Get ComName of hoResource to sName             
            If (sName = sResourceName) Begin
                Move True to bFound
                
                //Bomb loop as found. This leaves hoResource pointing to the 
                //corrrect resource object.
                Move iCount to iLoop    
            End
        Loop

        If (not(bFound)) Begin
            //Not found so add a resource object.
            Get Create U_cSigCjComCalendarResource to hoResource
            Send CreateComObject of hoResource
            Get pvComObject of hoResource to vResource
            Set ComName of hoResource to sResourceName
            Send ComAdd of hoCalResources vResource

            If (iDataType = eCal_DT_DataFlex) Begin
                Get pvComObject of hoDataProvider to vDataProvider
                //Need to create the data provider the first time, after that
                //we will use the same object. This is just for DataFlex files.
                If (IsNullComObject(vDataProvider)) Begin
                    Send ComSetDataProvider2 of hoResource ("Provider="+eCal_DataProvider_Custom+";DSN=Not Needed") True
                    Get ComDataProvider of hoResource to vDataProvider
                    Set pvComObject of hoDataProvider to vDataProvider
                    Get ComOpen of hoDataProvider to bOK
                    If (not(bOK)) Begin
                        Get ComCreate of hoDataProvider to bOK
                    End
                End
                Else Begin
                    Send ComSetDataProvider of hoResource vDataProvider False
                End
            End
            Else Begin
                //For PST files we will create a new data provider for each
                //resource.
                Send ComSetDataProvider2 of hoResource ("Provider="+eCal_DataProvider_Outlook+";DSN="+sDataSource) True
                Get ComDataProvider of hoResource to vDataProvider
                Set pvComObject of hoDataProvider to vDataProvider
                Get ComOpen of hoDataProvider to bOK
                If (not(bOK)) Begin
                    Get ComCreate of hoDataProvider to bOK
                End
            End
        End
        
        //---------------------------------------------------------------------
        //Find / Add Schedule
        Get Private_phoCalSchedules to hoCalSchedules
        Get ComSchedules of hoDataProvider to vCalSchedules
        Set pvComObject of hoCalSchedules to vCalSchedules
        
        Get Private_phoSchedule to hoSchedule
        
        Get ComCount of hoCalSchedules to iCount
        Decrement iCount    // zero based
        Move False to bFound
        For iLoop from 0 to iCount
            Get ComItem of hoCalSchedules iLoop to vSchedule
            Set pvComObject of hoSchedule to vSchedule

            //The ID could be used to find the schedule, but the name is used
            //for consistancy with the Resource above. 
            Get ComName of hoSchedule to sName             
            If (sName = sScheduleName) Begin
                Move True to bFound
                
                //Bomb loop as found. This leaves hoSchedule pointing to the 
                //corrrect schedule object.
                Move iCount to iLoop    
            End
        Loop
        
        If (not(bFound)) Begin
            //Not found so add a schedule object.
            Get ComAddNewSchedule of hoCalSchedules sScheduleName to bOK
            If (bOK) Begin
                Get ComCount of hoCalSchedules to iCount
                Decrement iCount
                Get ComItem of hoCalSchedules iCount to vSchedule
                Set pvComObject of hoSchedule to vSchedule
                Set ComId of hoSchedule to iScheduleID
            End
        End

        //---------------------------------------------------------------------
        //Find / Attach Resource and Scehdule
        If (iDataType = eCal_DT_DataFlex) Begin
        Get ComExistsScheduleID of hoResource iScheduleID False to bFound
        If (not(bFound)) Begin
            Get Private_phoScheduleIDs to hoScheduleIDs
            Get ComScheduleIDs of hoResource to vScheduleIDs
            Set pvComObject of hoScheduleIDs to vScheduleIDs
            
            Send ComAdd of hoScheduleIDs iScheduleID 
        End
        End    
    End_Procedure

    //=========================================================================
    //Property Methods
    //=========================================================================

    { MethodType=Property Category="CodeJock" InitialValue=eCal_FullCaptionBar }
    { EnumList="eCal_NoCaptionBar, eCal_CaptionBarDateLabel, eCal_CaptionBarScrollDateButtons, eCal_CaptionBarSwitchViewButtons, eCal_FullCaptionBar" }
    Procedure Set peCaptionBar Integer eCaption

        If (IsComObjectCreated(Self)) Begin
            Set ComShowCaptionBar                  to (eCaption iand eCal_ShowCaptionBar)
            Set ComShowCaptionBarDateLabel         to (eCaption iand eCal_CaptionBarDateLabel)
            Set ComShowCaptionBarScrollDateButtons to (eCaption iand eCal_CaptionBarScrollDateButtons)
            Set ComShowCaptionBarSwitchViewButtons to (eCaption iand eCal_CaptionBarSwitchViewButtons)
#IF (SigCj_Codejock_Version > 120101) 
            //New for 13.0.0 - Time Line mode. Disable the button until we implement support for this.
            Set ComShowTimelineButton to False
#ENDIF
        End

        Set Private_peCaptionBar to eCaption
    End_Procedure

    Function peCaptionBar Returns Integer
        Boolean bValue
        Integer eCaption

        If (IsComObjectCreated(Self)) Begin
            Get ComShowCaptionBar to eCaption

            Get ComShowCaptionBarDateLabel to bValue
            If (bValue) Move (eCaption ior eCal_CaptionBarDateLabel) to eCaption

            Get ComShowCaptionBarScrollDateButtons to bValue
            If (bValue) Move (eCaption ior eCal_CaptionBarScrollDateButtons) to eCaption

            Get ComShowCaptionBarSwitchViewButtons to bValue
            If (bValue) Move (eCaption ior eCal_CaptionBarSwitchViewButtons) to eCaption
        End
        Else Get Private_peCaptionBar to eCaption

        Function_Return eCaption
    End_Function

