        { DesignTime=False }
        Property Boolean  Private_pbEnableStdToolTips                True
        { DesignTime=False }
        Property String   Private_psPrintPreviewTitle                ""
        { DesignTime=False }
        Property Boolean  Private_pbUseCustomDialogs                 False
        { DesignTime=False }
        Property Boolean  Private_pbUseCustomCategories              False
        { DesignTime=False }
        Property Boolean  Private_pbClickToAdd                       True
        { DesignTime=False }
        Property String   Private_psClickToAddText                   //
        { DesignTime=False }
        Property Integer  Private_peDayViewCurrentTimeMarkVisible    eCal_TM_VisibleAlways
        { DesignTime=False }
        Property Boolean  Private_pbDayViewShowMinutes               True
        { DesignTime=False }
        Property Boolean  Private_pbInPlaceCreateEvent               False
        { DesignTime=False }
        Property Boolean  Private_pbInPlaceEdit_AfterEventResize     False
        { DesignTime=False }
        Property Boolean  Private_pbInPlaceEdit_ByF2                 False
        { DesignTime=False }
        Property Boolean  Private_pbInPlaceEdit_ByMouseClick         False
        { DesignTime=False }
        Property Boolean  Private_pbInPlaceEdit_ByTab                False
        { DesignTime=False }
        Property Integer  Private_peFirstDayOfTheWeek                eCal_Sunday
        { DesignTime=False }
        Property Boolean  Private_pbCompressWeekendDays              True
        { DesignTime=False }
        Property Boolean  Private_pbUseOutlookGlyphs                 False
        { DesignTime=False }
        Property Integer  Private_peShowEndDate                      eCal_MW_None
