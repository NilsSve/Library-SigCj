    { MethodType=Property Category="CodeJock" InitialValue=eCal_ViewType_Working }
    { EnumList="eCal_ViewType_Day, eCal_ViewType_Working, eCal_ViewType_Week, eCal_ViewType_Month, eCal_ViewType_FullWeek" }
    Procedure Set peViewType Integer eValue
        Set SigCjProperty Set_Private_peViewType Set_ComViewType to eValue
