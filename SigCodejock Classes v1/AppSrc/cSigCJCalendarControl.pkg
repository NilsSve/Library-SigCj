        //dummy to be over ridden
    End_Procedure

    //-------------------------------------------------------------------------

    Procedure GetHitCode Variant ByRef vViewEvent Integer ByRef iHitCode
        Handle  hoActiveView hoHitTest
        Variant vActiveView vHitTest
        DateTime dtHitDateTime
        
        Get Create U_cSigCjComCalendarView to hoActiveView
            Get ComActiveView to vActiveView
            Set pvComObject of hoActiveView to vActiveView

            Get Create U_cSigCjComCalendarHitTestInfo to hoHitTest
                Get ComHitTest of hoActiveView to vHitTest
                Set pvComObject of hoHitTest to vHitTest

                Get ComHitCode   of hoHitTest to iHitCode
                Get ComViewEvent of hoHitTest to vViewEvent
                
                //We save the Hit date & Time here as we have it.
                //This is used with Special Dates Allow Edit when showing dialogs 
                Get ComHitDateTime of hoHitTest to dtHitDateTime
                Set pdtHitDateTime to dtHitDateTime
                
            Send Destroy of hoHitTest
        Send Destroy of hoActiveView
    End_Procedure

    //-------------------------------------------------------------------------

    Procedure OnComPrePopulate Variant llViewGroup Variant llEvents
        Boolean bReminder bOccurrence bException bMeeting bPrivate
        Integer iCount iLoop iRecState
        Handle  hoEvent hoCustomIcons hoEvents
        Variant vEvent  vCustomIcons

        Get Create U_cSigCjComCalendarEvents to hoEvents
            Set pvComObject of hoEvents to llEvents

            Get ComCount of hoEvents to iCount
            Decrement iCount

            For iLoop from 0 to iCount
                Get ComEvent of hoEvents iLoop to vEvent
                Get Create U_cSigCjComCalendarEvent to hoEvent
                    Set pvComObject of hoEvent to vEvent

                    Get ComReminder    of hoEvent to bReminder
                    Get ComMeetingFlag of hoEvent to bMeeting
                    Get ComPrivateFlag of hoEvent to bPrivate

                    Get ComRecurrenceState of hoEvent to iRecState
                    Move (iRecState = OLExtpCalendarRecurrenceOccurrence) to bOccurrence
                    Move (iRecState = OLExtpCalendarRecurrenceException ) to bException

                    Get ComCustomIcons of hoEvent to vCustomIcons
                    Get Create U_cSigCjComCalendarIconIDs to hoCustomIcons
                        Set pvComObject of hoCustomIcons to vCustomIcons

                        If (bReminder  ) Send ComAddIfNeed of hoCustomIcons OLExtpCalendarEventIconIDReminder
                        Else             Send ComRemoveID  of hoCustomIcons OLExtpCalendarEventIconIDReminder

                        If (bOccurrence) Send ComAddIfNeed of hoCustomIcons OLExtpCalendarEventIconIDOccurrence
                        Else             Send ComRemoveID  of hoCustomIcons OLExtpCalendarEventIconIDOccurrence

                        If (bException ) Send ComAddIfNeed of hoCustomIcons OLExtpCalendarEventIconIDException
                        Else             Send ComRemoveID  of hoCustomIcons OLExtpCalendarEventIconIDException

                        If (bMeeting   ) Send ComAddIfNeed of hoCustomIcons OLExtpCalendarEventIconIDMeeting
                        Else             Send ComRemoveID  of hoCustomIcons OLExtpCalendarEventIconIDMeeting

                        If (bPrivate   ) Send ComAddIfNeed of hoCustomIcons OLExtpCalendarEventIconIDPrivate
                        Else             Send ComRemoveID  of hoCustomIcons OLExtpCalendarEventIconIDPrivate
                    Send Destroy of hoCustomIcons
                Send Destroy of hoEvent
            Loop

        Send Destroy of hoEvents
    End_Procedure

    //-------------------------------------------------------------------------

    Procedure OnComDblClick
        Integer iHitCode iEventID
        Handle  hoViewEvent hoEvent
        Variant vViewEvent vEvent

        Move (NullComObject()) to vViewEvent
        Send GetHitCode (&vViewEvent) (&iHitCode)

        If ((iHitCode =    1) or ;
            (iHitCode = 8193)) Begin
            Send Show_Built_In_Dialog eCal_Dialog_NewEvent vEvent //vEvent not need for NewEvent
        End
        If ((iHitCode =    32) or ;
            (iHitCode =  8208) or ;
            (iHitCode =  8224) or ;
            (iHitCode =  9472) or ;
            (iHitCode = 10496)) Begin
            //Now need the Event from the ViewEvent
            Get Create U_cSigCjComCalendarViewEvent to hoViewEvent
                Set pvComObject of hoViewEvent to vViewEvent
                Get ComEvent of hoViewEvent to vEvent
            Send Destroy of hoViewEvent

            Send Show_Built_In_Dialog eCal_Dialog_EditEvent vEvent
        End
    End_Procedure

    //-------------------------------------------------------------------------

    Procedure OnComMouseUp Short llButton Short llShift OLE_XPOS_PIXELS llx OLE_YPOS_PIXELS lly
        Boolean bAddRemoveException bAddGotoCRM
        Integer iRecState iCRM_Link iHitCode
        Handle  hoViewEvent hoEvent hoCustomProps hoRCCM
        Variant vViewEvent  vEvent  vCustomProps

        If (llButton = eCal_Mouse_Button_Right) Begin

            Send GetHitCode (&vViewEvent) (&iHitCode)
            If (iHitCode = 8224) Begin
                //Now need the Event from the ViewEvent
                Get Create U_cSigCjComCalendarViewEvent to hoViewEvent
                    Set pvComObject of hoViewEvent to vViewEvent
                    Get ComEvent of hoViewEvent to vEvent
                Send Destroy of hoViewEvent

                Get Create U_cSigCjComCalendarEvent to hoEvent
                    Set pvComObject of hoEvent to vEvent

                    Get ComRecurrenceState of hoEvent to iRecState
                    If (iRecState = OLExtpCalendarRecurrenceException) Move True to bAddRemoveException

                    Get ComCustomProperties of hoEvent to vCustomProps
                    Get Create U_cSigCjComCalendarCustomProperties to hoCustomProps
                        Set pvComObject of hoCustomProps to vCustomProps

                        Get ComProperty of hoCustomProps "CRM_Link" to iCRM_Link
                    Send Destroy of hoCustomProps
                    Move (iCRM_Link > 0) to bAddGotoCRM
                Send Destroy of hoEvent
            End
        End

        If (bAddRemoveException or bAddGotoCRM) Begin
            Get Create U_cEventRCCM to hoRCCM
                If (bAddGotoCRM)         Send ConfigureItem of hoRCCM cEventRCCM_GotoCRM         (Self) "msg_GotoCRM"         "Goto CRM Entry"   True vEvent
                If (bAddRemoveException) Send ConfigureItem of hoRCCM cEventRCCM_RemoveException (Self) "msg_RemoveException" "Remove Exception" True vEvent

                Send Display_RCCM of hoRCCM
            Send Destroy of hoRCCM
        End
    End_Procedure

