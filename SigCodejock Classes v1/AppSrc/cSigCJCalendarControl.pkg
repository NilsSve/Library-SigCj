    { MethodType=Property Category="CodeJock" InitialValue="17:00" }
    Procedure Set ptmWorkDayEndTime String tmValue
        DateTime dtWork
        Integer iHour iMins

        Set Private_ptmWorkDayEndTime to tmValue
        If (phoOptions(Self) and IsComObjectCreated(phoOptions(Self))) Begin
            //Have to get current value... Codejock issue
            //and then set the hours and mins from integers... Dataflex issue
            //Fun working this lot out!!!!
            Get ComWorkDayEndTime of (phoOptions(Self)) to dtWork
            Get SigCj_GetHours   tmValue to iHour
            Get SigCj_GetMinutes tmValue to iMins
            Move (DateSetHour  (dtWork, iHour)) to dtWork
            Move (DateSetMinute(dtWork, iMins)) to dtWork

            //Now we can set the time!!
            Set ComWorkDayEndTime of (phoOptions(Self)) to dtWork
        End

    End_Procedure

    Function ptmWorkDayEndTime Returns String
        //We always return our private property as the COM property is returned as a DateTime
        Function_Return (Private_ptmWorkDayEndTime(Self))
    End_Function

