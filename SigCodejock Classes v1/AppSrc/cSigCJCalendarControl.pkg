    Integer iRoD_Int_Days     //NUM 4.0
    Integer iRoData1          //NUM 8.0
    Integer iRoData2          //NUM 8.0
    Integer iRoData3          //NUM 8.0
    Integer iRoData4          //NUM 8.0
    Integer iRoM_DayOfMonth   //NUM 2.0
    Integer iRoM_Int_Months   //NUM 8.0
    Integer iRoM_NthInt_Mths  //NUM 8.0
