{ OverrideProperty=Color                     InitialValue=clActiveCaption }
Class cSigCJCalendarControl is a cSigCjComCalendarControl
    Import_Class_Protocol cSigCJMethods_Mixin

    //=========================================================================

    Procedure Construct_Object
        Forward Send Construct_Object

        Set peAutoCreate to acAutoCreate
        Move Self to ghoSigCj_Calendar

        //---------------------------------------------------------------------

        { Visibility=Private DesignTime=False }
        Property Handle phoOptions
        { Visibility=Private DesignTime=False }
        Property Handle phoPrintOptions
        { Visibility=Private DesignTime=False }
        Property Handle phoPrintPreviewOptions

        { DesignTime=False }
        Property tdEvent        ptEvent_Buffer
        { DesignTime=False }
        Property tdR_Pat        ptR_Pat_Buffer
        { DesignTime=False }
        Property tdCal_Dates[]  ptCal_Dates
        
        //---------------------------------------------------------------------

        { DesignTime=False }
        Property Boolean  pbUseIcons                         True
        { DesignTime=False }
        Property Boolean  pbUseCustomIcons                   False
        { DesignTime=False }
        Property Boolean  pbUseCustomProperties              False
        { DesignTime=False }
        Property DateTime pdtHitDateTime
        { DesignTime=False }
        Property Integer  Private_peCaptionBar                       eCal_FullCaptionBar
        { DesignTime=False }
