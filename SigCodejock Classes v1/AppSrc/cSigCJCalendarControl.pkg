    Procedure OnComDoGetUpcomingEvents DateTime lldtFrom Integer llPeriodMinutes Variant llpEvents
        Boolean  bFound
        DateTime dtTo dtStart
        TimeSpan tsTo
        tdEvent  tEvent
        Handle   hoEvents
        Variant  vEvent

        //Workout To Date Time
        Move (DateSetHour(tsTo, (llPeriodMinutes / 60))) to tsTo
        Move (DateSetMinute(tsTo, mod(llPeriodMinutes,60))) to tsTo
        Move (lldtFrom + tsTo) to dtTo

        Get Private_phoEvents to hoEvents
        Set pvComObject of hoEvents to llpEvents

        If (pbUseStdFiles(Self)) Begin
#IFDEF SigCj_Use_StdFiles
            Clear CalEvent
            Move lldtFrom  to CalEvent.StartDate
            Move (DateTime_to_Time(Self,lldtFrom)) to CalEvent.StartTime
            Find Gt CalEvent by Index.4
            While (Found)
                Move (Date_and_Time_to_DateTime(Self,CalEvent.StartDate, CalEvent.StartTime)) to dtStart
                If ((dtStart >= lldtFrom) and (dtStart <= dtTo)) Begin
                    Get Move_StdFile_Event_To_tdEvent to tEvent

                    Send Add_Upcoming_Event tEvent
                End
                Find Gt CalEvent by Index.4
            Loop
#ENDIF
        End
        Else Begin
            Send OnEvent_GetUpcoming lldtFrom dtTo
        End
    End_Procedure

    Procedure Add_Upcoming_Event tdEvent tEvent
        Variant vEvent

        Get Create_Event_Object_From_tdEvent tEvent False to vEvent

        If (not(IsNullComObject(vEvent))) Begin
            Send ComAdd of (Private_phoEvents(Self)) vEvent
        End
    End_Procedure

    //=========================================================================
    //Std File --> Buffer methods
    //=========================================================================

#IFDEF SigCj_Use_StdFiles
    Function Move_StdFile_Event_To_tdEvent Returns tdEvent
        tdEvent tEvent

        Move CalEvent.URN               to tEvent.iURN
        Move CalEvent.AllDayEvent       to tEvent.bAllDayEvent
        Move CalEvent.Body              to tEvent.sBody
        Move CalEvent.BusyStatus        to tEvent.eBusyStatus
        Move CalEvent.Categories        to tEvent.sCategories
        Move CalEvent.CreationDate      to tEvent.dCreationDate
        Move CalEvent.CreationTime      to tEvent.tmCreationTime
        Move CalEvent.CustomIcons       to tEvent.sCustomIcons
        Move CalEvent.CustomProp        to tEvent.sCustomProp
        Move CalEvent.EndDate           to tEvent.dEndDate
        Move CalEvent.EndTime           to tEvent.tmEndTime
        Move CalEvent.Importance        to tEvent.eImportance
        Move CalEvent.Label             to tEvent.sLabel
        Move CalEvent.LastMod_Date      to tEvent.dLastMod_Date
        Move CalEvent.LastMod_Time      to tEvent.tmLastMod_Time
        Move CalEvent.Location          to tEvent.sLocation
        Move CalEvent.MeetingFlag       to tEvent.bMeetingFlag
        Move CalEvent.PrivateFlag       to tEvent.bPrivateFlag
        Move CalEvent.Recurr_State      to tEvent.eRecurr_State
        Move CalEvent.Reminder          to tEvent.bReminder
        Move CalEvent.Rem_MinsBefore    to tEvent.iRem_MinsBefore
        Move CalEvent.Rem_SoundFile     to tEvent.sRem_SoundFile
        Move CalEvent.ScheduleID        to tEvent.iScheduleID
        Move CalEvent.StartDate         to tEvent.dStartDate
        Move CalEvent.StartTime         to tEvent.tmStartTime
        Move CalEvent.Subject           to tEvent.sSubject
        Move CalEvent.RE_StartDateOrg   to tEvent.dRE_StartDateOrg
        Move CalEvent.RE_StartTimeOrg   to tEvent.tmRE_StartTimeOrg
        Move CalEvent.RE_EndDateOrg     to tEvent.dRE_EndDateOrg
        Move CalEvent.RE_EndTimeOrg     to tEvent.tmRE_EndTimeOrg
        Move CalEvent.RE_Deleted        to tEvent.bRE_Deleted
        Move CalEvent.Rec_Pattern_id    to tEvent.iRec_Pattern_id

        Function_Return tEvent
    End_Function

    //-------------------------------------------------------------------------

    Function Move_StdFile_R_Pat_To_tdR_Pat Returns tdR_Pat
        tdR_Pat tR_Pat

        Move CalR_Pat.URN               to tR_Pat.iURN
        Move CalR_Pat.CustomProp_XML    to tR_Pat.sCustomProp_XML
        Move CalR_Pat.DurationMinutes   to tR_Pat.iDurationMinutes
        Move CalR_Pat.EndAfterOcc       to tR_Pat.iEndAfterOcc
        Move CalR_Pat.EndDate           to tR_Pat.dEndDate
        Move CalR_Pat.EndMethod         to tR_Pat.eEndMethod
        Move CalR_Pat.MasterEventId     to tR_Pat.iMasterEventId
        Move CalR_Pat.StartDate         to tR_Pat.dStartDate
        Move CalR_Pat.StartTime         to tR_Pat.tmStartTime
        Move CalR_Pat.roD_WeekDayOnly   to tR_Pat.bRoD_WeekDayOnly
        Move CalR_Pat.roD_Int_Days      to tR_Pat.iRoD_Int_Days
        Move CalR_Pat.roData1           to tR_Pat.iRoData1
        Move CalR_Pat.roData2           to tR_Pat.iRoData2
        Move CalR_Pat.roData3           to tR_Pat.iRoData3
        Move CalR_Pat.roData4           to tR_Pat.iRoData4
        Move CalR_Pat.roM_DayOfMonth    to tR_Pat.iRoM_DayOfMonth
        Move CalR_Pat.roM_Int_Months    to tR_Pat.iRoM_Int_Months
        Move CalR_Pat.roM_NthInt_Mths   to tR_Pat.iRoM_NthInt_Mths
        Move CalR_Pat.roM_Nth_Day       to tR_Pat.iRoM_Nth_Day
        Move CalR_Pat.roM_Nth_DayMask   to tR_Pat.eRoM_Nth_DayMask
        Move CalR_Pat.roRecurr_Type     to tR_Pat.eRoRecurr_Type
        Move CalR_Pat.roW_DayWeekMask   to tR_Pat.eRoW_DayWeekMask
        Move CalR_Pat.roW_Int_Weeks     to tR_Pat.iRoW_Int_Weeks
        Move CalR_Pat.roY_DayOfMonth    to tR_Pat.iRoY_DayOfMonth
        Move CalR_Pat.roY_MonthOfYear   to tR_Pat.iRoY_MonthOfYear
        Move CalR_Pat.roY_NthM_OfYear   to tR_Pat.iRoY_NthM_OfYear
        Move CalR_Pat.roY_Nth_Day       to tR_Pat.iRoY_Nth_Day
        Move CalR_Pat.roY_Nth_DayMask   to tR_Pat.iRoY_Nth_DayMask

        Function_Return tR_Pat
    End_Function
#ENDIF

    //=========================================================================
    //Buffer --> Object methods
    //=========================================================================

    Function Create_Event_Object_From_tdEvent tdEvent tEvent Boolean bRException Returns Variant
        Handle   hoDataProvider hoEvent hoCategories hoCustomIcons hoCustomProps hoDiary_CallBack
        Integer  iURN
        DateTime dtWork
        Variant  vEvent vCategories vCustomIcons vCustomProps

        Get Private_phoDataProvider to hoDataProvider

        Get Private_phoEvent to hoEvent
        Get ComCreateEventEx of hoDataProvider tEvent.iURN to vEvent
        Set pvComObject of hoEvent to vEvent

        Set ComBody                         of hoEvent to (Trim(tEvent.sBody))
        Set ComSubject                      of hoEvent to (Trim(tEvent.sSubject))
        Set ComLocation                     of hoEvent to (Trim(tEvent.sLocation))

        Set ComAllDayEvent                  of hoEvent to tEvent.bAllDayEvent
        Set ComBusyStatus                   of hoEvent to tEvent.eBusyStatus
        Set ComImportance                   of hoEvent to tEvent.eImportance
        Set ComLabel                        of hoEvent to (Trim(tEvent.sLabel))
        Set ComMeetingFlag                  of hoEvent to tEvent.bMeetingFlag
        Set ComPrivateFlag                  of hoEvent to tEvent.bPrivateFlag
        Set ComReminder                     of hoEvent to tEvent.bReminder
        Set ComReminderMinutesBeforeStart   of hoEvent to tEvent.iRem_MinsBefore
        Set ComReminderSoundFile            of hoEvent to (Trim(tEvent.sRem_SoundFile))
        Set ComScheduleID                   of hoEvent to tEvent.iScheduleID

        If (tEvent.eRecurr_State <> OLExtpCalendarRecurrenceMaster) Begin
            Get Date_and_Time_to_DateTime tEvent.dStartDate tEvent.tmStartTime to dtWork
            Set ComStartTime of hoEvent to dtWork

            Get Date_and_Time_to_DateTime tEvent.dEndDate   tEvent.tmEndTime   to dtWork
            Set ComEndTime of hoEvent to dtWork
        End

        Get ComCategories of hoEvent to vCategories
        Get Private_phoCategoriesIDs to hoCategories
        Set pvComObject of hoCategories to vCategories
        Send ComLoadFromString of hoCategories tEvent.sCategories

        Get ComCustomIcons of hoEvent to vCustomIcons
        Get Private_phoCustomIcons to hoCustomIcons
        Set pvComObject of hoCustomIcons to vCustomIcons
        Send ComLoadFromString of hoCustomIcons tEvent.sCustomIcons

        Get ComCustomProperties of hoEvent to vCustomProps
        Get Private_phoCustomProps to hoCustomProps
        Set pvComObject of hoCustomProps to vCustomProps
        Send ComLoadFromString of hoCustomProps tEvent.sCustomProp

        If (bRException) Begin
            Send ComMakeAsRException of hoEvent

            //These are Hidden !!!!!!!!!!!!
            Get Date_and_Time_to_DateTime tEvent.dRE_StartDateOrg tEvent.tmRE_StartTimeOrg to dtWork
            Set ComRExceptionStartTimeOrig of hoEvent to dtWork

            Get Date_and_Time_to_DateTime tEvent.dRE_EndDateOrg   tEvent.tmRE_EndTimeOrg   to dtWork
            Set ComRExceptionEndTimeOrig of hoEvent to dtWork

            Set ComRExceptionDeleted       of hoEvent to tEvent.bRE_Deleted
        End
        Else Begin
            Set ComProperty of hoCustomProps "process_RecurrenceState"     to tEvent.eRecurr_State
            Set ComProperty of hoCustomProps "process_RecurrencePatternID" to tEvent.iRec_Pattern_id
        End

        Function_Return vEvent
    End_Function

    //-------------------------------------------------------------------------

    Function Create_R_Pat_Object_From_tdR_Pat tdR_Pat tR_Pat Returns Variant
        Handle   hoDataProvider hoR_Pat hoR_Pat_Options hoCustomProps
        DateTime dtWork
        Variant  vR_Pat vR_Pat_Options vCustomProps

        Get Private_phoDataProvider to hoDataProvider

        Get Private_phoR_Pat to hoR_Pat
        Get ComCreateRecurrencePattern of hoDataProvider tR_Pat.iURN to vR_Pat
        Set pvComObject of hoR_Pat to vR_Pat

        Set ComMasterEventId   of hoR_Pat to tR_Pat.iMasterEventId
        Set ComDurationMinutes of hoR_Pat to tR_Pat.iDurationMinutes
        Set ComEndMethod       of hoR_Pat to tR_Pat.eEndMethod

        Case Begin
            Case (tR_Pat.eEndMethod = OLExtpCalendarPatternEndDate)
                Set ComEndDate of hoR_Pat to tR_Pat.dEndDate
            Case Break

            Case (tR_Pat.eEndMethod = OLExtpCalendarPatternEndAfterOccurrences)
                Set ComEndAfterOccurrences of hoR_Pat to tR_Pat.iEndAfterOcc
            Case Break

            Case Else
                //if no end info change end type
                Set ComEndMethod of hoR_Pat to OLExtpCalendarPatternEndNoDate
        Case End

        Set ComStartDate of hoR_Pat to tR_Pat.dStartDate
        Get Date_and_Time_to_DateTime tR_Pat.dStartDate tR_Pat.tmStartTime to dtWork
        Set ComStartTime of hoR_Pat to dtWork

        Get ComOptions of hoR_Pat to vR_Pat_Options
        Get Private_phoR_Pat_Options to hoR_Pat_Options
        Set pvComObject of hoR_Pat_Options to vR_Pat_Options

        Set ComDailyEveryWeekDayOnly  of hoR_Pat_Options to tR_Pat.bRoD_WeekDayOnly
        Set ComDailyIntervalDays      of hoR_Pat_Options to tR_Pat.iRoD_Int_Days
        Set ComData1                  of hoR_Pat_Options to tR_Pat.iRoData1
        Set ComData2                  of hoR_Pat_Options to tR_Pat.iRoData2
        Set ComData3                  of hoR_Pat_Options to tR_Pat.iRoData3
        Set ComData4                  of hoR_Pat_Options to tR_Pat.iRoData4
        Set ComMonthlyDayOfMonth      of hoR_Pat_Options to tR_Pat.iRoM_DayOfMonth
        Set ComMonthlyIntervalMonths  of hoR_Pat_Options to tR_Pat.iRoM_Int_Months
        Set ComMonthNthIntervalMonths of hoR_Pat_Options to tR_Pat.iRoM_NthInt_Mths
        Set ComMonthNthWhichDay       of hoR_Pat_Options to tR_Pat.iRoM_Nth_Day
        Set ComMonthNthWhichDayMask   of hoR_Pat_Options to tR_Pat.eRoM_Nth_DayMask
        Set ComRecurrenceType         of hoR_Pat_Options to tR_Pat.eRoRecurr_Type
        Set ComWeeklyDayOfWeekMask    of hoR_Pat_Options to tR_Pat.eRoW_DayWeekMask
        Set ComWeeklyIntervalWeeks    of hoR_Pat_Options to tR_Pat.iRoW_Int_Weeks
        Set ComYearlyDayOfMonth       of hoR_Pat_Options to tR_Pat.iRoY_DayOfMonth
        Set ComYearlyMonthOfYear      of hoR_Pat_Options to tR_Pat.iRoY_MonthOfYear
        Set ComYearNthMonthOfYear     of hoR_Pat_Options to tR_Pat.iRoY_NthM_OfYear
        Set ComYearNthWhichDay        of hoR_Pat_Options to tR_Pat.iRoY_Nth_Day
        Set ComYearNthWhichDayMask    of hoR_Pat_Options to tR_Pat.iRoY_Nth_DayMask

        Get ComCustomProperties of hoR_Pat to vCustomProps
        Get Private_phoCustomProps to hoCustomProps
        Set pvComObject of hoCustomProps to vCustomProps
        Send ComLoadFromString of hoCustomProps tR_Pat.sCustomProp_XML

        Send ReadRPatternExceptions

        Function_Return vR_Pat
    End_Function

    //-------------------------------------------------------------------------

    Procedure ReadRPatternExceptions
        Boolean bFound
        Integer iSave_Event_URN iPatternID
        Variant vEvent
        tdEvent tEvent

        Get ComID of (Private_phoR_Pat(Self)) to iPatternID

        If (pbUseStdFiles(Self)) Begin
#IFDEF SigCj_Use_StdFiles
            Move CalEvent.URN to iSave_Event_URN

            Clear CalEvent
            Move OLExtpCalendarRecurrenceException to CalEvent.Recurr_State
            Move iPatternID to CalEvent.Rec_Pattern_id
            Find GT CalEvent by Index.3
            Move Found to bFound
            If (bFound) Move (CalEvent.Recurr_State   = OLExtpCalendarRecurrenceException) to bFound
            If (bFound) Move (CalEvent.Rec_Pattern_id = iPatternID                       ) to bFound
            While (bFound)
                Get Move_StdFile_Event_To_tdEvent to tEvent

                Send Add_R_Pat_Exception_Event tEvent

                Find GT CalEvent by Index.3
                Move Found to bFound
                If (bFound) Move (CalEvent.Recurr_State   = OLExtpCalendarRecurrenceException) to bFound
                If (bFound) Move (CalEvent.Rec_Pattern_id = iPatternID                       ) to bFound
            End

            Clear CalEvent
            Move iSave_Event_URN to CalEvent.URN
            Find Eq CalEvent by Index.1
#ENDIF
        End
        Else Begin
            Send OnEventLoadR_Pat_Exceptions iPatternID
        End
    End_Procedure

    //-------------------------------------------------------------------------

    Procedure Add_R_Pat_Exception_Event tdEvent tEvent
        Variant vEvent

        Move (NullComObject()) to vEvent
        Get Create_Event_Object_From_tdEvent tEvent True to vEvent

        If (not(IsNullComObject(vEvent))) Begin
            Send ComSetException of (Private_phoR_Pat(Self)) vEvent
        End
    End_Procedure

    //=========================================================================
    //Object --> Buffer methods
    //=========================================================================

    Function Move_Event_Object_Data_To_tdEvent Variant vEvent Returns tdEvent
        Handle hoEvent hoR_Pat hoCategories hoCustomIcons hoCustomProps
        Variant         vR_Pat vCategories vCustomIcons vCustomProps
        DateTime dtWork

        tdEvent tEvent

        //Get the predeclared Dataflex objects
        Get Private_phoEvent         to hoEvent
        Get Private_phoR_Pat         to hoR_Pat
        Get Private_phoCategoriesIDs to hoCategories
        Get Private_phoCustomIcons   to hoCustomIcons
        Get Private_phoCustomProps   to hoCustomProps

        Set pvComObject of hoEvent to vEvent

        Get ComId                           of hoEvent to tEvent.iURN
        Get ComAllDayEvent                  of hoEvent to tEvent.bAllDayEvent
        Get ComBody                         of hoEvent to tEvent.sBody
        Get ComBusyStatus                   of hoEvent to tEvent.eBusyStatus
        Get ComImportance                   of hoEvent to tEvent.eImportance
        Get ComLabel                        of hoEvent to tEvent.sLabel
        Get ComLocation                     of hoEvent to tEvent.sLocation
        Get ComMeetingFlag                  of hoEvent to tEvent.bMeetingFlag
        Get ComPrivateFlag                  of hoEvent to tEvent.bPrivateFlag
        Get ComRecurrenceState              of hoEvent to tEvent.eRecurr_State
        Get ComReminder                     of hoEvent to tEvent.bReminder
        Get ComReminderMinutesBeforeStart   of hoEvent to tEvent.iRem_MinsBefore
        Get ComReminderSoundFile            of hoEvent to tEvent.sRem_SoundFile
        Get ComScheduleID                   of hoEvent to tEvent.iScheduleID
        Get ComSubject                      of hoEvent to tEvent.sSubject
        Get ComRExceptionDeleted            of hoEvent to tEvent.bRE_Deleted

        If ((tEvent.eRecurr_State = OLExtpCalendarRecurrenceMaster) or ;
            (tEvent.eRecurr_State = OLExtpCalendarRecurrenceException)) Begin

            Get ComRecurrencePattern of hoEvent to vR_Pat
            Set pvComObject of hoR_Pat to vR_Pat

            Get ComID of hoR_Pat to tEvent.iRec_Pattern_id
        End
        Else Begin
            Move 0 to tEvent.iRec_Pattern_id
        End

        Get ComStartTime of hoEvent to dtWork
        Move dtWork to tEvent.dStartDate
        Get DateTime_to_Time dtWork to tEvent.tmStartTime

        Get ComEndTime of hoEvent to dtWork
        If (IsDateValid(dtWork)) Begin
            Move dtWork to tEvent.dEndDate
        End
        Get DateTime_to_Time dtWork to tEvent.tmEndTime

        Get ComCreationTime of hoEvent to dtWork
        Move dtWork to tEvent.dCreationDate
        Get DateTime_to_Time dtWork to tEvent.tmCreationTime

        Get ComLastModificationTime of hoEvent to dtWork
        Move dtWork to tEvent.dLastMod_Date
        Get DateTime_to_Time dtWork to tEvent.tmLastMod_Time

        Get ComRExceptionStartTimeOrig of hoEvent to dtWork
        Move dtWork to tEvent.dRE_StartDateOrg
        Get DateTime_to_Time dtWork to tEvent.tmRE_StartTimeOrg

        Get ComRExceptionEndTimeOrig of hoEvent to dtWork
        Move dtWork to tEvent.dRE_EndDateOrg
        Get DateTime_to_Time dtWork to tEvent.tmRE_EndTimeOrg

        Get ComCategories of hoEvent to vCategories
        Set pvComObject of hoCategories to vCategories
        Get ComSaveToString of hoCategories to tEvent.sCategories

        //Remove multiple cats. leave only the last one selected / added
        Move (Left(tEvent.sCategories,(pos(",",tEvent.sCategories) -1))) to tEvent.sCategories

        Get ComCustomIcons of hoEvent to vCustomIcons
        Set pvComObject of hoCustomIcons to vCustomIcons
        Get ComSaveToString of hoCustomIcons to tEvent.sCustomIcons

        Get ComCustomProperties of hoEvent to vCustomProps
        Set pvComObject of hoCustomProps to vCustomProps
        Get ComSaveToString of hoCustomProps to tEvent.sCustomProp

        Function_Return tEvent
    End_Function

    //-------------------------------------------------------------------------

    Function Move_R_Pat_Object_Data_To_tdR_Pat Variant vR_Pat Returns tdR_Pat
        Handle   hoR_Pat hoCustomProps hoR_Pat_Options
        Variant           vCustomProps  vR_Pat_Options
        DateTime dtWork
        tdR_Pat  tR_Pat

        Get Private_phoR_Pat to hoR_Pat
        Set pvComObject of hoR_Pat to vR_Pat

        Get ComId                   of hoR_Pat to tR_Pat.iURN
        Get ComDurationMinutes      of hoR_Pat to tR_Pat.iDurationMinutes
        Get ComEndAfterOccurrences  of hoR_Pat to tR_Pat.iEndAfterOcc
        Get ComEndMethod            of hoR_Pat to tR_Pat.eEndMethod
        Get ComMasterEventId        of hoR_Pat to tR_Pat.iMasterEventId

        Get ComEndDate              of hoR_Pat to tR_Pat.dEndDate

        Get ComStartDate            of hoR_Pat to tR_Pat.dStartDate
        Get ComStartTime of hoR_Pat to dtWork
        Get DateTime_to_Time dtWork to tR_Pat.tmStartTime

        Get ComCustomProperties of hoR_Pat to vCustomProps
        Get Private_phoCustomProps to hoCustomProps
        Set pvComObject of hoCustomProps to vCustomProps
        Get ComSaveToString of hoCustomProps to tR_Pat.sCustomProp_XML

        Get ComOptions of hoR_Pat to vR_Pat_Options
        Get Private_phoR_Pat_Options to hoR_Pat_Options
        Set pvComObject of hoR_Pat_Options to vR_Pat_Options

        Get ComDailyEveryWeekDayOnly  of hoR_Pat_Options to tR_Pat.bRoD_WeekDayOnly
        Get ComDailyIntervalDays      of hoR_Pat_Options to tR_Pat.iRoD_Int_Days
        Get ComData1                  of hoR_Pat_Options to tR_Pat.iRoData1
        Get ComData2                  of hoR_Pat_Options to tR_Pat.iRoData2
        Get ComData3                  of hoR_Pat_Options to tR_Pat.iRoData3
        Get ComData4                  of hoR_Pat_Options to tR_Pat.iRoData4
        Get ComMonthlyDayOfMonth      of hoR_Pat_Options to tR_Pat.iRoM_DayOfMonth
        Get ComMonthlyIntervalMonths  of hoR_Pat_Options to tR_Pat.iRoM_Int_Months
        Get ComMonthNthIntervalMonths of hoR_Pat_Options to tR_Pat.iRoM_NthInt_Mths
        Get ComMonthNthWhichDay       of hoR_Pat_Options to tR_Pat.iRoM_Nth_Day
        Get ComMonthNthWhichDayMask   of hoR_Pat_Options to tR_Pat.eRoM_Nth_DayMask
        Get ComRecurrenceType         of hoR_Pat_Options to tR_Pat.eRoRecurr_Type
        Get ComWeeklyDayOfWeekMask    of hoR_Pat_Options to tR_Pat.eRoW_DayWeekMask
        Get ComWeeklyIntervalWeeks    of hoR_Pat_Options to tR_Pat.iRoW_Int_Weeks
        Get ComYearlyDayOfMonth       of hoR_Pat_Options to tR_Pat.iRoY_DayOfMonth
        Get ComYearlyMonthOfYear      of hoR_Pat_Options to tR_Pat.iRoY_MonthOfYear
        Get ComYearNthMonthOfYear     of hoR_Pat_Options to tR_Pat.iRoY_NthM_OfYear
        Get ComYearNthWhichDay        of hoR_Pat_Options to tR_Pat.iRoY_Nth_Day
        Get ComYearNthWhichDayMask    of hoR_Pat_Options to tR_Pat.iRoY_Nth_DayMask

        Function_Return tR_Pat
    End_Function

