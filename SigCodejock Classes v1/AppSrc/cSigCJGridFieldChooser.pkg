Use SigCjW_GridControl.pkg
Use cSigCJMethods_Mixin.pkg

{ OverrideProperty=Attach_Parent_State       DesignTime=False }
{ OverrideProperty=Block_Mouse_State         DesignTime=False }
{ OverrideProperty=Border_Style              DesignTime=False }
{ OverrideProperty=Client_Area_State         DesignTime=False }
{ OverrideProperty=Color                     DesignTime=False }
{ OverrideProperty=Delegation_Mode           DesignTime=False }
{ OverrideProperty=Focus_Mode                DesignTime=False }
{ OverrideProperty=Help_Id                   DesignTime=False }
{ OverrideProperty=Help_Keyword              DesignTime=False }
{ OverrideProperty=psHtmlHelpTopic           DesignTime=False }
{ OverrideProperty=Label                     DesignTime=False }
{ OverrideProperty=Label_Col_Offset          DesignTime=False }
{ OverrideProperty=Label_Col_Offset          DesignTime=False }
{ OverrideProperty=Label_Justification_Mode  DesignTime=False }
{ OverrideProperty=Label_Row_Offset          DesignTime=False }
{ OverrideProperty=peAutoCreate              DesignTime=False }
{ OverrideProperty=pbBindValue               DesignTime=False }
{ OverrideProperty=peNeighborhood            DesignTime=False }
{ OverrideProperty=piMinSize                 DesignTime=False }
{ OverrideProperty=Popup_State               DesignTime=False }
{ OverrideProperty=psLicenseKey              DesignTime=False }
{ OverrideProperty=psProgID                  DesignTime=False }
{ OverrideProperty=Ring_State                DesignTime=False }
{ OverrideProperty=Scope_State               DesignTime=False }
{ OverrideProperty=Search_Case               DesignTime=False }
{ OverrideProperty=Skip_State                DesignTime=False }
{ OverrideProperty=Status_Help               DesignTime=False }
{ OverrideProperty=Use_Parent_Status_Help    DesignTime=False }
{ OverrideProperty=Visible_State             DesignTime=False }
Class cSigCjGridFieldChooser is a cSigCjComFieldChooser
    Import_Class_Protocol cSigCJMethods_Mixin
    
    Procedure Construct_Object
        Forward Send Construct_Object
        
        {Visibility = Private}
        Property Boolean private_pbSortAscending    True // The SortAscending Property specifies whether to Sort the items in the Field Chooser in alphabetical order. See FieldChooser.SortAscending
        {Visibility = Private}
        Property Integer private_peAppearance       0   // Specifies whether the FieldChooser control is drawn with 3D effects.  See FieldChooser.Appearance
        {Visibility = Private}
        Property Integer private_peBorderStyle      1   // Specifies the border style for the FieldChooser control.  See FieldChooser.BorderStyle
        {Visibility = Private}
        Property Boolean private_Enabled_State      True  // Specifies whether the FieldChooser control can respond to events.  See FieldChooser.Enabled 

        Property Handle phoGridObject 0                 // Specifies the grid object that will be attached to this field chooser.

        Set peAnchors to anAll
    End_Procedure

    //-------------------------------------------------------------------------    

    Procedure OnCreate
        Handle hoGridObject

        Forward Send OnCreate

        Set ComAppearance       to (Private_peAppearance   (Self))
        Set ComBorderStyle      to (Private_peBorderStyle  (Self))
        Set ComEnabled          to (Private_Enabled_State  (Self))
        Set ComSortAscending    to (Private_pbSortAscending(Self))
        
        // Attach to the Grid object....
        Get phoGridObject to hoGridObject
        
        If (hoGridObject <> 0) Begin
            Send AttachFieldChooser of hoGridObject Self True
        End
    End_Procedure

    //-------------------------------------------------------------------------

    {Category="CodeJock" MethodType=Property InitialValue=True }
    Procedure Set Enabled_State Boolean bValue
        Set SigCJProperty Set_Private_Enabled_State Set_ComEnabled to bValue 
    End_Procedure

    Function Enabled_State Returns Boolean
        Function_Return (SigCJProperty(Self, Get_Private_Enabled_State, Get_ComEnabled))
    End_Function

    //-------------------------------------------------------------------------

    {Category="CodeJock" MethodType=Property InitialValue=True }
    Procedure Set pbSortAscending Boolean bValue
        Set SigCJProperty Set_Private_pbSortAscending Set_ComSortAscending to bValue 
    End_Procedure

    Function pbSortAscending Returns Boolean
        Function_Return (SigCJProperty(Self, Get_Private_pbSortAscending, Get_ComSortAscending))
    End_Function

    //-------------------------------------------------------------------------

    {Category="CodeJock" MethodType=Property InitialValue=0 }
    Procedure Set peAppearance Integer iValue
        Set SigCJProperty Set_Private_peAppearance Set_ComAppearance to iValue 
    End_Procedure

    Function peAppearance Returns Integer
        Function_Return (SigCJProperty(Self, Get_Private_peAppearance, Get_ComAppearance))
    End_Function

    //-------------------------------------------------------------------------

    {Category="CodeJock" MethodType=Property InitialValue=1 }
    Procedure Set peBorderStyle Integer iValue
        Set SigCJProperty Set_Private_peBorderStyle Set_ComBorderStyle to iValue 
    End_Procedure

    Function peBorderStyle Returns Integer
        Function_Return (SigCJProperty(Self, Get_Private_peBorderStyle, Get_ComBorderStyle))
    End_Function

    //-------------------------------------------------------------------------    

    Procedure ReleaseComObject
        Handle hoGridObject
        Forward Send ReleaseComObject
        Get phoGridObject to hoGridObject
        If (hoGridObject <> 0) Begin
            Send AttachFieldChooser of hoGridObject Self False
        End
    End_Procedure

End_Class
    
//=============================================================================

Class cSigCjGridFieldChooserPanel is a ToolPanel
    
    Procedure Construct_Object
        Forward Send Construct_Object
        
        { DesignTime=False }
        Property Handle phoFieldChooserControl

        Set Size to 100 80
        Set Auto_Locate_State to True
        Set Popup_State to True
        Set Label to "Field Chooser"
        
        Object oFieldChooser is a cSigCjGridFieldChooser
            Set Size to 100 80
            Set phoFieldChooserControl to Self
        End_Object
    End_Procedure
    
    //-------------------------------------------------------------------------    

    { MethodType=Property }
    Procedure Set phoGridObject Handle hoGrid
        Handle hoFieldChooserControl
        Get phoFieldChooserControl to hoFieldChooserControl
        Set phoGridObject of hoFieldChooserControl to hoGrid        
    End_Procedure
    
    { MethodType=Property }
    Function phoGridObject Returns Handle
        Handle hoFieldChooserControl hoGrid
        Get phoFieldChooserControl to hoFieldChooserControl
        Get phoGridObject of hoFieldChooserControl to hoGrid        
        Function_Return hoGrid
    End_Function

End_Class

//==============================================================================
//End of Package - cSigCJFieldChooser.pkg
//==============================================================================
